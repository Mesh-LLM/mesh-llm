+
+    test_glm_shexp_component(
+            int       component,
+            ggml_type gate_type = GGML_TYPE_Q4_K,
+            ggml_type up_type   = GGML_TYPE_Q4_K,
+            ggml_type down_type = GGML_TYPE_Q4_K,
