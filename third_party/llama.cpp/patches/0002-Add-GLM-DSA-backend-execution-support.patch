+    std::string vars() override {
+        std::string base = VARS_TO_STR13(type_k, type_v, type_mask, dk, dv, n_kv, n_batch, n_head, n_stream, n_top_k, n_top_stream, dense_equiv, graph_equiv);
+        if (graph_expected) {
