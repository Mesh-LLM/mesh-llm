+    const ggml_type type_v;
+    const ggml_type type_mask;
+
+    const int64_t dk;
+    const int64_t dv;
+    const int64_t n_kv;
+    const int64_t n_batch;
+    const int64_t n_head;
+    const int64_t n_stream;
+    const int64_t n_top_k;
+    const int64_t n_top_stream;
