+            "skippy: metal_cb_timing graph=%d cb=%d node_start=%d node_end=%d nodes=%d total_nodes=%d status=%lu cpu_ms=%.3f gpu_ms=%.3f gpu_start=%.9f gpu_end=%.9f\n",
