+static bool ggml_metal_tensor_is_shared_expert_up(const ggml_tensor * tensor) {
+    return ggml_metal_tensor_name_contains(tensor, "ffn_shexp_up") ||
+        ggml_metal_tensor_name_contains(tensor, "ffn_up");
+}
