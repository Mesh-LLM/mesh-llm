+static bool ggml_metal_tensor_is_glm_dsa_qk_moe_expert(const ggml_tensor * tensor) {
+    return tensor != nullptr && (tensor->type == GGML_TYPE_Q2_K || tensor->type == GGML_TYPE_Q3_K);
+}
