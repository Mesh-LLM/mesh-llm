From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate minicpm3 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/minicpm3.cpp b/src/models/minicpm3.cpp
index 7820d52241ef517ca320fffc6324c29ed765f778..07987e9c89872c40299619d0fe8ae975214a8b3c 100644
--- a/src/models/minicpm3.cpp
+++ b/src/models/minicpm3.cpp
@@ -89,6 +89,8 @@ llama_model_minicpm3::graph::graph(const llama_model & model, const llm_graph_pa
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         ggml_tensor * rope_factors = model.get_rope_factors(cparams, il);
@@ -227,6 +229,7 @@ llama_model_minicpm3::graph::graph(const llama_model & model, const llm_graph_pa
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
