From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate mimo2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/mimo2.cpp b/src/models/mimo2.cpp
index accde102cd63facfc20989f01f007c2027788821..373efc07ec0a0f2b29712eaf211eedb6b69d1a6c 100644
--- a/src/models/mimo2.cpp
+++ b/src/models/mimo2.cpp
@@ -106,6 +106,8 @@ llama_model_mimo2::graph::graph(const llama_model & model, const llm_graph_param
     const bool crop_last_layer = inp_out_ids && (!emit_h_nextn || cparams.embeddings_nextn_masked);
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         uint32_t n_head_l    = hparams.n_head(il);
@@ -229,6 +231,7 @@ llama_model_mimo2::graph::graph(const llama_model & model, const llm_graph_param
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
