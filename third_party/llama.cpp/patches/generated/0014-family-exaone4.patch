From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate exaone4 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/exaone4.cpp b/src/models/exaone4.cpp
index 9ba978956dc82223850bc9ca958d01c16b75d1ea..0d92dec305c5d6c482d81c7b4b863f1eca5e95c4 100644
--- a/src/models/exaone4.cpp
+++ b/src/models/exaone4.cpp
@@ -107,6 +107,8 @@ llama_model_exaone4::graph<iswa>::graph(const llama_model & model, const llm_gra
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // use RoPE for SWA layers or non-SWA models
@@ -170,6 +172,7 @@ llama_model_exaone4::graph<iswa>::graph(const llama_model & model, const llm_gra
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
