From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate bailingmoe3 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/bailingmoe3.cpp b/src/models/bailingmoe3.cpp
index d375502ddc6c27796792691bb45c505aa19a9329..a3d8185653d3ef4584d05b7d9285eb6651f02b37 100644
--- a/src/models/bailingmoe3.cpp
+++ b/src/models/bailingmoe3.cpp
@@ -245,6 +245,8 @@ llama_model_bailingmoe3::graph::graph(const llama_model & model, const llm_graph
     GGML_ASSERT(ubatch.n_tokens == n_seq_tokens * n_seqs);
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         const auto & layer = model.layers[il];
@@ -390,6 +392,7 @@ llama_model_bailingmoe3::graph::graph(const llama_model & model, const llm_graph
         cur = build_cvec(cur, il);
         cb(cur, "l_out", il);
         inpL = cur;
+        end_block(inpL, il);
     }
 
     ggml_tensor * cur = build_norm(inpL, model.output_norm, nullptr, LLM_NORM_RMS, -1);
-- 
