From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate lfm2--lfm2-moe--lfm2-vl graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/lfm2.cpp b/src/models/lfm2.cpp
index 9a7eadd24d6dc6dbfac10f3a73b3679e9d3a4eea..bbb857d7038cd7abb3cfa60bbc4eafbebdc991ab 100644
--- a/src/models/lfm2.cpp
+++ b/src/models/lfm2.cpp
@@ -251,6 +251,8 @@ llama_model_lfm2::graph<iswa>::graph(const llama_model & model, const llm_graph_
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(cur, il);
+
         res->t_layer_inp[il] = cur;
 
         const bool is_moe_layer = il >= static_cast<int>(hparams.n_layer_dense_lead);
@@ -280,6 +282,7 @@ llama_model_lfm2::graph<iswa>::graph(const llama_model & model, const llm_graph_
 
         cur = build_cvec(cur, il);
         cb(cur, "l_out", il);
+        end_block(cur, il);
     }
 
     cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
-- 
2.54.0

