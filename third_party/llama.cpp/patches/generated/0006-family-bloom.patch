From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate bloom graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/bloom.cpp b/src/models/bloom.cpp
index 609d2ddf998b7579cbcd4d8a07c09d0bc9f0492b..609cf959b8500964f06a65b2d6b5821e7b99a076 100644
--- a/src/models/bloom.cpp
+++ b/src/models/bloom.cpp
@@ -83,6 +83,8 @@ llama_model_bloom::graph::graph(const llama_model & model, const llm_graph_param
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         cur = build_norm(inpL,
                 model.layers[il].attn_norm,
                 model.layers[il].attn_norm_b,
@@ -132,6 +134,7 @@ llama_model_bloom::graph::graph(const llama_model & model, const llm_graph_param
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = build_norm(inpL,
