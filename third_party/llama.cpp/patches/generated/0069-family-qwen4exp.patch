From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate qwen4exp graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 7925db11ca7466c8c2f30f69b1bfea6ee23ea5f9..9126631b9e537d69280ba13ba3c881f8769606ef 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -392,6 +392,8 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
     cb(res_hc, "hc_init", -1);
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(res_hc, il);
+
         res->t_layer_inp[il] = res_hc;
 
         if (hparams.is_ple(il)) {
@@ -440,6 +442,7 @@ llama_model_qwen4exp::graph::graph(const llama_model & model, const llm_graph_pa
 
         // "l_last" is the layer output name that build_cvec and imatrix look for
         cb(res_hc, "l_last", il);
+        end_block(res_hc, il);
     }
 
     // the final mixer is the output norm: there is no separate one
-- 
