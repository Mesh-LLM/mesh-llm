From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: generate inkling stage controls

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/inkling.cpp b/src/models/inkling.cpp
index 0310612ef9d7fa2d4b2f34651cfa2b78faae6816..1ce96ea1b4004f89d8ba3264362026e25a046cdb 100644
--- a/src/models/inkling.cpp
+++ b/src/models/inkling.cpp
@@ -636,20 +636,35 @@ llama_model_inkling::graph::graph(const llama_model & model, const llm_graph_par
         return;
     }
 
-    ggml_tensor * cur = build_inp_embd(model.tok_embd);
+    const skippy_graph_filter & stage_filter = build_inputs.filter;
+    const bool stage_filtered = stage_filter.enabled;
+    const int il_start = stage_filtered ? stage_filter.layer_start : 0;
+    const int il_end   = stage_filtered ? stage_filter.layer_end   : n_layer;
+
+    ggml_tensor * cur = build_inp_embd(stage_filtered && il_start > 0 ? nullptr : model.tok_embd);
     // mtmd embd rows arrive pre-normalized; embed_norm applies to text token lookups only
-    if (ubatch.token) {
+    if ((!stage_filtered || il_start == 0) && (ubatch.token)) {
         cur = build_norm(cur, model.tok_norm, NULL, LLM_NORM_RMS, -1);
     }
     cb(cur, ubatch.token ? "inkling_embd_norm" : "inkling_mm_embd", -1);
     ggml_build_forward_expand(gf, cur);
 
-    for (int il = 0; il < n_layer; ++il) {
+    for (int il = il_start; il < il_end; ++il) {
+        begin_block(cur, il);
+
         res->t_layer_inp[il] = cur;
         cur = build_block(cur, il);
+        end_block(cur, il);
+    }
+    if (stage_filtered && !stage_filter.include_output) {
+        cb(cur, "stage_boundary", il_end - 1);
+        res->t_embd = cur;
+        ggml_build_forward_expand(gf, cur);
+        return;
     }
 
-    ggml_tensor * inp_out_ids = build_inp_out_ids();
+
+    ggml_tensor * inp_out_ids = (!stage_filtered || stage_filter.include_output) ? build_inp_out_ids() : nullptr;
 
     // Conv states need every layer to see all tokens. Intermediate stages hand off the full
     // activation sequence, and the final stage trims outputs only after its last local layer.
-- 
