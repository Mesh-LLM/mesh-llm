From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate gemma2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/gemma2.cpp b/src/models/gemma2.cpp
index 2fbfb15a94a39a605d2e3ba1426304d7dc922e27..17b070fde483d3e0bcdc62504def6d8a7ec519a1 100644
--- a/src/models/gemma2.cpp
+++ b/src/models/gemma2.cpp
@@ -78,6 +78,8 @@ llama_model_gemma2::graph::graph(const llama_model & model, const llm_graph_para
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const float freq_base_l  = model.get_rope_freq_base (cparams, il);
         const float freq_scale_l = model.get_rope_freq_scale(cparams, il);
 
@@ -152,6 +154,7 @@ llama_model_gemma2::graph::graph(const llama_model & model, const llm_graph_para
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
-- 
