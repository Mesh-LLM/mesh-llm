From d01b473cd4e6969a5c757ad1ae58a7c3ed6a43b5 Mon Sep 17 00:00:00 2001
From: sat <sat@local>
Date: Mon, 21 Sep 2026 18:51:35 +1000
Subject: [PATCH] skippy: SAT graph trace to stderr

---
 src/llama-context.cpp | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index c063d1918..81f7ca083 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1494,10 +1494,11 @@ llm_graph_result * llama_context::process_ubatch(
         const int64_t t_us = ggml_time_us() - t_trace_start_us;
         ++trace_count;
         const bool pow2 = (trace_count & (trace_count - 1)) == 0;
-        if (pow2 || trace_count % 500 == 0) {
-            LLAMA_LOG_WARN("SAT-TRACE ubatch=%" PRIu64 " n_tokens=%u n_seqs=%u n_outputs=%u reused=%d nodes=%d splits=%d compute_us=%" PRId64 "\n",
+        if (trace_count <= 64 || pow2 || trace_count % 200 == 0) {
+            fprintf(stderr, "SAT-TRACE ubatch=%" PRIu64 " n_tokens=%u n_seqs=%u n_outputs=%u reused=%d nodes=%d splits=%d compute_us=%" PRId64 "\n",
                     trace_count, ubatch.n_tokens, ubatch.n_seqs, n_outputs, reused_now ? 1 : 0,
                     ggml_graph_n_nodes(res->get_gf()), ggml_backend_sched_get_n_splits(sched.get()), t_us);
+            fflush(stderr);
         }
     }
 
