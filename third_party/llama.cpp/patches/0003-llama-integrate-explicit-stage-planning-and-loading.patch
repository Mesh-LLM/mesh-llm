+
+    auto * raw = input->get_raw();
+    request_input(raw->self_k_idxs, "dsv4.raw.key_indices");
+    request_input(raw->self_kq_mask, "dsv4.raw.attention_mask");
+    request_input(raw->self_k_rot, "dsv4.raw.key_rotation");
+    register_comp(input->get_csa(), "csa");
+    register_comp(input->get_hca(), "hca");
+    register_comp(input->get_lid(), "lid");
+}
