+        const std::string prefix = std::string("dsv4.") + plane + ".";
+        request_input(comp.state_pos, (prefix + "state_positions").c_str());
+        request_input(comp.state_persist_src_idxs, (prefix + "persist_source_indices").c_str());
+        request_input(comp.state_persist_dst_idxs, (prefix + "persist_destination_indices").c_str());
+        request_input(comp.state_restore_src_idxs, (prefix + "restore_source_indices").c_str());
+        request_input(comp.state_restore_dst_idxs, (prefix + "restore_destination_indices").c_str());
+        request_input(comp.state_snapshot_src_idxs, (prefix + "snapshot_source_indices").c_str());
+        request_input(comp.state_snapshot_dst_idxs, (prefix + "snapshot_destination_indices").c_str());
+        request_input(comp.state_read_idxs, (prefix + "read_indices").c_str());
+        request_input(comp.state_write_idxs, (prefix + "write_indices").c_str());
+        request_input(comp.state_write_pos, (prefix + "write_positions").c_str());
+        request_input(comp.kq_mask, (prefix + "attention_mask").c_str());
+        request_input(comp.k_rot, (prefix + "key_rotation").c_str());
