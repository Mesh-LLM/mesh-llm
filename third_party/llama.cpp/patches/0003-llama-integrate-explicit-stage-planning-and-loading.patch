+void llm_graph_context::begin_block(ggml_tensor * cur, int il) const {
+    res->block_boundaries.push_back({skippy_block_boundary_kind::entry, il, cur});
+}
+
+void llm_graph_context::end_block(ggml_tensor * cur, int il) const {
+    // Expand eagerly so block boundary positions partition the executable
+    // graph: lazy expansion lets independent nodes from later blocks be
+    // appended before an earlier block's exit tensor.
+    ggml_build_forward_expand(gf, cur);
+    res->block_boundaries.push_back({skippy_block_boundary_kind::exit, il, cur});
+}
+
+void llm_graph_context::state_read(skippy_state_kind kind, ggml_tensor * storage, int il) const {
+    res->state_effects.push_back({kind, skippy_state_access::read,
+            il, skippy_state_canonical_storage(storage), nullptr, -1,
+            il >= n_layer ? skippy_state_residency::per_stage : skippy_state_residency::layer_local});
+}
+
+void llm_graph_context::state_write(skippy_state_kind kind, ggml_tensor * storage, ggml_tensor * effect_node, int il) const {
+    const ggml_tensor * canonical = skippy_state_canonical_storage(storage);
+    int64_t ordinal = 0;
+    for (const auto & effect : res->state_effects) {
+        if (effect.access == skippy_state_access::write && effect.kind == kind &&
+                effect.layer == il && effect.storage == canonical) {
+            ++ordinal;
+        }
+    }
+    res->state_effects.push_back({kind, skippy_state_access::write, il, canonical, effect_node, ordinal,
+            il >= n_layer ? skippy_state_residency::per_stage : skippy_state_residency::layer_local});
+}
