From 8b3393e23b172f449633b3ebd4f55b2a65138589 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Wed, 2 Sep 2026 04:18:49 -0400
Subject: [PATCH 45/48] skippy: add kv-events family (bit 31)

Adds SKIPPY_FEATURE_KV_EVENTS (bit 31): KV/cache init, pressure
crossed/cleared, context-capacity approaching/exhausted, published
through skippy_emit_kv_event under the existing
SKIPPY_RUNTIME_EVENT_CATEGORY_KV via the reporter patch's shared
dispatch() seam. No further ABI bump.

Adds ctest case skippy_runtime_event_kv_events_dispatch.
---
 include/skippy/common.h             |  1 +
 include/skippy/events.h             | 14 ++++++++++++++
 src/CMakeLists.txt                  |  3 ++-
 src/skippy/abi.cpp                  |  3 ++-
 src/skippy/events.cpp               | 11 +++++++++++
 src/skippy/tests/runtime_events.cpp | 13 +++++++++++++
 6 files changed, 43 insertions(+), 2 deletions(-)

diff --git a/include/skippy/common.h b/include/skippy/common.h
index eacf6da22..bf5cab87b 100644
--- a/include/skippy/common.h
+++ b/include/skippy/common.h
@@ -85,6 +85,7 @@ enum skippy_feature {
 // combine these with the enum bits identically either way.
 #define SKIPPY_FEATURE_RUNTIME_EVENT_REPORTER ((uint64_t)1 << 29)
 #define SKIPPY_FEATURE_MODEL_LOAD_EVENTS_V2   ((uint64_t)1 << 30)
+#define SKIPPY_FEATURE_KV_EVENTS              ((uint64_t)1 << 31)
 
 enum skippy_status {
     SKIPPY_STATUS_OK                      = 0,
diff --git a/include/skippy/events.h b/include/skippy/events.h
index 47b096a40..8c0259c14 100644
--- a/include/skippy/events.h
+++ b/include/skippy/events.h
@@ -42,6 +42,13 @@ enum {
     SKIPPY_RUNTIME_EVENT_KIND_MODEL_LOAD_TENSORS_OFFLOADED   = 102,
     SKIPPY_RUNTIME_EVENT_KIND_MODEL_LOAD_TOKENIZER_READY     = 103,
     SKIPPY_RUNTIME_EVENT_KIND_MODEL_LOAD_AUX_COMPONENT_READY = 104,
+
+    // SKIPPY_FEATURE_KV_EVENTS (category KV).
+    SKIPPY_RUNTIME_EVENT_KIND_KV_INITIALIZED                  = 200,
+    SKIPPY_RUNTIME_EVENT_KIND_KV_PRESSURE_CROSSED             = 201,
+    SKIPPY_RUNTIME_EVENT_KIND_KV_PRESSURE_CLEARED             = 202,
+    SKIPPY_RUNTIME_EVENT_KIND_KV_CONTEXT_APPROACHING_CAPACITY = 203,
+    SKIPPY_RUNTIME_EVENT_KIND_KV_CONTEXT_CAPACITY_EXHAUSTED   = 204,
 };
 
 typedef uint32_t skippy_runtime_event_emitter_kind;
@@ -155,6 +162,13 @@ LLAMA_API void skippy_emit_model_load_event_v2(
         const char * detail_ptr,
         uint64_t detail_len);
 
+/** @brief Emits SKIPPY_FEATURE_KV_EVENTS category KV events. */
+LLAMA_API void skippy_emit_kv_event(
+        skippy_runtime_event_kind kind,
+        uint64_t session_id,
+        uint64_t numeric_summary_0,
+        uint64_t numeric_summary_1);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index da740a024..2f92aced4 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -102,7 +102,8 @@ if (LLAMA_STAGE_BUILD_TESTS)
             clear_is_quiescent
             struct_size_extension
             concurrent_dispatch
-            model_load_events_v2_dispatch)
+            model_load_events_v2_dispatch
+            kv_events_dispatch)
         add_test(
             NAME skippy_runtime_event_${SKIPPY_EVENT_TEST_CASE}
             COMMAND skippy-runtime-events-test ${SKIPPY_EVENT_TEST_CASE})
diff --git a/src/skippy/abi.cpp b/src/skippy/abi.cpp
index 76ac92196..f053ee2ff 100644
--- a/src/skippy/abi.cpp
+++ b/src/skippy/abi.cpp
@@ -38,7 +38,8 @@ uint64_t skippy_abi_features(void) {
            SKIPPY_FEATURE_INKLING_MTP_MM |
            SKIPPY_FEATURE_ITERATION_BATCH |
            SKIPPY_FEATURE_RUNTIME_EVENT_REPORTER |
-           SKIPPY_FEATURE_MODEL_LOAD_EVENTS_V2;
+           SKIPPY_FEATURE_MODEL_LOAD_EVENTS_V2 |
+           SKIPPY_FEATURE_KV_EVENTS;
 }
 
 void skippy_error_free(struct skippy_error * error) {
diff --git a/src/skippy/events.cpp b/src/skippy/events.cpp
index 325385ebc..ff236de37 100644
--- a/src/skippy/events.cpp
+++ b/src/skippy/events.cpp
@@ -132,3 +132,14 @@ void skippy_emit_model_load_event_v2(
         SKIPPY_RUNTIME_EVENT_FAILURE_NONE, numeric_summary_0, numeric_summary_1, 0, 0,
         detail_ptr, detail_len);
 }
+
+void skippy_emit_kv_event(
+        skippy_runtime_event_kind kind,
+        uint64_t session_id,
+        uint64_t numeric_summary_0,
+        uint64_t numeric_summary_1) {
+    skippy::events::dispatch(
+        SKIPPY_RUNTIME_EVENT_CATEGORY_KV, kind, 0, 0, session_id,
+        SKIPPY_RUNTIME_EVENT_FAILURE_NONE, numeric_summary_0, numeric_summary_1, 0, 0,
+        nullptr, 0);
+}
diff --git a/src/skippy/tests/runtime_events.cpp b/src/skippy/tests/runtime_events.cpp
index 12ea097f9..01f01b5c9 100644
--- a/src/skippy/tests/runtime_events.cpp
+++ b/src/skippy/tests/runtime_events.cpp
@@ -143,6 +143,18 @@ int test_model_load_events_v2_dispatch() {
     return 0;
 }
 
+int test_kv_events_dispatch() {
+    capture c;
+    install(c);
+    skippy_emit_kv_event(SKIPPY_RUNTIME_EVENT_KIND_KV_PRESSURE_CROSSED, 5, 9, 0);
+    CHECK(c.count.load() == 1);
+    CHECK(c.last_category.load() == SKIPPY_RUNTIME_EVENT_CATEGORY_KV);
+    CHECK(c.last_kind.load() == SKIPPY_RUNTIME_EVENT_KIND_KV_PRESSURE_CROSSED);
+    CHECK(c.last_numeric_summary_0.load() == 9);
+    skippy_clear_runtime_event_reporter();
+    return 0;
+}
+
 } // namespace
 
 int main(int argc, char ** argv) {
@@ -157,6 +169,7 @@ int main(int argc, char ** argv) {
     if (name == "struct_size_extension") return test_struct_size_extension();
     if (name == "concurrent_dispatch") return test_concurrent_dispatch();
     if (name == "model_load_events_v2_dispatch") return test_model_load_events_v2_dispatch();
+    if (name == "kv_events_dispatch") return test_kv_events_dispatch();
     std::fprintf(stderr, "unknown test: %s\n", name.c_str());
     return 2;
 }
-- 
