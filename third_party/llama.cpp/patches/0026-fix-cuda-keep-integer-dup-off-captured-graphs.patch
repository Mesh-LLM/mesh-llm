From 05f093fe62a92b1c17ffd62431c6eaf348b3ae31 Mon Sep 17 00:00:00 2001
From: James Dumay <jameswdumay@gmail.com>
Date: Thu, 24 Sep 2026 12:25:00 +1000
Subject: [PATCH] fix(cuda): keep integer dup off captured graphs

The updated llama.cpp pin enables CUDA offload for I16 and I32 DUP nodes.
Stable CUDA graph capture can fail once those nodes move from the host into
the captured graph, aborting the third request in the CUDA smoke test.

Retain the previous backend placement for integer DUP nodes while leaving the
new CUDA copy kernels available to explicit copy operations.
---
 ggml/src/ggml-cuda/ggml-cuda.cu | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index b7855d016..69decaa3e 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5373,7 +5373,12 @@ static bool ggml_backend_cuda_device_supports_op(ggml_backend_dev_t dev, const g
                 return false;
             } break;
         case GGML_OP_DUP:
-                return true;
+            {
+                // Integer DUP offload can fail while capturing stable CUDA graphs.
+                // Keep these tensors on the host until the upstream graph path is safe.
+                ggml_type src0_type = op->src[0]->type;
+                return src0_type != GGML_TYPE_I32 && src0_type != GGML_TYPE_I16;
+            } break;
         case GGML_OP_ARGMAX:
         case GGML_OP_COUNT_EQUAL:
             {
