+            for (const auto & req : required_parsers) {
+                required_slots.push_back(optional_run + req + p.space());
+            }
+            args_seq = args_seq + p.permute("tool-" + name + "-required", required_slots) + optional_run;
+        } else {
+            args_seq = args_seq + optional_run;
