+static const ggml_tensor * program_canonical_storage(const ggml_tensor * tensor) {
+    std::unordered_set<const ggml_tensor *> seen;
+    while (tensor != nullptr && tensor->view_src != nullptr) {
+        if (!seen.insert(tensor).second) return nullptr;
+        tensor = tensor->view_src;
+    }
+    return tensor;
+}
+static bool checked_add_u64(uint64_t lhs, uint64_t rhs, uint64_t & result) {
+    if (rhs > std::numeric_limits<uint64_t>::max() - lhs) return false;
+    result = lhs + rhs;
+    return true;
+}
+
+static bool checked_multiply_u64(uint64_t lhs, uint64_t rhs, uint64_t & result) {
+    if (lhs != 0 && rhs > std::numeric_limits<uint64_t>::max()/lhs) return false;
+    result = lhs*rhs;
+    return true;
+}
+static bool has_supported_op(ggml_op op) {
+    switch (op) {
+        case GGML_OP_GET_ROWS:
+        case GGML_OP_SCALE:
+        case GGML_OP_NORM:
+        case GGML_OP_RMS_NORM:
+        case GGML_OP_MUL:
+        case GGML_OP_MUL_MAT:
+        case GGML_OP_FLASH_ATTN_EXT:
+        case GGML_OP_ADD:
+        case GGML_OP_ADD_ID:
+        case GGML_OP_SUB:
+        case GGML_OP_REPEAT:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_ROPE:
+        case GGML_OP_ROPE_BACK:
+        case GGML_OP_VIEW:
+        case GGML_OP_SET_ROWS:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_SOFT_MAX:
+        case GGML_OP_CONT:
+        case GGML_OP_GLU:
+        case GGML_OP_CPY:
+        case GGML_OP_TRANSPOSE:
+        case GGML_OP_CONCAT:
+        case GGML_OP_SSM_CONV:
+        case GGML_OP_UNARY:
+        case GGML_OP_SSM_SCAN:
+        case GGML_OP_GATED_DELTA_NET:
+        case GGML_OP_SQR:
+        case GGML_OP_SQRT:
+        case GGML_OP_ARGSORT:
+        case GGML_OP_MUL_MAT_ID:
+        case GGML_OP_SUM_ROWS:
+        case GGML_OP_CLAMP:
+        case GGML_OP_DIV:
+        case GGML_OP_FILL:
+        case GGML_OP_DSV4_HC_COMB:
+        case GGML_OP_DSV4_HC_PRE:
+        case GGML_OP_DSV4_HC_POST:
+        case GGML_OP_LIGHTNING_INDEXER:
+        case GGML_OP_TOP_K:
+        case GGML_OP_CUMSUM:
+        case GGML_OP_SET:
+        case GGML_OP_DIAG:
+        case GGML_OP_PAD:
+        case GGML_OP_TRI:
+        case GGML_OP_SOLVE_TRI:
+        case GGML_OP_POOL_2D:
+        case GGML_OP_ARANGE:
+            return true;
+        default:
+            return false;
+    }
+}
+
+template<typename T>
+T operation_parameter(const skippy_stage_program::operation & operation, size_t index) {
+    T result;
+    std::memcpy(&result, operation.parameters.data() + index*sizeof(T), sizeof(T));
+    return result;
+}
+
+ggml_tensor * replay_operation(
+        ggml_context * context,
+        const skippy_stage_program::operation & operation,
+        const std::array<ggml_tensor *, GGML_MAX_SRC> & sources,
+        const geometry_runtime & runtime,
+        std::string & error) {
