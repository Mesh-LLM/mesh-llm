+skippy_stage_program::replay_plan skippy_stage_program::build_replay_plan(bool token_input) const {
+    replay_plan plan;
+    std::unordered_set<std::string> live_operations;
+    for (const auto & operation : operations) {
+        if ((operation.flags & GGML_TENSOR_FLAG_COMPUTE) != 0 || operation.input_choice_branches != 0) {
+            live_operations.insert(operation.value_id);
+        }
+    }
+    for (const auto & exported : activation_exports) live_operations.insert(exported);
+    const auto selected_choice_value = [&](const std::string & value_id) {
+        for (const auto & choice : input_choices) {
+            if (choice.value_id == value_id) {
+                return choice.alternatives[token_input ? 0 : 1];
+            }
+        }
+        return value_id;
+    };
+    for (auto operation = operations.rbegin(); operation != operations.rend(); ++operation) {
+        if (live_operations.count(operation->value_id) == 0) continue;
+        for (const auto & source_id : operation->sources) {
+            if (!source_id.empty()) live_operations.insert(selected_choice_value(source_id));
+        }
+    }
+    plan.operation_indexes.reserve(live_operations.size());
+    for (size_t index = 0; index < operations.size(); ++index) {
+        if (live_operations.count(operations[index].value_id) != 0) {
+            plan.operation_indexes.push_back(static_cast<uint32_t>(index));
+        }
+    }
+    // Every value the replay map can hold: bound roots, the input values each
+    // recipe binds, one entry per operation, and the input-choice aliases.
+    uint64_t capacity = roots.size() + operations.size() + input_choices.size() + 16;
+    for (const auto & input : inputs) capacity += input.values.size();
+    plan.value_capacity = static_cast<uint32_t>(capacity);
+    return plan;
+}
+
+void skippy_stage_program::prepare_replay_plans() {
+    replay_plans[0] = build_replay_plan(true);
+    replay_plans[1] = build_replay_plan(false);
+    replay_plans_prepared = true;
+}
