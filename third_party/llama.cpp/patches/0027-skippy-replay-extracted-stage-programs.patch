+                    bind(input.values[base + 7], comp.state_read_idxs);
+                    bind(input.values[base + 8], comp.state_write_idxs);
+                    bind(input.values[base + 9], comp.state_write_pos);
+                    bind(input.values[base + 10], comp.kq_mask);
+                    bind(input.values[base + 11], comp.k_rot);
+                };
+                bind(input.values[0], recipe->get_raw()->self_k_idxs);
+                bind(input.values[1], recipe->get_raw()->self_kq_mask);
+                bind(input.values[2], recipe->get_raw()->self_k_rot);
+                bind_comp(recipe->get_csa(), 3);
+                bind_comp(recipe->get_hca(), 15);
+                bind_comp(recipe->get_lid(), 27);
+                result.add_input(std::move(recipe));
+                break;
+            }
+            case input_kind::qwen4exp_qsa: {
+                const auto * qwen_memory = dynamic_cast<const llama_memory_hybrid_idx_context *>(params.mctx);
+                if (qwen_memory == nullptr || qwen_memory->get_idx() == nullptr ||
+                        input.qwen4exp_qsa_ratio == 0) {
+                    error = "stage program Qwen4 QSA input requires compatible indexed hybrid memory";
+                    return false;
+                }
+                const auto * index_memory = qwen_memory->get_idx();
+                const int64_t n_kv = index_memory->get_n_kv();
+                const int64_t n_stream = qwen_memory->get_n_stream();
+                if (n_stream <= 0 || params.ubatch.n_tokens % n_stream != 0) {
+                    error = "stage program Qwen4 QSA input has incompatible stream geometry";
+                    return false;
+                }
+                const int64_t n_blocks = (n_kv + input.qwen4exp_qsa_ratio - 1)/input.qwen4exp_qsa_ratio;
+                auto recipe = std::make_unique<llama_model_qwen4exp::llm_graph_input_qsa>(
+                        qwen_memory, input.qwen4exp_qsa_ratio, input.qwen4exp_qsa_block_bias);
+                recipe->k_idxs = index_memory->build_input_k_idxs(context, params.ubatch);
+                recipe->cell_blk = ggml_new_tensor_2d(context, GGML_TYPE_I32, n_kv, n_stream);
+                recipe->blk_cells = ggml_new_tensor_2d(context, GGML_TYPE_I32,
+                        static_cast<int64_t>(input.qwen4exp_qsa_ratio)*n_blocks, n_stream);
+                recipe->blk_pos = ggml_new_tensor_1d(context, GGML_TYPE_I32, 4*n_blocks*n_stream);
+                recipe->bias = ggml_new_tensor_3d(context, GGML_TYPE_F32,
+                        input.qwen4exp_qsa_block_bias ? n_blocks : n_kv,
+                        params.ubatch.n_tokens/n_stream, n_stream);
+                ggml_set_input(recipe->cell_blk);
+                ggml_set_input(recipe->blk_cells);
+                ggml_set_input(recipe->blk_pos);
+                ggml_set_input(recipe->bias);
+                bind(input.values[0], recipe->k_idxs);
+                bind(input.values[1], recipe->cell_blk);
+                bind(input.values[2], recipe->blk_cells);
+                bind(input.values[3], recipe->blk_pos);
+                bind(input.values[4], recipe->bias);
+                result.add_input(std::move(recipe));
+                break;
+            }
+            case input_kind::qwen4exp_ple: {
+                const auto * qwen_model = dynamic_cast<const llama_model_qwen4exp *>(&model);
+                const auto * qwen_memory = dynamic_cast<const llama_memory_hybrid_idx_context *>(params.mctx);
+                if (qwen_model == nullptr || qwen_memory == nullptr || qwen_memory->get_attn() == nullptr) {
+                    error = "stage program Qwen4 PLE input requires a compatible model and hybrid memory";
+                    return false;
+                }
+                auto recipe = std::make_unique<llama_model_qwen4exp::llm_graph_input_ple>(
+                        *qwen_model, qwen_memory->get_attn());
+                recipe->rows = ggml_new_tensor_1d(context, GGML_TYPE_I32,
+                        static_cast<int64_t>(qwen_model->hparams.ple_n_heads)*params.ubatch.n_tokens);
+                ggml_set_input(recipe->rows);
+                bind(input.values[0], recipe->rows);
+                result.add_input(std::move(recipe));
+                break;
+            }
+            case input_kind::minimax_m3_msa: {
+                if (memory_msa == nullptr || input.minimax_m3_msa_block_size <= 0) {
+                    error = "stage program MiniMax-M3 MSA input has no compatible runtime memory";
+                    return false;
+                }
+                const int64_t n_positions = GGML_PAD(
+                        static_cast<int64_t>(memory_msa->get_n_pos()), input.minimax_m3_msa_block_size);
+                const int64_t n_blocks = n_positions/input.minimax_m3_msa_block_size;
+                const int64_t streams = params.cparams.kv_unified ? 1 : params.ubatch.n_seqs_unq;
+                auto recipe = std::make_unique<skippy_stage_program_minimax_m3_msa_input>(memory_msa,
+                        input.minimax_m3_msa_block_size, input.minimax_m3_msa_local_blocks);
+                if (!input.values[0].empty()) {
+                    recipe->local_bias = ggml_new_tensor_2d(
+                            context, GGML_TYPE_F32, n_blocks, params.ubatch.n_tokens);
+                    ggml_set_input(recipe->local_bias);
+                    bind(input.values[0], recipe->local_bias);
+                }
+                if (!input.values[1].empty()) {
+                    recipe->position_mask = ggml_new_tensor_2d(
+                            context, GGML_TYPE_F32, n_positions, params.ubatch.n_tokens);
+                    ggml_set_input(recipe->position_mask);
+                    bind(input.values[1], recipe->position_mask);
+                }
+                if (!input.values[2].empty()) {
+                    recipe->position_to_cell_indices = ggml_new_tensor_2d(
+                            context, GGML_TYPE_I32, n_positions, streams);
+                    ggml_set_input(recipe->position_to_cell_indices);
+                    bind(input.values[2], recipe->position_to_cell_indices);
+                }
+                if (!input.values[3].empty()) {
+                    recipe->position_to_cell_values = ggml_new_tensor_2d(
+                            context, GGML_TYPE_F32, n_positions, streams);
+                    ggml_set_input(recipe->position_to_cell_values);
+                    bind(input.values[3], recipe->position_to_cell_values);
+                }
+                if (!input.values[4].empty()) {
+                    recipe->cell_blocks = ggml_new_tensor_2d(context, GGML_TYPE_I32,
+                            memory_msa->get_base()->get_n_kv(), streams);
+                    ggml_set_input(recipe->cell_blocks);
+                    bind(input.values[4], recipe->cell_blocks);
+                }
+                result.add_input(std::move(recipe));
+                break;
+            }
+            case input_kind::output_indices: {
+                auto recipe = std::make_unique<llm_graph_input_out_ids>(params.hparams, params.cparams, params.n_outputs);
+                recipe->out_ids = ggml_new_tensor_1d(context, GGML_TYPE_I32, params.n_outputs);
+                ggml_set_input(recipe->out_ids);
+                bind(input.values[0], recipe->out_ids);
+                result.add_input(std::move(recipe));
+                break;
+            }
+            case input_kind::pooling_mean: {
+                auto recipe = std::make_unique<llm_graph_input_mean>(params.cparams);
+                recipe->mean = ggml_new_tensor_2d(context, GGML_TYPE_F32,
+                        params.ubatch.n_tokens, params.ubatch.n_seqs_unq);
+                ggml_set_input(recipe->mean);
+                bind(input.values[0], recipe->mean);
+                result.add_input(std::move(recipe));
+                break;
+            }
+            case input_kind::pooling_indices: {
+                auto recipe = std::make_unique<llm_graph_input_cls>(params.cparams, params.arch);
+                recipe->cls = ggml_new_tensor_1d(context, GGML_TYPE_I32, params.ubatch.n_seqs_unq);
+                ggml_set_input(recipe->cls);
+                bind(input.values[0], recipe->cls);
+                result.add_input(std::move(recipe));
+                break;
+            }
+        }
+    }
+    for (const auto & root : roots) {
+        if (values.count(root.value_id) == 0) {
+            error = "stage program did not bind every owned root";
+            return false;
+        }
+    }
+    for (const auto & entry : values) {
+        if (entry.second->op == GGML_OP_NONE) ggml_build_forward_order(graph, entry.second);
+    }
+    const uint8_t selected_input_branch = token_input ? 1u << 0 : 1u << 1;
+    auto bind_input_choices = [&]() {
+        for (const auto & choice : input_choices) {
+            if (values.count(choice.value_id) != 0) continue;
+            const size_t branch = token_input ? 0 : 1;
+            const auto found = values.find(choice.alternatives[branch]);
+            if (found != values.end()) values.emplace(choice.value_id, found->second);
+        }
+    };
+    bind_input_choices();
+    // The replay plan only depends on the captured program and the selected
+    // input branch, so it was derived once at extraction/installation. A
+    // program assembled without extraction falls back to the same derivation.
+    const replay_plan fallback_plan = replay_plans_prepared ? replay_plan() : build_replay_plan(token_input);
+    const replay_plan & plan = replay_plans_prepared ? replay_plans[token_input ? 0 : 1] : fallback_plan;
+    values.reserve(plan.value_capacity);
+    for (const uint32_t index : plan.operation_indexes) {
+        const operation & operation = operations[index];
+        std::array<ggml_tensor *, GGML_MAX_SRC> sources = {};
+        for (int source = 0; source < GGML_MAX_SRC; ++source) {
+            if (operation.sources[source].empty()) continue;
+            const auto found = values.find(operation.sources[source]);
+            if (found == values.end()) {
+                error = "stage program operation references an unbound value";
+                return false;
+            }
+            sources[source] = found->second;
+        }
+        ggml_tensor * tensor = replay_operation(context, operation, sources, geometry_runtime_values, error);
+        if (tensor == nullptr) {
+            error = "stage program operation " + operation.value_id + " (" + operation.name + ") failed: " + error;
+            for (const auto & source_id : operation.sources) {
+                if (source_id.empty()) continue;
+                const auto producer = std::find_if(operations.begin(), operations.end(), [&](const auto & candidate) {
+                    return candidate.value_id == source_id;
+                });
+                if (producer == operations.end()) continue;
+                error += " [producer=" + producer->value_id + " op=" +
+                        ggml_op_name(static_cast<ggml_op>(producer->op)) +
+                        " source0=" + producer->sources[0] +
+                        " axis=" + std::to_string(producer->dynamic_axis) +
+                        " branches=" + std::to_string(producer->input_choice_branches) + "]";
+                const auto parent = std::find_if(operations.begin(), operations.end(), [&](const auto & candidate) {
+                    return candidate.value_id == producer->sources[0];
+                });
+                if (parent != operations.end()) {
+                    error += " [parent=" + parent->value_id + " op=" +
+                            ggml_op_name(static_cast<ggml_op>(parent->op)) +
+                            " source0=" + parent->sources[0] +
+                            " axis=" + std::to_string(parent->dynamic_axis) +
+                            " branches=" + std::to_string(parent->input_choice_branches) + "]";
+                    const auto grandparent = std::find_if(operations.begin(), operations.end(), [&](const auto & candidate) {
+                        return candidate.value_id == parent->sources[0];
+                    });
+                    if (grandparent != operations.end()) {
+                        error += " [grandparent=" + grandparent->value_id + " op=" +
+                                ggml_op_name(static_cast<ggml_op>(grandparent->op)) +
+                                " source0=" + grandparent->sources[0] +
+                                " source1=" + grandparent->sources[1] +
+                                " axis=" + std::to_string(grandparent->dynamic_axis) +
+                                " branches=" + std::to_string(grandparent->input_choice_branches) + "]";
+                        const auto greatgrandparent = std::find_if(operations.begin(), operations.end(), [&](const auto & candidate) {
+                            return candidate.value_id == grandparent->sources[0];
+                        });
+                        if (greatgrandparent != operations.end()) {
+                            error += " [greatgrandparent=" + greatgrandparent->value_id + " op=" +
+                                    ggml_op_name(static_cast<ggml_op>(greatgrandparent->op)) +
+                                    " source0=" + greatgrandparent->sources[0] +
+                                    " source1=" + greatgrandparent->sources[1] +
+                                    " axis=" + std::to_string(greatgrandparent->dynamic_axis) +
+                                    " branches=" + std::to_string(greatgrandparent->input_choice_branches) + "]";
+                        }
+                    }
+                }
+            }
+            return false;
+        }
+        if (!values.emplace(operation.value_id, tensor).second) {
+            error = "stage program replay generated a duplicate value";
+            return false;
+        }
+        const bool compute = operation.input_choice_branches != 0
+                ? (operation.input_choice_branches & selected_input_branch) != 0
+                : (operation.flags & GGML_TENSOR_FLAG_COMPUTE) != 0;
+        if (compute) ggml_build_forward_expand(graph, tensor);
+        else ggml_build_forward_order(graph, tensor);
+        bind_input_choices();
+    }
+    for (const auto & choice : input_choices) {
+        if (values.count(choice.value_id) == 0) {
+            error = "stage program input choice did not bind its selected alternative";
+            return false;
+        }
+    }
+    for (size_t index = 0; index < activation_exports.size(); ++index) {
+        const auto found = values.find(activation_exports[index]);
+        if (found == values.end()) {
+            error = "stage program activation export is missing";
+            return false;
+        }
+        result.add_skippy_activation_export(found->second, activation_export_token_axes[index], false, true);
+    }
+    if (!outputs.bind(result, values, error)) return false;
+    result.set_outputs(params);
+    return true;
+}
