+static int check_stage_geometry_recipes() {
+    ggml_init_params params = {
+        ggml_tensor_overhead()*32 + ggml_graph_overhead_custom(32, false), nullptr, true,
+    };
+    std::unique_ptr<ggml_context, decltype(&ggml_free)> context(ggml_init(params), ggml_free);
+    if (!context) return 101;
+
+    skippy_stage_geometry_capture_begin();
+    ggml_tensor * reshape_source = ggml_new_tensor_2d(context.get(), GGML_TYPE_F32, 8, 2);
+    ggml_tensor * reshape = ggml_reshape_2d(context.get(), reshape_source, 8, 2);
+    skippy_stage_geometry_recipe found;
+    if (skippy_stage_geometry_lookup(reshape, found)) return 102;
+
+    auto reshape_recipe = skippy_stage_geometry_static(reshape);
+    reshape_recipe.dimensions[0] = skippy_stage_geometry_expression::tokens();
+    reshape_recipe.dimensions[1] = skippy_stage_geometry_expression::constant(2);
+    skippy_stage_geometry_note(reshape, reshape_recipe);
+    if (!skippy_stage_geometry_lookup(reshape, found)) return 103;
+
+    std::array<ggml_tensor *, 10> sources = {};
+    sources[0] = reshape_source;
+    std::array<int64_t, 4> dims;
+    std::array<uint64_t, 4> strides;
+    uint64_t offset = 0;
+    std::string error;
+    if (!skippy_stage_geometry_evaluate_for_test(
+                found, 4, 0, 0, 0, sources, dims, strides, offset, error) ||
+            dims[0] != 4 || dims[1] != 2) {
+        std::fprintf(stderr, "[T,2] geometry recipe failed: %s dims=%lld,%lld\n", error.c_str(),
+                static_cast<long long>(dims[0]), static_cast<long long>(dims[1]));
+        return 104;
+    }
+
+    ggml_tensor * view_source_8 = ggml_new_tensor_2d(context.get(), GGML_TYPE_F32, 8, 4);
+    ggml_tensor * view_source_4 = ggml_new_tensor_2d(context.get(), GGML_TYPE_F32, 4, 4);
+    ggml_tensor * view = ggml_view_2d(context.get(), view_source_8, 8, 2, view_source_8->nb[1], 0);
+    auto view_recipe = skippy_stage_geometry_static(view);
+    view_recipe.dimensions[0] = skippy_stage_geometry_expression::tokens();
+    view_recipe.dimensions[1] = skippy_stage_geometry_expression::constant(2);
+    view_recipe.byte_strides[1] = skippy_stage_geometry_expression::source_stride(0, 1);
+    view_recipe.byte_strides[2] = skippy_stage_geometry_expression::source_stride(0, 1, 2);
+    view_recipe.byte_strides[3] = view_recipe.byte_strides[2];
+    view_recipe.view_offset = skippy_stage_geometry_expression::tokens(4);
+
+    sources[0] = view_source_8;
+    std::array<int64_t, 4> dims_8;
+    std::array<uint64_t, 4> strides_8;
+    uint64_t offset_8 = 0;
+    if (!skippy_stage_geometry_evaluate_for_test(
+                view_recipe, 8, 0, 0, 0, sources, dims_8, strides_8, offset_8, error)) return 105;
+    sources[0] = view_source_4;
+    std::array<int64_t, 4> dims_4;
+    std::array<uint64_t, 4> strides_4;
+    uint64_t offset_4 = 0;
+    if (!skippy_stage_geometry_evaluate_for_test(
+                view_recipe, 4, 0, 0, 0, sources, dims_4, strides_4, offset_4, error)) return 106;
+    if (dims_8[0] != 8 || dims_4[0] != 4 ||
+            strides_8[1] != view_source_8->nb[1] || strides_4[1] != view_source_4->nb[1] ||
+            strides_8[1] == strides_4[1] || offset_8 != 32 || offset_4 != 16) {
+        std::fprintf(stderr,
+                "runtime view recipe failed: dims=%lld/%lld stride=%llu/%llu offset=%llu/%llu\n",
+                static_cast<long long>(dims_8[0]), static_cast<long long>(dims_4[0]),
+                static_cast<unsigned long long>(strides_8[1]), static_cast<unsigned long long>(strides_4[1]),
+                static_cast<unsigned long long>(offset_8), static_cast<unsigned long long>(offset_4));
+        return 107;
+    }
+    ggml_tensor * replayed_view_8 = ggml_view_4d(context.get(), view_source_8,
+            dims_8[0], dims_8[1], dims_8[2], dims_8[3],
+            strides_8[1], strides_8[2], strides_8[3], offset_8);
+    ggml_tensor * replayed_view_4 = ggml_view_4d(context.get(), view_source_4,
+            dims_4[0], dims_4[1], dims_4[2], dims_4[3],
+            strides_4[1], strides_4[2], strides_4[3], offset_4);
+    size_t parameter_offset_8 = 0;
+    size_t parameter_offset_4 = 0;
+    std::memcpy(&parameter_offset_8, replayed_view_8->op_params, sizeof(parameter_offset_8));
+    std::memcpy(&parameter_offset_4, replayed_view_4->op_params, sizeof(parameter_offset_4));
+    if (replayed_view_8->nb[1] != view_source_8->nb[1] || replayed_view_8->view_offs != 32 ||
+            replayed_view_4->nb[1] != view_source_4->nb[1] || replayed_view_4->view_offs != 16 ||
+            parameter_offset_8 != offset_8 || parameter_offset_4 != offset_4) {
+        return 108;
+    }
+    if (!check_permuted_token_axis(256, 256, true) || !check_permuted_token_axis(4, 256, false)) {
+        return 109;
+    }
+    skippy_stage_geometry_capture_end();
+    return 0;
+}
