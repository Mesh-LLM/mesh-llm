diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 4826bfb19..5578ef1f1 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -14,9 +14,12 @@
 #include "llama.h"
 #include "skippy/graph_build_inputs.h"
 #include "skippy/activation.h"
+#include "skippy/stage_program.h"
 
+#include <atomic>
 #include <cinttypes>
 #include <cmath>
+#include <cstdlib>
 #include <cstring>
 #include <limits>
 #include <stdexcept>
@@ -517,6 +520,33 @@ llama_context::~llama_context() {
     // wait for any pending asynchronous copies into the output buffers before they are freed
     synchronize();
 
+    // Field-observable replay accounting: one bounded record per context that
+    // carries an installed stage program, emitted only when SKIPPY_GRAPH_TRACE
+    // is enabled. The environment is read once so tracing off costs a branch.
+    if (stage_program_installs != 0) {
+        static const bool stage_program_trace = [] {
+            const char * value = std::getenv("SKIPPY_GRAPH_TRACE");
+            return value != nullptr && value[0] != '\0' && value[0] != '0';
+        }();
+        if (stage_program_trace) {
+            uint64_t replays = 0;
+            uint64_t domain_misses = 0;
+            uint64_t alternative_hits = 0;
+            for (const auto & entry : stage_programs) {
+                replays += entry.second->replays.load(std::memory_order_relaxed);
+                domain_misses += entry.second->domain_probe_misses.load(std::memory_order_relaxed);
+                alternative_hits += entry.second->alternative_hits.load(std::memory_order_relaxed);
+            }
+            LLAMA_LOG_INFO("SKIPPY-GRAPH-STATS phase=teardown context=%p installs=%llu replays=%llu "
+                    "domain_probe_misses=%llu alternative_hits=%llu\n",
+                    static_cast<const void *>(this),
+                    static_cast<unsigned long long>(stage_program_installs),
+                    static_cast<unsigned long long>(replays),
+                    static_cast<unsigned long long>(domain_misses),
+                    static_cast<unsigned long long>(alternative_hits));
+        }
+    }
+
     // when training, ggml_opt allocates extra buffers through the scheduler, so the sizes no longer match the expectation
     if (!model.hparams.no_alloc && !opt_ctx) {
         for (size_t i = 0; i < backend_ptrs.size(); ++i) {
@@ -672,6 +702,11 @@ void llama_context::sched_reserve() {
 }
 
 void llama_context::sched_reserve(const skippy_graph_build_inputs & graph_build_inputs) {
+    const auto * program = active_stage_program();
+    if (program != nullptr && program->installed &&
+            program->program.computation_generation != computation_generation) {
+        throw std::runtime_error("stage program computation configuration changed after installation");
+    }
     if (!sched_need_reserve) {
         return;
     }
@@ -868,6 +903,169 @@ const skippy_graph_build_inputs & llama_context::get_graph_build_inputs() const
     return graph_build_inputs;
 }
 
+skippy_stage_program_installation * llama_context::active_stage_program() {
+    if (stage_program_capture_target != nullptr) return stage_program_capture_target;
+    if (stage_programs.empty()) return nullptr;
+    const int32_t key = cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP ? cparams.nextn_layer_offset : 0;
+    const auto found = stage_programs.find(key);
+    if (found == stage_programs.end()) {
+        throw std::runtime_error("installed stage program has no branch for nextn offset " +
+                std::to_string(key));
+    }
+    return found->second.get();
+}
+
+skippy_stage_program_installation * llama_context::active_stage_program() const {
+    if (stage_program_capture_target != nullptr) return stage_program_capture_target;
+    if (stage_programs.empty()) return nullptr;
+    const int32_t key = cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP ? cparams.nextn_layer_offset : 0;
+    const auto found = stage_programs.find(key);
+    if (found == stage_programs.end()) {
+        throw std::runtime_error("installed stage program has no branch for nextn offset " +
+                std::to_string(key));
+    }
+    return found->second.get();
+}
+
+const skippy_stage_program_installation * llama_context::get_stage_program_installation() const {
+    return active_stage_program();
+}
+
+bool llama_context::install_stage_program(
+        const skippy_graph_build_inputs & graph_build_inputs,
+        std::string & error) {
+    error.clear();
+    if (!graph_build_inputs.selection.enabled) {
+        error = "stage program installation requires an admitted stage selection";
+        return false;
+    }
+    if (!stage_programs.empty() || stage_program_capture_target != nullptr) {
+        error = "stage program installation is already configured";
+        return false;
+    }
+
+    const int32_t previous_offset = cparams.nextn_layer_offset;
+    const int32_t branch_count = cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP
+            ? std::max<int32_t>(1, model.hparams.n_layer_nextn) : 1;
+    try {
+        for (int32_t branch = 0; branch < branch_count; ++branch) {
+            const int32_t key = cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP ? branch : 0;
+            const int32_t capture_offset = cparams.ctx_type == LLAMA_CONTEXT_TYPE_MTP ? branch : previous_offset;
+            cparams.nextn_layer_offset = capture_offset;
+            auto installation = std::make_unique<skippy_stage_program_installation>();
+            installation->model = &model;
+            installation->capturing = true;
+            stage_program_capture_target = installation.get();
+            sched_need_reserve = true;
+            sched_reserve(graph_build_inputs);
+            installation->capturing = false;
+            if (!installation->installed) {
+                error = "stage program installation did not capture a reusable program for branch " +
+                        std::to_string(capture_offset);
+                stage_program_capture_target = nullptr;
+                stage_programs.clear();
+                cparams.nextn_layer_offset = previous_offset;
+                sched_need_reserve = true;
+                return false;
+            }
+            stage_programs.emplace(key, std::move(installation));
+            ++stage_program_installs;
+            stage_program_capture_target = nullptr;
+        }
+    } catch (const std::exception & exception) {
+        error = exception.what();
+        if (stage_program_capture_target != nullptr) stage_program_capture_target->capturing = false;
+        stage_program_capture_target = nullptr;
+        stage_programs.clear();
+        cparams.nextn_layer_offset = previous_offset;
+        sched_need_reserve = true;
+        return false;
+    }
+    cparams.nextn_layer_offset = previous_offset;
+    sched_need_reserve = true;
+    return true;
+}
+
+bool llama_context::reconfigure_stage_program(std::string & error) {
+    error.clear();
+    const auto * active = active_stage_program();
+    if (active == nullptr || !active->installed) {
+        error = "stage program reconfiguration requires an installed program";
+        return false;
+    }
+    synchronize();
+    auto previous = std::move(stage_programs);
+    try {
+        if (install_stage_program(graph_build_inputs, error)) return true;
+    } catch (const std::exception & exception) {
+        error = exception.what();
+    }
+
+    for (auto & result : gf_res_prev) result.reset();
+    gf_res_reserve.reset();
+    gf_res_prev_active = nullptr;
+    stage_program_capture_target = nullptr;
+    stage_programs = std::move(previous);
+    sched_need_reserve = true;
+    return false;
+}
+
+bool llama_context::refresh_stage_program(std::string & error) {
+    error.clear();
+    const auto * active = active_stage_program();
+    if (active == nullptr || !active->installed ||
+            active->program.computation_generation == computation_generation) return true;
+    return reconfigure_stage_program(error);
+}
+
+bool llama_context::configure_stage_program_nextn_outputs(bool value, bool masked, std::string & error) {
+    error.clear();
+    const auto previous_params = cparams;
+    const auto previous_generation = computation_generation;
+    set_embeddings_nextn(value, masked);
+    if (stage_programs.empty() || computation_generation == previous_generation) return true;
+    if (reconfigure_stage_program(error)) return true;
+
+    cparams = previous_params;
+    computation_generation = previous_generation;
+    return false;
+}
+
+#ifdef LLAMA_STAGE_BUILD_TESTS
+skippy_stage_program_installation * llama_context::get_stage_program_installation_for_test(int32_t nextn_layer_offset) {
+    if (nextn_layer_offset < 0) return active_stage_program();
+    const auto found = stage_programs.find(nextn_layer_offset);
+    return found == stage_programs.end() ? nullptr : found->second.get();
+}
+
+size_t llama_context::get_stage_program_installation_count_for_test() const {
+    return stage_programs.size();
+}
+
+void llama_context::clear_stage_program_for_test() {
+    stage_program_capture_target = nullptr;
+    stage_programs.clear();
+}
+
+bool llama_context::configure_stage_program_gdn_for_test(
+        bool fused_ar, bool fused_chunk, std::string & error) {
+    error.clear();
+    if (cparams.fused_gdn_ar == fused_ar && cparams.fused_gdn_ch == fused_chunk) return true;
+    synchronize();
+    const bool previous_ar = cparams.fused_gdn_ar;
+    const bool previous_chunk = cparams.fused_gdn_ch;
+    const uint64_t previous_generation = computation_generation;
+    cparams.fused_gdn_ar = fused_ar;
+    cparams.fused_gdn_ch = fused_chunk;
+    ++computation_generation;
+    if (stage_programs.empty() || reconfigure_stage_program(error)) return true;
+    cparams.fused_gdn_ar = previous_ar;
+    cparams.fused_gdn_ch = previous_chunk;
+    computation_generation = previous_generation;
+    return false;
+}
+#endif
+
 ggml_backend_sched_t llama_context::get_sched() const {
