+    recording_geometry = true;
+}
+
+void skippy_stage_geometry_capture_end() {
+    recording_geometry = false;
+    recorded_geometry.clear();
+}
+
+#ifdef LLAMA_STAGE_BUILD_TESTS
+bool skippy_stage_geometry_evaluate_for_test(
+        const skippy_stage_geometry_recipe & recipe,
+        int64_t n_tokens,
+        int64_t n_kv,
+        int64_t kv_stream_start,
+        int64_t kv_stream_count,
+        const std::array<ggml_tensor *, 10> & supplied_sources,
+        std::array<int64_t, 4> & dims,
+        std::array<uint64_t, 4> & strides,
+        uint64_t & offset,
+        std::string & error) {
+    static_assert(GGML_MAX_SRC == 10, "stage-program proof source count changed");
+    std::array<ggml_tensor *, GGML_MAX_SRC> sources;
+    std::copy(supplied_sources.begin(), supplied_sources.end(), sources.begin());
+    geometry_runtime runtime;
+    runtime.n_tokens = n_tokens;
+    runtime.n_sequences = 1;
+    runtime.n_kv = n_kv;
+    runtime.kv_stream_start = kv_stream_start;
+    runtime.kv_stream_count = kv_stream_count;
+    return skippy_stage_program_detail::evaluate_geometry(recipe, runtime, sources, dims, strides, offset, error);
+}
+#endif
