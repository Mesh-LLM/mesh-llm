+        std::string binding;
+        int32_t state_kind = -1;
+        state_partition partition = state_partition::primary;
+        int32_t layer = -1;
+        uint32_t type = 0;
+        std::array<int64_t, 4> dimensions = {};
+        std::array<uint64_t, 4> byte_strides = {};
+        int32_t dynamic_axis = -1;
+        ggml_tensor * parameter = nullptr;
+        skippy_stage_geometry_recipe geometry;
