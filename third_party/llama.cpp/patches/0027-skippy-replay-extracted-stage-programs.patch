+#include "stage_program_outputs.h"
+
+#include "llama-graph.h"
+
+void skippy_stage_program_outputs::capture(
+        const llm_graph_result & result,
+        const std::function<std::string(const ggml_tensor *)> & value_id) {
+    const auto scalar = [&](const ggml_tensor * tensor) {
+        return tensor == nullptr ? std::string() : value_id(tensor);
+    };
+    const auto vector = [&](const std::vector<ggml_tensor *> & tensors) {
+        std::vector<std::string> ids;
+        ids.reserve(tensors.size());
+        for (const auto * tensor : tensors) ids.push_back(scalar(tensor));
+        return ids;
+    };
+    logits = scalar(result.t_logits);
+    embeddings = scalar(result.t_embd);
+    pooled_embeddings = scalar(result.t_embd_pooled);
+    nextn = scalar(result.t_h_nextn);
+    layer_inputs = vector(result.t_layer_inp);
+    sampled = vector(result.t_sampled);
+    sampled_probs = vector(result.t_sampled_probs);
+    sampled_logits = vector(result.t_sampled_logits);
+    candidates = vector(result.t_candidates);
+}
+
+bool skippy_stage_program_outputs::bind(
+        llm_graph_result & result,
+        const std::unordered_map<std::string, ggml_tensor *> & values,
+        std::string & error) const {
+    const auto scalar = [&](const std::string & id, ggml_tensor *& tensor) {
+        if (id.empty()) {
+            tensor = nullptr;
+            return true;
+        }
+        const auto found = values.find(id);
+        if (found == values.end() || found->second == nullptr) {
+            error = "stage program output references an unbound value: " + id;
+            return false;
+        }
+        tensor = found->second;
+        return true;
+    };
+    const auto vector = [&](const std::vector<std::string> & ids, std::vector<ggml_tensor *> & tensors) {
+        tensors.resize(ids.size());
+        for (size_t index = 0; index < ids.size(); ++index) {
+            if (!scalar(ids[index], tensors[index])) return false;
+        }
+        return true;
+    };
+    return scalar(logits, result.t_logits) &&
+           scalar(embeddings, result.t_embd) &&
+           scalar(pooled_embeddings, result.t_embd_pooled) &&
+           scalar(nextn, result.t_h_nextn) &&
+           vector(layer_inputs, result.t_layer_inp) &&
+           vector(sampled, result.t_sampled) &&
+           vector(sampled_probs, result.t_sampled_probs) &&
+           vector(sampled_logits, result.t_sampled_logits) &&
+           vector(candidates, result.t_candidates);
+}
