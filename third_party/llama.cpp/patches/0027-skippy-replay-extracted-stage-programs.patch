+
+bool evaluate_expression(
+        const skippy_stage_geometry_expression & expression,
+        const geometry_runtime & runtime,
+        const std::array<ggml_tensor *, GGML_MAX_SRC> & sources,
+        int64_t & result,
+        std::string & error) {
+    int64_t base = 0;
+    switch (expression.value_kind) {
+        case skippy_stage_geometry_expression::kind::constant:
+            result = expression.constant_value;
+            return true;
+        case skippy_stage_geometry_expression::kind::runtime_tokens:
+            base = runtime.n_tokens;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_tokens_per_sequence:
+        case skippy_stage_geometry_expression::kind::runtime_tokens_per_sequence_clamped:
+        case skippy_stage_geometry_expression::kind::runtime_tokens_per_sequence_capped:
+            base = runtime.n_tokens;
+            if (runtime.n_sequences <= 0 || base % runtime.n_sequences != 0) {
+                error = "runtime token count is not divisible by the sequence count";
+                return false;
+            }
+            base /= runtime.n_sequences;
+            if (expression.value_kind == skippy_stage_geometry_expression::kind::runtime_tokens_per_sequence_clamped) {
+                if ((expression.constant_value > 0 && base > std::numeric_limits<int64_t>::max() - expression.constant_value) ||
+                        (expression.constant_value < 0 && base < std::numeric_limits<int64_t>::min() - expression.constant_value)) {
+                    error = "runtime tokens-per-sequence offset overflows";
+                    return false;
+                }
+                base = std::max<int64_t>(0, base + expression.constant_value);
+            } else if (expression.value_kind == skippy_stage_geometry_expression::kind::runtime_tokens_per_sequence_capped) {
+                base = std::min(base, expression.constant_value);
+            }
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_sequences:
+            base = runtime.n_sequences;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_kv_extent:
+            base = runtime.n_kv;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_dsv4_csa_extent:
+            base = runtime.dsv4_csa_extent;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_dsv4_hca_extent:
+            base = runtime.dsv4_hca_extent;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_dsv4_lid_extent:
+            base = runtime.dsv4_lid_extent;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_kv_stream_start:
+            base = runtime.kv_stream_start;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_kv_stream_count:
+            base = runtime.kv_stream_count;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_tokens_per_kv_stream:
+            base = runtime.n_tokens;
+            if (runtime.kv_stream_count <= 0 || base % runtime.kv_stream_count != 0) {
+                error = "runtime token count is not divisible by the KV stream count";
+                return false;
+            }
+            base /= runtime.kv_stream_count;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_recurrent_count:
+            base = runtime.recurrent_count;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_recurrent_extra_count:
+            base = runtime.recurrent_count - runtime.n_sequences;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_recurrent_zero_extent:
+            base = runtime.recurrent_zero >= 0 ? 1 : 0;
+            break;
+        case skippy_stage_geometry_expression::kind::runtime_recurrent_zero_offset:
+        case skippy_stage_geometry_expression::kind::runtime_recurrent_head_offset:
+        case skippy_stage_geometry_expression::kind::runtime_recurrent_extra_offset:
+        case skippy_stage_geometry_expression::kind::runtime_sequence_offset: {
+            if (expression.source < 0 || expression.source >= GGML_MAX_SRC || sources[expression.source] == nullptr ||
+                    expression.axis < 0 || expression.axis >= GGML_MAX_DIMS) {
+                error = "recurrent geometry recipe references an invalid source stride";
+                return false;
+            }
+            int64_t rows = runtime.n_sequences;
+            if (expression.value_kind == skippy_stage_geometry_expression::kind::runtime_recurrent_zero_offset) {
+                rows = std::max<int64_t>(runtime.recurrent_zero, 0);
+            } else if (expression.value_kind == skippy_stage_geometry_expression::kind::runtime_recurrent_head_offset) {
+                rows = runtime.recurrent_head;
+            } else if (expression.value_kind == skippy_stage_geometry_expression::kind::runtime_recurrent_extra_offset) {
+                if (runtime.recurrent_head > 0 && rows > std::numeric_limits<int64_t>::max() - runtime.recurrent_head) {
+                    error = "recurrent geometry row offset overflows";
+                    return false;
+                }
+                rows += runtime.recurrent_head;
+            }
+            const uint64_t stride = sources[expression.source]->nb[expression.axis];
+            if (rows < 0 || stride > static_cast<uint64_t>(std::numeric_limits<int64_t>::max()) ||
+                    (rows != 0 && stride != 0 &&
+                     static_cast<uint64_t>(rows) > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())/stride)) {
+                error = "recurrent geometry offset overflows";
+                return false;
+            }
+            base = rows*static_cast<int64_t>(stride);
+            break;
+        }
+        case skippy_stage_geometry_expression::kind::source_dimension:
+        case skippy_stage_geometry_expression::kind::source_stride:
+        case skippy_stage_geometry_expression::kind::source_stride_per_kv_stream:
+        case skippy_stage_geometry_expression::kind::source_elements: {
+            if (expression.source < 0 || expression.source >= GGML_MAX_SRC || sources[expression.source] == nullptr) {
+                error = "geometry recipe references an unbound source";
+                return false;
+            }
+            if (expression.value_kind == skippy_stage_geometry_expression::kind::source_elements) {
+                base = ggml_nelements(sources[expression.source]);
+            } else {
+                if (expression.axis < 0 || expression.axis >= GGML_MAX_DIMS) {
+                    error = "geometry recipe references an invalid source axis";
+                    return false;
+                }
+                base = expression.value_kind == skippy_stage_geometry_expression::kind::source_dimension
+                        ? sources[expression.source]->ne[expression.axis]
+                        : static_cast<int64_t>(sources[expression.source]->nb[expression.axis]);
+                if (expression.value_kind == skippy_stage_geometry_expression::kind::source_stride_per_kv_stream) {
+                    if (runtime.kv_stream_count <= 0 || base % runtime.kv_stream_count != 0) {
+                        error = "source stride is not divisible by the KV stream count";
+                        return false;
+                    }
+                    base /= runtime.kv_stream_count;
+                }
+            }
+            break;
+        }
+    }
+    if (expression.divisor <= 0 || expression.multiplier < 0 || base < 0 ||
+            (base != 0 && expression.multiplier > std::numeric_limits<int64_t>::max()/base)) {
+        error = "geometry recipe arithmetic is invalid or overflows";
+        return false;
+    }
+    const int64_t product = base*expression.multiplier;
+    if (product % expression.divisor != 0) {
+        error = "geometry recipe division is not exact";
+        return false;
+    }
+    const int64_t quotient = product/expression.divisor;
+    if ((expression.addend > 0 && quotient > std::numeric_limits<int64_t>::max() - expression.addend) ||
+            (expression.addend < 0 && quotient < std::numeric_limits<int64_t>::min() - expression.addend)) {
+        error = "geometry recipe addition overflows";
+        return false;
+    }
+    result = quotient + expression.addend;
+    return true;
+}
+
+bool evaluate_geometry_impl(
+        const skippy_stage_geometry_recipe & recipe,
+        const geometry_runtime & runtime,
+        const std::array<ggml_tensor *, GGML_MAX_SRC> & sources,
+        std::array<int64_t, 4> & dims,
+        std::array<uint64_t, 4> & strides,
+        uint64_t & offset,
+        std::string & error) {
+    for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+        int64_t stride = 0;
+        if (!evaluate_expression(recipe.dimensions[axis], runtime, sources, dims[axis], error) || dims[axis] < 0 ||
+                !evaluate_expression(recipe.byte_strides[axis], runtime, sources, stride, error) || stride < 0) {
+            if (error.empty()) error = "geometry recipe produced an invalid dimension or stride";
+            return false;
+        }
+        strides[axis] = static_cast<uint64_t>(stride);
+    }
+    int64_t signed_offset = 0;
+    if (!evaluate_expression(recipe.view_offset, runtime, sources, signed_offset, error) || signed_offset < 0) {
+        if (error.empty()) error = "geometry recipe produced an invalid view offset";
+        return false;
+    }
+    offset = static_cast<uint64_t>(signed_offset);
+    return true;
+}
