+                    static_cast<ggml_op_pool>(operation_parameter<int32_t>(operation, 0)),
+                    operation_parameter<int32_t>(operation, 1),
+                    operation_parameter<int32_t>(operation, 2),
+                    operation_parameter<int32_t>(operation, 3),
+                    operation_parameter<int32_t>(operation, 4),
+                    static_cast<float>(operation_parameter<int32_t>(operation, 5)),
+                    static_cast<float>(operation_parameter<int32_t>(operation, 6)));
+            break;
+        case GGML_OP_ARANGE:
+            tensor = ggml_arange(context,
+                    operation_parameter<float>(operation, 0),
+                    operation_parameter<float>(operation, 1),
+                    operation_parameter<float>(operation, 2));
+            break;
+        default:
+            error = "stage program encountered an unsupported operation during replay";
+            return nullptr;
+    }
+    if (tensor == nullptr) {
+        error = "stage program operation constructor failed";
+        return nullptr;
+    }
+    if (tensor->type != static_cast<ggml_type>(operation.type)) {
+        error = "stage program operation constructor changed the recorded value type";
+        return nullptr;
+    }
+    if (operation.alias_source >= 0 &&
+            (operation.alias_source >= GGML_MAX_SRC || sources[operation.alias_source] == nullptr ||
+             program_canonical_storage(tensor) != program_canonical_storage(sources[operation.alias_source]))) {
+        error = "stage program operation constructor did not preserve the recorded storage alias";
+        return nullptr;
+    }
+    if (!operation.name.empty()) ggml_set_name(tensor, operation.name.c_str());
+    return tensor;
+}
+
+}
+
+bool skippy_stage_program_supports_operation(uint32_t op) {
+    return skippy_stage_program_detail::has_supported_op(static_cast<ggml_op>(op));
+}
