+static bool check_permuted_token_axis(int64_t n_tokens, int64_t width, bool expect_ambiguous) {
+    llm_graph_result result(16);
+    ggml_tensor * source = ggml_new_tensor_4d(result.get_ctx(), GGML_TYPE_I32, n_tokens, width, width, 1);
+    auto input = std::make_unique<llm_graph_input_pos>(1);
+    input->pos = source;
+    result.add_input(std::move(input));
+
+    ggml_tensor * permuted = ggml_permute(result.get_ctx(), source, 1, 2, 0, 3);
+    ggml_build_forward_expand(result.get_gf(), permuted);
+    const int32_t axis = skippy_stage_program_builder_token_axis(result, permuted);
+    return axis == 1 && permuted->ne[axis] == n_tokens &&
+            (permuted->ne[1] == permuted->ne[2]) == expect_ambiguous;
+}
