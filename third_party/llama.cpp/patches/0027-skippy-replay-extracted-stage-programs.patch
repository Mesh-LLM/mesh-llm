+static int check_stage_program_rejects_unsupported_operation(llama_model & model) {
+    if (!skippy_stage_program_supports_operation(GGML_OP_ARANGE) ||
+            skippy_stage_program_supports_operation(GGML_OP_SUM)) {
+        std::fprintf(stderr, "stage program operation allow-list lost its fail-closed boundary\n");
+        return 185;
+    }
+    std::vector<llama_token> token_values(4, 3);
+    llm_graph_params params{};
+    params.arch = model.arch;
+    params.hparams = model.hparams;
+    params.gtype = LLM_GRAPH_TYPE_DEFAULT;
+    params.cparams.n_ctx = params.cparams.n_ctx_seq = 32;
+    params.cparams.n_seq_max = 1;
+    params.ubatch.n_tokens = params.ubatch.n_seq_tokens = 4;
+    params.ubatch.n_seqs = params.ubatch.n_seqs_unq = 1;
+    params.ubatch.token = token_values.data();
+    params.n_outputs = 1;
+    params.build_inputs.selection.layer_end = 1;
+    llm_graph_result capture(64);
+    params.res = &capture;
+    llm_graph_context builder(params);
+    auto embeddings = std::make_unique<llm_graph_input_embd>(model.hparams.n_embd_inp());
+    embeddings->tokens = ggml_new_tensor_1d(capture.get_ctx(), GGML_TYPE_I32, 4);
+    ggml_tensor * tokens = embeddings->tokens;
+    capture.add_input(std::move(embeddings));
+
+    ggml_tensor * rows = ggml_get_rows(capture.get_ctx(), model.tok_embd, tokens);
+    capture.t_logits = ggml_sum(capture.get_ctx(), rows);
+    ggml_build_forward_expand(capture.get_gf(), capture.t_logits);
+    skippy_stage_slice_selection selection;
+    selection.layer_end = 1;
+    selection.source_graph = capture.get_gf();
+    selection.request_inputs = {tokens};
+    for (int32_t index = 0; index < ggml_graph_n_nodes(capture.get_gf()); ++index) {
+        selection.node_indices.push_back(index);
+    }
+
+    skippy_stage_program program;
+    std::string error;
+    if (skippy_extract_stage_program(model, capture, selection, 4, 1, 1,
+                LLM_GRAPH_TYPE_DEFAULT, {}, program, error) ||
+            error.find("does not support operation SUM") == std::string::npos) {
+        std::fprintf(stderr, "unsupported operation was not rejected precisely: %s\n", error.c_str());
+        return 184;
+    }
+    return 0;
+}
+
+static int check_stage_program_replay(const char * model_path) {
+    std::unique_ptr<llama_model, decltype(&llama_model_free)> model(load_model(model_path), llama_model_free);
+    if (!model || llama_model_n_layer(model.get()) < 2) return 110;
+    if (const int rc = check_stage_program_msa_inputs(*model)) return rc;
+    if (const int rc = check_stage_program_hidden_inputs(*model)) return rc;
+    if (const int rc = check_stage_program_ignores_unused_unsupported_input(*model)) return rc;
+    if (const int rc = check_stage_program_rejects_unsupported_operation(*model)) return rc;
+    model->hparams.f_embedding_scale = 0.5f;
+    auto params = make_context_params(2);
+    auto imported_params = params;
+    imported_params.n_ctx = 512;
+    imported_params.n_batch = model->hparams.n_embd_inp();
+    imported_params.n_ubatch = model->hparams.n_embd_inp();
+
+    skippy_graph_build_inputs first_inputs, last_inputs, full_inputs;
+    const int32_t layers = llama_model_n_layer(model.get());
+    if (!make_stage_inputs(model.get(), 2, 0, 1, first_inputs) ||
+            !make_stage_inputs(model.get(), 2, 1, layers, last_inputs) ||
+            !make_stage_inputs(model.get(), 2, 0, layers, full_inputs)) return 111;
+    for (auto * inputs : {&first_inputs, &last_inputs, &full_inputs}) {
+        auto execution_contract = nlohmann::json::parse(inputs->execution_contract);
+        execution_contract["decoder_embeddings"] = inputs->resident_tensor_names;
+        inputs->execution_contract = execution_contract.dump();
+    }
+    std::unique_ptr<llama_context, decltype(&llama_free)> first(
+            llama_init_from_model_with_graph_inputs(model.get(), params, first_inputs), llama_free);
+    std::unique_ptr<llama_context, decltype(&llama_free)> last(
+            llama_init_from_model_with_graph_inputs(model.get(), params, last_inputs), llama_free);
+    std::unique_ptr<llama_context, decltype(&llama_free)> ambiguous(
+            llama_init_from_model_with_graph_inputs(model.get(), imported_params, last_inputs), llama_free);
+    std::unique_ptr<llama_context, decltype(&llama_free)> compatibility(
+            llama_init_from_model_with_graph_inputs(model.get(), params, first_inputs), llama_free);
+    auto mismatched_params = params;
+    mismatched_params.n_ctx = 1024;
+    std::unique_ptr<llama_context, decltype(&llama_free)> mismatched(
+            llama_init_from_model_with_graph_inputs(model.get(), mismatched_params, first_inputs), llama_free);
+
+    const char * old_reuse_setting = std::getenv("LLAMA_GRAPH_REUSE_DISABLE");
+    const std::string saved_reuse_setting = old_reuse_setting ? old_reuse_setting : "";
+    const bool had_reuse_setting = old_reuse_setting != nullptr;
+    set_reuse_environment("1");
+    std::unique_ptr<llama_context, decltype(&llama_free)> reference(
+            llama_init_from_model_with_graph_inputs(model.get(), params, full_inputs), llama_free);
+    set_reuse_environment(had_reuse_setting ? saved_reuse_setting.c_str() : nullptr);
+    if (!first || !last || !ambiguous || !reference || !compatibility || !mismatched) return 112;
+
+    std::vector<skippy_activation_port_shape> reserved_imports;
+    if (!ambiguous->get_input_activation_frontier(reserved_imports) || reserved_imports.size() != 1 ||
+            reserved_imports[0].dimensions[0] != static_cast<int64_t>(ambiguous->n_ubatch()) ||
+            reserved_imports[0].token_axis != 1 ||
+            reserved_imports[0].token_axis_explicit) {
+        std::fprintf(stderr, "ambiguous reserved import did not retain inferred-axis provenance\n");
+        return 135;
+    }
+
+    std::string install_error;
+    if (!first->install_stage_program(first_inputs, install_error) ||
+            !last->install_stage_program(last_inputs, install_error) ||
+            !ambiguous->install_stage_program(last_inputs, install_error) ||
+            !compatibility->install_stage_program(first_inputs, install_error) ||
+            !mismatched->install_stage_program(first_inputs, install_error)) {
+        std::fprintf(stderr, "stage program setup installation failed: %s\n", install_error.c_str());
+        return 113;
+    }
+
+    const skippy_stage_program_installation * first_installation = first->get_stage_program_installation();
+    const skippy_stage_program_installation * last_installation = last->get_stage_program_installation();
+    if (first_installation == nullptr || last_installation == nullptr ||
+            !first_installation->installed || !last_installation->installed) return 134;
+    if (!ambiguous->get_input_activation_frontier(reserved_imports) ||
+            !reserved_imports[0].token_axis_explicit) return 136;
+    const skippy_stage_program & first_program = first_installation->program;
+    const skippy_stage_program & last_program = last_installation->program;
+
+    std::set<std::string> operation_ids;
+    size_t geometry_recipes = 0;
+    size_t runtime_geometry_recipes = 0;
+    size_t state_roots = 0;
+    bool output_indices = false;
+    uint8_t scaled_input_branches = 0;
+    for (const auto * program : {&first_program, &last_program}) {
+        for (const auto & input : program->inputs) {
+            output_indices |= input.kind == skippy_stage_program::input_kind::output_indices;
+        }
+        for (const auto & root : program->roots) {
+            state_roots += root.kind == skippy_stage_program::root_kind::state;
+        }
+        for (const auto & operation : program->operations) {
+            if (!operation_ids.insert(operation.value_id).second) {
+                std::fprintf(stderr, "stage program generated a colliding operation ValueId: %s\n", operation.value_id.c_str());
+                return 114;
+            }
+            if (operation.op == GGML_OP_RESHAPE || operation.op == GGML_OP_VIEW || operation.op == GGML_OP_CONT) {
+                ++geometry_recipes;
+                for (const auto & expression : operation.geometry.dimensions) {
+                    runtime_geometry_recipes += expression.value_kind !=
+                            skippy_stage_geometry_expression::kind::constant;
+                }
+                for (const auto & expression : operation.geometry.byte_strides) {
+                    runtime_geometry_recipes += expression.value_kind !=
+                            skippy_stage_geometry_expression::kind::constant;
+                }
+                runtime_geometry_recipes += operation.geometry.view_offset.value_kind !=
+                        skippy_stage_geometry_expression::kind::constant;
+            }
+            if (operation.op == GGML_OP_SCALE) scaled_input_branches |= operation.input_choice_branches;
+        }
+    }
+    if (first_program.activation_exports.empty() || last_program.activation_imports.empty() ||
+            first_program.activation_exports != last_program.activation_imports ||
+            geometry_recipes == 0 || runtime_geometry_recipes == 0 || state_roots < 4 || !output_indices ||
+            first_program.maximum_sequences != 2 || last_program.maximum_sequences != 2 ||
+            first_program.input_choices.size() != 1 || scaled_input_branches != 3) {
+        std::fprintf(stderr,
+                "stage program omitted required proof evidence: exports=%zu imports=%zu match=%d geometry=%zu runtime_geometry=%zu state=%zu output_ids=%d max_sequences=%u/%u choices=%zu scaled_branches=%u\n",
+                first_program.activation_exports.size(), last_program.activation_imports.size(),
+                first_program.activation_exports == last_program.activation_imports,
+                geometry_recipes, runtime_geometry_recipes, state_roots, output_indices,
+                first_program.maximum_sequences, last_program.maximum_sequences,
+                first_program.input_choices.size(), scaled_input_branches);
+        return 115;
+    }
+
+    llama_batch compatibility_batch = llama_batch_init(1, 0, 2);
+    compatibility_batch.n_tokens = 1;
+    compatibility_batch.token[0] = 17;
+    compatibility_batch.pos[0] = 0;
+    compatibility_batch.n_seq_id[0] = 1;
+    compatibility_batch.seq_id[0][0] = 0;
+    compatibility_batch.logits[0] = 1;
+
+    auto * compatibility_installation = compatibility->get_stage_program_installation_for_test();
+    auto * mismatched_installation = mismatched->get_stage_program_installation_for_test();
+    if (compatibility_installation == nullptr || mismatched_installation == nullptr ||
+            !compatibility_installation->installed || !mismatched_installation->installed) {
+        llama_batch_free(compatibility_batch);
+        return 116;
+    }
+    set_reuse_environment("1");
+
+    bool rejected_model_binding = false;
+    std::unique_ptr<llama_model, decltype(&llama_model_free)> other_model(load_model(model_path), llama_model_free);
+    if (!other_model) {
+        llama_batch_free(compatibility_batch);
+        return 128;
+    }
+    const llama_model * installed_model = compatibility_installation->model;
+    compatibility_installation->model = other_model.get();
+    try {
+        compatibility->decode(compatibility_batch, first_inputs);
+    } catch (const std::runtime_error & exception) {
+        rejected_model_binding = std::string(exception.what()).find(
+                "not bound to this immutable model configuration") != std::string::npos;
+    }
+    compatibility_installation->model = installed_model;
+    if (!rejected_model_binding) {
+        llama_batch_free(compatibility_batch);
+        return 129;
+    }
+
+    bool rejected_same_shape_stride = false;
+    skippy_stage_program stride_mismatch_program = first_program;
+    for (auto & root : stride_mismatch_program.roots) {
+        if (root.kind != skippy_stage_program::root_kind::state) continue;
+        ++root.byte_strides[1];
+        break;
+    }
+    compatibility_batch.seq_id[0][0] = 1;
+    compatibility_installation->program = stride_mismatch_program;
+    try {
+        compatibility->decode(compatibility_batch, first_inputs);
+    } catch (const std::runtime_error & exception) {
+        rejected_same_shape_stride = std::string(exception.what()).find(
+                "state binding does not match the captured type, capacity, or layout") != std::string::npos;
+    }
+    compatibility_installation->program = first_program;
+    bool rejected_stale_computation = false;
+    if (!compatibility->set_adapter_cvec(nullptr, 0, 0, 0, 0)) {
+        llama_batch_free(compatibility_batch);
+        return 131;
+    }
+    compatibility_batch.pos[0] = 1;
+    try {
+        compatibility->decode(compatibility_batch, first_inputs);
+    } catch (const std::runtime_error & exception) {
+        rejected_stale_computation = std::string(exception.what()).find(
+                "computation configuration changed after installation") != std::string::npos;
+    }
+    llama_batch_free(compatibility_batch);
+    if (!rejected_same_shape_stride || !rejected_stale_computation) return 130;
+
+    const std::vector<std::function<void(llama_context &)>> configuration_changes = {
+        [](llama_context & ctx) { ctx.set_embeddings(!ctx.get_cparams().embeddings); },
+        [](llama_context & ctx) { ctx.set_embeddings_nextn(true, false); },
+        [](llama_context & ctx) { ctx.set_embeddings_nextn(false, true); },
+        [](llama_context & ctx) { ctx.set_embeddings_layer_inp(0, true); },
+        [](llama_context & ctx) { ctx.set_nextn_layer_offset(1); },
+        [](llama_context & ctx) { ctx.set_causal_attn(!ctx.get_cparams().causal_attn); },
+        [](llama_context & ctx) { ctx.set_warmup(!ctx.get_cparams().warmup); },
+    };
+    for (const auto & change : configuration_changes) {
+        std::unique_ptr<llama_context, decltype(&llama_free)> changed(
+                llama_init_from_model_with_graph_inputs(model.get(), params, first_inputs), llama_free);
+        if (!changed || !changed->install_stage_program(first_inputs, install_error)) return 166;
+        const auto & current = changed->get_cparams();
+        changed->set_embeddings(current.embeddings);
+        changed->set_embeddings_nextn(current.embeddings_nextn, current.embeddings_nextn_masked);
+        changed->set_embeddings_layer_inp(0, current.embeddings_layer_inp[0]);
+        changed->set_nextn_layer_offset(current.nextn_layer_offset);
+        changed->set_causal_attn(current.causal_attn);
+        changed->set_warmup(current.warmup);
+        changed->sched_reserve(first_inputs);
+        change(*changed);
+        bool rejected = false;
+        try {
+            changed->sched_reserve(first_inputs);
+        } catch (const std::runtime_error & exception) {
+            rejected = std::string(exception.what()).find(
+                    "computation configuration changed after installation") != std::string::npos;
+        }
+        if (!rejected) return 167;
+        if (changed->get_cparams().embeddings_layer_inp[0]) changed->set_embeddings_layer_inp(0, false);
+        if (!changed->reconfigure_stage_program(install_error)) {
+            std::fprintf(stderr, "stage program reconfiguration failed: %s\n", install_error.c_str());
+            return 168;
+        }
+        changed->sched_reserve(first_inputs);
+    }
+
+    {
+        std::unique_ptr<llama_context, decltype(&llama_free)> configured(
+                llama_init_from_model_with_graph_inputs(model.get(), params, first_inputs), llama_free);
+        if (!configured || !configured->install_stage_program(first_inputs, install_error)) return 169;
+        if (!configured->configure_stage_program_nextn_outputs(true, false, install_error)) return 170;
+        configured->sched_reserve(first_inputs);
+        skippy_stage_program_reset_test_counters();
+        if (!configured->configure_stage_program_nextn_outputs(true, false, install_error) ||
+                skippy_stage_program_arch_builder_calls() != 0 ||
+                skippy_stage_program_selector_calls() != 0) return 171;
+        if (!configured->configure_stage_program_nextn_outputs(false, false, install_error)) return 172;
+        configured->sched_reserve(first_inputs);
+        configured->set_embeddings(true);
+        if (!configured->refresh_stage_program(install_error)) return 182;
+        configured->sched_reserve(first_inputs);
+        configured->set_embeddings(false);
+        if (!configured->refresh_stage_program(install_error)) return 183;
+        configured->sched_reserve(first_inputs);
+    }
+
+    skippy_stage_program state_mismatch_program = first_program;
+    const llama_cparams & mismatched_cparams = mismatched->get_cparams();
+    state_mismatch_program.context_size = mismatched_cparams.n_ctx;
+    state_mismatch_program.context_sequence_size = mismatched_cparams.n_ctx_seq;
+    state_mismatch_program.maximum_sequences = mismatched_cparams.n_seq_max;
+    state_mismatch_program.causal_attention = mismatched_cparams.causal_attn;
+    state_mismatch_program.flash_attention = mismatched_cparams.flash_attn;
+    state_mismatch_program.unified_kv = mismatched_cparams.kv_unified;
+    llama_batch mismatched_batch = llama_batch_init(1, 0, 2);
+    mismatched_batch.n_tokens = 1;
+    mismatched_batch.token[0] = 17;
+    mismatched_batch.pos[0] = 0;
+    mismatched_batch.n_seq_id[0] = 1;
+    mismatched_batch.seq_id[0][0] = 0;
+    mismatched_batch.logits[0] = 1;
+    bool rejected_state_layout = false;
+    mismatched_installation->program = state_mismatch_program;
+    try {
+        mismatched->decode(mismatched_batch, first_inputs);
+    } catch (const std::runtime_error & exception) {
+        rejected_state_layout = std::string(exception.what()).find(
+                "state binding does not match the captured type, capacity, or layout") != std::string::npos;
+    }
+    llama_batch_free(mismatched_batch);
+    if (!rejected_state_layout) return 127;
+
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model.get()));
+    const int32_t n_embd = model->hparams.n_embd_inp();
+    llama_batch token_batch = llama_batch_init(4, 0, 2);
+    llama_batch embedding_batch = llama_batch_init(4, n_embd, 2);
+    int result = 0;
+    std::array<llama_pos, 2> positions = {};
+    bool observed_changed_sequences = false;
+    bool observed_partial_outputs = false;
+    bool observed_zero_outputs = false;
+    bool observed_token_input = false;
+    bool observed_embedding_input = false;
+    for (int step = 0; step < 4 && result == 0; ++step) {
+        llama_batch & batch = step % 2 == 0 ? token_batch : embedding_batch;
+        batch.n_tokens = step == 0 ? 4 : 1;
+        for (int32_t row = 0; row < batch.n_tokens; ++row) {
+            const llama_seq_id sequence = step == 0 && row >= 2 ? 1 : 0;
+            if (batch.token != nullptr) batch.token[row] = (17 + step + row) % n_vocab;
+            if (batch.embd != nullptr) {
+                for (int32_t column = 0; column < n_embd; ++column) {
+                    batch.embd[static_cast<size_t>(row)*n_embd + column] =
+                            static_cast<float>((step + row + column) % 17 - 8)*0.01f;
+                }
+            }
+            batch.pos[row] = positions[sequence]++;
+            batch.n_seq_id[row] = 1;
+            batch.seq_id[row][0] = sequence;
+            batch.logits[row] = step == 0 ? (row == 1 || row == 3) : step == 2;
+        }
+        const uint32_t runtime_sequences = step == 0 ? 2 : 1;
+        observed_changed_sequences |= first_program.captured_sequences != runtime_sequences;
+        observed_partial_outputs |= step == 0;
+        observed_zero_outputs |= step == 1;
+        observed_token_input |= batch.token != nullptr;
+        observed_embedding_input |= batch.embd != nullptr;
+        if (reference->decode(batch, full_inputs)) { result = 117; break; }
+        std::vector<float> expected(static_cast<size_t>(batch.n_tokens)*n_vocab);
+        for (int32_t row = 0; row < batch.n_tokens; ++row) {
+            if (!batch.logits[row]) continue;
+            const float * logits = llama_get_logits_ith(reference.get(), row);
+            if (logits == nullptr) { result = 118; break; }
+            std::copy(logits, logits + n_vocab, expected.begin() + static_cast<size_t>(row)*n_vocab);
+        }
+        if (result) break;
+
+        skippy_stage_program_reset_test_counters();
+        if (first->decode(batch, first_inputs)) { result = 119; break; }
+        if (batch.embd != nullptr) {
+            ggml_cgraph * replay_graph = first->get_gf_res_prev_active()->get_gf();
+            bool found_inactive_token_gather = false;
+            for (const auto & operation : first_program.operations) {
+                if (operation.op != GGML_OP_GET_ROWS || operation.input_choice_branches != 1 || operation.name.empty()) continue;
+                for (int node_index = 0; node_index < ggml_graph_n_nodes(replay_graph); ++node_index) {
+                    const ggml_tensor * node = ggml_graph_node(replay_graph, node_index);
+                    if (node->op == GGML_OP_GET_ROWS && operation.name == ggml_get_name(node)) {
+                        if (node->flags & GGML_TENSOR_FLAG_COMPUTE) {
+                            result = 132;
+                        }
+                        found_inactive_token_gather = true;
+                        break;
+                    }
+                }
+            }
+            if (!found_inactive_token_gather) result = 133;
+            if (result) break;
+        }
+        first->synchronize();
+        const auto & ports = first->get_gf_res_prev_active()->get_skippy_activation_exports();
+        auto replay_inputs = last_inputs;
+        replay_inputs.activation_frontier.clear();
+        std::vector<std::vector<uint8_t>> payloads;
+        for (const auto & port : ports) {
+            payloads.emplace_back(ggml_nbytes(port.tensor));
+            ggml_backend_tensor_get(port.tensor, payloads.back().data(), 0, payloads.back().size());
+            skippy_activation_frontier_part_input part;
+            part.values = payloads.back().data();
+            part.payload_bytes = payloads.back().size();
+            part.ggml_type = port.tensor->type;
+            part.rank = GGML_MAX_DIMS;
+            part.token_axis = port.token_axis;
+            for (int axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                part.dimensions[axis] = port.tensor->ne[axis];
+                part.byte_strides[axis] = port.tensor->nb[axis];
+            }
+            part.pos_start = batch.pos[0];
+            for (int32_t row = 0; row < batch.n_tokens; ++row) {
+                const llama_seq_id sequence = batch.seq_id[row][0];
+                if (part.sequence_ids.empty() || part.sequence_ids.back() != sequence) {
+                    part.sequence_ids.push_back(sequence);
+                    part.sequence_offsets.push_back(row);
+                    part.sequence_pos_starts.push_back(batch.pos[row]);
+                }
+            }
+            replay_inputs.activation_frontier.push_back(part);
+        }
+        if (ports.empty()) { result = 120; break; }
+        if (last->decode(batch, replay_inputs)) { result = 121; break; }
+        if (skippy_stage_program_arch_builder_calls() != 0 || skippy_stage_program_selector_calls() != 0) {
+            std::fprintf(stderr, "stage replay called builder=%llu selector=%llu\n",
+                    static_cast<unsigned long long>(skippy_stage_program_arch_builder_calls()),
+                    static_cast<unsigned long long>(skippy_stage_program_selector_calls()));
+            result = 122;
+            break;
+        }
+        for (int32_t row = 0; row < batch.n_tokens; ++row) {
+            if (!batch.logits[row]) continue;
+            const float * actual = llama_get_logits_ith(last.get(), row);
+            if (actual == nullptr) { result = 123; break; }
+            for (int32_t token = 0; token < n_vocab; ++token) {
+                const float target = expected[static_cast<size_t>(row)*n_vocab + token];
+                if (!std::isfinite(actual[token]) || std::abs(actual[token] - target) > 1e-5f) {
+                    result = 124;
+                    break;
+                }
+            }
+        }
+    }
+    if (result == 0 && (!observed_changed_sequences || !observed_partial_outputs || !observed_zero_outputs ||
+            !observed_token_input || !observed_embedding_input)) result = 125;
+    set_reuse_environment(had_reuse_setting ? saved_reuse_setting.c_str() : nullptr);
+    llama_batch_free(token_batch);
+    llama_batch_free(embedding_batch);
+    if (result) std::fprintf(stderr, "stage program replay proof failed: %d\n", result);
+    return result;
+}
+#endif
+
 int main(int argc, char ** argv) {
