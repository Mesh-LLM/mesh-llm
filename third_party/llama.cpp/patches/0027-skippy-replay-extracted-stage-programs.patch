+static int check_stage_program_hidden_inputs(llama_model & model) {
+    const int64_t width = model.hparams.n_embd;
+    std::vector<llama_token> tokens(8, 3);
+    std::vector<llama_pos> positions(8, 2);
+    std::vector<float> hidden(width * 8, 0.25f);
+    std::vector<float> embeddings(width * 10, 0.75f);
+    for (bool token_mode : {true, false}) {
+        llm_graph_params params{};
+        params.arch = model.arch;
+        params.hparams = model.hparams;
+        params.gtype = LLM_GRAPH_TYPE_DECODER_MTP;
+        params.cparams.n_ctx = params.cparams.n_ctx_seq = 32;
+        params.cparams.n_seq_max = 1;
+        params.ubatch.n_tokens = params.ubatch.n_seq_tokens = 8;
+        params.ubatch.n_seqs = params.ubatch.n_seqs_unq = 1;
+        params.ubatch.token = token_mode ? tokens.data() : nullptr;
+        params.ubatch.embd = hidden.data();
+        params.ubatch.pos = positions.data();
+        params.n_outputs = 1;
+        params.build_inputs.selection.layer_end = 1;
+        params.build_inputs.mtp_embeddings.values = embeddings.data();
+        params.build_inputs.mtp_embeddings.token_count = 10;
+        params.build_inputs.mtp_embeddings.n_embd = width;
+        skippy_stage_program program;
+        std::string error;
+        {
+            llm_graph_result capture(128);
+            params.res = &capture;
+            llm_graph_context builder(params);
+            auto input = std::make_unique<llm_graph_input_embd_h>(width);
+            input->tokens = ggml_new_tensor_1d(capture.get_ctx(), GGML_TYPE_I32, 8);
+            input->embd = ggml_new_tensor_2d(capture.get_ctx(), GGML_TYPE_F32, width, 8);
+            input->h = ggml_new_tensor_2d(capture.get_ctx(), GGML_TYPE_F32, width, 8);
+            auto * selected = token_mode ? ggml_get_rows(capture.get_ctx(), model.tok_embd, input->tokens) : input->embd;
+            capture.t_logits = ggml_add(capture.get_ctx(), selected, input->h);
+            skippy_stage_slice_selection selection;
+            selection.layer_end = 1;
+            selection.request_inputs = {token_mode ? input->tokens : input->embd, input->h};
+            capture.add_input(std::move(input));
+            ggml_build_forward_expand(capture.get_gf(), capture.t_logits);
+            selection.source_graph = capture.get_gf();
+            for (int i = 0; i < ggml_graph_n_nodes(capture.get_gf()); ++i) selection.node_indices.push_back(i);
+            if (!skippy_extract_stage_program(model, capture, selection, 8, 1, 1,
+                        LLM_GRAPH_TYPE_DECODER_MTP, {}, program, error)) {
+                std::fprintf(stderr, "MTP hidden extraction: %s\n", error.c_str());
+                return 173;
+            }
+        }
+        for (uint32_t count : {4u, 1u}) {
+            llm_graph_result replay(128);
+            params.res = &replay;
+            params.ubatch.n_tokens = params.ubatch.n_seq_tokens = count;
+            skippy_stage_program runtime_program = program;
+            runtime_program.token_generation = count == 1;
+            if (!runtime_program.instantiate(model, params, error)) {
+                std::fprintf(stderr, "MTP hidden replay: %s\n", error.c_str());
+                return 174;
+            }
+            auto * input = dynamic_cast<llm_graph_input_embd_h *>(replay.inputs.at(0).get());
+            if (!input || !input->h || input->h->ne[1] != count) return 175;
+            std::unique_ptr<ggml_backend_buffer, decltype(&ggml_backend_buffer_free)> buffer(
+                    ggml_backend_alloc_ctx_tensors_from_buft(replay.get_ctx(), ggml_backend_cpu_buffer_type()),
+                    ggml_backend_buffer_free);
+            if (!buffer) return 176;
+            replay.set_inputs(&params.ubatch, params.build_inputs);
+            if (std::memcmp(input->h->data, hidden.data(), width * count * sizeof(float))) return 177;
+            if (token_mode) {
+                if (std::memcmp(input->tokens->data, tokens.data(), count * sizeof(llama_token))) return 178;
+            } else if (std::memcmp(input->embd->data, embeddings.data() + 2 * width,
+                        width * count * sizeof(float))) return 179;
+            params.ubatch.embd = nullptr;
+            llm_graph_result invalid(128);
+            params.res = &invalid;
+            if (runtime_program.instantiate(model, params, error)) return 180;
+            params.ubatch.embd = hidden.data();
+        }
+    }
+    return 0;
+}
