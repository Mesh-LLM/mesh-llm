+// An independent ordinary-execution stage with the same package and configuration.
+class stage_program_reference {
+public:
+    ~stage_program_reference() {
+        skippy_error * error = nullptr;
+        if (session) skippy_session_free(session, &error);
+        skippy_error_free(error);
+        error = nullptr;
+        if (model) skippy_model_free(model, &error);
+        skippy_error_free(error);
+    }
+
+    bool open(const std::vector<const char *> & parts, const skippy_runtime_config & config) {
+        skippy_error * error = nullptr;
+        const auto status = skippy_model_open_from_parts(parts.data(), parts.size(), &config, &model, &error);
+        if (status != SKIPPY_STATUS_OK || !model) {
+            std::fprintf(stderr, "reference stage load failed: %s\n", error ? error->message : "unknown");
+            skippy_error_free(error);
+            return false;
+        }
+        if (model->ctx->get_stage_program_installation() == nullptr) return false;
+        model->ctx->clear_stage_program_for_test();
+        if (model->ctx->get_stage_program_installation() != nullptr) return false;
+        if (skippy_session_create(model, &session, &error) != SKIPPY_STATUS_OK) {
+            skippy_error_free(error);
+            return false;
+        }
+        return true;
+    }
+
+    void clear_with(skippy_model * actual) {
+        llama_memory_clear(llama_get_memory(actual->ctx), true);
+        llama_memory_clear(llama_get_memory(model->ctx), true);
+    }
+
+    bool prefill(const llama_token * tokens, size_t count, const stage_program_reference * source = nullptr) {
+        if (!no_rebuild()) return false;
+        skippy_error * error = nullptr;
+        const auto status = skippy_prefill_chunk_frame(session, tokens, count,
+                source ? &source->desc : nullptr, source ? source->payload.data() : nullptr,
+                &desc, payload.data(), payload.size(), &bytes, &error);
+        return finished(status, error);
+    }
+
+    bool step(llama_token token, const skippy_sampling_config * sampling,
+            llama_token expected, const stage_program_reference * source = nullptr) {
+        if (!no_rebuild()) return false;
+        skippy_error * error = nullptr;
+        llama_token prediction = -1;
+        const auto status = skippy_decode_step_frame_sampled(session, token, sampling,
+                source ? &source->desc : nullptr, source ? source->payload.data() : nullptr,
+                &desc, payload.data(), payload.size(), &bytes, &prediction, &error);
+        return finished(status, error) && (expected < 0 || prediction == expected);
+    }
+
+    bool compare(skippy_model * actual, bool logits) const {
+        llama_synchronize(actual->ctx);
+        llama_synchronize(model->ctx);
+        if (logits) {
+            const auto count = llama_vocab_n_tokens(llama_model_get_vocab(model->model));
+            const float * left = llama_get_logits_ith(actual->ctx, -1);
+            const float * right = llama_get_logits_ith(model->ctx, -1);
+            if (!left || !right || !close(left, right, count, "logits")) return false;
+        }
+        auto left_memory = llama_get_memory(actual->ctx)->init_full();
+        auto right_memory = llama_get_memory(model->ctx)->init_full();
+        const auto * installation = actual->ctx->get_stage_program_installation();
+        if (!installation || !installation->installed) return false;
+        for (const auto & root : installation->program.roots) {
+            if (root.kind != skippy_stage_program::root_kind::state) continue;
+            const auto * left = state(left_memory.get(), root);
+            const auto * right = state(right_memory.get(), root);
+            if (!left || !right || left->type != right->type ||
+                    std::memcmp(left->ne, right->ne, sizeof(left->ne)) != 0 ||
+                    !ggml_is_contiguous(left) || !ggml_is_contiguous(right)) return false;
+            std::vector<float> left_values, right_values;
+            if (!read(left, left_values) || !read(right, right_values) ||
+                    !close(left_values.data(), right_values.data(), left_values.size(), root.value_id.c_str())) return false;
+        }
+        return true;
+    }
+
+    static bool snapshot(llama_context * context,
+            const std::vector<skippy_stage_program::root> & roots, std::vector<float> & values) {
+        llama_synchronize(context);
+        const auto count = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(context)));
+        const auto * logits = llama_get_logits_ith(context, -1);
+        if (!logits) return false;
+        values.assign(logits, logits + count);
+        auto memory = llama_get_memory(context)->init_full();
+        for (const auto & root : roots) {
+            if (root.kind != skippy_stage_program::root_kind::state) continue;
+            const auto * tensor = state(memory.get(), root);
+            std::vector<float> data;
+            if (!tensor || !ggml_is_contiguous(tensor) || !read(tensor, data)) return false;
+            values.insert(values.end(), data.begin(), data.end());
+        }
+        return true;
+    }
+
+    static bool compare_snapshots(const std::vector<float> & left, const std::vector<float> & right) {
+        return left.size() == right.size() && close(left.data(), right.data(), left.size(), "MTP logits/state");
+    }
+
+private:
+    skippy_model * model = nullptr;
+    skippy_session * session = nullptr;
+    skippy_activation_desc desc{};
+    std::vector<uint8_t> payload = std::vector<uint8_t>(1024 * 1024);
+    size_t bytes = 0;
+
+    static bool no_rebuild() {
+        if (skippy_stage_program_arch_builder_calls() == 0 && skippy_stage_program_selector_calls() == 0) return true;
+        std::fprintf(stderr, "program stage rebuilt before reference execution\n");
+        return false;
+    }
+
+    static bool finished(skippy_status status, skippy_error * error) {
+        if (status != SKIPPY_STATUS_OK) {
+            std::fprintf(stderr, "reference stage execution failed: %s\n", error ? error->message : "unknown");
+        }
+        skippy_error_free(error);
+        // Only the ordinary reference may build; the next program call starts at zero.
+        skippy_stage_program_reset_test_counters();
+        return status == SKIPPY_STATUS_OK;
+    }
+
+    static bool close(const float * left, const float * right, size_t count, const char * name) {
+        for (size_t i = 0; i < count; ++i) {
+            if (!std::isfinite(left[i]) || !std::isfinite(right[i]) ||
+                    std::abs(left[i] - right[i]) > 1e-5f * (1.0f + std::abs(right[i]))) {
+                std::fprintf(stderr, "replay parity mismatch %s[%zu]: %.9g / %.9g\n", name, i, left[i], right[i]);
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static bool read(const ggml_tensor * tensor, std::vector<float> & values) {
+        if (!tensor->buffer) return false;
+        std::vector<uint8_t> data(ggml_nbytes(tensor));
+        ggml_backend_tensor_get(tensor, data.data(), 0, data.size());
+        values.resize(ggml_nelements(tensor));
+        if (tensor->type == GGML_TYPE_F32) {
+            std::memcpy(values.data(), data.data(), data.size());
+        } else {
+            const auto convert = ggml_get_type_traits(tensor->type)->to_float;
+            if (!convert) return false;
+            convert(data.data(), values.data(), values.size());
+        }
+        return true;
+    }
+
+    static ggml_tensor * state(const llama_memory_context_i * memory, const skippy_stage_program::root & root) {
+        if (const auto * dsv4 = dynamic_cast<const llama_kv_cache_dsv4_context *>(memory)) {
+            switch (root.partition) {
+                case skippy_stage_program::state_partition::dsv4_raw:
+                    return dsv4->get_raw()->find_k_storage(root.layer);
+                case skippy_stage_program::state_partition::dsv4_csa:
+                    return dsv4->get_csa()->find_k_storage(root.layer);
+                case skippy_stage_program::state_partition::dsv4_hca:
+                    return dsv4->get_hca()->find_k_storage(root.layer);
+                case skippy_stage_program::state_partition::dsv4_lid:
+                    return dsv4->get_lid()->find_k_storage(root.layer);
+                case skippy_stage_program::state_partition::dsv4_csa_state_kv:
+                    return dsv4->get_csa_state()->find_kv_storage(root.layer);
+                case skippy_stage_program::state_partition::dsv4_csa_state_score:
+                    return dsv4->get_csa_state()->find_score_storage(root.layer);
+                case skippy_stage_program::state_partition::dsv4_hca_state_kv:
+                    return dsv4->get_hca_state()->find_kv_storage(root.layer);
+                case skippy_stage_program::state_partition::dsv4_hca_state_score:
+                    return dsv4->get_hca_state()->find_score_storage(root.layer);
+                case skippy_stage_program::state_partition::dsv4_lid_state_kv:
+                    return dsv4->get_lid_state()->find_kv_storage(root.layer);
+                case skippy_stage_program::state_partition::dsv4_lid_state_score:
+                    return dsv4->get_lid_state()->find_score_storage(root.layer);
+                default:
+                    break;
+            }
+        }
+        const auto * kv = dynamic_cast<const llama_kv_cache_context *>(memory);
+        const auto * recurrent = dynamic_cast<const llama_memory_recurrent_context *>(memory);
+        if (const auto * hybrid = dynamic_cast<const llama_memory_hybrid_context *>(memory)) {
+            kv = hybrid->get_attn();
+            recurrent = hybrid->get_recr();
+        }
+        if (const auto * msa = dynamic_cast<const llama_kv_cache_msa_context *>(memory)) {
+            kv = root.partition == skippy_stage_program::state_partition::msa_indexer
+                    ? msa->get_idx() : msa->get_base();
+        }
+        const auto * dsa = dynamic_cast<const llama_kv_cache_dsa_context *>(memory);
+        if (const auto * dsa_iswa = dynamic_cast<const llama_kv_cache_dsa_iswa_context *>(memory)) {
+            dsa = dsa_iswa->get_dsa();
+            if (root.partition == skippy_stage_program::state_partition::sliding_window) {
+                kv = dsa_iswa->get_swa();
+            }
+        }
+        if (dsa) {
+            if (root.partition == skippy_stage_program::state_partition::dsa_mla) kv = dsa->get_mla();
+            if (root.partition == skippy_stage_program::state_partition::dsa_indexer) kv = dsa->get_lid();
+        }
+        const auto * iswa = dynamic_cast<const llama_kv_cache_iswa_context *>(memory);
+        if (const auto * hybrid_iswa = dynamic_cast<const llama_memory_hybrid_iswa_context *>(memory)) {
+            iswa = hybrid_iswa->get_attn();
+            recurrent = hybrid_iswa->get_recr();
+        }
+        if (iswa) {
+            kv = root.partition == skippy_stage_program::state_partition::sliding_window
+                    ? iswa->get_swa() : iswa->get_base();
+        }
+        switch (static_cast<skippy_state_kind>(root.state_kind)) {
+            case skippy_state_kind::kv_key: return kv ? kv->find_k_storage(root.layer) : nullptr;
+            case skippy_state_kind::kv_value: return kv ? kv->find_v_storage(root.layer) : nullptr;
+            case skippy_state_kind::recurrent_conv: return recurrent ? recurrent->get_r_l(root.layer) : nullptr;
+            case skippy_state_kind::recurrent_ssm: return recurrent ? recurrent->get_s_l(root.layer) : nullptr;
+            default: return nullptr;
+        }
+    }
+
+public:
+    // Exercise the C ABI decode boundary. A stage program that cannot serve a
+    // request has to fail that request: if its C++ exception unwinds out of the
+    // ABI into Rust, the process aborts with "Rust cannot catch foreign
+    // exceptions" and the diagnostic is lost. This runs the lab shape on a
+    // two-lane sibling of the runtime under test -- a one-request warmup, then
+    // a multi-request batch -- and then a request after the program's
+    // computation configuration changed.
+    static bool boundary_probe(skippy_model * runtime, const char * path) {
+        if (runtime == nullptr || runtime->ctx == nullptr || path == nullptr) return true;
+        if (runtime->ctx->get_stage_program_installation() == nullptr) return true;
+        skippy_error * error = nullptr;
+        skippy_runtime_config config = runtime->config;
+        config.lane_count = 2;
+        skippy_model * concurrent = nullptr;
+        if (skippy_model_open(path, &config, &concurrent, &error) != SKIPPY_STATUS_OK || concurrent == nullptr ||
+                concurrent->ctx->get_stage_program_installation() == nullptr) {
+            std::fprintf(stderr, "boundary probe could not open a two-lane runtime: %s\n",
+                    error != nullptr ? error->message : "unknown");
+            if (concurrent != nullptr) skippy_model_free(concurrent, &error);
+            return false;
+        }
+        bool served = false;
+        skippy_session * lanes[2] = {nullptr, nullptr};
+        if (skippy_session_create(concurrent, &lanes[0], &error) == SKIPPY_STATUS_OK &&
+                skippy_session_create(concurrent, &lanes[1], &error) == SKIPPY_STATUS_OK) {
+            served = boundary_probe_warmup(lanes[0], &error) &&
+                    boundary_probe_concurrent(lanes, &error) &&
+                    boundary_probe_invalidated(concurrent, lanes[0], &error);
+        } else {
+            std::fprintf(stderr, "boundary probe could not open two lanes\n");
+        }
+        for (skippy_session * lane : lanes) {
+            if (lane == nullptr) continue;
+            skippy_error_free(error);
+            error = nullptr;
+            skippy_session_free(lane, &error);
+        }
+        skippy_error_free(error);
+        skippy_model_free(concurrent, &error);
+        skippy_error_free(error);
+        return served;
+    }
+
+private:
+    // One request through the batch entrypoint the serving path uses.
+    static skippy_status boundary_probe_request(
+            skippy_session * session, llama_token token, llama_token * predicted, skippy_error ** error) {
+        size_t sampled_indexes[1] = {0};
+        size_t sampled_count = 0;
+        skippy_iteration_request request = {};
+        request.session = session;
+        request.token_ids = &token;
+        request.token_count = 1;
+        request.sample_last = true;
+        *predicted = -1;
+        return skippy_iteration_batch_sampled(
+                &request, 1, nullptr, nullptr, nullptr, nullptr, sampled_indexes, predicted, 1, &sampled_count, error);
+    }
+
+    // One request on the freshly installed program.
+    static bool boundary_probe_warmup(skippy_session * session, skippy_error ** error) {
+        llama_token predicted = -1;
+        const skippy_status status = boundary_probe_request(session, 3, &predicted, error);
+        if (status != SKIPPY_STATUS_OK || predicted < 0) {
+            std::fprintf(stderr, "boundary probe warmup decode failed: %s\n",
+                    *error != nullptr ? (*error)->message : "unknown");
+            return false;
+        }
+        return true;
+    }
+
+    // Two concurrent requests. Serving both from the installed program is the
+    // product contract, but the regression is the boundary: a rejection has to
+    // arrive as a skippy error with its diagnostic, never as an abort.
+    static bool boundary_probe_concurrent(skippy_session * const * lanes, skippy_error ** error) {
+        const llama_token tokens[2] = {5, 7};
+        llama_token predicted[2] = {-1, -1};
+        size_t sampled_indexes[2] = {0, 0};
+        size_t sampled_count = 0;
+        skippy_iteration_request requests[2] = {};
+        for (size_t index = 0; index < 2; ++index) {
+            requests[index].session = lanes[index];
+            requests[index].token_ids = &tokens[index];
+            requests[index].token_count = 1;
+            requests[index].sample_last = true;
+        }
+        skippy_stage_program_reset_test_counters();
+        const skippy_status status = skippy_iteration_batch_sampled(
+                requests, 2, nullptr, nullptr, nullptr, nullptr, sampled_indexes,
+                predicted, 2, &sampled_count, error);
+        bool served = false;
+        if (status == SKIPPY_STATUS_OK) {
+            served = sampled_count == 2 && predicted[0] >= 0 && predicted[1] >= 0 &&
+                    skippy_stage_program_arch_builder_calls() == 0 &&
+                    skippy_stage_program_selector_calls() == 0;
+            if (!served) std::fprintf(stderr, "boundary probe two-request batch rebuilt the graph\n");
+        } else if (status == SKIPPY_STATUS_RUNTIME_ERROR && *error != nullptr && (*error)->message != nullptr &&
+                (*error)->message[0] != '\0') {
+            // Rejected, but reported. This is the outcome that used to abort.
+            std::fprintf(stderr, "boundary probe two-request batch reported: %s\n", (*error)->message);
+            served = true;
+        } else {
+            std::fprintf(stderr, "boundary probe two-request batch failed without a surfaced error (status %d)\n",
+                    static_cast<int>(status));
+        }
+        skippy_error_free(*error);
+        *error = nullptr;
+        return served;
+    }
+
+    // A program is bound to the configuration it was installed against. The
+    // change below invalidates it, so the decode must report the mismatch
+    // instead of letting the exception escape.
+    static bool boundary_probe_invalidated(
+            skippy_model * runtime, skippy_session * session, skippy_error ** error) {
+        runtime->ctx->set_embeddings(!runtime->ctx->get_cparams().embeddings);
+        llama_token predicted = -1;
+        const skippy_status status = boundary_probe_request(session, 11, &predicted, error);
+        const char * message = *error != nullptr ? (*error)->message : nullptr;
+        if (status != SKIPPY_STATUS_RUNTIME_ERROR || message == nullptr ||
+                std::strstr(message, "computation configuration changed after installation") == nullptr) {
+            std::fprintf(stderr, "boundary probe invalidated stage program did not report its rejection: %s\n",
+                    message != nullptr ? message : "unknown");
+            return false;
+        }
+        skippy_error_free(*error);
+        *error = nullptr;
+        return true;
+    }
+
+};
