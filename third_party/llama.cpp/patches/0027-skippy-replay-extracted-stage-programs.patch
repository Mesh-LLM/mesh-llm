+static int check_stage_program_msa_inputs(llama_model & model) {
+    llama_kv_cache_msa cache(model, GGML_TYPE_F32, GGML_TYPE_F32,
+            false, false, true, 32, 1, 1, 0, LLAMA_SWA_TYPE_NONE, {}, {}, {});
+    llama_token token = 0;
+    llm_graph_params params{};
+    params.arch = model.arch;
+    params.hparams = model.hparams;
+    params.cparams.n_ctx = params.cparams.n_ctx_seq = 32;
+    params.cparams.n_seq_max = 1;
+    params.cparams.kv_unified = true;
+    params.gtype = LLM_GRAPH_TYPE_DEFAULT;
+    params.n_outputs = 1;
+    params.build_inputs.selection.layer_end = 1;
+    params.ubatch.n_tokens = params.ubatch.n_seq_tokens = 4;
+    params.ubatch.n_seqs = params.ubatch.n_seqs_unq = 1;
+    params.ubatch.token = &token;
+    skippy_stage_program program;
+    std::string error;
+    {
+        auto memory = cache.init_full();
+        llm_graph_result source(128);
+        params.mctx = memory.get();
+        params.res = &source;
+        llm_graph_context builder(params);
+        auto * msa = builder.build_attn_inp_kv_msa(true);
+        auto embd = std::make_unique<llm_graph_input_embd>(model.hparams.n_embd_inp());
+        embd->tokens = ggml_new_tensor_1d(source.get_ctx(), GGML_TYPE_I32, 4);
+        source.add_input(std::move(embd));
+        skippy_stage_slice_selection selection;
+        ggml_build_forward_expand(source.get_gf(), ggml_permute(source.get_ctx(), msa->self_k_idxs_idx, 0, 1, 2, 3));
+        selection.source_graph = source.get_gf();
+        const auto * capture_memory = static_cast<const llama_kv_cache_msa_context *>(memory.get());
+        auto * base_storage = capture_memory->get_base()->get_k_storage(0);
+        auto * index_storage = capture_memory->get_idx()->get_k_storage(0);
+        ggml_build_forward_expand(source.get_gf(), ggml_permute(source.get_ctx(), base_storage, 0, 1, 2, 3));
+        ggml_build_forward_expand(source.get_gf(), ggml_permute(source.get_ctx(), index_storage, 0, 1, 2, 3));
+        selection.node_indices = {0, 1, 2};
+        selection.state_effects = {
+            {skippy_state_kind::kv_key, skippy_state_access::read, 0, base_storage},
+            {skippy_state_kind::kv_key, skippy_state_access::read, 0, index_storage},
+        };
+        source.t_layer_inp[0] = base_storage;
+        source.t_layer_inp[1] = index_storage;
+        selection.layer_end = 1;
+        selection.request_inputs = {msa->self_k_idxs, msa->self_v_idxs, msa->self_k_idxs_idx};
+        if (skippy_stage_program_builder_token_axis(source, msa->self_k_idxs_idx) != 0 ||
+                !skippy_extract_stage_program(model, source, selection, 4, 1, 1,
+                    LLM_GRAPH_TYPE_DEFAULT, {}, program, error)) {
+            std::fprintf(stderr, "MSA input extraction: %s\n", error.c_str());
+            return 141;
+        }
+        if (program.inputs.size() != 1 ||
+                program.inputs[0].kind != skippy_stage_program::input_kind::attention_kv_msa ||
+                program.inputs[0].values[5].empty()) return 142;
+    }
+    for (const uint32_t count : {4u, 1u}) {
+        params.ubatch.n_tokens = params.ubatch.n_seq_tokens = count;
+        llama_kv_cache::slot_info base_slots{}, index_slots{};
+        base_slots.s0 = base_slots.s1 = index_slots.s0 = index_slots.s1 = 0;
+        base_slots.strm = index_slots.strm = {0};
+        base_slots.idxs.resize(1);
+        index_slots.idxs.resize(1);
+        for (uint32_t i = 0; i < count; ++i) {
+            base_slots.idxs[0].push_back(i + 2);
+            index_slots.idxs[0].push_back(i + 9);
+        }
+        llama_kv_cache_msa_context memory(&cache, {base_slots}, {index_slots}, {params.ubatch});
+        llm_graph_result replay(128);
+        params.mctx = &memory;
+        params.res = &replay;
+        skippy_stage_program runtime_program = program;
+        if (count == 1) {
+            runtime_program.separates_token_generation = true;
+            runtime_program.token_generation = false;
+            if (runtime_program.instantiate(model, params, error) ||
+                    error.find("control-flow domain") == std::string::npos) {
+                std::fprintf(stderr, "MSA input replay accepted a mismatched prompt program: %s\n", error.c_str());
+                return 186;
+            }
+            runtime_program.token_generation = true;
+        }
+        if (!runtime_program.instantiate(model, params, error)) {
+            std::fprintf(stderr, "MSA input replay: %s\n", error.c_str());
+            return 143;
+        }
+        auto * msa = dynamic_cast<llm_graph_input_attn_kv_msa *>(replay.inputs.at(0).get());
+        if (replay.get_layer_inp(0) != memory.get_base()->get_k_storage(0) ||
+                replay.get_layer_inp(1) != memory.get_idx()->get_k_storage(0)) return 148;
+        if (!msa || msa->mctx_msa != &memory || msa->mctx != memory.get_base() ||
+                !msa->self_k_idxs_idx || msa->self_k_idxs_idx->ne[0] != count) return 144;
+        std::unique_ptr<ggml_backend_buffer, decltype(&ggml_backend_buffer_free)> buffer(
+                ggml_backend_alloc_ctx_tensors_from_buft(replay.get_ctx(), ggml_backend_cpu_buffer_type()),
+                ggml_backend_buffer_free);
+        if (!buffer) return 145;
+        msa->set_input(&params.ubatch);
+        for (uint32_t i = 0; i < count; ++i) {
+            if (static_cast<int64_t *>(msa->self_k_idxs->data)[i] != i + 2 ||
+                    static_cast<int64_t *>(msa->self_v_idxs->data)[i] != i + 2 ||
+                    static_cast<int64_t *>(msa->self_k_idxs_idx->data)[i] != i + 9) return 146;
+        }
+        for (auto & index : base_slots.idxs[0]) index += 5;
+        for (auto & index : index_slots.idxs[0]) index += 7;
+        llama_kv_cache_msa_context rebound(&cache, {base_slots}, {index_slots}, {params.ubatch});
+        params.mctx = &rebound;
+        if (!msa->can_reuse(params) || msa->mctx_msa != &rebound || msa->mctx != rebound.get_base()) return 149;
+        msa->set_input(&params.ubatch);
+        for (uint32_t i = 0; i < count; ++i) {
+            if (static_cast<int64_t *>(msa->self_k_idxs->data)[i] != i + 7 ||
+                    static_cast<int64_t *>(msa->self_k_idxs_idx->data)[i] != i + 16) return 150;
+        }
+        params.mctx = rebound.get_base();
+        if (msa->can_reuse(params) || msa->mctx_msa != &rebound) return 151;
+        llm_graph_result invalid(128);
+        params.res = &invalid;
+        params.mctx = memory.get_base();
+        if (runtime_program.instantiate(model, params, error) ||
+                error.find("compatible runtime state binding") == std::string::npos) return 147;
+    }
+    return 0;
+}
