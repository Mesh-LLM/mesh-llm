+#include <utility>
+#include <vector>
+
+struct ggml_tensor;
+struct llama_model;
+class llm_graph_result;
+class llm_graph_input_i;
+struct skippy_input_choice;
+struct skippy_stage_slice_selection;
+
+namespace stage_program_extraction_detail {
+
+int32_t permuted_axis(const ggml_tensor * tensor, int32_t source_axis);
+const ggml_tensor * program_canonical_storage(const ggml_tensor * tensor);
+std::array<int64_t, 4> dimensions(const ggml_tensor * tensor);
+std::array<uint64_t, 4> byte_strides(const ggml_tensor * tensor);
+bool checked_multiply_u64(uint64_t lhs, uint64_t rhs, uint64_t & result);
+
+struct extraction {
+    extraction(
+            const llama_model & model,
+            const llm_graph_result & result,
+            const skippy_stage_slice_selection & selection,
+            uint32_t n_tokens,
+            uint32_t n_sequences,
+            uint32_t n_outputs,
+            uint32_t graph_type,
+            const std::vector<int32_t> & activation_import_token_axes,
+            skippy_stage_program & program,
+            std::string & error,
+            const skippy_stage_program * reference);
+
+    const llama_model & model;
+    const llm_graph_result & result;
+    const skippy_stage_slice_selection & selection;
+    uint32_t n_tokens;
+    uint32_t n_sequences;
+    uint32_t n_outputs;
+    uint32_t graph_type;
+    const std::vector<int32_t> & activation_import_token_axes;
+    skippy_stage_program & program;
+    std::string & error;
+    const skippy_stage_program * reference;
+    std::unordered_map<const ggml_tensor *, std::string> values;
+    std::unordered_map<const ggml_tensor *, std::string> parameters;
+    std::unordered_map<const ggml_tensor *, std::string> requests;
+    std::unordered_map<const ggml_tensor *, std::pair<int32_t, int32_t>> states;
+    std::unordered_map<const ggml_tensor *, std::string> imports;
+    std::unordered_map<const ggml_tensor *, std::string> exports;
+    std::unordered_map<std::string, int32_t> dynamic_axes;
+    std::unordered_map<const ggml_tensor *, uint8_t> input_choice_branches;
+    std::vector<const skippy_input_choice *> active_input_choices;
+
+    bool add_root(const ggml_tensor * tensor, skippy_stage_program::root root);
+    void mark_dynamic(const std::string & value_id, int32_t axis);
+    int32_t dynamic_axis(const std::string & value_id) const;
+    const skippy_stage_program::operation * reference_operation(
+            const skippy_stage_program::operation & operation) const;
+    int32_t reference_dynamic_axis(const std::string & value_id) const;
+    int32_t reference_dynamic_axis(const skippy_stage_program::operation & operation) const;
+    bool assign_root(const ggml_tensor * tensor);
+    std::string value(const ggml_tensor * tensor);
+    bool capture_input(const llm_graph_input_i * input);
+    bool run();
+};
+
+}
diff --git a/src/skippy/stage_program_extraction_roots.cpp b/src/skippy/stage_program_extraction_roots.cpp
new file mode 100644
index 000000000..ffbb30715
--- /dev/null
+++ b/src/skippy/stage_program_extraction_roots.cpp
@@ -0,0 +1,587 @@
+#include "stage_program.h"
+
+#include "stage_slice_plan.h"
+#include "state_effects.h"
+
+#include "llama-graph.h"
+#include "llama-kv-cache-dsa.h"
+#include "llama-kv-cache-dsa-iswa.h"
+#include "llama-kv-cache-dsv4.h"
+#include "llama-kv-cache-msa.h"
+#include "llama-kv-cache-iswa.h"
+#include "llama-memory-hybrid-iswa.h"
+#include "llama-model.h"
+#include "models/models.h"
+
+#include "ggml.h"
+
+#include <algorithm>
+#include <cstring>
+#include <functional>
+#include <limits>
+#include <numeric>
+#include <set>
+#include <unordered_map>
+#include <unordered_set>
+
+#include "stage_program_extraction_internal.h"
+
+namespace stage_program_extraction_detail {
+
+int32_t permuted_axis(const ggml_tensor * tensor, int32_t source_axis) {
+    return source_axis < 0 ? -1 : ggml_get_op_params_i32(tensor, source_axis);
+}
+
+const ggml_tensor * program_canonical_storage(const ggml_tensor * tensor) {
+    std::unordered_set<const ggml_tensor *> seen;
+    while (tensor != nullptr && tensor->view_src != nullptr) {
+        if (!seen.insert(tensor).second) return nullptr;
+        tensor = tensor->view_src;
+    }
+    return tensor;
+}
+
+
+std::array<int64_t, 4> dimensions(const ggml_tensor * tensor) {
+    std::array<int64_t, 4> result;
+    std::copy(std::begin(tensor->ne), std::end(tensor->ne), result.begin());
+    return result;
+}
+
+std::array<uint64_t, 4> byte_strides(const ggml_tensor * tensor) {
+    std::array<uint64_t, 4> result;
+    std::copy(std::begin(tensor->nb), std::end(tensor->nb), result.begin());
+    return result;
+}
+
+bool checked_multiply_u64(uint64_t lhs, uint64_t rhs, uint64_t & result) {
+    if (lhs != 0 && rhs > std::numeric_limits<uint64_t>::max()/lhs) return false;
+    result = lhs*rhs;
+    return true;
+}
+
+
+extraction::extraction(
+            const llama_model & model,
+            const llm_graph_result & result,
+            const skippy_stage_slice_selection & selection,
+            uint32_t n_tokens,
+            uint32_t n_sequences,
+            uint32_t n_outputs,
+            uint32_t graph_type,
+            const std::vector<int32_t> & activation_import_token_axes,
+            skippy_stage_program & program,
+            std::string & error,
+            const skippy_stage_program * reference) :
+        model(model), result(result), selection(selection), n_tokens(n_tokens),
+        n_sequences(n_sequences), n_outputs(n_outputs), graph_type(graph_type),
+        activation_import_token_axes(activation_import_token_axes), program(program), error(error), reference(reference) {
+    }
+
+bool extraction::add_root(const ggml_tensor * tensor, skippy_stage_program::root root) {
+        if (tensor == nullptr || root.value_id.empty() || values.count(tensor) != 0) return tensor != nullptr;
+        root.type = static_cast<uint32_t>(tensor->type);
+        root.dimensions = dimensions(tensor);
+        root.byte_strides = byte_strides(tensor);
+        values.emplace(tensor, root.value_id);
+        if (root.dynamic_axis >= 0) dynamic_axes.emplace(root.value_id, root.dynamic_axis);
+        program.roots.push_back(std::move(root));
+        return true;
+    }
+
+void extraction::mark_dynamic(const std::string & value_id, int32_t axis) {
+        if (value_id.empty() || axis < 0) return;
+        dynamic_axes[value_id] = axis;
+        for (auto & root : program.roots) {
+            if (root.value_id == value_id) {
+                root.dynamic_axis = axis;
+                return;
+            }
+        }
+    }
+
+int32_t extraction::dynamic_axis(const std::string & value_id) const {
+        const auto found = dynamic_axes.find(value_id);
+        return found == dynamic_axes.end() ? -1 : found->second;
+    }
+
+bool extraction::assign_root(const ggml_tensor * tensor) {
+        if (tensor == nullptr || values.count(tensor) != 0) return tensor != nullptr;
+        const ggml_tensor * canonical = program_canonical_storage(tensor);
+        if (canonical == nullptr) {
+            error = "stage program encountered a cyclic root view";
+            return false;
+        }
+        auto found_parameter = parameters.find(tensor);
+        if (found_parameter == parameters.end()) found_parameter = parameters.find(canonical);
+        if (found_parameter != parameters.end()) {
+            skippy_stage_program::root root;
+            root.value_id = "parameter/" + found_parameter->second;
+            root.kind = skippy_stage_program::root_kind::parameter;
+            root.binding = found_parameter->second;
+            return add_root(tensor, std::move(root));
+        }
+        auto found_request = requests.find(tensor);
+        if (found_request == requests.end()) found_request = requests.find(canonical);
+        if (found_request != requests.end()) {
+            skippy_stage_program::root root;
+            root.value_id = "request/" + found_request->second;
+            root.kind = skippy_stage_program::root_kind::request;
+            root.binding = found_request->second;
+            return add_root(tensor, std::move(root));
+        }
+        auto found_state = states.find(canonical);
+        if (found_state != states.end()) {
+            const int32_t kind = found_state->second.first;
+            const int32_t layer = found_state->second.second;
+            skippy_stage_program::root root;
+            root.value_id = "state/" + std::to_string(kind) + "/" + std::to_string(layer);
+            root.kind = skippy_stage_program::root_kind::state;
+            root.binding = ggml_get_name(canonical);
+            root.state_kind = kind;
+            root.layer = layer;
+            if (const auto * dsv4 = dynamic_cast<const llama_kv_cache_dsv4_context *>(result.get_params().mctx)) {
+                const auto classify = [&](const ggml_tensor * candidate,
+                        skippy_stage_program::state_partition partition, const char * suffix) {
+                    if (candidate != nullptr && canonical == candidate) {
+                        root.partition = partition;
+                        root.value_id += suffix;
+                        return true;
+                    }
+                    return false;
+                };
+                if (!classify(dsv4->get_raw()->find_k_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_raw, "/dsv4-raw") &&
+                    !classify(dsv4->get_csa()->find_k_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_csa, "/dsv4-csa") &&
+                    !classify(dsv4->get_hca()->find_k_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_hca, "/dsv4-hca") &&
+                    !classify(dsv4->get_lid()->find_k_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_lid, "/dsv4-lid") &&
+                    !classify(dsv4->get_csa_state()->find_kv_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_csa_state_kv, "/dsv4-csa-state-kv") &&
+                    !classify(dsv4->get_csa_state()->find_score_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_csa_state_score, "/dsv4-csa-state-score") &&
+                    !classify(dsv4->get_hca_state()->find_kv_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_hca_state_kv, "/dsv4-hca-state-kv") &&
+                    !classify(dsv4->get_hca_state()->find_score_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_hca_state_score, "/dsv4-hca-state-score") &&
+                    !classify(dsv4->get_lid_state()->find_kv_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_lid_state_kv, "/dsv4-lid-state-kv")) {
+                    classify(dsv4->get_lid_state()->find_score_storage(layer),
+                            skippy_stage_program::state_partition::dsv4_lid_state_score, "/dsv4-lid-state-score");
+                }
+            }
+            if (const auto * msa = dynamic_cast<const llama_kv_cache_msa_context *>(result.get_params().mctx)) {
+                const auto classify_msa = [&](const llama_kv_cache_context * cache,
+                        skippy_stage_program::state_partition partition, const char * suffix) {
+                    if (canonical == cache->find_k_storage(layer)) {
+                        root.state_kind = static_cast<int32_t>(skippy_state_kind::kv_key);
+                        root.partition = partition;
+                        root.value_id = "state/0/" + std::to_string(layer) + suffix;
+                        return true;
+                    }
+                    if (canonical == cache->find_v_storage(layer)) {
+                        root.state_kind = static_cast<int32_t>(skippy_state_kind::kv_value);
+                        root.partition = partition;
+                        root.value_id = "state/1/" + std::to_string(layer) + suffix;
+                        return true;
+                    }
+                    return false;
+                };
+                const auto * indexer = msa->get_idx();
+                if (!classify_msa(msa->get_base(), skippy_stage_program::state_partition::primary, "")) {
+                    classify_msa(indexer, skippy_stage_program::state_partition::msa_indexer, "/msa-indexer");
+                }
+            }
+            const llama_kv_cache_dsa_context * dsa =
+                    dynamic_cast<const llama_kv_cache_dsa_context *>(result.get_params().mctx);
+            const auto * dsa_iswa =
+                    dynamic_cast<const llama_kv_cache_dsa_iswa_context *>(result.get_params().mctx);
+            if (dsa_iswa != nullptr) dsa = dsa_iswa->get_dsa();
+            if (dsa != nullptr) {
+                const auto classify_dsa = [&](const llama_kv_cache_context * cache,
+                        skippy_stage_program::state_partition partition, const char * suffix) {
+                    const bool match =
+                            (kind == static_cast<int32_t>(skippy_state_kind::kv_key) &&
+                                canonical == cache->find_k_storage(layer)) ||
+                            (kind == static_cast<int32_t>(skippy_state_kind::kv_value) &&
+                                canonical == cache->find_v_storage(layer));
+                    if (match) {
+                        root.partition = partition;
+                        root.value_id += suffix;
+                    }
+                    return match;
+                };
+                if (!classify_dsa(dsa->get_mla(),
+                            skippy_stage_program::state_partition::dsa_mla, "/dsa-mla")) {
+                    classify_dsa(dsa->get_lid(),
+                            skippy_stage_program::state_partition::dsa_indexer, "/dsa-indexer");
+                }
+            }
+            const llama_kv_cache_iswa_context * iswa =
+                    dynamic_cast<const llama_kv_cache_iswa_context *>(result.get_params().mctx);
+            if (const auto * hybrid_iswa =
+                    dynamic_cast<const llama_memory_hybrid_iswa_context *>(result.get_params().mctx)) {
+                iswa = hybrid_iswa->get_attn();
+            }
+            if (iswa != nullptr) {
+                const auto * sliding = iswa->get_swa();
+                const bool sliding_state =
+                        (kind == static_cast<int32_t>(skippy_state_kind::kv_key) &&
+                            canonical == sliding->find_k_storage(layer)) ||
+                        (kind == static_cast<int32_t>(skippy_state_kind::kv_value) &&
+                            canonical == sliding->find_v_storage(layer));
+                if (sliding_state) {
+                    root.partition = skippy_stage_program::state_partition::sliding_window;
+                    root.value_id += "/sliding-window";
+                }
+            } else if (dsa_iswa != nullptr) {
+                const auto * sliding = dsa_iswa->get_swa();
+                const bool sliding_state =
+                        (kind == static_cast<int32_t>(skippy_state_kind::kv_key) &&
+                            canonical == sliding->find_k_storage(layer)) ||
+                        (kind == static_cast<int32_t>(skippy_state_kind::kv_value) &&
+                            canonical == sliding->find_v_storage(layer));
+                if (sliding_state) {
+                    root.partition = skippy_stage_program::state_partition::sliding_window;
+                    root.value_id += "/sliding-window";
+                }
+            }
+            return add_root(tensor, std::move(root));
+        }
+        auto found_import = imports.find(tensor);
+        if (found_import != imports.end()) {
+            skippy_stage_program::root root;
+            root.value_id = "frontier/" + found_import->second;
+            root.kind = skippy_stage_program::root_kind::activation_import;
+            root.binding = found_import->second;
+            const auto import = std::distance(selection.activation_imports.begin(),
+                    std::find(selection.activation_imports.begin(), selection.activation_imports.end(), tensor));
+            if (import < static_cast<ptrdiff_t>(activation_import_token_axes.size())) {
+                root.dynamic_axis = activation_import_token_axes[import];
+            }
+            if (root.dynamic_axis < 0) {
+                error = "stage program activation import has no explicit token-axis recipe";
+                return false;
+            }
+            return add_root(tensor, std::move(root));
+        }
+        if (tensor->op != GGML_OP_NONE || tensor->view_src != nullptr) {
+            error = std::string("stage program dependency is neither selected nor a bound root: ") +
+                    ggml_get_name(tensor) + " (" + ggml_op_name(tensor->op) + ")";
+            for (int32_t node_index = 0; node_index < selection.source_graph->n_nodes; ++node_index) {
+                const ggml_tensor * consumer = selection.source_graph->nodes[node_index];
+                if (consumer == tensor) {
+                    error += " ordinal=" + std::to_string(node_index) +
+                            " selected=" + std::to_string(std::find(selection.node_indices.begin(),
+                                    selection.node_indices.end(), node_index) != selection.node_indices.end());
+                }
+                for (int32_t source = 0; source < GGML_MAX_SRC; ++source) {
+                    if (consumer->src[source] == tensor) {
+                        error += " consumer=" + std::string(ggml_get_name(consumer)) +
+                                "(" + ggml_op_name(consumer->op) + "):" + std::to_string(source) +
+                                "@" + std::to_string(node_index);
+                    }
+                }
+            }
+            return false;
+        }
+        skippy_stage_geometry_recipe scratch_geometry;
+        if (tensor->data == nullptr && tensor->buffer == nullptr &&
+                skippy_stage_geometry_lookup(tensor, scratch_geometry)) {
+            skippy_stage_program::root root;
+            root.value_id = "scratch/" + std::to_string(program.roots.size());
+            root.kind = skippy_stage_program::root_kind::scratch;
+            root.geometry = scratch_geometry;
+            for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                if (scratch_geometry.dimensions[axis].value_kind ==
+                        skippy_stage_geometry_expression::kind::runtime_tokens) {
+                    root.dynamic_axis = axis;
+                    break;
+                }
+            }
+            return add_root(tensor, std::move(root));
+        }
+        if (tensor->data == nullptr || tensor->buffer != nullptr) {
+            bool fill_scratch = tensor->data == nullptr && tensor->buffer == nullptr;
+            for (int32_t node_index = 0; fill_scratch && node_index < selection.source_graph->n_nodes; ++node_index) {
+                const ggml_tensor * consumer = selection.source_graph->nodes[node_index];
+                for (int32_t source = 0; source < GGML_MAX_SRC; ++source) {
+                    if (consumer->src[source] == tensor && !(consumer->op == GGML_OP_FILL && source == 0)) {
+                        fill_scratch = false;
+                    }
+                }
+            }
+            if (fill_scratch) {
+                skippy_stage_program::root root;
+                root.value_id = "scratch/" + std::to_string(program.roots.size());
+                root.kind = skippy_stage_program::root_kind::scratch;
+                root.geometry = skippy_stage_geometry_static(tensor);
+                for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                    if (tensor->ne[axis] == static_cast<int64_t>(n_tokens)) {
+                        root.geometry.dimensions[axis] = skippy_stage_geometry_expression::tokens();
+                        root.dynamic_axis = axis;
+                    }
+                }
+                return add_root(tensor, std::move(root));
+            }
+            error = "stage program proof does not support unbound or backend-resident constant name=" +
+                    std::string(ggml_get_name(tensor)) + " type=" + std::to_string(tensor->type) +
+                    " dims=" + std::to_string(tensor->ne[0]) + "x" + std::to_string(tensor->ne[1]) +
+                    "x" + std::to_string(tensor->ne[2]) + "x" + std::to_string(tensor->ne[3]) +
+                    " buffer=" + std::to_string(tensor->buffer != nullptr) +
+                    " flags=" + std::to_string(tensor->flags);
+            for (int32_t node_index = 0; node_index < selection.source_graph->n_nodes; ++node_index) {
+                const ggml_tensor * consumer = selection.source_graph->nodes[node_index];
+                for (int32_t source = 0; source < GGML_MAX_SRC; ++source) {
+                    if (consumer->src[source] == tensor) {
+                        error += " consumer=" + std::string(ggml_op_name(consumer->op)) +
+                                ":" + std::to_string(source);
+                    }
+                }
+            }
+            return false;
+        }
+        skippy_stage_program::root root;
+        root.value_id = "constant/" + std::to_string(program.roots.size());
+        root.kind = skippy_stage_program::root_kind::constant;
+        root.constant_data.resize(ggml_nbytes(tensor));
+        std::memcpy(root.constant_data.data(), tensor->data, root.constant_data.size());
+        return add_root(tensor, std::move(root));
+    }
+
+std::string extraction::value(const ggml_tensor * tensor) {
+        if (tensor == nullptr) return {};
+        const auto found = values.find(tensor);
+        if (found != values.end()) return found->second;
+        if (!assign_root(tensor)) return {};
+        return values.at(tensor);
+    }
+
+bool extraction::capture_input(const llm_graph_input_i * input) {
+        skippy_stage_program::input recipe;
+        auto capture = [&](const ggml_tensor * tensor, size_t index, int32_t token_axis) {
+            if (tensor == nullptr || requests.count(tensor) == 0) return;
+            if (recipe.values.size() <= index) recipe.values.resize(index + 1);
+            recipe.values[index] = value(tensor);
+            mark_dynamic(recipe.values[index], token_axis);
+        };
+        const auto capture_attention_kv = [&](const llm_graph_input_attn_kv * typed) {
+            capture(typed->self_k_idxs, 0, 0);
+            capture(typed->self_v_idxs, 1, 0);
+            capture(typed->self_kq_mask, 2, 1);
+            capture(typed->self_k_rot, 3, -1);
+            capture(typed->self_v_rot, 4, -1);
+        };
+        const auto capture_attention_iswa = [&](const llm_graph_input_attn_kv_iswa * typed) {
+            capture(typed->self_k_idxs, 0, 0);
+            capture(typed->self_v_idxs, 1, 0);
+            capture(typed->self_kq_mask, 2, 1);
+            capture(typed->self_k_rot, 3, -1);
+            capture(typed->self_v_rot, 4, -1);
+            capture(typed->self_k_idxs_swa, 5, 0);
+            capture(typed->self_v_idxs_swa, 6, 0);
+            capture(typed->self_kq_mask_swa, 7, 1);
+            capture(typed->self_k_rot_swa, 8, -1);
+            capture(typed->self_v_rot_swa, 9, -1);
+        };
+        const auto capture_attention_k = [&](const llm_graph_input_attn_k * typed, size_t base) {
+            capture(typed->self_k_idxs, base + 0, 0);
+            capture(typed->self_kq_mask, base + 2, 1);
+        };
+        const auto capture_attention_k_iswa = [&](const llm_graph_input_attn_k_iswa * typed) {
+            capture(typed->self_k_idxs, 0, 0);
+            capture(typed->self_kq_mask, 2, 1);
+            capture(typed->self_k_rot, 3, -1);
+            capture(typed->self_k_idxs_swa, 5, 0);
+            capture(typed->self_kq_mask_swa, 7, 1);
+            capture(typed->self_k_rot_swa, 8, -1);
+        };
+        const auto capture_attention_dsa = [&](const llm_graph_input_attn_k_dsa * typed, size_t base) {
+            capture(typed->self_k_idxs_mla, base + 0, 0);
+            capture(typed->self_k_idxs_lid, base + 1, 0);
+            capture(typed->self_kq_mask_mla, base + 2, 1);
+            capture(typed->self_kq_mask_lid, base + 3, 1);
+            capture(typed->self_k_rot_lid, base + 4, -1);
+        };
+        if (const auto * typed = dynamic_cast<const llama_model_qwen4exp::llm_graph_input_qsa *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::qwen4exp_qsa;
+            recipe.qwen4exp_qsa_ratio = typed->ratio;
+            recipe.qwen4exp_qsa_block_bias = typed->blk_bias;
+            capture(typed->k_idxs, 0, 0);
+            capture(typed->cell_blk, 1, -1);
+            capture(typed->blk_cells, 2, -1);
+            capture(typed->blk_pos, 3, -1);
+            capture(typed->bias, 4, 1);
+        } else if (const auto * typed = dynamic_cast<const llama_model_qwen4exp::llm_graph_input_ple *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::qwen4exp_ple;
+            capture(typed->rows, 0, 0);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_dsv4 *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::dsv4;
+            capture(typed->get_raw()->self_k_idxs, 0, 0);
+            capture(typed->get_raw()->self_kq_mask, 1, 1);
+            capture(typed->get_raw()->self_k_rot, 2, -1);
+            const auto capture_comp = [&](const llm_graph_input_dsv4::comp_input & comp, size_t base) {
+                capture(comp.state_pos, base + 0, -1);
+                capture(comp.state_persist_src_idxs, base + 1, -1);
+                capture(comp.state_persist_dst_idxs, base + 2, -1);
+                capture(comp.state_restore_src_idxs, base + 3, -1);
+                capture(comp.state_restore_dst_idxs, base + 4, -1);
+                capture(comp.state_snapshot_src_idxs, base + 5, -1);
+                capture(comp.state_snapshot_dst_idxs, base + 6, -1);
+                capture(comp.state_read_idxs, base + 7, -1);
+                capture(comp.state_write_idxs, base + 8, -1);
+                capture(comp.state_write_pos, base + 9, -1);
+                capture(comp.kq_mask, base + 10, 1);
+                capture(comp.k_rot, base + 11, -1);
+            };
+            capture_comp(typed->get_csa(), 3);
+            capture_comp(typed->get_hca(), 15);
+            capture_comp(typed->get_lid(), 27);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_embd *>(input)) {
+            recipe.n_embd = typed->n_embd;
+            if (graph_type == LLM_GRAPH_TYPE_DECODER_MTP && typed->tokens != nullptr && typed->embd != nullptr) {
+                // Older MTP builders use the ordinary embedding input class for
+                // simultaneous token IDs and hidden states. Normalize that
+                // representation to the explicit three-slot replay recipe.
+                recipe.kind = skippy_stage_program::input_kind::embeddings_hidden;
+                capture(typed->tokens, 0, 0);
+                capture(typed->embd, 2, 1);
+            } else {
+                recipe.kind = skippy_stage_program::input_kind::embeddings;
+                recipe.allow_embeddings = typed->allow_embeddings;
+                capture(typed->tokens, 0, 0);
+                capture(typed->embd, 1, 1);
+            }
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_embd_h *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::embeddings_hidden;
+            recipe.n_embd = typed->n_embd;
+            capture(typed->tokens, 0, 0);
+            capture(typed->embd, 1, 1);
+            capture(typed->h, 2, 1);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_pos *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::positions;
+            recipe.n_pos_per_embd = typed->n_pos_per_embd;
+            capture(typed->pos, 0, 0);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_attn_temp *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::attention_temperature;
+            recipe.attention_temperature_floor_scale = typed->n_attn_temp_floor_scale;
+            recipe.attention_temperature_scale = typed->f_attn_temp_scale;
+            recipe.attention_temperature_offset = typed->f_attn_temp_offset;
+            capture(typed->attn_scale, 0, 2);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_mem_hybrid_iswa *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::memory_hybrid_iswa;
+            capture_attention_iswa(typed->get_attn());
+            capture(typed->get_recr()->s_copy, 10, -1);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_mem_hybrid_k *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::memory_hybrid_k;
+            capture(typed->get_attn()->self_k_idxs, 0, 0);
+            capture(typed->get_attn()->self_kq_mask, 2, 1);
+            capture(typed->get_recr()->s_copy, 5, -1);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_mem_hybrid *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::memory_hybrid;
+            capture_attention_kv(typed->get_attn());
+            capture(typed->get_recr()->s_copy, 5, -1);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_attn_k_dsa_iswa *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::attention_k_dsa_iswa;
+            capture_attention_dsa(typed->get_dsa(), 0);
+            capture_attention_k(typed->get_swa(), 5);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_attn_k_dsa *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::attention_k_dsa;
+            capture_attention_dsa(typed, 0);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_attn_k_iswa *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::attention_k_iswa;
+            capture_attention_k_iswa(typed);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_attn_kv_iswa *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::attention_kv_iswa;
+            capture_attention_iswa(typed);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_attn_kv_msa *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::attention_kv_msa;
+            capture_attention_kv(typed);
+            capture(typed->self_k_idxs_idx, 5, 0);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_attn_kv *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::attention_kv;
+            capture_attention_kv(typed);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_attn_k *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::attention_k;
+            capture_attention_k(typed, 0);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_rs *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::recurrent;
+            capture(typed->s_copy, 0, -1);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_out_ids *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::output_indices;
+            capture(typed->out_ids, 0, 0);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_mean *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::pooling_mean;
+            capture(typed->mean, 0, 0);
+        } else if (const auto * typed = dynamic_cast<const llm_graph_input_cls *>(input)) {
+            recipe.kind = skippy_stage_program::input_kind::pooling_indices;
+            capture(typed->cls, 0, -1);
+        } else if (model.arch == LLM_ARCH_MINIMAX_M3) {
+            const auto & minimax = static_cast<const llama_model_minimax_m3 &>(model);
+            recipe.kind = skippy_stage_program::input_kind::minimax_m3_msa;
+            recipe.minimax_m3_msa_block_size = minimax.msa_p.blk;
+            recipe.minimax_m3_msa_local_blocks = minimax.msa_p.local;
+            const auto capture_named = [&](const char * identity, size_t index, int32_t token_axis) {
+                const std::string prefix = std::string(identity) + ".";
+                for (const auto & request : requests) {
+                    if (request.second == identity || request.second.compare(0, prefix.size(), prefix) == 0) {
+                        capture(request.first, index, token_axis);
+                    }
+                }
+            };
+            capture_named("attention.msa.local_bias", 0, 1);
+            capture_named("attention.msa.position_mask", 1, 1);
+            capture_named("attention.msa.position_to_cell_indices", 2, -1);
+            capture_named("attention.msa.position_to_cell_values", 3, -1);
+            capture_named("attention.msa.cell_blocks", 4, -1);
+        } else {
+            // Requests actually owned by an unsupported input remain uncaptured
+            // and are rejected by the request-root ownership check after the
+            // selected nodes have been traversed. An unsupported input that owns
+            // no selected request is irrelevant to this stage.
+            return true;
+        }
+        if (std::any_of(recipe.values.begin(), recipe.values.end(), [](const auto & id) { return !id.empty(); })) {
+            recipe.values.resize(48);
+            program.inputs.push_back(std::move(recipe));
+        }
+        return error.empty();
+    }
+
+}
+
+int32_t stage_program_extraction_detail::extraction::reference_dynamic_axis(const std::string & value_id) const {
+    if (reference == nullptr || value_id.empty()) return -1;
+    for (const auto & root : reference->roots) {
+        if (root.value_id == value_id) return root.dynamic_axis;
+    }
+    for (const auto & operation : reference->operations) {
+        if (operation.value_id == value_id) return operation.dynamic_axis;
+    }
+    return -1;
+}
+
+const skippy_stage_program::operation * stage_program_extraction_detail::extraction::reference_operation(
+        const skippy_stage_program::operation & operation) const {
+    if (reference == nullptr) return nullptr;
+    for (const auto & candidate : reference->operations) {
+        if (candidate.value_id == operation.value_id && candidate.op == operation.op) return &candidate;
+    }
+    return nullptr;
+}
+
+int32_t stage_program_extraction_detail::extraction::reference_dynamic_axis(
+        const skippy_stage_program::operation & operation) const {
+    const auto * matching = reference_operation(operation);
+    const int32_t by_value = matching == nullptr ? -1 : matching->dynamic_axis;
+    if (by_value >= 0 || reference == nullptr || operation.name.empty()) return by_value;
+    int32_t result = -1;
+    for (const auto & candidate : reference->operations) {
+        if (candidate.name != operation.name || candidate.op != operation.op || candidate.dynamic_axis < 0) continue;
+        if (result >= 0 && result != candidate.dynamic_axis) return -1;
+        result = candidate.dynamic_axis;
+    }
+    return result;
+}
