+bool extraction::run() {
+        program = {};
+        const llm_graph_params & capture = result.get_params();
+        program.layer_count = static_cast<int32_t>(model.hparams.n_layer());
+        program.layer_start = selection.layer_start;
+        program.layer_end = selection.layer_end;
+        program.model_arch = static_cast<uint32_t>(capture.arch);
+        program.graph_type = graph_type;
+        program.nextn_layer_offset = capture.cparams.nextn_layer_offset;
+        program.context_size = capture.cparams.n_ctx;
+        program.context_sequence_size = capture.cparams.n_ctx_seq;
+        program.maximum_sequences = capture.cparams.n_seq_max;
+        program.captured_sequences = n_sequences;
+        program.equal_sequences = capture.ubatch.equal_seqs();
+        program.causal_attention = capture.cparams.causal_attn;
+        program.flash_attention = capture.cparams.flash_attn;
+        program.unified_kv = capture.cparams.kv_unified;
+        program.computation_generation = capture.computation_generation;
+        for (const auto & input : result.inputs) {
+            if (const auto * typed = dynamic_cast<const llm_graph_input_embd *>(input.get())) {
+                const bool legacy_mtp_hidden = graph_type == LLM_GRAPH_TYPE_DECODER_MTP &&
+                        typed->tokens != nullptr && typed->embd != nullptr;
+                program.supports_token_inputs |= typed->tokens != nullptr;
+                program.supports_embedding_inputs |= !legacy_mtp_hidden &&
+                        typed->allow_embeddings && typed->embd != nullptr;
+            } else if (const auto * typed = dynamic_cast<const llm_graph_input_embd_h *>(input.get())) {
+                // These builders currently capture one input branch; hidden states accompany either mode.
+                program.supports_token_inputs |= capture.ubatch.token != nullptr && typed->tokens != nullptr;
+                program.supports_embedding_inputs |= capture.ubatch.token == nullptr && typed->embd != nullptr;
+            }
+        }
+        program.separates_token_generation = model.arch == LLM_ARCH_MINIMAX_M3;
+        program.token_generation = n_tokens == n_sequences;
+        if (n_sequences == 0 || n_sequences > capture.cparams.n_seq_max || n_outputs == 0 || n_outputs > n_tokens ||
+                (graph_type != static_cast<uint32_t>(LLM_GRAPH_TYPE_DEFAULT) &&
+                 graph_type != static_cast<uint32_t>(LLM_GRAPH_TYPE_DECODER_MTP)) ||
+                !capture.samplers.empty()) {
+            error = "stage program proof encountered an unsupported setup control-flow domain";
+            return false;
+        }
+        for (const auto & entry : model.tensors_by_name) {
+            if (entry.second != nullptr && parameters.count(entry.second) == 0) parameters.emplace(entry.second, entry.first);
+        }
+        std::set<int32_t> node_indices(selection.node_indices.begin(), selection.node_indices.end());
+        std::unordered_map<const ggml_tensor *, int32_t> graph_ordinals;
+        for (int32_t index = 0; index < selection.source_graph->n_nodes; ++index) {
+            graph_ordinals.emplace(selection.source_graph->nodes[index], index);
+        }
+        std::unordered_set<const ggml_tensor *> choice_dependencies;
+        for (const auto & choice : result.get_skippy_input_choices()) {
+            const ggml_tensor * selected = choice.alternatives[choice.selected];
+            const bool selected_by_stage = node_indices.count(graph_ordinals.count(selected) ? graph_ordinals.at(selected) : -1) != 0 ||
+                    std::find(selection.request_inputs.begin(), selection.request_inputs.end(), selected) != selection.request_inputs.end() ||
+                    std::find(selection.activation_exports.begin(), selection.activation_exports.end(), selected) != selection.activation_exports.end();
+            if (!selected_by_stage) continue;
+            active_input_choices.push_back(&choice);
+        }
+        if (active_input_choices.size() > 1) {
+            error = "stage program proof does not support multiple runtime input choices";
+            return false;
+        }
+        std::function<void(const ggml_tensor *, uint8_t)> include_choice_closure =
+                [&](const ggml_tensor * tensor, uint8_t branch) {
+            if (tensor == nullptr) return;
+            uint8_t & recorded_branches = input_choice_branches[tensor];
+            if ((recorded_branches & branch) != 0) return;
+            recorded_branches |= branch;
+            choice_dependencies.insert(tensor);
+            const auto ordinal = graph_ordinals.find(tensor);
+            if (ordinal != graph_ordinals.end()) {
+                node_indices.insert(ordinal->second);
+            }
+            if (tensor->view_src != nullptr) include_choice_closure(tensor->view_src, branch);
+            for (const ggml_tensor * source : tensor->src) {
+                if (source != nullptr) include_choice_closure(source, branch);
+            }
+        };
+        for (const auto * choice : active_input_choices) {
+            include_choice_closure(choice->alternatives[0], 1u << 0);
+            include_choice_closure(choice->alternatives[1], 1u << 1);
+        }
+        for (const auto & binding : result.get_request_input_bindings()) {
+            if (std::find(selection.request_inputs.begin(), selection.request_inputs.end(), binding.tensor) !=
+                        selection.request_inputs.end() || choice_dependencies.count(binding.tensor) != 0) {
+                requests.emplace(binding.tensor, binding.identity);
+            }
+        }
+        for (const ggml_tensor * request : selection.request_inputs) {
+            if (requests.count(request) == 0) {
+                error = "stage program request input has no builder binding identity";
+                return false;
+            }
+        }
+        for (const auto & effect : selection.state_effects) {
+            const ggml_tensor * storage = program_canonical_storage(effect.storage);
+            const std::pair<int32_t, int32_t> binding(static_cast<int32_t>(effect.kind), effect.layer);
+            const auto found = states.find(storage);
+            if (found != states.end() && found->second != binding) {
+                error = "stage program state root has conflicting semantics";
+                return false;
+            }
+            states[storage] = binding;
+        }
+        for (size_t index = 0; index < selection.activation_imports.size(); ++index) {
+            imports.emplace(selection.activation_imports[index], selection.activation_import_identities[index]);
+        }
+        for (size_t index = 0; index < selection.activation_exports.size(); ++index) {
+            exports.emplace(selection.activation_exports[index], selection.activation_export_identities[index]);
+        }
+        for (const auto & input : result.inputs) {
+            if (!capture_input(input.get())) return false;
+        }
+        for (int32_t index : node_indices) {
+            const ggml_tensor * tensor = selection.source_graph->nodes[index];
+            if (tensor->op == GGML_OP_NONE) {
+                if (!assign_root(tensor)) return false;
+                continue;
+            }
+            if (!skippy_stage_program_supports_operation(static_cast<uint32_t>(tensor->op))) {
+                error = std::string("stage program proof does not support operation ") + ggml_op_name(tensor->op);
+                return false;
+            }
+            skippy_stage_program::operation operation;
+            operation.source_ordinal = index;
+            operation.op = static_cast<uint32_t>(tensor->op);
+            operation.type = static_cast<uint32_t>(tensor->type);
+            const auto frontier = exports.find(tensor);
+            operation.value_id = frontier == exports.end()
+                    ? "op/" + std::to_string(index) + "/" + ggml_op_name(tensor->op)
+                    : "frontier/" + frontier->second;
+            operation.name = ggml_get_name(tensor);
+            operation.flags = tensor->flags;
+            operation.input_choice_branches = input_choice_branches[tensor];
+            std::memcpy(operation.parameters.data(), tensor->op_params, operation.parameters.size());
+            if (tensor->op == GGML_OP_TOP_K) {
+                const int32_t k = static_cast<int32_t>(tensor->ne[0]);
+                std::memcpy(operation.parameters.data(), &k, sizeof(k));
+            }
+            if (tensor->op == GGML_OP_REPEAT || tensor->op == GGML_OP_RESHAPE ||
+                    tensor->op == GGML_OP_VIEW || tensor->op == GGML_OP_CONT ||
+                    tensor->op == GGML_OP_PAD) {
+                const bool recorded_geometry = skippy_stage_geometry_lookup(tensor, operation.geometry);
+                const bool same_shape_cont = tensor->op == GGML_OP_CONT && tensor->src[0] != nullptr &&
+                        dimensions(tensor) == dimensions(tensor->src[0]);
+                if (recorded_geometry && same_shape_cont) {
+                    operation.geometry = skippy_stage_geometry_static(tensor);
+                    for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                        operation.geometry.dimensions[axis] =
+                                skippy_stage_geometry_expression::source_dimension(0, axis);
+                    }
+                } else if (!recorded_geometry) {
+                    if (same_shape_cont) {
+                        operation.geometry = skippy_stage_geometry_static(tensor);
+                        for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                            operation.geometry.dimensions[axis] =
+                                    skippy_stage_geometry_expression::source_dimension(0, axis);
+                        }
+                    } else if (tensor->op == GGML_OP_PAD) {
+                        // PAD often rounds a dynamic token extent to a fixed algorithmic block size.
+                        // Preserve padded target extents while unpadded axes continue to follow the
+                        // runtime source. Replay recomputes right padding from this target geometry
+                        // and the captured invariant left padding.
+                        operation.geometry = skippy_stage_geometry_static(tensor);
+                        for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                            const int32_t left = ggml_get_op_params_i32(tensor, 2*axis);
+                            const int32_t right = ggml_get_op_params_i32(tensor, 2*axis + 1);
+                            if (left == 0 && right == 0) {
+                                operation.geometry.dimensions[axis] =
+                                        skippy_stage_geometry_expression::source_dimension(0, axis);
+                            }
+                        }
+                    } else if (tensor->op == GGML_OP_REPEAT && tensor->src[0] != nullptr) {
+                        const std::string source_id = value(tensor->src[0]);
+                        int32_t source_axis = dynamic_axis(source_id);
+                        if (source_axis < 0) {
+                            for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                                if (tensor->src[0]->ne[axis] != static_cast<int64_t>(n_tokens) ||
+                                        tensor->ne[axis] != static_cast<int64_t>(n_tokens)) {
+                                    continue;
+                                }
+                                if (source_axis >= 0) {
+                                    source_axis = -1;
+                                    break;
+                                }
+                                source_axis = axis;
+                            }
+                        }
+                        if (source_axis < 0 || tensor->src[0]->ne[source_axis] <= 0 ||
+                                tensor->ne[source_axis] % tensor->src[0]->ne[source_axis] != 0) {
+                            error = "stage program repeat has no dynamic source geometry: " +
+                                    std::string(ggml_get_name(tensor)) + " source=" +
+                                    ggml_get_name(tensor->src[0]) + " source_op=" +
+                                    ggml_op_name(tensor->src[0]->op) + " source_axis=" +
+                                    std::to_string(source_axis) + " dims=" +
+                                    std::to_string(tensor->ne[0]) + "x" +
+                                    std::to_string(tensor->ne[1]) + "x" +
+                                    std::to_string(tensor->ne[2]) + "x" +
+                                    std::to_string(tensor->ne[3]) + " source_dims=" +
+                                    std::to_string(tensor->src[0]->ne[0]) + "x" +
+                                    std::to_string(tensor->src[0]->ne[1]) + "x" +
+                                    std::to_string(tensor->src[0]->ne[2]) + "x" +
+                                    std::to_string(tensor->src[0]->ne[3]);
+                            return false;
+                        }
+                        operation.geometry = skippy_stage_geometry_static(tensor);
+                        operation.geometry.dimensions[source_axis] =
+                                skippy_stage_geometry_expression::source_dimension(
+                                        0, source_axis, tensor->ne[source_axis] / tensor->src[0]->ne[source_axis]);
+                    } else if (tensor->op == GGML_OP_VIEW && tensor->src[0] != nullptr) {
+                        operation.geometry = skippy_stage_geometry_static(tensor);
+                        const int32_t source_axis = dynamic_axis(value(tensor->src[0]));
+                        for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                            if (n_sequences > 1 && tensor->ne[axis] == static_cast<int64_t>(n_sequences) &&
+                                    tensor->src[0]->ne[axis] == tensor->ne[axis]) {
+                                operation.geometry.dimensions[axis] =
+                                        skippy_stage_geometry_expression::sequences();
+                            }
+                        }
+                        if (source_axis >= 0) {
+                            int32_t target_axis = -1;
+                            for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                                if (tensor->ne[axis] != tensor->src[0]->ne[source_axis]) continue;
+                                if (target_axis >= 0) {
+                                    target_axis = -1;
+                                    break;
+                                }
+                                target_axis = axis;
+                            }
+                            if (target_axis < 0) {
+                                if (tensor->view_offs == 0 && source_axis < GGML_MAX_DIMS &&
+                                        tensor->ne[source_axis] < tensor->src[0]->ne[source_axis]) {
+                                    operation.geometry.dimensions[source_axis] =
+                                            skippy_stage_geometry_expression::source_dimension(
+                                                    0, source_axis, 1, 1,
+                                                    tensor->ne[source_axis] - tensor->src[0]->ne[source_axis]);
+                                    target_axis = source_axis;
+                                }
+                            }
+                            if (target_axis < 0) {
+                                const uint64_t source_stride = tensor->src[0]->nb[source_axis];
+                                uint64_t source_extent = 0;
+                                if (tensor->view_offs == 0 || tensor->src[0]->ne[source_axis] < 0 ||
+                                        !checked_multiply_u64(
+                                                static_cast<uint64_t>(tensor->src[0]->ne[source_axis]),
+                                                source_stride, source_extent) ||
+                                        source_extent > static_cast<uint64_t>(std::numeric_limits<int64_t>::max())) {
+                                    error = "stage program view requires an explicit dynamic geometry recipe: " +
+                                            std::string(ggml_get_name(tensor)) + " source=" +
+                                            std::string(ggml_get_name(tensor->src[0])) + " dims=" +
+                                            std::to_string(tensor->ne[0]) + "x" + std::to_string(tensor->ne[1]) +
+                                            "x" + std::to_string(tensor->ne[2]) + "x" + std::to_string(tensor->ne[3]) +
+                                            " source_dims=" + std::to_string(tensor->src[0]->ne[0]) + "x" +
+                                            std::to_string(tensor->src[0]->ne[1]) + "x" +
+                                            std::to_string(tensor->src[0]->ne[2]) + "x" +
+                                            std::to_string(tensor->src[0]->ne[3]) +
+                                            " source_dynamic_axis=" + std::to_string(source_axis);
+                                    return false;
+                                }
+                                const int64_t tokens_per_sequence = n_sequences == 0 ? 0 : n_tokens/n_sequences;
+                                if (source_axis == 0 && n_sequences > 0 && n_tokens % n_sequences == 0 &&
+                                        tensor->src[0]->ne[0] - tensor->ne[0] == tokens_per_sequence &&
+                                        tensor->view_offs % source_stride == 0) {
+                                    const int64_t slot = tokens_per_sequence - tensor->view_offs/source_stride;
+                                    operation.geometry.view_offset =
+                                            skippy_stage_geometry_expression::tokens_per_sequence_clamped(
+                                                    -slot, source_stride);
+                                } else {
+                                    operation.geometry.view_offset =
+                                            skippy_stage_geometry_expression::source_dimension(
+                                                    0, source_axis, source_stride, 1,
+                                                    static_cast<int64_t>(tensor->view_offs) -
+                                                            static_cast<int64_t>(source_extent));
+                                }
+                                for (int32_t axis = 1; axis < GGML_MAX_DIMS; ++axis) {
+                                    if (tensor->nb[axis] == tensor->src[0]->nb[axis]) {
+                                        operation.geometry.byte_strides[axis] =
+                                                skippy_stage_geometry_expression::source_stride(0, axis);
+                                    }
+                                }
+                            } else {
+                                operation.geometry.dimensions[target_axis] =
+                                        skippy_stage_geometry_expression::source_dimension(
+                                                0, source_axis, 1, 1,
+                                                tensor->ne[target_axis] - tensor->src[0]->ne[source_axis]);
+                                if (target_axis == source_axis) {
+                                    for (int32_t axis = 1; axis < GGML_MAX_DIMS; ++axis) {
+                                        operation.geometry.byte_strides[axis] =
+                                                skippy_stage_geometry_expression::source_stride(0, axis);
+                                    }
+                                }
+                            }
+                        }
+                    } else if (tensor->op == GGML_OP_CONT && tensor->src[0] != nullptr &&
+                            ggml_nelements(tensor) == ggml_nelements(tensor->src[0])) {
+                        operation.geometry = skippy_stage_geometry_static(tensor);
+                        int32_t token_axis = -1;
+                        for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                            if (tensor->ne[axis] != static_cast<int64_t>(n_tokens)) continue;
+                            if (token_axis >= 0) {
+                                token_axis = -1;
+                                break;
+                            }
+                            token_axis = axis;
+                        }
+                        if (token_axis < 0) {
+                            error = "stage program cont requires an explicit dynamic geometry recipe: " +
+                                    std::string(ggml_get_name(tensor));
+                            return false;
+                        }
+                        operation.geometry.dimensions[token_axis] =
+                                skippy_stage_geometry_expression::tokens();
+                    } else if (tensor->op == GGML_OP_RESHAPE && tensor->src[0] != nullptr &&
+                            ggml_nelements(tensor) == ggml_nelements(tensor->src[0])) {
+                        std::vector<int32_t> source_axes;
+                        std::vector<int32_t> target_axes;
+                        for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                            if (tensor->src[0]->ne[axis] != 1) source_axes.push_back(axis);
+                            if (tensor->ne[axis] != 1) target_axes.push_back(axis);
+                        }
+                        bool singleton_only = source_axes.size() == target_axes.size();
+                        for (size_t axis = 0; singleton_only && axis < source_axes.size(); ++axis) {
+                            singleton_only = tensor->src[0]->ne[source_axes[axis]] == tensor->ne[target_axes[axis]];
+                        }
+                        if (singleton_only) {
+                            operation.geometry = skippy_stage_geometry_static(tensor);
+                            for (size_t axis = 0; axis < source_axes.size(); ++axis) {
+                                operation.geometry.dimensions[target_axes[axis]] =
+                                        skippy_stage_geometry_expression::source_dimension(0, source_axes[axis]);
+                            }
+                        } else {
+                            const std::string source_id = value(tensor->src[0]);
+                            int32_t source_axis = dynamic_axis(source_id);
+                            if (source_axis < 0) source_axis = reference_dynamic_axis(source_id);
+                            operation.geometry = skippy_stage_geometry_static(tensor);
+                            bool recipe_built = false;
+                            int32_t runtime_token_axis = -1;
+                            for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                                if (tensor->ne[axis] != static_cast<int64_t>(n_tokens)) continue;
+                                if (runtime_token_axis >= 0) {
+                                    runtime_token_axis = -1;
+                                    break;
+                                }
+                                runtime_token_axis = axis;
+                            }
+                            // Prefer a source-relative recipe whenever the source already carries
+                            // a dynamic extent. In particular, output selection can have the same
+                            // captured width as the token batch while becoming empty at runtime;
+                            // treating that axis as runtime_tokens would incorrectly resurrect the
+                            // captured token count.
+                            if (source_axis < 0 && runtime_token_axis >= 0) {
+                                operation.geometry.dimensions[runtime_token_axis] =
+                                        skippy_stage_geometry_expression::tokens();
+                                recipe_built = true;
+                            }
+                            if (!recipe_built && source_axis >= 0 && n_sequences > 1 && n_tokens % n_sequences == 0 &&
+                                    tensor->src[0]->ne[source_axis] == static_cast<int64_t>(n_tokens)) {
+                                const int64_t tokens_per_sequence = n_tokens/n_sequences;
+                                int32_t token_axis = -1;
+                                int32_t sequence_axis = -1;
+                                for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                                    if (token_axis < 0 && tensor->ne[axis] == tokens_per_sequence) {
+                                        token_axis = axis;
+                                    } else if (axis > token_axis && tensor->ne[axis] == static_cast<int64_t>(n_sequences)) {
+                                        sequence_axis = axis;
+                                        break;
+                                    }
+                                }
+                                if (token_axis >= 0 && sequence_axis >= 0) {
+                                    operation.geometry.dimensions[token_axis] =
+                                            skippy_stage_geometry_expression::tokens_per_sequence();
+                                    operation.geometry.dimensions[sequence_axis] =
+                                            skippy_stage_geometry_expression::sequences();
+                                    recipe_built = true;
+                                }
+                            }
+                            int32_t target_axis = -1;
+                            int64_t source_prefix = 1;
+                            bool sequence_geometry = false;
+                            if (!recipe_built && source_axis < 0) {
+                                for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                                    if (tensor->src[0]->ne[axis] != static_cast<int64_t>(n_sequences)) continue;
+                                    if (source_axis >= 0) {
+                                        source_axis = -1;
+                                        break;
+                                    }
+                                    source_axis = axis;
+                                }
+                                sequence_geometry = source_axis >= 0;
+                            }
+                            if (!recipe_built && source_axis >= 0) {
+                                for (int32_t axis = 0; axis < source_axis; ++axis) {
+                                    source_prefix *= tensor->src[0]->ne[axis];
+                                }
+                                int64_t source_cumulative = source_prefix;
+                                for (int32_t source_end = source_axis;
+                                        source_end < GGML_MAX_DIMS && target_axis < 0; ++source_end) {
+                                    source_cumulative *= tensor->src[0]->ne[source_end];
+                                    int64_t target_cumulative = 1;
+                                    for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                                        target_cumulative *= tensor->ne[axis];
+                                        if (target_cumulative == source_cumulative) {
+                                            target_axis = axis;
+                                            break;
+                                        }
+                                    }
+                                }
+                            }
+                            if (!recipe_built && target_axis < 0) {
+                                const auto * matching = reference_operation(operation);
+                                if (matching != nullptr) {
+                                    operation.geometry = matching->geometry;
+                                    recipe_built = true;
+                                }
+                            }
+                            if (!recipe_built && target_axis < 0) {
+                                error = "stage program reshape requires an explicit non-singleton geometry recipe: " +
+                                        std::string(ggml_get_name(tensor)) + " source=" +
+                                        std::string(ggml_get_name(tensor->src[0])) + " dims=" +
+                                        std::to_string(tensor->ne[0]) + "x" + std::to_string(tensor->ne[1]) +
+                                        "x" + std::to_string(tensor->ne[2]) + "x" + std::to_string(tensor->ne[3]) +
+                                        " source_dims=" + std::to_string(tensor->src[0]->ne[0]) + "x" +
+                                        std::to_string(tensor->src[0]->ne[1]) + "x" +
+                                        std::to_string(tensor->src[0]->ne[2]) + "x" +
+                                        std::to_string(tensor->src[0]->ne[3]) +
+                                        " source_dynamic_axis=" + std::to_string(source_axis);
+                                return false;
+                            }
+                            if (!recipe_built) {
+                                if (sequence_geometry) {
+                                    operation.geometry.dimensions[target_axis] =
+                                            skippy_stage_geometry_expression::sequences();
+                                } else {
+                                    const int64_t source_extent = tensor->src[0]->ne[source_axis];
+                                    const int64_t target_extent = tensor->ne[target_axis];
+                                    const int64_t divisor = std::gcd(source_extent, target_extent);
+                                    operation.geometry.dimensions[target_axis] =
+                                            skippy_stage_geometry_expression::source_dimension(
+                                                    0, source_axis, target_extent/divisor, source_extent/divisor);
+                                }
+                            }
+                        }
+                    } else {
+                        error = std::string("stage program geometry operation has no builder recipe: ") +
+                                ggml_op_name(tensor->op) + " " + ggml_get_name(tensor) +
+                                " source=" + (tensor->src[0] == nullptr ? std::string("<null>") :
+                                        std::string(ggml_get_name(tensor->src[0]))) +
+                                " dims=" + std::to_string(tensor->ne[0]) + "x" +
+                                        std::to_string(tensor->ne[1]) + "x" +
+                                        std::to_string(tensor->ne[2]) + "x" +
+                                        std::to_string(tensor->ne[3]);
+                        return false;
+                    }
+                }
+            }
+            for (int source = 0; source < GGML_MAX_SRC; ++source) {
+                const ggml_tensor * source_tensor = tensor->src[source];
+                if (source_tensor == tensor) {
+                    source_tensor = tensor->view_src;
+                }
+                if (source_tensor != nullptr) {
+                    operation.sources[source] = value(source_tensor);
+                    if (operation.sources[source].empty()) return false;
+                    if (tensor->view_src != nullptr && operation.alias_source < 0 &&
+                            tensor->view_src == program_canonical_storage(source_tensor)) {
+                        operation.alias_source = source;
+                    }
+                }
+            }
+            const int32_t first_axis = dynamic_axis(operation.sources[0]);
+            const int32_t second_axis = dynamic_axis(operation.sources[1]);
+            switch (tensor->op) {
+                case GGML_OP_GET_ROWS:
+                    operation.dynamic_axis = second_axis < 0 ? -1 : second_axis + 1;
+                    break;
+                case GGML_OP_MUL_MAT:
+                case GGML_OP_MUL_MAT_ID:
+                    operation.dynamic_axis = second_axis;
+                    break;
+                case GGML_OP_FLASH_ATTN_EXT:
+                    operation.dynamic_axis = first_axis == 1 ? 2 : first_axis == 2 ? 1 : first_axis;
+                    break;
+                case GGML_OP_REPEAT:
+                case GGML_OP_RESHAPE:
+                case GGML_OP_VIEW:
+                case GGML_OP_CONT: {
+                    for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+                        const auto & dimension = operation.geometry.dimensions[axis];
+                        if (dimension.value_kind == skippy_stage_geometry_expression::kind::runtime_tokens ||
+                                dimension.value_kind == skippy_stage_geometry_expression::kind::runtime_tokens_per_sequence ||
+                                dimension.value_kind == skippy_stage_geometry_expression::kind::runtime_tokens_per_sequence_clamped ||
+                                dimension.value_kind == skippy_stage_geometry_expression::kind::runtime_tokens_per_sequence_capped ||
+                                (dimension.value_kind == skippy_stage_geometry_expression::kind::source_dimension &&
+                                 dimension.source == 0 && dimension.axis == first_axis)) {
+                            operation.dynamic_axis = axis;
+                            break;
+                        }
+                    }
+                    break;
+                }
+                case GGML_OP_PERMUTE:
+                    operation.dynamic_axis = permuted_axis(tensor, first_axis);
+                    break;
+                case GGML_OP_MUL:
+                case GGML_OP_ADD:
+                case GGML_OP_SUB:
+                case GGML_OP_DIV:
+                    operation.dynamic_axis = first_axis >= 0 ? first_axis : second_axis;
+                    break;
+                case GGML_OP_ADD_ID:
+                    operation.dynamic_axis = first_axis;
+                    break;
+                case GGML_OP_SCALE:
+                case GGML_OP_NORM:
+                case GGML_OP_RMS_NORM:
+                case GGML_OP_ROPE:
+                case GGML_OP_ROPE_BACK:
+                case GGML_OP_SOFT_MAX:
+                case GGML_OP_GLU:
+                case GGML_OP_UNARY:
+                case GGML_OP_ARGSORT:
+                case GGML_OP_SUM_ROWS:
+                case GGML_OP_CLAMP:
+                case GGML_OP_SQRT:
+                case GGML_OP_FILL:
+                case GGML_OP_CUMSUM:
+                case GGML_OP_SET:
+                case GGML_OP_TRI:
+                case GGML_OP_POOL_2D:
+                    operation.dynamic_axis = first_axis;
+                    break;
+                case GGML_OP_SOLVE_TRI:
+                    operation.dynamic_axis = second_axis;
+                    break;
+                case GGML_OP_DSV4_HC_COMB:
+                    operation.dynamic_axis = first_axis == 1 ? 2 : -1;
+                    break;
+                case GGML_OP_DSV4_HC_PRE:
+                    operation.dynamic_axis = first_axis == 2 ? 1 : -1;
+                    break;
+                case GGML_OP_DSV4_HC_POST:
+                    operation.dynamic_axis = first_axis == 1 ? 2 : -1;
+                    break;
+                case GGML_OP_LIGHTNING_INDEXER:
+                    operation.dynamic_axis = first_axis == 2 ? 1 : -1;
+                    break;
+                case GGML_OP_TOP_K:
+                    operation.dynamic_axis = first_axis;
+                    break;
+                case GGML_OP_SET_ROWS:
+                    operation.dynamic_axis = dynamic_axis(operation.sources[2]);
+                    break;
+                case GGML_OP_CPY:
+                    operation.dynamic_axis = first_axis < 0 ? second_axis :
+                            second_axis < 0 || first_axis == second_axis ? first_axis : -1;
+                    break;
+                case GGML_OP_TRANSPOSE:
+                    operation.dynamic_axis = first_axis == 0 ? 1 : first_axis == 1 ? 0 : first_axis;
+                    break;
+                case GGML_OP_CONCAT:
+                    operation.dynamic_axis = first_axis < 0 ? second_axis :
+                            second_axis < 0 || first_axis == second_axis ? first_axis : -1;
+                    break;
+                case GGML_OP_SSM_CONV:
+                    operation.dynamic_axis = first_axis == 0 ? 1 : first_axis;
+                    break;
+                default:
+                    break;
+            }
+            if (operation.dynamic_axis < 0) {
+                operation.dynamic_axis = reference_dynamic_axis(operation);
+            }
+            if (!values.emplace(tensor, operation.value_id).second) {
+                error = "stage program generated a duplicate operation value id";
+                return false;
+            }
+            if (operation.dynamic_axis >= 0) dynamic_axes.emplace(operation.value_id, operation.dynamic_axis);
+            program.operations.push_back(std::move(operation));
+        }
+        std::unordered_map<std::string, std::string> choice_aliases;
+        for (size_t index = 0; index < active_input_choices.size(); ++index) {
+            const auto & source = *active_input_choices[index];
+            skippy_stage_program::input_choice choice;
+            choice.value_id = "choice/input-mode/" + std::to_string(index);
+            for (size_t branch = 0; branch < choice.alternatives.size(); ++branch) {
+                const auto found = values.find(source.alternatives[branch]);
+                if (found == values.end()) {
+                    error = "stage program input choice alternative is outside the owned program";
+                    return false;
+                }
+                choice.alternatives[branch] = found->second;
+            }
+            const int32_t token_axis = dynamic_axis(choice.alternatives[0]);
+            if (token_axis < 0 || dynamic_axis(choice.alternatives[1]) != token_axis) {
+                error = "stage program input choice alternatives have incompatible token axes";
+                return false;
+            }
+            choice.dynamic_axis = token_axis;
+            dynamic_axes[choice.value_id] = token_axis;
+            choice_aliases.emplace(choice.alternatives[source.selected], choice.value_id);
+            program.input_choices.push_back(std::move(choice));
+        }
+        for (auto & operation : program.operations) {
+            if (operation.input_choice_branches != 0) continue;
+            for (auto & source : operation.sources) {
+                const auto alias = choice_aliases.find(source);
+                if (alias != choice_aliases.end()) source = alias->second;
+            }
+        }
+        const auto aliased = [&](std::string value_id) {
+            const auto found = choice_aliases.find(value_id);
+            return found == choice_aliases.end() ? value_id : found->second;
+        };
+        std::unordered_set<std::string> captured_requests;
+        for (const auto & input : program.inputs) {
+            for (const auto & id : input.values) if (!id.empty()) captured_requests.insert(id);
+        }
+        for (const auto & request : requests) {
+            const auto found = values.find(request.first);
+            if (found != values.end() && captured_requests.count(found->second) == 0) {
+                error = "stage program request root has no owned input recipe: " + request.second +
+                        " value=" + found->second + " tensor=" + ggml_get_name(request.first);
+                return false;
+            }
+        }
+        for (const auto * tensor : selection.activation_imports) program.activation_imports.push_back(aliased(value(tensor)));
+        for (const auto * tensor : selection.activation_exports) {
+            const std::string id = aliased(value(tensor));
+            program.activation_exports.push_back(id);
+            program.activation_export_token_axes.push_back(dynamic_axis(id));
+            if (program.activation_export_token_axes.back() < 0) {
+                error = "stage program activation export has no generic token-axis recipe";
+                return false;
+            }
+        }
+        program.outputs.capture(result, [&](const ggml_tensor * tensor) {
+            const auto found = values.find(tensor);
+            return found == values.end() ? std::string() : aliased(found->second);
+        });
+        return error.empty();
+    }
+
+}
+
+bool skippy_extract_stage_program(
+        const llama_model & model,
+        const llm_graph_result & result,
+        const skippy_stage_slice_selection & selection,
+        uint32_t n_tokens,
+        uint32_t n_sequences,
+        uint32_t n_outputs,
+        uint32_t graph_type,
+        const std::vector<int32_t> & activation_import_token_axes,
+        skippy_stage_program & program,
+        std::string & error,
+        const skippy_stage_program * reference) {
+    error.clear();
+    if (selection.source_graph == nullptr || selection.node_indices.empty() ||
+            selection.layer_start < 0 || selection.layer_start >= selection.layer_end) {
+        error = "invalid stage program extraction request";
+        return false;
+    }
+    if (activation_import_token_axes.size() != selection.activation_imports.size()) {
+        error = "stage program activation import token-axis contract is incomplete";
+        return false;
+    }
+    if (!stage_program_extraction_detail::extraction(model, result, selection, n_tokens, n_sequences, n_outputs, graph_type,
+            activation_import_token_axes,
+            program, error, reference).run()) {
+        return false;
+    }
+    // The replay plan is a pure function of the captured program, so derive it
+    // here rather than on every graph build.
+    program.prepare_replay_plans();
+    return true;
+}
