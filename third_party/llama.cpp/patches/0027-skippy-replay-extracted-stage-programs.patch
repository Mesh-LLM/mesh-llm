+    bool token_generation = false;
+    uint64_t computation_generation = 0;
+    std::vector<root> roots;
+    std::vector<input> inputs;
+    std::vector<operation> operations;
+    std::vector<input_choice> input_choices;
+    std::vector<std::string> activation_imports;
+    std::vector<std::string> activation_exports;
+    std::vector<int32_t> activation_export_token_axes;
+    skippy_stage_program_outputs outputs;
+
+    // Everything replay derives from the captured program alone: the ordered
+    // operations it builds and how many values its map holds. This is a pure
+    // function of (program, selected input branch), so it is computed once when
+    // the program is extracted or installed instead of on every graph build.
+    // Index 0 is the token branch, index 1 the embedding branch.
+    struct replay_plan {
+        std::vector<uint32_t> operation_indexes;
+        uint32_t value_capacity = 0;
+    };
+
+    replay_plan build_replay_plan(bool token_input) const;
+    void prepare_replay_plans();
+    std::array<replay_plan, 2> replay_plans = {};
+    bool replay_plans_prepared = false;
+
+    bool instantiate(
+            const llama_model & model,
+            const llm_graph_params & params,
+            std::string & error) const;
+
+    // Domain checks run on every graph build, so the mismatch description is
+    // composed only when the caller passes a non-null `mismatch_description`.
+    bool matches_control_flow_domain(
+            const llm_graph_params & params,
+            std::string * mismatch_description) const;
+};
+
+struct skippy_stage_program_installation {
+    const llama_model * model = nullptr;
+    skippy_stage_program program;
+    std::vector<skippy_stage_program> alternatives;
+    bool installed = false;
+    bool capturing = false;
+    // Production replay accounting. Counted on every graph build and reported
+    // only when SKIPPY_GRAPH_TRACE is enabled, so a field deployment can prove
+    // the captured program is reused without a telemetry sink or a test build.
+    mutable std::atomic<uint64_t> replays = 0;
+    mutable std::atomic<uint64_t> domain_probe_misses = 0;
+    mutable std::atomic<uint64_t> alternative_hits = 0;
+
+    bool instantiate(
+            const llama_model & runtime_model,
+            const llm_graph_params & params,
+            std::string & error) const;
+};
+
+bool skippy_extract_stage_program(
+        const llama_model & model,
+        const llm_graph_result & result,
+        const skippy_stage_slice_selection & selection,
