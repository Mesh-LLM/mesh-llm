+    skippy_stage_program program;
+    std::string error;
+    if (!skippy_extract_stage_program(model, capture, selection, 4, 1, 1,
+                LLM_GRAPH_TYPE_DEFAULT, {}, program, error)) {
+        std::fprintf(stderr, "unused unsupported input extraction: %s\n", error.c_str());
+        return 181;
+    }
+    return 0;
+}
