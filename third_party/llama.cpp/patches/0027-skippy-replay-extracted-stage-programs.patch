+                break;
+            case GGML_OP_LIGHTNING_INDEXER:
+                axis = first_axis == 2 ? 1 : -1;
+                break;
+            case GGML_OP_TOP_K:
+                axis = first_axis;
+                break;
+            case GGML_OP_SCALE:
+            case GGML_OP_NORM:
+            case GGML_OP_RMS_NORM:
+            case GGML_OP_ROPE:
+            case GGML_OP_ROPE_BACK:
+            case GGML_OP_SOFT_MAX:
+            case GGML_OP_GLU:
+            case GGML_OP_UNARY:
