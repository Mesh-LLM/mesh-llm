+#include "stage_program_inputs.h"
+
+#include "llama-kv-cache-msa.h"
+
+#include "ggml.h"
+
+#include <vector>
+
+skippy_stage_program_minimax_m3_msa_input::skippy_stage_program_minimax_m3_msa_input(
+        const llama_kv_cache_msa_context * memory,
+        int32_t block_size,
+        int32_t local_blocks) :
+    memory(memory), block_size(block_size), local_blocks(local_blocks) {}
+
+void skippy_stage_program_minimax_m3_msa_input::set_input(const llama_ubatch * ubatch) {
+    if (position_to_cell_indices) memory->set_input_pos_slot(position_to_cell_indices, ubatch);
+    if (position_to_cell_values) memory->set_input_pos_slot(position_to_cell_values, ubatch);
+    if (cell_blocks) memory->set_input_cell_pos(cell_blocks, ubatch, block_size);
+    if (position_mask) memory->set_input_pos_mask(position_mask, ubatch);
+    if (local_bias && ubatch->pos) {
+        const int64_t n_tokens = ubatch->n_tokens;
+        const int64_t n_blocks = local_bias->ne[0];
+        std::vector<float> data(static_cast<size_t>(n_blocks*n_tokens), 0.0f);
+        for (int64_t token = 0; token < n_tokens; ++token) {
+            const int64_t block = ubatch->pos[token]/block_size;
+            for (int32_t local = 0; local < local_blocks && block - local >= 0; ++local) {
+                if (block - local < n_blocks) {
+                    data[static_cast<size_t>(token*n_blocks + block - local)] = 1e30f;
+                }
+            }
+        }
+        ggml_backend_tensor_set(local_bias, data.data(), 0, data.size()*sizeof(float));
+    }
+}
+
+bool skippy_stage_program_minimax_m3_msa_input::can_reuse(const llm_graph_params & params) {
+    const auto * runtime_memory = static_cast<const llama_kv_cache_msa_context *>(params.mctx);
+    memory = runtime_memory;
+    const int64_t n_positions = GGML_PAD(static_cast<int64_t>(runtime_memory->get_n_pos()), block_size);
+    const int64_t streams = params.cparams.kv_unified ? 1 : params.ubatch.n_seqs_unq;
+    const bool decode = params.ubatch.n_tokens == streams;
+    return local_bias != nullptr && position_mask != nullptr && position_to_cell_indices != nullptr &&
+            local_bias->ne[0]*block_size == n_positions &&
+            local_bias->ne[1] == params.ubatch.n_tokens &&
+            position_mask->ne[0] == n_positions &&
+            position_mask->ne[1] == params.ubatch.n_tokens &&
+            position_to_cell_indices->ne[0] == n_positions &&
+            position_to_cell_indices->ne[1] == streams &&
+            decode == (position_to_cell_values != nullptr) &&
+            decode == (cell_blocks == nullptr) &&
+            (position_to_cell_values == nullptr ||
+                (position_to_cell_values->ne[0] == n_positions && position_to_cell_values->ne[1] == streams)) &&
+            (cell_blocks == nullptr ||
+                (cell_blocks->ne[0] == static_cast<int64_t>(runtime_memory->get_base()->get_n_kv()) &&
+                 cell_blocks->ne[1] == streams));
+}
