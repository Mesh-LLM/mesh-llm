diff --git a/src/skippy/stage_program_installation.cpp b/src/skippy/stage_program_installation.cpp
new file mode 100644
index 000000000..97400d7e5
--- /dev/null
+++ b/src/skippy/stage_program_installation.cpp
@@ -0,0 +1,139 @@
+#include "stage_program.h"
+
+#include "llama-graph.h"
+#include "llama-model.h"
+
+#include <algorithm>
+
+bool skippy_stage_program::matches_control_flow_domain(
+        const llm_graph_params & params,
+        std::string * mismatch_description) const {
+    if (params.computation_generation != computation_generation) {
+        if (mismatch_description != nullptr) {
+            *mismatch_description = "stage program computation configuration changed after installation";
+        }
+        return false;
+    }
+    const bool hidden_input = std::any_of(inputs.begin(), inputs.end(), [](const input & value) {
+        return value.kind == input_kind::embeddings_hidden;
+    });
+    const bool token_input = params.ubatch.token != nullptr && (params.ubatch.embd == nullptr || hidden_input);
+    const bool embedding_input = params.ubatch.token == nullptr && params.ubatch.embd != nullptr;
+    const bool runtime_token_generation = params.ubatch.n_tokens == params.ubatch.n_seqs_unq;
+    if (params.res == nullptr || static_cast<uint32_t>(params.arch) != model_arch ||
+            static_cast<uint32_t>(params.gtype) != graph_type ||
+            params.cparams.nextn_layer_offset != nextn_layer_offset ||
+            params.cparams.n_ctx != context_size || params.cparams.n_ctx_seq != context_sequence_size ||
+            params.cparams.n_seq_max != maximum_sequences || params.ubatch.n_seqs_unq == 0 ||
+            params.ubatch.n_seqs_unq > maximum_sequences ||
+            (params.ubatch.n_seqs_unq > 1 && params.ubatch.equal_seqs() != equal_sequences) ||
+            params.cparams.causal_attn != causal_attention || params.cparams.flash_attn != flash_attention ||
+            params.cparams.kv_unified != unified_kv ||
+            (separates_token_generation && runtime_token_generation != token_generation) ||
+            (!token_input && !embedding_input) || (token_input && !supports_token_inputs) ||
+            (embedding_input && !supports_embedding_inputs) || params.n_outputs > params.ubatch.n_tokens ||
+            !params.samplers.empty() || params.build_inputs.selection.layer_start != layer_start ||
+            params.build_inputs.selection.layer_end != layer_end) {
+        if (mismatch_description != nullptr) {
+            *mismatch_description = "runtime graph is outside the recorded stage program control-flow domain: gtype=" +
+                std::to_string(static_cast<uint32_t>(params.gtype)) + "/" + std::to_string(graph_type) +
+                " nextn_offset=" + std::to_string(params.cparams.nextn_layer_offset) + "/" +
+                std::to_string(nextn_layer_offset) +
+                " unique_seqs=" + std::to_string(params.ubatch.n_seqs_unq) + "/max=" +
+                std::to_string(maximum_sequences) +
+                " equal_seqs=" + std::to_string(params.ubatch.equal_seqs()) + "/" +
+                std::to_string(equal_sequences) +
+                " token_generation=" + std::to_string(runtime_token_generation) + "/" +
+                std::to_string(token_generation) +
+                " token=" + std::to_string(token_input) + "/" + std::to_string(supports_token_inputs) +
+                " embd=" + std::to_string(embedding_input) + "/" + std::to_string(supports_embedding_inputs) +
+                " outputs=" + std::to_string(params.n_outputs) + "/" +
+                std::to_string(params.ubatch.n_tokens) +
+                " samplers=" + std::to_string(params.samplers.size()) +
+                " layers=" + std::to_string(params.build_inputs.selection.layer_start) + ".." +
+                std::to_string(params.build_inputs.selection.layer_end) + "/" +
+                std::to_string(layer_start) + ".." + std::to_string(layer_end);
+        }
+        return false;
+    }
+    return true;
+}
+
+bool skippy_install_stage_program(
+        const llama_model & model,
+        const llm_graph_result & result,
+        const skippy_stage_slice_selection & selection,
+        const std::vector<int32_t> & activation_import_token_axes,
+        skippy_stage_program_installation & installation,
+        std::string & error) {
+    if (installation.model != nullptr && installation.model != &model) {
+        error = "stage program installation is bound to a different model";
+        return false;
+    }
+    const llm_graph_params & params = result.get_params();
+    skippy_stage_program program;
+    if (!skippy_extract_stage_program(
+                model,
+                result,
+                selection,
+                params.ubatch.n_tokens,
+                params.ubatch.n_seqs_unq,
+                params.n_outputs,
+                static_cast<uint32_t>(params.gtype),
+                activation_import_token_axes,
+                program,
+                error,
+                installation.installed ? &installation.program : nullptr)) {
+        return false;
+    }
+    for (auto & root : program.roots) {
+        if (root.kind != skippy_stage_program::root_kind::parameter) continue;
+        const auto found = std::find_if(model.tensors_by_name.begin(), model.tensors_by_name.end(),
+                [&](const auto & entry) { return entry.first == root.binding; });
+        if (found == model.tensors_by_name.end() || found->second == nullptr) {
+            error = "stage program parameter binding is missing during installation";
+            return false;
+        }
+        root.parameter = found->second;
+    }
+    installation.model = &model;
+    if (installation.installed) {
+        installation.alternatives.push_back(std::move(program));
+    } else {
+        installation.program = std::move(program);
+        installation.installed = true;
+    }
+    return true;
+}
+
+bool skippy_stage_program_installation::instantiate(
+        const llama_model & runtime_model,
+        const llm_graph_params & params,
+        std::string & error) const {
+    if (!installed || model == nullptr) {
+        error = "stage program is not installed";
+        return false;
+    }
+    if (model != &runtime_model) {
+        error = "stage program is not bound to this immutable model configuration";
+        return false;
+    }
+    // Probe with no description so a rejected candidate costs no string work,
+    // then compose the diagnostic once every candidate has been rejected.
+    if (program.matches_control_flow_domain(params, nullptr)) {
+        replays.fetch_add(1, std::memory_order_relaxed);
+        return program.instantiate(runtime_model, params, error);
+    }
+    const skippy_stage_program * rejected = &program;
+    for (const auto & alternative : alternatives) {
+        if (alternative.matches_control_flow_domain(params, nullptr)) {
+            replays.fetch_add(1, std::memory_order_relaxed);
+            alternative_hits.fetch_add(1, std::memory_order_relaxed);
+            return alternative.instantiate(runtime_model, params, error);
+        }
+        rejected = &alternative;
+    }
+    domain_probe_misses.fetch_add(1, std::memory_order_relaxed);
+    rejected->matches_control_flow_domain(params, &error);
+    return false;
+}
