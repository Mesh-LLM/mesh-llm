diff --git a/include/skippy/activation.h b/include/skippy/activation.h
index 4a097f044..673c1d81c 100644
--- a/include/skippy/activation.h
+++ b/include/skippy/activation.h
@@ -5,8 +5,8 @@
  * @file skippy/activation.h
  * @brief Describes activation-frame payloads exchanged between stages.
  *
- * The descriptor carries the payload representation, layer range, token and
- * sequence shape, and model-family sideband flags needed by downstream stages.
+ * The descriptor carries a typed directory for every tensor crossing a stage
+ * frontier. Parts are matched by planner identity rather than model family.
  */
 
 #include "common.h"
@@ -15,52 +15,48 @@
 extern "C" {
 #endif
 
-enum skippy_activation_dtype {
-    SKIPPY_ACTIVATION_DTYPE_UNKNOWN       = 0,
-    SKIPPY_ACTIVATION_DTYPE_F32           = 1,
-    SKIPPY_ACTIVATION_DTYPE_F16           = 2,
-    SKIPPY_ACTIVATION_DTYPE_BF16          = 3,
-};
+#define SKIPPY_ACTIVATION_FRAME_VERSION 2
+#define SKIPPY_ACTIVATION_BOUNDARY_DESC_VERSION 2
+#define SKIPPY_ACTIVATION_IDENTITY_BYTES 32
+#define SKIPPY_ACTIVATION_MAX_DIMS 4
+#define SKIPPY_ACTIVATION_MAX_PARTS 16
 
-enum skippy_activation_layout {
-    SKIPPY_ACTIVATION_LAYOUT_OPAQUE       = 0,
-    SKIPPY_ACTIVATION_LAYOUT_TOKEN_MAJOR  = 1,
-};
+#define SKIPPY_ACTIVATION_PART_OPTIONAL (UINT32_C(1) << 0)
 
-#define SKIPPY_ACTIVATION_BOUNDARY_DESC_VERSION 1
+/** @brief One typed tensor in a stage-frontier frame. */
+struct skippy_activation_part_desc {
+    uint8_t identity[SKIPPY_ACTIVATION_IDENTITY_BYTES];
+    uint32_t ggml_type;
+    uint32_t rank;
+    int32_t token_axis;
+    uint32_t flags;
+    int64_t dimensions[SKIPPY_ACTIVATION_MAX_DIMS];
+    uint64_t byte_strides[SKIPPY_ACTIVATION_MAX_DIMS];
+    uint64_t payload_offset;
+    uint64_t payload_bytes;
+};
 
-/** @brief Stable, graph-observed representation for one token at a stage edge. */
+/** @brief Stable, graph-observed multipart contract at one stage edge. */
 struct skippy_activation_boundary_desc {
     uint32_t version;
-    uint32_t ggml_type;
-    uint32_t layout;
-    uint32_t reserved;
-    uint64_t elements_per_token;
-    uint64_t bytes_per_token;
-    uint64_t required_frame_flags;
-    uint64_t required_sidebands;
+    uint32_t part_count;
+    uint8_t frontier_identity[SKIPPY_ACTIVATION_IDENTITY_BYTES];
+    struct skippy_activation_part_desc parts[SKIPPY_ACTIVATION_MAX_PARTS];
 };
 
-#define SKIPPY_ACTIVATION_SIDEBAND_TOKEN_IDS (UINT64_C(1) << 0)
-
-#define SKIPPY_ACTIVATION_FLAG_RWKV7_V_FIRST   (UINT64_C(1) << 0)
-#define SKIPPY_ACTIVATION_FLAG_GEMMA3N_ALTUP   (UINT64_C(1) << 1)
-#define SKIPPY_ACTIVATION_FLAG_INKLING_MTP_EMBD (UINT64_C(1) << 2)
-#define SKIPPY_ACTIVATION_FLAG_GLM_DSA_TOP_K     (UINT64_C(1) << 3)
-#define SKIPPY_ACTIVATION_FLAG_KIMI_K3_RESIDUAL   (UINT64_C(1) << 4)
-
 /** @brief Metadata for an activation payload passed between staged runtimes. */
 struct skippy_activation_desc {
     uint32_t version;
-    enum skippy_activation_dtype dtype;
-    enum skippy_activation_layout layout;
     int32_t producer_stage_index;
     int32_t layer_start;
     int32_t layer_end;
     uint32_t token_count;
     uint32_t sequence_count;
+    uint32_t part_count;
+    uint32_t reserved;
     uint64_t payload_bytes;
-    uint64_t flags;
+    uint8_t frontier_identity[SKIPPY_ACTIVATION_IDENTITY_BYTES];
+    struct skippy_activation_part_desc parts[SKIPPY_ACTIVATION_MAX_PARTS];
 };
 
