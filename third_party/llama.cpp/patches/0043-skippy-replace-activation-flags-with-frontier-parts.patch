+void llm_graph_result::add_skippy_activation_import(ggml_tensor * tensor, int32_t token_axis, bool optional) {
+    if (tensor == nullptr) return;
+    const auto found = std::find_if(activation_imports.begin(), activation_imports.end(),
+            [tensor](const skippy_activation_port & port) { return port.tensor == tensor; });
+    if (found == activation_imports.end()) activation_imports.push_back({tensor, token_axis, optional});
+}
+
+void llm_graph_result::add_skippy_activation_export(ggml_tensor * tensor, int32_t token_axis, bool optional) {
+    if (tensor == nullptr) return;
+    const auto found = std::find_if(activation_exports.begin(), activation_exports.end(),
+            [tensor](const skippy_activation_port & port) { return port.tensor == tensor; });
+    if (found == activation_exports.end()) activation_exports.push_back({tensor, token_axis, optional});
+}
