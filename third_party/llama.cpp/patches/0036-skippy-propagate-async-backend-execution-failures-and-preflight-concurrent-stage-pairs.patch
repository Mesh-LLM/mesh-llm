diff --git a/ggml/include/ggml-backend.h b/ggml/include/ggml-backend.h
index cc3f8cd36..91fc82ca1 100644
--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -97,6 +97,11 @@ extern "C" {
 
     GGML_API void ggml_backend_synchronize(ggml_backend_t backend);
 
+    // skippy: true if the backend entered an error state during previously
+    // submitted (async) work; call after ggml_backend_synchronize. Backends
+    // that execute synchronously always report false.
+    GGML_API bool ggml_backend_get_error(ggml_backend_t backend);
+
     GGML_API ggml_backend_graph_plan_t ggml_backend_graph_plan_create(ggml_backend_t backend, struct ggml_cgraph * cgraph);
     GGML_API void                      ggml_backend_graph_plan_free  (ggml_backend_t backend, ggml_backend_graph_plan_t plan);
 
