diff --git a/include/llama.h b/include/llama.h
index 4aef38850..bcb2dae39 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -1033,6 +1033,12 @@ extern "C" {
     // and is not necessary to call it explicitly in most cases
     LLAMA_API void llama_synchronize(struct llama_context * ctx);
 
+    // skippy: returns true if a backend failed during execution of previously
+    // submitted work (discovered at synchronize). Outputs from earlier decodes
+    // are then invalid and further decodes are refused - callers must treat
+    // the context as poisoned and recreate it.
+    LLAMA_API bool llama_ctx_has_backend_error(struct llama_context * ctx);
+
     // Token logits obtained from the last call to llama_decode()
