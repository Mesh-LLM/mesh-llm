diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index e519bdf50..85beec739 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -422,6 +422,19 @@ void ggml_backend_synchronize(ggml_backend_t backend) {
     backend->iface.synchronize(backend);
 }
 
+// skippy: after synchronization, an async backend's graph_compute status is
+// final. Surface an execution-time failure (e.g. Metal command-buffer error)
+// that was discovered by the synchronize above, so callers that capture the
+// enqueue-time status do not read stale results as success.
+bool ggml_backend_get_error(ggml_backend_t backend) {
+    GGML_ASSERT(backend);
+    if (backend->iface.get_error == NULL) {
+        return false;
+    }
+
+    return backend->iface.get_error(backend);
+}
+
 ggml_backend_graph_plan_t ggml_backend_graph_plan_create(ggml_backend_t backend, struct ggml_cgraph * cgraph) {
     GGML_ASSERT(backend);
     GGML_ASSERT(backend->iface.graph_plan_create != NULL);
@@ -446,6 +459,10 @@ enum ggml_status ggml_backend_graph_plan_compute(ggml_backend_t backend, ggml_ba
 enum ggml_status ggml_backend_graph_compute(ggml_backend_t backend, struct ggml_cgraph * cgraph) {
     enum ggml_status err = ggml_backend_graph_compute_async(backend, cgraph);
     ggml_backend_synchronize(backend);
+    // skippy: same execution-time failure propagation as the sched wrapper
+    if (err == GGML_STATUS_SUCCESS && ggml_backend_get_error(backend)) {
+        return GGML_STATUS_FAILED;
+    }
     return err;
 }
 
@@ -1957,6 +1974,17 @@ bool ggml_backend_sched_alloc_graph(ggml_backend_sched_t sched, struct ggml_cgra
 enum ggml_status ggml_backend_sched_graph_compute(ggml_backend_sched_t sched, struct ggml_cgraph * graph) {
     enum ggml_status err = ggml_backend_sched_graph_compute_async(sched, graph);
     ggml_backend_sched_synchronize(sched);
+    // skippy: an async backend (e.g. Metal) reports success at enqueue while
+    // execution may still fail afterwards. The synchronize above discovers
+    // that failure in the backend's error state - propagate it instead of
+    // returning the stale enqueue-time status.
+    if (err == GGML_STATUS_SUCCESS) {
+        for (int i = 0; i < sched->n_backends; i++) {
+            if (ggml_backend_get_error(sched->backends[i])) {
+                return GGML_STATUS_FAILED;
+            }
+        }
+    }
     return err;
 }
 
