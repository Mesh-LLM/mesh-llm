-    *out_predicted_token = skippy_sample_token(session, sampling);
-    if (*out_predicted_token == LLAMA_TOKEN_NULL) {
-        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR,
-                "sampling produced no eligible token after vocabulary suppression");
-        return SKIPPY_STATUS_RUNTIME_ERROR;
-    }
