diff --git a/src/skippy/events.cpp b/src/skippy/events.cpp
new file mode 100644
index 000000000..a0675f6e3
--- /dev/null
+++ b/src/skippy/events.cpp
@@ -0,0 +1,121 @@
+#include "skippy/events.h"
+
+#include "events_internal.h"
+
+#include <atomic>
+#include <chrono>
+#include <mutex>
+#include <thread>
+
+namespace {
+
+struct global_reporter_state {
+    std::mutex install_mutex;
+    std::atomic<uint64_t> in_flight{0};
+    skippy_runtime_event_callback callback = nullptr;
+    void * user_data = nullptr;
+    std::atomic<uint64_t> next_sequence{1};
+};
+
+global_reporter_state & state() {
+    static global_reporter_state s;
+    return s;
+}
+
+uint64_t now_mono_ns() {
+    return static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch())
+            .count());
+}
+
+} // namespace
+
+namespace skippy::events {
+
+void dispatch(
+        skippy_runtime_event_category category,
+        skippy_runtime_event_kind kind,
+        uint64_t model_id,
+        uint64_t stage_id,
+        uint64_t session_id,
+        skippy_runtime_event_failure_code failure_code,
+        uint64_t numeric_summary_0,
+        uint64_t numeric_summary_1,
+        uint64_t numeric_summary_2,
+        uint64_t numeric_summary_3,
+        const char * detail_ptr,
+        uint64_t detail_len) {
+    auto & s = state();
+
+    // Snapshot the callback under the install lock, then bump the in-flight
+    // counter before releasing it, so a concurrent skippy_clear_runtime_event_reporter
+    // call blocking on in_flight==0 cannot observe a zero count while a
+    // callback using the just-cleared callback pointer is still running.
+    skippy_runtime_event_callback callback;
+    void * user_data;
+    {
+        std::lock_guard<std::mutex> lock(s.install_mutex);
+        callback = s.callback;
+        user_data = s.user_data;
+        if (callback == nullptr) {
+            return;
+        }
+        s.in_flight.fetch_add(1, std::memory_order_acq_rel);
+    }
+
+    skippy_runtime_event_v1 event{};
+    event.abi_version = SKIPPY_RUNTIME_EVENT_V1_ABI_VERSION;
+    event.struct_size = static_cast<uint32_t>(sizeof(skippy_runtime_event_v1));
+    event.category = category;
+    event.kind = kind;
+    event.emitter = SKIPPY_RUNTIME_EVENT_EMITTER_WORKER_THREAD;
+    event.sequence = s.next_sequence.fetch_add(1, std::memory_order_relaxed);
+    event.timestamp_mono_ns = now_mono_ns();
+    event.model_id = model_id;
+    event.stage_id = stage_id;
+    event.session_id = session_id;
+    event.failure_code = failure_code;
+    event.numeric_summary_0 = numeric_summary_0;
+    event.numeric_summary_1 = numeric_summary_1;
+    event.numeric_summary_2 = numeric_summary_2;
+    event.numeric_summary_3 = numeric_summary_3;
+    event.detail_ptr = detail_ptr;
+    event.detail_len = detail_len;
+
+    callback(&event, user_data);
+
+    s.in_flight.fetch_sub(1, std::memory_order_acq_rel);
+}
+
+} // namespace skippy::events
+
+enum skippy_status skippy_set_runtime_event_reporter(
+        const struct skippy_runtime_event_reporter_v1 * reporter) {
+    if (reporter == nullptr ||
+        reporter->struct_size < sizeof(struct skippy_runtime_event_reporter_v1)) {
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+
+    auto & s = state();
+    std::lock_guard<std::mutex> lock(s.install_mutex);
+    s.callback = reporter->callback;
+    s.user_data = reporter->user_data;
+    return SKIPPY_STATUS_OK;
+}
+
+void skippy_clear_runtime_event_reporter(void) {
+    auto & s = state();
+    {
+        std::lock_guard<std::mutex> lock(s.install_mutex);
+        s.callback = nullptr;
+        s.user_data = nullptr;
+    }
+    // Quiescence: spin until every callback that had already snapshotted the
+    // (now-cleared) callback pointer inside dispatch() has returned. Callers
+    // installed after this point already observe callback == nullptr and can
+    // never enter the in-flight-counted region below.
+    while (s.in_flight.load(std::memory_order_acquire) != 0) {
+        std::this_thread::yield();
+    }
+}
diff --git a/src/skippy/events_internal.h b/src/skippy/events_internal.h
new file mode 100644
index 000000000..159c5bcbc
--- /dev/null
+++ b/src/skippy/events_internal.h
@@ -0,0 +1,31 @@
+#ifndef SKIPPY_EVENTS_INTERNAL_H
+#define SKIPPY_EVENTS_INTERNAL_H
+
+#include "skippy/events.h"
+
+// Private capability-internal dispatch path shared by every
+// `skippy_emit_*_event` family entrypoint (added by sibling patches). Not
+// part of the installed public ABI: declared under src/skippy/, matching
+// this codebase's private-header convention. Also used directly by the
+// native runtime-event test binary (which shares this include path) so the
+// reporter's own mechanism (install/clear/quiescence/struct-size extension)
+// is testable without depending on any one family's emit entrypoint.
+namespace skippy::events {
+
+void dispatch(
+        skippy_runtime_event_category category,
+        skippy_runtime_event_kind kind,
+        uint64_t model_id,
+        uint64_t stage_id,
+        uint64_t session_id,
+        skippy_runtime_event_failure_code failure_code,
+        uint64_t numeric_summary_0,
+        uint64_t numeric_summary_1,
+        uint64_t numeric_summary_2,
+        uint64_t numeric_summary_3,
+        const char * detail_ptr,
+        uint64_t detail_len);
+
+} // namespace skippy::events
+
+#endif // SKIPPY_EVENTS_INTERNAL_H
diff --git a/src/skippy/tests/runtime_events.cpp b/src/skippy/tests/runtime_events.cpp
new file mode 100644
index 000000000..64b37a4f7
--- /dev/null
+++ b/src/skippy/tests/runtime_events.cpp
@@ -0,0 +1,148 @@
+#include "skippy/events.h"
+
+#include "../events_internal.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace {
+
+#define CHECK(cond)                                                          \
+    do {                                                                     \
+        if (!(cond)) {                                                       \
+            std::fprintf(stderr, "CHECK failed: %s (%s:%d)\n", #cond,        \
+                          __FILE__, __LINE__);                               \
+            std::exit(1);                                                    \
+        }                                                                    \
+    } while (0)
+
+struct capture {
+    std::atomic<int> count{0};
+    std::atomic<uint32_t> last_category{0};
+    std::atomic<uint32_t> last_kind{0};
+    std::atomic<uint64_t> last_numeric_summary_0{0};
+};
+
+void capture_callback(const struct skippy_runtime_event_v1 * event, void * user_data) {
+    auto * c = static_cast<capture *>(user_data);
+    c->last_category.store(event->category);
+    c->last_kind.store(event->kind);
+    c->last_numeric_summary_0.store(event->numeric_summary_0);
+    c->count.fetch_add(1);
+}
+
+void install(capture & c) {
+    struct skippy_runtime_event_reporter_v1 reporter{};
+    reporter.abi_version = SKIPPY_RUNTIME_EVENT_V1_ABI_VERSION;
+    reporter.struct_size = sizeof(reporter);
+    reporter.callback = capture_callback;
+    reporter.user_data = &c;
+    CHECK(skippy_set_runtime_event_reporter(&reporter) == SKIPPY_STATUS_OK);
+}
+
+// Exercises the reporter mechanism (install/dispatch/clear/quiescence) via
+// the shared internal dispatch() seam directly, using the pre-existing
+// MODEL_OPEN category/kind. No sibling-patch family emit entrypoint is
+// required for this patch's own tests.
+void emit_probe(uint64_t numeric_summary_0 = 0) {
+    skippy::events::dispatch(
+        SKIPPY_RUNTIME_EVENT_CATEGORY_MODEL_OPEN,
+        SKIPPY_RUNTIME_EVENT_KIND_MODEL_OPEN_STARTED,
+        0, 0, 0, SKIPPY_RUNTIME_EVENT_FAILURE_NONE,
+        numeric_summary_0, 0, 0, 0, nullptr, 0);
+}
+
+int test_register_and_dispatch() {
+    capture c;
+    install(c);
+    emit_probe(7);
+    CHECK(c.count.load() == 1);
+    CHECK(c.last_category.load() == SKIPPY_RUNTIME_EVENT_CATEGORY_MODEL_OPEN);
+    CHECK(c.last_kind.load() == SKIPPY_RUNTIME_EVENT_KIND_MODEL_OPEN_STARTED);
+    CHECK(c.last_numeric_summary_0.load() == 7);
+    skippy_clear_runtime_event_reporter();
+    return 0;
+}
+
+int test_malformed_reporter_rejected() {
+    struct skippy_runtime_event_reporter_v1 reporter{};
+    reporter.abi_version = SKIPPY_RUNTIME_EVENT_V1_ABI_VERSION;
+    reporter.struct_size = 1; // smaller than the real struct
+    reporter.callback = capture_callback;
+    CHECK(skippy_set_runtime_event_reporter(&reporter) == SKIPPY_STATUS_INVALID_ARGUMENT);
+    CHECK(skippy_set_runtime_event_reporter(nullptr) == SKIPPY_STATUS_INVALID_ARGUMENT);
+    return 0;
+}
+
+int test_clear_is_quiescent() {
+    capture c;
+    install(c);
+    skippy_clear_runtime_event_reporter();
+    // No callback should fire after clear returns.
+    emit_probe();
+    CHECK(c.count.load() == 0);
+    return 0;
+}
+
+int test_struct_size_extension() {
+    struct skippy_runtime_event_v1 seen{};
+    struct skippy_runtime_event_reporter_v1 reporter{};
+    reporter.abi_version = SKIPPY_RUNTIME_EVENT_V1_ABI_VERSION;
+    reporter.struct_size = sizeof(reporter);
+    reporter.user_data = &seen;
+    reporter.callback = [](const struct skippy_runtime_event_v1 * event, void * user_data) {
+        std::memcpy(user_data, event, sizeof(*event));
+    };
+    CHECK(skippy_set_runtime_event_reporter(&reporter) == SKIPPY_STATUS_OK);
+
+    emit_probe();
+    CHECK(seen.struct_size == sizeof(struct skippy_runtime_event_v1));
+    CHECK(seen.abi_version == SKIPPY_RUNTIME_EVENT_V1_ABI_VERSION);
+
+    skippy_clear_runtime_event_reporter();
+    return 0;
+}
+
+int test_concurrent_dispatch() {
+    capture c;
+    install(c);
+
+    constexpr int n_threads = 8;
+    constexpr int per_thread = 200;
+    std::vector<std::thread> threads;
+    for (int t = 0; t < n_threads; ++t) {
+        threads.emplace_back([] {
+            for (int i = 0; i < per_thread; ++i) {
+                emit_probe();
+            }
+        });
+    }
+    for (auto & th : threads) {
+        th.join();
+    }
+    CHECK(c.count.load() == n_threads * per_thread);
+    skippy_clear_runtime_event_reporter();
+    return 0;
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    if (argc != 2) {
+        std::fprintf(stderr, "usage: %s <test-name>\n", argv[0]);
+        return 2;
+    }
+    const std::string name = argv[1];
+    if (name == "register_and_dispatch") return test_register_and_dispatch();
+    if (name == "malformed_reporter_rejected") return test_malformed_reporter_rejected();
+    if (name == "clear_is_quiescent") return test_clear_is_quiescent();
+    if (name == "struct_size_extension") return test_struct_size_extension();
+    if (name == "concurrent_dispatch") return test_concurrent_dispatch();
+    std::fprintf(stderr, "unknown test: %s\n", name.c_str());
+    return 2;
+}
