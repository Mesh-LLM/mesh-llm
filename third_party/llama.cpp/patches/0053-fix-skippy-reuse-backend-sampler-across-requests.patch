diff --git a/src/skippy/runtime_types.h b/src/skippy/runtime_types.h
index 24784dd28..fa97e12a5 100644
--- a/src/skippy/runtime_types.h
+++ b/src/skippy/runtime_types.h
@@ -153,6 +153,8 @@ struct skippy_session {
     // detached -- e.g. so a sampled verify window can output every row --
     // it must never be re-attached; only building a fresh chain clears this.
     bool sampling_backend_retired = false;
+    uint64_t sampling_reuse_hit_count = 0;
+    uint64_t sampling_rebuild_count = 0;
     skippy_sampling_config sampling_config = {};
     bool sampling_config_valid = false;
     std::string chat_sampling_metadata;
diff --git a/src/skippy/sampling.cpp b/src/skippy/sampling.cpp
index 99d9731cf..013e49709 100644
--- a/src/skippy/sampling.cpp
+++ b/src/skippy/sampling.cpp
@@ -11,6 +11,7 @@
 #include "../vendor/nlohmann/json.hpp"
 
 #include <algorithm>
+#include <cinttypes>
 #include <cmath>
 #include <cstdint>
 #include <cstring>
@@ -45,8 +46,6 @@ enum skippy_status skippy_decode_tokens(
         bool request_logits,
         int32_t glm_dsa_phase_hint,
         struct skippy_error ** out_error) {
-    (void) request_logits;
-
     if (session == nullptr || session->ctx == nullptr || token_ids == nullptr || token_count == 0) {
         skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "session and at least one token are required");
         return SKIPPY_STATUS_INVALID_ARGUMENT;
@@ -135,6 +134,16 @@ enum skippy_status skippy_verify_token_batch(
         return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
 
+    if (session->sampling_backend_enabled) {
+        // Verification requests logits for every row and then consumes them on
+        // the CPU. An attached backend sampler permits only one output row per
+        // sequence, so retire its one-shot backend initialization before
+        // building the verification batch.
+        llama_set_sampler(session->ctx, session->seq_id, nullptr);
+        session->sampling_backend_enabled = false;
+        session->sampling_backend_retired = true;
+    }
+
     const int32_t n_tokens = static_cast<int32_t>(token_count);
     llama_batch batch = llama_batch_init(n_tokens, 0, 1);
     batch.n_tokens = n_tokens;
@@ -442,25 +451,71 @@ static bool skippy_sampling_configs_equal(
     return true;
 }
 
+static bool skippy_sampling_chain_is_reusable_for(
+        const skippy_session * session,
+        const skippy_sampling_config * sampling) {
+    if (session == nullptr || !session->sampling_config_valid ||
+            session->sampling_backend_retired) {
+        return false;
+    }
+    if (sampling != nullptr &&
+            skippy_sampling_configs_equal(session->sampling_config, *sampling)) {
+        return true;
+    }
+    // Greedy-equivalent configurations all build the same one-node greedy
+    // chain. Fields such as seed and top_p are semantically inactive while
+    // temperature is zero, so changing them must not detach the sampler and
+    // force an otherwise identical scheduler reservation.
+    return skippy_sampling_is_greedy_equivalent(&session->sampling_config) &&
+           skippy_sampling_is_greedy_equivalent(sampling);
+}
+
+static void skippy_store_sampling_config(
+        skippy_session * session,
+        const skippy_sampling_config * sampling) {
+    session->sampling_config = sampling != nullptr ?
+            *sampling : skippy_sampling_config{};
+    session->sampling_config_valid = true;
+}
+
+static void skippy_log_sampling_cache_metrics(
+        const skippy_session * session,
+        const char * action) {
+    if (session == nullptr || session->ctx == nullptr) {
+        return;
+    }
+    LLAMA_LOG_INFO(
+            "%s: seq=%d action=%s reuse_hits=%" PRIu64 " rebuilds=%" PRIu64 " scheduler_reserves=%" PRIu64 "\n",
+            __func__,
+            session->seq_id,
+            action,
+            session->sampling_reuse_hit_count,
+            session->sampling_rebuild_count,
+            session->ctx->get_sched_reserve_count());
+}
+
 bool skippy_reuse_plain_chat_sampling(
         skippy_session * session,
         const skippy_sampling_config * sampling,
         const char * metadata_json,
         uint64_t prompt_token_count) {
-    if (session == nullptr || sampling == nullptr || metadata_json == nullptr ||
+    if (session == nullptr || metadata_json == nullptr ||
             std::strcmp(metadata_json, "{\"grammar\":\"\"}") != 0 ||
             session->sampling_chain == nullptr || session->grammar_sampler != nullptr ||
             session->reasoning_budget_sampler != nullptr ||
             !session->sampling_config_valid || session->sampling_config.logit_bias_count != 0 ||
-            sampling->logit_bias_count != 0 ||
-            !skippy_sampling_configs_equal(session->sampling_config, *sampling)) {
+            (sampling != nullptr && sampling->logit_bias_count != 0) ||
+            !skippy_sampling_chain_is_reusable_for(session, sampling)) {
         return false;
     }
     llama_sampler_reset(session->sampling_chain);
+    skippy_store_sampling_config(session, sampling);
     session->chat_sampling_metadata = metadata_json;
     session->grammar_generated_start = prompt_token_count;
     session->sampling_accepted_token_count = 0;
     skippy_refresh_backend_sampling(session, sampling);
+    ++session->sampling_reuse_hit_count;
+    skippy_log_sampling_cache_metrics(session, "reuse");
     return true;
 }
 
@@ -468,6 +523,7 @@ bool skippy_reset_reusable_sampling(skippy_session * session) {
     if (session == nullptr || session->sampling_chain == nullptr ||
             session->grammar_sampler != nullptr || !session->sampling_config_valid ||
             session->reasoning_budget_sampler != nullptr ||
+            session->sampling_backend_retired ||
             session->sampling_config.logit_bias_count != 0) {
         return false;
     }
@@ -476,6 +532,8 @@ bool skippy_reset_reusable_sampling(skippy_session * session) {
     session->grammar_generated_start = 0;
     session->sampling_accepted_token_count = 0;
     skippy_refresh_backend_sampling(session, &session->sampling_config);
+    ++session->sampling_reuse_hit_count;
+    skippy_log_sampling_cache_metrics(session, "reset-reuse");
     return true;
 }
 
@@ -700,6 +758,8 @@ llama_sampler * skippy_build_sampling_chain(
     } else {
         llama_sampler_chain_add(sampler, llama_sampler_init_dist(seed));
     }
+    ++session->sampling_rebuild_count;
+    skippy_log_sampling_cache_metrics(session, "rebuild");
     return sampler;
 }
 
@@ -712,8 +772,8 @@ static bool skippy_ensure_plain_sampling_chain(
 
     if (session->sampling_chain != nullptr &&
             session->chat_sampling_metadata.empty() &&
-            session->sampling_config_valid &&
-            skippy_sampling_configs_equal(session->sampling_config, *sampling)) {
+            skippy_sampling_chain_is_reusable_for(session, sampling)) {
+        skippy_store_sampling_config(session, sampling);
         return true;
     }
 
@@ -722,8 +782,7 @@ static bool skippy_ensure_plain_sampling_chain(
     if (session->sampling_chain == nullptr) {
         return false;
     }
-    session->sampling_config = *sampling;
-    session->sampling_config_valid = true;
+    skippy_store_sampling_config(session, sampling);
     session->sampling_accepted_token_count = 0;
     skippy_refresh_backend_sampling(session, sampling);
     return true;
diff --git a/src/skippy/session.cpp b/src/skippy/session.cpp
index 37b0b9c5b..1babdd733 100644
--- a/src/skippy/session.cpp
+++ b/src/skippy/session.cpp
@@ -305,10 +305,9 @@ enum skippy_status skippy_session_configure_chat_sampling(
             return SKIPPY_STATUS_RUNTIME_ERROR;
         }
         session->chat_sampling_metadata = metadata_json;
-        if (sampling != nullptr) {
-            session->sampling_config = *sampling;
-            session->sampling_config_valid = true;
-        }
+        session->sampling_config = sampling != nullptr ?
+                *sampling : skippy_sampling_config{};
+        session->sampling_config_valid = true;
         session->grammar_generated_start = prompt_token_count;
         session->sampling_accepted_token_count = 0;
         if (!skippy_init_chat_grammar_sampler(session, metadata, out_error)) {
@@ -361,10 +360,14 @@ enum skippy_status skippy_session_reset(
         session->token_history.clear();
     }
     session->signal_history.clear();
-    // Backend sampling allows only one output row per sequence. A pooled
-    // session must therefore detach its sampler before the next request's
-    // multi-token prefill; generation will attach a fresh chain afterwards.
-    if (session->sampling_backend_enabled || !skippy_reset_reusable_sampling(session)) {
+    // Preserve the established detach-on-reset behavior by default until the
+    // reuse path has production benchmark coverage on every backend. Operators
+    // can opt in with SKIPPY_DETACH_SAMPLER_ON_RESET=0. Single-session prefill
+    // requests no output rows; batched prefill requests at most the final row,
+    // so the opt-in path remains within the one-output-per-sequence contract.
+    const bool detach_sampler_on_reset =
+            !skippy_env_disabled("SKIPPY_DETACH_SAMPLER_ON_RESET");
+    if (detach_sampler_on_reset || !skippy_reset_reusable_sampling(session)) {
         skippy_clear_chat_sampling(session);
     }
     skippy_mtp_clear_session_state(session);
diff --git a/src/skippy/tests/runtime_events.cpp b/src/skippy/tests/runtime_events.cpp
index 60357184a..40f056cdc 100644
--- a/src/skippy/tests/runtime_events.cpp
+++ b/src/skippy/tests/runtime_events.cpp
@@ -1,7 +1,9 @@
 #include "skippy.h"
 
 #include "../events_internal.h"
