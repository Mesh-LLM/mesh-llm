From e106c2d00b106fb9cceb5803168d2e753d12854d Mon Sep 17 00:00:00 2001
From: sat <sat@local>
Date: Tue, 22 Sep 2026 16:50:12 +1000
Subject: [PATCH] skippy: remember the stage slice selection across identical
 graph builds

---
 src/skippy/stage_slice_plan.cpp | 161 +++++++++++++++++++++++++++++++-
 1 file changed, 160 insertions(+), 1 deletion(-)

diff --git a/src/skippy/stage_slice_plan.cpp b/src/skippy/stage_slice_plan.cpp
index dda2df504..c2d80e00b 100644
--- a/src/skippy/stage_slice_plan.cpp
+++ b/src/skippy/stage_slice_plan.cpp
@@ -4,6 +4,7 @@
 #include "../../ggml/src/ggml-impl.h"
 
 #include <algorithm>
+#include <cstring>
 #include <set>
 #include <tuple>
 #include <unordered_map>
@@ -594,6 +595,153 @@ struct selector {
 
 }
 
+namespace {
+
+// Graph-derived stage filtering builds the whole-model graph and selects this stage's
+// slice out of it on every graph build, which in steady-state decode is every step.
+// Selecting costs one SHA-256 digest per graph node -- around 1700 of them for an 8B
+// model -- to derive the semantic value identities, and a second digest pass to
+// finalize the slice identity. Those identities are a function of the graph's
+// structure and tensor metadata, the block boundaries, the declared state effects,
+// the parameter and request bindings, and the stage's layer range. None of that moves
+// while a stage serves a fixed model at a fixed shape.
+//
+// So remember the selection against a fingerprint of exactly those inputs. A build
+// whose fingerprint matches would recompute byte-identical identities, which makes
+// replaying the remembered selection the same answer for a few microseconds instead
+// of tens of milliseconds. Inputs the fingerprint does not cover cannot reach the
+// result; anything that does change -- a new shape, a different stage, a graph
+// rebuilt at fresh addresses -- misses and is computed from scratch.
+
+uint64_t fingerprint_bytes(uint64_t hash, const void * data, size_t size) {
+    const auto * bytes = static_cast<const unsigned char *>(data);
+    for (size_t i = 0; i < size; ++i) {
+        hash = (hash ^ bytes[i]) * 0x100000001b3ULL;
+    }
+    return hash;
+}
+
+uint64_t fingerprint_identity(uint64_t hash, const std::string & identity) {
+    hash = fingerprint_bytes(hash, identity.data(), identity.size());
+    return fingerprint_bytes(hash, "", 1);
+}
+
+// Every field a node's semantic identity is derived from, laid out so the whole node
+// folds into the fingerprint in one pass. Zero-initialized on construction so padding
+// never leaks indeterminate bytes into the hash.
+struct fingerprint_node {
+    const void * self;
+    const void * view_src;
+    const void * sources[GGML_MAX_SRC];
+    size_t       view_offs;
+    int64_t      dimensions[GGML_MAX_DIMS];
+    size_t       byte_strides[GGML_MAX_DIMS];
+    int32_t      operation;
+    int32_t      type;
+    int32_t      flags;
+    int32_t      operation_parameters[GGML_MAX_OP_PARAMS / sizeof(int32_t)];
+};
+
+uint64_t selection_fingerprint(
+        const ggml_cgraph * graph,
+        const std::vector<skippy_block_boundary> & boundaries,
+        const std::vector<skippy_state_effect> & state_effects,
+        const std::vector<skippy_parameter_binding> & parameters,
+        const std::vector<skippy_request_input_binding> & request_inputs,
+        int32_t layer_count,
+        int32_t layer_start,
+        int32_t layer_end,
+        const ggml_tensor * explicit_output) {
+    uint64_t hash = 0xcbf29ce484222325ULL;
+    const void * scope[] = {graph, explicit_output};
+    const int32_t range[] = {layer_count, layer_start, layer_end};
+    hash = fingerprint_bytes(hash, scope, sizeof(scope));
+    hash = fingerprint_bytes(hash, range, sizeof(range));
+
+    const int32_t node_count = graph == nullptr ? 0 : graph->n_nodes;
+    hash = fingerprint_bytes(hash, &node_count, sizeof(node_count));
+    for (int32_t index = 0; index < node_count; ++index) {
+        const ggml_tensor * node = graph->nodes[index];
+        fingerprint_node folded = {};
+        folded.self = node;
+        folded.view_src = node->view_src;
+        for (int source = 0; source < GGML_MAX_SRC; ++source) {
+            folded.sources[source] = node->src[source];
+        }
+        folded.view_offs = node->view_offs;
+        for (int axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+            folded.dimensions[axis] = node->ne[axis];
+            folded.byte_strides[axis] = node->nb[axis];
+        }
+        folded.operation = static_cast<int32_t>(node->op);
+        folded.type = static_cast<int32_t>(node->type);
+        folded.flags = node->flags;
+        std::memcpy(folded.operation_parameters, node->op_params,
+                sizeof(folded.operation_parameters));
+        hash = fingerprint_bytes(hash, &folded, sizeof(folded));
+        const char * name = ggml_get_name(node);
+        hash = fingerprint_bytes(hash, name, std::strlen(name) + 1);
+    }
+
+    for (const auto & boundary : boundaries) {
+        const int32_t kind = static_cast<int32_t>(boundary.kind);
+        hash = fingerprint_bytes(hash, &boundary.tensor, sizeof(boundary.tensor));
+        hash = fingerprint_bytes(hash, &kind, sizeof(kind));
+        hash = fingerprint_bytes(hash, &boundary.layer, sizeof(boundary.layer));
+    }
+    for (const auto & effect : state_effects) {
+        const int32_t descriptors[] = {
+            static_cast<int32_t>(effect.kind), static_cast<int32_t>(effect.access),
+            effect.layer, static_cast<int32_t>(effect.residency)};
+        hash = fingerprint_bytes(hash, descriptors, sizeof(descriptors));
+        hash = fingerprint_bytes(hash, &effect.storage, sizeof(effect.storage));
+        hash = fingerprint_bytes(hash, &effect.effect_node, sizeof(effect.effect_node));
+        hash = fingerprint_bytes(hash, &effect.write_ordinal, sizeof(effect.write_ordinal));
+    }
+    for (const auto & parameter : parameters) {
+        hash = fingerprint_bytes(hash, &parameter.tensor, sizeof(parameter.tensor));
+        hash = fingerprint_identity(hash, parameter.identity);
+    }
+    for (const auto & request : request_inputs) {
+        hash = fingerprint_bytes(hash, &request.tensor, sizeof(request.tensor));
+        hash = fingerprint_identity(hash, request.identity);
+    }
+    return hash;
+}
+
+// A stage alternates between a handful of graphs in practice -- the decode profile,
+// whatever prefill shapes it is currently serving, and any auxiliary profile -- so a
+// small ring holds the working set without a long tail of prefill shapes evicting it.
+constexpr size_t REMEMBERED_SELECTIONS = 8;
+
+struct remembered_selection {
+    uint64_t fingerprint = 0;
+    bool occupied = false;
+    skippy_stage_slice_selection selection;
+};
+
+thread_local remembered_selection g_remembered[REMEMBERED_SELECTIONS];
+thread_local size_t g_remembered_next = 0;
+
+const skippy_stage_slice_selection * recall_selection(uint64_t fingerprint) {
+    for (const auto & entry : g_remembered) {
+        if (entry.occupied && entry.fingerprint == fingerprint) {
+            return &entry.selection;
+        }
+    }
+    return nullptr;
+}
+
+void remember_selection(uint64_t fingerprint, const skippy_stage_slice_selection & selection) {
+    auto & entry = g_remembered[g_remembered_next];
+    entry.fingerprint = fingerprint;
+    entry.occupied = true;
+    entry.selection = selection;
+    g_remembered_next = (g_remembered_next + 1) % REMEMBERED_SELECTIONS;
+}
+
+}
+
 bool skippy_select_stage_slice(
         ggml_cgraph * graph,
         const std::vector<skippy_block_boundary> & boundaries,
@@ -608,6 +756,13 @@ bool skippy_select_stage_slice(
         const ggml_tensor * explicit_output) {
     selection = {};
     error.clear();
+    const uint64_t fingerprint = selection_fingerprint(
+            graph, boundaries, state_effects, parameters, request_inputs,
+            layer_count, layer_start, layer_end, explicit_output);
+    if (const auto * remembered = recall_selection(fingerprint)) {
+        selection = *remembered;
+        return true;
+    }
     std::vector<skippy_state_effect> effective_state_effects;
     if (!skippy_infer_state_effects(
                 state_effects, graph, boundaries, effective_state_effects, error)) {
@@ -634,7 +789,11 @@ bool skippy_select_stage_slice(
     for (const auto & request : request_inputs) {
         state.request_names.emplace(canonical_storage(request.tensor), request.identity);
     }
-    return state.select() && skippy_finalize_stage_slice_identity(semantics, selection, error);
+    if (!state.select() || !skippy_finalize_stage_slice_identity(semantics, selection, error)) {
+        return false;
+    }
+    remember_selection(fingerprint, selection);
+    return true;
 }
 
 bool skippy_build_guarded_stage_slice_plan(
