+                }
+            }
         }
         inputs.filter.glm_dsa_phase_hint = glm_dsa_phase_hint;
     }
diff --git a/src/skippy/graph_identity.cpp b/src/skippy/graph_identity.cpp
index 778db99de..807118c9d 100644
--- a/src/skippy/graph_identity.cpp
+++ b/src/skippy/graph_identity.cpp
@@ -778,6 +778,21 @@ bool effect_identity(
 
 }
 
+bool skippy_build_activation_port_identity(
+        const std::string & binding,
+        std::string & identity) {
+    if (binding.empty()) {
+        identity.clear();
+        return false;
+    }
+    encoding encoded;
+    encoded.text("skippy.activation.port");
+    encoded.u32(identity_version);
+    encoded.text(binding);
+    identity = encoded.digest("skippy-port");
+    return true;
+}
+
 bool skippy_build_activation_frontier_identity(
         const skippy_activation_part_desc * parts,
         size_t part_count,
