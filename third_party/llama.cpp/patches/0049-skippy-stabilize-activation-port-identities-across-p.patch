diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 60a9674c3..67f1d2ffc 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2623,13 +2623,15 @@ ggml_cgraph * llama_context::graph_reserve(
                 return;
             }
             skippy_activation_port_shape shape;
-            shape.binding = ggml_get_name(port.tensor);
+            shape.binding = port.binding.empty() ? ggml_get_name(port.tensor) : port.binding;
             if (shape.binding.empty()) {
                 stable = false;
                 return;
             }
             shape.type = port.tensor->type;
-            shape.rank = static_cast<uint32_t>(ggml_n_dims(port.tensor));
+            shape.rank = std::max<uint32_t>(
+                    static_cast<uint32_t>(ggml_n_dims(port.tensor)),
+                    static_cast<uint32_t>(port.token_axis + 1));
             shape.token_axis = port.token_axis;
             shape.optional = port.optional;
             for (int dimension = 0; dimension < GGML_MAX_DIMS; ++dimension) {
diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index c92489c7c..35f2dfdf2 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -26,6 +26,8 @@
 #include <unordered_set>
 
 bool skippy_graph_build_inputs::topology_equal(const skippy_graph_build_inputs & other) const {
+    if (activation_import_bindings != other.activation_import_bindings ||
+            activation_export_bindings != other.activation_export_bindings) return false;
     if (activation_frontier.size() != other.activation_frontier.size()) return false;
     for (size_t index = 0; index < activation_frontier.size(); ++index) {
         const auto & left = activation_frontier[index];
@@ -1621,6 +1623,34 @@ void llm_graph_result::set_outputs(const llm_graph_params & params) {
                 [this](const skippy_activation_port & port) { return port.tensor == t_embd; });
         if (found == activation_exports.end()) activation_exports.insert(activation_exports.begin(), {t_embd, 1, false});
     }
+    const auto bind_ports = [](std::vector<skippy_activation_port> & ports,
+                               const std::vector<std::string> & expected) {
+        if (ports.empty() || ports.size() != expected.size()) return;
+        std::set<size_t> matched;
+        std::vector<size_t> unmatched_ports;
+        for (size_t port_index = 0; port_index < ports.size(); ++port_index) {
+            const char * name = ports[port_index].tensor == nullptr ? nullptr :
+                    ggml_get_name(ports[port_index].tensor);
+            const auto found = name == nullptr ? expected.end() :
+                    std::find(expected.begin(), expected.end(), name);
+            if (found == expected.end()) {
+                unmatched_ports.push_back(port_index);
+                continue;
+            }
+            const size_t binding_index = static_cast<size_t>(found - expected.begin());
+            if (!matched.insert(binding_index).second) return;
+            ports[port_index].binding = *found;
+        }
+        std::vector<size_t> unmatched_bindings;
+        for (size_t index = 0; index < expected.size(); ++index) {
+            if (matched.count(index) == 0) unmatched_bindings.push_back(index);
+        }
+        if (unmatched_ports.size() == 1 && unmatched_bindings.size() == 1) {
+            ports[unmatched_ports.front()].binding = expected[unmatched_bindings.front()];
+        }
+    };
+    bind_ports(activation_imports, params.build_inputs.activation_import_bindings);
+    bind_ports(activation_exports, params.build_inputs.activation_export_bindings);
     if (t_logits != nullptr) {
         ggml_set_output(t_logits);
     }
