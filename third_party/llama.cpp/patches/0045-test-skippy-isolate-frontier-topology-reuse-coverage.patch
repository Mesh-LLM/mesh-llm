From 0aac1cdf5c9d3f4a842c28022be620e58a30d3aa Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Tue, 15 Sep 2026 21:14:33 +1000
Subject: [PATCH] test(skippy): isolate frontier topology reuse coverage

---
 src/skippy/tests/graph_build_inputs.cpp | 26 +++++++++++--------------
 1 file changed, 11 insertions(+), 15 deletions(-)

diff --git a/src/skippy/tests/graph_build_inputs.cpp b/src/skippy/tests/graph_build_inputs.cpp
index a2bbdba24..20a804d20 100644
--- a/src/skippy/tests/graph_build_inputs.cpp
+++ b/src/skippy/tests/graph_build_inputs.cpp
@@ -42,18 +42,6 @@ static skippy_graph_build_inputs make_inputs(uint32_t id) {
     inputs.filter.glm_dsa_phase_hint = static_cast<int32_t>(id % 4);
     inputs.activation_tokens.tokens = reinterpret_cast<const llama_token *>(static_cast<uintptr_t>(id + 1));
     inputs.activation_tokens.token_count = id + 2;
-    skippy_activation_frontier_part_input frontier;
-    frontier.values = reinterpret_cast<const void *>(static_cast<uintptr_t>(id + 3));
-    frontier.payload_bytes = id + 4;
-    frontier.ggml_type = id + 5;
-    frontier.rank = 2;
-    frontier.token_axis = 1;
-    frontier.dimensions[0] = id + 6;
-    frontier.dimensions[1] = id + 7;
-    frontier.byte_strides[0] = 4;
-    frontier.byte_strides[1] = id + 8;
-    frontier.pos_start = static_cast<llama_pos>(id + 9);
-    inputs.activation_frontier.push_back(frontier);
     inputs.mtp_embeddings.values = reinterpret_cast<const float *>(static_cast<uintptr_t>(id + 19));
     inputs.mtp_embeddings.token_count = id + 20;
     inputs.mtp_embeddings.n_embd = id + 21;
@@ -68,9 +56,6 @@ static bool matches(const skippy_graph_build_inputs & inputs, uint32_t id) {
            inputs.filter.layer_end == expected.filter.layer_end &&
            inputs.activation_tokens.tokens == expected.activation_tokens.tokens &&
            inputs.activation_tokens.token_count == expected.activation_tokens.token_count &&
-           inputs.activation_frontier.size() == 1 &&
-           inputs.activation_frontier[0].values == expected.activation_frontier[0].values &&
-           inputs.activation_frontier[0].dimensions[0] == expected.activation_frontier[0].dimensions[0] &&
            inputs.mtp_embeddings.values == expected.mtp_embeddings.values;
 }
 
@@ -107,6 +92,17 @@ static int check_sequential_and_nested_lifetimes() {
 
 static int check_topology_reuse_guards() {
     auto base = make_inputs(31);
+    skippy_activation_frontier_part_input frontier;
+    frontier.values = reinterpret_cast<const void *>(static_cast<uintptr_t>(34));
+    frontier.payload_bytes = 35;
+    frontier.ggml_type = GGML_TYPE_F32;
+    frontier.rank = 2;
+    frontier.token_axis = 1;
+    frontier.dimensions[0] = 8;
+    frontier.dimensions[1] = 1;
+    frontier.byte_strides[0] = 4;
+    frontier.byte_strides[1] = 32;
+    base.activation_frontier.push_back(frontier);
     auto changed_pointer = base;
     changed_pointer.activation_tokens.tokens = reinterpret_cast<const llama_token *>(static_cast<uintptr_t>(999));
     if (!base.topology_equal(changed_pointer)) {
-- 
