diff --git a/src/skippy/tests/graph_contract_cases.cmake b/src/skippy/tests/graph_contract_cases.cmake
index d2eda9f7b..4ee862411 100644
--- a/src/skippy/tests/graph_contract_cases.cmake
+++ b/src/skippy/tests/graph_contract_cases.cmake
@@ -105,3 +105,16 @@ skippy_contract_case(muse-glimmer muse-glimmer 52 6656 0 causal)
 skippy_contract_case(bailingmoe2 bailingmoe2 19 4096 0 causal)
 skippy_contract_case(minimax-m2 minimax-m2 62 3072 0 causal)
 skippy_contract_case(deepseek4 deepseek4 43 4096 0 causal)
+
+# GLM-5.3 is too large for the ordinary one-host family battery. Keep its
+# production topology in a separate synthetic-architecture lane so this case
+# cannot be mistaken for a registry-backed real-artifact certification.
+set(glm53_contract_dir "${SKIPPY_MODEL_FIXTURE_DIR}/contract-glm53-synthetic")
+file(MAKE_DIRECTORY "${glm53_contract_dir}")
+add_test(NAME skippy_generate_contract_glm53_synthetic COMMAND skippy-model-fixture-generator
+    --arch glm-dsa --graph-contract 78 6144 --contract-mtp 1 --out "${glm53_contract_dir}")
+set_tests_properties(skippy_generate_contract_glm53_synthetic PROPERTIES FIXTURES_SETUP contract-glm53-synthetic)
+add_test(NAME skippy_graph_contract_glm53_synthetic COMMAND skippy-graph-contract-models
+    "${glm53_contract_dir}/graph-contract.gguf" causal)
+set_tests_properties(skippy_graph_contract_glm53_synthetic PROPERTIES
+    FIXTURES_REQUIRED contract-glm53-synthetic TIMEOUT 900)
