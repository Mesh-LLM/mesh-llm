From fe2246204c4948128928e6405636da89f1e63a01 Mon Sep 17 00:00:00 2001
From: scama
 <a1860575018c4680d5669dd7bc3bd356b478bccb8d42e194df46304a5e25f49a@meshllm.communities.buzz.xyz>
Date: Sun, 13 Sep 2026 16:05:07 +1000
Subject: [PATCH] fix(cuda): keep feature definition cacheable

---
 ggml/cmake/common.cmake         | 9 +++++++--
 ggml/src/ggml-cuda/ggml-cuda.cu | 4 +++-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/ggml/cmake/common.cmake b/ggml/cmake/common.cmake
index 25eff7a5e..29e71898b 100644
--- a/ggml/cmake/common.cmake
+++ b/ggml/cmake/common.cmake
@@ -92,8 +92,13 @@ function(ggml_cuda_fattn_vec_instances DIR OUT_SRCS)
     endif()
     list(REMOVE_DUPLICATES FA_COMBINATIONS)
 
-    string(REPLACE ";" "," FA_QUANTS_DEFINE "${FA_QUANTS}")
-    add_compile_definitions(GGML_CUDA_FA_QUANTS="${FA_QUANTS_DEFINE}")
+    # Encode list separators as colons for the compiler command line. nvcc
+    # treats commas inside -D values as option separators, while quoted
+    # definitions are re-emitted with escaped quotes that Windows sccache
+    # cannot parse.
+    string(REPLACE ";" ":" FA_QUANTS_DEFINE "${FA_QUANTS}")
+    string(REPLACE "," ":" FA_QUANTS_DEFINE "${FA_QUANTS_DEFINE}")
+    add_compile_definitions(GGML_CUDA_FA_QUANTS=${FA_QUANTS_DEFINE})
     foreach (TYPE_V IN LISTS FA_TYPES)
         foreach (TYPE_K IN LISTS FA_TYPES)
             if ("${TYPE_K}-${TYPE_V}" IN_LIST FA_COMBINATIONS)
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
index 5ae3b8d22..a23417926 100644
--- a/ggml/src/ggml-cuda/ggml-cuda.cu
+++ b/ggml/src/ggml-cuda/ggml-cuda.cu
@@ -5641,7 +5641,9 @@ static ggml_backend_feature * ggml_backend_cuda_get_features(ggml_backend_reg_t
     #endif
 
     #ifdef GGML_CUDA_FA_QUANTS
-        features.push_back({ "FA_QUANTS", GGML_CUDA_FA_QUANTS });
+        static std::string fa_quants = STRINGIFY(GGML_CUDA_FA_QUANTS);
+        std::replace(fa_quants.begin(), fa_quants.end(), ':', ',');
+        features.push_back({ "FA_QUANTS", fa_quants.c_str() });
     #endif
 
     {
