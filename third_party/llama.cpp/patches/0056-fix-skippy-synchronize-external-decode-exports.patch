From f008cc71d9a24bc8230101d2b9d0a3107f8a5278 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Wed, 16 Sep 2026 07:34:42 +1000
Subject: [PATCH] fix(skippy): synchronize external decode exports

---
 src/skippy/speculative_decoding.cpp     |  7 +++++--
 tests/test-skippy-activation-layout.cpp | 24 ++++++++++++++++++++++++
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/src/skippy/speculative_decoding.cpp b/src/skippy/speculative_decoding.cpp
index 253932b8a..2d81379e9 100644
--- a/src/skippy/speculative_decoding.cpp
+++ b/src/skippy/speculative_decoding.cpp
@@ -351,8 +351,11 @@ enum skippy_status skippy_mtp_sync_target_inputs(
 int skippy_external_decode_observe(llama_context * ctx, const llama_batch & batch) {
     skippy_session * session = g_skippy_external_decode_session;
     if (session == nullptr || ctx != session->ctx || batch.n_tokens <= 0 ||
-            session->stage_model == nullptr || session->stage_model->model == nullptr ||
-            session->stage_model->model->arch != LLM_ARCH_INKLING) {
+            session->stage_model == nullptr || session->stage_model->model == nullptr) {
+        return 0;
+    }
+    skippy_mark_context_work_pending(session->stage_model);
+    if (session->stage_model->model->arch != LLM_ARCH_INKLING) {
         return 0;
     }
     session->pending_activation_exports.clear();
diff --git a/tests/test-skippy-activation-layout.cpp b/tests/test-skippy-activation-layout.cpp
index 76077fef6..fa7ceae71 100644
--- a/tests/test-skippy-activation-layout.cpp
+++ b/tests/test-skippy-activation-layout.cpp
@@ -1,4 +1,5 @@
 #include "../src/llama-model.h"
+#include "../src/llama-context.h"
 #include "../src/skippy/activation_internal.h"
 #include "../src/skippy/runtime_types.h"
 
@@ -118,5 +119,28 @@ int main() {
         }
     }
 
+    std::unique_ptr<llama_model> external_decode_model(
+            llama_model_create(LLM_ARCH_LLAMA, llama_model_default_params()));
+    skippy_model external_decode_stage = {};
+    external_decode_stage.model = external_decode_model.get();
+    skippy_session external_decode_session = {};
+    external_decode_session.stage_model = &external_decode_stage;
+    external_decode_session.ctx = reinterpret_cast<llama_context *>(1);
+    llama_batch external_decode_batch = {};
+    external_decode_batch.n_tokens = 1;
+    if (skippy_session_begin_external_decode(&external_decode_session, nullptr) != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "external decode guard could not be started\n");
+        return 8;
+    }
+    if (skippy_external_decode_observe(external_decode_session.ctx, external_decode_batch) != 0 ||
+            !external_decode_stage.context_work_pending.load()) {
+        std::fprintf(stderr, "external decode did not mark asynchronous context work pending\n");
+        return 9;
+    }
+    if (skippy_session_end_external_decode(&external_decode_session, nullptr) != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "external decode guard could not be ended\n");
+        return 10;
+    }
+
     return 0;
 }
-- 
