+enum skippy_status skippy_session_shared_kv_anchor_range(
+        struct skippy_session * session,
+        int32_t * out_anchor_start,
+        int32_t * out_anchor_end,
+        struct skippy_error ** out_error) {
+    if (out_anchor_start != nullptr) {
+        *out_anchor_start = 0;
+    }
+    if (out_anchor_end != nullptr) {
+        *out_anchor_end = 0;
+    }
+    if (session == nullptr || session->ctx == nullptr || out_anchor_start == nullptr || out_anchor_end == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "active session and outputs are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+
+    const llama_hparams & hparams = session->stage_model->model->hparams;
+    const int32_t n_layer_kv_from_start = hparams.n_layer_kv_from_start;
+    if (n_layer_kv_from_start < 2) {
+        // not a shared-KV architecture: nothing to transport
+        return skippy_success(out_error);
+    }
+
+    const int32_t layer_start = session->stage_model->config.layer_start;
+    const int32_t anchor_swa  = n_layer_kv_from_start - 2;
+    const int32_t anchor_full = n_layer_kv_from_start - 1;
+    if (layer_start <= anchor_swa) {
+        // the stage owns (or starts at or below) the anchors: its own forward
+        // passes write the anchor rows; no cross-stage transport is needed
+        return skippy_success(out_error);
+    }
+
+    *out_anchor_start = anchor_swa;
+    *out_anchor_end = anchor_full + 1;
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_session_seed_shared_kv_anchor_page(
+        struct skippy_session * session,
+        const struct skippy_kv_page_desc * desc,
+        const void * input,
+        size_t input_bytes,
+        struct skippy_error ** out_error) {
+    if (session == nullptr || session->ctx == nullptr || desc == nullptr || input == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "session, descriptor, and payload are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+
+    session->ctx->synchronize();
+
+    std::string error;
+    bool ok = false;
+    if (desc->codec == SKIPPY_KV_PAGE_CODEC_ISWA_COMPOSITE_V1) {
+        auto * iswa = skippy_get_iswa_cache(session);
+        if (iswa == nullptr) {
+            skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "composite anchor page requires ISWA memory");
+            return SKIPPY_STATUS_RUNTIME_ERROR;
+        }
+        // decompose into per-subcache single pages and seed each
+        skippy_kv_page_desc base = skippy_page_from_component(*desc, desc->components[0]);
+        skippy_kv_page_desc swa = skippy_page_from_component(*desc, desc->components[1]);
+        const char * bytes = static_cast<const char *>(input);
+        ok = true;
+        if (base.layer_count > 0) {
+            ok = iswa->get_base()->stage_seed_kv_page(session->seq_id, base, bytes, base.payload_bytes, error);
+        }
+        if (ok && swa.layer_count > 0) {
+            ok = iswa->get_swa()->stage_seed_kv_page(session->seq_id, swa, bytes + desc->components[1].payload_offset, swa.payload_bytes, error);
+        }
+    } else if (desc->codec == 0 || desc->codec == SKIPPY_KV_PAGE_CODEC_SINGLE_V1) {
+        if (auto * kv = skippy_get_kv_cache(session, out_error)) {
+            ok = kv->stage_seed_kv_page(session->seq_id, *desc, input, input_bytes, error);
+        }
+    } else {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "unsupported native KV page codec");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+
+    if (!ok) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, error.c_str());
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    return skippy_success(out_error);
+}
