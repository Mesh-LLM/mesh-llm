+/** @brief Reports the shared-KV anchor range the session's stage depends on.
+ *
+ * For architectures whose upper layers reuse the KV cache of two anchor
+ * layers (Gemma3N, Gemma4), a stage slice that starts above the anchors
+ * still allocates the anchor cache tensors and must have their rows seeded
+ * by the upstream stage. Outputs anchor_start = anchor_end = 0 when the
+ * model does not use shared KV or the anchors are inside this stage's own
+ * layer range (nothing to transport).
+ */
+LLAMA_API enum skippy_status skippy_session_shared_kv_anchor_range(
+        struct skippy_session * session,
+        int32_t * out_anchor_start,
+        int32_t * out_anchor_end,
+        struct skippy_error ** out_error);
+
+/** @brief Seeds shared-KV anchor rows exported by the upstream stage.
+ *
+ * Writes the anchor K/V rows into this session's cache without marking any
+ * cell or advancing the session position. Must be called on a fresh session
+ * before any decode: the next decode claims the same cells and its attention
+ * reads the seeded rows in place. `desc` must be a composite ISWA page (or a
+ * single-codec page) exported with the anchor layer range reported by
+ * skippy_session_shared_kv_anchor_range.
+ */
+LLAMA_API enum skippy_status skippy_session_seed_shared_kv_anchor_page(
+        struct skippy_session * session,
+        const struct skippy_kv_page_desc * desc,
+        const void * input,
+        size_t input_bytes,
+        struct skippy_error ** out_error);
+
 /** @brief Saves a session prefix into a resident cache sequence. */
 LLAMA_API enum skippy_status skippy_session_save_prefix(
         struct skippy_session * session,
diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 8242017bd..9e99e1056 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -100,6 +100,43 @@ llama_kv_cache::llama_kv_cache(
 
     const uint32_t n_layer = hparams.n_layer_all;
 
+    // Skippy staged slices: a KV-sharing layer (one whose `reuse` target lies
+    // outside the stage filter) must still resolve its anchor, because it
+    // aliases the anchor's K/V tensors instead of owning its own. Compute the
+    // anchor set up front — every anchor referenced by a filter-passing layer
+    // that the filter itself excludes — plus the transitive closure: an
+    // admitted anchor may itself alias another anchor (e.g. the non-SWA cache
+    // admits full-attention layer 23, which reuses nothing, while the SWA
+    // cache admits SWA anchor 22 whose own reuse is -1; conversely a hybrid
+    // pattern can chain), so follow `reuse` until it stops. Admit those
+    // layers through the primary loop, so the reuse loop below always finds a
+    // physical entry to alias.
+    // Example: Gemma-4 shares KV tensors across layers — only layers
+    // [0, n_layer_kv_from_start) own cache entries and every later layer
+    // aliases an anchor, so any stage starting at or after the first shared
+    // layer drops its anchors and crashes.
+    std::vector<int32_t> reuse_anchors;
+    if (reuse && filter) {
+        for (uint32_t il = 0; il < n_layer; il++) {
+            // note: no has_kv guard here — the reuse loop below also admits
+            // non-KV-owning sharing layers, and those are precisely the layers
+            // whose anchors may lie outside the stage filter
+            if (!filter(il)) {
+                continue;
+            }
+            int32_t il_anchor = reuse(il);
+            while (il_anchor >= 0 && !filter(il_anchor)) {
+                reuse_anchors.push_back(il_anchor);
+                il_anchor = reuse(il_anchor);
+            }
+        }
+        std::sort(reuse_anchors.begin(), reuse_anchors.end());
+        reuse_anchors.erase(std::unique(reuse_anchors.begin(), reuse_anchors.end()), reuse_anchors.end());
+    }
+    const auto is_reuse_anchor = [&reuse_anchors](int32_t il) {
+        return std::find(reuse_anchors.begin(), reuse_anchors.end(), il) != reuse_anchors.end();
+    };
+
     // define a comparator for the buft -> ctx map to ensure that the order is well-defined:
     struct ggml_backend_buft_comparator {
         bool operator()(const ggml_backend_buffer_type_t & lhs, const ggml_backend_buffer_type_t & rhs) const {
@@ -167,11 +204,17 @@ llama_kv_cache::llama_kv_cache(
             continue;
         }
 
-        if (filter && !filter(il)) {
+        const bool admitted_reuse_anchor = is_reuse_anchor((int32_t) il);
+
+        if (filter && !filter(il) && !admitted_reuse_anchor) {
             LLAMA_LOG_DEBUG("%s: layer %3d: filtered\n", __func__, il);
             continue;
         }
 
+        if (admitted_reuse_anchor) {
+            LLAMA_LOG_DEBUG("%s: layer %3d: admitted as reuse anchor\n", __func__, il);
+        }
+
         if (share && other) {
             const int32_t il_share = share(il);
 
@@ -278,9 +321,17 @@ llama_kv_cache::llama_kv_cache(
                 continue;
             }
 
-            GGML_ASSERT(map_layer_ids.find(il_reuse) != map_layer_ids.end());
+            const auto it_reuse = map_layer_ids.find(il_reuse);
+            if (it_reuse == map_layer_ids.end()) {
+                // Skippy stage filters admit the shared-KV reuse anchors into
+                // stage memory, so this is unreachable for well-formed stages.
+                // Keep it a loud construction failure (caught and surfaced as a
+                // null context by llama_init_from_model) rather than a process
+                // abort if a future filter path regresses.
+                throw std::runtime_error(format("kv cache reuse layer %d is missing from the cache (anchor %d was filtered out)", il, il_reuse));
+            }
 
-            map_layer_ids[il] = map_layer_ids[il_reuse];
+            map_layer_ids[il] = it_reuse->second;
 
             LLAMA_LOG_DEBUG("%s: - layer %3d: reuse layer %d, is_swa = %d\n", __func__, il, il_reuse, hparams.is_swa(il));
         }
