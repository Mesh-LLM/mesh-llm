From 31cced897b9d1a0ce0a8de63331d6953034e847b Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Wed, 16 Sep 2026 05:32:54 +1000
Subject: [PATCH] fix(skippy): schedule embedding views used by stages

---
 src/llama-graph.cpp                     |  1 +
 src/skippy/tests/graph_build_inputs.cpp | 12 +++++++++++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index c06a48645..8a9ef3725 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1653,6 +1653,7 @@ void llm_graph_result::set_outputs(const llm_graph_params & params) {
         ggml_set_output(t_logits);
     }
     if (t_embd != nullptr) {
+        ggml_build_forward_expand(gf, t_embd);
         ggml_set_output(t_embd);
     }
     if (t_embd_pooled != nullptr) {
diff --git a/src/skippy/tests/graph_build_inputs.cpp b/src/skippy/tests/graph_build_inputs.cpp
index 3d879cddc..c4b43a65a 100644
--- a/src/skippy/tests/graph_build_inputs.cpp
+++ b/src/skippy/tests/graph_build_inputs.cpp
@@ -256,6 +256,16 @@ static int check_activation_port_alias_is_not_duplicated() {
             ports[0].binding != "stable_export") {
         return 22;
     }
+    bool embedding_view_is_scheduled = false;
+    for (int32_t index = 0; index < ggml_graph_n_nodes(result.get_gf()); ++index) {
+        if (ggml_graph_node(result.get_gf(), index) == view) {
+            embedding_view_is_scheduled = true;
+            break;
+        }
+    }
+    if (!embedding_view_is_scheduled) {
+        return 23;
+    }
 
     llm_graph_result siblings(64);
     auto * sibling_storage = ggml_new_tensor_2d(siblings.get_ctx(), GGML_TYPE_F32, 4, 2);
@@ -269,7 +279,7 @@ static int check_activation_port_alias_is_not_duplicated() {
     const auto & sibling_ports = siblings.get_skippy_activation_exports();
     if (sibling_ports.size() != 2 || sibling_ports[0].tensor != second ||
             sibling_ports[1].tensor != first) {
-        return 23;
+        return 24;
     }
     return 0;
 }
