From f8af1c892dc3dfe0e5be5762629915bc42c4d259 Mon Sep 17 00:00:00 2001
From: Virgile-pct <222121099+Virgile-pct@users.noreply.github.com>
Date: Fri, 2 Oct 2026 22:01:11 +0000
Subject: [PATCH] fix(skippy): resolve auto fused ops from the stage's own
 layers

resolve_fused_ops() reserves the stage graph, then compares the backend of
each fused node with the device of its layer. Stage realization builds the
whole-model graph and keeps only the stage slice, but the fused-node list
still held the nodes of every layer. The scheduler never assigns a backend
to nodes outside the slice, so the first of them read as a device mismatch
and auto turned flash attention, and the DeepSeek V4 HC fusions, off for
that stage.

Keep only the fused nodes that are in the stage graph, as
replace_with_stage_graph() already does for the output tensors. A new
check in skippy-graph-build-inputs opens the stages on both sides of a cut
with flash attention on auto. Each stage must resolve it to enabled, as
the whole model does, and keep the attention nodes of exactly its own
layers in its reserved graph.
---
 src/llama-graph.cpp                     | 13 +++++
 src/skippy/tests/graph_build_inputs.cpp | 74 +++++++++++++++++++++++++
 2 files changed, 87 insertions(+)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 9dd7343d2..2fce22c3f 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1801,6 +1801,19 @@ void llm_graph_result::replace_with_stage_graph(
     for (auto *& tensor : t_sampled_probs) retain_if_present(tensor);
     for (auto *& tensor : t_sampled_logits) retain_if_present(tensor);
     for (auto *& tensor : t_candidates) retain_if_present(tensor);
+
+    // resolve_fused_ops() compares the backend of every fused node with the
+    // device of its layer. Fused nodes of layers outside this stage are not in
+    // the stage graph, so the scheduler never assigns them a backend and they
+    // would read as a device mismatch. Keep only the nodes this stage computes.
+    std::unordered_set<const ggml_tensor *> stage_nodes;
+    for (int index = 0; index < ggml_graph_n_nodes(graph); ++index) {
+        stage_nodes.insert(ggml_graph_node(graph, index));
+    }
+    fused_nodes.erase(std::remove_if(fused_nodes.begin(), fused_nodes.end(),
+            [&stage_nodes](const llm_graph_fused_node & node) {
+                return stage_nodes.count(node.tensor) == 0;
+            }), fused_nodes.end());
 }
 
 bool llm_graph_result::can_reuse(const llm_graph_params & params) {
diff --git a/src/skippy/tests/graph_build_inputs.cpp b/src/skippy/tests/graph_build_inputs.cpp
index 23087204f..e66224f9d 100644
--- a/src/skippy/tests/graph_build_inputs.cpp
+++ b/src/skippy/tests/graph_build_inputs.cpp
@@ -610,6 +610,79 @@ static int check_sched_reserve_and_memory_update(const char * model_path) {
     return 0;
 }
 
+// A stage reserves only its own layers. Auto flash attention must resolve the
+// same way it does for the whole model instead of tripping on the attention
+// nodes of layers the stage does not run, and the stage must still check the
+// attention nodes of the layers it does run.
+static int check_stage_flash_attention_auto(const char * model_path) {
+    llama_model * model = load_model(model_path);
+    const int32_t n_layer = model == nullptr ? 0 : llama_model_n_layer(model);
+    if (n_layer < 2) {
+        llama_model_free(model);
+        return 40;
+    }
+
+    const auto resolve_auto = [model](const skippy_graph_build_inputs & inputs, bool & enabled,
+            std::set<int32_t> & checked_layers) {
+        llama_context_params params = make_context_params(1);
+        params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_AUTO;
+        llama_context * context = llama_init_from_model_with_graph_inputs(model, params, inputs);
+        if (context == nullptr) {
+            return false;
+        }
+        enabled = context->get_cparams().flash_attn;
+        for (const auto & node : context->get_gf_res_reserve()->get_fused_nodes()) {
+            if (node.op == LLM_FUSED_OP_FLASH_ATTN) {
+                checked_layers.insert(node.il);
+            }
+        }
+        llama_free(context);
+        return true;
+    };
+    const auto layer_range = [](int32_t layer_start, int32_t layer_end) {
+        std::set<int32_t> layers;
+        for (int32_t il = layer_start; il < layer_end; ++il) {
+            layers.insert(il);
+        }
+        return layers;
+    };
+
+    bool whole_model_enabled = false;
+    std::set<int32_t> whole_model_layers;
+    if (!resolve_auto(skippy_graph_build_inputs(), whole_model_enabled, whole_model_layers) ||
+            !whole_model_enabled || whole_model_layers != layer_range(0, n_layer)) {
+        llama_model_free(model);
+        return 41;
+    }
+
+    const std::pair<int32_t, int32_t> stages[] = {{0, 1}, {1, n_layer}};
+    for (const auto & [layer_start, layer_end] : stages) {
+        skippy_graph_build_inputs inputs;
+        bool enabled = false;
+        std::set<int32_t> checked_layers;
+        if (!make_stage_inputs(model, 1, layer_start, layer_end, inputs) ||
+                !resolve_auto(inputs, enabled, checked_layers)) {
+            llama_model_free(model);
+            return 42;
+        }
+        if (!enabled) {
+            std::fprintf(stderr, "stage %d..%d resolved auto flash attention to disabled\n",
+                    layer_start, layer_end);
+            llama_model_free(model);
+            return 43;
+        }
+        if (checked_layers != layer_range(layer_start, layer_end)) {
+            std::fprintf(stderr, "stage %d..%d kept flash attention nodes for %zu layers, expected %d\n",
+                    layer_start, layer_end, checked_layers.size(), layer_end - layer_start);
+            llama_model_free(model);
+            return 44;
+        }
+    }
+
+    llama_model_free(model);
+    return 0;
+}
+
 static int check_decode_encode_fallback(const char * model_path) {
     llama_model * model = load_model(model_path);
     if (model == nullptr) {
@@ -1700,6 +1773,7 @@ int main(int argc, char ** argv) {
     }
 #endif
     if (rc == 0) rc = check_sched_reserve_and_memory_update(argv[1]);
+    if (rc == 0) rc = check_stage_flash_attention_auto(argv[1]);
     if (rc == 0) {
         rc = check_decode_encode_fallback(argv[2]);
     }
-- 
2.43.0

