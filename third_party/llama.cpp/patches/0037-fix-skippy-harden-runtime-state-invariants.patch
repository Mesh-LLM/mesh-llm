+            uint16_t split_count = 0;
+            bool invalid_split_metadata = has_split_no != has_split_count;
+            if (i == 0) {
+                split_metadata_expected = has_split_no && has_split_count;
+            } else if (has_split_no != split_metadata_expected) {
