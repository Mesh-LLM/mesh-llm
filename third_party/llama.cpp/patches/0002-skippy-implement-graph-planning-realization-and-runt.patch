@@ -0,0 +1,49 @@
+#pragma once
+
+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+inline bool skippy_env_enabled(const char * name) {
+    const char * value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return false;
+    }
+    return std::strcmp(value, "0") != 0 &&
+           std::strcmp(value, "false") != 0 &&
+           std::strcmp(value, "off") != 0 &&
+           std::strcmp(value, "no") != 0;
+}
+
+inline bool skippy_env_disabled(const char * name) {
+    const char * value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return false;
+    }
+    return std::strcmp(value, "0") == 0 ||
+           std::strcmp(value, "false") == 0 ||
+           std::strcmp(value, "FALSE") == 0 ||
+           std::strcmp(value, "off") == 0 ||
+           std::strcmp(value, "OFF") == 0 ||
+           std::strcmp(value, "no") == 0 ||
+           std::strcmp(value, "NO") == 0;
+}
+
+inline uint32_t skippy_env_u32(const char * name, uint32_t fallback, uint32_t min_value, uint32_t max_value) {
+    const char * value = std::getenv(name);
+    if (value == nullptr || value[0] == '\0') {
+        return fallback;
+    }
+
+    char * end = nullptr;
+    errno = 0;
+    const unsigned long parsed = std::strtoul(value, &end, 10);
+    if (errno != 0 || end == value || *end != '\0') {
+        return fallback;
+    }
+
+    return std::min<uint32_t>(max_value, std::max<uint32_t>(min_value, static_cast<uint32_t>(parsed)));
+}
+
diff --git a/src/skippy/errors.h b/src/skippy/errors.h
new file mode 100644
index 000000000..e3e7cb38d
--- /dev/null
+++ b/src/skippy/errors.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "skippy/common.h"
+
+#include <cstdlib>
+#include <cstring>
+
+static inline skippy_error * skippy_make_error(enum skippy_status status, const char * message) {
+    skippy_error * error = new skippy_error{};
+    error->status = status;
+
+    if (message == nullptr) {
+        error->message = nullptr;
+        return error;
+    }
+
+    const size_t len = std::strlen(message);
+    char * owned = static_cast<char *>(std::malloc(len + 1));
+    if (owned == nullptr) {
+        error->status = SKIPPY_STATUS_ERROR;
+        error->message = nullptr;
+        return error;
+    }
+
+    std::memcpy(owned, message, len + 1);
+    error->message = owned;
+    return error;
+}
+
+static inline void skippy_set_error(
+        skippy_error ** out_error,
+        enum skippy_status status,
+        const char * message) {
+    if (out_error != nullptr) {
+        *out_error = skippy_make_error(status, message);
+    }
+}
+
+static inline enum skippy_status skippy_success(skippy_error ** out_error) {
+    if (out_error != nullptr) {
+        *out_error = nullptr;
+    }
+    return SKIPPY_STATUS_OK;
+}
diff --git a/src/skippy/events.cpp b/src/skippy/events.cpp
new file mode 100644
index 000000000..a7bbe6028
--- /dev/null
+++ b/src/skippy/events.cpp
@@ -0,0 +1,243 @@
+#include "skippy/events.h"
+
+#include "events_internal.h"
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <mutex>
+#include <thread>
+
+namespace {
+
+struct global_reporter_state {
+    // Lifecycle operations are serialized independently from dispatch. A
+    // setter/clearer may wait for callbacks to drain, while a callback only
+    // needs dispatch_mutex to snapshot its current target and retire its
+    // in-flight count.
+    std::mutex lifecycle_mutex;
+    std::mutex dispatch_mutex;
+    std::condition_variable drained;
+    std::atomic<uint64_t> in_flight{0};
+    skippy_runtime_event_callback callback = nullptr;
+    void * user_data = nullptr;
+    std::atomic<uint64_t> next_sequence{1};
+};
+
+global_reporter_state & state() {
+    static global_reporter_state s;
+    return s;
+}
+
+thread_local uint32_t callback_depth = 0;
+
+struct callback_scope {
+    callback_scope() { ++callback_depth; }
+    ~callback_scope() { --callback_depth; }
+};
+
+#if defined(SKIPPY_RUNTIME_EVENTS_TEST_HOOKS)
+using test_lifecycle_hook_fn = void (*)(void *);
+std::atomic<test_lifecycle_hook_fn> test_lifecycle_hook{nullptr};
+std::atomic<void *> test_lifecycle_hook_user_data{nullptr};
+#endif
+
+uint64_t now_mono_ns() {
+    return static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch())
+            .count());
+}
+
+void disable_dispatch(global_reporter_state & s) {
+    // Disable admission before draining. Do not hold dispatch_mutex while
+    // waiting: an in-flight callback must be able to finish and reacquire it
+    // to retire its count.
+    std::lock_guard<std::mutex> lock(s.dispatch_mutex);
+    s.callback = nullptr;
+    s.user_data = nullptr;
+}
+
+void quiesce(global_reporter_state & s) {
+    disable_dispatch(s);
+    std::unique_lock<std::mutex> lock(s.dispatch_mutex);
+    s.drained.wait(lock, [&s] {
+        return s.in_flight.load(std::memory_order_acquire) == 0;
+    });
+}
+
+void callback_finished(global_reporter_state & s) {
+    std::lock_guard<std::mutex> lock(s.dispatch_mutex);
+    s.in_flight.fetch_sub(1, std::memory_order_acq_rel);
+    if (s.in_flight.load(std::memory_order_acquire) == 0) {
+        s.drained.notify_all();
+    }
+}
+
+#if defined(SKIPPY_RUNTIME_EVENTS_TEST_HOOKS)
+void notify_lifecycle_admission_hook() {
+    const auto hook = test_lifecycle_hook.load(std::memory_order_acquire);
+    if (hook != nullptr) {
+        hook(test_lifecycle_hook_user_data.load(std::memory_order_acquire));
+    }
+}
+#endif
+} // namespace
+
+namespace skippy::events {
+
+#if defined(SKIPPY_RUNTIME_EVENTS_TEST_HOOKS)
+void set_lifecycle_admission_hook(lifecycle_admission_hook hook, void * user_data) {
+    test_lifecycle_hook_user_data.store(user_data, std::memory_order_release);
+    test_lifecycle_hook.store(hook, std::memory_order_release);
+}
+#endif
+
+void dispatch(
+        skippy_runtime_event_category category,
+        skippy_runtime_event_kind kind,
+        uint64_t model_id,
+        uint64_t stage_id,
+        uint64_t session_id,
+        skippy_runtime_event_failure_code failure_code,
+        uint64_t numeric_summary_0,
+        uint64_t numeric_summary_1,
+        uint64_t numeric_summary_2,
+        uint64_t numeric_summary_3,
+        const char * detail_ptr,
+        uint64_t detail_len) {
+    auto & s = state();
+
+    // Snapshot the callback and admit the invocation atomically with respect
+    // to lifecycle quiescence. The callback itself runs with both locks
+    // released so it can complete while set/clear waits for its retirement.
+    skippy_runtime_event_callback callback;
+    void * user_data;
+    {
+        std::lock_guard<std::mutex> lock(s.dispatch_mutex);
+        callback = s.callback;
+        user_data = s.user_data;
+        if (callback == nullptr) {
+            return;
+        }
+        s.in_flight.fetch_add(1, std::memory_order_acq_rel);
+    }
+
+    skippy_runtime_event_v1 event{};
+    event.abi_version = SKIPPY_RUNTIME_EVENT_V1_ABI_VERSION;
+    event.struct_size = static_cast<uint32_t>(sizeof(skippy_runtime_event_v1));
+    event.category = category;
+    event.kind = kind;
+    event.emitter = SKIPPY_RUNTIME_EVENT_EMITTER_WORKER_THREAD;
+    event.sequence = s.next_sequence.fetch_add(1, std::memory_order_relaxed);
+    event.timestamp_mono_ns = now_mono_ns();
+    event.model_id = model_id;
+    event.stage_id = stage_id;
+    event.session_id = session_id;
+    event.failure_code = failure_code;
+    event.numeric_summary_0 = numeric_summary_0;
+    event.numeric_summary_1 = numeric_summary_1;
+    event.numeric_summary_2 = numeric_summary_2;
+    event.numeric_summary_3 = numeric_summary_3;
+    event.detail_ptr = detail_ptr;
+    event.detail_len = detail_len;
+
+    {
+        callback_scope scope;
+        callback(&event, user_data);
+    }
+
+    callback_finished(s);
+}
+
+} // namespace skippy::events
+
+enum skippy_status skippy_set_runtime_event_reporter(
+        const struct skippy_runtime_event_reporter_v1 * reporter) {
+    if (reporter == nullptr ||
+        reporter->struct_size < sizeof(struct skippy_runtime_event_reporter_v1)) {
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (callback_depth != 0) {
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+
+    auto & s = state();
+    std::lock_guard<std::mutex> lifecycle_lock(s.lifecycle_mutex);
+#if defined(SKIPPY_RUNTIME_EVENTS_TEST_HOOKS)
+    notify_lifecycle_admission_hook();
+#endif
+    // A replacement has the same lifetime guarantee as clear: no callback
+    // using the previous user_data can remain when this function returns.
+    quiesce(s);
+    {
+        std::lock_guard<std::mutex> dispatch_lock(s.dispatch_mutex);
+        s.callback = reporter->callback;
+        s.user_data = reporter->user_data;
+    }
+    return SKIPPY_STATUS_OK;
+}
+
+void skippy_clear_runtime_event_reporter(void) {
+    auto & s = state();
+    if (callback_depth != 0) {
+        disable_dispatch(s);
+        return;
+    }
+    std::lock_guard<std::mutex> lifecycle_lock(s.lifecycle_mutex);
+    quiesce(s);
+}
+
+void skippy_emit_model_load_event_v2(
+        skippy_runtime_event_kind kind,
+        uint64_t model_id,
+        uint64_t numeric_summary_0,
+        uint64_t numeric_summary_1,
+        const char * detail_ptr,
+        uint64_t detail_len) {
+    skippy::events::dispatch(
+        SKIPPY_RUNTIME_EVENT_CATEGORY_MODEL_OPEN, kind, model_id, 0, 0,
+        SKIPPY_RUNTIME_EVENT_FAILURE_NONE, numeric_summary_0, numeric_summary_1, 0, 0,
+        detail_ptr, detail_len);
+}
+
+void skippy_emit_kv_event(
+        skippy_runtime_event_kind kind,
+        uint64_t session_id,
+        uint64_t numeric_summary_0,
+        uint64_t numeric_summary_1) {
+    skippy::events::dispatch(
+        SKIPPY_RUNTIME_EVENT_CATEGORY_KV, kind, 0, 0, session_id,
+        SKIPPY_RUNTIME_EVENT_FAILURE_NONE, numeric_summary_0, numeric_summary_1, 0, 0,
+        nullptr, 0);
+}
+
+void skippy_emit_device_event(
+        skippy_runtime_event_kind kind,
+        uint64_t numeric_summary_0,
+        const char * detail_ptr,
+        uint64_t detail_len) {
+    skippy::events::dispatch(
+        SKIPPY_RUNTIME_EVENT_CATEGORY_DEVICE, kind, 0, 0, 0,
+        SKIPPY_RUNTIME_EVENT_FAILURE_NONE, numeric_summary_0, 0, 0, 0,
+        detail_ptr, detail_len);
+}
+
+void skippy_emit_diagnostic_event(
+        skippy_runtime_event_kind kind,
+        skippy_runtime_event_failure_code failure_code,
+        const char * detail_ptr,
+        uint64_t detail_len) {
+    skippy::events::dispatch(
+        SKIPPY_RUNTIME_EVENT_CATEGORY_DIAGNOSTIC, kind, 0, 0, 0,
+        failure_code, 0, 0, 0, 0, detail_ptr, detail_len);
+}
+
+void skippy_emit_unload_event(
+        skippy_runtime_event_kind kind,
+        uint64_t model_id,
+        uint64_t numeric_summary_0) {
+    skippy::events::dispatch(
+        SKIPPY_RUNTIME_EVENT_CATEGORY_UNLOAD, kind, model_id, 0, 0,
+        SKIPPY_RUNTIME_EVENT_FAILURE_NONE, numeric_summary_0, 0, 0, 0, nullptr, 0);
+}
diff --git a/src/skippy/events_internal.h b/src/skippy/events_internal.h
new file mode 100644
index 000000000..040f89e1e
--- /dev/null
+++ b/src/skippy/events_internal.h
@@ -0,0 +1,35 @@
+#ifndef SKIPPY_EVENTS_INTERNAL_H
+#define SKIPPY_EVENTS_INTERNAL_H
+
+#include "skippy/events.h"
+
+// Private capability-internal dispatch path shared by every
+// `skippy_emit_*_event` family entrypoint (added by sibling patches). Not
+// part of the installed public ABI: declared under src/skippy/, matching
+// this codebase's private-header convention. Also used directly by the
+// native runtime-event test binary (which shares this include path) so the
+// reporter's own mechanism (install/clear/quiescence/struct-size extension)
+// is testable without depending on any one family's emit entrypoint.
+namespace skippy::events {
+
+#if defined(SKIPPY_RUNTIME_EVENTS_TEST_HOOKS)
+using lifecycle_admission_hook = void (*)(void *);
+void set_lifecycle_admission_hook(lifecycle_admission_hook hook, void * user_data);
+#endif
+void dispatch(
+        skippy_runtime_event_category category,
+        skippy_runtime_event_kind kind,
+        uint64_t model_id,
+        uint64_t stage_id,
+        uint64_t session_id,
+        skippy_runtime_event_failure_code failure_code,
+        uint64_t numeric_summary_0,
+        uint64_t numeric_summary_1,
+        uint64_t numeric_summary_2,
+        uint64_t numeric_summary_3,
+        const char * detail_ptr,
+        uint64_t detail_len);
+
+} // namespace skippy::events
+
+#endif // SKIPPY_EVENTS_INTERNAL_H
diff --git a/src/skippy/executable_graph.cpp b/src/skippy/executable_graph.cpp
new file mode 100644
index 000000000..bb590a6a0
--- /dev/null
+++ b/src/skippy/executable_graph.cpp
@@ -0,0 +1,329 @@
+#include "executable_graph.h"
+
+#include "graph_identity.h"
+#include "stage_slice_plan.h"
+
+#include "../../ggml/src/ggml-impl.h"
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <unordered_set>
+
+namespace {
+
+bool is_storage_leaf(const ggml_tensor * tensor) {
+    if (tensor->op != GGML_OP_NONE || tensor->view_src != nullptr) {
+        return false;
+    }
+    for (const ggml_tensor * src : tensor->src) {
+        if (src != nullptr) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool is_custom_op(ggml_op op) {
+    return op == GGML_OP_MAP_CUSTOM1 || op == GGML_OP_MAP_CUSTOM2 ||
+           op == GGML_OP_MAP_CUSTOM3 || op == GGML_OP_CUSTOM;
+}
+
+bool same_layout(const ggml_tensor * source, const ggml_tensor * clone) {
+    return source->type == clone->type &&
+            std::memcmp(source->ne, clone->ne, sizeof(source->ne)) == 0 &&
+            std::memcmp(source->nb, clone->nb, sizeof(source->nb)) == 0;
+}
+
+bool verify_clone(
+        const ggml_cgraph * source,
+        const std::vector<int32_t> & node_indices,
+        const std::vector<const ggml_tensor *> & imports,
+        const skippy_executable_graph & clone,
+        std::string & error) {
+    std::unordered_set<const ggml_tensor *> imported(imports.begin(), imports.end());
+    std::unordered_set<const ggml_tensor *> clone_tensors;
+    for (const auto & entry : clone.tensors) {
+        if (entry.first == nullptr || entry.second == nullptr || !clone_tensors.insert(entry.second).second ||
+                !same_layout(entry.first, entry.second)) {
+            error = "executable clone has an invalid or conflicting semantic tensor mapping";
+            return false;
+        }
+        if (imported.count(entry.first)) {
+            if (entry.second->op != GGML_OP_NONE || entry.second->view_src != nullptr ||
+                    (entry.second->flags & GGML_TENSOR_FLAG_INPUT) == 0 ||
+                    (entry.second->flags & ~(GGML_TENSOR_FLAG_INPUT | GGML_TENSOR_FLAG_OUTPUT)) != 0) {
+                error = "executable clone did not detach an imported semantic value";
+                return false;
+            }
+            for (const ggml_tensor * dependency : entry.second->src) {
+                if (dependency != nullptr) {
+                    error = "executable clone retained an imported semantic dependency";
+                    return false;
+                }
+            }
+            continue;
+        }
+        if (entry.first->op != entry.second->op || entry.first->view_offs != entry.second->view_offs ||
+                std::memcmp(entry.first->op_params, entry.second->op_params, sizeof(entry.first->op_params)) != 0 ||
+                (entry.first->flags & ~GGML_TENSOR_FLAG_OUTPUT) !=
+                        (entry.second->flags & ~GGML_TENSOR_FLAG_OUTPUT)) {
+            error = "executable clone changed selected semantic tensor metadata";
+            return false;
+        }
+        const ggml_tensor * expected_view = entry.first->view_src == nullptr
+                ? nullptr : clone.tensors.at(entry.first->view_src);
+        if (entry.second->view_src != expected_view) {
+            error = "executable clone changed a selected semantic view reference";
+            return false;
+        }
+        for (int source_index = 0; source_index < GGML_MAX_SRC; ++source_index) {
+            const ggml_tensor * expected = entry.first->src[source_index] == nullptr
+                    ? nullptr : clone.tensors.at(entry.first->src[source_index]);
+            if (entry.second->src[source_index] != expected) {
+                error = "executable clone changed a selected semantic operand reference";
+                return false;
+            }
+        }
+    }
+    std::vector<const ggml_tensor *> expected_nodes;
+    for (int32_t index : node_indices) {
+        const ggml_tensor * tensor = source->nodes[index];
+        if (!is_storage_leaf(tensor)) {
+            expected_nodes.push_back(clone.tensors.at(tensor));
+        }
+    }
+    if (expected_nodes.size() != static_cast<size_t>(clone.graph->n_nodes)) {
+        error = "executable clone node count does not match the selected semantics";
+        return false;
+    }
+    for (size_t index = 0; index < expected_nodes.size(); ++index) {
+        if (clone.graph->nodes[index] != expected_nodes[index]) {
+            error = "executable clone node order does not match the selected semantics";
+            return false;
+        }
+    }
+    return true;
+}
+
+struct graph_builder {
+    skippy_executable_graph result;
+    std::vector<const ggml_tensor *> tensors;
+    std::unordered_set<const ggml_tensor *> available;
+    std::unordered_set<const ggml_tensor *> imported;
+    std::string & error;
+
+    bool dependency(const ggml_tensor * tensor) {
+        if (tensor == nullptr || available.count(tensor)) {
+            return true;
+        }
+        if (!is_storage_leaf(tensor)) {
+            error = "slice dependency is not an earlier selected node, import, or storage leaf";
+            return false;
+        }
+        available.insert(tensor);
+        tensors.push_back(tensor);
+        return true;
+    }
+
+    bool collect(
+            const ggml_cgraph * source,
+            const std::vector<int32_t> & indices,
+            const std::vector<const ggml_tensor *> & imports,
+            const std::vector<const ggml_tensor *> & exports) {
+        std::unordered_set<const ggml_tensor *> members;
+        std::unordered_set<const ggml_tensor *> selected;
+        for (int i = 0; i < source->n_nodes; ++i) {
+            if (source->nodes[i] == nullptr || !members.insert(source->nodes[i]).second) {
+                error = "source graph has null or duplicate nodes";
+                return false;
+            }
+        }
+        for (int i = 0; i < source->n_leafs; ++i) {
+            members.insert(source->leafs[i]);
+        }
+        int32_t previous = -1;
+        for (int32_t index : indices) {
+            if (index <= previous || index < 0 || index >= source->n_nodes) {
+                error = "slice node indices must be unique and in source order";
+                return false;
+            }
+            previous = index;
+            selected.insert(source->nodes[index]);
+        }
+        for (const ggml_tensor * tensor : imports) {
+            if (tensor == nullptr || !members.count(tensor) || selected.count(tensor) ||
+                    !imported.insert(tensor).second) {
+                error = "slice imports must be unique source tensors outside the selection";
+                return false;
+            }
+            available.insert(tensor);
+            tensors.push_back(tensor);
+        }
+        for (int32_t index : indices) {
+            const ggml_tensor * tensor = source->nodes[index];
+            if (is_custom_op(tensor->op)) {
+                error = "slice cannot relocate opaque custom-op state";
+                return false;
+            }
+            // ggml flattens view_src. A detached imported view cannot silently reuse its old base.
+            for (const ggml_tensor * input : imports) {
+                if (input->view_src && tensor->view_src == input->view_src) {
+                    error = "slice view requires alias rebasing across an imported view";
+                    return false;
+                }
+            }
+            // Storage leaves can be graph nodes when marked PARAM.
+            if (!is_storage_leaf(tensor)) {
+                if (!dependency(tensor->view_src)) {
+                    return false;
+                }
+                for (const ggml_tensor * src : tensor->src) {
+                    if (!dependency(src)) {
+                        return false;
+                    }
+                }
+            }
+            if (available.insert(tensor).second) {
+                tensors.push_back(tensor);
+            }
+        }
+        std::unordered_set<const ggml_tensor *> exported;
+        for (const ggml_tensor * tensor : exports) {
+            if (tensor == nullptr || (!selected.count(tensor) && !imported.count(tensor)) ||
+                    !exported.insert(tensor).second) {
+                error = "slice exports must be unique selected or imported tensors";
+                return false;
+            }
+        }
+        return true;
+    }
+
+    void clone_tensors() {
+        for (const ggml_tensor * source : tensors) {
+            ggml_tensor * tensor = ggml_dup_tensor(result.context.get(), source);
+            std::memcpy(tensor->nb, source->nb, sizeof(tensor->nb));
+            ggml_set_name(tensor, source->name);
+            tensor->flags = source->flags & ~GGML_TENSOR_FLAG_COMPUTE;
+            if (imported.count(source)) {
+                tensor->flags = GGML_TENSOR_FLAG_INPUT;
+            } else {
+                tensor->op = source->op;
+                std::memcpy(tensor->op_params, source->op_params, sizeof(tensor->op_params));
+                tensor->view_offs = source->view_offs;
+            }
+            result.tensors.emplace(source, tensor);
+        }
+        for (const ggml_tensor * source : tensors) {
+            if (imported.count(source)) {
+                continue;
+            }
+            ggml_tensor * tensor = result.tensors.at(source);
+            if (source->view_src != nullptr) {
+                tensor->view_src = result.tensors.at(source->view_src);
+            }
+            for (int i = 0; i < GGML_MAX_SRC; ++i) {
+                if (source->src[i] != nullptr) {
+                    tensor->src[i] = result.tensors.at(source->src[i]);
+                }
+            }
+        }
+    }
+};
+
+}
+
+bool skippy_build_executable_graph(
+        const ggml_cgraph * source,
+        const std::vector<int32_t> & node_indices,
+        const std::vector<const ggml_tensor *> & imports,
+        const std::vector<const ggml_tensor *> & exports,
+        skippy_executable_graph & result,
+        std::string & error) {
+    result = {};
+    error.clear();
+    if (source == nullptr || source->n_nodes < 0 || source->n_leafs < 0 ||
+            (node_indices.empty() && imports.empty())) {
+        error = "invalid executable slice request";
+        return false;
+    }
+    graph_builder builder{{}, {}, {}, {}, error};
+    if (!builder.collect(source, node_indices, imports, exports)) {
+        return false;
+    }
+    const size_t count = std::max(size_t(1), builder.tensors.size());
+    if (count > size_t(std::numeric_limits<int32_t>::max()) / GGML_MAX_SRC) {
+        error = "executable slice exceeds graph capacity";
+        return false;
+    }
+    ggml_init_params params = {
+        ggml_tensor_overhead() * count + ggml_graph_overhead_custom(count, false), nullptr, true,
+    };
+    builder.result.context.reset(ggml_init(params));
+    if (!builder.result.context) {
+        error = "cannot allocate executable slice metadata";
+        return false;
+    }
+    builder.clone_tensors();
+    ggml_cgraph * graph = ggml_new_graph_custom(builder.result.context.get(), count, false);
+    graph->order = source->order;
+    // Reuse ggml's traversal to rebuild leaves, visited slots, use counts, and compute flags.
+    // Include storage reachable only through view_src as well as ordinary operand leaves.
+    for (const ggml_tensor * tensor : builder.tensors) {
+        if (is_storage_leaf(tensor) || builder.imported.count(tensor)) {
+            ggml_build_forward_order(graph, builder.result.tensors.at(tensor));
+        }
+    }
+    for (const ggml_tensor * tensor : exports) {
+        ggml_set_output(builder.result.tensors.at(tensor));
+    }
+    // An exported view must also keep its backing allocation alive.
+    for (const auto & entry : builder.result.tensors) {
+        if (entry.second->flags & GGML_TENSOR_FLAG_OUTPUT) {
+            for (ggml_tensor * output = entry.second->view_src; output; output = output->view_src) {
+                ggml_set_output(output);
+            }
+        }
+    }
+    for (int32_t index : node_indices) {
+        const ggml_tensor * tensor = source->nodes[index];
+        if (tensor->flags & GGML_TENSOR_FLAG_COMPUTE) {
+            ggml_build_forward_expand(graph, builder.result.tensors.at(tensor));
+        } else {
+            ggml_build_forward_order(graph, builder.result.tensors.at(tensor));
+        }
+    }
+    builder.result.graph = graph;
+    if (!verify_clone(source, node_indices, imports, builder.result, error)) {
+        return false;
+    }
+    result = std::move(builder.result);
+    return true;
+}
+
+bool skippy_build_executable_graph(
+        const ggml_cgraph * source,
+        const skippy_stage_slice_selection & selection,
+        skippy_executable_graph & result,
+        std::string & error) {
+    result = {};
+    if (source == nullptr || selection.source_graph != source ||
+            !skippy_validate_stage_slice_identity(selection, error)) {
+        if (error.empty()) {
+            error = "executable source does not match the planned semantic graph";
+        }
+        return false;
+    }
+    if (!skippy_build_executable_graph(
+                source,
+                selection.node_indices,
+                selection.activation_imports,
+                selection.activation_exports,
+                result,
+                error)) {
+        return false;
+    }
+    result.slice_identity = selection.slice_identity;
+    result.node_identities = selection.node_identities;
+    return true;
+}
diff --git a/src/skippy/executable_graph.h b/src/skippy/executable_graph.h
new file mode 100644
