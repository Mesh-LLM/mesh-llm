                 return 1;
             }
@@ -96,12 +113,26 @@ int main(int argc, char ** argv) {
                 names.emplace_back(name, length);
             }
             std::sort(names.begin(), names.end());
-            if (names != std::vector<std::string>{"decode", "embeddings:decode", "embeddings:prefill", "prefill"}) {
+            if (names != std::vector<std::string>{"batched-decode", "decode", "embeddings:batched-decode", "embeddings:decode", "embeddings:prefill", "embeddings:prefill-last", "prefill", "prefill-last"}) {
                 std::fprintf(stderr, "planned profile identities differ from requested input modes\n");
                 return 1;
             }
