+        }
         if (strcmp(argv[i], "--deepseek4-mtp") == 0) {
             deepseek4_mtp = true;
         }
@@ -1053,7 +1062,7 @@ int main(int argc, char ** argv) {
             return 0;
         }
         if (!out.empty()) {
-            return save_models(arch, seed, verbosity, out);
+            return save_models(arch, seed, verbosity, out, text_only);
         }
         return test_backends(arch, seed, verbosity);
     } catch (const std::exception & err) {
