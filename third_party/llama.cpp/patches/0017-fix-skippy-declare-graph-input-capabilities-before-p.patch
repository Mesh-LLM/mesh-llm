             LOG_INF("%s: Saving %s model (%s) to %s...\n", __func__, llm_arch_name(arch), moe ? "MoE" : "dense", path.c_str());
@@ -976,11 +981,15 @@ int main(int argc, char ** argv) {
     size_t seed = rd();
     std::string out;
     bool deepseek4_mtp = false;
+    bool text_only = false;
