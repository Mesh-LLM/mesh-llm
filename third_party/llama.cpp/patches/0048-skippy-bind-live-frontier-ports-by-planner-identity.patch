diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index e37a71b66..60a9674c3 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2623,6 +2623,11 @@ ggml_cgraph * llama_context::graph_reserve(
                 return;
             }
             skippy_activation_port_shape shape;
+            shape.binding = ggml_get_name(port.tensor);
+            if (shape.binding.empty()) {
+                stable = false;
+                return;
+            }
             shape.type = port.tensor->type;
             shape.rank = static_cast<uint32_t>(ggml_n_dims(port.tensor));
             shape.token_axis = port.token_axis;
@@ -2644,7 +2649,8 @@ ggml_cgraph * llama_context::graph_reserve(
         for (size_t index = 0; index < shapes.size(); ++index) {
             auto & expected = shapes[index];
             const auto & actual = current[index];
-            if (expected.type != actual.type || expected.rank != actual.rank ||
+            if (expected.binding != actual.binding ||
+                    expected.type != actual.type || expected.rank != actual.rank ||
                     expected.token_axis != actual.token_axis || expected.optional != actual.optional) {
                 stable = false;
                 return;
