diff --git a/src/skippy/stage_program.cpp b/src/skippy/stage_program.cpp
index 7b1a3ba03..b61f47aeb 100644
--- a/src/skippy/stage_program.cpp
+++ b/src/skippy/stage_program.cpp
@@ -244,7 +244,6 @@ bool skippy_stage_program::instantiate(
                 tensor = ggml_new_tensor_4d(context, static_cast<ggml_type>(root.type),
                         dims[0], dims[1], dims[2], dims[3]);
                 ggml_set_input(tensor);
-                result.add_skippy_activation_import(tensor, root.dynamic_axis, false, true);
                 break;
             }
             case root_kind::scratch: {
@@ -278,6 +277,22 @@ bool skippy_stage_program::instantiate(
         if (tensor != nullptr) values.emplace(root.value_id, tensor);
     }
 
+    // Root discovery follows dependency traversal, while the public activation
+    // descriptor follows the admitted frontier order. Reinstall imports in the
+    // latter order so multi-part boundaries keep identity, type, and payload
+    // positions aligned.
+    for (const auto & id : activation_imports) {
+        const auto value = values.find(id);
+        const auto root = std::find_if(roots.begin(), roots.end(), [&](const auto & candidate) {
+            return candidate.value_id == id && candidate.kind == root_kind::activation_import;
+        });
+        if (value == values.end() || root == roots.end()) {
+            error = "stage program activation import is missing or is not a frontier root: " + id;
+            return false;
+        }
+        result.add_skippy_activation_import(value->second, root->dynamic_axis, false, true);
+    }
+
     auto bind = [&](const std::string & id, ggml_tensor * tensor) {
         if (!id.empty() && tensor != nullptr) values[id] = tensor;
     };
