                 top_k = ggml_cont(ctx0, ggml_top_k(ctx0, indexer_score, n_top_k));
+                auto top_k_geometry = skippy_stage_geometry_static(top_k);
+                top_k_geometry.dimensions[1] = skippy_stage_geometry_expression::tokens_per_kv_stream();
