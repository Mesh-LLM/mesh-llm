+        geometry.byte_strides = {
+            skippy_stage_geometry_expression::source_stride(0, 0),
+            skippy_stage_geometry_expression::source_stride(0, 0),
+            skippy_stage_geometry_expression::source_stride(0, 1),
+            skippy_stage_geometry_expression::source_stride(0, 2),
+        };
+        geometry.view_offset = skippy_stage_geometry_expression::constant(0);
+        skippy_stage_geometry_note(kq_mask_all, geometry);
+    }
 
     // reshape top_k indices: [n_top_k, n_batch, 1, n_stream] -> [n_top_k, n_batch, n_stream, 1]
     ggml_tensor * top_k_3d = ggml_view_4d(ctx0, top_k, top_k->ne[0], top_k->ne[1], top_k->ne[3], 1, top_k->nb[1], top_k->nb[2], top_k->ne[3]*top_k->nb[3], 0);
+    {
+        auto geometry = skippy_stage_geometry_static(top_k_3d);
+        geometry.dimensions = {
+            skippy_stage_geometry_expression::source_dimension(0, 0),
+            skippy_stage_geometry_expression::source_dimension(0, 1),
+            skippy_stage_geometry_expression::source_dimension(0, 3),
+            skippy_stage_geometry_expression::constant(1),
+        };
+        geometry.byte_strides = {
+            skippy_stage_geometry_expression::source_stride(0, 0),
+            skippy_stage_geometry_expression::source_stride(0, 1),
+            skippy_stage_geometry_expression::source_stride(0, 2),
+            skippy_stage_geometry_expression::source_stride(0, 3, top_k->ne[3]),
+        };
+        geometry.view_offset = skippy_stage_geometry_expression::constant(0);
+        skippy_stage_geometry_note(top_k_3d, geometry);
+    }
 
     // prepare zero-filled tensor with rows of size 1: [1, n_top_k, n_batch, n_stream]
     // this will be our source of zero values for unmasking top k mask elements
     ggml_tensor * zeros = ggml_new_tensor_4d(ctx0, GGML_TYPE_F32, 1, top_k_3d->ne[0], top_k_3d->ne[1], top_k_3d->ne[2]);
+    auto zeros_geometry = skippy_stage_geometry_static(zeros);
+    zeros_geometry.dimensions[2] = skippy_stage_geometry_expression::tokens_per_kv_stream();
+    zeros_geometry.dimensions[3] = skippy_stage_geometry_expression::kv_stream_count();
+    skippy_stage_geometry_note(zeros, zeros_geometry);
     zeros = ggml_fill(ctx0, zeros, 0.0f);
 
     // modify KQ mask by unmasking elements that are in top_k indices
@@ -3779,6 +3833,23 @@ ggml_tensor * llm_graph_context::build_attn(
     // reshape to restore the original shape of KQ mask:
     // [1, n_kv, n_batch, n_stream] -> [n_kv, n_batch, 1, n_stream]
     kq_mask_top_k = ggml_view_4d(ctx0, kq_mask_top_k, kq_mask_top_k->ne[1], kq_mask_top_k->ne[2], 1, kq_mask_top_k->ne[3], kq_mask_top_k->nb[2], kq_mask_top_k->nb[3], kq_mask_top_k->nb[3], 0);
+    {
+        auto geometry = skippy_stage_geometry_static(kq_mask_top_k);
+        geometry.dimensions = {
+            skippy_stage_geometry_expression::source_dimension(0, 1),
+            skippy_stage_geometry_expression::source_dimension(0, 2),
+            skippy_stage_geometry_expression::constant(1),
+            skippy_stage_geometry_expression::source_dimension(0, 3),
+        };
+        geometry.byte_strides = {
+            skippy_stage_geometry_expression::source_stride(0, 0),
+            skippy_stage_geometry_expression::source_stride(0, 2),
+            skippy_stage_geometry_expression::source_stride(0, 3),
+            skippy_stage_geometry_expression::source_stride(0, 3),
+        };
+        geometry.view_offset = skippy_stage_geometry_expression::constant(0);
+        skippy_stage_geometry_note(kq_mask_top_k, geometry);
+    }
 
     // combine with the original kq mask
     kq_mask_top_k = ggml_add(ctx0, kq_mask_top_k, kq_mask);
