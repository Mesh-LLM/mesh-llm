@@ -3763,13 +3779,51 @@ ggml_tensor * llm_graph_context::build_attn(
     // reshape KQ mask into tensor with rows of size 1:
     // [n_kv, n_batch, 1, n_stream] -> [1, n_kv, n_batch, n_stream]
     kq_mask_all = ggml_view_4d(ctx0, kq_mask_all, 1, kq_mask_all->ne[0], kq_mask_all->ne[1], kq_mask_all->ne[3], kq_mask_all->nb[0], kq_mask_all->nb[1], kq_mask_all->nb[2], 0);
+    {
+        auto geometry = skippy_stage_geometry_static(kq_mask_all);
+        geometry.dimensions = {
+            skippy_stage_geometry_expression::constant(1),
+            skippy_stage_geometry_expression::source_dimension(0, 0),
+            skippy_stage_geometry_expression::source_dimension(0, 1),
+            skippy_stage_geometry_expression::source_dimension(0, 3),
