diff --git a/tests/test-skippy-deepstack-width.h b/tests/test-skippy-deepstack-width.h
new file mode 100644
index 000000000..b6336a161
--- /dev/null
+++ b/tests/test-skippy-deepstack-width.h
@@ -0,0 +1,116 @@
+#pragma once
+
+#include "../src/llama-context.h"
+#include "../src/llama-model.h"
+#include "../src/skippy/activation_internal.h"
+
+// Run the actual activation row packer, decode allocator, microbatch splitter
+// and graph input. Deepstack makes raw projector rows wider than stage rows.
+static std::vector<float> deepstack_decode(
+        llama_model * model, size_t tokens, bool downstream, bool one_at_a_time) {
+    auto params = llama_context_default_params();
+    params.n_ctx = 32;
+    params.n_batch = 8;
+    params.n_ubatch = 2;
+    params.n_threads = 2;
+    params.n_threads_batch = 2;
+    params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    llama_context_ptr ctx(llama_init_from_model(model, params));
+    if (!ctx) throw std::runtime_error("deepstack context creation failed");
+    const size_t width = downstream ? model->hparams.n_embd : model->hparams.n_embd_inp();
+    const size_t stride = width + 3;
+    const size_t vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    std::vector<float> source(tokens * stride, -999.0f);
+    for (size_t row = 0; row < tokens; ++row) {
+        for (size_t col = 0; col < width; ++col) {
+            source[row * stride + col] = std::sin(float(row * 13 + col) * 0.07f);
+        }
+    }
+    std::vector<float> result;
+    for (size_t start = 0; start < tokens;) {
+        const size_t count = one_at_a_time ? 1 : tokens;
+        // Deliberately exact-sized: ASan must catch copying raw-input-width
+        // rows from packed downstream decoder-width storage.
+        std::vector<float> packed(count * width);
+        skippy_activation_desc desc = {};
+        desc.part_count = 1;
+        desc.token_count = count;
+        desc.payload_bytes = count * stride * sizeof(float);
+        auto & part = desc.parts[0];
+        part.ggml_type = GGML_TYPE_F32;
+        part.rank = 2;
+        part.token_axis = 1;
+        part.dimensions[0] = width;
+        part.dimensions[1] = count;
+        part.byte_strides[0] = sizeof(float);
+        part.byte_strides[1] = stride * sizeof(float);
+        part.payload_bytes = desc.payload_bytes;
+        if (skippy_copy_primary_activation_rows(&desc, source.data() + start * stride,
+                    count, width, packed.data(), packed.size(), nullptr) != SKIPPY_STATUS_OK) {
+            throw std::runtime_error("deepstack activation packing failed");
+        }
+        std::vector<llama_pos> positions(count * 4);
+        std::vector<int32_t> n_seq(count, 1);
+        llama_seq_id sequence = 0;
+        std::vector<llama_seq_id *> seq(count, &sequence);
+        std::vector<int8_t> logits(count, 1);
+        for (size_t i = 0; i < count; ++i) {
+            positions[i] = positions[count + i] = positions[2 * count + i] = start + i;
+            positions[3 * count + i] = 0;
+        }
+        llama_batch batch = {};
+        batch.n_tokens = count;
+        batch.embd = packed.data();
+        batch.pos = positions.data();
+        batch.n_seq_id = n_seq.data();
+        batch.seq_id = seq.data();
+        batch.logits = logits.data();
+        skippy_graph_build_inputs inputs;
+        inputs.filter.enabled = true;
+        inputs.filter.layer_start = downstream ? 1 : 0;
+        inputs.filter.layer_end = model->hparams.n_layer();
+        inputs.filter.include_embeddings = !downstream;
+        inputs.filter.include_output = true;
+        if (ctx->decode(batch, inputs) != 0) throw std::runtime_error("deepstack decode failed");
+        for (size_t i = 0; i < count; ++i) {
+            const float * row = llama_get_logits_ith(ctx.get(), i);
+            if (!row) throw std::runtime_error("deepstack logits absent");
+            for (size_t j = 0; j < vocab; ++j) {
+                if (!std::isfinite(row[j])) throw std::runtime_error("deepstack nonfinite logits");
+                result.push_back(row[j]);
+            }
+        }
+        start += count;
+    }
+    return result;
+}
+
+static int test_skippy_deepstack_width() {
+    for (auto arch : {LLM_ARCH_QWEN3VL, LLM_ARCH_QWEN3VLMOE}) {
+        const bool moe = arch == LLM_ARCH_QWEN3VLMOE;
+        auto metadata = get_gguf_ctx(arch, moe);
+        llama_model_saver saver(arch, metadata.get());
+        saver.add_kv(LLM_KV_NUM_DEEPSTACK_LAYERS, uint32_t(1));
+        auto model_and_context = get_model_and_ctx(metadata.get(), nullptr, 1234, {});
+        model_and_context.second.reset();
+        auto * model = model_and_context.first.get();
+        if (model->hparams.n_embd_inp() <= model->hparams.n_embd) {
+            throw std::runtime_error("deepstack fixture lost unequal widths");
+        }
+        for (bool downstream : {true, false}) {
+            for (size_t rows : {size_t(1), size_t(2), size_t(5)}) {
+                auto batched = deepstack_decode(model, rows, downstream, false);
+                auto scalar = deepstack_decode(model, rows, downstream, true);
+                if (batched.size() != scalar.size()) throw std::runtime_error("deepstack logits size mismatch");
+                for (size_t i = 0; i < batched.size(); ++i) {
+                    if (std::abs(batched[i] - scalar[i]) > 1e-4f * (1.0f + std::abs(scalar[i]))) {
+                        throw std::runtime_error("deepstack microbatch row parity mismatch");
+                    }
+                }
+            }
+        }
+        std::printf("deepstack width regression passed: %s (raw=%d decoder=%u)\n",
+                llm_arch_name(arch), model->hparams.n_embd_inp(), model->hparams.n_embd);
+    }
+    return 0;
+}
