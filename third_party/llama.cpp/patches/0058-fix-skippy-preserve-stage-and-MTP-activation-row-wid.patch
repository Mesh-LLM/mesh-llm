diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 67f1d2ffc..52b40c179 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -26,6 +26,25 @@
 // llama_context
 //
 
+int64_t llama_decode_input_width(
+        const llama_hparams & hparams, llm_arch arch, llama_context_type ctx_type,
+        const skippy_graph_build_inputs & inputs, bool has_embeddings) {
+    if (has_embeddings) {
+        // Fused DFlash features and MTP hidden rows precede stage slicing.
+        if (arch == LLM_ARCH_DFLASH) {
+            return hparams.n_embd_inp_enc();
+        }
+        if (ctx_type == LLAMA_CONTEXT_TYPE_MTP) {
+            return hparams.n_embd_out();
+        }
+        if (inputs.filter.enabled && inputs.filter.layer_start > 0) {
+            return hparams.n_embd;
+        }
+    }
+    // Stage zero still consumes the complete projector input, including deepstack.
+    return hparams.n_embd_inp();
+}
+
 static llm_graph_type ctx_type_to_graph_type(llama_context_type ctx_type) {
     switch (ctx_type) {
         case LLAMA_CONTEXT_TYPE_DEFAULT: return LLM_GRAPH_TYPE_DEFAULT;
@@ -1749,9 +1768,8 @@ int llama_context::decode(
     const auto & hparams = model.hparams;
 
     const int64_t n_vocab = vocab.n_tokens();
-    // DFlash embd batches carry the fused target features at the encoder input width
-    const bool    dflash_embd = model.arch == LLM_ARCH_DFLASH && batch_inp.embd;
-    const int64_t n_embd  = dflash_embd ? hparams.n_embd_inp_enc() : hparams.n_embd_inp();
+    const int64_t n_embd = llama_decode_input_width(
+            hparams, model.arch, cparams.ctx_type, graph_build_inputs, batch_inp.embd != nullptr);
 
     // when computing embeddings, all tokens are output
     const bool output_all   = cparams.embeddings;
