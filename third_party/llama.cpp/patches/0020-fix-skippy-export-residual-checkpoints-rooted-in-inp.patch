From 68bef0b6e0598cfe96ebae8db652948af9b9650f Mon Sep 17 00:00:00 2001
From: James Dumay <jameswdumay@gmail.com>
Date: Wed, 23 Sep 2026 07:31:48 +1000
Subject: [PATCH] fix(skippy): export residual checkpoints rooted in input
 boundaries

---
 src/skippy/stage_slice_plan.cpp               | 14 ++---
 .../tests/residual_checkpoint_regression.h    | 52 +++++++++++++++++++
 src/skippy/tests/stage_slice_plan.cpp         |  5 +-
 3 files changed, 63 insertions(+), 8 deletions(-)
 create mode 100644 src/skippy/tests/residual_checkpoint_regression.h

diff --git a/src/skippy/stage_slice_plan.cpp b/src/skippy/stage_slice_plan.cpp
index dda2df504..75a4da24c 100644
--- a/src/skippy/stage_slice_plan.cpp
+++ b/src/skippy/stage_slice_plan.cpp
@@ -297,6 +297,13 @@ struct selector {
         if (cached != request_derived_cache.end()) {
             return cached->second > 0;
         }
+        // Layer boundaries carry activations even when the boundary itself
+        // is a raw-embedding request leaf. Only auxiliary cones outside the blocks
+        // may be rebuilt independently by the adjacent stage.
+        if (block_boundaries.find(tensor) != block_boundaries.end()) {
+            request_derived_cache[tensor] = -1;
+            return false;
+        }
         if (node_index.find(tensor) == node_index.end()) {
             const int structural_classes = structural_class_count(tensor);
             if (structural_classes > 1) {
@@ -320,13 +327,6 @@ struct selector {
             request_derived_cache[tensor] = 1;
             return true;
         }
-        // Transformer boundaries carry computed activations even when their
-        // leaves are all structural. Only auxiliary cones outside the blocks
-        // may be rebuilt independently by the adjacent stage.
-        if (block_boundaries.find(tensor) != block_boundaries.end()) {
-            request_derived_cache[tensor] = -1;
-            return false;
-        }
         if (!request_derived_visiting.insert(tensor).second) {
             error = "graph dependency cycle encountered while resolving request ownership";
             return false;
diff --git a/src/skippy/tests/residual_checkpoint_regression.h b/src/skippy/tests/residual_checkpoint_regression.h
new file mode 100644
index 000000000..31734bf56
--- /dev/null
+++ b/src/skippy/tests/residual_checkpoint_regression.h
@@ -0,0 +1,52 @@
+#pragma once
+
+// An initial raw-embedding boundary is also a request leaf. Its reshaped
+// checkpoint must cross the split, unlike ordinary request-only auxiliaries.
+static int check_raw_embedding_checkpoint() {
+    ggml_init_params params = {
+        ggml_tensor_overhead() * 64 + ggml_graph_overhead_custom(64, false), nullptr, true,
+    };
+    ggml_context_ptr context(ggml_init(params));
+    auto * input = ggml_new_tensor_1d(context.get(), GGML_TYPE_F32, 4);
+    auto * positions = ggml_new_tensor_1d(context.get(), GGML_TYPE_F32, 4);
+    auto * weight = ggml_new_tensor_1d(context.get(), GGML_TYPE_F32, 4);
+    ggml_set_input(input);
+    ggml_set_input(positions);
+    auto * checkpoint = ggml_reshape_3d(context.get(), input, 4, 1, 1);
+    auto * auxiliary = ggml_scale(context.get(), positions, 2.0f);
+    auto * first = ggml_add(context.get(), ggml_mul(context.get(), input, weight), checkpoint);
+    auto * output = ggml_add(context.get(), ggml_add(context.get(), first, checkpoint), auxiliary);
+    auto * graph = ggml_new_graph_custom(context.get(), 64, false);
+    ggml_build_forward_expand(graph, output);
+    const std::vector<skippy_block_boundary> boundaries = {
+        {skippy_block_boundary_kind::entry, 0, input},
+        {skippy_block_boundary_kind::exit, 0, first},
+        {skippy_block_boundary_kind::entry, 1, first},
+        {skippy_block_boundary_kind::exit, 1, output},
+    };
+    const std::vector<skippy_parameter_binding> parameters = {{weight, "weight"}};
+    const std::vector<skippy_request_input_binding> requests = {
+        {input, "embeddings"}, {positions, "positions"},
+    };
+    const std::vector<skippy_state_effect> effects;
+    const skippy_execution_profile_guard guard = {1, 1, 1, 0, "checkpoint", "cpu"};
+    const std::vector<skippy_stage_profile_input> profiles = {{
+        "embeddings:decode", graph, &boundaries, &effects, &parameters, &requests, 2, guard, output,
+    }};
+    skippy_guarded_stage_slice_plan source, final;
+    std::string error;
+    if (!skippy_build_guarded_stage_slice_plan(profiles, 0, 1, source, error) ||
+        !skippy_build_guarded_stage_slice_plan(profiles, 1, 2, final, error) ||
+        !skippy_validate_guarded_stage_chain({&source, &final}, error)) {
+        std::fprintf(stderr, "raw embedding checkpoint chain failed: %s\n", error.c_str());
+        return 90;
+    }
+    const auto & exports = source.profiles.front().slice.activation_exports;
+    const auto & imports = final.profiles.front().slice.activation_imports;
+    if (!contains_tensor(exports, checkpoint) || !contains_tensor(imports, checkpoint) ||
+        contains_tensor(exports, auxiliary) || contains_tensor(imports, auxiliary)) {
+        std::fprintf(stderr, "raw embedding checkpoint or request-only auxiliary misclassified\n");
+        return 91;
+    }
+    return 0;
+}
diff --git a/src/skippy/tests/stage_slice_plan.cpp b/src/skippy/tests/stage_slice_plan.cpp
index 1f5a04c98..69370e576 100644
--- a/src/skippy/tests/stage_slice_plan.cpp
+++ b/src/skippy/tests/stage_slice_plan.cpp
@@ -1127,8 +1127,11 @@ static int check_auxiliary_graph_parameter_closure() {
     return 0;
 }
 
+#include "residual_checkpoint_regression.h"
+
 int main() {
-    int result = check_semantic_identities();
+    int result = check_raw_embedding_checkpoint();
+    if (!result) { result = check_semantic_identities(); }
     if (!result) { result = check_tied_parameter_identity(); }
     if (!result) { result = check_middle_stage_selection(); }
     if (!result) { result = check_inferred_registered_state_write(); }
