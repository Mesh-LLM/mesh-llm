diff --git a/src/skippy/selection_memo.cpp b/src/skippy/selection_memo.cpp
new file mode 100644
index 000000000..1b9051e3e
--- /dev/null
+++ b/src/skippy/selection_memo.cpp
@@ -0,0 +1,145 @@
+#include "selection_memo.h"
+
+#include "../../ggml/src/ggml-impl.h"
+
+#include <unordered_set>
+#include <utility>
+
+namespace {
+
+class metadata_key {
+public:
+    template <typename T> void value(const T & value) {
+        bytes.append(reinterpret_cast<const char *>(&value), sizeof(value));
+    }
+
+    void text(const std::string & text) {
+        value(text.size());
+        bytes.append(text);
+    }
+
+    void tensor(const ggml_tensor * tensor) {
+        value(tensor);
+        if (tensor != nullptr && seen.insert(tensor).second) {
+            pending.push_back(tensor);
+        }
+    }
+
+    void finish_tensors() {
+        // Traverse every reachable external alias and leaf as well as graph nodes.
+        // The visited set terminates cycles; fresh validation still rejects them.
+        for (size_t index = 0; index < pending.size(); ++index) {
+            const ggml_tensor * current = pending[index];
+            value(current);
+            value(current->type);
+            value(current->op);
+            value(current->flags);
+            value(current->view_offs);
+            value(current->ne);
+            value(current->nb);
+            value(current->op_params);
+            value(current->buffer);
+            text(ggml_get_name(current));
+            tensor(current->view_src);
+            for (const ggml_tensor * source : current->src) {
+                tensor(source);
+            }
+        }
+    }
+
+    std::string bytes;
+
+private:
+    std::unordered_set<const ggml_tensor *> seen;
+    std::vector<const ggml_tensor *> pending;
+};
+
+struct remembered_selection {
+    std::string key;
+    skippy_stage_slice_selection selection;
+};
+
+// Bounded per-thread FIFO. Exact key comparison is required: a hash match alone
+// must never authorize reuse of semantic identities or bypass validation.
+constexpr size_t remembered_selections = 8;
+thread_local remembered_selection entries[remembered_selections];
+thread_local size_t next_entry = 0;
+
+}
+
+std::string skippy_stage_slice_memo_key(
+        const ggml_cgraph * graph,
+        const std::vector<skippy_block_boundary> & boundaries,
+        const std::vector<skippy_state_effect> & state_effects,
+        const std::vector<skippy_parameter_binding> & parameters,
+        const std::vector<skippy_request_input_binding> & request_inputs,
+        int32_t layer_count, int32_t layer_start, int32_t layer_end,
+        const ggml_tensor * explicit_output) {
+    if (graph == nullptr || graph->n_nodes <= 0 || graph->n_leafs < 0) {
+        return {};
+    }
+    metadata_key key;
+    key.value(graph);
+    key.value(graph->order);
+    key.value(layer_count);
+    key.value(layer_start);
+    key.value(layer_end);
+    key.tensor(explicit_output);
+    key.value(graph->n_nodes);
+    for (int32_t index = 0; index < graph->n_nodes; ++index) {
+        if (graph->nodes[index] == nullptr) { return {}; }
+        key.tensor(graph->nodes[index]);
+    }
+    key.value(graph->n_leafs);
+    for (int32_t index = 0; index < graph->n_leafs; ++index) {
+        key.tensor(graph->leafs[index]);
+    }
+    key.value(boundaries.size());
+    for (const auto & boundary : boundaries) {
+        key.value(boundary.kind);
+        key.value(boundary.layer);
+        key.tensor(boundary.tensor);
+    }
+    key.value(state_effects.size());
+    for (const auto & effect : state_effects) {
+        key.value(effect.kind);
+        key.value(effect.access);
+        key.value(effect.layer);
+        key.value(effect.residency);
+        key.value(effect.write_ordinal);
+        key.tensor(effect.storage);
+        key.tensor(effect.effect_node);
+    }
+    key.value(parameters.size());
+    for (const auto & parameter : parameters) {
+        key.tensor(parameter.tensor);
+        key.text(parameter.identity);
+    }
+    key.value(request_inputs.size());
+    for (const auto & request : request_inputs) {
+        key.tensor(request.tensor);
+        key.text(request.identity);
+    }
+    key.finish_tensors();
+    return std::move(key.bytes);
+}
+
+const skippy_stage_slice_selection * skippy_recall_stage_slice(const std::string & key) {
+    if (!key.empty()) {
+        for (const auto & entry : entries) {
+            if (entry.key == key) {
+                return &entry.selection;
+            }
+        }
+    }
+    return nullptr;
+}
+
+void skippy_remember_stage_slice(std::string key, const skippy_stage_slice_selection & selection) {
+    if (key.empty()) { return; }
+    auto & entry = entries[next_entry];
+    entry.key.clear();
+    entry.selection = selection;
+    entry.key = std::move(key);
+    next_entry = (next_entry + 1) % remembered_selections;
+}
