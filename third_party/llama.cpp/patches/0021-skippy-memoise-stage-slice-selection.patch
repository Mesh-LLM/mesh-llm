 #include "../../ggml/src/ggml-impl.h"
@@ -608,6 +609,13 @@ bool skippy_select_stage_slice(
         const ggml_tensor * explicit_output) {
     selection = {};
     error.clear();
+    std::string memo_key = skippy_stage_slice_memo_key(
+            graph, boundaries, state_effects, parameters, request_inputs,
+            layer_count, layer_start, layer_end, explicit_output);
+    if (const auto * remembered = skippy_recall_stage_slice(memo_key)) {
+        selection = *remembered;
+        return true;
+    }
     std::vector<skippy_state_effect> effective_state_effects;
     if (!skippy_infer_state_effects(
                 state_effects, graph, boundaries, effective_state_effects, error)) {
@@ -634,7 +642,11 @@ bool skippy_select_stage_slice(
     for (const auto & request : request_inputs) {
         state.request_names.emplace(canonical_storage(request.tensor), request.identity);
     }
-    return state.select() && skippy_finalize_stage_slice_identity(semantics, selection, error);
+    if (!state.select() || !skippy_finalize_stage_slice_identity(semantics, selection, error)) {
+        return false;
+    }
+    skippy_remember_stage_slice(std::move(memo_key), selection);
+    return true;
 }
 
