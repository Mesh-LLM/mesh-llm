diff --git a/src/skippy/tests/selection_memo_regression.h b/src/skippy/tests/selection_memo_regression.h
new file mode 100644
index 000000000..12a0f7c23
--- /dev/null
+++ b/src/skippy/tests/selection_memo_regression.h
@@ -0,0 +1,116 @@
+#pragma once
+
+// Included after semantic_fixture by stage_slice_plan.cpp.
+static bool same_selection(const skippy_stage_slice_selection & a, const skippy_stage_slice_selection & b) {
+    if (std::tie(a.layer_start, a.layer_end, a.source_graph, a.node_indices,
+                a.activation_imports, a.activation_exports, a.request_inputs,
+                a.parameter_identities, a.graph_identity, a.slice_identity, a.node_identities,
+                a.activation_import_identities, a.activation_export_identities,
+                a.request_input_identities, a.state_effect_identities,
+                a.source_snapshot_identity, a.source_value_identities,
+                a.source_value_metadata_identities, a.source_value_references) !=
+            std::tie(b.layer_start, b.layer_end, b.source_graph, b.node_indices,
+                b.activation_imports, b.activation_exports, b.request_inputs,
+                b.parameter_identities, b.graph_identity, b.slice_identity, b.node_identities,
+                b.activation_import_identities, b.activation_export_identities,
+                b.request_input_identities, b.state_effect_identities,
+                b.source_snapshot_identity, b.source_value_identities,
+                b.source_value_metadata_identities, b.source_value_references) ||
+            a.state_effects.size() != b.state_effects.size()) {
+        return false;
+    }
+    for (size_t index = 0; index < a.state_effects.size(); ++index) {
+        const auto & x = a.state_effects[index];
+        const auto & y = b.state_effects[index];
+        if (std::tie(x.kind, x.access, x.layer, x.storage, x.effect_node, x.write_ordinal, x.residency) !=
+                std::tie(y.kind, y.access, y.layer, y.storage, y.effect_node, y.write_ordinal, y.residency)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int check_selection_memo_regressions() {
+    using edit = std::function<void(semantic_fixture &)>;
+    struct regression { const char * name; edit prepare; edit mutate; };
+    const edit unchanged = [](semantic_fixture &) {};
+    const edit unused_parameter = [](semantic_fixture & f) {
+        auto * unused = ggml_new_tensor_1d(f.context.get(), GGML_TYPE_F32, 4);
+        f.parameters.push_back({unused, "unused"});
+    };
+    const edit alias_parameter = [](semantic_fixture & f) {
+        f.parameters[0].tensor = ggml_view_1d(f.context.get(), f.parameter, 4, 0);
+    };
+    const edit constant_leaf = [](semantic_fixture & f) {
+        auto * constant = ggml_new_tensor_1d(f.context.get(), GGML_TYPE_F32, 4);
+        f.side->src[0] = constant;
+        f.graph->leafs[f.graph->n_leafs++] = constant;
+    };
+    const regression cases[] = {
+        {"unchanged cache hit", unchanged, unchanged},
+        {"role swap", unchanged, [](semantic_fixture & f) {
+            f.parameters.push_back({f.request, "tokens"}); f.requests.clear();
+        }},
+        {"external parameter flags", unchanged, [](semantic_fixture & f) { f.parameter->flags |= GGML_TENSOR_FLAG_INPUT; }},
+        {"request flags", unchanged, [](semantic_fixture & f) { f.request->flags &= ~GGML_TENSOR_FLAG_INPUT; }},
+        {"unused binding flags", unused_parameter, [](semantic_fixture & f) {
+            const_cast<ggml_tensor *>(f.parameters.back().tensor)->flags |= GGML_TENSOR_FLAG_INPUT;
+        }},
+        {"canonical binding flags", alias_parameter, [](semantic_fixture & f) { f.parameter->flags |= GGML_TENSOR_FLAG_INPUT; }},
+        {"bound alias flags", alias_parameter, [](semantic_fixture & f) {
+            const_cast<ggml_tensor *>(f.parameters[0].tensor)->flags |= GGML_TENSOR_FLAG_INPUT;
+        }},
+        {"external leaf dimensions", unchanged, [](semantic_fixture & f) { f.parameter->ne[0] = 8; }},
+        {"external leaf strides", unchanged, [](semantic_fixture & f) { f.parameter->nb[1] *= 2; }},
+        {"state storage metadata", unchanged, [](semantic_fixture & f) { f.state->flags |= GGML_TENSOR_FLAG_OUTPUT; }},
+        {"external alias view", alias_parameter, [](semantic_fixture & f) {
+            const_cast<ggml_tensor *>(f.parameters[0].tensor)->view_offs = sizeof(float);
+        }},
+        {"graph order", unchanged, [](semantic_fixture & f) { f.graph->order = GGML_CGRAPH_EVAL_ORDER_RIGHT_TO_LEFT; }},
+        {"constant leaf membership", constant_leaf, [](semantic_fixture & f) { --f.graph->n_leafs; }},
+        {"constant leaf flags", constant_leaf, [](semantic_fixture & f) { f.side->src[0]->flags |= GGML_TENSOR_FLAG_INPUT; }},
+        {"constant leaf buffer", constant_leaf, [](semantic_fixture & f) {
+            // A non-null marker is sufficient for classification; no buffer API is called.
+            f.side->src[0]->buffer = reinterpret_cast<ggml_backend_buffer_t>(f.state);
+        }},
+        {"null node", unchanged, [](semantic_fixture & f) { f.graph->nodes[0] = nullptr; }},
+        {"duplicate node", unchanged, [](semantic_fixture & f) { f.graph->nodes[1] = f.graph->nodes[0]; }},
+        {"forward dependency", unchanged, [](semantic_fixture & f) { f.entry->src[0] = f.exit_1; }},
+        {"cyclic external view", alias_parameter, [](semantic_fixture & f) {
+            auto * alias = const_cast<ggml_tensor *>(f.parameters[0].tensor); alias->view_src = alias;
+        }},
+        {"boundary dependency", unchanged, [](semantic_fixture & f) { f.boundaries[0].tensor = f.parameter; }},
+        {"binding identity bytes", unused_parameter, [](semantic_fixture & f) {
+            f.parameters[0].identity = std::string("weight.shared\0unused", 20);
+            f.parameters[1].identity = "different";
+        }},
+    };
+    for (const auto & test : cases) {
+        semantic_fixture fixture(test.name);
+        test.prepare(fixture);
+        auto select = [&](skippy_stage_slice_selection & selection, std::string & error) {
+            return skippy_select_stage_slice(fixture.graph, fixture.boundaries, fixture.effects,
+                    fixture.parameters, fixture.requests, 2, 0, 1, selection, error, fixture.exit_1);
+        };
+        skippy_stage_slice_selection warm, cached, fresh;
+        std::string error, cached_error, fresh_error;
+        if (!select(warm, error)) {
+            std::fprintf(stderr, "memo %s warmup failed: %s\n", test.name, error.c_str());
+            return 92;
+        }
+        test.mutate(fixture);
+        const bool cached_ok = select(cached, cached_error);
+        bool fresh_ok = false;
+        // A new thread has an empty thread-local memo while retaining exactly the
+        // same graph/tensor addresses and metadata as the warmed caller.
+        std::thread cold([&]() { fresh_ok = select(fresh, fresh_error); });
+        cold.join();
+        if (cached_ok != fresh_ok || (cached_ok && !same_selection(cached, fresh))) {
+            std::fprintf(stderr, "memo %s differs: cached=%d fresh=%d cached_error=%s fresh_error=%s\n",
+                    test.name, cached_ok, fresh_ok, cached_error.c_str(), fresh_error.c_str());
+            return 93;
+        }
+        std::fprintf(stderr, "PASS memo %s: cached=fresh=%d\n", test.name, cached_ok);
+    }
+    return 0;
+}
