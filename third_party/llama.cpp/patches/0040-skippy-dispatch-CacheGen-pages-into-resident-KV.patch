+struct skippy_cachegen_record_v1;
 
 //
 // llama_kv_cache
@@ -209,6 +210,17 @@ public:
             std::string & error,
             bool validate_only = false);
 
+    bool stage_import_cachegen_kv_page(
+            llama_seq_id seq_id,
+            const skippy_kv_page_desc & desc,
+            const skippy_cachegen_record_v1 * records,
+            size_t record_count,
+            size_t output_base,
+            std::string & error,
+            bool & unsupported,
