index 8368e0ee2..ba95e63dc 100644
--- a/src/llama-kv-cache.h
+++ b/src/llama-kv-cache.h
@@ -14,6 +14,7 @@ struct llama_hparams;
 struct llama_model;
 struct llama_context;
