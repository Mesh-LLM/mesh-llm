From 1115f070972cd02956bd4ab682c637fab2df2aa0 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sun, 26 Jul 2026 09:54:12 +1000
Subject: [PATCH] ggml-metal: allow disabling small-batch mul-mm

---
 ggml/src/ggml-metal/ggml-metal-ops.cpp | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 5ead7e432..cf38d16bc 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -62,6 +62,11 @@ static bool ggml_metal_small_batch_mul_mv_ext_disabled() {
     return value && atoi(value) != 0;
 }
 
+static bool ggml_metal_small_batch_mul_mm_disabled() {
+    const char * value = getenv("GGML_METAL_DISABLE_SMALL_BATCH_MUL_MM");
+    return value && atoi(value) != 0;
+}
+
 static bool ggml_metal_glm_dsa_dispatch_log_enabled() {
     const char * value = getenv("GGML_METAL_MOE_DISPATCH_LOG");
     if (value && atoi(value) != 0) {
@@ -7927,6 +7932,7 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
 
         ggml_metal_encoder_dispatch_threadgroups(enc, ((ne01 + r0ptg - 1)/r0ptg), ((ne11 + r1ptg - 1)/r1ptg), ne12*ne13, 32, nsg, 1);
     } else if (
+        !(ggml_metal_small_batch_mul_mm_disabled() && ne11 <= 16) &&
         !ggml_is_transposed(op->src[0]) &&
         !ggml_is_transposed(op->src[1]) &&
         // for now the matrix-matrix multiplication kernel only works on A14+/M1+ SoCs
-- 
