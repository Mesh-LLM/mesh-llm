+        ggml_backend_dev_t d = ggml_backend_dev_get(i);
+        const auto dt = ggml_backend_dev_type(d);
+        if (dt == GGML_BACKEND_DEVICE_TYPE_GPU || dt == GGML_BACKEND_DEVICE_TYPE_IGPU) {
+            gpu_devs++;
+            if (!gpu_dev) gpu_dev = d;
+        }
+    }
