+            const std::string raw = read_text_file(line);
+            if (raw.empty()) { printf("ERR badreq\n"); fflush(stdout); continue; }
+            const common_json req = common_json::parse(raw);
+            seed     = req.value("seed", 0);
+            n_blocks = req.value("n_blocks", 1);
