+    if (params.kv_cache) {
+        llama_diffusion_set_phase(model, /*PKV_UNIFIED=*/0, 0, 0);  // restore default for later turns / masked path
+    }
+    if (dev_sc) {
+        llama_diffusion_set_device_sc(model, false);             // restore host SC path for later turns
+    }
