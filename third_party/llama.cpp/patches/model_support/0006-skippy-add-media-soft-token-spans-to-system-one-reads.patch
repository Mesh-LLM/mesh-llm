diff --git a/include/skippy/system_one.h b/include/skippy/system_one.h
index 6046c77ec..b30c65fea 100644
--- a/include/skippy/system_one.h
+++ b/include/skippy/system_one.h
@@ -27,6 +27,21 @@ struct skippy_system_one_slot {
     size_t label_token_count;
 };
 
+/**
+ * Describes one image soft-token span inside the prompt token array.
+ *
+ * `[prompt_offset, prompt_offset + token_count)` are placeholder rows in the
+ * prompt: the read replaces them with `token_count` rows of `embeddings`
+ * (row-major, `token_count * n_embd` floats, as produced by the model's
+ * multimodal projector). Span rows must be sorted, non-overlapping, and in
+ * bounds; placeholder token IDs in `prompt_tokens` are ignored.
+ */
+struct skippy_system_one_media_span {
+    uint32_t prompt_offset;
+    uint32_t token_count;
+    const float * embeddings;
+};
+
 /**
  * @brief Returns the fixed answer-canvas length encoded by a DiffusionGemma model.
  *
@@ -64,6 +79,33 @@ LLAMA_API enum skippy_status skippy_system_one_read(
         size_t * out_output_count,
         struct skippy_error ** out_error);
 
+/**
+ * @brief Scores structured labels with one DiffusionGemma read over a media prompt.
+ *
+ * Same contract as `skippy_system_one_read`, except that `media_span_count`
+ * soft-token spans replace rows of `prompt_tokens` with projector embeddings
+ * during the prompt prefill. Image spans attend bidirectionally within the
+ * span (matching the architecture's `use_bidirectional_attention == "vision"`
+ * contract); text rows stay causal. Requires the
+ * `SKIPPY_FEATURE_SYSTEM_ONE_MEDIA` feature.
+ */
+LLAMA_API enum skippy_status skippy_system_one_read_media(
+        struct skippy_model * model,
+        const llama_token * prompt_tokens,
+        size_t prompt_token_count,
+        const struct skippy_system_one_media_span * media_spans,
+        size_t media_span_count,
+        const llama_token * canvas_tokens,
+        size_t canvas_token_count,
+        const llama_token * label_token_ids,
+        size_t label_token_count,
+        const struct skippy_system_one_slot * slots,
+        size_t slot_count,
+        float * out_probabilities,
+        size_t output_capacity,
+        size_t * out_output_count,
+        struct skippy_error ** out_error);
+
 #ifdef __cplusplus
 }
 #endif
