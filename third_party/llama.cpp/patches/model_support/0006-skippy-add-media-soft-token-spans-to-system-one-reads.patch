From bad969962d1084cb7f3c39c8ce95aa108ca0afe5 Mon Sep 17 00:00:00 2001
From: James Dumay <jameswdumay@gmail.com>
Date: Thu, 24 Sep 2026 08:48:41 +1000
Subject: [PATCH] skippy: add media soft-token spans to DiffusionGemma
 system-one reads

Extend the system-one native op with an embeddings-input variant:
skippy_system_one_read_media accepts image soft-token spans (projector
embeddings produced via mtmd) and prefills the prompt in mixed token/
embd micro-batches. Image rows attend bidirectionally within their span
in the prefill and unified masks, matching the architecture's
use_bidirectional_attention == "vision" contract; text rows stay causal
and the canvas phase is unchanged. Adds the
SKIPPY_FEATURE_SYSTEM_ONE_MEDIA feature bit and bumps the ABI patch to
63. The text-only entry point keeps its exact behavior.
---
 include/llama.h                |  15 ++++
 include/skippy/common.h        |   4 +-
 include/skippy/system_one.h    |  42 ++++++++++
 src/models/diffusion-gemma.cpp |  62 +++++++++++---
 src/models/models.h            |   5 ++
 src/skippy/abi.cpp             |   3 +-
 src/skippy/system_one.cpp      | 145 +++++++++++++++++++++++++++++++--
 7 files changed, 255 insertions(+), 21 deletions(-)

diff --git a/include/llama.h b/include/llama.h
index 5c194a5dd..26ad5c623 100644
--- a/include/llama.h
+++ b/include/llama.h
@@ -635,6 +635,21 @@ extern "C" {
                        int32_t   P,
                        int32_t   off);
 
+    // DiffusionGemma image soft-token spans for the next prefill/unified decode (no-op otherwise).
+    // Each span {start, end} is a half-open range of absolute prompt positions whose rows carry
+    // projector embeddings (fed via the batch embd path); those rows attend bidirectionally within
+    // the span (use_bidirectional_attention == "vision"), text rows stay causal. Copied on set;
+    // pass count = 0 to clear.
+    struct llama_diffusion_media_span {
+        int32_t start; // first prompt position of the span (inclusive)
+        int32_t end;   // one past the last prompt position of the span
+    };
+
+    LLAMA_API void llama_diffusion_set_media_spans(
+            struct llama_model * model,
+            const struct llama_diffusion_media_span * spans,
+                             size_t   count);
+
     // DiffusionGemma prompt-KV store bytes per prompt token (0 for other models). Pass use_f16 = whether
     // flash attention is enabled (the store is F16 under FA, F32 otherwise). Sizes context against the store.
     LLAMA_API size_t llama_diffusion_pkv_bytes_per_token(
