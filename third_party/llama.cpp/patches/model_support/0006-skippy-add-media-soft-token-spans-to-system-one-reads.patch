+
+// Public API: set the image soft-token spans for the next PREFILL/UNIFIED decode (copied; count = 0 clears).
+void llama_diffusion_set_media_spans(struct llama_model * model, const struct llama_diffusion_media_span * spans, size_t count) {
+    auto * dm = dynamic_cast<llama_model_diffusion_gemma *>(model);
+    if (!dm) {
+        return;
+    }
+    dm->media_spans.assign(spans, spans + count);
+}
