     session->mtp_has_pending_h = false;
@@ -4353,6 +4422,97 @@ static enum skippy_status skippy_verify_activation_frame(
     return status;
 }
 
+static std::vector<uint8_t> skippy_verify_prefix_activation_payload(
+        const skippy_session * session,
+        const skippy_verify_checkpoint & checkpoint,
+        size_t token_count) {
+    const uint64_t flags = checkpoint.input_desc.flags;
+    const size_t prefix_bytes = skippy_activation_payload_bytes(session, token_count, flags);
+    std::vector<uint8_t> payload(prefix_bytes);
+    if ((flags & SKIPPY_ACTIVATION_FLAG_GEMMA3N_ALTUP) != 0) {
+        std::memcpy(payload.data(), checkpoint.input_payload.data(), prefix_bytes);
+        return payload;
+    }
+
+    const size_t source_hidden_bytes = skippy_activation_hidden_bytes(session, checkpoint.token_count);
+    const size_t prefix_hidden_bytes = skippy_activation_hidden_bytes(session, token_count);
+    std::memcpy(payload.data(), checkpoint.input_payload.data(), prefix_hidden_bytes);
+    size_t source_offset = source_hidden_bytes;
+    size_t prefix_offset = prefix_hidden_bytes;
+    if ((flags & SKIPPY_ACTIVATION_FLAG_RWKV7_V_FIRST) != 0) {
+        std::memcpy(
+                payload.data() + prefix_offset,
+                checkpoint.input_payload.data() + source_offset,
+                prefix_hidden_bytes);
+        source_offset += source_hidden_bytes;
+        prefix_offset += prefix_hidden_bytes;
+    }
+    if ((flags & SKIPPY_ACTIVATION_FLAG_INKLING_MTP_EMBD) != 0) {
+        std::memcpy(
+                payload.data() + prefix_offset,
+                checkpoint.input_payload.data() + source_offset,
+                prefix_hidden_bytes);
+    }
+    return payload;
+}
+
+static enum skippy_status skippy_restore_verify_prefix(
+        skippy_session * session,
+        uint64_t token_count,
+        bool * out_restored,
+        skippy_error ** out_error) {
+    *out_restored = false;
+    const skippy_verify_checkpoint & checkpoint = session->verify_checkpoint;
+    const uint64_t token_start = static_cast<uint64_t>(checkpoint.token_start);
+    const uint64_t token_end = token_start + checkpoint.token_count;
+    if (!checkpoint.valid || token_count < token_start || token_count >= token_end) {
+        return skippy_success(out_error);
+    }
+
+    const size_t read = llama_state_seq_set_data(
+            session->ctx,
+            checkpoint.state.data(),
+            checkpoint.state.size(),
+            session->seq_id);
+    if (read != checkpoint.state.size()) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to restore verify-window sequence state");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+
+    session->n_past = checkpoint.token_start;
+    const size_t accepted_count = static_cast<size_t>(token_count - token_start);
+    enum skippy_status status = SKIPPY_STATUS_OK;
+    if (accepted_count > 0 && checkpoint.has_activation_input) {
+        skippy_activation_desc input_desc = checkpoint.input_desc;
+        std::vector<uint8_t> input_payload = skippy_verify_prefix_activation_payload(
+                session, checkpoint, accepted_count);
+        input_desc.token_count = static_cast<uint32_t>(accepted_count);
+        input_desc.payload_bytes = input_payload.size();
+        const llama_token * token_ids = checkpoint.token_ids.empty() ? nullptr : checkpoint.token_ids.data();
+        status = skippy_decode_activation_frame(
+                session,
+                &input_desc,
+                input_payload.data(),
+                token_ids,
+                nullptr,
+                0,
+                accepted_count,
+                false,
+                out_error);
+    } else if (accepted_count > 0) {
+        status = skippy_decode_tokens(
+                session,
+                checkpoint.token_ids.data(),
+                accepted_count,
+                false,
+                out_error);
+    }
+    if (status == SKIPPY_STATUS_OK) {
+        *out_restored = true;
+    }
+    return status;
+}
+
