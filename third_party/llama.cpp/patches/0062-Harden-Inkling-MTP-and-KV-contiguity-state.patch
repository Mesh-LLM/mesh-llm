     std::vector<uint8_t> payload(prefix_hidden_bytes + prefix_glm_dsa_bytes + prefix_rwkv7_bytes);
     std::memcpy(payload.data(), checkpoint.input_payload.data(), prefix_hidden_bytes);
 
@@ -4478,7 +4496,7 @@ static std::vector<uint8_t> skippy_verify_prefix_activation_payload(
                 payload.data() + prefix_offset,
                 checkpoint.input_payload.data() + source_offset,
                 prefix_glm_dsa_bytes);
-        source_offset += skippy_glm_dsa_top_k_bytes_for_count(checkpoint.token_count, glm_dsa_top_k);
+        source_offset += source_glm_dsa_bytes;
         prefix_offset += prefix_glm_dsa_bytes;
     }
     if (prefix_rwkv7_bytes > 0) {
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
