 src/skippy.cpp                            | 20 ++++++++++-
 tests/CMakeLists.txt                      |  1 +
 tests/test-skippy-kv-cells-contiguous.cpp | 20 +++++++++++
 7 files changed, 82 insertions(+), 15 deletions(-)
