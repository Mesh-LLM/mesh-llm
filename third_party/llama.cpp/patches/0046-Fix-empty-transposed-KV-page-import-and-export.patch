From 91eaf086ccb425da6c05af606f9ed20eb558cf3a Mon Sep 17 00:00:00 2001
From: James Dumay <jameswdumay@gmail.com>
Date: Sun, 26 Jul 2026 15:39:58 +1000
Subject: [PATCH 46/47] Fix empty transposed KV page import and export

---
 src/llama-kv-cache.cpp               |   6 +
 tests/CMakeLists.txt                 |   1 +
 tests/test-skippy-kv-page-export.cpp | 165 +++++++++++++++++++++++++++
 3 files changed, 172 insertions(+)
 create mode 100644 tests/test-skippy-kv-page-export.cpp

diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index c4517d65..117855d6 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -1622,6 +1622,9 @@ bool llama_kv_cache::stage_export_kv_page(
         }
     } else {
         for (const auto * layer : selected) {
+            if (v_element_bytes == 0) {
+                continue;
+            }
             auto * v = layer->v_stream[strm];
             const uint32_t n_embd_v_gqa = hparams.n_embd_v_gqa(layer->il);
             for (uint32_t j = 0; j < n_embd_v_gqa; ++j) {
@@ -1804,6 +1807,9 @@ bool llama_kv_cache::stage_import_kv_page(
         }
     } else {
         for (const auto * layer : selected) {
+            if (desc.v_element_bytes == 0) {
+                continue;
+            }
             auto * v = layer->v_stream[strm];
             const uint32_t n_embd_v_gqa = hparams.n_embd_v_gqa(layer->il);
             for (uint32_t j = 0; j < n_embd_v_gqa; ++j) {
diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index 7a93b19a..158ab28d 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -151,6 +151,7 @@ endif ()
 llama_build(test-recurrent-state-rollback.cpp get-model.cpp)
 
 if (NOT WIN32 OR NOT BUILD_SHARED_LIBS)
+    llama_build_and_test(test-skippy-kv-page-export.cpp)
     # these tests are disabled on Windows because they use internal functions not exported with LLAMA_API (when building with shared libraries)
     llama_build_and_test(test-sampling.cpp)
     llama_build_and_test(test-reasoning-budget.cpp)
diff --git a/tests/test-skippy-kv-page-export.cpp b/tests/test-skippy-kv-page-export.cpp
new file mode 100644
index 00000000..724835df
--- /dev/null
+++ b/tests/test-skippy-kv-page-export.cpp
@@ -0,0 +1,165 @@
+#include "skippy.h"
+
+#include "../src/llama-batch.h"
+#include "../src/llama-kv-cache.h"
+#include "../src/llama-model.h"
+
+#include <cstdio>
+#include <memory>
+#include <string>
+#include <vector>
+
+int main() {
+    std::unique_ptr<llama_model> model(llama_model_create(LLM_ARCH_LLAMA, llama_model_default_params()));
+    if (!model) {
+        fprintf(stderr, "failed to create test model\n");
+        return 1;
+    }
+    llama_hparams hparams = {};
+    hparams.n_layer_all = 1;
+    hparams.n_embd_head_k_full = 4;
+    hparams.n_embd_head_v_full = 4;
+    hparams.n_embd_head_k_swa = 4;
+    hparams.n_embd_head_v_swa = 4;
+    hparams.n_embd_head_k_mla_impl = 4;
+    hparams.n_embd_head_v_mla_impl = 4;
+    hparams.n_head_arr[0] = 1;
+    hparams.n_head_kv_arr[0] = 1;
+
+    llama_kv_cache kv(
+            *model,
+            hparams,
+            GGML_TYPE_F32,
+            GGML_TYPE_F32,
+            true,
+            false,
+            true,
+            1,
+            1,
+            1,
+            0,
+            LLAMA_SWA_TYPE_NONE,
+            nullptr,
+            {},
+            {},
+            {});
+
+    llama_pos pos = 0;
+    llama_seq_id seq_id = 0;
+    llama_seq_id * seq_ids = &seq_id;
+    int32_t n_seq_id = 1;
+    llama_ubatch ubatch = {};
+    ubatch.n_tokens = 1;
+    ubatch.n_pos = 1;
+    ubatch.pos = &pos;
+    ubatch.n_seq_id = &n_seq_id;
+    ubatch.seq_id = &seq_ids;
+
+    llama_kv_cache::slot_info slot = {};
+    slot.s0 = 0;
+    slot.s1 = 0;
+    slot.strm = { 0 };
+    slot.idxs = {{ 0 }};
+    kv.apply_ubatch(slot, ubatch);
+
+    skippy_kv_page_desc desc = {};
+    size_t payload_bytes = 0;
+    std::string error;
+    if (!kv.stage_export_kv_page(
+                0,
+                0,
+                1,
+                0,
+                1,
+                &desc,
+                nullptr,
+                0,
+                &payload_bytes,
+                error)) {
+        fprintf(stderr, "K-only KV page sizing failed: %s\n", error.c_str());
+        return 1;
+    }
+    if ((desc.flags & SKIPPY_KV_PAGE_FLAG_V_TRANSPOSED) == 0 ||
+            desc.v_row_bytes != 0 ||
+            desc.v_element_bytes != 0 ||
+            payload_bytes == 0) {
+        fprintf(stderr, "unexpected K-only transposed KV page descriptor\n");
+        return 1;
+    }
+
+    std::vector<uint8_t> payload(payload_bytes);
+    if (!kv.stage_export_kv_page(
+                0,
+                0,
+                1,
+                0,
+                1,
+                &desc,
+                payload.data(),
+                payload.size(),
+                &payload_bytes,
+                error)) {
+        fprintf(stderr, "K-only KV page export failed: %s\n", error.c_str());
+        return 1;
+    }
+
+    if (payload_bytes != payload.size()) {
+        fprintf(stderr, "K-only KV page export byte count mismatch\n");
+        return 1;
+    }
+    if (!kv.stage_import_kv_page(
+                0,
+                desc,
+                payload.data(),
+                payload.size(),
+                error)) {
+        fprintf(stderr, "K-only KV page import failed: %s\n", error.c_str());
+        return 1;
+    }
+
+    skippy_kv_page_desc roundtrip_desc = {};
+    size_t roundtrip_bytes = 0;
+    if (!kv.stage_export_kv_page(
+                0,
+                0,
+                1,
+                0,
+                1,
+                &roundtrip_desc,
+                nullptr,
+                0,
+                &roundtrip_bytes,
+                error)) {
+        fprintf(stderr, "K-only KV page round-trip sizing failed: %s\n", error.c_str());
+        return 1;
+    }
+    if (roundtrip_bytes != payload.size() ||
+            roundtrip_desc.flags != desc.flags ||
+            roundtrip_desc.k_row_bytes != desc.k_row_bytes ||
+            roundtrip_desc.v_row_bytes != 0 ||
+            roundtrip_desc.v_element_bytes != 0) {
+        fprintf(stderr, "unexpected K-only transposed KV page round-trip descriptor\n");
+        return 1;
+    }
+    std::vector<uint8_t> roundtrip_payload(roundtrip_bytes);
+    if (!kv.stage_export_kv_page(
+                0,
+                0,
+                1,
+                0,
+                1,
+                &roundtrip_desc,
+                roundtrip_payload.data(),
+                roundtrip_payload.size(),
+                &roundtrip_bytes,
+                error)) {
+        fprintf(stderr, "K-only KV page round-trip export failed: %s\n", error.c_str());
+        return 1;
+    }
+    if (roundtrip_payload != payload) {
+        fprintf(stderr, "K-only KV page payload changed after round trip\n");
+        return 1;
+    }
+
+    return 0;
+}
-- 
