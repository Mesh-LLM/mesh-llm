-struct test_glm_dsa_selected_row_tiled_parity : public test_case {
+struct test_case_with_scoped_env : public test_case {
+    using env_setting = std::pair<const char *, const char *>;
+
+    virtual std::vector<env_setting> env_settings() const = 0;
+
+    test_status_t eval(
+            ggml_backend_t backend1,
+            ggml_backend_t backend2,
+            const char * op_names_filter,
+            printer * output_printer) override {
+        [[maybe_unused]] auto env = scoped_env();
+        return test_case::eval(backend1, backend2, op_names_filter, output_printer);
+    }
+
+    bool eval_perf(ggml_backend_t backend, const char * op_names_filter, printer * output_printer) override {
+        [[maybe_unused]] auto env = scoped_env();
+        return test_case::eval_perf(backend, op_names_filter, output_printer);
+    }
+
+private:
+    std::vector<std::unique_ptr<scoped_test_env>> scoped_env() const {
+        std::vector<std::unique_ptr<scoped_test_env>> env;
+        for (const auto & setting : env_settings()) {
+            env.emplace_back(std::make_unique<scoped_test_env>(setting.first, setting.second));
+        }
+        return env;
+    }
+};
+
+struct test_glm_dsa_selected_row_tiled_parity : public test_case_with_scoped_env {
     static constexpr int64_t dk      = 576;
