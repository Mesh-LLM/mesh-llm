+    llama_token tokens[] = {3, 7};
+    llama_batch batch = llama_batch_init(2, 0, 1);
+    batch.n_tokens = 2;
+    for (int row = 0; row < 2; ++row) {
+        batch.token[row] = tokens[row];
+        batch.pos[row] = row;
+        batch.n_seq_id[row] = 1;
+        batch.seq_id[row][0] = session->seq_id;
+        batch.logits[row] = 1;
+    }
+    const auto rc = skippy_decode_batch(session, batch, 2, -1, &error, nullptr);
+    llama_batch_free(batch);
+    if (rc != 0) return 10;
+    if (!integrated) {
+        skippy_session_free(session, &error);
+        skippy_model_free(runtime, &error);
+        skippy_error_free(error);
+        return 0;
+    }
+    if (skippy_mtp_sync_target_inputs(session, tokens, nullptr, 2, 0, &error) != SKIPPY_STATUS_OK) {
+        fprintf(stderr, "MTP sync: %s\n", error ? error->message : "unknown"); return 11;
+    }
+    session->n_past = 2;
+    skippy_native_mtp_draft draft{};
+    if (skippy_mtp_propose_next(session, 31, 2, &draft, &error) != SKIPPY_STATUS_OK || draft.token_count != 2) {
+        fprintf(stderr, "MTP draft: %s\n", error ? error->message : "unknown"); return 12;
+    }
+    skippy_session_free(session, &error);
+    skippy_model_free(runtime, &error);
+    skippy_error_free(error);
+    return 0;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 2) return 64;
+    llama_backend_init();
+    int result = run(argv[1], false);
+    if (result == 0) result = run(argv[1], true);
+    llama_backend_free();
+    return result;
+}
