From bc35da7162f68fc3fb6432e04bbdca80a94f667b Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Wed, 16 Sep 2026 01:15:11 +1000
Subject: [PATCH] fix(skippy): bind ordered multipart activation ports

---
 src/llama-graph.cpp                     |  6 +++--
 src/skippy/tests/graph_build_inputs.cpp | 31 +++++++++++++++++++++++++
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 35f2dfdf2..a902cb865 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1645,8 +1645,10 @@ void llm_graph_result::set_outputs(const llm_graph_params & params) {
         for (size_t index = 0; index < expected.size(); ++index) {
             if (matched.count(index) == 0) unmatched_bindings.push_back(index);
         }
-        if (unmatched_ports.size() == 1 && unmatched_bindings.size() == 1) {
-            ports[unmatched_ports.front()].binding = expected[unmatched_bindings.front()];
+        if (unmatched_ports.size() == unmatched_bindings.size()) {
+            for (size_t index = 0; index < unmatched_ports.size(); ++index) {
+                ports[unmatched_ports[index]].binding = expected[unmatched_bindings[index]];
+            }
         }
     };
     bind_ports(activation_imports, params.build_inputs.activation_import_bindings);
diff --git a/src/skippy/tests/graph_build_inputs.cpp b/src/skippy/tests/graph_build_inputs.cpp
index d9f0c170f..c82253a2e 100644
--- a/src/skippy/tests/graph_build_inputs.cpp
+++ b/src/skippy/tests/graph_build_inputs.cpp
@@ -210,6 +210,34 @@ static int check_mtp_request_input_registration() {
     return 0;
 }
 
+static int check_activation_port_binding() {
+    llm_graph_result result(64);
+    auto * first = ggml_new_tensor_1d(result.get_ctx(), GGML_TYPE_F32, 4);
+    auto * second = ggml_new_tensor_1d(result.get_ctx(), GGML_TYPE_F32, 4);
+    auto * third = ggml_new_tensor_1d(result.get_ctx(), GGML_TYPE_F32, 4);
+    ggml_set_name(first, "local_first");
+    ggml_set_name(second, "stable_second");
+    ggml_set_name(third, "local_third");
+    result.add_skippy_activation_import(first, 0);
+    result.add_skippy_activation_import(second, 0);
+    result.add_skippy_activation_import(third, 0);
+
+    llm_graph_params params{};
+    params.build_inputs.activation_import_bindings = {
+        "stable_first", "stable_second", "stable_third",
+    };
+    result.set_outputs(params);
+
+    const auto & ports = result.get_skippy_activation_imports();
+    if (ports.size() != 3 ||
+            ports[0].binding != "stable_first" ||
+            ports[1].binding != "stable_second" ||
+            ports[2].binding != "stable_third") {
+        return 21;
+    }
+    return 0;
+}
+
 static skippy_graph_build_inputs make_stage_inputs(
         int32_t layer_start,
         int32_t layer_end,
@@ -345,6 +373,9 @@ int main(int argc, char ** argv) {
     if (const int rc = check_mtp_request_input_registration()) {
         return rc;
     }
+    if (const int rc = check_activation_port_binding()) {
+        return rc;
+    }
     llama_backend_init();
     int rc = check_sched_reserve_and_memory_update(argv[1]);
     if (rc == 0) {
-- 
