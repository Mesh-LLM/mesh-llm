     add_test(NAME skippy_decode_input_width COMMAND skippy-graph-build-inputs --input-width)
 
     add_test(
diff --git a/src/skippy/model_lifecycle.cpp b/src/skippy/model_lifecycle.cpp
index caa9fcd6d..2891f5694 100644
--- a/src/skippy/model_lifecycle.cpp
+++ b/src/skippy/model_lifecycle.cpp
@@ -4,6 +4,7 @@
 #include "skippy/glm_dsa.h"
 #include "skippy-verify-checkpoint.h"
 #include "skippy/devices.h"
+#include "skippy/speculative_internal.h"
 
 #include <mutex>
 #include "gguf.h"
@@ -141,6 +142,13 @@ bool skippy_model_output_activation_boundary(
     return true;
 }
 
+bool skippy_model_output_activation_vocabulary(
+        const struct skippy_model * model,
+        struct skippy_activation_boundary_desc * out_desc) {
+    return skippy_model_output_activation_boundary(model, out_desc) &&
+            skippy_append_optional_activation_vocabulary(model, out_desc);
+}
+
 bool skippy_model_input_activation_boundary(
         const struct skippy_model * model,
         struct skippy_activation_boundary_desc * out_desc) {
diff --git a/src/skippy/speculative_decoding.cpp b/src/skippy/speculative_decoding.cpp
index 59b311dd2..3a0a23394 100644
--- a/src/skippy/speculative_decoding.cpp
+++ b/src/skippy/speculative_decoding.cpp
@@ -550,3 +550,8 @@ enum skippy_status skippy_mtp_propose_next(
     }
     return skippy_success(out_error);
 }
+
+bool skippy_append_optional_activation_vocabulary(
+        const skippy_model * model, skippy_activation_boundary_desc * desc) {
+    return model != nullptr && desc != nullptr;
+}
diff --git a/src/skippy/speculative_internal.h b/src/skippy/speculative_internal.h
index d8276944d..fd07e6130 100644
--- a/src/skippy/speculative_internal.h
+++ b/src/skippy/speculative_internal.h
@@ -30,3 +30,8 @@ enum skippy_status skippy_mtp_propose_next(
         size_t max_draft_tokens,
         skippy_native_mtp_draft * out_mtp_draft,
         skippy_error ** out_error);
+
+struct skippy_model;
+struct skippy_activation_boundary_desc;
+bool skippy_append_optional_activation_vocabulary(
+        const skippy_model * model, skippy_activation_boundary_desc * desc);
diff --git a/src/skippy/tests/activation_vocabulary.cpp b/src/skippy/tests/activation_vocabulary.cpp
new file mode 100644
index 000000000..ab3ee4d3a
--- /dev/null
+++ b/src/skippy/tests/activation_vocabulary.cpp
@@ -0,0 +1,25 @@
+#include "skippy.h"
+#include "skippy/runtime_types.h"
+#include "llama-model.h"
+#include <cstdio>
+#include <cstring>
+
+int main() {
+    std::unique_ptr<llama_model> owner(llama_model_create(LLM_ARCH_LLAMA, llama_model_default_params()));
+    if (!owner) return 8;
+    auto & native = *owner;
+    native.arch = LLM_ARCH_LLAMA;
+    native.hparams.n_embd = 8;
+    skippy_model stage;
+    stage.model = &native;
+    stage.has_output_activation_boundary = true;
+    stage.output_activation_boundary.part_count = 1;
+    stage.output_activation_boundary.version = SKIPPY_ACTIVATION_FRAME_VERSION;
+    skippy_activation_boundary_desc vocabulary = {};
+    if (!skippy_model_output_activation_vocabulary(&stage, &vocabulary) || vocabulary.part_count != 1) return 1;
+    if (std::memcmp(&vocabulary, &stage.output_activation_boundary, sizeof(vocabulary)) != 0) return 2;
+    if (skippy_model_output_activation_vocabulary(nullptr, &vocabulary) ||
+            skippy_model_output_activation_vocabulary(&stage, nullptr)) return 3;
+    std::puts("PASS startup activation vocabulary");
+    return 0;
+}
