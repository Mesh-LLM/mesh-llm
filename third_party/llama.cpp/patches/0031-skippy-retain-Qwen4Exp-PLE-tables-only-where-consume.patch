From 661f19c38091ad31903dee257ab5685269bc0335 Mon Sep 17 00:00:00 2001
From: Jimmy
 <1fe240cd1a8cf775f6f3060f115e5a303181f3abf28ad4cb0c2515f4a02b36a8@meshllm.communities.buzz.xyz>
Date: Sat, 29 Aug 2026 02:10:58 +1000
Subject: [PATCH] skippy: retain Qwen4Exp PLE tables only where consumed

Scope the shared per-layer token embedding table to artifacts and runtime slices whose selected range actually contains a PLE layer. Non-PLE stages no longer duplicate or require the very large lazy table.

Co-authored-by: Michael Neale <14976+michaelneale@users.noreply.github.com>

Signed-off-by: Michael Neale <14976+michaelneale@users.noreply.github.com>
---
 src/llama-model-loader.cpp   | 15 ++++++++++-----
 src/models/qwen4exp.cpp      | 15 +++++++++++++--
 src/skippy/model_package.cpp | 37 +++++++++++++++++++++++++++++++-----
 3 files changed, 55 insertions(+), 12 deletions(-)

diff --git a/src/llama-model-loader.cpp b/src/llama-model-loader.cpp
index 742d9f3a3..58afd21f0 100644
--- a/src/llama-model-loader.cpp
+++ b/src/llama-model-loader.cpp
@@ -1224,11 +1224,16 @@ struct ggml_tensor * llama_model_loader::create_tensor(
                    (tn.tensor == LLM_TENSOR_ALTUP_UNEMBD_PROJ && g_skippy_filter.include_output);
         }
         if (!keep && llm_kv.arch == LLM_ARCH_QWEN4EXP && hparams.ple_n_heads > 0) {
-            // QWEN4EXP's PLE n-gram table is classified as an input tensor, but it is
-            // read by every retained PLE layer, not only by a stage that owns the
-            // embeddings. load_arch_tensors also require_weight()s it unconditionally
-            // whenever ple_n_heads > 0, so a stage that drops it cannot load at all.
-            keep = tn.tensor == LLM_TENSOR_PER_LAYER_TOKEN_EMBD;
+            bool stage_has_ple = false;
+            for (int il = g_skippy_filter.layer_start; il < g_skippy_filter.layer_end; ++il) {
+                if (il >= 0 && hparams.is_ple(static_cast<uint32_t>(il))) {
+                    stage_has_ple = true;
+                    break;
+                }
+            }
+            // QWEN4EXP's shared PLE table is classified as an input tensor but
+            // is consumed only by stages whose retained range includes a PLE layer.
+            keep = stage_has_ple && tn.tensor == LLM_TENSOR_PER_LAYER_TOKEN_EMBD;
         }
         if (!keep &&
             llm_kv.arch == LLM_ARCH_NEMOTRON_H_MOE &&
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index 4ff718c40..19f6ef55c 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -124,8 +124,19 @@ void llama_model_qwen4exp::load_arch_tensors(llama_model_loader & ml) {
         output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), { n_embd, n_vocab }, TENSOR_DUPLICATED);
     }
 
-    // flat [ple_head_dim, n_rows] gather target; n_rows is padded, so read it back
-    if (hparams.ple_n_heads > 0) {
+    // Flat [ple_head_dim, n_rows] gather target. Staged artifacts retain this
+    // shared table only when their selected range includes a PLE layer.
+    const skippy_graph_filter & stage_filter = skippy_graph_get_filter();
+    bool retained_ple_layer = !stage_filter.enabled;
+    if (stage_filter.enabled) {
+        for (int il = stage_filter.layer_start; il < stage_filter.layer_end; ++il) {
+            if (il >= 0 && hparams.is_ple(static_cast<uint32_t>(il))) {
+                retained_ple_layer = true;
+                break;
+            }
+        }
+    }
+    if (hparams.ple_n_heads > 0 && retained_ple_layer) {
         const std::string ple_name = tn(LLM_TENSOR_PER_LAYER_TOKEN_EMBD, "weight").str();
         const auto & ple_w = ml.require_weight(ple_name.c_str());
         const int64_t ple_rows = ple_w.tensor->ne[1];
diff --git a/src/skippy/model_package.cpp b/src/skippy/model_package.cpp
index 7dd40cba6..d10199f51 100644
--- a/src/skippy/model_package.cpp
+++ b/src/skippy/model_package.cpp
@@ -250,10 +250,37 @@ static bool skippy_parse_tensor_metadata(skippy_model_info * info) {
     return ok && info->tensors.size() == static_cast<size_t>(n_tensors);
 }
 
-static bool skippy_tensor_selected(const skippy_tensor_meta & tensor, const skippy_slice_range & range) {
-    if (tensor.name == "per_layer_token_embd.weight") {
-        // Qwen4Exp PLE layers consume this table independently of token embeddings,
-        // so every staged artifact must retain it.
+static bool skippy_range_contains_qwen4exp_ple_layer(
+        const skippy_model_info & info,
+        const skippy_slice_range & range) {
+    const int64_t arch_key = gguf_find_key(info.ctx, "general.architecture");
+    if (arch_key < 0 || gguf_get_kv_type(info.ctx, arch_key) != GGUF_TYPE_STRING ||
+        std::strcmp(gguf_get_val_str(info.ctx, arch_key), "qwen4exp") != 0) {
+        return false;
+    }
+
+    const int64_t layers_key = gguf_find_key(info.ctx, "qwen4exp.ple.layers");
+    if (layers_key < 0 || gguf_get_kv_type(info.ctx, layers_key) != GGUF_TYPE_ARRAY ||
+        gguf_get_arr_type(info.ctx, layers_key) != GGUF_TYPE_UINT32) {
+        return false;
+    }
+
+    const uint32_t * layers = static_cast<const uint32_t *>(gguf_get_arr_data(info.ctx, layers_key));
+    const size_t layer_count = gguf_get_arr_n(info.ctx, layers_key);
+    return std::any_of(layers, layers + layer_count, [&](uint32_t layer) {
+        return layer >= static_cast<uint32_t>(range.layer_start) &&
+               layer <  static_cast<uint32_t>(range.layer_end);
+    });
+}
+
+static bool skippy_tensor_selected(
+        const skippy_model_info & info,
+        const skippy_tensor_meta & tensor,
+        const skippy_slice_range & range) {
+    if (tensor.name == "per_layer_token_embd.weight" &&
+        skippy_range_contains_qwen4exp_ple_layer(info, range)) {
+        // Qwen4Exp's PLE table is shared rather than block-named, so retain it
+        // only in stages that execute a PLE layer.
         return true;
     }
     if (tensor.layer_index >= 0) {
@@ -583,7 +610,7 @@ enum skippy_status skippy_write_slice_gguf(
 
     std::vector<skippy_source_tensor> selected;
     for (const skippy_tensor_meta & tensor : info->tensors) {
-        if (skippy_tensor_selected(tensor, *range)) {
+        if (skippy_tensor_selected(*info, tensor, *range)) {
             selected.push_back({ info, &tensor });
         }
     }
-- 
