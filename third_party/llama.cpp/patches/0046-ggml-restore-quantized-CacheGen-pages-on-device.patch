             if (job->dst == NULL || job->dst->buffer == NULL || job->tiles == NULL || job->tile_count == 0 ||
                     job->tile_count > UINT32_MAX || job->cells == NULL || job->cell_count == 0 || job->channels == 0 ||
-                    (job->dst->type != GGML_TYPE_F16 && job->dst->type != GGML_TYPE_F32) ||
+                    (job->dst->type != GGML_TYPE_F16 && job->dst->type != GGML_TYPE_F32 &&
