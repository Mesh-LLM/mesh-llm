 ggml/src/ggml-cuda/ggml-cuda.cu            |   9 +-
 ggml/src/ggml-metal/ggml-metal-device.m    |  14 ++-
 ggml/src/ggml-metal/kernels/cachegen.metal |  44 ++++++++-
 include/skippy/state.h                     |   2 +
