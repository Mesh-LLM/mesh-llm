+static int check_retained_execution(const char * model_path, bool sampled) {
+    std::unique_ptr<llama_model, decltype(&llama_model_free)> model(load_model(model_path), llama_model_free);
+    if (!model) return 80;
+    skippy_graph_build_inputs inputs;
+    if (!make_stage_inputs(model.get(), 4, 0, llama_model_n_layer(model.get()), inputs)) return 81;
