+
+// Direct host allocations; excludes backend-private buffer/driver bookkeeping.
+size_t ggml_gallocr_get_metadata_size(ggml_gallocr_t galloc) {
+    size_t size = sizeof(*galloc) + galloc->node_alloc_bytes + galloc->leaf_alloc_bytes;
+    size += galloc->n_buffers * (sizeof(*galloc->bufts) + sizeof(*galloc->buffers) + sizeof(*galloc->buf_tallocs));
+    size += galloc->hash_set.size * (sizeof(*galloc->hash_set.keys) + sizeof(*galloc->hash_values));
+    size += ggml_bitset_size(galloc->hash_set.size) * sizeof(ggml_bitset_t);
+    for (int i = 0; i < galloc->n_buffers; ++i) {
+        bool shared = false;
+        for (int j = 0; j < i; ++j) {
+            if (galloc->buf_tallocs[j] == galloc->buf_tallocs[i]) shared = true;
+        }
+        if (!shared) {
+            size += sizeof(*galloc->buf_tallocs[i]);
+            size += galloc->buf_tallocs[i]->n_chunks * sizeof(struct tallocr_chunk);
+            if (galloc->buffers[i]) size += sizeof(struct vbuffer);
+        }
+    }
+    return size;
+}
