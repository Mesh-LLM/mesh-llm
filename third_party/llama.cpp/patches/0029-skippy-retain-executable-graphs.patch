+
+bool llama_sampler_has_graph_owned_backend(const llama_sampler * sampler) {
+    if (sampler == nullptr) {
+        return false;
+    }
+    if (sampler->iface == &llama_sampler_greedy_i) {
+        return true;
+    }
+    if (sampler->iface != &llama_sampler_chain_i) {
+        return false;
+    }
+    const auto * chain = static_cast<const llama_sampler_chain *>(sampler->ctx);
+    for (const auto & entry : chain->samplers) {
+        if (entry.is_backend && !llama_sampler_has_graph_owned_backend(entry.ptr)) {
+            return false;
+        }
+    }
+    return true;
+}
