+    size += sched->hash_set.size * sched->n_backends * sched->n_copies * sizeof(*sched->hv_tensor_copies);
+    size += 4 * sched->backend_ids_capacity * sizeof(int);
+    size += sched->splits_capacity * sizeof(*sched->splits);
