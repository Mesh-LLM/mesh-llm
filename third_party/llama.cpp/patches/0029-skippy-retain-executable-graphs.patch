index 000000000..c309c07a8
--- /dev/null
+++ b/src/skippy/execution_graph_cache.cpp
@@ -0,0 +1,100 @@
+#include "llama-context.h"
+#include "llama-sampler.h"
+#include "llama-model.h"
+
+#include <utility>
+
+bool llama_context::stage_graph_retention_allowed(const llm_graph_params & params) const {
+    if (!params.build_inputs.selection.enabled || model.hparams.no_alloc || opt_ctx != nullptr ||
+            stage_graph_retention_disabled) {
+        return false;
+    }
+    for (const auto & entry : params.samplers) {
+        if (!llama_sampler_has_graph_owned_backend(entry.second)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool llama_context::stage_graph_fits_reservation(ggml_backend_sched_t scheduler) const {
+    for (size_t i = 0; i < backend_ptrs.size(); ++i) {
+        if (ggml_backend_sched_get_buffer_size(scheduler, backend_ptrs[i]) > backend_buf_exp_size[i]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void llama_context::clear_retained_stage_graph() {
+    // Retained schedulers are idle; a graph can only be parked after synchronization.
+    sched_retained.reset();
+    for (auto & res : gf_res_retained) res.reset();
+    gf_res_retained_active = nullptr;
+    retained_allocation_valid = false;
+}
+
+bool llama_context::restore_stage_graph(const llm_graph_params & params) {
+    if (!stage_graph_retention_allowed(params) || !retained_allocation_valid ||
+            !gf_res_retained_active ||
+            gf_res_retained[params.n_outputs > 0].get() != gf_res_retained_active ||
+            !gf_res_retained_active->can_reuse(params)) {
+        return false;
+    }
+    // Includes asynchronous output copies from the previous microbatch.
+    ggml_backend_sched_synchronize(sched.get());
+    std::swap(sched, sched_retained);
+    std::swap(gf_res_prev, gf_res_retained);
+    std::swap(gf_res_prev_active, gf_res_retained_active);
+    std::swap(graph_allocation_valid, retained_allocation_valid);
+    return true;
+}
+
+void llama_context::retain_stage_graph(const llm_graph_params & params) {
+    if (!stage_graph_retention_allowed(params) || !graph_allocation_valid || !gf_res_prev_active ||
+            !stage_graph_fits_reservation(sched.get())) {
+        clear_retained_stage_graph();
+        return;
+    }
+    ggml_backend_sched_synchronize(sched.get());
+    if (!sched_retained) {
+        sched_retained.reset(ggml_backend_sched_new(backend_ptrs.data(), backend_buft.data(),
+                backend_ptrs.size(), gf_res_reserve->get_max_nodes(),
+                cparams.pipeline_parallel, cparams.op_offload));
+    }
+    std::swap(sched, sched_retained);
+    std::swap(gf_res_prev, gf_res_retained);
+    std::swap(gf_res_prev_active, gf_res_retained_active);
+    retained_allocation_valid = true;
+    graph_allocation_valid = false;
+}
+
+
+bool llama_context::allocate_stage_graph(const llm_graph_params & params, ggml_cgraph * & graph) {
+    if (ggml_backend_sched_alloc_graph(sched.get(), graph)) {
+        graph_allocation_valid = true;
+        return true;
+    }
+    if (!sched_retained) {
+        return false;
+    }
+    // Cache pressure must not prevent a run that fits with one executable.
+    clear_retained_stage_graph();
+    stage_graph_retention_disabled = true;
+    params.res->reset();
+    // A failed reservation can leave allocator assignments without buffers.
+    // Recreate the scheduler as well as the graph before the one-slot retry.
+    sched.reset();
+    sched.reset(ggml_backend_sched_new(backend_ptrs.data(), backend_buft.data(),
+            backend_ptrs.size(), gf_res_reserve->get_max_nodes(),
+            cparams.pipeline_parallel, cparams.op_offload));
+    ggml_backend_sched_set_eval_callback(sched.get(), cparams.cb_eval, cparams.cb_eval_user_data);
+    auto retry_params = params;
+    retry_params.sched = sched.get();
+    graph = model.build_graph(retry_params);
+    if (graph == nullptr || !ggml_backend_sched_alloc_graph(sched.get(), graph)) {
+        return false;
+    }
+    graph_allocation_valid = true;
+    return true;
+}
