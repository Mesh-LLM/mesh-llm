From c28b48b4fae9418cd9f27845aff78dcbc6160788 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Mon, 20 Jul 2026 05:19:37 +1000
Subject: [PATCH 34/47] ggml: use GLM max-active policy for Q3 down kernels

---
 ggml/src/ggml-metal/ggml-metal-ops.cpp | 30 ++++++++++++++++++++++++++
 tests/test-backend-ops.cpp             |  2 ++
 2 files changed, 32 insertions(+)

diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 4fd2fab6c73e84aa5bbd923c83a8a6f84a7e836a..d85230dcdf415549399e5938681e5d184d4b6e4a 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -525,6 +525,11 @@ static bool ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_active2_enabled() {
     return value && atoi(value) != 0;
 }
 
+static int ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_active_count() {
+    const int active_experts = ggml_metal_glm_dsa_moe_max_active_experts();
+    return active_experts == 2 || active_experts == 4 || active_experts == 6 ? active_experts : 0;
+}
+
 static bool ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_r6_nb8_w0_enabled() {
     const char * value = getenv("GGML_METAL_ENABLE_Q3_DOWN_SLOT_PARALLEL_REDUCE_R6_NB8_W0");
     return value && atoi(value) != 0;
@@ -4800,16 +4805,23 @@ static bool ggml_metal_match_mul_mv_id_weighted_reduce(
     const bool q3_default_w1_shape =
         down_type == GGML_TYPE_Q3_K &&
         ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_r8_nb8_w1_default_enabled() &&
         down->src[0]->ne[0] == 2048 &&
         down->src[2]->ne[1] == 1 &&
         ggml_get_op_params_i32(weighted_sum, 0) != 0;
+    const bool q3_active_count_shape =
+        down_type == GGML_TYPE_Q3_K &&
+        ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_active_count() != 0 &&
+        down->src[0]->ne[0] == 2048 &&
+        down->src[2]->ne[1] == 1 &&
+        ggml_get_op_params_i32(weighted_sum, 0) == 0;
     if (down_type == GGML_TYPE_Q3_K &&
             !ggml_metal_glm_dsa_q3_down_weighted_reduce_tensor_selected(weighted_sum)) {
         return reject("q3_tensor");
     }
     if (down_type == GGML_TYPE_Q3_K &&
             !q3_default_w0_shape &&
             !q3_default_w1_shape &&
+            !q3_active_count_shape &&
             !ggml_metal_glm_dsa_q3_down_weighted_reduce_enabled() &&
             !ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_enabled() &&
             !ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_r8_enabled() &&
@@ -5095,6 +5107,14 @@ static int ggml_metal_op_mul_mv_id_weighted_reduce(
         ggml_metal_glm_dsa_q3_down_f16_act_enabled() &&
         ne00 == 2048 &&
         extra.already_weighted == 0;
+    const int q3_active_count = ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_active_count();
+    const bool q3_active_count_shape =
+        down->src[0]->type == GGML_TYPE_Q3_K &&
+        q3_active_count != 0 &&
+        ne00 == 2048 &&
+        ne20 == 8 &&
+        ne21 == 1 &&
+        extra.already_weighted == 0;
     const bool q3_slot_parallel = ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_enabled();
     const bool q3_slot_parallel_r8 = ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_r8_enabled();
     const bool q3_slot_parallel_r8_nb8 = ggml_metal_glm_dsa_q3_down_slot_parallel_reduce_r8_nb8_enabled();
@@ -5221,8 +5241,9 @@ static int ggml_metal_op_mul_mv_id_weighted_reduce(
              q3_slot_parallel_r8_nb8 ||
              q3_slot_parallel_r8_nb8_w0 ||
              q3_slot_parallel_active6 ||
              q3_slot_parallel_active4 ||
              q3_slot_parallel_active2 ||
+             q3_active_count_shape ||
              q3_slot_parallel_r6_nb8_w0 ||
              q3_slot_parallel_r10_nb8_w0 ||
              q3_slot_parallel_glm52_w0 ||
@@ -5261,6 +5282,15 @@ static int ggml_metal_op_mul_mv_id_weighted_reduce(
         } else if (q3_slot_parallel_active2 && ne00 == 2048 && extra.already_weighted == 0) {
             pipeline_slot_parallel = ggml_metal_library_get_pipeline_mul_mv_id_q3_weighted_reduce_slots_sg_r8_nb8_w0_active2(lib, weighted_sum);
             q3_slot_parallel_op = "mul_mv_id_q3_down_slot_parallel_reduce_active2";
+        } else if (q3_active_count_shape && q3_active_count == 6) {
+            pipeline_slot_parallel = ggml_metal_library_get_pipeline_mul_mv_id_q3_weighted_reduce_slots_sg_r8_nb8_w0_active6(lib, weighted_sum);
+            q3_slot_parallel_op = "mul_mv_id_q3_down_slot_parallel_reduce_active6";
+        } else if (q3_active_count_shape && q3_active_count == 4) {
+            pipeline_slot_parallel = ggml_metal_library_get_pipeline_mul_mv_id_q3_weighted_reduce_slots_sg_r8_nb8_w0_active4(lib, weighted_sum);
+            q3_slot_parallel_op = "mul_mv_id_q3_down_slot_parallel_reduce_active4";
+        } else if (q3_active_count_shape && q3_active_count == 2) {
+            pipeline_slot_parallel = ggml_metal_library_get_pipeline_mul_mv_id_q3_weighted_reduce_slots_sg_r8_nb8_w0_active2(lib, weighted_sum);
+            q3_slot_parallel_op = "mul_mv_id_q3_down_slot_parallel_reduce_active2";
         } else if (q3_f16_w0_shape) {
             pipeline_slot_parallel = ggml_metal_library_get_pipeline_mul_mv_id_q3_weighted_reduce_slots_sg_r8_nb8_w0_f16(lib, weighted_sum);
             q3_slot_parallel_op = "mul_mv_id_q3_down_slot_parallel_reduce_r8_nb8_w0_f16";
diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index b16fd5a82a7336468f476a9573f2b79660f3c026..aa28fb6a395aaa886fec4c398e80ec7787700a9d 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -7333,6 +7333,7 @@ struct test_topk_moe_glm_component : public test_case {
             getenv("SKIPPY_GLM_DSA_EXPERIMENTAL_Q3_DOWN_SLOT_PARALLEL_REDUCE_R8") != nullptr ||
             getenv("GGML_METAL_ENABLE_Q3_DOWN_SLOT_PARALLEL_REDUCE_R8_NB8") != nullptr ||
             getenv("GGML_METAL_ENABLE_Q3_DOWN_SLOT_PARALLEL_REDUCE_R8_NB8_W0") != nullptr ||
+            getenv("GGML_METAL_EXPERIMENTAL_GLM_MOE_MAX_ACTIVE_EXPERTS") != nullptr ||
             getenv("GGML_METAL_ENABLE_Q3_DOWN_SLOT_PARALLEL_REDUCE_R12_NB8_W0") != nullptr ||
             getenv("SKIPPY_GLM_DSA_EXPERIMENTAL_Q3_DOWN_SLOT_PARALLEL_REDUCE_R16") != nullptr ||
             getenv("SKIPPY_GLM_DSA_EXPERIMENTAL_Q3_DOWN_SLOT_SPLIT2_REDUCE") != nullptr ||
@@ -9060,6 +9061,7 @@ struct test_glm_moe_static_motif : public test_case {
             getenv("SKIPPY_GLM_DSA_EXPERIMENTAL_Q3_DOWN_SLOT_PARALLEL_REDUCE_R8") != nullptr ||
             getenv("GGML_METAL_ENABLE_Q3_DOWN_SLOT_PARALLEL_REDUCE_R8_NB8") != nullptr ||
             getenv("GGML_METAL_ENABLE_Q3_DOWN_SLOT_PARALLEL_REDUCE_R8_NB8_W0") != nullptr ||
+            getenv("GGML_METAL_EXPERIMENTAL_GLM_MOE_MAX_ACTIVE_EXPERTS") != nullptr ||
             getenv("GGML_METAL_ENABLE_Q3_DOWN_SLOT_PARALLEL_REDUCE_R12_NB8_W0") != nullptr ||
             getenv("SKIPPY_GLM_DSA_EXPERIMENTAL_Q3_DOWN_SLOT_PARALLEL_REDUCE_R16") != nullptr ||
             getenv("SKIPPY_GLM_DSA_EXPERIMENTAL_Q3_DOWN_SLOT_SPLIT2_REDUCE") != nullptr ||
-- 
