From 3fb3badf769647aaaed28b6e6a8f3bc1ffd5cecb Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Wed, 15 Jul 2026 23:20:44 +1000
Subject: [PATCH] Preserve Cohere generation prefix for tool history

---
 common/chat.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/common/chat.cpp b/common/chat.cpp
index bb35495e..f60daa66 100644
--- a/common/chat.cpp
+++ b/common/chat.cpp
@@ -2189,6 +2189,9 @@ static common_chat_params common_chat_params_init_cohere2moe(const common_chat_t
 
     data.prompt             = common_chat_template_direct_apply_impl(tmpl, inputs);
     data.generation_prompt  = common_chat_template_generation_prompt_impl(tmpl, inputs);
+    if (data.generation_prompt.empty() && string_ends_with(data.prompt, GEN_PREFIX)) {
+        data.generation_prompt = GEN_PREFIX;
+    }
     data.format             = COMMON_CHAT_FORMAT_PEG_NATIVE;
     data.supports_thinking  = true;
     data.thinking_start_tag = THINK_START;
