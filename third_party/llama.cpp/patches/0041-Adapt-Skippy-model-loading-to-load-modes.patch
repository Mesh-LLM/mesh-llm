From 43fe1861b1b58d04444da0886fb5fddd1a14f05c Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sun, 26 Jul 2026 19:30:12 +1000
Subject: [PATCH 41/45] Adapt Skippy model loading to load modes

---
 src/skippy.cpp | 7 +++----
 1 file changed, 3 insertions(+), 4 deletions(-)

diff --git a/src/skippy.cpp b/src/skippy.cpp
index a8cc03cb..9bd81828 100644
--- a/src/skippy.cpp
+++ b/src/skippy.cpp
@@ -950,11 +950,10 @@ static void skippy_apply_model_load_memory_config(
     if (config == nullptr) {
         return;
     }
-    if (config->has_mmap_override) {
-        params.use_mmap = config->use_mmap;
-    }
     if (config->use_mlock) {
-        params.use_mlock = true;
+        params.load_mode = LLAMA_LOAD_MODE_MLOCK;
+    } else if (config->has_mmap_override) {
+        params.load_mode = config->use_mmap ? LLAMA_LOAD_MODE_MMAP : LLAMA_LOAD_MODE_NONE;
     }
 }
 
