From 63c0e5b5ac8555a37302b2b2da812f9f0c62972b Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Mon, 7 Sep 2026 06:23:51 +1000
Subject: [PATCH 11/23] build(skippy): wire runtime and native tests

---
 CMakeLists.txt            | 17 +++++++++++++++++
 common/CMakeLists.txt     |  2 ++
 src/CMakeLists.txt        | 12 +++++++++++-
 tools/mtmd/CMakeLists.txt |  1 +
 4 files changed, 31 insertions(+), 1 deletion(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 86b09dfd4..2ce07587c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2,6 +2,18 @@ cmake_minimum_required(VERSION 3.14...3.28) # for add_link_options and implicit
 project("llama.cpp" C CXX)
 include(CheckIncludeFileCXX)
 
+# Upstream added target_precompile_headers for several targets. The Skippy
+# stage rewriter (Clang LibTooling) consumes the compilation database with its
+# own clang, which cannot read a PCH produced by the configured compiler, and
+# unity-built model sources inherit those -include-pch flags when the database
+# is matched. Keep every target PCH-free so the database stays rewriter-ready.
+set(CMAKE_DISABLE_PRECOMPILE_HEADERS ON)
+
+option(LLAMA_STAGE_BUILD_TESTS "Build private Skippy native application probes" OFF)
+if (LLAMA_STAGE_BUILD_TESTS)
+    enable_testing()
+endif()
+
 ### llama.cpp version
 set(LLAMA_VERSION_MAJOR 0)
 set(LLAMA_VERSION_MINOR 4)
@@ -271,6 +283,7 @@ set(LLAMA_BIN_INSTALL_DIR     ${CMAKE_INSTALL_BINDIR}     CACHE PATH "Location o
 
 set(LLAMA_PUBLIC_HEADERS
     ${CMAKE_CURRENT_SOURCE_DIR}/include/llama.h
+    ${CMAKE_CURRENT_SOURCE_DIR}/include/skippy.h
     ${CMAKE_CURRENT_SOURCE_DIR}/include/llama-cpp.h)
 
 set_target_properties(llama
@@ -278,6 +291,10 @@ set_target_properties(llama
         PUBLIC_HEADER "${LLAMA_PUBLIC_HEADERS}")
 
 install(TARGETS llama LIBRARY PUBLIC_HEADER)
+install(
+    DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}/include/skippy
+    DESTINATION ${LLAMA_INCLUDE_INSTALL_DIR}
+    FILES_MATCHING PATTERN "*.h")
 
 if (LLAMA_BUILD_COMMON)
     install(TARGETS llama-common LIBRARY)
diff --git a/common/CMakeLists.txt b/common/CMakeLists.txt
index 9a43911d3..0c66e485f 100644
--- a/common/CMakeLists.txt
+++ b/common/CMakeLists.txt
@@ -103,6 +103,7 @@ add_library(${TARGET}
     reasoning-budget.h
     sampling.cpp
     sampling.h
+    stage-chat.cpp
     speculative.cpp
     speculative.h
     subproc.cpp
@@ -143,6 +144,7 @@ endif()
 
 if (BUILD_SHARED_LIBS)
     set_target_properties(${TARGET} PROPERTIES POSITION_INDEPENDENT_CODE ON)
+    target_compile_definitions(${TARGET} PRIVATE SKIPPY_COMMON_BUILD)
 
     # TODO: make fine-grained exports in the future
     set_target_properties(${TARGET} PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index f11810d5c..40912866f 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -88,12 +88,22 @@ set_target_properties(llama PROPERTIES
 set_source_files_properties(${LLAMA_CORE_SOURCES} ../include/llama.h unicode.h
     PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
 
+# Keep model sources out of the unity build as well. The Skippy stage
+# rewriter (Clang LibTooling) needs a per-source compilation database entry
+# for every model builder, and unity composites collapse those entries.
+set_source_files_properties(${LLAMA_MODELS_SOURCES}
+    PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+
 configure_file(llama-version.h.in ${CMAKE_CURRENT_BINARY_DIR}/llama-version.h @ONLY)
 
 target_include_directories(llama PRIVATE . ${CMAKE_CURRENT_BINARY_DIR})
 target_include_directories(llama PUBLIC ../include)
 target_compile_features   (llama PRIVATE cxx_std_17) # don't bump
-target_precompile_headers (llama PRIVATE models/models.h)
+# Upstream added a models.h PCH for the llama target. The Skippy stage
+# rewriter (Clang LibTooling) consumes this target's compilation database
+# entries with its own clang, which cannot read a PCH produced by the
+# configured compiler, so the llama target must stay PCH-free.
+# target_precompile_headers (llama PRIVATE models/models.h)
 
 target_link_libraries(llama PUBLIC ggml)
 
diff --git a/tools/mtmd/CMakeLists.txt b/tools/mtmd/CMakeLists.txt
index 176eb1505..6bbc4c7f2 100644
--- a/tools/mtmd/CMakeLists.txt
+++ b/tools/mtmd/CMakeLists.txt
@@ -43,6 +43,7 @@ add_library(mtmd
             models/granite4-vision.cpp
             models/hunyuanvl.cpp
             models/internvl.cpp
+            models/inkling.cpp
             models/kimivl.cpp
             models/kimik25.cpp
             models/nemotron-v2-vl.cpp
