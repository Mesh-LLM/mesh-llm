+            return SKIPPY_STATUS_INVALID_ARGUMENT;
         }
         status = skippy_prepare_output_activation_frame(
                 request.session, request.token_count,
@@ -263,19 +260,41 @@ enum skippy_status skippy_iteration_batch_sampled(
         if (status != SKIPPY_STATUS_OK) return status;
         if (output_descs != nullptr && request_exports &&
                 output_descs[index].part_count != request.session->stage_model->output_activation_boundary.part_count) {
-            skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED,
-                    "iteration batching defers optional activation ports to serial execution");
-            return SKIPPY_STATUS_UNSUPPORTED;
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                    "iteration batching accepts planned frontier parts only");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
         }
         offsets[index + 1] = offsets[index] + request.token_count;
         if (request.sample_last && request_logits) ++sampled_count;
     }
-    if (request_exports &&
-            (!uniform_token_counts || !consecutive_sequence_ids ||
-             offsets.back() > static_cast<size_t>(first->ctx->n_ubatch()))) {
-        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED,
-                "activation export batch would span more than one native microbatch");
-        return SKIPPY_STATUS_UNSUPPORTED;
+    // Batched exports are sliced by request offset, which is the microbatch row
+    // order only when llama decodes the batch with split_simple, so a stage that
+    // exports activations needs a unified KV cache. Multi-lane exporting stages
+    // cannot turn that off (model_loading.cpp rejects the combination), and a
+    // terminal stage never reads exports.
+    if (request_exports && request_count > 1 && !first->ctx->kv_unified()) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                "batched activation exports require a unified KV cache");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    // Recurrent and hybrid memory splits an all-output batch by sequence
+    // (split_seq), so the last microbatch only carries one request's rows and
+    // its exports cannot be sliced by request offset. The runtime routes those
+    // stages one request at a time; reaching this means that routing is wrong.
+    if (request_exports && request_count > 1 &&
+            (llm_arch_is_recurrent(first->stage_model->model->arch) ||
+             llm_arch_is_hybrid(first->stage_model->model->arch))) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                "recurrent and hybrid stages cannot batch activation exports");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    // Exports are read from the last microbatch's graph, so an exporting stage
+    // must see the whole batch in one microbatch. The scheduler caps batched
+    // tokens at n_ubatch; exceeding it here is a scheduler bug.
+    if (request_exports && offsets.back() > static_cast<size_t>(first->ctx->n_ubatch())) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                "iteration batch exceeds the native microbatch on an exporting stage");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
     if (sampled_count > sampled_output_capacity ||
             (sampled_count > 0 &&
diff --git a/src/skippy/model_loading.cpp b/src/skippy/model_loading.cpp
index 15b29ab..66e4856 100644
--- a/src/skippy/model_loading.cpp
+++ b/src/skippy/model_loading.cpp
@@ -727,9 +727,9 @@ enum skippy_status skippy_finish_model_open(
     if (classifier_workload) {
         params.pooling_type = LLAMA_POOLING_TYPE_RANK;
     }
-    params.embeddings = embedding_workload ||
-            (skippy_runtime_has_stage_plan(config) &&
-             !skippy_runtime_is_terminal_stage(config));
+    const bool activation_export_stage =
+            skippy_runtime_has_stage_plan(config) && !skippy_runtime_is_terminal_stage(config);
+    params.embeddings = embedding_workload || activation_export_stage;
     if (embedding_workload) {
         // Non-causal embedding graphs must fit their logical batch in one
         // physical batch, matching llama-embedding's runtime contract.
@@ -760,6 +760,21 @@ enum skippy_status skippy_finish_model_open(
         params.n_rs_seq = std::max<uint32_t>(params.n_rs_seq, 2);
         params.kv_unified = true;
     }
+    // Batched activation exports are sliced by request offset, which is the
+    // microbatch row order only while llama splits with split_simple. A
+    // per-stream cache splits by sequence instead, so an exporting stage with
+    // more than one lane cannot run without a unified cache. Reject the
+    // configuration here, once, instead of failing every batched iteration.
+    if (activation_export_stage && stage_model->lane_count > 1 && !params.kv_unified) {
+        const char * message = "an exporting stage with multiple lanes requires a unified KV cache";
+        if (event_scope != nullptr) {
+            event_scope->emit_failure(SKIPPY_STATUS_INVALID_ARGUMENT, message);
+        }
+        llama_model_free(model);
+        delete stage_model;
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, message);
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
 
     const skippy_graph_build_inputs graph_build_inputs = skippy_graph_build_inputs_from_config(config);
     stage_model->ctx = llama_init_from_model_with_graph_inputs(model, params, graph_build_inputs);
