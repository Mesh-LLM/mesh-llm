From 1cb35bffb6a5844c432d94bcb64feaf21807d3ee Mon Sep 17 00:00:00 2001
From: Nick DiZazzo <nick.dizazzo@gmail.com>
Date: Sun, 27 Sep 2026 15:11:36 -0400
Subject: [PATCH] fix(skippy): preserve CPU sampler reuse on reset

---
 src/skippy/session.cpp              | 14 ++++++++------
 src/skippy/tests/runtime_events.cpp | 18 ++++++++++++++++++
 2 files changed, 26 insertions(+), 6 deletions(-)

diff --git a/src/skippy/session.cpp b/src/skippy/session.cpp
index 1babdd733..e5c3d5738 100644
--- a/src/skippy/session.cpp
+++ b/src/skippy/session.cpp
@@ -360,12 +360,14 @@ enum skippy_status skippy_session_reset(
         session->token_history.clear();
     }
     session->signal_history.clear();
-    // Preserve the established detach-on-reset behavior by default until the
-    // reuse path has production benchmark coverage on every backend. Operators
-    // can opt in with SKIPPY_DETACH_SAMPLER_ON_RESET=0. Single-session prefill
-    // requests no output rows; batched prefill requests at most the final row,
-    // so the opt-in path remains within the one-output-per-sequence contract.
-    const bool detach_sampler_on_reset =
+    // Preserve backend-sampler detachment by default until the reuse path has
+    // production benchmark coverage on every backend. CPU-only sampler chains
+    // remain eligible for the established reset-and-reuse path. Operators can
+    // opt into backend sampler reuse with SKIPPY_DETACH_SAMPLER_ON_RESET=0.
+    // Single-session prefill requests no output rows; batched prefill requests
+    // at most the final row, so backend reuse stays within the one-output-per-
+    // sequence contract.
+    const bool detach_sampler_on_reset = session->sampling_backend_enabled &&
             !skippy_env_disabled("SKIPPY_DETACH_SAMPLER_ON_RESET");
     if (detach_sampler_on_reset || !skippy_reset_reusable_sampling(session)) {
         skippy_clear_chat_sampling(session);
diff --git a/src/skippy/tests/runtime_events.cpp b/src/skippy/tests/runtime_events.cpp
index 40f056cdc..7a42e64af 100644
--- a/src/skippy/tests/runtime_events.cpp
+++ b/src/skippy/tests/runtime_events.cpp
@@ -464,6 +464,24 @@ int test_native_model_load_production(const char * fixture_path) {
     CHECK(skippy_session_reset(session, &error) == SKIPPY_STATUS_OK);
     CHECK(session->sampling_chain == nullptr);
     CHECK(!session->sampling_backend_retired);
+
+    // With the default policy, non-greedy CPU sampler chains still reset and
+    // reuse the same chain instead of rebuilding it for every pooled request.
+    set_detach_sampler_on_reset_environment(nullptr);
+    sampling.temperature = 0.7f;
+    CHECK(skippy_session_configure_chat_sampling(
+            session, &sampling, "{\"grammar\":\"\"}", 0, &error) == SKIPPY_STATUS_OK);
+    CHECK(!session->sampling_backend_enabled);
+    CHECK(session->sampling_chain != nullptr);
+    llama_sampler * cpu_sampling_chain = session->sampling_chain;
+    const uint64_t cpu_reuse_hits_before_reset = session->sampling_reuse_hit_count;
+    const uint64_t cpu_rebuilds_before_reset = session->sampling_rebuild_count;
+    CHECK(skippy_session_reset(session, &error) == SKIPPY_STATUS_OK);
+    CHECK(!session->sampling_backend_enabled);
+    CHECK(session->sampling_chain == cpu_sampling_chain);
+    CHECK(session->sampling_reuse_hit_count == cpu_reuse_hits_before_reset + 1);
+    CHECK(session->sampling_rebuild_count == cpu_rebuilds_before_reset);
+
     CHECK(global.kv_cleared_events.load() > 0);
     CHECK(skippy_session_free(session, &error) == SKIPPY_STATUS_OK);
     CHECK(skippy_model_free(model, &error) == SKIPPY_STATUS_OK);
