+        const auto existing = std::find_if(request_input_bindings.begin(), request_input_bindings.end(),
+                [tensor](const skippy_request_input_binding & binding) {
+                    return binding.tensor == tensor;
+                });
+        if (existing == request_input_bindings.end()) {
+            const uint32_t ordinal = request_input_ordinals[identity]++;
+            request_input_bindings.push_back(
+                    {tensor, std::string(identity) + "." + std::to_string(ordinal)});
+        }
+    };
+
+    // Some family builders create generic input bundles directly instead of
+    // going through build_inp_embd(). Register those request leaves here so
+    // every graph exposes the same semantic input contract to stage planning.
+    if (auto * embd = dynamic_cast<llm_graph_input_embd *>(input.get())) {
+        request_input(embd->tokens, "tokens");
+        request_input(embd->embd, "embeddings");
+    }
     if (auto * mtp = dynamic_cast<llm_graph_input_embd_h *>(input.get())) {
-        const auto request_input = [&](ggml_tensor * tensor, const char * identity) {
-            if (tensor == nullptr) {
-                return;
-            }
-            const auto existing = std::find_if(request_input_bindings.begin(), request_input_bindings.end(),
-                    [tensor](const skippy_request_input_binding & binding) {
-                        return binding.tensor == tensor;
-                    });
-            if (existing == request_input_bindings.end()) {
-                const uint32_t ordinal = request_input_ordinals[identity]++;
-                request_input_bindings.push_back(
-                        {tensor, std::string(identity) + "." + std::to_string(ordinal)});
-            }
-        };
         request_input(mtp->tokens, "tokens");
         request_input(mtp->embd, "embeddings");
         request_input(mtp->h, "mtp.hidden");
     }
+    if (auto * stage_tokens = dynamic_cast<llm_graph_input_stage_tokens *>(input.get())) {
+        request_input(stage_tokens->tokens, "stage.tokens");
+    }
+    if (auto * residual = dynamic_cast<llm_graph_input_kimi_k3_residual *>(input.get())) {
+        request_input(residual->values, "kimi_k3.residual");
+    }
+    if (auto * top_k = dynamic_cast<llm_graph_input_glm_dsa_top_k *>(input.get())) {
+        request_input(top_k->values, "glm_dsa.top_k");
+    }
     inputs.emplace_back(std::move(input));
     return inputs.back().get();
 }
