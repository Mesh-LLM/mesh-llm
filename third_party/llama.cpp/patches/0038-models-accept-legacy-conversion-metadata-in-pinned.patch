-    hparams_idx.n_embd_head_k_full = model.hparams.indexer_head_size;
+    // conversions without indexer metadata keep a minimal placeholder cache;
+    // MSA stays disabled in the graph when the indexer is absent
+    hparams_idx.n_embd_head_k_full = model.hparams.indexer_head_size > 0 ? model.hparams.indexer_head_size : 1;
     // the rope parameters are kept identical to the main cache
 
     LLAMA_LOG_INFO("%s: creating indexer KV cache, size = %u cells\n", __func__, kv_size);
