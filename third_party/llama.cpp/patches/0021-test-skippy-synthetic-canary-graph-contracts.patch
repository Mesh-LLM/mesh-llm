@@ -1042,6 +1051,9 @@ int main(int argc, char ** argv) {
     printf("%s: using seed %zu\n", __func__, seed);
 
     try {
+        if (contract_layers) {
+            return save_graph_contract_fixture(arch, out, contract_layers, contract_width);
+        }
         if (!mtp_model.empty()) {
             return test_deepseek4_mtp(mtp_model);
         }
