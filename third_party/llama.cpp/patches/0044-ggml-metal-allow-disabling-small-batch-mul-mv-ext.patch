From 8ec6b2047c020aa5ec39b8da0119cb181bcc4d3e Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sun, 26 Jul 2026 09:52:05 +1000
Subject: [PATCH] ggml-metal: allow disabling small-batch mul-mv-ext

---
 ggml/src/ggml-metal/ggml-metal-ops.cpp | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 646c983ad..5ead7e432 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -57,6 +57,11 @@ static int ggml_metal_lightning_indexer_parallel_threads_requested() {
     }
 }
 
+static bool ggml_metal_small_batch_mul_mv_ext_disabled() {
+    const char * value = getenv("GGML_METAL_DISABLE_SMALL_BATCH_MUL_MV_EXT");
+    return value && atoi(value) != 0;
+}
+
 static bool ggml_metal_glm_dsa_dispatch_log_enabled() {
     const char * value = getenv("GGML_METAL_MOE_DISPATCH_LOG");
     if (value && atoi(value) != 0) {
@@ -7820,7 +7825,8 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
 
     // first try to use small-batch mat-mv kernels
     // these should be efficient for BS [2, ~8]
-    if (op->src[1]->type == GGML_TYPE_F32 && (ne00%128 == 0) &&
+    if (!ggml_metal_small_batch_mul_mv_ext_disabled() &&
+        op->src[1]->type == GGML_TYPE_F32 && (ne00%128 == 0) &&
         (
          (
           (
