From 30784e36d4bf052806278d303d6ebe3167363738 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Wed, 16 Sep 2026 01:35:31 +1000
Subject: [PATCH] fix(skippy): trust activation port registration order

---
 src/llama-graph.cpp                     | 27 ++++---------------------
 src/skippy/tests/graph_build_inputs.cpp |  4 ++--
 2 files changed, 6 insertions(+), 25 deletions(-)

diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index a902cb865..dde82142e 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1626,29 +1626,10 @@ void llm_graph_result::set_outputs(const llm_graph_params & params) {
     const auto bind_ports = [](std::vector<skippy_activation_port> & ports,
                                const std::vector<std::string> & expected) {
         if (ports.empty() || ports.size() != expected.size()) return;
-        std::set<size_t> matched;
-        std::vector<size_t> unmatched_ports;
-        for (size_t port_index = 0; port_index < ports.size(); ++port_index) {
-            const char * name = ports[port_index].tensor == nullptr ? nullptr :
-                    ggml_get_name(ports[port_index].tensor);
-            const auto found = name == nullptr ? expected.end() :
-                    std::find(expected.begin(), expected.end(), name);
-            if (found == expected.end()) {
-                unmatched_ports.push_back(port_index);
-                continue;
-            }
-            const size_t binding_index = static_cast<size_t>(found - expected.begin());
-            if (!matched.insert(binding_index).second) return;
-            ports[port_index].binding = *found;
-        }
-        std::vector<size_t> unmatched_bindings;
-        for (size_t index = 0; index < expected.size(); ++index) {
-            if (matched.count(index) == 0) unmatched_bindings.push_back(index);
-        }
-        if (unmatched_ports.size() == unmatched_bindings.size()) {
-            for (size_t index = 0; index < unmatched_ports.size(); ++index) {
-                ports[unmatched_ports[index]].binding = expected[unmatched_bindings[index]];
-            }
+        // Tensor names are local graph details and can collide with a different
+        // planner binding. Port registration order is the cross-build contract.
+        for (size_t index = 0; index < ports.size(); ++index) {
+            ports[index].binding = expected[index];
         }
     };
     bind_ports(activation_imports, params.build_inputs.activation_import_bindings);
diff --git a/src/skippy/tests/graph_build_inputs.cpp b/src/skippy/tests/graph_build_inputs.cpp
index c82253a2e..8f2a28502 100644
--- a/src/skippy/tests/graph_build_inputs.cpp
+++ b/src/skippy/tests/graph_build_inputs.cpp
@@ -215,8 +215,8 @@ static int check_activation_port_binding() {
     auto * first = ggml_new_tensor_1d(result.get_ctx(), GGML_TYPE_F32, 4);
     auto * second = ggml_new_tensor_1d(result.get_ctx(), GGML_TYPE_F32, 4);
     auto * third = ggml_new_tensor_1d(result.get_ctx(), GGML_TYPE_F32, 4);
-    ggml_set_name(first, "local_first");
-    ggml_set_name(second, "stable_second");
+    ggml_set_name(first, "stable_second");
+    ggml_set_name(second, "stable_first");
     ggml_set_name(third, "local_third");
     result.add_skippy_activation_import(first, 0);
     result.add_skippy_activation_import(second, 0);
-- 
