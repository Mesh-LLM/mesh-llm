From a354f289a226242e97ac52e0aac133d654b40a71 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sun, 13 Sep 2026 14:34:46 +1000
Subject: [PATCH 035/113] fix(skippy): restore runtime safety guards

---
 src/llama-context.cpp  | 20 +++++++++++++++-----
 src/llama-kv-cache.cpp |  4 ++++
 src/models/inkling.cpp | 12 ++++++++++--
 3 files changed, 29 insertions(+), 7 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index d7c1a427b..c6fc62df3 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1772,6 +1772,10 @@ int llama_context::decode(
             for (int32_t s = 0; s < ns; ++s) {
                 const llama_seq_id seq_id = batch_inp.seq_id ? batch_inp.seq_id[i][s] : 0;
 
+                if (seq_id < 0 || (uint32_t) seq_id >= n_seq_max) {
+                    continue;
+                }
+
                 seq_output_count[seq_id]++;
                 // Only sequences that actually have a backend sampler attached
                 // are limited to one output row; a sampler on some other
@@ -3880,6 +3884,17 @@ llama_context * llama_init_from_model_with_graph_inputs(
         }
     }
 
+    if (ggml_is_quantized(params.type_v) && params.flash_attn_type != LLAMA_FLASH_ATTN_TYPE_ENABLED) {
+        if (params.flash_attn_type == LLAMA_FLASH_ATTN_TYPE_AUTO) {
+            LLAMA_LOG_INFO("%s: enabling flash_attn since it is required for quantized V cache\n", __func__);
+            params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+        }
+        if (params.flash_attn_type == LLAMA_FLASH_ATTN_TYPE_DISABLED) {
+            LLAMA_LOG_ERROR("%s: quantized V cache requires flash_attn to be enabled\n", __func__);
+            return nullptr;
+        }
+    }
+
     if (params.flash_attn_type != LLAMA_FLASH_ATTN_TYPE_DISABLED && ggml_is_quantized(params.type_k)) {
         const uint32_t blck_size = ggml_blck_size(params.type_k);
         for (uint32_t il = 0; il < model->hparams.n_layer(); ++il) {
@@ -3902,11 +3917,6 @@ llama_context * llama_init_from_model_with_graph_inputs(
         }
     }
 
-    if (ggml_is_quantized(params.type_v) && params.flash_attn_type == LLAMA_FLASH_ATTN_TYPE_DISABLED) {
-        LLAMA_LOG_ERROR("%s: V cache quantization requires flash_attn\n", __func__);
-        return nullptr;
-    }
-
     if (params.pooling_type != LLAMA_POOLING_TYPE_UNSPECIFIED &&
         params.pooling_type != model->hparams.pooling_type) {
         //user-specified pooling-type is different from the model default
diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index b4102d1a3..4621eed19 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -2871,6 +2871,10 @@ ggml_cgraph * llama_kv_cache::build_graph_shift(llm_graph_result * res, llama_co
     for (const auto & layer : layers) {
         const uint32_t il = layer.il;
 
+        if (!hparams.has_rope(il)) {
+            continue;
+        }
+
         const int64_t n_head_kv    = hparams.n_head_kv(il);
         const int64_t n_embd_k_gqa = hparams.n_embd_k_gqa(il);
 
diff --git a/src/models/inkling.cpp b/src/models/inkling.cpp
index e7a574e5f..6b956188b 100644
--- a/src/models/inkling.cpp
+++ b/src/models/inkling.cpp
@@ -345,7 +345,9 @@ llama_model_inkling::graph::graph(const llama_model & model, const llm_graph_par
                 sx->nb[1], sx->nb[2], (sx->ne[0] - d_conv)*sx->nb[0]);
         ggml_tensor * state_dst = ggml_view_3d(ctx0, conv_state, d_conv, w, n_seqs,
                 d_conv*sz, n_embd_r*sz, (kv_head*n_embd_r + off)*sz);
-        ggml_build_forward_expand(gf, ggml_cpy(ctx0, new_state, state_dst));
+        ggml_tensor * conv_write = ggml_cpy(ctx0, new_state, state_dst);
+        ggml_build_forward_expand(gf, conv_write);
+        state_write(skippy_state_kind::recurrent_conv, conv_state, conv_write, il);
 
         ggml_tensor * conv_out = ggml_ssm_conv(ctx0, sx, kernel); // {w, n_seq_tokens, n_seqs}
 
@@ -533,7 +535,13 @@ llama_model_inkling::graph::graph(const llama_model & model, const llm_graph_par
     };
 
     auto build_block = [&](ggml_tensor * cur, int il) -> ggml_tensor * {
-        conv_rs_cur = build_rs(inp_hybrid->get_recr(), mctx_recr->get_r_l(il), n_embd_r, n_seqs);
+        conv_rs_cur = build_rs(
+                inp_hybrid->get_recr(),
+                mctx_recr->get_r_l(il),
+                n_embd_r,
+                n_seqs,
+                skippy_state_kind::recurrent_conv,
+                il);
 
         // h += attn_sconv(attn(attn_norm(h)))
         ggml_tensor * attn_in  = build_norm(cur, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
