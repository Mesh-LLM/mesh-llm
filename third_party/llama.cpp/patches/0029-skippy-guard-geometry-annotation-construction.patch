+
+// An architecture builder runs through the geometry annotation sites whether or
+// not a stage program is being captured. An unsplit build is the ordinary path:
+// it must reach those sites, and it must derive nothing from them, because only
+// a capture consumes a recipe and deriving one reads the tensor and materialises
+// nine expressions at the site.
+static int check_unsplit_graph_build_derives_no_geometry(llama_model * model) {
+    if (model == nullptr) return 196;
+    skippy_graph_build_inputs inputs;
+    skippy_stage_geometry_reset_test_counters();
+    if (!make_stage_inputs(model, 2, 0, llama_model_n_layer(model), inputs)) return 197;
+    const uint64_t sites = skippy_stage_geometry_note_sites();
+    const uint64_t derived = skippy_stage_geometry_recipe_derivations();
+    if (sites == 0) {
+        std::fprintf(stderr, "unsplit graph build reached no geometry annotation site\n");
+        return 198;
+    }
+    if (derived != 0) {
+        std::fprintf(stderr, "unsplit graph build derived %llu geometry recipes at %llu sites\n",
+                static_cast<unsigned long long>(derived), static_cast<unsigned long long>(sites));
+        return 199;
+    }
     return 0;
 }
 
