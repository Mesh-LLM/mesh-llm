+// Geometry annotation sites in the architecture builders describe how a
+// tensor's shape follows the runtime shape. Each one opens a recipe with
+// skippy_stage_geometry_static() and overrides the axes it owns. Those sites run
+// for every graph build, split or not, so the recipe a site hands to
+// skippy_stage_geometry_note() is an intent record: which axes the site chose
+// and which it left to the tensor. note() completes it from the live tensor, and
+// only a capture calls note() -- outside a capture nothing is derived and
+// nothing is stored. Consumption that does not go through note() (stage
+// extraction fallbacks, the geometry proof) derives immediately with
+// skippy_stage_geometry_snapshot().
 skippy_stage_geometry_recipe skippy_stage_geometry_static(const ggml_tensor * tensor);
+skippy_stage_geometry_recipe skippy_stage_geometry_snapshot(const ggml_tensor * tensor);
 void skippy_stage_geometry_note(const ggml_tensor * tensor, const skippy_stage_geometry_recipe & recipe);
 void skippy_stage_geometry_reset();
 bool skippy_stage_geometry_lookup(const ggml_tensor * tensor, skippy_stage_geometry_recipe & recipe);
@@ -323,4 +339,10 @@ void skippy_stage_program_note_arch_builder_call();
 void skippy_stage_program_note_selector_call();
 uint64_t skippy_stage_program_arch_builder_calls();
 uint64_t skippy_stage_program_selector_calls();
+// Monotonic: counts every skippy_stage_program::build_replay_plan() derivation
+// in the process, so a caller compares before/after rather than resetting it.
+uint64_t skippy_stage_program_replay_plan_builds();
+void skippy_stage_geometry_reset_test_counters();
+uint64_t skippy_stage_geometry_note_sites();
+uint64_t skippy_stage_geometry_recipe_derivations();
 #endif
