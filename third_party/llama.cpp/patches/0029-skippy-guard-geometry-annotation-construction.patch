-skippy_stage_geometry_recipe skippy_stage_geometry_static(const ggml_tensor * tensor) {
+namespace {
+
+// An annotation site's starting point: every axis unspecified, so note() can
+// tell the axes the site chose from the axes the tensor owns.
+skippy_stage_geometry_recipe unspecified_geometry() {
     skippy_stage_geometry_recipe result;
     for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
-        result.dimensions[axis] = skippy_stage_geometry_expression::constant(tensor->ne[axis]);
-        result.byte_strides[axis] = skippy_stage_geometry_expression::constant(tensor->nb[axis]);
+        result.dimensions[axis].value_kind = skippy_stage_geometry_expression::kind::unset;
+        result.byte_strides[axis].value_kind = skippy_stage_geometry_expression::kind::unset;
     }
-    result.view_offset = skippy_stage_geometry_expression::constant(tensor->view_offs);
+    result.view_offset.value_kind = skippy_stage_geometry_expression::kind::unset;
     return result;
 }
 
+// Complete an annotation site's intent record from the live tensor. Every axis
+// the site did not override follows the tensor, which is exactly what the
+// recipe used to be seeded with at the site itself.
+skippy_stage_geometry_recipe derive_geometry(
+        const ggml_tensor * tensor, const skippy_stage_geometry_recipe & recipe) {
+    skippy_stage_geometry_recipe result = recipe;
+    for (int32_t axis = 0; axis < GGML_MAX_DIMS; ++axis) {
+        if (result.dimensions[axis].value_kind == skippy_stage_geometry_expression::kind::unset) {
+            result.dimensions[axis] = skippy_stage_geometry_expression::constant(tensor->ne[axis]);
+        }
+        if (result.byte_strides[axis].value_kind == skippy_stage_geometry_expression::kind::unset) {
+            result.byte_strides[axis] = skippy_stage_geometry_expression::constant(tensor->nb[axis]);
+        }
+    }
+    if (result.view_offset.value_kind == skippy_stage_geometry_expression::kind::unset) {
+        result.view_offset = skippy_stage_geometry_expression::constant(tensor->view_offs);
+    }
+#ifdef LLAMA_STAGE_BUILD_TESTS
+    ++test_recipe_derivations;
+#endif
+    return result;
+}
+
+}
+
+// An annotation site: record the axes this site owns and defer everything else.
+// The tensor is not read here, so a graph build that is not capturing pays for
+// the site's own assignments and nothing more.
+skippy_stage_geometry_recipe skippy_stage_geometry_static(const ggml_tensor * tensor) {
+    (void) tensor;
+#ifdef LLAMA_STAGE_BUILD_TESTS
+    ++test_note_sites;
+#endif
+    return unspecified_geometry();
+}
+
+// The tensor's own geometry, derived now, for consumption that does not go
+// through skippy_stage_geometry_note().
+skippy_stage_geometry_recipe skippy_stage_geometry_snapshot(const ggml_tensor * tensor) {
+    return derive_geometry(tensor, unspecified_geometry());
+}
+
 void skippy_stage_geometry_note(const ggml_tensor * tensor, const skippy_stage_geometry_recipe & recipe) {
-    if (recording_geometry && tensor != nullptr) recorded_geometry[tensor] = recipe;
+    if (recording_geometry && tensor != nullptr) recorded_geometry[tensor] = derive_geometry(tensor, recipe);
 }
 
 void skippy_stage_geometry_reset() {
@@ -502,5 +561,13 @@ bool skippy_stage_geometry_evaluate_for_test(
     runtime.kv_stream_count = kv_stream_count;
     return skippy_stage_program_detail::evaluate_geometry(recipe, runtime, sources, dims, strides, offset, error);
 }
+
+void skippy_stage_geometry_reset_test_counters() {
+    test_note_sites = 0;
+    test_recipe_derivations = 0;
+}
+
+uint64_t skippy_stage_geometry_note_sites() { return test_note_sites; }
+uint64_t skippy_stage_geometry_recipe_derivations() { return test_recipe_derivations; }
 #endif
 
