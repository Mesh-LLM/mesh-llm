+void llama_kv_cache::copy_compacted_cells(const std::vector<compaction_move> & moves) const {
+    for (const auto & layer : layers) {
+        for (const compaction_move & move : moves) {
+            if (move.strm >= layer.k_stream.size()) {
+                continue;
