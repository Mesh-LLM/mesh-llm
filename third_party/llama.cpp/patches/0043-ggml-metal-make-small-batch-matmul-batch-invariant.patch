     kernel_mul_mv_q6_K_f32_impl<N_R0_Q6_K, constant ggml_metal_kargs_mul_mv &>(args, src0, src1, dst, nullptr, tgpig, tiisg, sgitg);
 }
 
+// Batch-invariant small-batch kernels. Each input row uses the same arithmetic
+// and reduction tree as the canonical single-row mul_mv implementation.
+template<short r1ptg>
+kernel void kernel_mul_mv_ext_f32_f32_batch_invariant(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    (void) r1ptg;
+    kernel_mul_mv_t_t_4_impl<
+            float, float4, float, float4, 2,
+            constant ggml_metal_kargs_mul_mv_ext &>(
+                args, src0, src1, dst, shmem,
+                tgpig, tiisg, sgitg);
+}
+
+template<short r1ptg>
+kernel void kernel_mul_mv_ext_q4_K_f32_batch_invariant(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    (void) r1ptg;
+    kernel_mul_mv_q4_K_f32_impl<
+            N_R0_Q4_K, constant ggml_metal_kargs_mul_mv_ext &>(
+                args, src0, src1, dst, nullptr,
+                tgpig, tiisg, sgitg);
+}
+
+template<short r1ptg>
+kernel void kernel_mul_mv_ext_q6_K_f32_batch_invariant(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    (void) r1ptg;
+    kernel_mul_mv_q6_K_f32_impl<
+            N_R0_Q6_K, constant ggml_metal_kargs_mul_mv_ext &>(
+                args, src0, src1, dst, nullptr,
+                tgpig, tiisg, sgitg);
+}
+
+template<short r1ptg>
+kernel void kernel_mul_mv_ext_q5_0_f32_batch_invariant(
+        constant ggml_metal_kargs_mul_mv_ext & args,
+        device const char * src0,
+        device const char * src1,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig[[threadgroup_position_in_grid]],
+        ushort tiisg[[thread_index_in_simdgroup]],
+        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
+    (void) r1ptg;
+    mul_vec_q_n_f32_impl<
+            block_q5_0, N_R0_Q5_0,
+            constant ggml_metal_kargs_mul_mv_ext &>(
+                args, src0, src1, dst, shmem,
+                tgpig, tiisg, sgitg);
+}
+
+typedef decltype(kernel_mul_mv_ext_f32_f32_batch_invariant<2>) mul_mv_ext_f32_f32_batch_invariant_t;
+typedef decltype(kernel_mul_mv_ext_q4_K_f32_batch_invariant<2>) mul_mv_ext_q4_K_f32_batch_invariant_t;
+typedef decltype(kernel_mul_mv_ext_q6_K_f32_batch_invariant<2>) mul_mv_ext_q6_K_f32_batch_invariant_t;
+typedef decltype(kernel_mul_mv_ext_q5_0_f32_batch_invariant<2>) mul_mv_ext_q5_0_f32_batch_invariant_t;
+
+template [[host_name("kernel_mul_mv_ext_f32_f32_r1_2")]] kernel mul_mv_ext_f32_f32_batch_invariant_t kernel_mul_mv_ext_f32_f32_batch_invariant<2>;
+template [[host_name("kernel_mul_mv_ext_f32_f32_r1_3")]] kernel mul_mv_ext_f32_f32_batch_invariant_t kernel_mul_mv_ext_f32_f32_batch_invariant<3>;
+template [[host_name("kernel_mul_mv_ext_f32_f32_r1_4")]] kernel mul_mv_ext_f32_f32_batch_invariant_t kernel_mul_mv_ext_f32_f32_batch_invariant<4>;
+template [[host_name("kernel_mul_mv_ext_f32_f32_r1_5")]] kernel mul_mv_ext_f32_f32_batch_invariant_t kernel_mul_mv_ext_f32_f32_batch_invariant<5>;
+
+template [[host_name("kernel_mul_mv_ext_q4_K_f32_r1_2")]] kernel mul_mv_ext_q4_K_f32_batch_invariant_t kernel_mul_mv_ext_q4_K_f32_batch_invariant<2>;
+template [[host_name("kernel_mul_mv_ext_q4_K_f32_r1_3")]] kernel mul_mv_ext_q4_K_f32_batch_invariant_t kernel_mul_mv_ext_q4_K_f32_batch_invariant<3>;
+template [[host_name("kernel_mul_mv_ext_q4_K_f32_r1_4")]] kernel mul_mv_ext_q4_K_f32_batch_invariant_t kernel_mul_mv_ext_q4_K_f32_batch_invariant<4>;
+template [[host_name("kernel_mul_mv_ext_q4_K_f32_r1_5")]] kernel mul_mv_ext_q4_K_f32_batch_invariant_t kernel_mul_mv_ext_q4_K_f32_batch_invariant<5>;
+
+template [[host_name("kernel_mul_mv_ext_q6_K_f32_r1_2")]] kernel mul_mv_ext_q6_K_f32_batch_invariant_t kernel_mul_mv_ext_q6_K_f32_batch_invariant<2>;
