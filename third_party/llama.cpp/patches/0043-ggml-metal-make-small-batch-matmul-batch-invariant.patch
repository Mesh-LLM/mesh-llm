From d2784b42bb03b90b88612e7d8c56005b2da5723b Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Sun, 26 Jul 2026 11:28:36 +1000
Subject: [PATCH] ggml-metal: make small-batch matmul batch invariant

---
 ggml/src/ggml-metal/ggml-metal-device.cpp |   4 +
 ggml/src/ggml-metal/ggml-metal-ops.cpp    |  71 +++++++++++--
 ggml/src/ggml-metal/ggml-metal.metal      | 115 ++++++++++++++++++----
 3 files changed, 162 insertions(+), 28 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-device.cpp b/ggml/src/ggml-metal/ggml-metal-device.cpp
index 870d5a92e..d3554e28b 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-device.cpp
@@ -1186,6 +1186,10 @@ ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mv_ext(ggml_
         ggml_metal_cv_free(cv);
     }
 
+    if (tsrc0 == GGML_TYPE_F32 && tsrc1 == GGML_TYPE_F32) {
+        res.smem = 32*2*sizeof(float);
+    }
+
     return res;
 }
 
diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 646c983ad..7f4b1cc51 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -7704,6 +7704,34 @@ int ggml_metal_op_pool_2d(ggml_metal_op_t ctx, int idx) {
     return 1;
 }
 
+struct ggml_metal_mul_mv_ext_row_params {
+    int nsg;
+    int16_t r0ptg;
+};
+
+static ggml_metal_mul_mv_ext_row_params ggml_metal_mul_mv_ext_row_params_for(
+        enum ggml_type type,
+        int64_t ne00,
+        int16_t nypsg,
+        bool batch_invariant) {
+    const int nsg = type == GGML_TYPE_F32 ? std::min(4, (int) ((ne00 + 127)/128)) : 2;
+    if (!batch_invariant) {
+        return { nsg, (int16_t) (nypsg*nsg) };
+    }
+
+    switch (type) {
+        case GGML_TYPE_F32:
+            return { nsg, 2 };
+        case GGML_TYPE_Q5_0:
+            return { nsg, (int16_t) (N_R0_Q5_0*nsg) };
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q6_K:
+            return { nsg, (int16_t) (2*nsg) };
+        default:
+            GGML_ABORT("unsupported batch-invariant mul_mv_ext type");
+    }
+}
+
 int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
     ggml_tensor * op = ctx->node(idx);
 
@@ -7817,10 +7845,17 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
     // find the break-even point where the matrix-matrix kernel becomes more efficient compared
     // to the matrix-vector kernel
     const int ne11_mm_min = 8;
+    const bool batch_invariant_ext_type =
+        op->src[0]->type == GGML_TYPE_F32 ||
+        op->src[0]->type == GGML_TYPE_Q5_0 ||
+        op->src[0]->type == GGML_TYPE_Q4_K ||
+        op->src[0]->type == GGML_TYPE_Q6_K;
 
     // first try to use small-batch mat-mv kernels
     // these should be efficient for BS [2, ~8]
-    if (op->src[1]->type == GGML_TYPE_F32 && (ne00%128 == 0) &&
+    if (op->src[1]->type == GGML_TYPE_F32 &&
+        (ne00%128 == 0 ||
+         (op->src[0]->type == GGML_TYPE_Q5_0 && ne00%32 == 0)) &&
         (
          (
           (
@@ -7836,7 +7871,9 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
            op->src[0]->type == GGML_TYPE_Q8_0 ||
            op->src[0]->type == GGML_TYPE_MXFP4 ||
            op->src[0]->type == GGML_TYPE_IQ4_NL ||
-           false) && (ne11 >= 2 && ne11 <= 8)
+           false) && (ne11 >= 2 && ne11 <=
+               ((op->src[0]->type == GGML_TYPE_F32 ||
+                 op->src[0]->type == GGML_TYPE_Q5_0) ? 16 : 8))
          ) ||
          (
           (
@@ -7845,7 +7882,9 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
            op->src[0]->type == GGML_TYPE_Q6_K ||
            op->src[0]->type == GGML_TYPE_Q2_K ||
            op->src[0]->type == GGML_TYPE_Q3_K ||
-           false) && (ne11 >= 4 && ne11 <= 8)
+           false) && (ne11 >= 4 && ne11 <=
+               ((op->src[0]->type == GGML_TYPE_Q4_K ||
+                 op->src[0]->type == GGML_TYPE_Q6_K) ? 16 : 8))
          )
         )
        ) {
@@ -7857,8 +7896,6 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
         //       my current hypothesis is that the work grid is not evenly divisible for different nsg
         //       values and there can be some tail effects when nsg is high. need to confirm this
         //
-        const int nsg    = 2;                 // num simdgroups per threadgroup
-
         // num threads along row per simdgroup
         int16_t nxpsg = 0;
         if (ne00 % 256 == 0 && ne11 < 3) {
@@ -7869,8 +7906,11 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
             nxpsg = 4;
         }
 
-        const int16_t nypsg  = 32/nxpsg;          // num threads along col per simdgroup (i.e. a simdgroup processes that many src0 rows at a time)
-        const int16_t r0ptg  = nypsg*nsg;         // num src0 rows per threadgroup
+        const int16_t nypsg = 32/nxpsg;           // num threads along col per simdgroup (i.e. a simdgroup processes that many src0 rows at a time)
+        const auto row_params = ggml_metal_mul_mv_ext_row_params_for(
+            op->src[0]->type, ne00, nypsg, batch_invariant_ext_type);
+        const int nsg = row_params.nsg;            // num simdgroups per threadgroup
+        const int16_t r0ptg = row_params.r0ptg;    // num src0 rows per threadgroup
               int16_t r1ptg  = 4;                 // num src1 rows per threadgroup
 
         // note: not sure how optimal are those across all different hardware. there might be something cleverer
@@ -7879,12 +7919,20 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
                 r1ptg = 2; break;
             case 3:
             case 6:
+            case 9:
                 r1ptg = 3; break;
             case 4:
             case 7:
             case 8:
+            case 11:
+            case 12:
+            case 16:
                 r1ptg = 4; break;
             case 5:
+            case 10:
+            case 13:
+            case 14:
+            case 15:
                 r1ptg = 5; break;
             default:
                 GGML_ABORT("unsupported ne11");
@@ -7919,7 +7967,14 @@ int ggml_metal_op_mul_mat(ggml_metal_op_t ctx, int idx) {
         ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op->src[1]), 2);
         ggml_metal_encoder_set_buffer  (enc, ggml_metal_get_buffer_id(op),         3);
 
-        ggml_metal_encoder_dispatch_threadgroups(enc, ((ne01 + r0ptg - 1)/r0ptg), ((ne11 + r1ptg - 1)/r1ptg), ne12*ne13, 32, nsg, 1);
+        if (pipeline.smem > 0) {
+            ggml_metal_encoder_set_threadgroup_memory_size(enc, pipeline.smem, 0);
+        }
+
+        const int64_t grid_y = batch_invariant_ext_type ?
+            ne11 : (ne11 + r1ptg - 1)/r1ptg;
+        ggml_metal_encoder_dispatch_threadgroups(
+            enc, (ne01 + r0ptg - 1)/r0ptg, grid_y, ne12*ne13, 32, nsg, 1);
     } else if (
         !ggml_is_transposed(op->src[0]) &&
         !ggml_is_transposed(op->src[1]) &&
