-    const float * logits = llama_get_logits_ith(ctx, index);
-    if (logits == nullptr) {
-        return 0;
-    }
-
-    llama_token best = 0;
-    float best_logit = -std::numeric_limits<float>::infinity();
-    for (int32_t token = 0; token < n_vocab; ++token) {
-        if (logits[token] > best_logit) {
-            best_logit = logits[token];
-            best = token;
-        }
-    }
-
-    return best;
-}
