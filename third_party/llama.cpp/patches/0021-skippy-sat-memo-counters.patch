From bfc15ea2eceb8e719345c17ed7d5e364414176df Mon Sep 17 00:00:00 2001
From: sat <sat@local>
Date: Tue, 22 Sep 2026 22:04:20 +1000
Subject: [PATCH] sat: count stage slice memo hits and misses

---
 src/llama-context.cpp           | 7 +++++--
 src/skippy/stage_slice_plan.cpp | 9 +++++++++
 2 files changed, 14 insertions(+), 2 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index a4198c889..11368356c 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1497,6 +1497,7 @@ llm_graph_result * llama_context::process_ubatch(
     if (sat_trace) {
         extern uint64_t g_sat_build_us, g_sat_build_count, g_sat_realize_us, g_sat_realize_count;
         extern uint64_t g_sat_params_us, g_sat_select_us, g_sat_validate_us, g_sat_frontier_us, g_sat_graph_us;
+        extern uint64_t g_sat_memo_hit, g_sat_memo_miss;
         ggml_backend_sched_synchronize(sched.get());
         sat_exec += 1;
         sat_out  += (uint64_t) n_outputs;
@@ -1510,7 +1511,8 @@ llm_graph_result * llama_context::process_ubatch(
                     " | params=%.1f select=%.1f validate=%.1f frontier=%.1f graph=%.1f"
                     " | noreuse ubatch=%" PRIu64 " nout=%" PRIu64 " topo=%" PRIu64
                     " samplers=%" PRIu64 " nodata=%" PRIu64 " out_i=%" PRIu64
-                    " seqid_i=%" PRIu64 " nextn=%" PRIu64 "\n",
+                    " seqid_i=%" PRIu64 " nextn=%" PRIu64
+                    " | memo_hit=%" PRIu64 " memo_miss=%" PRIu64 "\n",
                     sat_exec, sat_out, sat_reused,
                     (double) sat_us / 1000.0 / (double) sat_exec,
                     (double) g_sat_build_us / 1000.0 / (double) sat_exec,
@@ -1524,7 +1526,8 @@ llm_graph_result * llama_context::process_ubatch(
                     llm_graph_params::reuse_reason(0), llm_graph_params::reuse_reason(1),
                     llm_graph_params::reuse_reason(2), llm_graph_params::reuse_reason(3),
                     llm_graph_params::reuse_reason(4), llm_graph_params::reuse_reason(5),
-                    llm_graph_params::reuse_reason(6), llm_graph_params::reuse_reason(7));
+                    llm_graph_params::reuse_reason(6), llm_graph_params::reuse_reason(7),
+                    g_sat_memo_hit, g_sat_memo_miss);
             fflush(stderr);
         }
     }
diff --git a/src/skippy/stage_slice_plan.cpp b/src/skippy/stage_slice_plan.cpp
index c2d80e00b..89bd85bc7 100644
--- a/src/skippy/stage_slice_plan.cpp
+++ b/src/skippy/stage_slice_plan.cpp
@@ -722,13 +722,22 @@ struct remembered_selection {
 
 thread_local remembered_selection g_remembered[REMEMBERED_SELECTIONS];
 thread_local size_t g_remembered_next = 0;
+}
+
+// SAT instrumentation: with reuse unblocked the memo should fire only on the steps
+// that still rebuild, so the two counters together say which fix is carrying the run.
+uint64_t g_sat_memo_hit = 0, g_sat_memo_miss = 0;
+
+namespace {
 
 const skippy_stage_slice_selection * recall_selection(uint64_t fingerprint) {
     for (const auto & entry : g_remembered) {
         if (entry.occupied && entry.fingerprint == fingerprint) {
+            g_sat_memo_hit += 1;
             return &entry.selection;
         }
     }
+    g_sat_memo_miss += 1;
     return nullptr;
 }
 
-- 
