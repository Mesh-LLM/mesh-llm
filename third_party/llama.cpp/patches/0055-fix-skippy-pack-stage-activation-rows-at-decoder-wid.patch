diff --git a/tests/test-skippy-activation-layout.cpp b/tests/test-skippy-activation-layout.cpp
index 84e78ac39..76077fef6 100644
--- a/tests/test-skippy-activation-layout.cpp
+++ b/tests/test-skippy-activation-layout.cpp
@@ -4,6 +4,7 @@
 
 #include <cstdio>
 #include <memory>
+#include <vector>
 
 static bool expect_hidden_bytes(
         llm_arch arch,
@@ -80,5 +81,42 @@ int main() {
         return 5;
     }
 
+    constexpr size_t decoder_width = 4;
+    constexpr size_t source_width = 6;
+    std::vector<float> source(tokens*source_width, -1.0f);
+    for (size_t token = 0; token < tokens; ++token) {
+        for (size_t column = 0; column < decoder_width; ++column) {
+            source[token*source_width + column] = static_cast<float>(token*10 + column);
+        }
+    }
+    skippy_activation_desc input_desc = {};
+    input_desc.part_count = 1;
+    input_desc.token_count = tokens;
+    input_desc.payload_bytes = source.size()*sizeof(float);
+    auto & primary = input_desc.parts[0];
+    primary.ggml_type = GGML_TYPE_F32;
+    primary.rank = 2;
+    primary.token_axis = 1;
+    primary.dimensions[0] = source_width;
+    primary.dimensions[1] = tokens;
+    primary.byte_strides[0] = sizeof(float);
+    primary.byte_strides[1] = source_width*sizeof(float);
+    primary.payload_bytes = input_desc.payload_bytes;
+    std::vector<float> packed(tokens*decoder_width, -1.0f);
+    if (skippy_copy_primary_activation_rows(
+                &input_desc, source.data(), tokens, decoder_width,
+                packed.data(), packed.size(), nullptr) != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "multi-token activation rows could not be packed\n");
+        return 6;
+    }
+    for (size_t token = 0; token < tokens; ++token) {
+        for (size_t column = 0; column < decoder_width; ++column) {
+            if (packed[token*decoder_width + column] != static_cast<float>(token*10 + column)) {
+                std::fprintf(stderr, "activation rows were not packed at decoder width\n");
+                return 7;
+            }
+        }
+    }
+
     return 0;
 }
