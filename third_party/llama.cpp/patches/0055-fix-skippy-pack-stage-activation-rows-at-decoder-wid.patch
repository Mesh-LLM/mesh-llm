-        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "activation input width is incompatible with the model embedding width");
+    if (n_embd <= 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "model decoder width must be positive");
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
     const int32_t n_pos_per_embd = session->stage_model->model->hparams.n_pos_per_embd();
@@ -670,30 +711,17 @@ enum skippy_status skippy_decode_activation_frame(
