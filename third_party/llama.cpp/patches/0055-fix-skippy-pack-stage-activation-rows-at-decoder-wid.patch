diff --git a/src/skippy/activation.cpp b/src/skippy/activation.cpp
index c0ff99a96..6593f6afb 100644
--- a/src/skippy/activation.cpp
+++ b/src/skippy/activation.cpp
@@ -63,6 +63,48 @@ bool skippy_memory_needs_verify_checkpoint(llama_memory_t memory) {
            dynamic_cast<llama_memory_recurrent *>(memory) != nullptr;
 }
 
+enum skippy_status skippy_copy_primary_activation_rows(
+        const skippy_activation_desc * input_desc,
+        const void * input_payload,
+        size_t token_count,
+        size_t row_width,
+        float * destination,
+        size_t destination_count,
+        skippy_error ** out_error) {
+    if (input_desc == nullptr || input_payload == nullptr || token_count == 0 || row_width == 0 || destination == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation rows require a descriptor, payload, shape, and destination");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (token_count > std::numeric_limits<size_t>::max()/row_width || destination_count < token_count*row_width) {
+        skippy_set_error(out_error, SKIPPY_STATUS_BUFFER_TOO_SMALL, "activation row destination is too small");
+        return SKIPPY_STATUS_BUFFER_TOO_SMALL;
+    }
+    if (row_width > std::numeric_limits<size_t>::max()/sizeof(float)) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation row width exceeds size_t range");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const auto * primary = skippy_activation_part_at(input_desc, 0);
+    const auto * payload = static_cast<const uint8_t *>(
+            skippy_activation_part_payload(input_desc, input_payload, primary));
+    if (primary == nullptr || payload == nullptr || primary->ggml_type != GGML_TYPE_F32 ||
+            primary->token_axis < 0 || primary->token_axis >= static_cast<int32_t>(primary->rank)) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation frame primary part must be token-indexed F32");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const size_t row_bytes = row_width*sizeof(float);
+    const size_t source_stride = static_cast<size_t>(primary->byte_strides[primary->token_axis]);
+    if (source_stride < row_bytes ||
+            (token_count - 1 > (std::numeric_limits<size_t>::max() - row_bytes)/source_stride) ||
+            (token_count - 1)*source_stride + row_bytes > primary->payload_bytes) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation primary part is narrower than its decoder rows");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    for (size_t token = 0; token < token_count; ++token) {
+        std::memcpy(destination + token*row_width, payload + token*source_stride, row_bytes);
+    }
+    return skippy_success(out_error);
+}
+
 // Recurrent memory can roll a bounded number of trailing positions back in
 // place: the RS cache is widened to (1 + n_rs_seq) snapshot groups and
 // llama_memory_recurrent::seq_rm rewinds via set_rs_idx when the rollback fits
@@ -649,9 +691,8 @@ enum skippy_status skippy_decode_activation_frame(
         skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation boundary requires token-id sideband");
         return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
