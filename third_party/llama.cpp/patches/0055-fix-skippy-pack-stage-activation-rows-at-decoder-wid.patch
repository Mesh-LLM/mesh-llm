     }
 
-    std::vector<float> embd_storage(static_cast<size_t>(n_tokens)*n_embd_inp);
+    std::vector<float> embd_storage(static_cast<size_t>(n_tokens)*n_embd);
     std::vector<llama_pos> pos_storage(expected_position_count);
     std::vector<int32_t> n_seq_id_storage(n_tokens);
     std::vector<llama_seq_id> seq_id_0(1, session->seq_id);
     std::vector<llama_seq_id *> seq_id_storage(n_tokens + 1, nullptr);
     std::vector<int8_t> logits_storage(n_tokens);
 
-    const auto * primary_part = skippy_activation_part_at(input_desc, 0);
-    const void * primary_payload = skippy_activation_part_payload(input_desc, input_payload, primary_part);
-    if (primary_part == nullptr || primary_payload == nullptr || primary_part->ggml_type != GGML_TYPE_F32) {
-        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation frame primary part must be packed F32");
-        return SKIPPY_STATUS_INVALID_ARGUMENT;
-    }
-    const size_t primary_token_stride = primary_part->byte_strides[primary_part->token_axis];
-    if (primary_token_stride < static_cast<size_t>(n_embd) * sizeof(float)) {
-        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation primary part is narrower than the model embedding width");
-        return SKIPPY_STATUS_INVALID_ARGUMENT;
-    }
-    for (int32_t i = 0; i < n_tokens; ++i) {
-        float * dst = embd_storage.data() + static_cast<size_t>(i)*n_embd_inp;
-        const auto * src = static_cast<const uint8_t *>(primary_payload) + static_cast<size_t>(i)*primary_token_stride;
-        std::memcpy(dst, src, static_cast<size_t>(n_embd)*sizeof(float));
-        std::memset(dst + n_embd, 0, static_cast<size_t>(n_embd_inp - n_embd)*sizeof(float));
-    }
+    enum skippy_status status = skippy_copy_primary_activation_rows(
+            input_desc, input_payload, token_count, static_cast<size_t>(n_embd),
+            embd_storage.data(), embd_storage.size(), out_error);
+    if (status != SKIPPY_STATUS_OK) return status;
 
     for (int32_t i = 0; i < n_tokens; ++i) {
         n_seq_id_storage[i] = 1;
@@ -735,7 +763,7 @@ enum skippy_status skippy_decode_activation_frame(
             input_desc,
             input_payload,
             token_start);
-    enum skippy_status status = skippy_decode_batch(
+    status = skippy_decode_batch(
             session,
             batch,
             token_count,
@@ -777,9 +805,8 @@ enum skippy_status skippy_verify_activation_frame(
         skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation verification requires token-id sideband");
         return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
-    const int32_t n_embd_inp = llama_model_n_embd_inp(session->stage_model->model);
-    if (n_embd <= 0 || n_embd_inp < n_embd) {
-        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "activation input width is incompatible with the model embedding width");
+    if (n_embd <= 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "model decoder width must be positive");
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
     const int32_t n_pos_per_embd = session->stage_model->model->hparams.n_pos_per_embd();
@@ -793,29 +820,18 @@ enum skippy_status skippy_verify_activation_frame(
         return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
     const size_t expected_position_count = token_count*n_pos_per_token;
-    const auto * primary_part = skippy_activation_part_at(input_desc, 0);
-    const void * primary_payload = skippy_activation_part_payload(input_desc, input_payload, primary_part);
-    if (primary_part == nullptr || primary_payload == nullptr || primary_part->ggml_type != GGML_TYPE_F32) {
-        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation frame primary part must be packed F32");
-        return SKIPPY_STATUS_INVALID_ARGUMENT;
-    }
-    const size_t primary_token_stride = primary_part->byte_strides[primary_part->token_axis];
-    if (primary_token_stride < static_cast<size_t>(n_embd) * sizeof(float)) {
-        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "activation primary part is narrower than the model embedding width");
-        return SKIPPY_STATUS_INVALID_ARGUMENT;
-    }
-
-    llama_batch batch = llama_batch_init(n_tokens, n_embd_inp, 1);
+    llama_batch batch = llama_batch_init(n_tokens, n_embd, 1);
     llama_token * owned_batch_tokens = batch.token;
     llama_pos * owned_batch_positions = batch.pos;
+    enum skippy_status status = skippy_copy_primary_activation_rows(
+            input_desc, input_payload, token_count, static_cast<size_t>(n_embd),
+            batch.embd, token_count*static_cast<size_t>(n_embd), out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        llama_batch_free(batch);
+        return status;
+    }
     std::vector<llama_pos> pos_storage(expected_position_count);
     batch.pos = pos_storage.data();
-    for (int32_t i = 0; i < n_tokens; ++i) {
-        float * dst = batch.embd + static_cast<size_t>(i)*n_embd_inp;
-        const auto * src = static_cast<const uint8_t *>(primary_payload) + static_cast<size_t>(i)*primary_token_stride;
-        std::memcpy(dst, src, static_cast<size_t>(n_embd)*sizeof(float));
-        std::memset(dst + n_embd, 0, static_cast<size_t>(n_embd_inp - n_embd)*sizeof(float));
-    }
     if (token_ids_required) batch.token = const_cast<llama_token *>(token_ids);
     batch.n_tokens = n_tokens;
 
@@ -847,7 +863,7 @@ enum skippy_status skippy_verify_activation_frame(
             input_desc,
             input_payload,
             token_start);
-    enum skippy_status status = skippy_decode_batch(
+    status = skippy_decode_batch(
             session,
             batch,
             token_count,
