From 14c1e7eb55fbd5ed54c782e3e4fa33e56a49ebbd Mon Sep 17 00:00:00 2001
From: sat <sat@local>
Date: Tue, 22 Sep 2026 16:37:51 +1000
Subject: [PATCH] skippy: SAT phase timers inside stage realisation

---
 src/llama-context.cpp            | 11 +++++++++--
 src/skippy/stage_realization.cpp | 12 ++++++++++++
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 8f8d91dc5..eebc23467 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -1496,6 +1496,7 @@ llm_graph_result * llama_context::process_ubatch(
 
     if (sat_trace) {
         extern uint64_t g_sat_build_us, g_sat_build_count, g_sat_realize_us, g_sat_realize_count;
+        extern uint64_t g_sat_params_us, g_sat_select_us, g_sat_validate_us, g_sat_frontier_us, g_sat_graph_us;
         ggml_backend_sched_synchronize(sched.get());
         sat_exec += 1;
         sat_out  += (uint64_t) n_outputs;
@@ -1505,12 +1506,18 @@ llm_graph_result * llama_context::process_ubatch(
             fprintf(stderr,
                     "SAT-STATS exec=%" PRIu64 " outputs=%" PRIu64 " reused=%" PRIu64
                     " compute_ms_per_exec=%.1f build_ms_per_exec=%.1f realize_ms_per_exec=%.1f"
-                    " builds=%" PRIu64 " realizes=%" PRIu64 "\n",
+                    " builds=%" PRIu64 " realizes=%" PRIu64
+                    " | params=%.1f select=%.1f validate=%.1f frontier=%.1f graph=%.1f\n",
                     sat_exec, sat_out, sat_reused,
                     (double) sat_us / 1000.0 / (double) sat_exec,
                     (double) g_sat_build_us / 1000.0 / (double) sat_exec,
                     (double) g_sat_realize_us / 1000.0 / (double) sat_exec,
-                    g_sat_build_count, g_sat_realize_count);
+                    g_sat_build_count, g_sat_realize_count,
+                    (double) g_sat_params_us / 1000.0 / (double) sat_exec,
+                    (double) g_sat_select_us / 1000.0 / (double) sat_exec,
+                    (double) g_sat_validate_us / 1000.0 / (double) sat_exec,
+                    (double) g_sat_frontier_us / 1000.0 / (double) sat_exec,
+                    (double) g_sat_graph_us / 1000.0 / (double) sat_exec);
             fflush(stderr);
         }
     }
diff --git a/src/skippy/stage_realization.cpp b/src/skippy/stage_realization.cpp
index 9b2726f60..77f37df4f 100644
--- a/src/skippy/stage_realization.cpp
+++ b/src/skippy/stage_realization.cpp
@@ -126,6 +126,8 @@ int32_t skippy_activation_token_axis(const ggml_tensor * tensor, uint32_t n_toke
 // SAT instrumentation: #1927 builds the whole-model graph and filters it here, on the
 // critical path of every rebuild. This is CPU time no GPU counter sees.
 uint64_t g_sat_realize_us = 0, g_sat_realize_count = 0;
+uint64_t g_sat_params_us = 0, g_sat_select_us = 0, g_sat_validate_us = 0,
+         g_sat_frontier_us = 0, g_sat_graph_us = 0;
 
 namespace {
 struct SatRealizeTimer {
@@ -146,7 +148,9 @@ void skippy_realize_stage_graph(
     }
     SatRealizeTimer sat_timer;
 
+    const int64_t sat_p0 = ggml_time_us();
     const auto parameters = parameter_bindings(model);
+    g_sat_params_us += (uint64_t) (ggml_time_us() - sat_p0);
     skippy_stage_slice_selection selection;
     std::string error;
     if (params.gtype == LLM_GRAPH_TYPE_DECODER_MTP) {
@@ -159,6 +163,7 @@ void skippy_realize_stage_graph(
                 params.cparams.nextn_layer_offset, auxiliary.parameter_identities);
         return;
     }
+    const int64_t sat_s0 = ggml_time_us();
     if (!skippy_select_stage_slice(
                 result.get_gf(),
                 result.get_block_boundaries(),
@@ -173,8 +178,12 @@ void skippy_realize_stage_graph(
                 primary_output(result))) {
         throw std::runtime_error("cannot realize admitted stage graph: " + error);
     }
+    g_sat_select_us += (uint64_t) (ggml_time_us() - sat_s0);
 
+    const int64_t sat_v0 = ggml_time_us();
     skippy_validate_execution_dependencies(params.build_inputs, false, 0, selection.parameter_identities);
+    g_sat_validate_us += (uint64_t) (ggml_time_us() - sat_v0);
+    const int64_t sat_f0 = ggml_time_us();
     std::vector<std::string> realized_import_identities;
     std::vector<std::string> realized_import_bindings;
     std::vector<std::string> realized_export_identities;
@@ -200,6 +209,8 @@ void skippy_realize_stage_graph(
         throw std::runtime_error("admitted stage frontier bindings do not match the realized graph slice");
     }
 
+    g_sat_frontier_us += (uint64_t) (ggml_time_us() - sat_f0);
+    const int64_t sat_g0 = ggml_time_us();
     std::unordered_map<const ggml_tensor *, ggml_tensor *> replacements;
     std::vector<skippy_activation_port> imports;
     imports.reserve(selection.activation_imports.size());
@@ -272,4 +283,5 @@ void skippy_realize_stage_graph(
                 params.build_inputs.activation_export_bindings[index]});
     }
     result.replace_with_stage_graph(graph, std::move(imports), std::move(exports));
+    g_sat_graph_us += (uint64_t) (ggml_time_us() - sat_g0);
 }
-- 
2.50.1 (Apple Git-155)

