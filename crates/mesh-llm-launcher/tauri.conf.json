{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesh",
  "identifier": "com.mesh-llm.launcher",
  "build": {
    "frontendDist": "assets"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mesh",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../mesh-llm-ui/public/icon-192.png",
      "../mesh-llm-ui/public/icon-512.png",
      "../mesh-llm-ui/public/meshllm-favicon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["mesh-llm"]
      }
    }
  }
}
