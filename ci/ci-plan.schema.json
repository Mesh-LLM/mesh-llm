{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mesh-llm.dev/schemas/ci-plan.schema.json",
  "title": "MeshLLM CI plan",
  "$comment": "This schema validates the transport shape. Consumers must obtain plans from scripts/plan-ci.py, whose semantic validation additionally enforces unique matrix IDs and requires reasons, dependencies, runner_roles, and cache_modes to be keyed exactly by required_slices.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "event_name",
    "source_sha",
    "base_sha",
    "direct_crates",
    "affected_crates",
    "domains",
    "required_slices",
    "matrices",
    "reasons",
    "dependencies",
    "runner_roles",
    "cache_modes",
    "budgets",
    "signals"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"enum": ["pr-draft", "pr-ready", "main", "manual-full"]},
    "event_name": {"enum": ["pull_request", "push", "workflow_dispatch"]},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": "string", "pattern": "^(|[0-9a-f]{40})$"},
    "direct_crates": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "affected_crates": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "domains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "required_slices": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "matrices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clippy", "rust_tests", "hosts", "runtime_products", "platform_checks", "smoke", "sdk"],
      "properties": {
        "clippy": {"$ref": "#/$defs/matrix"},
        "rust_tests": {"$ref": "#/$defs/matrix"},
        "hosts": {"$ref": "#/$defs/matrix"},
        "runtime_products": {"$ref": "#/$defs/matrix"},
        "platform_checks": {"$ref": "#/$defs/matrix"},
        "smoke": {"$ref": "#/$defs/matrix"},
        "sdk": {"$ref": "#/$defs/matrix"}
      }
    },
    "reasons": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
    "dependencies": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}},
    "runner_roles": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"type": "string", "minLength": 1}},
    "cache_modes": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"enum": ["none", "pr-isolated", "trusted-readonly", "trusted-readwrite"]}},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux_max_parallel", "macos_max_parallel", "windows_max_parallel", "total_max_workers"],
      "properties": {
        "linux_max_parallel": {"type": "integer", "minimum": 1},
        "macos_max_parallel": {"type": "integer", "minimum": 1},
        "windows_max_parallel": {"type": "integer", "minimum": 1},
        "total_max_workers": {"type": "integer", "minimum": 1}
      }
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rust_changed",
        "ui_changed",
        "website_changed",
        "website_docs_changed",
        "cli_surface_changed",
        "swift_full_required",
        "docs_only",
        "backend_changed",
        "runner_contract_required"
      ],
      "properties": {
        "rust_changed": {"type": "boolean"},
        "ui_changed": {"type": "boolean"},
        "website_changed": {"type": "boolean"},
        "website_docs_changed": {"type": "boolean"},
        "cli_surface_changed": {"type": "boolean"},
        "swift_full_required": {"type": "boolean"},
        "docs_only": {"type": "boolean"},
        "backend_changed": {"type": "boolean"},
        "runner_contract_required": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "matrix": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}, "additionalProperties": true}
    }
  }
}
