{% from "components/ui.njk" import sectionHead %}

<section class="sec" id="share-server">
  <div class="shell">
    {{ sectionHead(
      "Already running Ollama or LM Studio?",
      "Keep your server and models. Share them with your other machines through Mesh, without installing a plugin or loading a native inference runtime. Private by default; one HTTP upstream without authentication."
