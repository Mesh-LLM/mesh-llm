<script>
(function () {
  const searchInput = document.getElementById('catalog-search');
  const filterCapability = document.getElementById('filter-capability');
  const filterRuntime = document.getElementById('filter-runtime');
  const filterHardware = document.getElementById('filter-hardware');
  const filterSource = document.getElementById('filter-source');
  const catalogCard = document.getElementById('catalog-card');

  if (!searchInput || !catalogCard) return;

  var PAGE_SIZE = 10;
  var currentPage = 1;
  var filteredRows = [];

  function applyFilters() {
    const query = searchInput.value.toLowerCase().trim();
    const capability = filterCapability ? filterCapability.value : '';
    const runtime = filterRuntime ? filterRuntime.value : '';
    const hardware = filterHardware ? filterHardware.value : '';
    const source = filterSource ? filterSource.value : '';

    const rows = catalogCard.querySelectorAll('.catalog-row');
    filteredRows = [];

    rows.forEach(function (row) {
      const name = (row.querySelector('.m')?.textContent || '').toLowerCase();
      const ref = (row.querySelector('.ref code')?.textContent || '').toLowerCase();
      const desc = (row.querySelector('.ms')?.textContent || '').toLowerCase();
      const caps = row.getAttribute('data-capability') || '';
      const rt = row.getAttribute('data-runtime') || '';
      const hw = row.getAttribute('data-hardware') || '';
      const src = row.getAttribute('data-source') || '';

      const matchesSearch = !query || name.includes(query) || ref.includes(query) || desc.includes(query);
      const matchesCapability = !capability || caps.split(' ').some(function (c) { return c.toLowerCase() === capability.toLowerCase(); });
      const matchesRuntime = !runtime || rt.toLowerCase() === runtime.toLowerCase();
      const matchesHardware = !hardware || hw.toLowerCase() === hardware.toLowerCase();
      const matchesSource = !source || src.toLowerCase() === source.toLowerCase();

      const visible = matchesSearch && matchesCapability && matchesRuntime && matchesHardware && matchesSource;
      row.style.display = 'none';
      if (visible) filteredRows.push(row);
    });

    currentPage = 1;
    renderPage();
  }

  function renderPage() {
    var totalPages = Math.max(1, Math.ceil(filteredRows.length / PAGE_SIZE));
    if (currentPage > totalPages) currentPage = totalPages;

    var start = (currentPage - 1) * PAGE_SIZE;
    var end = start + PAGE_SIZE;

    filteredRows.forEach(function (row, i) {
      row.style.display = (i >= start && i < end) ? '' : 'none';
    });

    updatePagination(filteredRows.length, totalPages);
  }

  function updatePagination(total, totalPages) {
    var pgEl = catalogCard.querySelector('.catalog-foot .pg');
    if (!pgEl) return;

    if (totalPages <= 1) {
      pgEl.style.display = 'none';
      return;
    }
    pgEl.style.display = '';

    var totalPagesNum = totalPages;
    var html = '';

    // Prev button
    html += '<a href="#" class="pg-prev"' + (currentPage === 1 ? ' style="opacity:0.3;pointer-events:none"' : '') + '>←</a>';

    // Page numbers with ellipsis
    if (totalPagesNum <= 7) {
      for (var i = 1; i <= totalPagesNum; i++) {
        html += '<a href="#" class="pg-num' + (i === currentPage ? ' now' : '') + '" data-page="' + i + '">' + i + '</a>';
      }
    } else {
      html += '<a href="#" class="pg-num' + (1 === currentPage ? ' now' : '') + '" data-page="1">1</a>';
      if (currentPage > 3) html += '<span style="padding:4px 6px;color:var(--muted)">…</span>';
      var rangeStart = Math.max(2, currentPage - 1);
      var rangeEnd = Math.min(totalPagesNum - 1, currentPage + 1);
      if (currentPage <= 3) rangeEnd = Math.min(4, totalPagesNum - 1);
      if (currentPage >= totalPagesNum - 2) rangeStart = Math.max(3, totalPagesNum - 2);
      for (var i = rangeStart; i <= rangeEnd; i++) {
        html += '<a href="#" class="pg-num' + (i === currentPage ? ' now' : '') + '" data-page="' + i + '">' + i + '</a>';
      }
      if (currentPage < totalPagesNum - 2) html += '<span style="padding:4px 6px;color:var(--muted)">…</span>';
      html += '<a href="#" class="pg-num' + (totalPagesNum === currentPage ? ' now' : '') + '" data-page="' + totalPagesNum + '">' + totalPagesNum + '</a>';
    }

    // Next button
    html += '<a href="#" class="pg-next"' + (currentPage === totalPagesNum ? ' style="opacity:0.3;pointer-events:none"' : '') + '>→</a>';

    pgEl.innerHTML = html;

    // Update live count
    var liveEl = catalogCard.querySelector('.catalog-foot .live');
    if (liveEl) {
      liveEl.innerHTML = 'Showing ' + ((currentPage - 1) * PAGE_SIZE + 1) + '–' + Math.min(currentPage * PAGE_SIZE, total) + ' of ' + total;
    }
  }

  // Pagination click handler
  catalogCard.addEventListener('click', function (e) {
    var pgBtn = e.target.closest('.pg-prev, .pg-next, .pg-num');
    if (!pgBtn) return;
    e.preventDefault();

    if (pgBtn.classList.contains('pg-prev')) currentPage--;
    else if (pgBtn.classList.contains('pg-next')) currentPage++;
    else if (pgBtn.hasAttribute('data-page')) currentPage = parseInt(pgBtn.getAttribute('data-page'));

    renderPage();
  });

  searchInput.addEventListener('input', applyFilters);
  if (filterCapability) filterCapability.addEventListener('change', applyFilters);
  if (filterRuntime) filterRuntime.addEventListener('change', applyFilters);
  if (filterHardware) filterHardware.addEventListener('change', applyFilters);
  if (filterSource) filterSource.addEventListener('change', applyFilters);

  // Copy button functionality
  catalogCard.addEventListener('click', function (e) {
    const btn = e.target.closest('.copy');
    if (!btn) return;
    const row = btn.closest('.catalog-row');
    const ref = row.querySelector('.ref code')?.textContent || '';
    navigator.clipboard.writeText(ref).then(function () {
      const original = btn.innerHTML;
      btn.classList.add('copied');
      btn.textContent = '✓';
      setTimeout(function () {
        btn.innerHTML = original;
        btn.classList.remove('copied');
        if (typeof lucide !== 'undefined') lucide.createIcons();
      }, 1200);
    });
  });

  // Keyboard shortcut for search
  document.addEventListener('keydown', function (e) {
    if ((e.key === 'k' || e.key === 'K') && !e.ctrlKey && !e.metaKey && !e.altKey) {
      const tag = document.activeElement.tagName;
      if (tag !== 'INPUT' && tag !== 'TEXTAREA' && tag !== 'SELECT') {
        e.preventDefault();
        searchInput.focus();
      }
    }
  });

  // Initial render
  applyFilters();
})();
</script>
