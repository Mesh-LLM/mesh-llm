// exported invariants for PD hello in hello.system
define mk_is_protected_source(x) (false)
define f_mk_is_protected_source(heap,gv,x) (mk_is_protected_source(x))
define mk_is_ppcall_target(x) (false)
define f_mk_is_ppcall_target(heap,gv,x) (mk_is_ppcall_target(x))
define mk_is_notified_source(x) (false)
define f_mk_is_notified_source(heap,gv,x) (mk_is_notified_source(x))
define mk_is_notify_target(x) (false)
define f_mk_is_notify_target(heap,gv,x) (mk_is_notify_target(x))
define mk_is_irq_channel(x) (false)
define f_mk_is_irq_channel(heap,gv,x) (mk_is_irq_channel(x))
define mk_is_child(x) (false)
define f_mk_is_child(heap,gv,x) (mk_is_child(x))
define pansel4_has_cap(x) (x in Set(1,3,4))
define f_pansel4_has_cap(heap,gv,x) (pansel4_has_cap(x))
define pansel4_has_endpoint_cap(x) (false)
define f_pansel4_has_endpoint_cap(heap,gv,x) (pansel4_has_endpoint_cap(x))
define pansel4_has_notification_cap(x) (x in Set(1))
define f_pansel4_has_notification_cap(heap,gv,x) (pansel4_has_notification_cap(x))
define pansel4_has_reply_cap(x) (x in Set(4))
define f_pansel4_has_reply_cap(heap,gv,x) (pansel4_has_reply_cap(x))
define pansel4_has_page_table_cap(x) (x in Set(3))
define f_pansel4_has_page_table_cap(heap,gv,x) (pansel4_has_page_table_cap(x))
define pansel4_has_irq_handler_cap(x) (false)
define f_pansel4_has_irq_handler_cap(heap,gv,x) (pansel4_has_irq_handler_cap(x))
define pansel4_has_tcb_cap(x) (false)
define f_pansel4_has_tcb_cap(heap,gv,x) (pansel4_has_tcb_cap(x))
define pansel4_has_vcpu_cap(x) (false)
define f_pansel4_has_vcpu_cap(heap,gv,x) (pansel4_has_vcpu_cap(x))
define pansel4_has_ioport_cap(x) (false)
define f_pansel4_has_ioport_cap(heap,gv,x) (pansel4_has_ioport_cap(x))
define pansel4_has_arm_smc_cap(x) (false)
define f_pansel4_has_arm_smc_cap(heap,gv,x) (pansel4_has_arm_smc_cap(x))
define mem_readable(x) (false)
define f_mem_readable(heap,gv,x) (mem_readable(x))
define mem_writeable(x) (false)
define f_mem_writeable(heap,gv,x) (mem_writeable(x))
