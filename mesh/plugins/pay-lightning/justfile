# Isolated plugin commands; run from this directory.
root := "../../.."

build:
    cd {{root}} && just with-lld cargo build --locked -p mesh-pay-lightning

check:
    cd {{root}} && cargo check --locked -p mesh-pay-lightning
    cd {{root}} && cargo clippy --locked -p mesh-pay-lightning --all-targets -- -D warnings

test:
    cd {{root}} && cargo test --locked -p mesh-pay-lightning -p mesh-llm-payments -p mesh-llm-payments-types -p mesh-llm-wallet

package: build
    mkdir -p dist
    cp plugin.toml README.md dist/
    cp {{root}}/target/debug/mesh-pay-lightning dist/pay-lightning
    {{root}}/target/debug/mesh-pay-lightning --manifest > dist/manifest.json

clean:
    cd {{root}} && cargo clean -p mesh-pay-lightning
    rm -rf dist
