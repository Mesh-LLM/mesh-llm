# Copy to mesh-fleet.env then chmod 600. No token belongs in this file.
MESH_NAME=lab-071
# Use a real immutable package revision for split runs. Local GGUF is single-node only.
MESH_MODEL='hf://meshllm/Qwen3-8B-Q4_K_M-layers@REPLACE_WITH_REAL_IMMUTABLE_REVISION'
MESH_VERSION=0.71.0
MESH_LAN=1
MESH_SPLIT=1
MESH_ARTIFACT_TRANSFER=trusted
MESH_CTX_SIZE=65536
# Fast mode starts peer processes immediately; only --wait-ready polls APIs.
MESH_WAIT_SECONDS=15
MESH_KV_CACHE_POLICY=saver
MESH_KV_OFFLOAD=true
MESH_CACHE_TYPE_K=q4_0
MESH_CACHE_TYPE_V=q4_0
MESH_GPU_LAYERS=auto
MESH_MMAP=true

NODE_MAC_ENABLED=1
NODE_MAC_ROLE=seed
NODE_MAC_BIN='/Users/luciano/Downloads/scripts/flushnet-mesh-llm/upstream/mesh-llm-v071/target/release/mesh-llm'
NODE_MAC_MODEL="$MESH_MODEL"
NODE_MAC_CONSOLE=31782
NODE_MAC_API_PORT=30781
NODE_MAC_BIND_PORT=7842
# Operator seed: embedded UI exposes normal chat and access-code enabled Flushnet tool chat.
NODE_MAC_WEB_UI=1
NODE_MAC_LLAMA_FLAVOR=metal
NODE_MAC_DEVICE=metal
NODE_MAC_MAX_VRAM=8

# Keep disabled until a matching Windows 0.71.0 bundle exists at this path.
NODE_WIN_ENABLED=0
NODE_WIN_ROLE=join
NODE_WIN_SSH_MODE='wrapper:ssh-win'
NODE_WIN_BIN='C:\MeshLLM\0.71.0\mesh-llm.exe'
NODE_WIN_CONSOLE=41331
NODE_WIN_API_PORT=41332
NODE_WIN_BIND_PORT=7843
# Enable this on the Windows builder/operator node after its 0.71.0 UI bundle is installed.
NODE_WIN_WEB_UI=1
NODE_WIN_LLAMA_FLAVOR=cpu
NODE_WIN_DEVICE=cpu
NODE_WIN_MAX_VRAM=4

# Explicit IP requested: 192.168.1.113. Enable only if it is a separate physical host.
NODE_WIN2_ENABLED=0
NODE_WIN2_ROLE=join
NODE_WIN2_SSH_MODE=direct
NODE_WIN2_SSH_HOST=192.168.1.113
NODE_WIN2_SSH_USER=lux
NODE_WIN2_SSH_KEY="$HOME/.ssh/l2p2p_win"
NODE_WIN2_BIN='C:\MeshLLM\0.71.0\mesh-llm.exe'
NODE_WIN2_CONSOLE=42331
NODE_WIN2_API_PORT=42332
NODE_WIN2_BIND_PORT=7844
NODE_WIN2_WEB_UI=0
NODE_WIN2_LLAMA_FLAVOR=cpu
NODE_WIN2_DEVICE=cpu
NODE_WIN2_MAX_VRAM=4

NODE_WIN3_ENABLED=0
NODE_WIN3_ROLE=join
NODE_WIN3_SSH_MODE='wrapper:ssh-win3'
NODE_WIN3_BIN='C:\MeshLLM\0.71.0\mesh-llm.exe'
NODE_WIN3_CONSOLE=43331
NODE_WIN3_API_PORT=43332
NODE_WIN3_BIND_PORT=7845
NODE_WIN3_WEB_UI=0
NODE_WIN3_LLAMA_FLAVOR=cpu
NODE_WIN3_DEVICE=cpu
NODE_WIN3_MAX_VRAM=4
