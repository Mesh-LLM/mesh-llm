    {
      "group": "happy",
      "name": "cpu",
      "args": ["--root", "rt", "--os", "linux", "--arch", "x86_64", "--backend", "cpu"],
      "files": {
        "rt/cpu/manifest.json": "{\"runtime\": {\"platform\": {\"os\": \"linux\", \"arch\": \"x86_64\"}, \"backend\": {\"kind\": \"cpu\"}}}",
        "rt/metal/manifest.json": "{\"runtime\": {\"platform\": {\"os\": \"macos\", \"arch\": \"aarch64\"}, \"backend\": {\"kind\": \"metal\"}}}",
        "rt/notes.txt": "not a runtime"
      },
      "code": 0,
      "stdout": "rt/cpu\n",
      "stderr": ""
    },
    {
