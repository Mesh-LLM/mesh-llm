        "rt/rocm/manifest.json": "{\"runtime\": {\"platform\": {\"os\": \"linux\", \"arch\": \"x86_64\"}, \"backend\": {\"kind\": \"rocm\"}}}",
        "rt/cpu/manifest.json": "{\"runtime\": {\"platform\": {\"os\": \"linux\", \"arch\": \"x86_64\"}, \"backend\": {\"kind\": \"cpu\"}}}"
