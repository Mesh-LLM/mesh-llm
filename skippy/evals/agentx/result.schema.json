{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profile", "model", "cells", "promote_to_performance_history"],
  "additionalProperties": false,
  "properties": {
    "profile": {"enum": ["smoke", "benchmark"]},
    "model": {"type": "object"},
    "promote_to_performance_history": {"const": false},
    "cells": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["name", "engine", "offered_sessions", "generation_slots", "submission_valid", "request_count", "output_tok_s", "ttft", "itl", "e2e", "export_sha256"],
        "properties": {
          "name": {"type": "string"},
          "engine": {"enum": ["llama", "skippy"]},
          "offered_sessions": {"enum": [1, 2, 4, 8]},
          "generation_slots": {"const": 1},
          "submission_valid": {"const": false},
          "request_count": {"type": "number", "minimum": 1},
          "output_tok_s": {"type": "number", "minimum": 0},
          "ttft": {"type": "object"},
          "itl": {"type": "object"},
          "e2e": {"type": "object"},
          "export_sha256": {"type": "string", "minLength": 64, "maxLength": 64}
        }
      }
    }
  }
}
