{
  "spec": {
    "name": "Grammar sampler \u2014 M6 fresh-process startup and A-history control",
    "description": "Diagnostic only:24 fresh pairs using unchanged R5 worker binaries, full factorial startup order x A-preconditioning x six B/R/C orders. Three warmups and20 repetitions, all five fixtures. Frozen B primary; no normalization or qualification.",
    "target": {
      "executor": "lab",
      "nodes": [
        "macmini-gq7vhw"
      ],
      "os": "macos"
    },
    "runtime": {
      "model_package": {
        "ref": "hf:unsloth/Qwen3.5-9B-GGUF@3885219b6810b007914f3a7950a8d1b469d598a5",
        "sha256": "03b74727a860a56338e042c4420bb3f04b2fec5734175f4cb9fa853daf52b7e8",
        "egress": "lab_only"
      },
      "models": [
        {
          "ref": "hf:unsloth/Qwen3.5-9B-GGUF@3885219b6810b007914f3a7950a8d1b469d598a5",
          "env": "MODEL_DIR",
          "delivery": "cache",
          "pin": true
        }
      ],
      "flags": {
        "phase": "process-control",
        "product_commit": "983f2aad129270dea4d172bff9441d2195a86d9a",
        "baseline_commit": "3947de0cbc73fe5cbcaae548b297f03a401532d7",
        "build_job_id": "${build_job_id}",
        "build_run_id": "${build_run_id}",
        "input_manifest_sha256": "${input_manifest_sha256}",
        "binary_manifest_sha256": "${binary_manifest_sha256}",
        "evaluator_commit": "${evaluator_sha}"
      },
      "command": "set -eu\nSOURCE=\"$PWD/controller-source\"\nFROZEN=\"${retained_workspace}\"\ntest \"$(git -C \"$SOURCE\" rev-parse HEAD)\" = '${evaluator_sha}'\ntest \"$(git -C \"$FROZEN\" rev-parse HEAD)\" = '983f2aad129270dea4d172bff9441d2195a86d9a'\ntest -z \"$(git -C \"$SOURCE\" status --porcelain --untracked-files=no)\"\ntest -z \"$(git -C \"$FROZEN\" status --porcelain --untracked-files=no)\"\ncd \"$FROZEN\"\nprintf '%s  %s\\n' '${binary_manifest_sha256}' .deps/grammar-receipts/binary-hashes.txt | shasum -a 256 -c -\nprintf '%s  %s\\n' '${input_manifest_sha256}' .deps/grammar-receipts/input-hashes.txt | shasum -a 256 -c -\nshasum -a 256 -c .deps/grammar-receipts/binary-hashes.txt\nshasum -a 256 -c .deps/grammar-receipts/input-hashes.txt\nprintf '%s  %s\\n' 03b74727a860a56338e042c4420bb3f04b2fec5734175f4cb9fa853daf52b7e8 \"$MODEL_DIR/Qwen3.5-9B-Q4_K_M.gguf\" | shasum -a 256 -c -\nmkdir -p \"$JIANYANG_ARTIFACT_DIR\"\nOUTPUT=$(mktemp -d \"$FROZEN/.deps/grammar-process-control.XXXXXX\")\ncp \"$SOURCE/skippy/evals/grammar-sampling/process-control.json\" \"$JIANYANG_ARTIFACT_DIR/\"\n{ git -C \"$SOURCE\" rev-parse HEAD; git rev-parse HEAD; clang++ --version; sw_vers; sysctl -n machdep.cpu.brand_string hw.memsize; } > \"$JIANYANG_ARTIFACT_DIR/identity.txt\"\nshasum -a 256 \"$SOURCE/.deps/grammar-process-control/controller\" \"$SOURCE/skippy/evals/grammar-sampling/process-control.json\" > \"$JIANYANG_ARTIFACT_DIR/controller-hashes.txt\"\n\"$SOURCE/.deps/grammar-process-control/controller\" .deps/grammar-A/grammar-sampling .deps/grammar-C/grammar-sampling \"$MODEL_DIR/Qwen3.5-9B-Q4_K_M.gguf\" \"$FROZEN/.deps/grammar-inputs\" \"$OUTPUT\" \"$SOURCE/skippy/evals/grammar-sampling/process-control.json\" > \"$JIANYANG_ARTIFACT_DIR/measurement.log\" 2>&1\ncp \"$OUTPUT/\"*.json* \"$JIANYANG_ARTIFACT_DIR/\"\ncp .deps/grammar-receipts/*.txt \"$JIANYANG_ARTIFACT_DIR/\"\nshasum -a 256 \"$JIANYANG_ARTIFACT_DIR/\"* > \"$OUTPUT/artifact-hashes.txt\"\ncp \"$OUTPUT/artifact-hashes.txt\" \"$JIANYANG_ARTIFACT_DIR/\"\nprintf 'Fresh-process control retained; no qualification claim\\n'\n",
      "workspace": {
        "repos": [
          {
            "url": "https://github.com/Mesh-LLM/mesh-llm.git",
            "rev": "${evaluator_sha}",
            "path": "controller-source"
          }
        ],
        "retain": "always",
        "build": "set -eu\ncd controller-source\njust grammar-process-control-build \"${retained_workspace}/.deps/llama.cpp/vendor/nlohmann\""
      }
    },
    "harness": {
      "name": "custom",
      "version": "grammar-sampling-independent-process-r7",
      "trace": {
        "kind": "file",
        "ref": "synthetic-tool-grammar-fixed-logits",
        "sha256": "${input_manifest_sha256}"
      },
      "seed": 73,
      "warmup_requests": 3,
      "concurrency": [
        1
      ],
      "request_count": 1,
      "args": {
        "phase": "process-control",
        "fresh_pairs": 24,
        "sampler_repetitions_per_cell": 20
      }
    },
    "budget": {
      "max_usd": 0,
      "max_duration_s": 7200,
      "grace_s": 120
    },
    "retries": 0,
    "labels": {
      "campaign": "max-grammar-sampling-abc-20261028",
      "phase": "process-control",
      "protocol": "7"
    }
  }
}
