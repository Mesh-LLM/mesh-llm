From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Winter <danielwinterw@gmail.com>
Date: Fri, 30 Oct 2026 04:50:30 +1100
Subject: [PATCH] skippy: realize live stage graphs without semantic identities

Every live graph a staged session builds for a new batch shape is the
whole model's graph, sliced to the stage by skippy_select_stage_slice.
That selection also encoded the whole graph's semantics and hashed an
identity for every selected value: 50-70 ms per build for a 64-layer
Qwen3.6-27B on a DGX Spark, against about 1 ms for the selection
itself and 40 ms for the stage's forward. A speculative split rebuilds
whenever its window width changes, so most verify windows paid it
twice per stage, once for the window and once for the decode after it.

Realization reads only the selection: its nodes, frontier, parameters,
request inputs and state effects. The identities serve admission and
planning, which still compute them. skippy_select_live_stage_slice
selects the same slice without them, and realization uses it.
---
 src/skippy/stage_realization.cpp      |  2 +-
 src/skippy/stage_slice_plan.cpp       | 48 +++++++++++++++++++++++----
 src/skippy/stage_slice_plan.h         | 17 ++++++++++
 src/skippy/tests/stage_slice_plan.cpp | 45 +++++++++++++++++++++++++
 4 files changed, 105 insertions(+), 7 deletions(-)

diff --git a/src/skippy/stage_realization.cpp b/src/skippy/stage_realization.cpp
index 32106f7f2..6482cafa6 100644
--- a/src/skippy/stage_realization.cpp
+++ b/src/skippy/stage_realization.cpp
@@ -161,7 +161,7 @@ void skippy_realize_stage_graph(
         return;
     }
     skippy_stage_slice_selection selection;
-    if (!skippy_select_stage_slice(
+    if (!skippy_select_live_stage_slice(
                 result.get_gf(),
                 result.get_block_boundaries(),
                 result.get_state_effects(),
diff --git a/src/skippy/stage_slice_plan.cpp b/src/skippy/stage_slice_plan.cpp
index 75a4da24c..7444a760e 100644
--- a/src/skippy/stage_slice_plan.cpp
+++ b/src/skippy/stage_slice_plan.cpp
@@ -594,7 +594,8 @@ struct selector {
 
 }
 
-bool skippy_select_stage_slice(
+// Encodes the graph's semantics into `semantics` when it is given.
+static bool select_stage_slice(
         ggml_cgraph * graph,
         const std::vector<skippy_block_boundary> & boundaries,
         const std::vector<skippy_state_effect> & state_effects,
@@ -605,7 +606,8 @@ bool skippy_select_stage_slice(
         int32_t layer_end,
         skippy_stage_slice_selection & selection,
         std::string & error,
-        const ggml_tensor * explicit_output) {
+        const ggml_tensor * explicit_output,
+        skippy_graph_semantics * semantics) {
     selection = {};
     error.clear();
     std::vector<skippy_state_effect> effective_state_effects;
@@ -613,9 +615,9 @@ bool skippy_select_stage_slice(
                 state_effects, graph, boundaries, effective_state_effects, error)) {
         return false;
     }
-    skippy_graph_semantics semantics;
-    if (!skippy_build_graph_semantics(
-                graph, boundaries, effective_state_effects, parameters, request_inputs, semantics, error)) {
+    if (semantics != nullptr &&
+            !skippy_build_graph_semantics(
+                graph, boundaries, effective_state_effects, parameters, request_inputs, *semantics, error)) {
         return false;
     }
     selector state(
@@ -634,7 +636,41 @@ bool skippy_select_stage_slice(
     for (const auto & request : request_inputs) {
         state.request_names.emplace(canonical_storage(request.tensor), request.identity);
     }
-    return state.select() && skippy_finalize_stage_slice_identity(semantics, selection, error);
+    return state.select();
+}
+
+bool skippy_select_stage_slice(
+        ggml_cgraph * graph,
+        const std::vector<skippy_block_boundary> & boundaries,
+        const std::vector<skippy_state_effect> & state_effects,
+        const std::vector<skippy_parameter_binding> & parameters,
+        const std::vector<skippy_request_input_binding> & request_inputs,
+        int32_t layer_count,
+        int32_t layer_start,
+        int32_t layer_end,
+        skippy_stage_slice_selection & selection,
+        std::string & error,
+        const ggml_tensor * explicit_output) {
+    skippy_graph_semantics semantics;
+    return select_stage_slice(graph, boundaries, state_effects, parameters, request_inputs, layer_count,
+            layer_start, layer_end, selection, error, explicit_output, &semantics) &&
+            skippy_finalize_stage_slice_identity(semantics, selection, error);
+}
+
+bool skippy_select_live_stage_slice(
+        ggml_cgraph * graph,
+        const std::vector<skippy_block_boundary> & boundaries,
+        const std::vector<skippy_state_effect> & state_effects,
+        const std::vector<skippy_parameter_binding> & parameters,
+        const std::vector<skippy_request_input_binding> & request_inputs,
+        int32_t layer_count,
+        int32_t layer_start,
+        int32_t layer_end,
+        skippy_stage_slice_selection & selection,
+        std::string & error,
+        const ggml_tensor * explicit_output) {
+    return select_stage_slice(graph, boundaries, state_effects, parameters, request_inputs, layer_count,
+            layer_start, layer_end, selection, error, explicit_output, nullptr);
 }
 
 bool skippy_build_guarded_stage_slice_plan(
diff --git a/src/skippy/stage_slice_plan.h b/src/skippy/stage_slice_plan.h
index 2272a3fec..1cb24c7cb 100644
--- a/src/skippy/stage_slice_plan.h
+++ b/src/skippy/stage_slice_plan.h
@@ -107,6 +107,23 @@ bool skippy_select_stage_slice(
         std::string & error,
         const ggml_tensor * explicit_output = nullptr);
 
+// Selects the same slice as skippy_select_stage_slice without its semantic
+// identities. Those are a full-graph encoding and hash that admission and
+// planning compare; a live graph rebuilt for a new batch shape only executes
+// the selection, and encoding it there costs more than the stage's forward.
+bool skippy_select_live_stage_slice(
+        ggml_cgraph * graph,
+        const std::vector<skippy_block_boundary> & boundaries,
+        const std::vector<skippy_state_effect> & state_effects,
+        const std::vector<skippy_parameter_binding> & parameters,
+        const std::vector<skippy_request_input_binding> & request_inputs,
+        int32_t layer_count,
+        int32_t layer_start,
+        int32_t layer_end,
+        skippy_stage_slice_selection & selection,
+        std::string & error,
+        const ggml_tensor * explicit_output = nullptr);
+
 bool skippy_build_guarded_stage_slice_plan(
         const std::vector<skippy_stage_profile_input> & profiles,
         int32_t layer_start,
diff --git a/src/skippy/tests/stage_slice_plan.cpp b/src/skippy/tests/stage_slice_plan.cpp
index 35de1e36c..b7ad7c85e 100644
--- a/src/skippy/tests/stage_slice_plan.cpp
+++ b/src/skippy/tests/stage_slice_plan.cpp
@@ -479,6 +479,51 @@ static int check_middle_stage_selection() {
         ggml_free(ctx);
         return 6;
     }
+    {
+        // Live realization selects the same slice without encoding the
+        // graph's semantic identities.
+        skippy_stage_slice_selection live;
+        if (!skippy_select_live_stage_slice(
+                    graph,
+                    boundaries,
+                    effects,
+                    parameter_bindings,
+                    request_bindings,
+                    3,
+                    1,
+                    2,
+                    live,
+                    error) ||
+                live.source_graph != selection.source_graph ||
+                live.node_indices != selection.node_indices ||
+                live.activation_imports != selection.activation_imports ||
+                live.activation_exports != selection.activation_exports ||
+                live.request_inputs != selection.request_inputs ||
+                live.parameter_identities != selection.parameter_identities ||
+                live.state_effects.size() != selection.state_effects.size()) {
+            std::fprintf(stderr, "live stage selection differs from the planned selection: %s\n", error.c_str());
+            ggml_free(ctx);
+            return 40;
+        }
+        for (size_t index = 0; index < live.state_effects.size(); ++index) {
+            const auto & left = live.state_effects[index];
+            const auto & right = selection.state_effects[index];
+            if (left.kind != right.kind || left.access != right.access || left.layer != right.layer ||
+                    left.storage != right.storage || left.effect_node != right.effect_node ||
+                    left.write_ordinal != right.write_ordinal || left.residency != right.residency) {
+                std::fprintf(stderr, "live stage selection changed a state effect\n");
+                ggml_free(ctx);
+                return 41;
+            }
+        }
+        if (selection.graph_identity.empty() || selection.node_identities.empty() ||
+                !live.graph_identity.empty() || !live.node_identities.empty() ||
+                !live.source_value_identities.empty()) {
+            std::fprintf(stderr, "live stage selection should carry no semantic identities\n");
+            ggml_free(ctx);
+            return 42;
+        }
+    }
 
     if (!skippy_select_stage_slice(
                 graph,
