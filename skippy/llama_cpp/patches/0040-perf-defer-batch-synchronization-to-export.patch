From 177290c7b51e720a90f97a830c6d9d10c3c59117 Mon Sep 17 00:00:00 2001
From: James Dumay <james@generalinference.xyz>
Date: Tue, 17 Nov 2026 12:15:00 +1100
Subject: [PATCH] perf(skippy): synchronize batch iterations only when results
 are consumed

The batch execution path synchronized the CUDA context immediately
after llama_decode, forcing the CPU to idle while the GPU finished.
Move the sync to the export loop and skip it entirely for iterations
that consume no GPU results: prefill chunks that neither sample their
last token, run a causal readout, nor export activation frames return
with the context still pending, so the scheduler prepares and the
backend encodes the next chunk while the GPU executes this one.
Command-queue order sequences the chunks' KV writes and reads.
---
 src/skippy/execution-batch.cpp | 18 +++++++++++++++++-
 1 file changed, 17 insertions(+), 1 deletion(-)

diff --git a/src/skippy/execution-batch.cpp b/src/skippy/execution-batch.cpp
index 83c290ee2..46b0d1a27 100644
--- a/src/skippy/execution-batch.cpp
+++ b/src/skippy/execution-batch.cpp
@@ -464,7 +464,6 @@ enum skippy_status skippy_iteration_batch_sampled(
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
     skippy_mark_context_work_pending(first->stage_model);
-    skippy_synchronize_context_if_pending(first->stage_model);
 
     // exports, readouts and sampling, request by request
     skippy_trace::scope outputs_trace("skippy.batch_outputs", "requests", static_cast<int64_t>(request_count));
@@ -472,6 +471,23 @@ enum skippy_status skippy_iteration_batch_sampled(
     // once every request's outputs are recorded
     std::vector<skippy_sample_request> samples;
     std::vector<size_t> sample_request_indexes;
+    // Synchronize only when this iteration consumes GPU results: a sampled
+    // last token, a causal readout, or a batched activation export. Prefill
+    // chunks without any of those return with the context still pending, so
+    // the scheduler prepares and the backend encodes the next chunk while
+    // the GPU still executes this one; command-queue order sequences the
+    // chunks' KV writes and reads. The Rust sizing protocol always passes a
+    // non-null descriptor array, so gate on the sessions that actually emit
+    // activation frames rather than on the array pointer.
+    const bool consumes_gpu_results = std::any_of(
+            requests, requests + request_count,
+            [](const skippy_iteration_request & request) {
+                return request.sample_last || request.readout != nullptr ||
+                        skippy_emits_activation_frame(request.session);
+            });
+    if (consumes_gpu_results) {
+        skippy_synchronize_context_if_pending(first->stage_model);
+    }
     for (size_t request_index = 0; request_index < request_count; ++request_index) {
         const auto & request = requests[request_index];
         status = skippy_copy_batched_exports(
-- 
