index 000000000..463e53a9d
--- /dev/null
+++ b/src/llama-context-kv-rows.cpp
@@ -0,0 +1,79 @@
+#include "llama-context.h"
+
+#include "llama-graph.h"
+#include "llama-impl.h"
+
+#include <map>
+#include <stdexcept>
+#include <utility>
+
+void llama_context::resolve_fused_kv_rows(
+        const llama_memory_context_i * mctx,
+        uint32_t n_seqs,
+        const skippy_graph_build_inputs & graph_build_inputs) {
+    cparams.fused_kv_rows = false;
+    if (!cparams.flash_attn || !cparams.kv_unified) {
+        return;
+    }
+
+    // Resolve the same one-token-per-owner shape as the upstream row probe,
+    // but compare to actual ordinary attention placement, not weight placement.
+    // In particular --no-kv-offload and filtered stages need not share their
+    // weight layer's device. Only stable backend handles survive the re-reserve.
+    using Key = std::pair<int, uint32_t>;
+    std::map<Key, ggml_backend_t> ordinary;
+    auto reserve = [&]() {
+        if (!graph_reserve(n_seqs, n_seqs, n_seqs, mctx, true, nullptr, graph_build_inputs)) {
+            throw std::runtime_error("failed to reserve graph for Flash Attention over K/V rows check");
+        }
+    };
+    reserve();
+    std::map<int, uint32_t> ordinals;
+    for (const auto & node : get_gf_res_reserve()->get_fused_nodes()) {
+        if (node.op == LLM_FUSED_OP_FLASH_ATTN) {
+            const auto backend = ggml_backend_sched_get_tensor_backend(sched.get(), node.tensor);
+            if (!backend || node.il < 0) {
+                return;
+            }
+            ordinary.emplace(Key{node.il, ordinals[node.il]++}, backend);
+        }
+    }
+    if (ordinary.empty()) {
+        return;
+    }
+
+    try {
+        cparams.fused_kv_rows = true;
+        reserve();
+        ordinals.clear();
+        size_t observed = 0, row_nodes = 0;
+        bool same_backends = true;
+        for (const auto & node : get_gf_res_reserve()->get_fused_nodes()) {
+            if (node.op != LLM_FUSED_OP_FLASH_ATTN && node.op != LLM_FUSED_OP_FLASH_ATTN_KV_ROWS) {
+                continue;
+            }
+            const Key key{node.il, ordinals[node.il]++};
+            const auto previous = ordinary.find(key);
+            const auto actual = ggml_backend_sched_get_tensor_backend(sched.get(), node.tensor);
+            same_backends &= previous != ordinary.end() && actual && previous->second == actual;
+            row_nodes += node.op == LLM_FUSED_OP_FLASH_ATTN_KV_ROWS;
+            ++observed;
