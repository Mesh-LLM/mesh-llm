diff --git a/src/llama-kv-rows.cpp b/src/llama-kv-rows.cpp
new file mode 100644
index 000000000..57608f5ae
--- /dev/null
+++ b/src/llama-kv-rows.cpp
@@ -0,0 +1,101 @@
+#include "llama-kv-cache.h"
+
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <set>
+
+uint32_t llama_kv_cache::get_n_kv_slices(const llama_ubatch & ubatch) {
+    if (!ubatch.n_tokens || !ubatch.n_seqs_unq || !ubatch.n_seq_id || !ubatch.seq_id ||
+            !ubatch.seq_id_unq || ubatch.decision_order) {
+        return 0;
+    }
+    uint32_t slices = 0;
+    if (ubatch.n_seqs_unq == 1) {
+        slices = 1;
+    } else if (ubatch.equal_seqs() && ubatch.n_seqs == ubatch.n_seqs_unq) {
+        slices = ubatch.n_seqs;
+    } else if (ubatch.n_tokens == ubatch.n_seqs_unq) {
+        slices = ubatch.n_tokens;
+    }
+    if (!slices || ubatch.n_tokens % slices != 0) {
+        return 0;
+    }
+    // Query blocks determine stream order, not seq_id_unq's enumeration order.
+    const uint32_t per_slice = ubatch.n_tokens / slices;
+    std::set<llama_seq_id> actual, expected;
+    for (uint32_t s = 0; s < ubatch.n_seqs_unq; ++s) {
+        expected.insert(ubatch.seq_id_unq[s]);
+    }
+    for (uint32_t s = 0; s < slices; ++s) {
+        const uint32_t first = s * per_slice;
+        if (ubatch.n_seq_id[first] != 1 || !ubatch.seq_id[first]) {
+            return 0;
+        }
+        const auto owner = ubatch.seq_id[first][0];
+        if (owner < 0 || owner >= LLAMA_MAX_SEQ || !actual.insert(owner).second) {
+            return 0;
+        }
+        for (uint32_t i = first; i < first + per_slice; ++i) {
+            if (ubatch.n_seq_id[i] != 1 || !ubatch.seq_id[i] || ubatch.seq_id[i][0] != owner) {
+                return 0;
+            }
+        }
+    }
+    return actual == expected ? slices : 0;
+}
+
+std::vector<llama_pos> llama_kv_cache::get_kv_rows_p_min(const llama_ubatch & ubatch, uint32_t n_slices) const {
+    if (!n_swa || (swa_type != LLAMA_SWA_TYPE_STANDARD && swa_type != LLAMA_SWA_TYPE_CHUNKED)) {
+        return {};
+    }
+    GGML_ASSERT(n_slices && ubatch.pos && ubatch.n_tokens % n_slices == 0);
+    const uint32_t per_slice = ubatch.n_tokens / n_slices;
+    std::vector<llama_pos> result(n_slices);
+    for (uint32_t s = 0; s < n_slices; ++s) {
+        const auto * begin = ubatch.pos + s * per_slice;
+        const llama_pos minimum = *std::min_element(begin, begin + per_slice);
+        result[s] = swa_type == LLAMA_SWA_TYPE_STANDARD ? minimum - (llama_pos) n_swa + 1 :
+                (minimum / (llama_pos) n_swa) * (llama_pos) n_swa;
+    }
+    return result;
+}
+
+uint32_t llama_kv_cache::get_n_kv_rows(const llama_ubatch & ubatch) const {
+    const uint32_t slices = get_n_kv_slices(ubatch);
+    if (n_stream != 1 || !slices) {
+        return 0;
+    }
+    const auto & cells = v_cells[0];
+    const auto minimum = get_kv_rows_p_min(ubatch, slices);
+    const uint32_t per_slice = ubatch.n_tokens / slices;
+    uint32_t maximum = 0;
+    for (uint32_t s = 0; s < slices; ++s) {
+        const auto owner = ubatch.seq_id[s * per_slice][0];
+        const auto count = minimum.empty() ? cells.seq_n_cells(owner) : cells.seq_n_cells(owner, minimum[s]);
+        maximum = std::max(maximum, count);
+    }
+    return std::min(GGML_PAD(maximum, 256u), get_size());
+}
+
+void llama_kv_cache::set_input_kv_rows(ggml_tensor * rows, const llama_ubatch * ubatch) const {
+    GGML_ASSERT(rows && rows->buffer && ggml_backend_buffer_is_host(rows->buffer));
+    GGML_ASSERT(n_stream == 1 && rows->type == GGML_TYPE_I32 && ggml_is_contiguous(rows));
+    const uint32_t slices = get_n_kv_slices(*ubatch);
+    GGML_ASSERT(slices && rows->ne[1] == slices && rows->ne[2] == 1 && rows->ne[3] == 1);
+    const uint32_t per_slice = ubatch->n_tokens / slices;
+    std::vector<llama_seq_id> owners(slices);
+    for (uint32_t s = 0; s < slices; ++s) {
+        owners[s] = ubatch->seq_id[s * per_slice][0];
+    }
+    v_cells[0].get_seq_cells(owners, get_kv_rows_p_min(*ubatch, slices),
+            static_cast<int32_t *>(rows->data), rows->ne[0]);
+}
+
+uint32_t llama_kv_cache_context::get_n_kv_rows() const {
+    return n_kv_rows;
+}
+
+void llama_kv_cache_context::set_input_kv_rows(ggml_tensor * rows, const llama_ubatch * ubatch) const {
+    kv->set_input_kv_rows(rows, ubatch);
+}
