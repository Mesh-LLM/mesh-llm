+void llm_graph_context::request_input(ggml_tensor * tensor, const char * identity) const {
+    if (tensor != nullptr) {
+        const uint32_t ordinal = res->request_input_ordinals[identity]++;
+        res->request_input_bindings.push_back({tensor, std::string(identity) + "." + std::to_string(ordinal)});
+    }
