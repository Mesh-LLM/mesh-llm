+/** @brief The parts of a stage checkpoint. */
+enum skippy_checkpoint_part {
+    SKIPPY_CHECKPOINT_PART_KV_PAGE = 1 << 0,
+    SKIPPY_CHECKPOINT_PART_RECURRENT = 1 << 1,
+};
+
+/** @brief Returns the skippy_checkpoint_part bits a checkpoint of this stage carries.
+ * The parts follow the stage's layers rather than its model family: a hybrid
+ * model's stage holding no attention layers is checkpointed by its recurrent
+ * state alone. Zero means only full state checkpoints the stage.
+ */
+LLAMA_API uint32_t skippy_model_checkpoint_parts(const struct skippy_model * model);
+
+/** @brief One stage checkpoint, in the parts skippy_model_checkpoint_parts names. */
+struct skippy_checkpoint_view {
+    /** The KV page, or null when the checkpoint has no KV page part. */
+    const struct skippy_kv_page_desc * page;
+    const void * page_payload;
+    size_t page_payload_bytes;
+    /** skippy_export_recurrent_state's bytes, or none when the checkpoint has no recurrent part. */
+    const void * recurrent;
+    size_t recurrent_bytes;
+    /** The position the checkpoint resumes from. */
+    uint64_t token_count;
+    /** The token history, token_count long, or null to leave it empty. */
+    const llama_token * tokens;
+};
+
+/** @brief Imports a checkpoint into a fresh session whole, or leaves the session empty.
+ * The checkpoint must carry exactly the parts the stage needs, and its KV page
+ * must end at token_count. The page goes in first, then the recurrent state,
+ * the position and the token history; any failure empties the sequence again.
+ */
+LLAMA_API enum skippy_status skippy_import_checkpoint(
+        struct skippy_session * session,
+        const struct skippy_checkpoint_view * checkpoint,
+        struct skippy_error ** out_error);
+
 /** @brief Trims the session's token history and associated state. */
 LLAMA_API enum skippy_status skippy_trim_session(
         struct skippy_session * session,
