@@ -31,6 +32,28 @@ llama_memory_t attention_memory(llama_memory_t memory) {
     return skippy_memory_recurrent_adapter(memory) ? nullptr : memory;
 }
 
+// A hybrid stage whose layer range holds no attention layers keeps attention
+// cells with no rows; its recurrent state checkpoints it alone.
+bool holds_attention_rows(llama_memory_t memory) {
+    auto * attention = attention_memory(memory);
+    if (auto * iswa = dynamic_cast<llama_kv_cache_iswa *>(attention)) {
+        return !iswa->get_base()->get_layer_ids().empty() || !iswa->get_swa()->get_layer_ids().empty();
+    }
+    if (auto * kv = dynamic_cast<llama_kv_cache *>(attention)) {
+        return !kv->get_layer_ids().empty();
+    }
+    return attention != nullptr;
+}
+
+const char * describe_parts(uint32_t parts) {
+    switch (parts) {
+        case SKIPPY_CHECKPOINT_PART_KV_PAGE | SKIPPY_CHECKPOINT_PART_RECURRENT: return "a KV page and recurrent state";
+        case SKIPPY_CHECKPOINT_PART_KV_PAGE: return "a KV page alone";
+        case SKIPPY_CHECKPOINT_PART_RECURRENT: return "recurrent state alone";
+        default: return "no parts";
+    }
+}
+
 skippy_status validate_session(skippy_session * session, int32_t cache_seq_id,
         skippy_error ** error) {
     if (!session || !session->ctx || !session->stage_model || !session->ctx->get_memory()) {
@@ -375,10 +398,82 @@ enum skippy_status skippy_import_recurrent_state(skippy_session * session, const
         if (reader.n_bytes() != bytes) {
             throw std::runtime_error("recurrent checkpoint has trailing data");
         }
+        auto * memory = session->ctx->get_memory();
+        if (holds_attention_rows(memory)
+                && attention_memory(memory)->seq_pos_max(session->seq_id) != recurrent->seq_pos_max(session->seq_id)) {
+            memory->seq_rm(session->seq_id, -1, -1);
+            skippy_session_set_position(session, 0, nullptr);
+            skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                    "recurrent state does not end where the session's attention cells do; import its KV page first");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
         return skippy_success(error);
     } catch (const std::exception & exception) { return native_error(error, exception); }
 }
 
+uint32_t skippy_model_checkpoint_parts(const skippy_model * model) {
+    if (!model || !model->ctx || !model->ctx->get_memory()
+            || !(skippy_model_memory_cache_capabilities(model) & SKIPPY_MEMORY_CACHE_KV_RECURRENT)) {
+        return 0;
+    }
+    auto * memory = model->ctx->get_memory();
+    return (holds_attention_rows(memory) ? SKIPPY_CHECKPOINT_PART_KV_PAGE : 0u)
+            | (skippy_memory_recurrent_adapter(memory) ? SKIPPY_CHECKPOINT_PART_RECURRENT : 0u);
+}
+
+enum skippy_status skippy_import_checkpoint(skippy_session * session,
+        const skippy_checkpoint_view * checkpoint, skippy_error ** error) {
+    if (!session || !session->ctx || !session->stage_model || !session->ctx->get_memory() || !checkpoint
+            || (checkpoint->page && !checkpoint->page_payload)
+            || (checkpoint->recurrent_bytes && !checkpoint->recurrent)) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "session and checkpoint are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const uint32_t needed = skippy_model_checkpoint_parts(session->stage_model);
+    if (!needed) {
+        skippy_set_error(error, SKIPPY_STATUS_UNSUPPORTED, "only full state checkpoints this stage");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    const uint32_t carried = (checkpoint->page ? SKIPPY_CHECKPOINT_PART_KV_PAGE : 0u)
+            | (checkpoint->recurrent_bytes ? SKIPPY_CHECKPOINT_PART_RECURRENT : 0u);
+    if (carried != needed) {
+        const std::string message = std::string("this stage is checkpointed by ") + describe_parts(needed)
+                + ", but the checkpoint carries " + describe_parts(carried);
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, message.c_str());
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (session->n_past != 0) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "a checkpoint is imported into a fresh session");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (checkpoint->token_count > static_cast<uint64_t>(std::numeric_limits<int32_t>::max())
+            || (checkpoint->page
+                && checkpoint->page->token_start + checkpoint->page->token_count != checkpoint->token_count)) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "the checkpoint's KV page must end at its position");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const auto empty_again = [&](skippy_status status) {
+        session->ctx->get_memory()->seq_rm(session->seq_id, -1, -1);
+        skippy_session_set_position(session, 0, nullptr);
+        return status;
+    };
+    if (checkpoint->page) {
+        const auto status = skippy_import_kv_page(session, checkpoint->page, checkpoint->page_payload,
+                checkpoint->page_payload_bytes, error);
+        if (status != SKIPPY_STATUS_OK) { return empty_again(status); }
+    }
+    if (checkpoint->recurrent_bytes) {
+        const auto status = skippy_import_recurrent_state(session, checkpoint->recurrent,
+                checkpoint->recurrent_bytes, error);
+        if (status != SKIPPY_STATUS_OK) { return empty_again(status); }
+    }
+    auto status = skippy_session_set_position(session, static_cast<int32_t>(checkpoint->token_count), error);
+    if (status == SKIPPY_STATUS_OK && checkpoint->tokens) {
+        status = skippy_session_restore_token_history(session, checkpoint->tokens, checkpoint->token_count, error);
+    }
+    return status == SKIPPY_STATUS_OK ? status : empty_again(status);
+}
