+        ggml_backend_buffer_t buf = ctxs_bufs.emplace(std::move(ctx), buft, "kv cache", /*clear =*/ false);
 
         LLAMA_LOG_INFO("%s: %10s KV buffer size = %8.2f MiB\n", __func__, ggml_backend_buffer_name(buf), ggml_backend_buffer_get_size(buf)/1024.0/1024.0);
     }
 
+    // The cells are zeroed as they come into use instead of all at once here (see
+    // clear_cells_through). That needs a cell range to be one byte range of each tensor, which a
+    // transposed V is not, and buffers that can zero a range. One decision covers every buffer:
+    // a pool cleared lazily in part would leave the rest never zeroed.
+    // A cache that shares the cells of another one applies no ubatch of its own, so nothing would
+    // zero its tensors later; it skips the clear only where fresh memory already reads as zeros.
+    {
+        const bool by_range = !v_trans && !no_alloc &&
+            std::all_of(cell_tensors.begin(), cell_tensors.end(), [](const ggml_tensor * t) {
+                return ggml_backend_buffer_has_memset(t->buffer);
+            });
+        const bool starts_zeroed = std::all_of(ctxs_bufs.begin(), ctxs_bufs.end(), [](const auto & ctx_buf) {
+            return kv_buffer_starts_zeroed(ctx_buf.second.get());
+        });
+
+        clear_lazily = by_range && !other;
+
+        if (!clear_lazily && !(by_range && starts_zeroed)) {
+            for (auto & [_, buf] : ctxs_bufs) {
+                ggml_backend_buffer_clear(buf.get(), 0);
+            }
+        }
+    }
+
     {
         const size_t memory_size_k     = size_k_bytes();
         const size_t memory_size_v     = size_v_bytes();
@@ -465,9 +503,37 @@ void llama_kv_cache::clear(bool data) {
         for (auto & [_, buf] : ctxs_bufs) {
             ggml_backend_buffer_clear(buf.get(), 0);
         }
+        cells_cleared = get_size();
     }
 }
 
+void llama_kv_cache::clear_cells_through(uint32_t cell) {
+    if (!clear_lazily || cell < cells_cleared) {
+        return;
+    }
+    // attention reads the cells below get_n_kv(), which pads the highest cell in use to a multiple of
+    // kv_clear_step, so the mark advances in the same steps
+    const uint32_t upto = std::min<uint32_t>(get_size(), GGML_PAD(cell + 1, kv_clear_step));
+    skippy_trace::scope trace("llama.kv_clear_cells", "cells", (int64_t) (upto - cells_cleared));
+    // [row, cell, stream]: a cell range of one stream is contiguous
+    for (ggml_tensor * t : cell_tensors) {
+        for (uint32_t s = 0; s < n_stream; ++s) {
+            ggml_backend_tensor_memset(t, 0, s*t->nb[2] + (size_t) cells_cleared*t->nb[1], (size_t) (upto - cells_cleared)*t->nb[1]);
+        }
+    }
+    cells_cleared = upto;
+}
+
+void llama_kv_cache::clear_eagerly() {
+    if (!clear_lazily) {
+        return;
+    }
+    if (get_size() > 0) {
+        clear_cells_through(get_size() - 1);
+    }
+    clear_lazily = false;
+}
+
 bool llama_kv_cache::seq_rm(llama_seq_id seq_id, llama_pos p0, llama_pos p1) {
     skippy_trace::scope trace("llama.kv_seq_rm", "seq", seq_id);
