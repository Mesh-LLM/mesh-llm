+// Whether a buffer of this kind reads as zeros until something is written to it. Metal hands out
+// zero-filled buffers; host memory from an allocator may be recycled, and device memory elsewhere
+// starts undefined.
+static bool kv_buffer_starts_zeroed(ggml_backend_buffer_t buf) {
+    const char * name = ggml_backend_buffer_name(buf);
+    return strncmp(name, "MTL", 3) == 0 && name[3] != '\0' && strspn(name + 3, "0123456789") == strlen(name + 3);
+}
