     assert(ubatch.n_tokens == sinfo.n_stream()*sinfo.size());
 
+    // every cell this ubatch writes, and so every cell attention may read, lies below the mark
+    for (const auto & idxs : sinfo.idxs) {
+        const auto top = std::max_element(idxs.begin(), idxs.end());
+        if (top != idxs.end()) {
+            clear_cells_through(*top);
+        }
+    }
+
     for (uint32_t s = 0; s < sinfo.n_stream(); ++s) {
         for (uint32_t ii = 0; ii < sinfo.size(); ++ii) {
             const uint32_t i = s*sinfo.size() + ii;
diff --git a/src/llama-kv-cache.h b/src/llama-kv-cache.h
index 2be616364..5e4dd63cb 100644
--- a/src/llama-kv-cache.h
+++ b/src/llama-kv-cache.h
@@ -282,6 +282,21 @@ public:
     std::vector<uint32_t> find_chunked_cells(
             const llama_ubatch & ubatch, const llama_kv_cells & cells, uint32_t head_cur) const;
 
+    // Cells are zeroed as the pool's high-water mark advances, not all at creation: attention
+    // reads nothing above the cells get_n_kv() covers, and a page never written costs no memory.
+    // Cells below `cells_cleared` in every stream hold zeros or data. A layout or a buffer that
+    // cannot zero a cell range clears at creation instead, and a cache sharing another's cells
+    // keeps no mark (see the constructor).
+    static constexpr uint32_t kv_clear_step = 256; // the padding of get_n_kv()
+    uint32_t cells_cleared = 0;
+    bool     clear_lazily  = false;
+    void clear_cells_through(uint32_t cell);
+    // zero every cell now, as llama.cpp does at creation, and stop zeroing them lazily
+    void clear_eagerly();
+
+    // the K, V and K_idx tensors this cache allocated; a layer shared with another cache has none here
+    std::vector<ggml_tensor *> cell_tensors;
+
     // emplace the ubatch context into slot: [sinfo.idxs[0...ubatch.n_tokens - 1]]
     void apply_ubatch(const slot_info & sinfo, const llama_ubatch & ubatch);
 
