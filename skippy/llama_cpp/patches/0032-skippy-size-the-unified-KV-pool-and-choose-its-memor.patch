+// Every attention cache a memory owns, composite memories included.
+static std::vector<llama_kv_cache *> skippy_memory_attention_caches(llama_memory_t memory) {
+    if (auto * dsa = dynamic_cast<llama_kv_cache_dsa *>(memory)) {
+        return { dsa->get_mla(), dsa->get_lid() };
+    }
+    if (auto * iswa = skippy_memory_iswa_adapter(memory)) {
+        return { iswa->get_base(), iswa->get_swa() };
+    }
+    if (auto * kv = skippy_memory_kv_adapter(memory)) {
+        return { kv };
+    }
+    return {};
+}
+
+void skippy_apply_kv_memory_config(llama_memory_t memory, const skippy_runtime_config * config) {
+    if (memory == nullptr || config == nullptr) {
+        return;
+    }
+    // AUTO takes what a cache supports, so only FALSE changes its choice.
+    const bool lazy_clear    = config->kv_lazy_clear    != SKIPPY_TRISTATE_FALSE;
+    const bool release_pages = config->kv_release_pages != SKIPPY_TRISTATE_FALSE;
+    const std::vector<llama_kv_cache *> caches = skippy_memory_attention_caches(memory);
+    std::for_each(caches.begin(), caches.end(), [&](llama_kv_cache * cache) {
+        if (cache == nullptr) {
+            return;
+        }
+        if (!lazy_clear) {
+            cache->clear_eagerly();
+        }
+        cache->set_page_release(release_pages);
+    });
+}
+
 llama_kv_cache_iswa * skippy_memory_iswa_adapter(llama_memory_t memory) {
     if (auto * iswa = dynamic_cast<llama_kv_cache_iswa *>(memory)) {
         return iswa;
@@ -107,6 +143,10 @@ uint32_t skippy_graph_cache_capabilities(const llm_graph_result & result) {
     return supported;
 }
 
+extern "C" uint32_t skippy_model_kv_pool_cells(const skippy_model * model) {
+    return model && model->ctx ? model->ctx->n_ctx() : 0;
+}
