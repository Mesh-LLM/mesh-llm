+    /** @brief Whether chunks of free KV cells hand their pages back to the kernel. AUTO and TRUE release wherever cells are zeroed lazily and the pool's memory is host-visible; FALSE keeps the pages. */
+    int32_t kv_release_pages;
+    /** @brief Whether attention reads a unified pool through per-owner row lists. AUTO and TRUE use row lists wherever the backend supports them; FALSE keeps ordinary attention over the whole pool, to measure one against the other. */
+    int32_t kv_row_attention;
