From 05c37270582f612516216f857b33089c2233b696 Mon Sep 17 00:00:00 2001
From: Virgile-pct <222121099+Virgile-pct@users.noreply.github.com>
Date: Fri, 9 Oct 2026 13:47:42 +0200
Subject: [PATCH] ggml: size the scheduler split context for the graph being
 split

ggml_backend_sched_new allocates the split context for one split per node
of the largest graph the scheduler accepts: graph_size *
GGML_SCHED_MAX_SPLIT_INPUTS * 2 tensors, about 20 KB per node. llama sizes
graph_size from the model's tensor count, so every llama context allocates
about 0.6 MiB per model tensor (298 MiB for a 484-tensor model), and almost
none of it is ever touched. Linux only charges a process for the pages it
touches. Windows charges every allocated byte against the commit limit, so
the Skippy stage planner, which keeps a llama context per execution
profile for every plan, runs out of commit on large models.

Allocate the split context in ggml_backend_sched_split_graph instead,
sized for the graph being split with the same bound (at most one split per
node or leaf), and grow it the way sched->graph already grows when a larger
graph comes. The context is rebuilt at that point, so nothing still points
into the old buffer.
---
 ggml/src/ggml-backend.cpp | 25 +++++++++++++++++++++----
 1 file changed, 21 insertions(+), 4 deletions(-)

diff --git a/ggml/src/ggml-backend.cpp b/ggml/src/ggml-backend.cpp
index 20bf96501..ecc9ca6f1 100644
--- a/ggml/src/ggml-backend.cpp
+++ b/ggml/src/ggml-backend.cpp
@@ -1069,14 +1069,30 @@ void ggml_backend_sched_split_graph(ggml_backend_sched_t sched, struct ggml_cgra
     sched->n_graph_inputs = 0;
     sched->is_reset = false;
 
+    ggml_free(sched->ctx);
+
+    // The split context holds the copies of split inputs. Size it for the graph
+    // being split rather than for the largest graph the scheduler accepts: the
+    // same bound, at most one split per tensor, but the capacity-based worst case
+    // is allocated up front and almost never touched, and on Windows every
+    // allocated byte counts against the commit limit. Grow only, like
+    // sched->graph below; the context is rebuilt here, so nothing points into
+    // the old buffer.
+    const size_t max_splits = (size_t) std::max(graph->n_nodes + graph->n_leafs, 1);
+    const size_t context_buffer_size = max_splits*GGML_SCHED_MAX_SPLIT_INPUTS*2*sizeof(struct ggml_tensor) +
+        ggml_graph_overhead_custom(graph->size, false);
+    if (sched->context_buffer_size < context_buffer_size) {
+        free(sched->context_buffer);
+        sched->context_buffer = (char *) malloc(context_buffer_size);
+        sched->context_buffer_size = context_buffer_size;
+    }
+
     struct ggml_init_params params = {
         /* .mem_size =   */ sched->context_buffer_size,
         /* .mem_buffer = */ sched->context_buffer,
         /* .no_alloc =   */ true
     };
 
-    ggml_free(sched->ctx);
-
     sched->ctx = ggml_init(params);
     if (sched->ctx == NULL) {
         GGML_ABORT("%s: failed to initialize context\n", __func__);
@@ -1887,8 +1903,9 @@ ggml_backend_sched_t ggml_backend_sched_new(
     sched->debug_graph_size = 0;
     sched->debug_prev_graph_size = 0;
 
-    sched->context_buffer_size = ggml_sched_max_splits*GGML_SCHED_MAX_SPLIT_INPUTS*2*sizeof(struct ggml_tensor) + ggml_graph_overhead_custom(graph_size, false);
-    sched->context_buffer = (char *) malloc(sched->context_buffer_size);
+    // sized by ggml_backend_sched_split_graph for the graph it splits
+    sched->context_buffer_size = 0;
+    sched->context_buffer = NULL;
 
     const int initial_splits_capacity = 16;
     sched->splits = (ggml_backend_sched_split *) calloc(initial_splits_capacity, sizeof(sched->splits[0]));
-- 
