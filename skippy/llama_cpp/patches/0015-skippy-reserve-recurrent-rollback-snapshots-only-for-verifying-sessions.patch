From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Winter <danielwinterw@gmail.com>
Date: Wed, 28 Oct 2026 14:17:38 +1100
Subject: [PATCH] skippy: reserve recurrent rollback snapshots only for
 verifying sessions

Recurrent and hybrid models opened with at least two rollback snapshots
per sequence (n_rs_seq), so a verify window could rewind in place instead
of restoring a host checkpoint. Every decode step then wrote each
recurrent layer's conv state once per snapshot group whether or not the
session ever verified drafts: 48 extra copies in every Qwen3.5-4B decode
graph.

skippy_runtime_config.verify_rollback_tokens now says how many trailing
tokens a verify window may rewind in place; 0 reserves no snapshots and
verify windows restore a checkpoint instead. skippy_runtime_config_default
and a load without a config keep SKIPPY_VERIFY_ROLLBACK_TOKENS_DEFAULT,
the two snapshots every load reserved before.

Sampled verify also gets cheaper: a sampling chain retired by sampled verify
stays retired until the session resets, and upstream's per-sequence
backend-sampling output limit is restored.
---
 include/skippy/runtime.h     | 7 +++++++
 src/llama-context.cpp        | 7 ++++---
 src/skippy/model_loading.cpp | 5 ++++-
 src/skippy/sampling.cpp      | 4 +++-
 src/skippy/session.cpp       | 1 +
 5 files changed, 19 insertions(+), 5 deletions(-)

diff --git a/include/skippy/runtime.h b/include/skippy/runtime.h
index bc4da9a07..b570682ef 100644
--- a/include/skippy/runtime.h
+++ b/include/skippy/runtime.h
@@ -123,6 +123,12 @@ struct skippy_runtime_config {
     int32_t host_expert_layer_start;
     /** @brief One past the last such block index. `host_expert_layer_end <= host_expert_layer_start` keeps every routed expert on the accelerator, and a range wider than 4096 blocks is ignored the same way: no supported model approaches that block count, and the bound keeps override construction proportional to the model. Routing and precision are unchanged; only weight placement differs. */
     int32_t host_expert_layer_end;
+
+    /** @brief Trailing tokens a verify window may rewind recurrent and hybrid state by in place; 0 when the session never verifies drafts. Each one keeps another snapshot of every recurrent state, which every decode step writes. */
+    uint32_t verify_rollback_tokens;
 };
+
+/** @brief The verify_rollback_tokens of skippy_runtime_config_default, and of a load without a config. */
+#define SKIPPY_VERIFY_ROLLBACK_TOKENS_DEFAULT 2
 
 /** @brief Returns a C-safe runtime configuration with all derived-default controls set to auto. */
 LLAMA_API struct skippy_runtime_config skippy_runtime_config_default(void);
diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 4d198295f..b5b6d0670 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2019,9 +2019,10 @@ int llama_context::decode(
                 // are limited to one output row; a sampler on some other
                 // sequence of this context must not reject a multi-output
                 // batch (e.g. speculative verification) for this one.
-                if (seq_output_count[seq_id] > 1 && sampling.samplers.count(seq_id) > 0) {
-                    LLAMA_LOG_ERROR("%s: backend sampling requires at most one output token per sequence (seq_id %d had %d)\n",
-                            __func__, seq_id, seq_output_count[seq_id]);
+                if (sampling.samplers.count(seq_id) > 0 &&
+                        seq_output_count[seq_id] > (int32_t) cparams.n_outputs_max_per_seq) {
+                    LLAMA_LOG_ERROR("%s: backend sampling supports at most %u outputs per sequence (seq_id %d had %d)\n",
+                            __func__, cparams.n_outputs_max_per_seq, seq_id, seq_output_count[seq_id]);
                     return -1;
                 }
             }
diff --git a/src/skippy/model_loading.cpp b/src/skippy/model_loading.cpp
index 7305cc529..db5a69e38 100644
--- a/src/skippy/model_loading.cpp
+++ b/src/skippy/model_loading.cpp
@@ -590,6 +590,7 @@ struct skippy_runtime_config skippy_runtime_config_default(void) {
     config.swa_full = SKIPPY_TRISTATE_AUTO;
     config.op_offload = SKIPPY_TRISTATE_AUTO;
     config.split_mode = SKIPPY_TRISTATE_AUTO;
+    config.verify_rollback_tokens = SKIPPY_VERIFY_ROLLBACK_TOKENS_DEFAULT;
     return config;
 }
 
@@ -733,7 +734,8 @@ enum skippy_status skippy_finish_model_open(
     }
     if (llm_arch_is_recurrent(model->arch) || llm_arch_is_hybrid(model->arch)) {
         params.n_seq_max = std::max<uint32_t>(params.n_seq_max, std::max<uint32_t>(2, stage_model->lane_count * 2));
-        params.n_rs_seq = std::max<uint32_t>(params.n_rs_seq, 2);
+        params.n_rs_seq = std::max<uint32_t>(params.n_rs_seq,
+                config != nullptr ? config->verify_rollback_tokens : SKIPPY_VERIFY_ROLLBACK_TOKENS_DEFAULT);
         params.kv_unified = true;
     }
     // Multi-lane activation exports rely on the shared KV pool's batch order.
diff --git a/src/skippy/sampling.cpp b/src/skippy/sampling.cpp
index 6a1352271..b688fce73 100644
--- a/src/skippy/sampling.cpp
+++ b/src/skippy/sampling.cpp
@@ -325,7 +325,9 @@ void skippy_clear_chat_sampling(skippy_session * session) {
     session->sampling_has_reasoning_budget = false;
     session->grammar_lazy = false;
     session->sampling_backend_enabled = false;
-    session->sampling_backend_retired = false;
+    // A chain retired by sampled verification stays retired until
+    // the session is reset, so speculative repair does not re-attach a backend
+    // sampler that the next verify window must detach (two reserves per window).
     session->sampling_config = {};
     session->sampling_config_valid = false;
     session->chat_sampling_metadata.clear();
diff --git a/src/skippy/session.cpp b/src/skippy/session.cpp
index 36c972d92..4741f55cb 100644
--- a/src/skippy/session.cpp
+++ b/src/skippy/session.cpp
@@ -390,6 +390,7 @@ enum skippy_status skippy_session_reset(
             skippy_env_enabled("SKIPPY_DETACH_SAMPLER_ON_RESET");
     if (detach_sampler_on_reset || !skippy_reset_reusable_sampling(session)) {
         skippy_clear_chat_sampling(session);
+        session->sampling_backend_retired = false;
     }
     skippy_mtp_clear_session_state(session);
     session->sampling_backend_verifying = false;
-- 
