+    void load_arch_hparams(llama_model_loader &) override {}
+    void load_arch_tensors(llama_model_loader &) override {}
+    std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params &) const override { return nullptr; }
+};
+
+static void iswa_row_require(bool condition, const char * message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+static llama_ubatch iswa_row_batch(uint32_t per_owner, llama_pos first, bool two_owners) {
+    llama_ubatch batch = {};
+    batch.b_equal_seqs = 1;
+    batch.n_seq_tokens = per_owner;
+    batch.n_seqs = batch.n_seqs_unq = two_owners ? 2 : 1;
+    batch.n_tokens = per_owner * batch.n_seqs;
+    batch.n_pos = 1;
+    batch.data = std::make_shared<llama_ubatch::data_t>();
+    auto & data = *batch.data;
+    data.token.assign(batch.n_tokens, 1);
+    data.pos.resize(batch.n_tokens);
+    data.n_seq_id.assign(batch.n_tokens, 1);
+    data.seq_id_data.resize(batch.n_tokens);
+    data.seq_id.resize(batch.n_tokens);
+    data.seq_id_unq = two_owners ? std::vector<llama_seq_id>{0, 1} : std::vector<llama_seq_id>{0};
+    data.output.assign(batch.n_tokens, 1);
+    data.seq_idx.assign(LLAMA_MAX_SEQ, -1);
+    for (uint32_t i = 0; i < batch.n_seqs_unq; ++i) data.seq_idx[data.seq_id_unq[i]] = i;
+    for (uint32_t i = 0; i < batch.n_tokens; ++i) {
+        // Deliberately different from seq_id_unq order: Q blocks own stream order.
+        data.seq_id_data[i] = two_owners ? 1 - i/per_owner : 0;
+        data.seq_id[i] = &data.seq_id_data[i];
+        data.pos[i] = first + i%per_owner;
+    }
+    batch.token = data.token.data();
+    batch.pos = data.pos.data();
+    batch.n_seq_id = data.n_seq_id.data();
+    batch.seq_id = data.seq_id.data();
+    batch.seq_id_unq = data.seq_id_unq.data();
+    batch.output = data.output.data();
+    batch.seq_idx = data.seq_idx.data();
+    return batch;
+}
+
+static std::unique_ptr<llama_kv_cache_iswa_context> iswa_row_apply(
+        llama_kv_cache_iswa & cache, const llama_ubatch & batch) {
+    auto base = cache.get_base()->prepare({batch});
+    auto swa = cache.get_swa()->prepare({batch});
+    iswa_row_require(base.size() == 1 && swa.size() == 1, "ISWA prepare both pools");
+    auto context = std::make_unique<llama_kv_cache_iswa_context>(
+            &cache, std::move(base), std::move(swa), std::vector<llama_ubatch>{batch});
+    iswa_row_require(context->apply(), "ISWA apply both pools");
+    return context;
+}
+
+static void iswa_row_check_pool(
+        const llama_kv_cache & cache, const llama_ubatch & batch,
+        const ggml_tensor * rows, const ggml_tensor * mask, bool swa) {
+    iswa_row_require(rows && mask && rows->buffer && mask->buffer, "ISWA both live inputs allocated");
+    iswa_row_require(rows->type == GGML_TYPE_I32 && rows->ne[0] >= 256 && rows->ne[0] % 256 == 0 && rows->ne[1] == 2 &&
+            mask->type == GGML_TYPE_F16 && mask->ne[0] == rows->ne[0] && mask->ne[1] == 2 && mask->ne[3] == 2,
+            "ISWA row/mask geometry");
+    const uint32_t width = static_cast<uint32_t>(rows->ne[0]);
+    const auto * actual_rows = static_cast<const int32_t *>(rows->data);
+    const auto * actual_mask = static_cast<const ggml_fp16_t *>(mask->data);
+    for (uint32_t stream = 0; stream < 2; ++stream) {
+        const llama_seq_id owner = batch.seq_id[stream*2][0];
+        const auto & cells = cache.get_cells(owner);
+        std::vector<int32_t> expected;
+        for (uint32_t physical = 0; physical < cells.size(); ++physical) {
+            // Independent scalar scan of actual membership and the known 2-row window.
+            if (cells.seq_has(physical, owner) && (!swa || cells.pos_get(physical) >= batch.pos[stream*2] - 1)) {
+                expected.push_back(static_cast<int32_t>(physical));
+            }
+        }
+        iswa_row_require(!expected.empty() && expected.size() < width, "ISWA nonempty bounded expected rows");
+        for (uint32_t column = 0; column < width; ++column) {
+            const int32_t physical = column < expected.size() ? expected[column] : -1;
+            iswa_row_require(actual_rows[stream*width + column] == physical, "ISWA current ascending owner rows");
+            for (uint32_t q = 0; q < 2; ++q) {
+                const llama_pos query = batch.pos[stream*2 + q];
+                const bool visible = physical >= 0 && cells.pos_get(physical) <= query &&
+                        (!swa || cells.pos_get(physical) > query - 2);
+                const float value = ggml_fp16_to_fp32(actual_mask[(stream*2 + q)*width + column]);
+                iswa_row_require(visible ? value == 0.0f : (std::isinf(value) && value < 0),
+                        "ISWA exact causal/SWA compact mask");
+            }
+        }
+    }
+}
+
+static void iswa_row_check_bindings(const llm_graph_result & result, const llm_graph_input_attn_kv_iswa & input) {
+    const std::pair<const ggml_tensor *, const char *> expected[] = {
+        {input.self_kv_rows, "attention.base.read_rows.0"},
+        {input.self_read_mask, "attention.base.read_mask.0"},
+        {input.self_kv_rows_swa, "attention.swa.read_rows.0"},
+        {input.self_read_mask_swa, "attention.swa.read_mask.0"},
+    };
+    for (const auto & item : expected) {
+        iswa_row_require(item.first != nullptr, "ISWA missing declared input");
+        const auto & bindings = result.get_request_input_bindings();
+        const auto count = std::count_if(bindings.begin(), bindings.end(), [&](const skippy_request_input_binding & binding) {
+            return binding.tensor == item.first && binding.identity == item.second;
+        });
+        iswa_row_require(count == 1, "ISWA semantic input binding");
+    }
+}
+
+static int check_iswa_row_inputs() {
+    try {
+        iswa_row_fixture_model model;
+        llama_kv_cache_iswa cache(model, GGML_TYPE_F16, GGML_TYPE_F16, false, false,
+                false, true, 512, 3, 16, 256, nullptr, nullptr, nullptr, nullptr);
+        auto prefix = iswa_row_batch(8, 0, false);
+        auto prefix_context = iswa_row_apply(cache, prefix);
+        cache.seq_cp(0, 1, -1, -1);
+        cache.seq_cp(0, 2, -1, -1); // parked owner keeps the shared prefix live
+        auto first = iswa_row_batch(2, 8, true);
+        auto first_context = iswa_row_apply(cache, first);
+        ggml_backend_ptr cpu(ggml_backend_cpu_init());
+        iswa_row_require(cpu != nullptr, "ISWA CPU backend");
+        ggml_backend_t backends[] = {cpu.get()};
+        ggml_backend_sched_ptr scheduler(ggml_backend_sched_new(backends, nullptr, 1, 512, false, true));
+        iswa_row_require(scheduler != nullptr, "ISWA CPU scheduler");
+        llm_graph_result result(512);
+        llm_graph_params params = {};
+        params.arch = model.arch;
+        params.hparams = model.hparams;
+        params.cparams.flash_attn = params.cparams.fused_kv_rows = true;
+        params.cparams.kv_unified = params.cparams.causal_attn = params.cparams.offload_kqv = true;
+        params.cparams.n_ctx = 512;
+        params.cparams.n_seq_max = 3;
+        params.ubatch = first;
+        params.mctx = first_context.get();
+        params.sched = scheduler.get();
+        params.backend_cpu = cpu.get();
+        params.res = &result;
+        llm_graph_context graph(params);
+        auto * input = graph.build_attn_inp_kv_iswa();
+        iswa_row_check_bindings(result, *input);
+        auto * q = ggml_new_tensor_3d(result.get_ctx(), GGML_TYPE_F32, 64, 1, 4);
+        ggml_set_input(q);
+        std::vector<ggml_tensor *> outputs;
+        for (int layer = 0; layer < 2; ++layer) {
+            outputs.push_back(graph.build_attn(input, nullptr, nullptr, nullptr, q, nullptr, nullptr,
+                    nullptr, nullptr, nullptr, 0.125f, layer));
+        }
+        const auto & fused = result.get_fused_nodes();
+        iswa_row_require(fused.size() == 2, "ISWA both attention layers");
+        for (const auto & node : fused) {
+            const bool swa = model.hparams.is_swa(node.il);
+            iswa_row_require(node.op == LLM_FUSED_OP_FLASH_ATTN_KV_ROWS && node.tensor->src[6] == nullptr &&
+                    node.tensor->src[5] == (swa ? input->self_kv_rows_swa : input->self_kv_rows) &&
+                    node.tensor->src[3] == (swa ? input->self_read_mask_swa : input->self_read_mask) &&
+                    ggml_backend_supports_op(cpu.get(), node.tensor), "ISWA per-layer pool/route admission");
+        }
+        iswa_row_require(ggml_backend_sched_alloc_graph(scheduler.get(), result.get_gf()), "ISWA graph allocation");
+        std::vector<float> zeros(64*4, 0.0f);
+        ggml_backend_tensor_set(q, zeros.data(), 0, zeros.size()*sizeof(float));
+        const auto execute = [&](const llama_ubatch & batch) {
+            result.set_inputs(&batch);
+            iswa_row_check_pool(*cache.get_base(), batch, input->self_kv_rows, input->self_read_mask, false);
+            iswa_row_check_pool(*cache.get_swa(), batch, input->self_kv_rows_swa, input->self_read_mask_swa, true);
+            iswa_row_require(ggml_backend_sched_graph_compute(scheduler.get(), result.get_gf()) == GGML_STATUS_SUCCESS,
+                    "ISWA finite graph compute");
+            for (auto * output : outputs) {
+                std::vector<float> values(ggml_nelements(output));
+                ggml_backend_tensor_get(output, values.data(), 0, values.size()*sizeof(float));
+                for (float value : values) iswa_row_require(std::isfinite(value) && value == 0.0f, "ISWA zero-KV finite output");
+            }
+        };
+        execute(first);
+        auto next = iswa_row_batch(2, 10, true);
+        auto next_context = iswa_row_apply(cache, next);
+        params.ubatch = next;
+        params.mctx = next_context.get();
+        iswa_row_require(input->can_reuse(params) && input->mctx == next_context.get(), "ISWA refresh actual current mctx");
+        execute(next);
+        for (const auto * pool : {cache.get_base(), cache.get_swa()}) {
+            const auto & cells = pool->get_cells(2);
+            for (uint32_t i = 0; i < 8; ++i) {
+                iswa_row_require(cells.seq_has(i, 0) && cells.seq_has(i, 1) && cells.seq_has(i, 2) &&
+                        cells.pos_get(i) == static_cast<llama_pos>(i), "ISWA shared parked prefix retained");
+            }
+        }
+        // Exercise the hybrid caller with real typed contexts too. The fixture
+        // has no recurrent layers: this checks attention delegation, not RS math.
+        llama_memory_hybrid_iswa hybrid(model, GGML_TYPE_F16, GGML_TYPE_F16, false, false,
+                512, 16, 256, GGML_TYPE_F32, GGML_TYPE_F32, 3, 3, 0, false, true,
+                nullptr, [](int32_t) { return false; });
+        auto * hybrid_cache = hybrid.get_mem_attn();
+        auto hybrid_prefix = iswa_row_apply(*hybrid_cache, prefix);
+        hybrid_cache->seq_cp(0, 1, -1, -1);
+        hybrid_cache->seq_cp(0, 2, -1, -1);
+        auto hybrid_first = iswa_row_apply(*hybrid_cache, first);
+        auto hybrid_context = hybrid.init_full();
+        auto * old_hybrid_context = static_cast<const llama_memory_hybrid_iswa_context *>(hybrid_context.get());
+        ggml_backend_sched_ptr hybrid_scheduler(ggml_backend_sched_new(backends, nullptr, 1, 512, false, true));
+        iswa_row_require(hybrid_scheduler != nullptr, "hybrid ISWA CPU scheduler");
+        llm_graph_result hybrid_result(512);
+        auto hybrid_params = params;
+        hybrid_params.ubatch = first;
+        hybrid_params.mctx = hybrid_context.get();
+        hybrid_params.res = &hybrid_result;
+        hybrid_params.sched = hybrid_scheduler.get();
+        llm_graph_context hybrid_graph(hybrid_params);
+        auto * hybrid_input = hybrid_graph.build_inp_mem_hybrid_iswa();
+        iswa_row_check_bindings(hybrid_result, *hybrid_input->get_attn());
+        auto * hybrid_q = ggml_new_tensor_3d(hybrid_result.get_ctx(), GGML_TYPE_F32, 64, 1, 4);
+        ggml_set_input(hybrid_q);
+        std::vector<ggml_tensor *> hybrid_outputs;
+        for (int layer = 0; layer < 2; ++layer) {
+            hybrid_outputs.push_back(hybrid_graph.build_attn(hybrid_input->get_attn(), nullptr, nullptr, nullptr,
+                    hybrid_q, nullptr, nullptr, nullptr, nullptr, nullptr, 0.125f, layer));
+        }
+        iswa_row_require(ggml_backend_sched_alloc_graph(hybrid_scheduler.get(), hybrid_result.get_gf()),
+                "hybrid ISWA graph allocation");
+        ggml_backend_tensor_set(hybrid_q, zeros.data(), 0, zeros.size()*sizeof(float));
+        const auto execute_hybrid = [&](const llama_ubatch & batch) {
+            hybrid_result.set_inputs(&batch);
+            const auto * attention = hybrid_input->get_attn();
+            iswa_row_check_pool(*hybrid_cache->get_base(), batch, attention->self_kv_rows, attention->self_read_mask, false);
+            iswa_row_check_pool(*hybrid_cache->get_swa(), batch, attention->self_kv_rows_swa, attention->self_read_mask_swa, true);
+            iswa_row_require(ggml_backend_sched_graph_compute(hybrid_scheduler.get(), hybrid_result.get_gf()) == GGML_STATUS_SUCCESS,
+                    "hybrid ISWA finite compute");
+            for (auto * output : hybrid_outputs) {
+                std::vector<float> values(ggml_nelements(output));
+                ggml_backend_tensor_get(output, values.data(), 0, values.size()*sizeof(float));
+                for (float value : values) iswa_row_require(std::isfinite(value) && value == 0.0f, "hybrid ISWA finite output");
+            }
+        };
+        execute_hybrid(first);
+        auto hybrid_next = iswa_row_apply(*hybrid_cache, next);
+        auto next_hybrid_context = hybrid.init_full();
+        hybrid_params.ubatch = next;
+        hybrid_params.mctx = next_hybrid_context.get();
+        const auto * actual_hybrid_context = static_cast<const llama_memory_hybrid_iswa_context *>(next_hybrid_context.get());
+        iswa_row_require(actual_hybrid_context != old_hybrid_context && hybrid_input->can_reuse(hybrid_params) &&
+                hybrid_input->mctx == actual_hybrid_context && hybrid_input->get_attn()->mctx == actual_hybrid_context->get_attn(),
+                "hybrid ISWA refresh both current context pointers");
+        execute_hybrid(next);
+
+        auto ragged = next;
+        ragged.b_equal_seqs = 0;
+        ragged.n_tokens = 3;
+        iswa_row_require(!input->can_reuse_row_inputs(ragged, params.cparams), "ISWA ragged topology rejects row reuse");
+        auto ordinary = params.cparams;
+        ordinary.fused_kv_rows = false;
+        iswa_row_require(!input->can_reuse_row_inputs(next, ordinary), "ISWA row-enabled topology cannot reuse ordinary");
+        ordinary = params.cparams;
+        ordinary.training = true;
+        iswa_row_require(!input->can_reuse_row_inputs(next, ordinary), "ISWA training cannot reuse row topology");
+        // Test both ordinary pool builders without changing the product setting.
+        llm_graph_result ordinary_result(512);
+        params.cparams.fused_kv_rows = false;
+        params.res = &ordinary_result;
+        llm_graph_context ordinary_graph(params);
+        auto * ordinary_input = ordinary_graph.build_attn_inp_kv_iswa();
+        iswa_row_require(!ordinary_input->self_kv_rows && !ordinary_input->self_kv_rows_swa,
+                "ISWA ordinary row inputs absent");
+        auto * ordinary_q = ggml_new_tensor_3d(ordinary_result.get_ctx(), GGML_TYPE_F32, 64, 1, 4);
+        for (int layer = 0; layer < 2; ++layer) {
+            ordinary_graph.build_attn(ordinary_input, nullptr, nullptr, nullptr, ordinary_q, nullptr, nullptr,
+                    nullptr, nullptr, nullptr, 0.125f, layer);
+        }
+        iswa_row_require(ordinary_result.get_fused_nodes().size() == 2, "ISWA both ordinary layers");
+        for (const auto & node : ordinary_result.get_fused_nodes()) {
+            iswa_row_require(node.op == LLM_FUSED_OP_FLASH_ATTN && !node.tensor->src[5] && !node.tensor->src[6] &&
+                    node.tensor->src[3] == (model.hparams.is_swa(node.il) ? ordinary_input->self_kq_mask_swa : ordinary_input->self_kq_mask),
+                    "ISWA ordinary per-layer mask");
+        }
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "ISWA row-input regression: %s\n", error.what());
+        return 120;
+    }
+}
diff --git a/src/skippy/tests/resident_checkpoint_gpu.cpp b/src/skippy/tests/resident_checkpoint_gpu.cpp
new file mode 100644
index 000000000..691e92c37
--- /dev/null
+++ b/src/skippy/tests/resident_checkpoint_gpu.cpp
@@ -0,0 +1,287 @@
+// Opt-in real-model GPU proof: separate checkpoint ownership from HTTP scheduling.
+#include "skippy.h"
+#include "../runtime_types.h"
+#include "llama-model.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+int skippy_test_resident_checkpoint_gpu(const char * model_path, skippy_runtime_config config);
+
+namespace {
+constexpr size_t lanes = 4;
+constexpr size_t suffix_steps = 32;
+constexpr size_t pressure_tokens = 4096;
+using Sessions = std::array<skippy_session *, lanes>;
+using Prefixes = std::array<std::vector<llama_token>, lanes>;
+
+#define REQUIRE(condition) do { if (!(condition)) { \
+    std::fprintf(stderr, "long GPU checkpoint failed: %s at %s:%d\n", #condition, __FILE__, __LINE__); \
+    std::exit(1); } } while (0)
+
+void ok(skippy_status status, skippy_error * error) {
+    if (status != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "long GPU native error: %s\n", error ? error->message : "no detail");
+        std::exit(1);
+    }
+    skippy_error_free(error);
+}
+
+size_t prefix_tokens() {
+    const char * value = std::getenv("SKIPPY_NATIVE_TEST_PREFIX_TOKENS");
+    if (!value) { return 23497; }
+    REQUIRE(*value && std::strspn(value, "0123456789") == std::strlen(value));
+    const unsigned long count = std::strtoul(value, nullptr, 10);
+    REQUIRE(count >= 128 && count <= 65536);
+    return static_cast<size_t>(count);
+}
+
+Sessions create(skippy_model * model) {
+    Sessions sessions{};
+    for (auto & session : sessions) {
+        skippy_error * error = nullptr;
+        const auto status = skippy_session_create(model, &session, &error);
+        ok(status, error);
+    }
+    return sessions;
+}
+
+void release(Sessions & sessions) {
+    for (auto & session : sessions) {
+        skippy_error * error = nullptr;
+        const auto status = skippy_session_free(session, &error);
+        ok(status, error);
+        session = nullptr;
+    }
+}
+
+void prefill(Sessions & sessions, const Prefixes & prefixes) {
+    // Identical explicit chunk and lane order in every cold reference arm.
+    for (size_t offset = 0; offset < prefixes[0].size(); offset += 512) {
+        for (size_t lane = 0; lane < lanes; ++lane) {
+            const size_t count = std::min<size_t>(512, prefixes[lane].size() - offset);
+            skippy_error * error = nullptr;
+            size_t bytes = 0;
+            const auto status = skippy_prefill_chunk(sessions[lane], prefixes[lane].data() + offset,
+                    count, nullptr, 0, nullptr, 0, &bytes, &error);
+            ok(status, error);
+        }
+    }
+}
+
+Prefixes tokens(size_t count, int32_t vocab_size, int32_t salt) {
+    REQUIRE(vocab_size > 64);
+    const int32_t span = std::min<int32_t>(vocab_size - 32, 4096);
+    Prefixes prefixes;
+    for (size_t lane = 0; lane < lanes; ++lane) {
+        prefixes[lane].reserve(count);
+        for (size_t i = 0; i < count; ++i) {
+            prefixes[lane].push_back(32 + static_cast<int32_t>((i * 17 + lane * 101 + salt) % span));
+        }
+    }
+    return prefixes;
+}
+
+struct Components {
+    std::vector<uint8_t> kv;
+    std::vector<uint8_t> recurrent;
+};
+
+Components components(skippy_session * session) {
+    const int32_t layers = static_cast<int32_t>(session->stage_model->model->hparams.n_layer());
+    skippy_kv_page_desc desc{};
+    size_t bytes = 0;
+    skippy_error * error = nullptr;
+    auto status = skippy_export_kv_page(session, 0, layers, 0, session->n_past,
+            &desc, nullptr, 0, &bytes, &error);
+    REQUIRE(status == SKIPPY_STATUS_BUFFER_TOO_SMALL && bytes > 0);
+    skippy_error_free(error);
+    Components result;
+    result.kv.resize(bytes);
+    error = nullptr;
+    status = skippy_export_kv_page(session, 0, layers, 0, session->n_past,
+            &desc, result.kv.data(), result.kv.size(), &bytes, &error);
+    ok(status, error);
+    result.kv.resize(bytes);
+    error = nullptr;
+    status = skippy_export_recurrent_state(session, nullptr, 0, &bytes, &error);
+    REQUIRE(status == SKIPPY_STATUS_BUFFER_TOO_SMALL && bytes > 0);
+    skippy_error_free(error);
+    result.recurrent.resize(bytes);
+    error = nullptr;
+    status = skippy_export_recurrent_state(session, result.recurrent.data(),
+            result.recurrent.size(), &bytes, &error);
+    ok(status, error);
+    result.recurrent.resize(bytes);
+    return result;
+}
+
+struct DecodeRows {
+    std::array<llama_token, lanes> greedy;
+    std::array<std::vector<float>, lanes> logits;
+};
+
+using DecodeTrace = std::vector<DecodeRows>;
+
+DecodeTrace decode_fixed_suffix(Sessions & sessions, int32_t vocab_size) {
+    skippy_sampling_config sampling{};
+    sampling.version = 1;
+    sampling.flags = SKIPPY_SAMPLING_FLAG_ENABLED;
+    sampling.repeat_penalty = 1.0f;
+    sampling.temperature = 0;
+    sampling.top_k = 1;
+    sampling.reasoning_budget_tokens = -1;
+    DecodeTrace trace;
+    trace.reserve(suffix_steps);
+    for (size_t step = 0; step < suffix_steps; ++step) {
+        std::array<llama_token, lanes> input{};
+        for (size_t lane = 0; lane < lanes; ++lane) {
+            input[lane] = 32 + static_cast<llama_token>((step * 11 + lane * 37) % (vocab_size - 32));
+        }
+        DecodeRows rows;
+        skippy_error * error = nullptr;
+        std::array<skippy_iteration_request, lanes> requests{};
+        std::array<size_t, lanes> sampled_indexes{};
+        size_t sampled_count = 0;
+        for (size_t lane = 0; lane < lanes; ++lane) {
+            requests[lane].session = sessions[lane];
+            requests[lane].token_ids = &input[lane];
+            requests[lane].token_count = 1;
+            requests[lane].sampling = &sampling;
+            requests[lane].sample_last = true;
+        }
+        const auto status = skippy_iteration_batch_sampled(requests.data(), requests.size(),
+                nullptr, nullptr, nullptr, nullptr, sampled_indexes.data(), rows.greedy.data(),
+                rows.greedy.size(), &sampled_count, &error);
+        ok(status, error);
+        REQUIRE(sampled_count == lanes);
+        for (size_t lane = 0; lane < lanes; ++lane) {
+            REQUIRE(sampled_indexes[lane] == lane);
+            const float * logits = llama_get_logits_ith(sessions[lane]->ctx, static_cast<int32_t>(lane));
+            REQUIRE(logits != nullptr);
+            rows.logits[lane].assign(logits, logits + vocab_size);
+            REQUIRE(std::all_of(rows.logits[lane].begin(), rows.logits[lane].end(),
+                    [](float value) { return std::isfinite(value); }));
+        }
+        trace.push_back(std::move(rows));
+    }
+    return trace;
+}
+
+bool compare(const char * arm, const DecodeTrace & reference, const DecodeTrace & actual) {
+    REQUIRE(reference.size() == actual.size());
+    float max_delta = 0;
+    size_t mismatched_greedy = 0;
+    for (size_t step = 0; step < reference.size(); ++step) {
+        for (size_t lane = 0; lane < lanes; ++lane) {
+            mismatched_greedy += reference[step].greedy[lane] != actual[step].greedy[lane];
+            REQUIRE(reference[step].logits[lane].size() == actual[step].logits[lane].size());
+            for (size_t token = 0; token < reference[step].logits[lane].size(); ++token) {
+                max_delta = std::max(max_delta,
+                        std::fabs(reference[step].logits[lane][token] - actual[step].logits[lane][token]));
+            }
+        }
+    }
+    std::fprintf(stderr, "%s: batch=4 steps=%zu max_logit_delta=%.9g greedy_mismatches=%zu\n",
+            arm, reference.size(), max_delta, mismatched_greedy);
+    return max_delta <= 1e-6f && mismatched_greedy == 0;
+}
+
+void save(Sessions & sessions, size_t count) {
+    for (size_t lane = 0; lane < lanes; ++lane) {
+        skippy_error * error = nullptr;
+        const auto status = skippy_session_save_prefix(sessions[lane], static_cast<int32_t>(8 + lane), count, &error);
+        ok(status, error);
+    }
+}
+
+Sessions restore(skippy_model * model, const Prefixes & prefixes) {
+    Sessions sessions{};
+    for (size_t lane = 0; lane < lanes; ++lane) {
+        skippy_error * error = nullptr;
+        const auto status = skippy_session_create_from_resident_prefix(model, static_cast<int32_t>(8 + lane),
+                prefixes[lane].data(), prefixes[lane].size(), &sessions[lane], &error);
+        ok(status, error);
+    }
+    return sessions;
+}
+
+void require_gpu_weights(skippy_model * model) {
+    REQUIRE(std::any_of(model->model->tensors_by_name.begin(), model->model->tensors_by_name.end(),
+            [](const auto & item) {
+                if (!item.second->buffer || ggml_backend_buffer_is_host(item.second->buffer)) { return false; }
+                const auto type = ggml_backend_dev_type(ggml_backend_buft_get_device(
+                        ggml_backend_buffer_get_type(item.second->buffer)));
+                return type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU;
+            }));
+}
+
