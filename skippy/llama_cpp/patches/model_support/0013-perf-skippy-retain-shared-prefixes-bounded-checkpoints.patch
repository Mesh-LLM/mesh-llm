+            const int64_t query = (i - request*request_elements) / (data.spec.heads*data.spec.dv);
+            if (exceptional[request*data.spec.queries + query]) { continue; }
+            require(std::isfinite(expected[i]) && std::isfinite(actual[i]), "non-finite attention output");
+            const double delta = double(expected[i]) - actual[i];
+            error += delta*delta;
+            energy += double(expected[i])*expected[i];
+            max_absolute = std::max(max_absolute, float(std::abs(delta)));
+        }
+        if (energy == 0.0) {
+            require(error == 0.0, "zero-energy finite-domain output must remain exact");
+        } else {
+            maximum_nmse = std::max(maximum_nmse, error/energy);
+            require(error/energy <= max_nmse, "rows attention exceeds existing FA NMSE tolerance");
+        }
+    }
+    std::printf("PASS finite-domain backend=%s K=%s V=%s dk=%lld dv=%lld heads=%lld bias=%.2f q=%lld logical=%lld mask=%d sinks=%d query_local=%d strided_q=%d softcap=%.2f phase=%d max_request_nmse=%.9g max_abs=%.9g\n",
+            backend, ggml_type_name(data.spec.type_k), ggml_type_name(data.spec.type_v),
+            (long long) data.spec.dk, (long long) data.spec.dv, (long long) data.spec.heads,
+            data.spec.mask ? data.spec.max_bias : 0.0f, (long long) data.spec.queries, (long long) data.spec.logical_rows,
+            data.spec.mask, data.spec.sinks, data.spec.query_local, data.spec.strided_query,
+            data.spec.logit_softcap, phase, maximum_nmse, max_absolute);
+}
+
+void set_threads(ggml_backend_t backend) {
+    const auto reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend));
+    const auto setter = reinterpret_cast<void (*)(ggml_backend_t, int)>(
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads"));
+    if (setter) {
+        setter(backend, 4);
+    }
+}
+
+// Accept an exact device (e.g. MTL0/CUDA0) or its registry (Metal/CUDA).
+ggml_backend_t open_backend(const char * name) {
+    if (auto exact = ggml_backend_init_by_name(name, nullptr)) {
+        return exact;
+    }
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        auto device = ggml_backend_dev_get(i);
+        const auto registry = ggml_backend_dev_backend_reg(device);
+        if (std::strcmp(ggml_backend_reg_name(registry), name) == 0) {
+            return ggml_backend_dev_init(device, nullptr);
+        }
+    }
+    return nullptr;
+}
+
+void run_case(ggml_backend_t cpu, ggml_backend_t target, attention_case spec) {
+    inputs data(spec);
+    graph_fixture reference(cpu, data, false);
+    graph_fixture row_based(cpu, data, true);
+    require(reference.output->src[5] == nullptr && reference.output->src[6] == nullptr,
+            "ordinary FA must remain free of row metadata");
+    if (!spec.mask) {
+        require(reference.mask == nullptr && row_based.mask != nullptr,
+                "ordinary unmasked input and required rows zero-mask metadata are distinct representations");
+        std::printf("REPRESENTATION ordinary_mask=null rows_mask=explicit_zero logical_values=unmasked\n");
+    }
+    require(std::memcmp(reference.output->op_params, row_based.output->op_params,
+            sizeof(reference.output->op_params)) == 0, "rows must retain ordinary arithmetic parameters");
+    std::unique_ptr<graph_fixture> device;
+    std::unique_ptr<graph_fixture> device_ordinary;
+    if (target != cpu) {
+        if (ggml_backend_supports_op(target, row_based.output)) {
+            require(ggml_backend_supports_op(target, reference.output), "rows require an ordinary same-backend control");
+            device = std::make_unique<graph_fixture>(target, data, true);
+            device_ordinary = std::make_unique<graph_fixture>(target, data, false);
+            std::printf("ADMISSION rows backend=%s K=%s V=%s dk=%lld dv=%lld q=%lld mask=%d\n",
+                    ggml_backend_name(target), ggml_type_name(spec.type_k), ggml_type_name(spec.type_v),
+                    (long long) spec.dk, (long long) spec.dv, (long long) spec.queries, spec.mask);
+        } else {
+            const bool dense_supported = ggml_backend_supports_op(target, reference.output);
+            if (dense_supported) {
+                device = std::make_unique<graph_fixture>(target, data, false);
+            }
+            std::printf("%s backend=%s K=%s V=%s q=%lld mask=%d query_local=%d softcap=%.2f rows_admission=0 ordinary_admission=%d; CPU reference is separate\n",
+                    dense_supported ? "FALLBACK ordinary-selected-backend" : "SKIP unsupported-selected-backend",
+                    ggml_backend_name(target), ggml_type_name(spec.type_k), ggml_type_name(spec.type_v),
+                    (long long) spec.queries, spec.mask, spec.query_local, spec.logit_softcap, dense_supported);
+        }
+    }
+    // Changed row tables and masks must remain visible after graph reuse.
+    for (int phase = 0; phase < 4; ++phase) {
+        data.refresh(phase);
+        const auto expected = reference.run(cpu, data);
+        if (phase == 0) {
+            const auto repeated = reference.run(cpu, data);
+            require(expected.size() == repeated.size(), "ordinary repeat output size");
+            for (int64_t request = 0; request < requests; ++request) {
+                for (int64_t query = 0; query < spec.queries; ++query) {
+                    const size_t begin = (request*spec.queries + query)*spec.heads*spec.dv;
+                    const size_t count = spec.heads*spec.dv;
+                    if (exceptional_query(data, request, query)) {
+                        for (size_t i = begin; i < begin + count; ++i) {
+                            require(result_class(expected[i]) == result_class(repeated[i]), "ordinary exceptional repeat class");
+                        }
+                    } else {
+                        require(std::memcmp(expected.data() + begin, repeated.data() + begin,
+                                count*sizeof(float)) == 0, "ordinary finite-domain output must self-repeat exactly");
+                    }
+                }
+            }
+        }
+        const auto cpu_rows = row_based.run(cpu, data);
+        exceptional_result_control(expected, cpu_rows, data, ggml_backend_name(cpu), phase);
+        compare(expected, cpu_rows, data, ggml_backend_name(cpu), phase);
+        if (device) {
+            const auto actual = device->run(target, data);
+            if (device_ordinary && spec.mask && !spec.sinks) {
+                const auto ordinary = device_ordinary->run(target, data);
+                exceptional_result_control(ordinary, actual, data, ggml_backend_name(target), phase);
+            }
+            compare(expected, actual, data, ggml_backend_name(target), phase);
+        }
+    }
+}
+
+void run_unquantized_vector_cases(ggml_backend_t cpu, ggml_backend_t target) {
+    const std::array<ggml_type, 2> types = {GGML_TYPE_F16, GGML_TYPE_BF16};
+    // Wide GQA must retain the shared hardware policy rather than force vec.
+    for (auto type_k : types) {
+        for (auto type_v : types) {
+            for (int64_t queries : {1, 2}) {
+                run_case(cpu, target, {queries, 256, true, false, false, false,
+                        type_k, type_v, 256, 256, 0.0f, 16});
+            }
+        }
+    }
+    for (int64_t dimension : {64, 128, 256}) {
+        for (auto type_k : types) {
+            for (auto type_v : types) {
+                for (int64_t queries : {1, 2}) {
+                    if (dimension != 256) {
+                        run_case(cpu, target, {queries, 256, true, true, false, false,
+                                type_k, type_v, dimension, dimension});
+                    }
+                    run_case(cpu, target, {queries, 256, false, false, false, false,
+                            type_k, type_v, dimension, dimension});
+                    if (dimension != 64) {
+                        run_case(cpu, target, {queries, 256, true, true, false, false,
+                                type_k, type_v, dimension, dimension, 0.0f, 8, 4.0f});
+                    }
+                }
+            }
+        }
+    }
+    run_case(cpu, target, {2, 256, true, true, false, true,
+            GGML_TYPE_F16, GGML_TYPE_BF16, 128, 128});
+}
+
+void run_softcap_capability_cases(ggml_backend_t cpu, ggml_backend_t target) {
+    const auto registry = ggml_backend_dev_backend_reg(ggml_backend_get_device(target));
+    const bool cuda = std::strcmp(ggml_backend_reg_name(registry), "CUDA") == 0;
+    for (auto type_k : {GGML_TYPE_F16, GGML_TYPE_BF16}) {
+        for (auto type_v : {GGML_TYPE_F16, GGML_TYPE_BF16}) {
+            for (int64_t queries : {1, 2}) {
+                attention_case spec{queries, 256, true, true, false, false,
+                        type_k, type_v, 64, 64, 0.0f, 8, 4.0f};
+                if (cuda) {
+                    inputs data(spec);
+                    graph_fixture dense(cpu, data, false);
+                    graph_fixture row_based(cpu, data, true);
+                    require(!ggml_backend_supports_op(target, dense.output) &&
+                            !ggml_backend_supports_op(target, row_based.output),
+                            "CUDA must refuse head64 softcap without a compiled kernel");
+                    std::printf("PASS CUDA admission refuses unsupported softcap K=%s V=%s dk=64 q=%lld\n",
+                            ggml_type_name(type_k), ggml_type_name(type_v), (long long) queries);
+                }
+                // CPU reference coverage is separate; a CUDA skip is not a GPU pass.
+                run_case(cpu, target, spec);
+            }
+        }
+    }
+    const std::array<std::array<int64_t, 3>, 5> shapes = {{{192, 128, 16},
+            {320, 256, 64}, {512, 512, 8}, {576, 512, 8}, {576, 512, 4}}};
+    for (const auto & shape : shapes) {
+        for (auto type : {GGML_TYPE_F16, GGML_TYPE_BF16}) {
+            for (int64_t queries : {1, 2}) {
+                run_case(cpu, target, {queries, 256, true, true, false, false,
+                        type, type, shape[0], shape[1], 0.0f, shape[2], 4.0f});
+            }
+        }
+    }
+}
+} // namespace
+
+int main(int argc, char ** argv) {
+    try {
+        require(argc == 1 || (argc == 3 && std::strcmp(argv[1], "--backend") == 0),
+                "usage: test-flash-attn-rows [--backend DEVICE_NAME]");
+        ggml_backend_load_all();
+        using backend_ptr = std::unique_ptr<ggml_backend, decltype(&ggml_backend_free)>;
+        backend_ptr cpu(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr), ggml_backend_free);
+        require(cpu != nullptr, "CPU reference backend unavailable");
+        set_threads(cpu.get());
+        backend_ptr selected(nullptr, ggml_backend_free);
+        if (argc == 3) {
+            selected.reset(open_backend(argv[2]));
+            require(selected != nullptr, "requested backend unavailable");
+        } else {
+            selected.reset(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_GPU, nullptr));
+            if (!selected) {
+                selected.reset(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_IGPU, nullptr));
+            }
+        }
+        const bool selected_cpu = selected &&
+                ggml_backend_dev_type(ggml_backend_get_device(selected.get())) == GGML_BACKEND_DEVICE_TYPE_CPU;
+        auto target = selected && !selected_cpu ? selected.get() : cpu.get();
+        std::printf("rows FA: CPU reference and target=%s; per-request NMSE limit=%.9g\n", ggml_backend_name(target), max_nmse);
+        for (int64_t queries : {1, 2, 4, 31, 32, 64}) {
+            run_case(cpu.get(), target, {queries, 256, true, true});
+        }
+        run_case(cpu.get(), target, {1, 4352, true, true});
+        run_case(cpu.get(), target, {4, 256, false, false});
+        run_case(cpu.get(), target, {31, 256, true, false, true});
+        run_case(cpu.get(), target, {32, 256, true, true, false, true});
+        const std::array<ggml_type, 8> types = {GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_BF16,
+                GGML_TYPE_Q4_0, GGML_TYPE_Q4_1, GGML_TYPE_Q5_0, GGML_TYPE_Q5_1, GGML_TYPE_Q8_0};
+        for (auto type_k : types) {
+            for (auto type_v : types) {
+                for (int64_t queries : {1, 2, 32}) {
+                    run_case(cpu.get(), target, {queries, 256, true, true, false, false, type_k, type_v});
+                }
+            }
+        }
+        run_unquantized_vector_cases(cpu.get(), target);
+        run_softcap_capability_cases(cpu.get(), target);
+        const std::array<std::array<int64_t, 2>, 13> head_shapes = {{{32, 32}, {64, 64}, {96, 96},
+                {96, 64}, {128, 128}, {128, 96}, {192, 192}, {192, 128}, {256, 256},
+                {320, 256}, {512, 512}, {576, 512}, {128, 64}}};
+        for (const auto & dimensions : head_shapes) {
+            for (auto type : types) {
+                for (int64_t queries : {1, 32}) {
+                    run_case(cpu.get(), target, {queries, 256, true, true, false, false,
+                            type, type, dimensions[0], dimensions[1]});
+                }
+            }
+        }
+        // CUDA's larger-head kernels require zero ALiBi and admitted GQA tile ratios.
+        const std::array<std::array<int64_t, 3>, 5> wide_shapes = {{{192, 128, 16},
+                {320, 256, 64}, {512, 512, 8}, {576, 512, 8}, {576, 512, 4}}};
+        for (const auto & dimensions : wide_shapes) {
+            for (auto type : types) {
+                for (int64_t queries : {1, 32}) {
+                    run_case(cpu.get(), target, {queries, 256, true, true, false, false,
+                            type, type, dimensions[0], dimensions[1], 0.0f, dimensions[2]});
+                }
+            }
+        }
+        for (int64_t dimension : {40, 48, 72, 80, 112}) {
+            for (auto type : {GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_BF16}) {
+                for (int64_t queries : {1, 32}) {
+                    run_case(cpu.get(), target, {queries, 256, true, true, false, false,
+                            type, type, dimension, dimension});
+                }
+            }
+        }
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "rows FA test failed: %s\n", error.what());
+        return 1;
+    }
+}
