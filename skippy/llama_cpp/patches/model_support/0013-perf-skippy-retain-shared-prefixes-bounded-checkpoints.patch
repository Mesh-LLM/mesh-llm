new file mode 100644
index 000000000..5da812201
--- /dev/null
+++ b/src/llama-graph-kv-rows.cpp
@@ -0,0 +1,124 @@
+#include "llama-graph.h"
+
+#include "llama-cparams.h"
+#include "llama-kv-cache.h"
+#include "llama-kv-cache-iswa.h"
+#include "ggml-backend.h"
+
+bool llm_graph_context::supports_row_attn(const ggml_tensor * node, const ggml_tensor * storage) const {
+    while (storage->view_src) {
+        storage = storage->view_src;
+    }
+    if (storage->buffer) {
+        const auto type = ggml_backend_buffer_get_type(storage->buffer);
+        const auto device = ggml_backend_buft_get_device(type);
+        if (device) {
+            return ggml_backend_dev_supports_op(device, node);
+        }
+        // Host storage may use the scheduler's existing CPU backend. Never
+        // redirect unsupported GPU-owned storage through a CPU pool copy.
+        if (!ggml_backend_buft_is_host(type) || !sched) {
+            return false;
+        }
+        for (int i = 0; i < ggml_backend_sched_get_n_backends(sched); ++i) {
+            const auto backend = ggml_backend_sched_get_backend(sched, i);
+            const auto device_cpu = ggml_backend_get_device(backend);
+            if (device_cpu && ggml_backend_dev_type(device_cpu) == GGML_BACKEND_DEVICE_TYPE_CPU &&
+                    ggml_backend_supports_op(backend, node)) {
+                return true;
+            }
+        }
+        return false;
+    }
+    return sched && ggml_backend_sched_get_n_backends(sched) > 0 &&
+            ggml_backend_supports_op(ggml_backend_sched_get_backend(sched, 0), node);
+}
+
+namespace {
+
+void build_pool_row_inputs(
+        ggml_context * ctx, const llama_ubatch & ubatch, const llama_cparams & params,
+        const llama_kv_cache_context * mctx, ggml_tensor * & row_input, ggml_tensor * & mask_input,
+        uint32_t & physical_extent, const char * row_name, const char * mask_name) {
+    if (!params.flash_attn || !params.fused_kv_rows || params.training) {
+        return;
+    }
+    const uint32_t rows = mctx->get_n_kv_rows();
+    const uint32_t slices = llama_kv_cache::get_n_kv_slices(ubatch);
+    if (!rows || rows % 256 != 0 || !slices) {
+        return;
+    }
+    physical_extent = mctx->get_n_kv();
+    row_input = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, rows, slices);
+    mask_input = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, rows, ubatch.n_tokens / slices, 1, slices);
+    ggml_set_input(row_input);
+    ggml_set_input(mask_input);
+    ggml_set_name(row_input, row_name);
+    ggml_set_name(mask_input, mask_name);
+}
+
+bool can_reuse_pool_row_inputs(
+        const llama_ubatch & ubatch, const llama_cparams & params, const llama_kv_cache_context * mctx,
+        const ggml_tensor * row_input, const ggml_tensor * mask_input, uint32_t physical_extent) {
+    const uint32_t rows = params.flash_attn && params.fused_kv_rows && !params.training ? mctx->get_n_kv_rows() : 0;
+    const uint32_t slices = llama_kv_cache::get_n_kv_slices(ubatch);
+    const bool use_rows = rows && rows % 256 == 0 && slices;
+    if (use_rows != (row_input != nullptr)) {
+        return false;
+    }
+    if (!use_rows) {
+        return true;
+    }
+    return physical_extent == mctx->get_n_kv() && row_input->ne[0] == rows &&
+            row_input->ne[1] == slices && mask_input->ne[0] == rows &&
+            mask_input->ne[1] == ubatch.n_tokens / slices && mask_input->ne[3] == slices;
+}
+
+void set_pool_row_inputs(
+        const llama_ubatch & ubatch, const llama_cparams & params, const llama_kv_cache_context * mctx,
+        ggml_tensor * row_input, ggml_tensor * mask_input) {
+    if (row_input && row_input->buffer) {
+        mctx->set_input_kv_rows(row_input, &ubatch);
+    }
+    if (mask_input && mask_input->buffer) {
+        GGML_ASSERT(row_input && row_input->buffer);
+        mctx->set_input_kq_mask(mask_input, &ubatch, params.causal_attn, row_input);
+    }
+}
+
+} // namespace
+
+void llm_graph_input_attn_kv::build_row_inputs(ggml_context * ctx, const llama_ubatch & ubatch) {
+    build_pool_row_inputs(ctx, ubatch, cparams, mctx, self_kv_rows, self_read_mask,
+            read_physical_extent, "attn_inp_kv_rows", "attn_inp_read_mask");
+}
+
+bool llm_graph_input_attn_kv::can_reuse_row_inputs(const llama_ubatch & ubatch, const llama_cparams & params) {
+    return can_reuse_pool_row_inputs(ubatch, params, mctx, self_kv_rows, self_read_mask, read_physical_extent);
+}
+
+void llm_graph_input_attn_kv::set_row_inputs(const llama_ubatch & ubatch) {
+    set_pool_row_inputs(ubatch, cparams, mctx, self_kv_rows, self_read_mask);
+}
+
+void llm_graph_input_attn_kv_iswa::build_row_inputs(ggml_context * ctx, const llama_ubatch & ubatch) {
+    build_pool_row_inputs(ctx, ubatch, cparams, mctx->get_base(), self_kv_rows, self_read_mask,
+            read_physical_extent, "attn_inp_kv_rows", "attn_inp_read_mask");
+    build_pool_row_inputs(ctx, ubatch, cparams, mctx->get_swa(), self_kv_rows_swa, self_read_mask_swa,
+            read_physical_extent_swa, "attn_inp_kv_rows_swa", "attn_inp_read_mask_swa");
+}
+
+bool llm_graph_input_attn_kv_iswa::can_reuse_row_inputs(
+        const llama_ubatch & ubatch, const llama_cparams & params) {
+    // Evaluate both pools: their compact extents and SWA visibility are independent.
+    const bool base = can_reuse_pool_row_inputs(ubatch, params, mctx->get_base(),
+            self_kv_rows, self_read_mask, read_physical_extent);
+    const bool swa = can_reuse_pool_row_inputs(ubatch, params, mctx->get_swa(),
+            self_kv_rows_swa, self_read_mask_swa, read_physical_extent_swa);
+    return base && swa;
+}
+
+void llm_graph_input_attn_kv_iswa::set_row_inputs(const llama_ubatch & ubatch) {
+    set_pool_row_inputs(ubatch, cparams, mctx->get_base(), self_kv_rows, self_read_mask);
+    set_pool_row_inputs(ubatch, cparams, mctx->get_swa(), self_kv_rows_swa, self_read_mask_swa);
+}
