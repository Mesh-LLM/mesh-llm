diff --git a/src/skippy/resident_prefix.cpp b/src/skippy/resident_prefix.cpp
new file mode 100644
index 000000000..42769ba7c
--- /dev/null
+++ b/src/skippy/resident_prefix.cpp
@@ -0,0 +1,447 @@
+#include "skippy/state.h"
+#include "skippy/state_memory.h"
+#include "skippy/errors.h"
+#include "skippy/runtime_support.h"
+#include "skippy/runtime_types.h"
+#include "skippy-verify-checkpoint.h"
+#include "llama-io.h"
+#include "llama-kv-cache.h"
+#include "llama-kv-cache-iswa.h"
+#include "llama-memory-hybrid.h"
+#include "llama-memory-hybrid-iswa.h"
+#include "llama-memory-recurrent.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+
+namespace {
+
+// These adapters cover complete memory objects, not model-family names. Never
+// silently drop auxiliary state belonging to an unknown derived memory type.
+llama_memory_t attention_memory(llama_memory_t memory) {
+    if (auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory)) {
+        return hybrid->get_mem_attn();
+    }
+    if (auto * hybrid = dynamic_cast<llama_memory_hybrid_iswa *>(memory)) {
+        return hybrid->get_mem_attn();
+    }
+    return skippy_memory_recurrent_adapter(memory) ? nullptr : memory;
+}
+
+skippy_status validate_session(skippy_session * session, int32_t cache_seq_id,
+        skippy_error ** error) {
+    if (!session || !session->ctx || !session->stage_model || !session->ctx->get_memory()) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "model-backed session is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (cache_seq_id < static_cast<int32_t>(session->stage_model->lane_count * 2)
+            || cache_seq_id >= LLAMA_MAX_SEQ) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "cache sequence id is outside the resident cache range");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto * memory = session->ctx->get_memory();
+    if (!(skippy_model_memory_cache_capabilities(session->stage_model) & SKIPPY_MEMORY_CACHE_RESIDENT)
+            || (attention_memory(memory) && !session->ctx->get_cparams().kv_unified)) {
+        skippy_set_error(error, SKIPPY_STATUS_UNSUPPORTED, "memory does not support complete shared resident prefixes");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    return SKIPPY_STATUS_OK;
+}
+
+// A size query never touches tensor bytes. Export writes directly to the
+// caller's allocation, avoiding an extra full recurrent payload temporary.
+class recurrent_buffer_writer final : public llama_io_write_i {
+public:
+    recurrent_buffer_writer(void * data = nullptr, size_t capacity = 0)
+        : data(static_cast<uint8_t *>(data)), capacity(capacity) {}
+    void write(const void * source, size_t bytes) override {
+        reserve(bytes);
+        if (data && bytes) { std::memcpy(data + position, source, bytes); }
+        position += bytes;
+    }
+    void write_tensor(ggml_tensor * tensor, size_t offset, size_t bytes) override {
+        reserve(bytes);
+        if (data && bytes) { ggml_backend_tensor_get(tensor, data + position, offset, bytes); }
+        position += bytes;
+    }
+    size_t n_bytes() override { return position; }
+private:
+    void reserve(size_t bytes) const {
+        if (bytes > std::numeric_limits<size_t>::max() - position
+                || (data && (position > capacity || bytes > capacity - position))) {
+            throw std::runtime_error("recurrent export buffer is too small");
+        }
+    }
+    uint8_t * data;
+    size_t capacity;
+    size_t position = 0;
+};
+
+class checkpoint_writer final : public llama_io_write_i {
+public:
+    void write(const void * source, size_t bytes) override {
+        const auto * data = static_cast<const uint8_t *>(source);
+        if (bytes) { payload.insert(payload.end(), data, data + bytes); }
+    }
+    void write_tensor(ggml_tensor * tensor, size_t offset, size_t bytes) override {
+        const size_t start = payload.size();
+        payload.resize(start + bytes);
+        if (bytes) { ggml_backend_tensor_get(tensor, payload.data() + start, offset, bytes); }
+    }
+    size_t n_bytes() override { return payload.size(); }
+    std::vector<uint8_t> payload;
+};
+
+class checkpoint_reader final : public llama_io_read_i {
+public:
+    explicit checkpoint_reader(const std::vector<uint8_t> & payload) : payload(payload.data()), bytes(payload.size()) {}
+    checkpoint_reader(const uint8_t * payload, size_t bytes) : payload(payload), bytes(bytes) {}
+    void read(void * destination, size_t bytes) override {
+        require(bytes);
+        if (bytes) { std::memcpy(destination, payload + position, bytes); }
+        position += bytes;
+    }
+    void read_tensor(ggml_tensor * tensor, size_t offset, size_t bytes) override {
+        require(bytes);
+        if (bytes) { ggml_backend_tensor_set(tensor, payload + position, offset, bytes); }
+        position += bytes;
+    }
+    size_t n_bytes() override { return position; }
+private:
+    void require(size_t bytes) const {
+        if (bytes > this->bytes - position) {
+            throw std::runtime_error("resident recurrent checkpoint is truncated");
+        }
+    }
+    const uint8_t * payload;
+    const size_t bytes;
+    size_t position = 0;
+};
+
+skippy_status validate_checkpoint(skippy_session * session, int32_t cache_seq_id,
+        const llama_token * tokens, size_t count, skippy_error ** error) {
+    auto status = validate_session(session, cache_seq_id, error);
+    if (status != SKIPPY_STATUS_OK) { return status; }
+    if (count > static_cast<size_t>(std::numeric_limits<int32_t>::max()) || (count && !tokens)) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "resident prefix tokens are invalid");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const auto & checkpoints = session->stage_model->resident_prefixes;
+    const auto found = checkpoints.find(cache_seq_id);
+    if (found == checkpoints.end() || count > found->second.tokens.size()
+            || (skippy_memory_recurrent_adapter(session->ctx->get_memory())
+                && count != found->second.tokens.size())
+            || (count && !std::equal(tokens, tokens + count, found->second.tokens.begin()))) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "resident prefix identity or exact recurrent boundary does not match");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto * attention = attention_memory(session->ctx->get_memory());
+    if (attention && count && attention->seq_pos_max(cache_seq_id) < static_cast<llama_pos>(count - 1)) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "resident attention prefix is incomplete");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    return SKIPPY_STATUS_OK;
+}
+
+skippy_status restore_checkpoint(skippy_session * session, int32_t cache_seq_id,
+        const llama_token * tokens, size_t count, skippy_error ** error) {
+    const auto valid = validate_session(session, cache_seq_id, error);
+    if (valid != SKIPPY_STATUS_OK) { return valid; }
+    std::lock_guard<std::mutex> lock(session->stage_model->resident_prefix_mutex);
+    const auto status = validate_checkpoint(session, cache_seq_id, tokens, count, error);
+    if (status != SKIPPY_STATUS_OK) { return status; }
+    // Allocate history before clearing live state. Checkpoint bytes stay immutable
+    // while each restoring lane receives its own mutable recurrent row.
+    std::vector<llama_token> history;
+    if (count) { history.assign(tokens, tokens + count); }
+    skippy_synchronize_context_if_pending(session->stage_model);
+    auto * memory = session->ctx->get_memory();
+    if (!memory->seq_rm(session->seq_id, -1, -1)) {
+        throw std::runtime_error("failed to clear execution lane for resident prefix");
+    }
+    const auto & checkpoint = session->stage_model->resident_prefixes.at(cache_seq_id);
+    try {
+        if (auto * recurrent = skippy_memory_recurrent_adapter(memory)) {
+            checkpoint_reader reader(checkpoint.recurrent);
+            recurrent->state_read(reader, session->seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+            if (reader.n_bytes() != checkpoint.recurrent.size()) {
+                throw std::runtime_error("resident recurrent checkpoint has trailing data");
+            }
+        }
+        if (auto * attention = attention_memory(memory)) {
+            if (count) { attention->seq_cp(cache_seq_id, session->seq_id, 0, static_cast<llama_pos>(count)); }
+        }
+    } catch (...) {
+        memory->seq_rm(session->seq_id, -1, -1);
+        session->n_past = 0;
+        session->token_history.clear();
+        throw;
+    }
+    session->n_past = static_cast<int32_t>(count);
+    session->token_history = std::move(history);
+    session->signal_history.clear();
+    skippy_mtp_clear_session_state(session);
+    session->verify_checkpoints.clear();
+    return skippy_success(error);
+}
+
+skippy_status native_error(skippy_error ** error, const std::exception & exception) {
+    skippy_set_error(error, SKIPPY_STATUS_RUNTIME_ERROR, exception.what());
+    return SKIPPY_STATUS_RUNTIME_ERROR;
+}
+
+bool used_attention_cells(llama_memory_t memory, uint64_t * cells) {
+    if (!memory) { *cells = 0; return true; }
+    if (auto * kv = dynamic_cast<llama_kv_cache *>(memory)) {
+        *cells = kv->get_used_cells();
+        return true;
+    }
+    if (auto * iswa = dynamic_cast<llama_kv_cache_iswa *>(memory)) {
+        *cells = std::max(iswa->get_base()->get_used_cells(), iswa->get_swa()->get_used_cells());
+        return true;
+    }
+    return false;
+}
+
+} // namespace
+
+extern "C" {
+
+enum skippy_status skippy_session_save_prefix(skippy_session * session, int32_t cache_seq_id,
+        uint64_t token_count, skippy_error ** error) {
+    const auto status = validate_session(session, cache_seq_id, error);
+    if (status != SKIPPY_STATUS_OK) { return status; }
+    if (token_count == 0 || token_count > static_cast<uint64_t>(std::max(session->n_past, 0))
+            || token_count > session->token_history.size()
+            || (skippy_memory_recurrent_adapter(session->ctx->get_memory())
+                && token_count != static_cast<uint64_t>(session->n_past))) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "resident save requires an available exact checkpoint boundary");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        std::lock_guard<std::mutex> lock(session->stage_model->resident_prefix_mutex);
+        auto & checkpoints = session->stage_model->resident_prefixes;
+        const auto previous = checkpoints.find(cache_seq_id);
+        if (previous != checkpoints.end()) {
+            if (previous->second.tokens.size() == token_count
+                    && std::equal(previous->second.tokens.begin(), previous->second.tokens.end(), session->token_history.begin())) {
+                return skippy_success(error);
+            }
+            skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "resident cache sequence already owns a different prefix");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        skippy_resident_checkpoint checkpoint;
+        checkpoint.tokens.assign(session->token_history.begin(), session->token_history.begin() + token_count);
+        skippy_synchronize_context_if_pending(session->stage_model);
+        auto * memory = session->ctx->get_memory();
+        if (auto * recurrent = skippy_memory_recurrent_adapter(memory)) {
+            recurrent_buffer_writer measure;
+            recurrent->state_write(measure, session->seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+            checkpoint_writer writer;
+            writer.payload.reserve(measure.n_bytes());
+            recurrent->state_write(writer, session->seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+            checkpoint.recurrent = std::move(writer.payload);
+        }
+        // Allocate metadata first. On allocation failure during seq_cp, remove
+        // every partially attached attention reference and unpublished map node.
+        auto [entry, inserted] = checkpoints.try_emplace(cache_seq_id);
+        GGML_ASSERT(inserted);
+        auto * attention = attention_memory(memory);
+        try {
+            if (attention) {
+                attention->seq_cp(session->seq_id, cache_seq_id, 0, static_cast<llama_pos>(token_count));
+            }
+            entry->second = std::move(checkpoint);
+        } catch (...) {
+            if (attention) { attention->seq_rm(cache_seq_id, -1, -1); }
+            checkpoints.erase(entry);
+            throw;
+        }
+        return skippy_success(error);
+    } catch (const std::exception & exception) { return native_error(error, exception); }
+}
+
+enum skippy_status skippy_session_restore_prefix(skippy_session * session, int32_t cache_seq_id,
+        const llama_token * tokens, size_t count, skippy_error ** error) {
+    try { return restore_checkpoint(session, cache_seq_id, tokens, count, error); }
+    catch (const std::exception & exception) { return native_error(error, exception); }
+}
+
+enum skippy_status skippy_session_create_from_resident_prefix(skippy_model * model, int32_t cache_seq_id,
+        const llama_token * tokens, size_t count, skippy_session ** output, skippy_error ** error) {
+    if (!model || !model->ctx || !output) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "model and output session are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    *output = nullptr;
+    skippy_session * session = nullptr;
+    auto status = skippy_session_create(model, &session, error);
+    if (status != SKIPPY_STATUS_OK) { return status; }
+    status = skippy_session_restore_prefix(session, cache_seq_id, tokens, count, error);
+    if (status != SKIPPY_STATUS_OK) {
+        skippy_session_free(session, nullptr);
+        return status;
+    }
+    *output = session;
+    return skippy_success(error);
+}
+
+enum skippy_status skippy_session_drop_sequence(skippy_session * session, int32_t cache_seq_id,
+        skippy_error ** error) {
+    try {
+        const auto status = validate_session(session, cache_seq_id, error);
+        if (status != SKIPPY_STATUS_OK) { return status; }
+        std::lock_guard<std::mutex> lock(session->stage_model->resident_prefix_mutex);
+        skippy_synchronize_context_if_pending(session->stage_model);
+        if (auto * attention = attention_memory(session->ctx->get_memory())) {
+            if (!attention->seq_rm(cache_seq_id, -1, -1)) {
+                skippy_set_error(error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to drop resident attention prefix");
+                return SKIPPY_STATUS_RUNTIME_ERROR;
+            }
+        }
+        session->stage_model->resident_prefixes.erase(cache_seq_id);
+        return skippy_success(error);
+    } catch (const std::exception & exception) { return native_error(error, exception); }
+}
+
+enum skippy_status skippy_session_resident_prefix_bytes(skippy_session * session, int32_t cache_seq_id,
+        uint64_t * output, skippy_error ** error) {
+    try {
+        if (!output) {
+            skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "resident byte count output is required");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        *output = 0;
+        const auto status = validate_session(session, cache_seq_id, error);
+        if (status != SKIPPY_STATUS_OK) { return status; }
+        std::lock_guard<std::mutex> lock(session->stage_model->resident_prefix_mutex);
+        const auto & checkpoints = session->stage_model->resident_prefixes;
+        const auto found = checkpoints.find(cache_seq_id);
+        if (found != checkpoints.end()) {
+            *output = found->second.recurrent.capacity() + found->second.tokens.capacity() * sizeof(llama_token);
+        }
+        return skippy_success(error);
+    } catch (const std::exception & exception) { return native_error(error, exception); }
+}
+
+enum skippy_status skippy_session_memory_used_cells(skippy_session * session, uint64_t * output,
+        skippy_error ** error) {
+    if (!session || !session->ctx || !output) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "session and cell count output are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    *output = 0;
+    if (!used_attention_cells(attention_memory(session->ctx->get_memory()), output)) {
+        skippy_set_error(error, SKIPPY_STATUS_UNSUPPORTED, "attention occupancy is unavailable for this memory type");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    return skippy_success(error);
+}
+
+enum skippy_status skippy_export_recurrent_state(skippy_session * session, void * output,
+        size_t capacity, size_t * bytes, skippy_error ** error) {
+    if (!session || !session->ctx || !bytes) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "session and recurrent byte count are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    *bytes = 0;
+    try {
+        auto * recurrent = skippy_memory_recurrent_adapter(session->ctx->get_memory());
+        if (!recurrent) { return skippy_success(error); }
+        skippy_synchronize_context_if_pending(session->stage_model);
+        recurrent_buffer_writer measure;
+        recurrent->state_write(measure, session->seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        *bytes = measure.n_bytes();
+        if (!output || capacity < *bytes) {
+            skippy_set_error(error, SKIPPY_STATUS_BUFFER_TOO_SMALL, "recurrent output buffer is too small");
+            return SKIPPY_STATUS_BUFFER_TOO_SMALL;
+        }
+        recurrent_buffer_writer writer(output, capacity);
+        recurrent->state_write(writer, session->seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        return skippy_success(error);
+    } catch (const std::exception & exception) { return native_error(error, exception); }
+}
+
+enum skippy_status skippy_import_recurrent_state(skippy_session * session, const void * input,
+        size_t bytes, skippy_error ** error) {
+    if (!bytes) { return skippy_success(error); }
+    if (!session || !session->ctx || !input) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "session and recurrent payload are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    try {
+        auto * recurrent = skippy_memory_recurrent_adapter(session->ctx->get_memory());
+        if (!recurrent) {
+            skippy_set_error(error, SKIPPY_STATUS_UNSUPPORTED, "runtime has no recurrent memory");
+            return SKIPPY_STATUS_UNSUPPORTED;
+        }
+        skippy_synchronize_context_if_pending(session->stage_model);
+        checkpoint_reader reader(static_cast<const uint8_t *>(input), bytes);
+        recurrent->state_read(reader, session->seq_id, LLAMA_STATE_SEQ_FLAGS_NONE);
+        if (reader.n_bytes() != bytes) {
+            throw std::runtime_error("recurrent checkpoint has trailing data");
+        }
+        return skippy_success(error);
+    } catch (const std::exception & exception) { return native_error(error, exception); }
+}
+
+enum skippy_status skippy_session_export_resident_recurrent_state(skippy_session * session,
+        int32_t cache_seq_id, void * output, size_t capacity, size_t * bytes, skippy_error ** error) {
+    if (!bytes) {
+        skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "recurrent byte count is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    *bytes = 0;
+    const auto valid = validate_session(session, cache_seq_id, error);
+    if (valid != SKIPPY_STATUS_OK) { return valid; }
+    try {
+        std::lock_guard<std::mutex> lock(session->stage_model->resident_prefix_mutex);
+        const auto found = session->stage_model->resident_prefixes.find(cache_seq_id);
+        if (found == session->stage_model->resident_prefixes.end()) {
+            skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "resident checkpoint is unavailable");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        const auto & payload = found->second.recurrent;
+        *bytes = payload.size();
+        if (payload.empty()) { return skippy_success(error); }
+        if (!output || capacity < payload.size()) {
+            skippy_set_error(error, SKIPPY_STATUS_BUFFER_TOO_SMALL, "recurrent output buffer is too small");
+            return SKIPPY_STATUS_BUFFER_TOO_SMALL;
+        }
+        std::memcpy(output, payload.data(), payload.size());
+        return skippy_success(error);
+    } catch (const std::exception & exception) { return native_error(error, exception); }
+}
+
+enum skippy_status skippy_session_export_resident_kv_page(skippy_session * session,
+        int32_t cache_seq_id, int32_t layer_start, int32_t layer_end,
+        uint64_t token_start, uint64_t token_count, skippy_kv_page_desc * descriptor,
+        void * output, size_t capacity, size_t * bytes, skippy_error ** error) {
+    if (bytes) { *bytes = 0; }
+    const auto valid = validate_session(session, cache_seq_id, error);
+    if (valid != SKIPPY_STATUS_OK) { return valid; }
+    try {
+        std::lock_guard<std::mutex> lock(session->stage_model->resident_prefix_mutex);
+        const auto found = session->stage_model->resident_prefixes.find(cache_seq_id);
+        if (found == session->stage_model->resident_prefixes.end()
+                || token_start > found->second.tokens.size()
+                || token_count > found->second.tokens.size() - token_start) {
+            skippy_set_error(error, SKIPPY_STATUS_INVALID_ARGUMENT, "resident KV export exceeds the saved prefix");
+            return SKIPPY_STATUS_INVALID_ARGUMENT;
+        }
+        // This stack view neither claims an execution lane nor changes its
+        // state. Only the explicitly requested cold payload is materialized.
+        skippy_session view{};
+        view.stage_model = session->stage_model;
+        view.ctx = session->ctx;
+        view.seq_id = cache_seq_id;
+        view.n_past = static_cast<int32_t>(found->second.tokens.size());
+        return skippy_export_kv_page(&view, layer_start, layer_end, token_start,
+                token_count, descriptor, output, capacity, bytes, error);
+    } catch (const std::exception & exception) { return native_error(error, exception); }
+}
