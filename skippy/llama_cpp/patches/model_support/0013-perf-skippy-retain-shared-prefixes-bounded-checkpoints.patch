             // skip the tile entirely if all the masks are -inf
             if (mask) {
@@ -9326,7 +9342,7 @@ static void ggml_compute_forward_flash_attn_ext_tiled(
             // Pack K tile transposed: K_f32[dk][kv] so KV_TILE is contiguous (SIMD dim)
