+
+int result_class(float value) {
+    if (std::isfinite(value)) { return 0; }
+    if (std::isnan(value)) { return 1; }
+    return std::signbit(value) ? 3 : 2;
+}
+
+void exceptional_result_control(const std::vector<float> & ordinary, const std::vector<float> & rows,
+        const inputs & data, const char * backend, int phase) {
+    std::array<size_t, 4> ordinary_classes{}, rows_classes{};
+    size_t mismatches = 0, elements = 0;
+    for (int64_t request = 0; request < requests; ++request) {
+        for (int64_t query = 0; query < data.spec.queries; ++query) {
+            if (!exceptional_query(data, request, query)) { continue; }
+            const size_t begin = (request*data.spec.queries + query)*data.spec.heads*data.spec.dv;
+            for (size_t i = begin; i < begin + data.spec.heads*data.spec.dv; ++i) {
+                const int left = result_class(ordinary[i]), right = result_class(rows[i]);
+                ++ordinary_classes[left]; ++rows_classes[right];
+                mismatches += left != right; ++elements;
+            }
+        }
+    }
+    if (!elements) { return; }
+    std::printf("EXCEPTIONAL_RESULT backend=%s phase=%d elements=%zu ordinary_finite_nan_posinf_neginf=%zu,%zu,%zu,%zu rows_finite_nan_posinf_neginf=%zu,%zu,%zu,%zu class_mismatches=%zu no_finite_qualification=1\n",
