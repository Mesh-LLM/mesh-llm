+bool exceptional_query(const inputs & data, int64_t request, int64_t query) {
+    if (data.spec.sinks) { return false; }
+    const auto begin = data.mask.begin() + (request*data.mask_queries + query)*data.spec.logical_rows;
+    return std::all_of(begin, begin + data.spec.logical_rows,
+            [](ggml_fp16_t value) { return ggml_fp16_to_fp32(value) == -INFINITY; });
