+int skippy_test_resident_checkpoint_gpu(const char * model_path, skippy_runtime_config config) {
+    REQUIRE(model_path && *model_path && config.n_gpu_layers > 0);
+    const size_t count = prefix_tokens();
+    config.ctx_size = static_cast<int32_t>(count + pressure_tokens + suffix_steps + 64);
+    config.lane_count = lanes;
+    config.kv_unified = 1;
+    config.n_batch = 512;
+    config.n_ubatch = 512;
+    skippy_model * model = nullptr;
+    skippy_error * error = nullptr;
+    auto status = skippy_model_open(model_path, &config, &model, &error);
+    ok(status, error);
+    require_gpu_weights(model);
+    REQUIRE(config.ctx_size <= llama_model_n_ctx_train(model->model));
+    const auto capabilities = skippy_model_memory_cache_capabilities(model);
+    REQUIRE(capabilities & SKIPPY_MEMORY_CACHE_RESIDENT_ATTENTION);
+    REQUIRE(capabilities & SKIPPY_MEMORY_CACHE_RESIDENT_CHECKPOINT);
+    const int32_t vocab_size = llama_vocab_n_tokens(llama_model_get_vocab(model->model));
+    const auto prefixes = tokens(count, vocab_size, 0);
+    auto source = create(model);
+    prefill(source, prefixes);
+    save(source, count);
+    std::array<Components, lanes> expected;
+    for (size_t lane = 0; lane < lanes; ++lane) { expected[lane] = components(source[lane]); }
+    const auto reference = decode_fixed_suffix(source, vocab_size);
+    release(source);
+
+    auto pressure = create(model);
+    prefill(pressure, tokens(pressure_tokens, vocab_size, 503));
+    release(pressure);
+    auto warm = restore(model, prefixes);
+    for (size_t lane = 0; lane < lanes; ++lane) {
+        const auto restored = components(warm[lane]);
+        std::fprintf(stderr, "checkpoint lane=%zu tokens=%zu kv_bytes=%zu recurrent_bytes=%zu kv_exact=%d recurrent_exact=%d\n",
+                lane, count, restored.kv.size(), restored.recurrent.size(),
+                restored.kv == expected[lane].kv, restored.recurrent == expected[lane].recurrent);
+        REQUIRE(restored.kv == expected[lane].kv);
+        REQUIRE(restored.recurrent == expected[lane].recurrent);
+    }
+    const auto restored_trace = decode_fixed_suffix(warm, vocab_size);
+    const bool passed = compare("resident restore vs reference", reference, restored_trace);
+    for (size_t lane = 0; lane < lanes; ++lane) {
+        error = nullptr;
+        status = skippy_session_drop_sequence(warm[0], static_cast<int32_t>(8 + lane), &error);
+        ok(status, error);
+    }
+    release(warm);
+    if (!passed) {
+        // Preserve the strict failure. A same-shape second cold reference
+        // distinguishes backend drift before any tolerance change is proposed.
+        auto repeated = create(model);
+        prefill(repeated, prefixes);
+        compare("cold reference vs repeated cold reference", reference, decode_fixed_suffix(repeated, vocab_size));
+        release(repeated);
+    }
+    error = nullptr;
+    status = skippy_model_free(model, &error);
+    ok(status, error);
+    return passed ? 0 : 1;
+}
