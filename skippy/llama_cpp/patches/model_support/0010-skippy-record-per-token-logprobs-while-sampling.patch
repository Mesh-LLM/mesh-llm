 #define SKIPPY_SAMPLING_FLAG_IGNORE_EOS (1u << 1)
+/** Record each sampled token's log-probability and top_logprobs alternatives (skippy/logprobs.h). */
+#define SKIPPY_SAMPLING_FLAG_LOGPROBS (1u << 2)
 
 enum skippy_sampler_type {
     SKIPPY_SAMPLER_PENALTIES = 1,
@@ -67,6 +69,8 @@ struct skippy_sampling_config {
     llama_logit_bias logit_bias[SKIPPY_MAX_LOGIT_BIAS];
