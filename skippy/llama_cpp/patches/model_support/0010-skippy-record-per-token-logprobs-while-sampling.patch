diff --git a/include/skippy/logprobs.h b/include/skippy/logprobs.h
new file mode 100644
index 000000000..c7f4ab5cd
--- /dev/null
+++ b/include/skippy/logprobs.h
@@ -0,0 +1,60 @@
+#ifndef SKIPPY_LOGPROBS_H
+#define SKIPPY_LOGPROBS_H
+
+/**
+ * @file skippy/logprobs.h
+ * @brief Per-token log-probabilities recorded while sampling, for OpenAI-style logprobs.
+ *
+ * A decode call whose sampling config sets SKIPPY_SAMPLING_FLAG_LOGPROBS records,
+ * for every token it samples, the token's log-probability and the most likely
+ * alternatives. The distribution is the model's raw one: softmax of the logits
+ * at temperature 1, before penalties, truncation or temperature, which is what
+ * OpenAI-compatible clients and output verifiers compare against.
+ */
+
+#include "runtime.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** @brief Most alternatives recorded per token (OpenAI's top_logprobs limit). */
+#define SKIPPY_MAX_TOP_LOGPROBS 20
+
+/** @brief One candidate token and its log-probability. */
+struct skippy_logprob_entry {
+    int32_t token;
+    float logprob;
+};
+
+/** @brief Log-probabilities recorded for one sampled token. */
+struct skippy_token_logprobs {
+    /** The sampled token. */
+    int32_t token;
+    /** Its log-probability; NaN when the logits row was not available. */
+    float logprob;
+    /** Number of valid entries in top, most likely first. */
+    uint32_t top_count;
+    struct skippy_logprob_entry top[SKIPPY_MAX_TOP_LOGPROBS];
+};
+
+/**
+ * @brief Moves recorded per-token log-probabilities out of the session, oldest first.
+ *
+ * Copies up to capacity entries into out_entries and removes them from the
+ * session. With out_entries NULL or capacity 0, nothing is removed and
+ * out_count receives the number of pending entries. Entries are also dropped
+ * when the session resets.
+ */
+LLAMA_API enum skippy_status skippy_session_take_token_logprobs(
+        struct skippy_session * session,
+        struct skippy_token_logprobs * out_entries,
+        size_t capacity,
+        size_t * out_count,
+        struct skippy_error ** out_error);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SKIPPY_LOGPROBS_H
