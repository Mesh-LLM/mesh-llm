             skippy_sampling_configs_equal(session->sampling_config, *sampling)) {
         return true;
@@ -813,6 +817,8 @@ void skippy_refresh_backend_sampling(
             session->sampling_chain != nullptr &&
             session->grammar_sampler == nullptr &&
