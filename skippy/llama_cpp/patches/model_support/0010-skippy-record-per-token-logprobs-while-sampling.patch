@@ -971,10 +977,29 @@ bool skippy_init_chat_reasoning_budget_sampler(
     return true;
 }
 
+static llama_token skippy_sample_token_ith_impl(
+        skippy_session * session,
+        const skippy_sampling_config * sampling,
+        int32_t logits_index);
+
 llama_token skippy_sample_token_ith(
         skippy_session * session,
         const skippy_sampling_config * sampling,
         int32_t logits_index) {
+    // A logprobs request does not attach backend (in-graph) sampling, but a lane
+    // may still carry a sampler a previous request attached, until this call
+    // detaches it. Such a decode skipped copying the raw logits row, so that
+    // token's entry is recorded as unreadable rather than read from a stale row.
+    const bool raw_logits_valid = session == nullptr || !session->sampling_backend_enabled;
+    const llama_token token = skippy_sample_token_ith_impl(session, sampling, logits_index);
+    skippy_record_token_logprobs(session, sampling, logits_index, token, raw_logits_valid);
+    return token;
+}
+
+static llama_token skippy_sample_token_ith_impl(
+        skippy_session * session,
+        const skippy_sampling_config * sampling,
+        int32_t logits_index) {
     if (session == nullptr || session->ctx == nullptr ||
             session->stage_model == nullptr || session->stage_model->model == nullptr) {
         return 0;
