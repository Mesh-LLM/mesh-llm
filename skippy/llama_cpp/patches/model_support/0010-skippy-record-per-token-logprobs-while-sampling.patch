diff --git a/src/skippy/logprobs.cpp b/src/skippy/logprobs.cpp
new file mode 100644
index 000000000..43260dfc2
--- /dev/null
+++ b/src/skippy/logprobs.cpp
@@ -0,0 +1,94 @@
+#include "errors.h"
+#include "runtime_types.h"
+#include "sampling_internal.h"
+
+#include <algorithm>
+#include <cmath>
+#include <limits>
+
+bool skippy_sampling_wants_logprobs(const skippy_sampling_config * sampling) {
+    return sampling != nullptr && sampling->version != 0 &&
+           (sampling->flags & SKIPPY_SAMPLING_FLAG_LOGPROBS) != 0;
+}
+
+void skippy_record_token_logprobs(
+        skippy_session * session,
+        const skippy_sampling_config * sampling,
+        int32_t logits_index,
+        llama_token token,
+        bool raw_logits_valid) {
+    if (session == nullptr || session->ctx == nullptr || session->stage_model == nullptr ||
+            !skippy_sampling_wants_logprobs(sampling)) {
+        return;
+    }
+    skippy_token_logprobs entry = {};
+    entry.token = token;
+    entry.logprob = std::numeric_limits<float>::quiet_NaN();
+
+    const llama_vocab * vocab = llama_model_get_vocab(session->stage_model->model);
+    const int32_t n_vocab = llama_vocab_n_tokens(vocab);
+    const float * logits = raw_logits_valid ? llama_get_logits_ith(session->ctx, logits_index) : nullptr;
+    if (logits == nullptr || n_vocab <= 0 || token < 0 || token >= n_vocab) {
+        session->token_logprobs.push_back(entry);
+        return;
+    }
+
+    float max_logit = -std::numeric_limits<float>::infinity();
+    for (int32_t v = 0; v < n_vocab; ++v) {
+        max_logit = std::max(max_logit, logits[v]);
+    }
+    double sum_exp = 0.0;
+    for (int32_t v = 0; v < n_vocab; ++v) {
+        sum_exp += std::exp(static_cast<double>(logits[v] - max_logit));
+    }
+    if (!std::isfinite(max_logit) || !(sum_exp > 0.0) || !std::isfinite(sum_exp)) {
+        session->token_logprobs.push_back(entry);
+        return;
+    }
+    const double log_sum_exp = static_cast<double>(max_logit) + std::log(sum_exp);
+    entry.logprob = static_cast<float>(static_cast<double>(logits[token]) - log_sum_exp);
+
+    // Top-N by a bounded insertion: N is at most 20, and almost every logit
+    // falls below the current N-th best, so this is one pass over the row.
+    const uint32_t wanted = std::min<uint32_t>(sampling->top_logprobs, SKIPPY_MAX_TOP_LOGPROBS);
+    uint32_t count = 0;
+    for (int32_t v = 0; v < n_vocab && wanted > 0; ++v) {
+        const float logit = logits[v];
+        if (count == wanted && logit <= logits[entry.top[count - 1].token]) {
+            continue;
+        }
+        uint32_t at = count < wanted ? count++ : wanted - 1;
+        while (at > 0 && logits[entry.top[at - 1].token] < logit) {
+            entry.top[at] = entry.top[at - 1];
+            --at;
+        }
+        entry.top[at].token = v;
+    }
+    for (uint32_t i = 0; i < count; ++i) {
+        entry.top[i].logprob = static_cast<float>(static_cast<double>(logits[entry.top[i].token]) - log_sum_exp);
+    }
+    entry.top_count = count;
+    session->token_logprobs.push_back(entry);
+}
+
+enum skippy_status skippy_session_take_token_logprobs(
+        struct skippy_session * session,
+        struct skippy_token_logprobs * out_entries,
+        size_t capacity,
+        size_t * out_count,
+        struct skippy_error ** out_error) {
+    if (session == nullptr || out_count == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "session and out_count are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (out_entries == nullptr || capacity == 0) {
+        *out_count = session->token_logprobs.size();
+        return skippy_success(out_error);
+    }
+    const size_t taken = std::min(capacity, session->token_logprobs.size());
+    std::copy_n(session->token_logprobs.begin(), taken, out_entries);
+    session->token_logprobs.erase(session->token_logprobs.begin(),
+                                  session->token_logprobs.begin() + static_cast<std::ptrdiff_t>(taken));
+    *out_count = taken;
+    return skippy_success(out_error);
+}
