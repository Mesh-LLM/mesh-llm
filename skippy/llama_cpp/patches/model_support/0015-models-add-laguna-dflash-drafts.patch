+// Laguna drafters RMS-norm each captured target feature before fc: view the
+// concatenated input as [n_feat, n_aux, n_tokens], norm over n_feat and scale
+// by the stacked per-feature weights. Other drafters pass through.
+static ggml_tensor * build_dflash_aux_norm(llm_graph_context & g, const llama_model & model, ggml_tensor * cur) {
+    ggml_tensor * aux_norm = static_cast<const llama_model_dflash &>(model).aux_norm;
+    if (aux_norm == nullptr) {
+        return cur;
+    }
+    const int64_t n_aux    = aux_norm->ne[1];
+    const int64_t n_feat   = cur->ne[0] / n_aux;
+    const int64_t n_tokens = cur->ne[1];
+
+    cur = ggml_reshape_3d(g.ctx0, cur, n_feat, n_aux, n_tokens);
+    cur = ggml_rms_norm(g.ctx0, cur, g.hparams.f_norm_rms_eps);
+    cur = ggml_mul(g.ctx0, cur, aux_norm);
+    cur = ggml_reshape_2d(g.ctx0, cur, n_feat * n_aux, n_tokens);
+    g.cb(cur, "enc_aux_norm", -1);
+    return cur;
+}
