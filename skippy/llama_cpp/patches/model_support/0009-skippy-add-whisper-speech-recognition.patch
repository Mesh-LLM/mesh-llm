diff --git a/src/skippy/asr.cpp b/src/skippy/asr.cpp
new file mode 100644
index 000000000..1f7c048bc
--- /dev/null
+++ b/src/skippy/asr.cpp
@@ -0,0 +1,442 @@
+#include "skippy/asr.h"
+#include "skippy/errors.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <thread>
+#include <vector>
+
+#if defined(SKIPPY_HAS_WHISPER)
+#include "ggml-backend.h"
+#include "whisper.h"
+
+#include <mutex>
+#include <sys/stat.h>
+
+// Decoders only, with every symbol file-local so they cannot collide with
+// the miniaudio copy that mtmd-helper compiles the same way. MA_API does not
+// reach miniaudio's one global, so rename it.
+#define ma_atomic_global_lock skippy_asr_ma_atomic_global_lock
+#define MINIAUDIO_IMPLEMENTATION
+#define MA_NO_ENCODING
+#define MA_NO_DEVICE_IO
+#define MA_NO_RESOURCE_MANAGER
+#define MA_NO_NODE_GRAPH
+#define MA_NO_ENGINE
+#define MA_NO_GENERATION
+#define MA_API static
+#include "miniaudio/miniaudio.h"
+#endif
+
+struct skippy_asr_model {
+#if defined(SKIPPY_HAS_WHISPER)
+    whisper_context * context = nullptr;
+    uint64_t weights_bytes = 0;
+    bool on_accelerator = false;
+
+    ~skippy_asr_model() {
+        if (context != nullptr) {
+            whisper_free(context);
+        }
+    }
+#endif
+};
+
+struct skippy_asr_segment_text {
+    int64_t start_ms = 0;
+    int64_t end_ms = 0;
+    std::string text;
+    float no_speech_prob = 0.0f;
+};
+
+struct skippy_asr_result {
+    std::vector<skippy_asr_segment_text> segments;
+    std::string language;
+    double duration_seconds = 0.0;
+};
+
+namespace {
+
+enum skippy_status asr_fail(
+        skippy_error ** out_error,
+        enum skippy_status status,
+        const std::string & message) {
+    skippy_set_error(out_error, status, message.c_str());
+    return status;
+}
+
+// Runs one exported entry point inside the exception containment, so no C++
+// exception can unwind into the Rust caller.
+template <typename Body>
+enum skippy_status asr_entry(skippy_error ** out_error, Body && body) {
+    enum skippy_status status = SKIPPY_STATUS_RUNTIME_ERROR;
+    if (!skippy_contain_native_failure(out_error, [&] { status = body(); })) {
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    return status;
+}
+
+#if defined(SKIPPY_HAS_WHISPER)
+
+// whisper.cpp installs its own ggml logger while it opens backends. Point it
+// at whichever sink the runtime already gave ggml, so ASR logs land beside
+// llama's instead of replacing them.
+void route_whisper_logs() {
+    static std::mutex lock;
+    std::lock_guard<std::mutex> guard(lock);
+    ggml_log_callback callback = nullptr;
+    void * user_data = nullptr;
+    ggml_log_get(&callback, &user_data);
+    whisper_log_set(callback, user_data);
+}
+
+bool is_gpu(ggml_backend_dev_t dev) {
+    const enum ggml_backend_dev_type type = ggml_backend_dev_type(dev);
+    return type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU;
+}
+
+// whisper.cpp selects a GPU by its position among GPU devices, so translate
+// the Laya-style device name into that ordinal.
+enum skippy_status resolve_device(
+        const char * device,
+        whisper_context_params & params,
+        bool & on_accelerator,
+        skippy_error ** out_error) {
+    params.use_gpu = false;
+    params.gpu_device = 0;
+    on_accelerator = false;
+    const std::string name = device == nullptr ? "" : device;
+    if (name.empty()) {
+        return skippy_success(out_error);
+    }
+    int ordinal = 0;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+        if (!is_gpu(dev)) {
+            if (name == ggml_backend_dev_name(dev)) {
+                return skippy_success(out_error);
+            }
+            continue;
+        }
+        if (name == "auto" || name == ggml_backend_dev_name(dev)) {
+            params.use_gpu = true;
+            params.gpu_device = ordinal;
+            on_accelerator = true;
+            return skippy_success(out_error);
+        }
+        ++ordinal;
+    }
+    if (name == "auto") {
+        return skippy_success(out_error);
+    }
+    return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "unknown ggml backend device '" + name + "'");
+}
+
+uint64_t file_bytes(const char * path) {
+    struct stat info {};
+    return stat(path, &info) == 0 ? static_cast<uint64_t>(info.st_size) : 0;
+}
+
+bool decode_audio(const uint8_t * data, size_t len, std::vector<float> & samples) {
+    ma_decoder_config config = ma_decoder_config_init(ma_format_f32, 1, SKIPPY_ASR_SAMPLE_RATE);
+    ma_decoder decoder;
+    if (ma_decoder_init_memory(data, len, &config, &decoder) != MA_SUCCESS) {
+        return false;
+    }
+    // Read in chunks: VBR MP3 cannot always report its length up front.
+    constexpr ma_uint64 chunk = SKIPPY_ASR_SAMPLE_RATE;
+    bool ok = true;
+    for (;;) {
+        const size_t offset = samples.size();
+        samples.resize(offset + chunk);
+        ma_uint64 read = 0;
+        const ma_result result = ma_decoder_read_pcm_frames(&decoder, samples.data() + offset, chunk, &read);
+        samples.resize(offset + read);
+        if (result == MA_AT_END || (result == MA_SUCCESS && read < chunk)) {
+            break;
+        }
+        if (result != MA_SUCCESS) {
+            ok = false;
+            break;
+        }
+    }
+    ma_decoder_uninit(&decoder);
+    return ok;
+}
+
+bool is_supported_container(const uint8_t * data, size_t len) {
+    if (len < 12) {
+        return false;
+    }
+    const bool wav = std::memcmp(data, "RIFF", 4) == 0 && std::memcmp(data + 8, "WAVE", 4) == 0;
+    const bool mp3 = std::memcmp(data, "ID3", 3) == 0 || (data[0] == 0xFF && (data[1] & 0xE0) == 0xE0);
+    const bool flac = std::memcmp(data, "fLaC", 4) == 0;
+    return wav || mp3 || flac;
+}
+
+struct abort_bridge {
+    skippy_asr_abort_callback callback;
+    void * user_data;
+};
+
+bool whisper_abort(void * data) {
+    const auto * bridge = static_cast<const abort_bridge *>(data);
+    return bridge->callback(bridge->user_data);
+}
+
+struct state_deleter {
+    void operator()(whisper_state * state) const { whisper_free_state(state); }
+};
+
+#endif
+
+enum skippy_status unsupported(skippy_error ** out_error) {
+    return asr_fail(out_error, SKIPPY_STATUS_UNSUPPORTED, "this runtime was built without speech recognition");
+}
+
+} // namespace
+
+extern "C" enum skippy_status skippy_asr_model_open(
+        const char * model_path,
+        const char * device,
+        struct skippy_asr_model ** out_model,
+        struct skippy_error ** out_error) {
+    if (model_path == nullptr || out_model == nullptr) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model_path and out_model are required");
+    }
+    *out_model = nullptr;
+#if defined(SKIPPY_HAS_WHISPER)
+    return asr_entry(out_error, [&] {
+        whisper_context_params params = whisper_context_default_params();
+        params.flash_attn = true;
+        bool on_accelerator = false;
+        const enum skippy_status status = resolve_device(device, params, on_accelerator, out_error);
+        if (status != SKIPPY_STATUS_OK) {
+            return status;
+        }
+        route_whisper_logs();
+        auto model = std::make_unique<skippy_asr_model>();
+        model->context = whisper_init_from_file_with_params_no_state(model_path, params);
+        if (model->context == nullptr) {
+            return asr_fail(out_error, SKIPPY_STATUS_MODEL_ERROR,
+                    std::string("failed to load Whisper model from ") + model_path);
+        }
+        model->weights_bytes = file_bytes(model_path);
+        model->on_accelerator = on_accelerator;
+        *out_model = model.release();
+        return skippy_success(out_error);
+    });
+#else
+    (void) device;
+    return unsupported(out_error);
+#endif
+}
+
+extern "C" void skippy_asr_model_free(struct skippy_asr_model * model) {
+    delete model;
+}
+
+extern "C" enum skippy_status skippy_asr_model_info_v1(
+        const struct skippy_asr_model * model,
+        struct skippy_asr_info_v1 * out_info,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || out_info == nullptr) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model and out_info are required");
+    }
+    if (out_info->struct_size < sizeof(skippy_asr_info_v1) ||
+            out_info->abi_version != SKIPPY_ASR_INFO_V1_ABI_VERSION) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "unsupported skippy_asr_info_v1 layout");
+    }
+#if defined(SKIPPY_HAS_WHISPER)
+    whisper_context * ctx = model->context;
+    out_info->multilingual = whisper_is_multilingual(ctx) != 0;
+    out_info->n_vocab = whisper_model_n_vocab(ctx);
+    out_info->n_audio_layer = whisper_model_n_audio_layer(ctx);
+    out_info->n_text_layer = whisper_model_n_text_layer(ctx);
+    out_info->n_mels = whisper_model_n_mels(ctx);
+    out_info->weights_bytes = model->weights_bytes;
+    out_info->on_accelerator = model->on_accelerator;
+    return skippy_success(out_error);
+#else
+    return unsupported(out_error);
+#endif
+}
+
+extern "C" enum skippy_status skippy_asr_decode_audio(
+        const uint8_t * data,
+        size_t len,
+        float ** out_samples,
+        size_t * out_sample_count,
+        struct skippy_error ** out_error) {
+    if (data == nullptr || out_samples == nullptr || out_sample_count == nullptr) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "data, out_samples, and out_sample_count are required");
+    }
+    *out_samples = nullptr;
+    *out_sample_count = 0;
+#if defined(SKIPPY_HAS_WHISPER)
+    return asr_entry(out_error, [&] {
+        if (!is_supported_container(data, len)) {
+            return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                    "unsupported audio format; send WAV, MP3, or FLAC");
+        }
+        std::vector<float> samples;
+        if (!decode_audio(data, len, samples)) {
+            return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "failed to decode the audio upload");
+        }
+        if (samples.empty()) {
+            return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "the audio upload holds no samples");
+        }
+        auto * owned = static_cast<float *>(std::malloc(samples.size() * sizeof(float)));
+        if (owned == nullptr) {
+            return asr_fail(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "out of memory decoding audio");
+        }
+        std::memcpy(owned, samples.data(), samples.size() * sizeof(float));
+        *out_samples = owned;
+        *out_sample_count = samples.size();
+        return skippy_success(out_error);
+    });
+#else
+    (void) len;
+    return unsupported(out_error);
+#endif
+}
+
+extern "C" void skippy_asr_samples_free(float * samples) {
+    std::free(samples);
+}
+
+extern "C" enum skippy_status skippy_asr_transcribe(
+        struct skippy_asr_model * model,
+        const float * samples,
+        size_t sample_count,
+        const struct skippy_asr_transcribe_params_v1 * params,
+        skippy_asr_abort_callback abort_callback,
+        void * abort_user_data,
+        struct skippy_asr_result ** out_result,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || samples == nullptr || params == nullptr || out_result == nullptr) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model, samples, params, and out_result are required");
+    }
+    *out_result = nullptr;
+    if (params->struct_size < sizeof(skippy_asr_transcribe_params_v1) ||
+            params->abi_version != SKIPPY_ASR_TRANSCRIBE_PARAMS_V1_ABI_VERSION) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "unsupported skippy_asr_transcribe_params_v1 layout");
+    }
+    if (sample_count == 0 || sample_count > static_cast<size_t>(INT32_MAX)) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "sample_count must be between 1 and INT32_MAX");
+    }
+#if defined(SKIPPY_HAS_WHISPER)
+    return asr_entry(out_error, [&] {
+        whisper_context * ctx = model->context;
+        std::string language = params->language == nullptr ? "" : params->language;
+        if (language.empty()) {
+            language = "auto";
+        }
+        if (language != "auto" && whisper_lang_id(language.c_str()) < 0) {
+            return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "unknown language '" + language + "'");
+        }
+        if (!whisper_is_multilingual(ctx) && (params->translate || (language != "auto" && language != "en"))) {
+            return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                    "this Whisper model is English-only; it cannot translate or transcribe '" + language + "'");
+        }
+
+        whisper_full_params full = whisper_full_default_params(WHISPER_SAMPLING_GREEDY);
+        full.n_threads = params->n_threads > 0
+                ? params->n_threads
+                : static_cast<int>(std::min(4u, std::max(1u, std::thread::hardware_concurrency())));
+        full.translate = params->translate;
+        full.language = whisper_is_multilingual(ctx) ? language.c_str() : "en";
+        full.detect_language = false;
+        full.initial_prompt = params->prompt != nullptr && params->prompt[0] != '\0' ? params->prompt : nullptr;
+        full.temperature = std::max(0.0f, params->temperature);
+        full.print_progress = false;
+        full.print_realtime = false;
+        full.print_special = false;
+        full.print_timestamps = false;
+        abort_bridge bridge{abort_callback, abort_user_data};
+        if (abort_callback != nullptr) {
+            full.abort_callback = whisper_abort;
+            full.abort_callback_user_data = &bridge;
+        }
+
+        std::unique_ptr<whisper_state, state_deleter> state(whisper_init_state(ctx));
+        if (!state) {
+            return asr_fail(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to allocate Whisper decoder state");
+        }
+        const int rc = whisper_full_with_state(ctx, state.get(), full, samples, static_cast<int>(sample_count));
+        if (abort_callback != nullptr && abort_callback(abort_user_data)) {
+            return asr_fail(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "transcription cancelled");
+        }
+        if (rc != 0) {
+            return asr_fail(out_error, SKIPPY_STATUS_RUNTIME_ERROR,
+                    "Whisper transcription failed with code " + std::to_string(rc));
+        }
+
+        auto result = std::make_unique<skippy_asr_result>();
+        const int n_segments = whisper_full_n_segments_from_state(state.get());
+        result->segments.reserve(static_cast<size_t>(std::max(0, n_segments)));
+        for (int i = 0; i < n_segments; ++i) {
+            skippy_asr_segment_text segment;
+            // whisper.cpp reports segment bounds in 10 ms ticks.
+            segment.start_ms = whisper_full_get_segment_t0_from_state(state.get(), i) * 10;
+            segment.end_ms = whisper_full_get_segment_t1_from_state(state.get(), i) * 10;
+            segment.text = whisper_full_get_segment_text_from_state(state.get(), i);
+            segment.no_speech_prob = whisper_full_get_segment_no_speech_prob_from_state(state.get(), i);
+            result->segments.push_back(std::move(segment));
+        }
+        const int lang_id = whisper_full_lang_id_from_state(state.get());
+        const char * lang = lang_id >= 0 ? whisper_lang_str(lang_id) : nullptr;
+        result->language = lang != nullptr ? lang : (language == "auto" ? "" : language);
+        result->duration_seconds = static_cast<double>(sample_count) / SKIPPY_ASR_SAMPLE_RATE;
+        *out_result = result.release();
+        return skippy_success(out_error);
+    });
+#else
+    (void) abort_callback;
+    (void) abort_user_data;
+    return unsupported(out_error);
+#endif
+}
+
+extern "C" size_t skippy_asr_result_segment_count(const struct skippy_asr_result * result) {
+    return result == nullptr ? 0 : result->segments.size();
+}
+
+extern "C" enum skippy_status skippy_asr_result_segment_v1(
+        const struct skippy_asr_result * result,
+        size_t index,
+        struct skippy_asr_segment_v1 * out_segment,
+        struct skippy_error ** out_error) {
+    if (result == nullptr || out_segment == nullptr) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "result and out_segment are required");
+    }
+    if (out_segment->struct_size < sizeof(skippy_asr_segment_v1) ||
+            out_segment->abi_version != SKIPPY_ASR_SEGMENT_V1_ABI_VERSION) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "unsupported skippy_asr_segment_v1 layout");
+    }
+    if (index >= result->segments.size()) {
+        return asr_fail(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "segment index out of range");
+    }
+    const skippy_asr_segment_text & segment = result->segments[index];
+    out_segment->start_ms = segment.start_ms;
+    out_segment->end_ms = segment.end_ms;
+    out_segment->text = segment.text.c_str();
+    out_segment->no_speech_prob = segment.no_speech_prob;
+    return skippy_success(out_error);
+}
+
+extern "C" const char * skippy_asr_result_language(const struct skippy_asr_result * result) {
+    return result == nullptr ? "" : result->language.c_str();
+}
+
+extern "C" double skippy_asr_result_duration_seconds(const struct skippy_asr_result * result) {
+    return result == nullptr ? 0.0 : result->duration_seconds;
+}
+
+extern "C" void skippy_asr_result_free(struct skippy_asr_result * result) {
+    delete result;
+}
