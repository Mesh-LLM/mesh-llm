diff --git a/include/skippy/asr.h b/include/skippy/asr.h
new file mode 100644
index 000000000..24bbc6f6b
--- /dev/null
+++ b/include/skippy/asr.h
@@ -0,0 +1,165 @@
+#ifndef SKIPPY_ASR_H
+#define SKIPPY_ASR_H
+
+/**
+ * @file skippy/asr.h
+ * @brief Full-model speech recognition (Whisper) over uploaded audio.
+ *
+ * An ASR model does not load through `skippy_model_open`; it owns its
+ * whisper.cpp model file and runs on the runtime's ggml backends. Callers
+ * decode an upload to 16 kHz mono PCM with `skippy_asr_decode_audio`, then
+ * transcribe or translate it with `skippy_asr_transcribe`. Each transcription
+ * holds its own decoder state, so calls on one model may run concurrently.
+ *
+ * Runtimes built without whisper.cpp still export every symbol; they leave
+ * SKIPPY_FEATURE_SPEECH_RECOGNITION clear and fail calls with
+ * SKIPPY_STATUS_UNSUPPORTED.
+ */
+
+#include "common.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SKIPPY_ASR_INFO_V1_ABI_VERSION 1
+#define SKIPPY_ASR_TRANSCRIBE_PARAMS_V1_ABI_VERSION 1
+#define SKIPPY_ASR_SEGMENT_V1_ABI_VERSION 1
+/** Sample rate of the PCM that `skippy_asr_decode_audio` returns. */
+#define SKIPPY_ASR_SAMPLE_RATE 16000
+
+struct skippy_asr_model;
+struct skippy_asr_result;
+
+/** @brief Shape and memory of an opened ASR model. */
+struct skippy_asr_info_v1 {
+    uint32_t struct_size;
+    uint32_t abi_version;
+    bool     multilingual;     /**< false for English-only (`.en`) models */
+    int32_t  n_vocab;
+    int32_t  n_audio_layer;
+    int32_t  n_text_layer;
+    int32_t  n_mels;
+    uint64_t weights_bytes;    /**< the model file's tensor data */
+    bool     on_accelerator;   /**< weights live on a non-CPU device */
+};
+
+/** @brief Options for one transcription. Zero values select the defaults. */
+struct skippy_asr_transcribe_params_v1 {
+    uint32_t struct_size;
+    uint32_t abi_version;
+    /** ISO 639-1 code such as "en"; NULL, "" or "auto" detects the language. */
+    const char * language;
+    /** Translate the speech into English instead of transcribing it. */
+    bool translate;
+    /** Optional text that conditions the first window, such as vocabulary. */
+    const char * prompt;
+    /** 0 decodes greedily; above 0 samples, with fallback on low confidence. */
+    float temperature;
+    /** CPU threads for the parts that run on the CPU; 0 picks a default. */
+    int32_t n_threads;
+};
+
+/** @brief One timed segment of a transcription. */
+struct skippy_asr_segment_v1 {
+    uint32_t struct_size;
+    uint32_t abi_version;
+    int64_t  start_ms;
+    int64_t  end_ms;
+    /** UTF-8 text, owned by the result and valid until it is freed. */
+    const char * text;
+    /** Probability that the segment holds no speech. */
+    float    no_speech_prob;
+};
+
+/** @brief Polled between decoder steps; returning true cancels the call. */
+typedef bool (*skippy_asr_abort_callback)(void * user_data);
+
+/**
+ * @brief Opens a whisper.cpp model file (`ggml-*.bin`).
+ *
+ * `device` follows `skippy_laya_model_open`: NULL or "" is the CPU backend,
+ * "auto" is the first GPU device when one exists, and any other value names a
+ * ggml backend device such as "CUDA0" or "MTL0". Fails with
+ * SKIPPY_STATUS_UNSUPPORTED when the runtime was built without whisper.cpp,
+ * and with SKIPPY_STATUS_MODEL_ERROR when the file is not a Whisper model.
+ */
+LLAMA_API enum skippy_status skippy_asr_model_open(
+        const char * model_path,
+        const char * device,
+        struct skippy_asr_model ** out_model,
+        struct skippy_error ** out_error);
+
+/** @brief Releases a model returned by `skippy_asr_model_open`. */
+LLAMA_API void skippy_asr_model_free(struct skippy_asr_model * model);
+
+/**
+ * @brief Reports the model's shape and weight memory.
+ *
+ * `out_info` must be initialized with its `struct_size` and `abi_version`.
+ */
+LLAMA_API enum skippy_status skippy_asr_model_info_v1(
+        const struct skippy_asr_model * model,
+        struct skippy_asr_info_v1 * out_info,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Decodes a WAV, MP3, or FLAC upload to 16 kHz mono float PCM.
+ *
+ * Returns SKIPPY_STATUS_INVALID_ARGUMENT for any other container. Free
+ * `*out_samples` with `skippy_asr_samples_free`.
+ */
+LLAMA_API enum skippy_status skippy_asr_decode_audio(
+        const uint8_t * data,
+        size_t len,
+        float ** out_samples,
+        size_t * out_sample_count,
+        struct skippy_error ** out_error);
+
+/** @brief Releases samples returned by `skippy_asr_decode_audio`. */
+LLAMA_API void skippy_asr_samples_free(float * samples);
+
+/**
+ * @brief Transcribes 16 kHz mono PCM.
+ *
+ * `params` must be initialized with its `struct_size` and `abi_version`.
+ * `abort_callback` may be NULL. A cancelled call fails with
+ * SKIPPY_STATUS_RUNTIME_ERROR and returns no result.
+ */
+LLAMA_API enum skippy_status skippy_asr_transcribe(
+        struct skippy_asr_model * model,
+        const float * samples,
+        size_t sample_count,
+        const struct skippy_asr_transcribe_params_v1 * params,
+        skippy_asr_abort_callback abort_callback,
+        void * abort_user_data,
+        struct skippy_asr_result ** out_result,
+        struct skippy_error ** out_error);
+
+/** @brief Number of segments in a transcription. */
+LLAMA_API size_t skippy_asr_result_segment_count(const struct skippy_asr_result * result);
+
+/**
+ * @brief Reads one segment. `out_segment` must be initialized with its
+ * `struct_size` and `abi_version`.
+ */
+LLAMA_API enum skippy_status skippy_asr_result_segment_v1(
+        const struct skippy_asr_result * result,
+        size_t index,
+        struct skippy_asr_segment_v1 * out_segment,
+        struct skippy_error ** out_error);
+
+/** @brief ISO 639-1 code of the spoken language, owned by the result. */
+LLAMA_API const char * skippy_asr_result_language(const struct skippy_asr_result * result);
+
+/** @brief Seconds of audio the result covers. */
+LLAMA_API double skippy_asr_result_duration_seconds(const struct skippy_asr_result * result);
+
+/** @brief Releases a result returned by `skippy_asr_transcribe`. */
+LLAMA_API void skippy_asr_result_free(struct skippy_asr_result * result);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SKIPPY_ASR_H
