+set_source_files_properties(skippy/asr.cpp PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+
 configure_file(llama-version.h.in ${CMAKE_CURRENT_BINARY_DIR}/llama-version.h @ONLY)
 
 target_include_directories(llama PRIVATE . ../common ../tools/laya ${CMAKE_CURRENT_BINARY_DIR})
@@ -118,6 +123,28 @@ target_compile_features   (llama PRIVATE cxx_std_17) # don't bump
 
 target_link_libraries(llama PUBLIC ggml)
 
+# Speech recognition: whisper.cpp built on this tree's ggml targets rather
+# than its own copy, and folded into libllama. Without a source directory the
+# skippy_asr_* entry points stay exported and report UNSUPPORTED.
+set(SKIPPY_WHISPER_SOURCE_DIR "" CACHE PATH "whisper.cpp source tree to build speech recognition from")
+target_include_directories(llama PRIVATE ../vendor)
+if (SKIPPY_WHISPER_SOURCE_DIR)
+    # Satisfy whisper.cpp's find_package(ggml) with the in-tree targets.
+    file(WRITE ${CMAKE_FIND_PACKAGE_REDIRECTS_DIR}/ggml-config.cmake "")
+    set(WHISPER_USE_SYSTEM_GGML ON  CACHE BOOL "" FORCE)
+    set(WHISPER_BUILD_EXAMPLES  OFF CACHE BOOL "" FORCE)
+    set(WHISPER_BUILD_TESTS     OFF CACHE BOOL "" FORCE)
+    set(WHISPER_BUILD_SERVER    OFF CACHE BOOL "" FORCE)
+    set(WHISPER_ALL_WARNINGS    OFF CACHE BOOL "" FORCE)
+    set(SKIPPY_SAVED_BUILD_SHARED_LIBS ${BUILD_SHARED_LIBS})
+    set(BUILD_SHARED_LIBS OFF)
+    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+    add_subdirectory(${SKIPPY_WHISPER_SOURCE_DIR} ${CMAKE_BINARY_DIR}/whisper EXCLUDE_FROM_ALL)
+    set(BUILD_SHARED_LIBS ${SKIPPY_SAVED_BUILD_SHARED_LIBS})
+    target_link_libraries(llama PRIVATE whisper)
+    target_compile_definitions(llama PRIVATE SKIPPY_HAS_WHISPER)
+endif()
+
 if (LLAMA_STAGE_BUILD_TESTS)
     target_compile_definitions(llama PRIVATE LLAMA_STAGE_BUILD_TESTS)
 
