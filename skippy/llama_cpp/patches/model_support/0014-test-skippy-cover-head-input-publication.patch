+            std::strcmp(argv[1], "--layer-inputs") == 0) {
         llama_backend_init();
-        const int rc = check_layer_inputs(argv[2]);
+        const int rc = check_layer_inputs(argv[2], argc == 4);
         llama_backend_free();
         return rc;
     }
