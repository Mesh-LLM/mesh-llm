+static int check_head_input_published(const char * model_path, bool expected) {
+    llama_model_params model_params = llama_model_default_params();
+    model_params.n_gpu_layers = 0;
+    model_params.load_mtp = true;
+    llama_model * model = llama_model_load_from_file(model_path, model_params);
+    if (model == nullptr) return 140;
+    const uint32_t n_layer = (uint32_t) llama_model_n_layer(model);
+    int rc = 0;
+    for (uint32_t n_seq_max : {1u, 2u}) {
+        llama_context * ctx = llama_init_from_model(model, make_context_params(n_seq_max));
+        if (ctx == nullptr) {
+            rc = 141;
+            break;
+        }
+        if (!llama_layer_inp_published(ctx, 0)) {
+            std::fprintf(stderr, "layer 0 input is not published (n_seq_max %u)\n", n_seq_max);
+            rc = 142;
+        }
+        const bool published = llama_layer_inp_published(ctx, n_layer);
+        if (rc == 0 && published != expected) {
+            std::fprintf(stderr, "head input published = %d, expected %d (n_seq_max %u)\n",
+                    published, expected, n_seq_max);
+            rc = 143;
+        }
+        if (rc == 0) {
+            std::atomic<bool> start{false};
+            int decode_status = -1;
+            std::thread decoder([&] {
+                while (!start.load(std::memory_order_acquire)) std::this_thread::yield();
+                llama_token token = 1;
+                decode_status = llama_decode(ctx, llama_batch_get_one(&token, 1));
+            });
+            start.store(true, std::memory_order_release);
+            const bool during_decode = llama_layer_inp_published(ctx, n_layer);
+            decoder.join();
+            if (decode_status != 0 || during_decode != expected) {
+                std::fprintf(stderr, "head input probe overlapped a failed decode (n_seq_max %u)\n", n_seq_max);
+                rc = 144;
+            }
+        }
+        llama_free(ctx);
+        if (rc != 0) break;
+    }
+    llama_model_free(model);
+    return rc;
+}
+
 // A split stage captures the input of each drafter target layer it runs,
 // except its first layer when that input arrives from the previous stage.
-// The realized stage graph must keep every such capture.
