     llama_model_params model_params = llama_model_default_params();
     model_params.n_gpu_layers = 0;
     model_params.load_mtp = true;
     llama_model * model = llama_model_load_from_file(model_path, model_params);
     const int32_t n_layer = model == nullptr ? 0 : llama_model_n_layer(model);
-    if (n_layer < 44) {
+    std::vector<int32_t> targets = {6, 15, 25, 34, 43};
+    std::vector<std::vector<int32_t>> splits = {
+        {0, 23, n_layer}, {0, 11, 23, 34, n_layer},
+    };
+    if (targets_csv != nullptr) {
+        targets.clear();
+        const std::string list = targets_csv;
+        for (size_t pos = 0;;) {
+            const size_t comma = list.find(',', pos);
+            const std::string token = list.substr(pos, comma - pos);
+            int32_t layer = 0;
+            const auto [end, error] = std::from_chars(token.data(), token.data() + token.size(), layer);
+            if (error != std::errc{} || end != token.data() + token.size()) {
+                llama_model_free(model);
+                return 130;
+            }
+            targets.push_back(layer);
+            if (comma == std::string::npos) break;
+            pos = comma + 1;
+        }
+        splits = {{0, n_layer / 2, n_layer}, {0, n_layer / 4, n_layer / 2, 3 * n_layer / 4, n_layer}};
+    }
+    const bool targets_in_range = std::all_of(targets.begin(), targets.end(),
+            [n_layer](int32_t layer) { return layer >= 0 && layer <= n_layer; });
+    if (n_layer < 4 || targets.empty() || !targets_in_range) {
         llama_model_free(model);
         return 130;
     }
-    // GLM-5.3-Flash's DFlash draft targets, on its two- and four-stage cuts.
-    const int32_t targets[] = {6, 15, 25, 34, 43};
-    const std::vector<std::vector<int32_t>> splits = {
-        {0, 23, n_layer}, {0, 11, 23, 34, n_layer},
-    };
     int rc = 0;
     for (const auto & cuts : splits) {
         for (size_t stage = 0; rc == 0 && stage + 1 < cuts.size(); ++stage) {
@@ -992,7 +1062,8 @@ static int check_stage_layer_inputs(const char * model_path) {
             }
             std::vector<int32_t> captured;
             for (int32_t layer : targets) {
-                if (layer >= start && layer < end && (layer != start || start == 0)) {
+                const bool computed = (layer >= start && layer < end) || (layer == n_layer && end == n_layer);
+                if (computed && (layer != start || start == 0)) {
                     captured.push_back(layer);
                     context->set_embeddings_layer_inp(layer, true);
                 }
@@ -1033,15 +1104,22 @@ int main(int argc, char ** argv) {
     if (argc == 2 && std::strcmp(argv[1], "--input-width") == 0) {
         return check_decode_input_width();
     }
-    if (argc == 3 && std::strcmp(argv[1], "--stage-layer-inputs") == 0) {
+    if ((argc == 3 || argc == 4) && std::strcmp(argv[1], "--stage-layer-inputs") == 0) {
+        llama_backend_init();
+        const int rc = check_stage_layer_inputs(argv[2], argc == 4 ? argv[3] : nullptr);
+        llama_backend_free();
+        return rc;
+    }
+    if (argc == 4 && std::strcmp(argv[1], "--head-input-published") == 0) {
         llama_backend_init();
-        const int rc = check_stage_layer_inputs(argv[2]);
+        const int rc = check_head_input_published(argv[2], std::strcmp(argv[3], "1") == 0);
         llama_backend_free();
         return rc;
     }
-    if (argc == 3 && std::strcmp(argv[1], "--layer-inputs") == 0) {
