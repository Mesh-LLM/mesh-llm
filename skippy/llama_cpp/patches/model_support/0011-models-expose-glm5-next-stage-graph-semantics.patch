+// Speculative drafters capture the residual entering each trunk layer. Every
+// layer must publish a finite input row per token, and distinct layers must
+// not alias one tensor.
+static int check_layer_inputs(const char * model_path) {
+    llama_model_params model_params = llama_model_default_params();
+    model_params.n_gpu_layers = 0;
+    model_params.load_mtp = true; // the fixture carries a NextN block beside the trunk
+    llama_model * model = llama_model_load_from_file(model_path, model_params);
+    if (model == nullptr) return 120;
+    llama_context * ctx = llama_init_from_model(model, make_context_params(1));
+    if (ctx == nullptr) {
+        llama_model_free(model);
+        return 121;
+    }
+    const int32_t n_layer = llama_model_n_layer(model);
+    const int32_t n_embd = llama_model_n_embd(model);
+    for (int32_t il = 0; il < n_layer; ++il) {
+        llama_set_embeddings_layer_inp(ctx, il, true);
+    }
+    llama_token tokens[] = {1, 2, 3, 4};
+    const int32_t n_tokens = 4;
+    int rc = llama_decode(ctx, llama_batch_get_one(tokens, n_tokens)) == 0 ? 0 : 122;
+    std::vector<std::vector<float>> rows;
+    for (int32_t il = 0; rc == 0 && il < n_layer; ++il) {
+        const float * data = llama_get_embeddings_layer_inp(ctx, il);
+        if (data == nullptr) {
+            std::fprintf(stderr, "layer %d input was not captured\n", il);
+            rc = 123;
+            break;
+        }
+        std::vector<float> row(data, data + (size_t) n_embd * n_tokens);
+        bool nonzero = false;
+        for (float value : row) {
+            if (!std::isfinite(value)) {
+                std::fprintf(stderr, "layer %d input is not finite\n", il);
+                rc = 124;
+                break;
+            }
+            nonzero = nonzero || value != 0.0f;
+        }
+        if (rc == 0 && !nonzero) {
+            std::fprintf(stderr, "layer %d input is all zero\n", il);
+            rc = 125;
+        }
+        if (rc == 0 && !rows.empty() && rows.back() == row) {
+            std::fprintf(stderr, "layers %d and %d captured the same input\n", il - 1, il);
+            rc = 126;
+        }
+        rows.push_back(std::move(row));
+    }
+    llama_free(ctx);
+    llama_model_free(model);
+    return rc;
+}
+
+// A split stage captures the input of each drafter target layer it runs,
+// except its first layer when that input arrives from the previous stage.
+// The realized stage graph must keep every such capture.
+static int check_stage_layer_inputs(const char * model_path) {
+    llama_model_params model_params = llama_model_default_params();
+    model_params.n_gpu_layers = 0;
+    model_params.load_mtp = true;
+    llama_model * model = llama_model_load_from_file(model_path, model_params);
+    const int32_t n_layer = model == nullptr ? 0 : llama_model_n_layer(model);
+    if (n_layer < 44) {
+        llama_model_free(model);
+        return 130;
+    }
+    // GLM-5.3-Flash's DFlash draft targets, on its two- and four-stage cuts.
+    const int32_t targets[] = {6, 15, 25, 34, 43};
+    const std::vector<std::vector<int32_t>> splits = {
+        {0, 23, n_layer}, {0, 11, 23, 34, n_layer},
+    };
+    int rc = 0;
+    for (const auto & cuts : splits) {
+        for (size_t stage = 0; rc == 0 && stage + 1 < cuts.size(); ++stage) {
+            const int32_t start = cuts[stage];
+            const int32_t end = cuts[stage + 1];
+            skippy_graph_build_inputs inputs;
+            if (!make_stage_inputs(model, 1, start, end, inputs)) {
+                rc = 131;
+                break;
+            }
+            llama_context * context = llama_init_from_model_with_graph_inputs(
+                    model, make_context_params(1), inputs);
+            if (context == nullptr) {
+                rc = 132;
+                break;
+            }
+            std::vector<int32_t> captured;
+            for (int32_t layer : targets) {
+                if (layer >= start && layer < end && (layer != start || start == 0)) {
+                    captured.push_back(layer);
+                    context->set_embeddings_layer_inp(layer, true);
+                }
+            }
+            try {
+                context->sched_reserve(inputs);
+            } catch (const std::exception & error) {
+                std::fprintf(stderr, "stage %d..%d reserve failed: %s\n", start, end, error.what());
+                rc = 133;
+            }
+            const llm_graph_result * result = context->get_gf_res_reserve();
+            for (int32_t layer : captured) {
+                if (rc != 0) break;
+                const ggml_tensor * tensor = result == nullptr ? nullptr : result->get_layer_inp(layer);
+                bool in_graph = false;
+                for (int index = 0; tensor != nullptr && index < ggml_graph_n_nodes(result->get_gf()); ++index) {
+                    in_graph = in_graph || ggml_graph_node(result->get_gf(), index) == tensor;
+                }
+                if (!in_graph) {
+                    std::fprintf(stderr, "stage %d..%d dropped the input of target layer %d\n", start, end, layer);
+                    rc = 134;
+                }
+            }
+            llama_free(context);
+        }
+    }
+    llama_model_free(model);
+    return rc;
+}
+
