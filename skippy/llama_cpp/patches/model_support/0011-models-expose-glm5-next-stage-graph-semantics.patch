 src/models/glm5-next.cpp                    | 50 ++++++++++++++-------
 src/skippy/tests/graph_contract_cases.cmake | 13 ++++++
 tests/test-llama-archs.cpp                  |  9 +++-
 4 files changed, 63 insertions(+), 17 deletions(-)

