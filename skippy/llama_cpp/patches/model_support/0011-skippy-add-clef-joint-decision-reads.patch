diff --git a/include/skippy/clef.h b/include/skippy/clef.h
new file mode 100644
index 000000000..a2bb704e0
--- /dev/null
+++ b/include/skippy/clef.h
@@ -0,0 +1,144 @@
+#ifndef SKIPPY_CLEF_H
+#define SKIPPY_CLEF_H
+
+/**
+ * @file skippy/clef.h
+ * @brief Joint Clef decision reads (prompt rendering, decision order, one-pass scoring).
+ *
+ * Clef is a decision model whose head scores every option of every question
+ * of a request in one non-causal forward pass. It does not load through
+ * `skippy_model_open`; it owns its GGUF, tokenizer, `systemone` chat
+ * template, and an embeddings-mode execution context. The caller supplies the
+ * request as JSON in prompt order; the runtime renders the template, splits
+ * the prompt on the Clef separator, tokenizes each piece, marks the decision
+ * order of every token, decodes the whole prompt in one micro-batch, and
+ * returns one raw score per option. Temperature and softmax stay on the
+ * caller side (see `skippy_clef_model_decision_metadata`).
+ */
+
+#include "common.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SKIPPY_CLEF_INFO_V1_ABI_VERSION 1
+
+struct skippy_clef_model;
+
+/** @brief Decision-order marks assigned to prompt tokens, as the head reads them. */
+enum skippy_clef_order {
+    SKIPPY_CLEF_ORDER_NONE            = 0,
+    SKIPPY_CLEF_ORDER_QUESTION_NOUL   = 1,
+    SKIPPY_CLEF_ORDER_QUESTION_CHOICE = 2,
+    SKIPPY_CLEF_ORDER_QUESTION_SCORE  = 3,
+    SKIPPY_CLEF_ORDER_OPTION          = 4,
+};
+
+/** @brief Sizes and budgets of an opened Clef model. */
+struct skippy_clef_info_v1 {
+    uint32_t struct_size;
+    uint32_t abi_version;
+    int32_t  n_ctx;            /**< tokens one read may span; also the micro-batch size */
+    int32_t  n_embd;
+    int32_t  n_layer;
+    int32_t  n_vocab;
+    int64_t  parameter_count;
+    uint64_t model_bytes;      /**< weight bytes as loaded */
+    /** Number of `<arch>.decision.*` metadata entries, see `skippy_clef_model_decision_metadata`. */
+    uint32_t decision_metadata_count;
+    /** `<arch>.decision.type`, NUL-terminated and truncated to the field. */
+    char     decision_type[32];
+};
+
+/**
+ * @brief Opens a Clef GGUF with an embeddings-mode context; not a `skippy_model`.
+ *
+ * `n_ctx` bounds the tokens of one request and sizes the single micro-batch
+ * that reads it. `n_gpu_layers` follows llama.cpp (negative offloads all
+ * layers). Fails with SKIPPY_STATUS_MODEL_ERROR when the GGUF is not a Clef
+ * decision model or has no `systemone` chat template.
+ */
+LLAMA_API enum skippy_status skippy_clef_model_open(
+        const char * model_path,
+        int32_t n_ctx,
+        int32_t n_threads,
+        int32_t n_gpu_layers,
+        struct skippy_clef_model ** out_model,
+        struct skippy_error ** out_error);
+
+/** @brief Releases a model returned by `skippy_clef_model_open`. */
+LLAMA_API void skippy_clef_model_free(struct skippy_clef_model * model);
+
+/**
+ * @brief Reports the model's sizes, decision type, and metadata count.
+ *
+ * `out_info` must be initialized with its `struct_size` and `abi_version`.
+ */
+LLAMA_API enum skippy_status skippy_clef_model_info_v1(
+        const struct skippy_clef_model * model,
+        struct skippy_clef_info_v1 * out_info,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Reads one `<arch>.decision.*` GGUF metadata entry by index.
+ *
+ * `out_key` receives the key suffix after `<arch>.decision.` (for example
+ * `temperature.choice.3_5` or `score_bias.5.2`) and `out_value` its string
+ * value; both are NUL-terminated and truncated to their capacities. Indices
+ * run over `decision_metadata_count` of `skippy_clef_info_v1`.
+ */
+LLAMA_API enum skippy_status skippy_clef_model_decision_metadata(
+        const struct skippy_clef_model * model,
+        uint32_t index,
+        char * out_key,
+        size_t key_capacity,
+        char * out_value,
+        size_t value_capacity,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Plans the prompt of a request: token ids with their decision order.
+ *
+ * `request_json` is `{"state": ..., "questions": [{"id", "type",
+ * "instructions", "options": [{"key", "description"}]}]}` with the questions
+ * and options in the order the caller wants the scores back. The runtime
+ * sorts object keys, escapes the Clef marker in the input, renders the
+ * `systemone` template, splits on the separator, and tokenizes each piece on
+ * its own without special tokens. Returns SKIPPY_STATUS_BUFFER_TOO_SMALL with
+ * `out_token_count` set to the required length when `capacity` is short.
+ */
+LLAMA_API enum skippy_status skippy_clef_plan(
+        const struct skippy_clef_model * model,
+        const char * request_json,
+        size_t request_len,
+        int32_t * out_tokens,
+        int32_t * out_orders,
+        size_t capacity,
+        size_t * out_token_count,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Scores every option of every question of a request in one pass.
+ *
+ * Plans the prompt like `skippy_clef_plan`, decodes it in one micro-batch,
+ * and writes one raw score per option in prompt order to `out_scores`. The
+ * head reports an unusable decision order as NaN, which fails the read with
+ * SKIPPY_STATUS_RUNTIME_ERROR. Calls are serialized per model. Returns
+ * SKIPPY_STATUS_BUFFER_TOO_SMALL with `out_score_count` set when `capacity`
+ * is short, and SKIPPY_STATUS_INVALID_ARGUMENT when the prompt exceeds `n_ctx`.
+ */
+LLAMA_API enum skippy_status skippy_clef_read(
+        struct skippy_clef_model * model,
+        const char * request_json,
+        size_t request_len,
+        float * out_scores,
+        size_t capacity,
+        size_t * out_score_count,
+        struct skippy_error ** out_error);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SKIPPY_CLEF_H
