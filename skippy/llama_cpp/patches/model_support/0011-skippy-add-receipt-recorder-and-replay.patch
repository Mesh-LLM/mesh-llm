+// The scratch context a model replays receipts in, created on first use.
+struct skippy_receipt_scratch {
+    std::mutex mutex;
+    llama_context * ctx = nullptr;
+    std::shared_ptr<skippy_receipt_capture> capture;
+
+    ~skippy_receipt_scratch() {
+        llama_free(ctx);
+    }
+};
+
+namespace {
+
+enum class matmul_role { attn_q, attn_k, attn_v, attn_output, ffn_gate, ffn_up, ffn_down };
+
+// Matches a weight by its GGUF name "blk.<layer>.<role>.weight".
+bool weight_role(const ggml_tensor * weight, int32_t & layer, matmul_role & role) {
+    if (weight == nullptr) {
+        return false;
+    }
+    const std::string name = weight->name;
+    static const std::string prefix = "blk.";
+    static const std::string suffix = ".weight";
+    if (name.size() <= prefix.size() + suffix.size() || name.compare(0, prefix.size(), prefix) != 0 ||
+            name.compare(name.size() - suffix.size(), suffix.size(), suffix) != 0) {
+        return false;
+    }
+    char * end = nullptr;
+    const long value = std::strtol(name.c_str() + prefix.size(), &end, 10);
+    if (end == name.c_str() + prefix.size() || *end != '.' || value < 0) {
+        return false;
+    }
+    static const std::map<std::string, matmul_role> roles = {
+        {"attn_q", matmul_role::attn_q},       {"attn_k", matmul_role::attn_k},
+        {"attn_v", matmul_role::attn_v},       {"attn_output", matmul_role::attn_output},
+        {"ffn_gate", matmul_role::ffn_gate},   {"ffn_up", matmul_role::ffn_up},
+        {"ffn_down", matmul_role::ffn_down},
+    };
+    const char * middle_start = end + 1;
+    const std::string middle(middle_start, name.c_str() + name.size() - suffix.size());
+    const auto found = roles.find(middle);
+    if (found == roles.end()) {
+        return false;
+    }
+    layer = static_cast<int32_t>(value);
+    role = found->second;
+    return true;
+}
+
+// The residual stream entering a layer: attn_q's input is rms_norm(x) * w.
+ggml_tensor * residual_of_attention_input(ggml_tensor * attn_in) {
+    if (attn_in == nullptr || attn_in->op != GGML_OP_MUL || attn_in->src[0] == nullptr ||
+            attn_in->src[0]->op != GGML_OP_RMS_NORM) {
+        return nullptr;
+    }
+    return attn_in->src[0]->src[0];
+}
+
+ggml_tensor * find_named(ggml_cgraph * gf, const std::string & name) {
+    for (int i = ggml_graph_n_nodes(gf) - 1; i >= 0; --i) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        if (name == node->name) {
+            return node;
+        }
+    }
+    return nullptr;
+}
+
+bool readable(const ggml_tensor * t) {
+    return (t->type == GGML_TYPE_F32 || t->type == GGML_TYPE_F16) && ggml_is_contiguous(t) &&
+           t->ne[2] == 1 && t->ne[3] == 1;
+}
+
+void keep_alive(ggml_tensor * t) {
+    ggml_set_output(t);
+    for (ggml_tensor * root = t->view_src; root != nullptr; root = root->view_src) {
+        ggml_set_output(root);
+    }
+}
+
+std::string find_targets(skippy_receipt_capture & capture, llm_graph_result & res) {
+    ggml_cgraph * gf = res.get_gf();
+    const bool extra = capture.extra_layer >= 0;
+    std::set<int32_t> layers;
+    std::map<int32_t, int> attention;  // q, k, v, attn_output seen per layer
+    auto add = [&](ggml_tensor * t, int32_t layer, int32_t kind) {
+        capture.targets.push_back({t, layer, kind});
+    };
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        int32_t layer = 0;
+        matmul_role role;
+        if (node->op != GGML_OP_MUL_MAT || !weight_role(node->src[0], layer, role)) {
+            continue;
+        }
+        layers.insert(layer);
+        const bool open = extra && layer == capture.extra_layer;
+        switch (role) {
+            case matmul_role::attn_q: {
+                ggml_tensor * x = residual_of_attention_input(node->src[1]);
+                if (x == nullptr) {
+                    return "layer " + std::to_string(layer) + " has no rms_norm attention input";
+                }
+                add(x, layer, SKIPPY_RECEIPT_TENSOR_RESIDUAL);
+                add(node, layer, SKIPPY_RECEIPT_TENSOR_ATTN_Q);
+                if (open) add(node->src[1], layer, SKIPPY_RECEIPT_TENSOR_ATTN_IN);
+                attention[layer] |= 1;
+                break;
+            }
+            case matmul_role::attn_k:
+                add(node, layer, SKIPPY_RECEIPT_TENSOR_ATTN_K);
+                attention[layer] |= 2;
+                break;
+            case matmul_role::attn_v:
+                add(node, layer, SKIPPY_RECEIPT_TENSOR_ATTN_V);
+                attention[layer] |= 4;
+                break;
+            case matmul_role::attn_output:
+                add(node->src[1], layer, SKIPPY_RECEIPT_TENSOR_ATTN_OUT);
+                if (open) add(node, layer, SKIPPY_RECEIPT_TENSOR_ATTN_PROJ);
+                attention[layer] |= 8;
+                break;
+            case matmul_role::ffn_gate:
+                if (open) {
+                    add(node->src[1], layer, SKIPPY_RECEIPT_TENSOR_FFN_IN);
+                    add(node, layer, SKIPPY_RECEIPT_TENSOR_FFN_GATE);
+                }
+                break;
+            case matmul_role::ffn_up:
+                if (open) add(node, layer, SKIPPY_RECEIPT_TENSOR_FFN_UP);
+                break;
+            case matmul_role::ffn_down:
+                if (open) {
+                    add(node->src[1], layer, SKIPPY_RECEIPT_TENSOR_FFN_DOWN_IN);
+                    add(node, layer, SKIPPY_RECEIPT_TENSOR_FFN_DOWN);
+                }
+                break;
+        }
+    }
+    if (layers.empty()) {
+        return "the graph has no blk.<layer> weight matmuls";
+    }
+    for (const int32_t layer : layers) {
+        if (attention[layer] != 15) {
+            return "layer " + std::to_string(layer) + " lacks separate attn_q, attn_k, attn_v and attn_output matmuls";
+        }
+    }
+    if (*layers.rbegin() - *layers.begin() + 1 != static_cast<int32_t>(layers.size())) {
+        return "the graph's layers are not contiguous";
+    }
+    const int32_t last = *layers.rbegin();
+    ggml_tensor * out = find_named(gf, "l_out-" + std::to_string(last));
+    if (out == nullptr) {
+        return "the graph has no l_out-" + std::to_string(last) + " stage output";
+    }
+    add(out, last + 1, SKIPPY_RECEIPT_TENSOR_RESIDUAL);
+
+    const auto & imports = res.get_skippy_activation_imports();
+    if (imports.size() > 1) {
+        return "a stage with more than one activation import";
+    }
+    if (imports.size() == 1) {
+        capture.input = imports.front().tensor;
+        if (capture.input == nullptr || !ggml_is_contiguous(capture.input) || capture.input->ne[2] != 1 ||
+                capture.input->ne[3] != 1) {
+            return "the activation import is not a contiguous row per token";
+        }
+    }
+    for (const auto & target : capture.targets) {
+        if (!readable(target.tensor)) {
+            return std::string("receipt tensor ") + target.tensor->name + " is not a contiguous f32 or f16 matrix";
+        }
+    }
+    return {};
+}
+
+}  // namespace
+
+void skippy_receipt_mark_graph(skippy_receipt_capture & capture, llm_graph_result & res) {
+    capture.targets.clear();
+    capture.input = nullptr;
+    capture.graph_error = find_targets(capture, res);
+    if (!capture.graph_error.empty()) {
+        capture.targets.clear();
+        capture.input = nullptr;
+        return;
+    }
+    for (const auto & target : capture.targets) {
+        keep_alive(target.tensor);
+    }
+    if (capture.input != nullptr) {
+        keep_alive(capture.input);
+    }
+}
+
+void skippy_receipt_mark_reserve_graph(const skippy_receipt_capture & capture, llm_graph_result & res) {
+    skippy_receipt_capture reserve;
+    reserve.extra_layer = capture.extra_layer;
+    skippy_receipt_mark_graph(reserve, res);
+}
+
+namespace {
+
+void report_error(skippy_receipt_capture & capture, const std::string & message) {
+    skippy_receipt_ubatch report = {};
+    report.step = capture.step;
+    report.error = message.c_str();
+    capture.on_ubatch(capture.user_data, &report);
+}
+
+ggml_backend_t tensor_backend(ggml_backend_sched_t sched, ggml_tensor * t) {
+    ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched, t);
+    if (backend == nullptr && t->view_src != nullptr) {
+        backend = ggml_backend_sched_get_tensor_backend(sched, t->view_src);
+    }
+    return backend;
+}
+
+// Host memory of at least `size` bytes for one ubatch's copies. Pinned memory
+// lets the device copies run asynchronously; it is kept and grown as needed.
+uint8_t * host_block(skippy_receipt_capture::host_copy & copy, ggml_backend_sched_t sched,
+        const std::vector<ggml_tensor *> & tensors, size_t size) {
+    if (copy.pinned && ggml_backend_buffer_get_size(copy.pinned.get()) >= size) {
+        return static_cast<uint8_t *>(ggml_backend_buffer_get_base(copy.pinned.get()));
+    }
+    copy.pinned.reset();
+    for (ggml_tensor * t : tensors) {
+        ggml_backend_t backend = tensor_backend(sched, t);
+        ggml_backend_dev_t dev = backend != nullptr ? ggml_backend_get_device(backend) : nullptr;
+        ggml_backend_buffer_type_t buft = dev != nullptr ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+        if (buft == nullptr) {
+            continue;
+        }
+        copy.pinned.reset(ggml_backend_buft_alloc_buffer(buft, size + size / 4));
+        if (copy.pinned) {
+            copy.pageable = {};
+            return static_cast<uint8_t *>(ggml_backend_buffer_get_base(copy.pinned.get()));
+        }
+        break;
+    }
+    copy.pageable.resize(size);
+    return copy.pageable.data();
+}
+
+// Starts an asynchronous copy of a tensor to host memory.
+void fetch(ggml_backend_sched_t sched, ggml_tensor * t, uint8_t * dst) {
+    ggml_backend_t backend = tensor_backend(sched, t);
+    if (backend != nullptr) {
+        ggml_backend_tensor_get_async(backend, t, dst, 0, ggml_nbytes(t));
+    } else {
+        ggml_backend_tensor_get(t, dst, 0, ggml_nbytes(t));
+    }
+}
+
+size_t aligned(size_t n) {
+    return (n + 63) & ~static_cast<size_t>(63);
+}
+
+}  // namespace
+
+void skippy_receipt_report_ubatch(
+        skippy_receipt_capture & capture,
+        ggml_backend_sched_t sched,
+        const llama_ubatch & ubatch,
+        llama_memory_context_i * mctx,
+        const llm_graph_result & res) {
+    GGML_UNUSED(res);
+    if (capture.on_ubatch == nullptr || !capture.report) {
+        return;
+    }
+    if (!capture.graph_error.empty()) {
+        report_error(capture, capture.graph_error);
+        return;
+    }
+    const auto * kv = dynamic_cast<const llama_kv_cache_context *>(mctx);
+    const std::vector<uint32_t> * cells = kv != nullptr ? kv->get_receipt_cells() : nullptr;
+    const uint32_t n = ubatch.n_tokens;
+    if (cells == nullptr || cells->size() != n) {
+        report_error(capture, "receipts need a plain KV cache with one stream");
+        return;
+    }
+    if (ubatch.pos == nullptr || ubatch.seq_id == nullptr || ubatch.output == nullptr) {
+        report_error(capture, "the ubatch has no positions, sequences or output flags");
+        return;
+    }
+    capture.token.resize(n);
+    capture.seq.resize(n);
+    capture.pos.resize(n);
+    capture.output.resize(n);
+    capture.cell.assign(cells->begin(), cells->end());
+    int64_t n_outputs = 0;
+    for (uint32_t i = 0; i < n; ++i) {
+        if (ubatch.n_seq_id[i] != 1) {
+            report_error(capture, "a token shared by several sequences cannot be receipted");
+            return;
+        }
+        capture.token[i] = ubatch.token != nullptr ? ubatch.token[i] : -1;
+        capture.seq[i] = ubatch.seq_id[i][0];
+        capture.pos[i] = ubatch.pos[i];
+        capture.output[i] = ubatch.output[i];
+        n_outputs += ubatch.output[i] != 0;
+    }
+    if (ubatch.token == nullptr && capture.input == nullptr) {
+        report_error(capture, "a ubatch of embeddings cannot be receipted");
+        return;
+    }
+
+    // Unique tensors: the first stage layer's residual can be the import itself.
+    std::vector<ggml_tensor *> unique;
+    std::vector<size_t> slot(capture.targets.size());
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        ggml_tensor * t = capture.targets[i].tensor;
+        size_t j = 0;
+        while (j < unique.size() && unique[j] != t) ++j;
+        if (j == unique.size()) unique.push_back(t);
+        slot[i] = j;
+    }
+    std::vector<size_t> offset(unique.size());
+    size_t size = 0;
+    for (size_t j = 0; j < unique.size(); ++j) {
+        offset[j] = size;
+        size += aligned(ggml_nbytes(unique[j]));
+    }
+    const size_t input_offset = size;
+    if (capture.input != nullptr) {
+        size += ggml_nbytes(capture.input);
+    }
+    auto & copy = capture.copies[capture.next_copy];
+    capture.next_copy ^= 1;
+    uint8_t * block = host_block(copy, sched, unique, size);
+    for (size_t j = 0; j < unique.size(); ++j) {
+        fetch(sched, unique[j], block + offset[j]);
+    }
+    if (capture.input != nullptr) {
+        fetch(sched, capture.input, block + input_offset);
+    }
+    ggml_backend_sched_synchronize(sched);
+
+    std::vector<const float *> values(unique.size());
+    copy.converted.resize(unique.size());
+    for (size_t j = 0; j < unique.size(); ++j) {
+        const ggml_tensor * t = unique[j];
+        if (t->type == GGML_TYPE_F32) {
+            values[j] = reinterpret_cast<const float *>(block + offset[j]);
+            continue;
+        }
+        auto & dst = copy.converted[j];
+        dst.resize(static_cast<size_t>(ggml_nelements(t)));
+        ggml_fp16_to_fp32_row(reinterpret_cast<const ggml_fp16_t *>(block + offset[j]), dst.data(),
+                ggml_nelements(t));
+        values[j] = dst.data();
+    }
+    std::vector<skippy_receipt_tensor> tensors;
+    tensors.reserve(capture.targets.size());
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        const ggml_tensor * t = capture.targets[i].tensor;
+        const int64_t n_cols = t->ne[1];
+        if (n_cols != static_cast<int64_t>(n) && n_cols != n_outputs) {
+            report_error(capture, std::string("receipt tensor ") + t->name + " has neither a column per token nor per output");
+            return;
+        }
+        tensors.push_back({capture.targets[i].layer, capture.targets[i].kind, t->ne[0], n_cols,
+                values[slot[i]]});
+    }
+
+    skippy_receipt_ubatch report = {};
+    report.step = capture.step;
+    report.n_tokens = static_cast<int32_t>(n);
+    report.token = capture.token.data();
+    report.seq = capture.seq.data();
+    report.pos = capture.pos.data();
+    report.output = capture.output.data();
+    report.cell = capture.cell.data();
+    report.n_kv = kv->get_n_kv();
+    if (capture.input != nullptr) {
+        report.input = block + input_offset;
+        report.input_row_bytes = static_cast<int64_t>(capture.input->nb[1]);
+        report.input_type = capture.input->type;
+    }
+    report.n_tensors = tensors.size();
+    report.tensors = tensors.data();
+    capture.on_ubatch(capture.user_data, &report);
+}
+
+namespace {
+
+llama_kv_cache * plain_kv_cache(llama_context * ctx) {
+    return dynamic_cast<llama_kv_cache *>(ctx->get_memory());
+}
+
+}  // namespace
+
+enum skippy_status skippy_model_set_receipt_recorder(
+        struct skippy_model * model,
+        skippy_receipt_ubatch_fn on_ubatch,
+        skippy_receipt_memory_fn on_memory,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->ctx == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model with a context is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    llama_kv_cache * kv = plain_kv_cache(model->ctx);
+    if (on_ubatch == nullptr && on_memory == nullptr) {
+        model->ctx->set_receipt_capture(nullptr);
+        if (kv != nullptr) {
+            kv->receipt_memory_observer = nullptr;
+        }
+        return skippy_success(out_error);
+    }
+    if (on_ubatch == nullptr || on_memory == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "both receipt callbacks are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (kv == nullptr || kv->get_n_stream() != 1) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED,
+                "receipts need a plain KV cache with one stream");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    if (model->mtp_ctx != nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "receipts do not support MTP stages yet");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    auto capture = std::make_shared<skippy_receipt_capture>();
+    capture->on_ubatch = on_ubatch;
+    capture->user_data = user_data;
+    kv->receipt_memory_observer = [on_memory, user_data](
+            int32_t op, llama_seq_id seq, llama_seq_id seq_dst, llama_pos p0, llama_pos p1) {
+        const skippy_receipt_memory_event event = {op, seq, seq_dst, p0, p1};
+        on_memory(user_data, &event);
+    };
+    model->ctx->set_receipt_capture(std::move(capture));
+    return skippy_success(out_error);
+}
+
+namespace {
+
+enum skippy_status ensure_scratch(skippy_model * model, skippy_receipt_scratch & scratch, skippy_error ** out_error) {
+    if (scratch.ctx != nullptr) {
+        return SKIPPY_STATUS_OK;
+    }
+    if (!model->has_receipt_ctx_params) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the stage context parameters were not kept");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    llama_context_params params = model->receipt_ctx_params;
+    params.cb_eval = nullptr;
+    params.cb_eval_user_data = nullptr;
+    params.samplers = nullptr;
+    params.n_samplers = 0;
+    scratch.ctx = llama_init_from_model_with_graph_inputs(
+            model->model, params, skippy_graph_build_inputs_from_config(&model->config));
+    if (scratch.ctx == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to create the receipt replay context");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (plain_kv_cache(scratch.ctx) == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the replay context has no plain KV cache");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    scratch.capture = std::make_shared<skippy_receipt_capture>();
+    scratch.ctx->set_receipt_capture(scratch.capture);
+    return SKIPPY_STATUS_OK;
+}
+
+enum skippy_status replay_decode(
+        skippy_model * model,
+        llama_context * ctx,
+        llama_kv_cache * kv,
+        const skippy_receipt_replay_step & step,
+        skippy_error ** out_error) {
+    const auto n = static_cast<size_t>(step.n_tokens);
+    std::vector<llama_token> tokens(step.token, step.token + n);
+    std::vector<llama_pos> positions(step.pos, step.pos + n);
+    std::vector<int32_t> n_seq_id(n, 1);
+    std::vector<llama_seq_id> seq_values(step.seq, step.seq + n);
+    std::vector<llama_seq_id *> seq_ids(n);
+    std::vector<int8_t> logits(step.output, step.output + n);
+    for (size_t i = 0; i < n; ++i) {
+        seq_ids[i] = &seq_values[i];
+    }
+    skippy_graph_build_inputs inputs = skippy_graph_build_inputs_from_config(&model->config);
+    skippy_graph_build_inputs_set_activation_tokens(inputs, tokens.data(), n);
+    if (step.input != nullptr) {
+        const size_t element = ggml_type_size(static_cast<ggml_type>(step.input_type));
+        skippy_activation_frontier_part_input part;
+        part.values = step.input;
+        part.payload_bytes = static_cast<uint64_t>(step.input_row_bytes) * n;
+        part.ggml_type = static_cast<uint32_t>(step.input_type);
+        part.rank = 2;
+        part.token_axis = 1;
+        part.dimensions[0] = step.input_row_bytes / static_cast<int64_t>(element);
+        part.dimensions[1] = static_cast<int64_t>(n);
+        part.byte_strides[0] = element;
+        part.byte_strides[1] = static_cast<uint64_t>(step.input_row_bytes);
+        part.pos_start = n > 0 ? step.pos[0] : 0;
+        inputs.activation_frontier.push_back(part);
+    }
+    llama_batch batch = {
+        step.n_tokens, tokens.data(), nullptr, positions.data(), n_seq_id.data(), seq_ids.data(), logits.data(),
+    };
+    kv->receipt_forced_cells.assign(step.cell, step.cell + n);
+    kv->receipt_forced_n_kv = step.n_kv;
+    int32_t rc = 0;
+    const bool contained = skippy_contain_native_failure(out_error, [&] { rc = ctx->decode(batch, inputs); });
+    kv->receipt_forced_cells.clear();
+    kv->receipt_forced_n_kv = 0;
+    if (!contained) {
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (rc != 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "a receipt replay step failed to decode");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    return SKIPPY_STATUS_OK;
+}
+
+}  // namespace
+
+enum skippy_status skippy_model_replay_receipt(
+        struct skippy_model * model,
+        int32_t seq,
+        int32_t layer,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->model == nullptr || (steps == nullptr && n_steps > 0) || on_capture == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model, steps and a capture callback are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (!model->receipt_scratch) {
+        model->receipt_scratch = std::make_shared<skippy_receipt_scratch>();
+    }
+    auto scratch = model->receipt_scratch;
+    std::lock_guard<std::mutex> lock(scratch->mutex);
+    enum skippy_status status = ensure_scratch(model, *scratch, out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    llama_context * ctx = scratch->ctx;
+    llama_kv_cache * kv = plain_kv_cache(ctx);
+    llama_memory_t memory = ctx->get_memory();
+    llama_memory_clear(memory, false);
+
+    auto & capture = *scratch->capture;
+    capture.on_ubatch = on_capture;
+    capture.user_data = user_data;
+    if (capture.extra_layer != layer) {
+        capture.extra_layer = layer;
+        // the next ubatch rebuilds its graph with this layer's matmuls marked
+        ctx->set_receipt_capture(scratch->capture);
+    }
+    for (size_t index = 0; index < n_steps && status == SKIPPY_STATUS_OK; ++index) {
+        const auto & step = steps[index];
+        if (step.kind == SKIPPY_RECEIPT_REPLAY_SEQ_RM) {
+            llama_memory_seq_rm(memory, seq, step.p0, step.p1);
+            continue;
+        }
+        if (step.kind != SKIPPY_RECEIPT_REPLAY_DECODE || step.n_tokens <= 0 || step.token == nullptr ||
+                step.seq == nullptr || step.pos == nullptr || step.output == nullptr || step.cell == nullptr) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "malformed receipt replay step");
+            status = SKIPPY_STATUS_INVALID_ARGUMENT;
+            break;
+        }
+        capture.step = static_cast<int64_t>(index);
+        capture.report = step.capture != 0;
+        status = replay_decode(model, ctx, kv, step, out_error);
+        std::set<llama_seq_id> foreign;
+        for (int32_t i = 0; i < step.n_tokens; ++i) {
+            if (step.seq[i] != seq) foreign.insert(step.seq[i]);
+        }
+        for (const llama_seq_id other : foreign) {
+            llama_memory_seq_rm(memory, other, -1, -1);
+        }
+    }
+    capture.on_ubatch = nullptr;
+    capture.user_data = nullptr;
+    llama_memory_clear(memory, false);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    return skippy_success(out_error);
+}
