 }
 
+void llama_context::set_receipt_capture(std::shared_ptr<skippy_receipt_capture> capture) {
+    receipt_capture = std::move(capture);
+    // the next ubatch rebuilds its graph, so the receipt tensors get marked, and
+    // the scheduler re-plans its allocation with them kept alive
+    gf_res_prev_active = nullptr;
+    sched_need_reserve = true;
+}
+
 void llama_context::set_abort_callback(bool (*abort_callback)(void * data), void * abort_callback_data) {
     LLAMA_LOG_DEBUG("%s: call\n", __func__);
 
@@ -1675,6 +1684,10 @@ llm_graph_result * llama_context::process_ubatch(
             return nullptr;
         }
 
+        if (receipt_capture) {
+            skippy_receipt_mark_graph(*receipt_capture, *res, ubatch.n_tokens);
+        }
+
         if (!ggml_backend_sched_alloc_graph(sched.get(), gf)) {
             LLAMA_LOG_ERROR("%s: failed to allocate graph\n", __func__);
             ret = GGML_STATUS_ALLOC_FAILED;
@@ -1694,6 +1707,10 @@ llm_graph_result * llama_context::process_ubatch(
         //LLAMA_LOG_INFO("graph set inputs time: %.3f ms\n", (ggml_time_us() - t_start_us)/1000.0);
     }
 
+    if (receipt_capture) {
+        skippy_receipt_begin_compute(*receipt_capture);
+    }
+
     const auto status = graph_compute(res->get_gf(), ubatch.n_tokens > 1);
     if (status != GGML_STATUS_SUCCESS) {
         LLAMA_LOG_ERROR("%s: failed to compute graph, compute status: %d\n", __func__, status);
@@ -1701,6 +1718,10 @@ llm_graph_result * llama_context::process_ubatch(
         return nullptr;
     }
 
+    if (receipt_capture) {
+        skippy_receipt_report_ubatch(*receipt_capture, sched.get(), ubatch, mctx, *res);
+    }
+
     ret = GGML_STATUS_SUCCESS;
 
     return res;
@@ -2892,6 +2913,10 @@ ggml_cgraph * llama_context::graph_reserve(uint32_t                          n_t
     res->reset();
 
     auto * gf = model.build_graph(gparams);
+    if (gf && receipt_capture) {
+        // the allocation planned here is reused by later graphs of the same shape
+        skippy_receipt_mark_reserve_graph(*receipt_capture, *res, ubatch.n_tokens);
+    }
     const uint32_t cache_capabilities = skippy_graph_cache_capabilities(*gf_res_reserve);
     if ((cache_capabilities & skippy_cache_admitted_capabilities) != skippy_cache_admitted_capabilities) {
         LLAMA_LOG_ERROR("%s: reserved graph state exceeds loaded cache admission\n", __func__);
