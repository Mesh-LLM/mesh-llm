+#ifndef SKIPPY_RECEIPTS_H
+#define SKIPPY_RECEIPTS_H
+
+/**
+ * @file skippy/receipts.h
+ * @brief Recording and replay for verifiable inference receipts.
+ *
+ * A receipt commits, for every layer a stage runs, to the residual stream
+ * entering the layer and to the values entering and leaving its
+ * token-mixing regions (attention, recurrent state updates), with KV-cache
+ * rows as stored. Which ops mix tokens is decided per ggml op from the built
+ * graph; a graph with an op outside that table, or one that breaks a receipt
+ * guard, is reported as unreceiptable with the reason
+ * (mesh/docs/design/RECEIPTS_GLUE.md).
+ *
+ * While serving, the recorder reports each ubatch: its geometry (tokens,
+ * sequences, positions, output rows, KV cells, n_kv), the stage input rows,
+ * and the committed tensors of every layer. It also reports every KV-cache
+ * operation that changes which cells a sequence holds.
+ *
+ * To open a challenge, the caller replays the recorded ubatches of one
+ * sequence in a scratch context of the same model. Other sequences' columns
+ * are replaced by dummy columns at the recorded cells, and the recorded cells
+ * and n_kv are forced, so the challenged sequence computes bit for bit what it
+ * computed while serving. The replay also reports the inputs and outputs of
+ * every weight matmul of the challenged layer.
+ *
+ * An auditor checks the glue between those values by evaluating the layer
+ * itself: skippy_model_eval_receipt_glue() computes one layer on opened
+ * values, with every weight matmul and token-mixing output replaced by the
+ * opened value.
+ */
+
+#include "runtime.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** @brief A per-layer tensor reported by the recorder, a replay or a glue evaluation. */
+enum skippy_receipt_tensor_kind {
+    /** Residual stream entering the layer; layer == layer_end is the stage output. */
+    SKIPPY_RECEIPT_TENSOR_RESIDUAL         = 0,
+    /** A per-token value entering a token-mixing region. */
+    SKIPPY_RECEIPT_TENSOR_MIXING_INPUT     = 1,
+    /**
+     * A row written to a KV cache, as stored and in the cache's type. A glue
+     * evaluation reports the f32 row before it is stored instead.
+     */
+    SKIPPY_RECEIPT_TENSOR_MIXING_STORED    = 2,
+    /** A value leaving a token-mixing region. */
+    SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT    = 3,
+    /** Replay and glue evaluation: the input of a weight matmul. */
+    SKIPPY_RECEIPT_TENSOR_MATMUL_INPUT     = 4,
+    /** Replay: the output of a weight matmul. */
+    SKIPPY_RECEIPT_TENSOR_MATMUL_OUTPUT    = 5,
+    /** Replay and glue evaluation: the expert of every slot of an expert matmul, I32. */
+    SKIPPY_RECEIPT_TENSOR_EXPERT_IDS       = 6,
+    /** Replay: the output of a selection (ARGSORT, TOP_K) made by glue, I32. */
+    SKIPPY_RECEIPT_TENSOR_SELECTION        = 7,
+    /** Glue evaluation: the scores a selection ranks. */
+    SKIPPY_RECEIPT_TENSOR_SELECTION_SCORES = 8,
+};
+
+/** @brief Flags of a reported tensor. */
+enum skippy_receipt_tensor_flag {
+    /**
+     * MATMUL_*: the matmul's output reaches a selection before any other
+     * weight matmul, so an auditor checks all of its rows.
+     */
+    SKIPPY_RECEIPT_TENSOR_ROUTER = 1,
+};
+
+/** @brief One reported tensor, column per token. */
+struct skippy_receipt_tensor {
+    int32_t layer;
+    /** A skippy_receipt_tensor_kind. */
+    int32_t kind;
+    /**
+     * Ordinal among the layer's tensors of this kind, in graph order.
+     * MATMUL_INPUT, MATMUL_OUTPUT and EXPERT_IDS share their matmul's
+     * ordinal; SELECTION and SELECTION_SCORES share their selection's.
+     */
+    int32_t index;
+    /** ggml type of the values: F32, I32, or the cache type of a stored row. */
+    int32_t ggml_type;
+    /** skippy_receipt_tensor_flag bits. */
+    int32_t flags;
+    /** Elements per column. */
+    int64_t len;
+    /** Bytes per column. */
+    int64_t row_bytes;
+    /**
+     * Number of columns: the ubatch's token count, or its output-row count when
+     * the layer keeps only output rows (the last layer of a final stage).
+     */
+    int64_t n_cols;
+    /** Column j at `values + j * row_bytes`. */
+    const void * values;
+    /** MATMUL_* and EXPERT_IDS: the weight's tensor name. Otherwise the graph node's name, for diagnostics. */
+    const char * name;
+};
+
+/**
+ * @brief One computed ubatch.
+ *
+ * The tensor values and stage input rows of a ubatch reported by the
+ * recorder stay valid until the callback for the next ubatch returns, or the
+ * recorder is removed or replaced, so a caller can hash them while the next
+ * ubatch computes. Every other pointer is valid only during the callback.
+ */
+struct skippy_receipt_ubatch {
+    /** Replay step index, or -1 while serving. */
+    int64_t step;
+    int32_t n_tokens;
+    /** Per column: token id, sequence, position, output flag, and KV cell. */
+    const int32_t * token;
+    const int32_t * seq;
+    const int32_t * pos;
+    const int8_t * output;
+    const uint32_t * cell;
+    /** KV cells the attention graph covered. */
+    uint32_t n_kv;
+    /** Stage input rows (a stage after the first), or NULL. Row j at `input + j * input_row_bytes`. */
+    const void * input;
+    int64_t input_row_bytes;
+    /** ggml type of the input rows. */
+    int32_t input_type;
+    size_t n_tensors;
+    const struct skippy_receipt_tensor * tensors;
+    /** Non-NULL when the ubatch cannot be receipted: the reason. Nothing else is set. */
+    const char * error;
+    /** Glue evaluation: weights read inside token-mixing regions, which nothing checks. */
+    size_t n_unchecked_weights;
+    const char * const * unchecked_weights;
+};
+
+/** @brief KV-cache operations that the recorder reports. */
+enum skippy_receipt_memory_op {
+    /** Every sequence lost all its cells. */
+    SKIPPY_RECEIPT_MEMORY_CLEAR      = 0,
+    /** Cells of `seq` (every sequence if -1) in positions [p0, p1) were removed; p1 < 0 means no end. */
+    SKIPPY_RECEIPT_MEMORY_SEQ_RM     = 1,
+    /** Cells of `seq` in [p0, p1) were shared with `seq_dst`. */
+    SKIPPY_RECEIPT_MEMORY_SEQ_CP     = 2,
+    /** Every sequence except `seq` lost its cells. */
+    SKIPPY_RECEIPT_MEMORY_SEQ_KEEP   = 3,
+    /** Positions of `seq` in [p0, p1) were shifted or divided. */
+    SKIPPY_RECEIPT_MEMORY_SEQ_SHIFT  = 4,
+    /** Cells of `seq` (every sequence if -1) were loaded from saved state. */
+    SKIPPY_RECEIPT_MEMORY_STATE_READ = 5,
+    /** Cells moved to close gaps. */
+    SKIPPY_RECEIPT_MEMORY_COMPACT    = 6,
+};
+
+struct skippy_receipt_memory_event {
+    /** A skippy_receipt_memory_op. */
+    int32_t op;
+    int32_t seq;
+    int32_t seq_dst;
+    int32_t p0;
+    int32_t p1;
+};
+
+typedef void (*skippy_receipt_ubatch_fn)(void * user_data, const struct skippy_receipt_ubatch * ubatch);
+typedef void (*skippy_receipt_memory_fn)(void * user_data, const struct skippy_receipt_memory_event * event);
+
+/**
+ * @brief Installs or, with both callbacks NULL, removes the receipt recorder.
+ *
+ * The callbacks run on the thread that decodes or changes the KV cache. The
+ * recorder marks the committed tensors as graph outputs, which keeps them
+ * alive and may disable some kernel fusions; replay marks the same tensors.
+ * The stage needs a plain unified KV cache with one stream, and flash
+ * attention, so V rows are stored untransposed.
+ */
+LLAMA_API enum skippy_status skippy_model_set_receipt_recorder(
+        struct skippy_model * model,
+        skippy_receipt_ubatch_fn on_ubatch,
+        skippy_receipt_memory_fn on_memory,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+enum skippy_receipt_replay_kind {
+    /** Decode one recorded ubatch. */
+    SKIPPY_RECEIPT_REPLAY_DECODE = 0,
+    /** Remove positions [p0, p1) of the replayed sequence (p1 < 0: no end). */
+    SKIPPY_RECEIPT_REPLAY_SEQ_RM = 1,
+};
+
+/** @brief One replay step. A decode step has the fields of a recorded ubatch. */
+struct skippy_receipt_replay_step {
+    /** A skippy_receipt_replay_kind. */
+    int32_t kind;
+    int32_t n_tokens;
+    const int32_t * token;
+    const int32_t * seq;
+    const int32_t * pos;
+    const int8_t * output;
+    const uint32_t * cell;
+    uint32_t n_kv;
+    const void * input;
+    int64_t input_row_bytes;
+    int32_t input_type;
+    /** SEQ_RM range. */
+    int32_t p0;
+    int32_t p1;
+    /** Nonzero to report this step's tensors through the capture callback. */
+    int32_t capture;
+};
+
+/**
+ * @brief Replays one sequence in the model's scratch context.
+ *
+ * The scratch context is created on first use with the stage context's
+ * parameters and kept until skippy_model_release_receipt_scratch(). Each
+ * replay starts from an empty cache. After every decode step, the columns of
+ * sequences other than `seq` are removed. A captured step reports the
+ * committed tensors of `layer`, its weight matmuls' inputs, outputs and
+ * experts, its selections, and the residual leaving it. Every step stops computing once those are done, so
+ * later layers and the output head are skipped and their values are
+ * undefined.
+ */
+LLAMA_API enum skippy_status skippy_model_replay_receipt(
+        struct skippy_model * model,
+        int32_t seq,
+        int32_t layer,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Frees the scratch context that receipt replays run in.
+ *
+ * The next replay creates it again. When a replay is running, the context
+ * is kept and the call still succeeds.
+ */
+LLAMA_API enum skippy_status skippy_model_release_receipt_scratch(
+        struct skippy_model * model,
+        struct skippy_error ** out_error);
+
+/** @brief A value a glue evaluation uses instead of computing it. */
+struct skippy_receipt_glue_value {
+    /** MATMUL_OUTPUT, MIXING_OUTPUT or SELECTION. */
+    int32_t kind;
+    int32_t index;
+    /** F32, or I32 for SELECTION. */
+    int32_t ggml_type;
+    /** Elements per column. Column j at `values + j * len` elements. */
+    int64_t len;
+    const void * values;
+};
+
+/** @brief Opened values of one layer at a few positions. */
+struct skippy_receipt_glue_request {
+    int32_t layer;
+    int32_t n_cols;
+    /** Per column: the position. */
+    const int32_t * pos;
+    /** Residual stream entering the layer. Column j at `residual + j * residual_len`. */
+    const float * residual;
+    int64_t residual_len;
+    /** One value for every weight matmul output, token-mixing output and selection of the layer. */
+    size_t n_values;
+    const struct skippy_receipt_glue_value * values;
+};
+
+/**
+ * @brief Evaluates the glue of one layer on opened values.
+ *
+ * The model must hold `layer`; an auditor loads a stage of that layer alone.
+ * Each column is computed as its own sequence at its position, starting
+ * from the opened residual. Every weight matmul, token-mixing output and
+ * selection takes the given value instead of being computed, so the
+ * layer's large weights are never read. `on_result` is called once with the
+ * computed values: weight matmul inputs and experts, token-mixing inputs,
+ * KV rows before storage, selection scores, the residual leaving the layer,
+ * and the weights read inside token-mixing regions.
+ */
+LLAMA_API enum skippy_status skippy_model_eval_receipt_glue(
+        struct skippy_model * model,
+        const struct skippy_receipt_glue_request * request,
+        skippy_receipt_ubatch_fn on_result,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Compares a stored KV row with the f32 row an auditor computed.
+ *
+ * Sets `stored_error` to the L2 distance between the dequantized stored row
+ * and `computed`, `rounding_error` to the distance between `computed` and
+ * its own round trip through `ggml_type`, and `norm` to the L2 norm of
+ * `computed`. An honestly stored row is about one rounding error away.
+ */
+LLAMA_API enum skippy_status skippy_receipt_stored_row_error(
+        int32_t ggml_type,
+        const void * stored,
+        const float * computed,
+        int64_t n,
+        double * stored_error,
+        double * rounding_error,
+        double * norm,
+        struct skippy_error ** out_error);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SKIPPY_RECEIPTS_H
