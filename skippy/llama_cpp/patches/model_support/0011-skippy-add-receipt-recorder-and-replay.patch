+#include <mutex>
+#include <set>
+#include <string>
+#include <vector>
+
+// The scratch contexts a model replays receipts and evaluates glue in. Each
+// llama context is created on first use and freed when the scratch is
+// released.
+struct skippy_receipt_scratch {
+    std::mutex mutex;
+    llama_context * ctx = nullptr;
+    std::shared_ptr<skippy_receipt_capture> capture;
+    llama_context * glue_ctx = nullptr;
+    std::shared_ptr<skippy_receipt_capture> glue_capture;
+    uint32_t glue_columns = 0;
+
+    ~skippy_receipt_scratch() {
+        llama_free(ctx);
+        llama_free(glue_ctx);
+    }
+};
+
+std::shared_ptr<skippy_receipt_scratch> skippy_receipt_new_scratch() {
+    return std::make_shared<skippy_receipt_scratch>();
+}
+
+namespace {
+
+llama_kv_cache * plain_kv_cache(llama_context * ctx) {
+    return dynamic_cast<llama_kv_cache *>(ctx->get_memory());
+}
+
+}  // namespace
+
+enum skippy_status skippy_model_set_receipt_recorder(
+        struct skippy_model * model,
+        skippy_receipt_ubatch_fn on_ubatch,
+        skippy_receipt_memory_fn on_memory,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->ctx == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model with a context is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    llama_kv_cache * kv = plain_kv_cache(model->ctx);
+    if (on_ubatch == nullptr && on_memory == nullptr) {
+        model->ctx->set_receipt_capture(nullptr);
+        if (kv != nullptr) {
+            kv->receipt_memory_observer = nullptr;
+        }
+        return skippy_success(out_error);
+    }
+    if (on_ubatch == nullptr || on_memory == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "both receipt callbacks are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (kv == nullptr || kv->get_n_stream() != 1) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED,
+                "receipts need a plain KV cache with one stream");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    if (model->mtp_ctx != nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "receipts do not support MTP stages yet");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    auto capture = std::make_shared<skippy_receipt_capture>();
+    capture->on_ubatch = on_ubatch;
+    capture->user_data = user_data;
+    kv->receipt_memory_observer = [on_memory, user_data](
+            int32_t op, llama_seq_id seq, llama_seq_id seq_dst, llama_pos p0, llama_pos p1) {
+        const skippy_receipt_memory_event event = {op, seq, seq_dst, p0, p1};
+        on_memory(user_data, &event);
+    };
+    model->ctx->set_receipt_capture(std::move(capture));
+    return skippy_success(out_error);
+}
+
+namespace {
+
+enum skippy_status ensure_scratch(skippy_model * model, skippy_receipt_scratch & scratch, skippy_error ** out_error) {
+    if (scratch.ctx != nullptr) {
+        return SKIPPY_STATUS_OK;
+    }
+    if (!model->has_receipt_ctx_params) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the stage context parameters were not kept");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    scratch.capture = std::make_shared<skippy_receipt_capture>();
+    llama_context_params params = model->receipt_ctx_params;
+    params.cb_eval = skippy_receipt_eval;
+    params.cb_eval_user_data = scratch.capture.get();
+    params.samplers = nullptr;
+    params.n_samplers = 0;
+    scratch.ctx = llama_init_from_model_with_graph_inputs(
+            model->model, params, skippy_graph_build_inputs_from_config(&model->config));
+    if (scratch.ctx == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to create the receipt replay context");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (plain_kv_cache(scratch.ctx) == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the replay context has no plain KV cache");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    scratch.ctx->set_receipt_capture(scratch.capture);
+    return SKIPPY_STATUS_OK;
+}
+
+enum skippy_status replay_decode(
+        skippy_model * model,
+        llama_context * ctx,
+        llama_kv_cache * kv,
+        const skippy_receipt_replay_step & step,
+        skippy_error ** out_error) {
+    const auto n = static_cast<size_t>(step.n_tokens);
+    std::vector<llama_token> tokens(step.token, step.token + n);
+    std::vector<llama_pos> positions(step.pos, step.pos + n);
+    std::vector<int32_t> n_seq_id(n, 1);
+    std::vector<llama_seq_id> seq_values(step.seq, step.seq + n);
+    std::vector<llama_seq_id *> seq_ids(n);
+    std::vector<int8_t> logits(step.output, step.output + n);
+    for (size_t i = 0; i < n; ++i) {
+        seq_ids[i] = &seq_values[i];
+    }
+    skippy_graph_build_inputs inputs = skippy_graph_build_inputs_from_config(&model->config);
+    skippy_graph_build_inputs_set_activation_tokens(inputs, tokens.data(), n);
+    if (step.input != nullptr) {
+        const size_t element = ggml_type_size(static_cast<ggml_type>(step.input_type));
+        skippy_activation_frontier_part_input part;
+        part.values = step.input;
+        part.payload_bytes = static_cast<uint64_t>(step.input_row_bytes) * n;
+        part.ggml_type = static_cast<uint32_t>(step.input_type);
+        part.rank = 2;
+        part.token_axis = 1;
+        part.dimensions[0] = step.input_row_bytes / static_cast<int64_t>(element);
+        part.dimensions[1] = static_cast<int64_t>(n);
+        part.byte_strides[0] = element;
+        part.byte_strides[1] = static_cast<uint64_t>(step.input_row_bytes);
+        part.pos_start = n > 0 ? step.pos[0] : 0;
+        inputs.activation_frontier.push_back(part);
+    }
+    llama_batch batch = {
+        step.n_tokens, tokens.data(), nullptr, positions.data(), n_seq_id.data(), seq_ids.data(), logits.data(),
+    };
+    kv->receipt_forced_cells.assign(step.cell, step.cell + n);
+    kv->receipt_forced_n_kv = step.n_kv;
+    int32_t rc = 0;
+    const bool contained = skippy_contain_native_failure(out_error, [&] { rc = ctx->decode(batch, inputs); });
+    kv->receipt_forced_cells.clear();
+    kv->receipt_forced_n_kv = 0;
+    if (!contained) {
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (rc != 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "a receipt replay step failed to decode");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    return SKIPPY_STATUS_OK;
+}
+
+}  // namespace
+
+enum skippy_status skippy_model_replay_receipt(
+        struct skippy_model * model,
+        int32_t seq,
+        int32_t layer,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->model == nullptr || (steps == nullptr && n_steps > 0) || on_capture == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model, steps and a capture callback are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto scratch = model->receipt_scratch;
+    if (!scratch) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the model cannot replay receipts");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    std::lock_guard<std::mutex> lock(scratch->mutex);
+    enum skippy_status status = ensure_scratch(model, *scratch, out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    llama_context * ctx = scratch->ctx;
+    llama_kv_cache * kv = plain_kv_cache(ctx);
+    llama_memory_t memory = ctx->get_memory();
+    llama_memory_clear(memory, false);
+
+    auto & capture = *scratch->capture;
+    capture.on_ubatch = on_capture;
+    capture.user_data = user_data;
+    capture.mode = skippy_receipt_mode::replay;
+    if (capture.layer != layer) {
+        capture.layer = layer;
+        // the next ubatch rebuilds its graph with this layer's matmuls marked
+        ctx->set_receipt_capture(scratch->capture);
+    }
+    for (size_t index = 0; index < n_steps && status == SKIPPY_STATUS_OK; ++index) {
+        const auto & step = steps[index];
+        if (step.kind == SKIPPY_RECEIPT_REPLAY_SEQ_RM) {
+            llama_memory_seq_rm(memory, seq, step.p0, step.p1);
+            continue;
+        }
+        if (step.kind != SKIPPY_RECEIPT_REPLAY_DECODE || step.n_tokens <= 0 || step.token == nullptr ||
+                step.seq == nullptr || step.pos == nullptr || step.output == nullptr || step.cell == nullptr) {
+            skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "malformed receipt replay step");
+            status = SKIPPY_STATUS_INVALID_ARGUMENT;
+            break;
+        }
+        capture.step = static_cast<int64_t>(index);
+        capture.report = step.capture != 0;
+        status = replay_decode(model, ctx, kv, step, out_error);
+        std::set<llama_seq_id> foreign;
+        for (int32_t i = 0; i < step.n_tokens; ++i) {
+            if (step.seq[i] != seq) foreign.insert(step.seq[i]);
+        }
+        for (const llama_seq_id other : foreign) {
+            llama_memory_seq_rm(memory, other, -1, -1);
+        }
+    }
+    capture.on_ubatch = nullptr;
+    capture.user_data = nullptr;
+    llama_memory_clear(memory, false);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_model_release_receipt_scratch(struct skippy_model * model, struct skippy_error ** out_error) {
+    if (model == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto scratch = model->receipt_scratch;
+    if (!scratch) {
+        return skippy_success(out_error);
+    }
+    std::unique_lock<std::mutex> lock(scratch->mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+        // a replay holds the context; it stays until the next release
+        return skippy_success(out_error);
+    }
+    llama_free(scratch->ctx);
+    scratch->ctx = nullptr;
+    scratch->capture.reset();
+    llama_free(scratch->glue_ctx);
+    scratch->glue_ctx = nullptr;
+    scratch->glue_capture.reset();
+    scratch->glue_columns = 0;
+    return skippy_success(out_error);
+}
+
+namespace {
+
+// Columns of a glue evaluation, at least two so the classifier can tell the
+// token axis from other axes of size one.
+constexpr int32_t MIN_GLUE_COLUMNS = 2;
+
+enum skippy_status ensure_glue(
+        skippy_model * model, skippy_receipt_scratch & scratch, uint32_t columns, skippy_error ** out_error) {
+    if (scratch.glue_ctx != nullptr && scratch.glue_columns >= columns) {
+        return SKIPPY_STATUS_OK;
+    }
+    llama_free(scratch.glue_ctx);
+    scratch.glue_ctx = nullptr;
+    scratch.glue_columns = 0;
+    if (!model->has_receipt_ctx_params) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the stage context parameters were not kept");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    scratch.glue_capture = std::make_shared<skippy_receipt_capture>();
+    scratch.glue_capture->mode = skippy_receipt_mode::glue;
+    llama_context_params params = model->receipt_ctx_params;
+    // every column is its own sequence of one token
+    params.n_seq_max = columns;
+    params.kv_unified = true;
+    params.n_ctx = 256;
+    params.n_batch = std::max<uint32_t>(params.n_batch, columns);
+    params.n_ubatch = std::max<uint32_t>(params.n_ubatch, columns);
+    params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+    params.cb_eval = skippy_receipt_eval;
+    params.cb_eval_user_data = scratch.glue_capture.get();
+    params.samplers = nullptr;
+    params.n_samplers = 0;
+    scratch.glue_ctx = llama_init_from_model_with_graph_inputs(
+            model->model, params, skippy_graph_build_inputs_from_config(&model->config));
+    if (scratch.glue_ctx == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to create the receipt glue context");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (plain_kv_cache(scratch.glue_ctx) == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the glue context has no plain KV cache");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    scratch.glue_columns = columns;
+    scratch.glue_ctx->set_receipt_capture(scratch.glue_capture);
+    return SKIPPY_STATUS_OK;
+}
+
+bool valid_glue_request(const skippy_receipt_glue_request * request) {
+    return request != nullptr && request->n_cols > 0 && request->pos != nullptr && request->residual != nullptr &&
+           request->residual_len > 0 && (request->values != nullptr || request->n_values == 0);
+}
+
+enum skippy_status glue_decode(skippy_model * model, llama_context * ctx, const skippy_receipt_glue_request & request,
+        skippy_error ** out_error) {
+    const int32_t n = std::max(request.n_cols, MIN_GLUE_COLUMNS);
+    const auto columns = static_cast<size_t>(n);
+    // columns past the request repeat its first column
+    auto source = [&](size_t j) { return j < static_cast<size_t>(request.n_cols) ? j : 0; };
+    std::vector<llama_token> tokens(columns, 0);
+    std::vector<llama_pos> positions(columns);
+    std::vector<int32_t> n_seq_id(columns, 1);
+    std::vector<llama_seq_id> seq_values(columns);
+    std::vector<llama_seq_id *> seq_ids(columns);
+    std::vector<int8_t> logits(columns, 1);
+    const auto row = static_cast<size_t>(request.residual_len);
+    std::vector<float> residual(columns * row);
+    for (size_t j = 0; j < columns; ++j) {
+        positions[j] = request.pos[source(j)];
+        seq_values[j] = static_cast<llama_seq_id>(j);
+        seq_ids[j] = &seq_values[j];
+        std::memcpy(residual.data() + j * row, request.residual + source(j) * row, row * sizeof(float));
+    }
+    skippy_graph_build_inputs inputs = skippy_graph_build_inputs_from_config(&model->config);
+    skippy_graph_build_inputs_set_activation_tokens(inputs, tokens.data(), columns);
+    skippy_activation_frontier_part_input part;
+    part.values = residual.data();
+    part.payload_bytes = residual.size() * sizeof(float);
+    part.ggml_type = GGML_TYPE_F32;
+    part.rank = 2;
+    part.token_axis = 1;
+    part.dimensions[0] = request.residual_len;
+    part.dimensions[1] = n;
+    part.byte_strides[0] = sizeof(float);
+    part.byte_strides[1] = row * sizeof(float);
+    part.pos_start = positions[0];
+    if (model->config.activation_import_identity_count > 0) {
+        inputs.activation_frontier.push_back(part);
+    }
+    llama_batch batch = {
+        n, tokens.data(), nullptr, positions.data(), n_seq_id.data(), seq_ids.data(), logits.data(),
+    };
+    int32_t rc = 0;
+    if (!skippy_contain_native_failure(out_error, [&] { rc = ctx->decode(batch, inputs); })) {
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (rc != 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "the receipt glue evaluation failed to decode");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    return SKIPPY_STATUS_OK;
+}
+
+}  // namespace
+
+enum skippy_status skippy_model_eval_receipt_glue(
+        struct skippy_model * model,
+        const struct skippy_receipt_glue_request * request,
+        skippy_receipt_ubatch_fn on_result,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->model == nullptr || !valid_glue_request(request) || on_result == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model, a glue request and a result callback are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto scratch = model->receipt_scratch;
+    if (!scratch) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the model cannot evaluate receipt glue");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    std::lock_guard<std::mutex> lock(scratch->mutex);
+    const auto columns = static_cast<uint32_t>(std::max(request->n_cols, MIN_GLUE_COLUMNS));
+    enum skippy_status status = ensure_glue(model, *scratch, columns, out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    llama_context * ctx = scratch->glue_ctx;
+    llama_memory_t memory = ctx->get_memory();
+    llama_memory_clear(memory, false);
+    auto & capture = *scratch->glue_capture;
+    capture.on_ubatch = on_result;
+    capture.user_data = user_data;
+    capture.glue = request;
+    if (capture.layer != request->layer) {
+        capture.layer = request->layer;
+        // the next ubatch rebuilds its graph for this layer
+        ctx->set_receipt_capture(scratch->glue_capture);
+    }
+    status = glue_decode(model, ctx, *request, out_error);
+    capture.on_ubatch = nullptr;
+    capture.user_data = nullptr;
+    capture.glue = nullptr;
+    llama_memory_clear(memory, false);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_receipt_stored_row_error(
+        int32_t ggml_type,
+        const void * stored,
+        const float * computed,
+        int64_t n,
+        double * stored_error,
+        double * rounding_error,
+        double * norm,
+        struct skippy_error ** out_error) {
+    if (ggml_type < 0 || ggml_type >= GGML_TYPE_COUNT || stored == nullptr || computed == nullptr || n <= 0 ||
+            stored_error == nullptr || rounding_error == nullptr || norm == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "a cache type, both rows and the outputs are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const auto type = static_cast<enum ggml_type>(ggml_type);
+    const auto * traits = ggml_get_type_traits(type);
+    if ((type != GGML_TYPE_F32 && traits->to_float == nullptr) || ggml_quantize_requires_imatrix(type) ||
+            n % ggml_blck_size(type) != 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED,
+                (std::string("cannot compare stored rows of type ") + ggml_type_name(type)).c_str());
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    const auto count = static_cast<size_t>(n);
+    std::vector<float> stored_values(count);
+    std::vector<float> rounded(count);
+    std::vector<uint8_t> quantized(ggml_row_size(type, n));
+    if (type == GGML_TYPE_F32) {
+        std::memcpy(stored_values.data(), stored, count * sizeof(float));
+        std::memcpy(rounded.data(), computed, count * sizeof(float));
+    } else {
+        traits->to_float(stored, stored_values.data(), n);
+        ggml_quantize_chunk(type, computed, quantized.data(), 0, 1, n, nullptr);
+        traits->to_float(quantized.data(), rounded.data(), n);
+    }
+    double stored_sum = 0.0;
+    double rounding_sum = 0.0;
+    double norm_sum = 0.0;
+    for (size_t i = 0; i < count; ++i) {
+        const double c = computed[i];
+        stored_sum += (stored_values[i] - c) * (stored_values[i] - c);
+        rounding_sum += (rounded[i] - c) * (rounded[i] - c);
+        norm_sum += c * c;
+    }
+    *stored_error = std::sqrt(stored_sum);
+    *rounding_error = std::sqrt(rounding_sum);
+    *norm = std::sqrt(norm_sum);
+    return skippy_success(out_error);
+}
diff --git a/src/skippy/receipts_graph.cpp b/src/skippy/receipts_graph.cpp
new file mode 100644
index 000000000..19a779976
--- /dev/null
+++ b/src/skippy/receipts_graph.cpp
@@ -0,0 +1,716 @@
+// Receipt tensors of a built graph: which ones a recorder, replay or glue
+// evaluation reports, and reading them after the graph is computed.
+
+#include "receipts_internal.h"
+#include "receipts_layers.h"
+
+#include "ggml-backend.h"
+#include "llama-batch.h"
+#include "llama-graph.h"
+#include "llama-kv-cache.h"
+
+#include <algorithm>
+#include <cstring>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace {
+
+bool tracked(int32_t axis) {
+    return axis >= 0 && axis < 4;
+}
+
+int64_t columns_of(const ggml_tensor * t, int32_t axis) {
+    if (ggml_nelements(t) == 0) {
+        return 0;  // no output rows
+    }
+    return tracked(axis) ? t->ne[axis] : 1;
+}
+
+// Elements per column; a value can have no columns (no output rows).
+int64_t column_len(const ggml_tensor * t, int32_t axis) {
+    int64_t len = 1;
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (!tracked(axis) || d != axis) {
+            len *= t->ne[d];
+        }
+    }
+    return len;
+}
+
+const ggml_tensor * root_of(const ggml_tensor * t) {
+    return t->view_src != nullptr ? t->view_src : t;
+}
+
+size_t offset_in_root(const ggml_tensor * t) {
+    return t->view_src != nullptr ? t->view_offs : 0;
+}
+
+// The request input identity without its ordinal suffix.
+std::string identity_name(const std::string & identity) {
+    const size_t dot = identity.rfind('.');
+    return dot == std::string::npos ? identity : identity.substr(0, dot);
+}
+
+skippy_receipt_graph_facts graph_facts(const llm_graph_result & res, int64_t n_tokens) {
+    skippy_receipt_graph_facts facts;
+    facts.n_tokens = n_tokens;
+    std::map<int32_t, skippy_receipt_graph_facts::layer_bounds> layers;
+    for (const auto & boundary : res.get_block_boundaries()) {
+        auto & bounds = layers[boundary.layer];
+        bounds.layer = boundary.layer;
+        auto * tensor = const_cast<ggml_tensor *>(boundary.tensor);
+        if (boundary.kind == skippy_block_boundary_kind::entry) {
+            bounds.entry = tensor;
+        } else {
+            bounds.exit = tensor;
+        }
+    }
+    for (const auto & entry : layers) {
+        facts.layers.push_back(entry.second);
+    }
+    for (const auto & effect : res.get_state_effects()) {
+        if (effect.storage != nullptr) {
+            facts.state_storage.insert(effect.storage);
+        }
+    }
+    for (const auto & binding : res.get_request_input_bindings()) {
+        const std::string name = identity_name(binding.identity);
+        if (name == "positions" || name == "attention.scale") {
+            facts.client_inputs.insert(binding.tensor);
+        } else if (name == "output.indices") {
+            facts.output_indices.insert(binding.tensor);
+        } else if (name == "attention.key_indices" || name == "attention.value_indices") {
+            facts.cell_indices.insert(binding.tensor);
+        }
+    }
+    facts.is_weight = [](const ggml_tensor * t) {
+        return t->op == GGML_OP_NONE && t->buffer != nullptr &&
+               ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS;
+    };
+    return facts;
+}
+
+void add_value(skippy_receipt_capture & capture, const skippy_receipt_value & value, int32_t layer, int32_t kind,
+        int32_t index, int32_t flags = 0, const char * name = nullptr) {
+    skippy_receipt_target target;
+    target.tensor = value.tensor;
+    target.axis = value.axis;
+    target.layer = layer;
+    target.kind = kind;
+    target.index = index;
+    target.flags = flags;
+    target.name = name != nullptr ? name : value.tensor->name;
+    capture.targets.push_back(target);
+}
+
+void add_committed(skippy_receipt_capture & capture, const skippy_receipt_layer_plan & plan) {
+    add_value(capture, plan.entry, plan.layer, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0);
+    for (size_t i = 0; i < plan.mixing_inputs.size(); ++i) {
+        add_value(capture, plan.mixing_inputs[i], plan.layer, SKIPPY_RECEIPT_TENSOR_MIXING_INPUT, static_cast<int32_t>(i));
+    }
+    for (size_t i = 0; i < plan.stores.size(); ++i) {
+        skippy_receipt_target target;
+        target.tensor = plan.stores[i].node;
+        target.layer = plan.layer;
+        target.kind = SKIPPY_RECEIPT_TENSOR_MIXING_STORED;
+        target.index = static_cast<int32_t>(i);
+        target.name = plan.stores[i].source.tensor->name;
+        target.rows = plan.stores[i].rows;
+        capture.targets.push_back(target);
+    }
+    for (size_t i = 0; i < plan.mixing_outputs.size(); ++i) {
+        add_value(capture, plan.mixing_outputs[i], plan.layer, SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT, static_cast<int32_t>(i));
+    }
+}
+
+void add_matmuls(skippy_receipt_capture & capture, const skippy_receipt_layer_plan & plan, bool outputs) {
+    for (size_t i = 0; i < plan.matmuls.size(); ++i) {
+        const auto & m = plan.matmuls[i];
+        const auto index = static_cast<int32_t>(i);
+        const int32_t flags = m.router ? SKIPPY_RECEIPT_TENSOR_ROUTER : 0;
+        add_value(capture, m.input, plan.layer, SKIPPY_RECEIPT_TENSOR_MATMUL_INPUT, index, flags, m.weight->name);
+        if (outputs) {
+            add_value(capture, m.output, plan.layer, SKIPPY_RECEIPT_TENSOR_MATMUL_OUTPUT, index, flags, m.weight->name);
+        }
+        if (m.ids.tensor != nullptr) {
+            add_value(capture, m.ids, plan.layer, SKIPPY_RECEIPT_TENSOR_EXPERT_IDS, index, flags, m.weight->name);
+        }
+    }
+}
+
+void add_glue(skippy_receipt_capture & capture, const skippy_receipt_layer_plan & plan) {
+    const int32_t layer = plan.layer;
+    ggml_tensor * entry = plan.entry.tensor;
+    if ((entry->flags & GGML_TENSOR_FLAG_INPUT) == 0 && entry->view_src == nullptr) {
+        // a first stage computes its entry from tokens; the opened residual replaces it
+        capture.substitutes.push_back({entry, plan.entry.axis, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0});
+    }
+    add_matmuls(capture, plan, false);
+    for (size_t i = 0; i < plan.matmuls.size(); ++i) {
+        capture.substitutes.push_back(
+                {plan.matmuls[i].node, plan.matmuls[i].output.axis, SKIPPY_RECEIPT_TENSOR_MATMUL_OUTPUT, static_cast<int32_t>(i)});
+    }
+    for (size_t i = 0; i < plan.mixing_inputs.size(); ++i) {
+        add_value(capture, plan.mixing_inputs[i], layer, SKIPPY_RECEIPT_TENSOR_MIXING_INPUT, static_cast<int32_t>(i));
+    }
+    for (size_t i = 0; i < plan.stores.size(); ++i) {
+        add_value(capture, plan.stores[i].source, layer, SKIPPY_RECEIPT_TENSOR_MIXING_STORED, static_cast<int32_t>(i));
+    }
+    for (size_t i = 0; i < plan.mixing_outputs.size(); ++i) {
+        const auto & out = plan.mixing_outputs[i];
+        capture.substitutes.push_back({out.tensor, out.axis, SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT, static_cast<int32_t>(i)});
+    }
+    for (size_t i = 0; i < plan.selections.size(); ++i) {
+        const auto & s = plan.selections[i];
+        add_value(capture, s.scores, layer, SKIPPY_RECEIPT_TENSOR_SELECTION_SCORES, static_cast<int32_t>(i));
+        capture.substitutes.push_back({s.node, s.output.axis, SKIPPY_RECEIPT_TENSOR_SELECTION, static_cast<int32_t>(i)});
+    }
+    for (const ggml_tensor * w : plan.unchecked_weights) {
+        capture.unchecked_weights.emplace_back(w->name);
+    }
+}
+
+std::string select_targets(skippy_receipt_capture & capture, const std::vector<skippy_receipt_layer_plan> & plans) {
+    if (capture.mode == skippy_receipt_mode::record) {
+        for (const auto & plan : plans) {
+            add_committed(capture, plan);
+        }
+        add_value(capture, plans.back().exit, plans.back().layer + 1, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0);
+        return {};
+    }
+    const auto found = std::find_if(plans.begin(), plans.end(),
+            [&](const skippy_receipt_layer_plan & plan) { return plan.layer == capture.layer; });
+    if (found == plans.end()) {
+        return "layer " + std::to_string(capture.layer) + " is not in the graph";
+    }
+    const auto & plan = *found;
+    if (capture.mode == skippy_receipt_mode::replay) {
+        add_committed(capture, plan);
+        add_matmuls(capture, plan, true);
+        for (size_t i = 0; i < plan.selections.size(); ++i) {
+            add_value(capture, plan.selections[i].output, plan.layer, SKIPPY_RECEIPT_TENSOR_SELECTION, static_cast<int32_t>(i));
+        }
+    } else {
+        add_glue(capture, plan);
+    }
+    add_value(capture, plan.exit, plan.layer + 1, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0);
+    return {};
+}
+
+std::string find_targets(skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens) {
+    std::vector<skippy_receipt_layer_plan> plans;
+    std::string error = skippy_receipt_classify(res.get_gf(), graph_facts(res, n_tokens), plans);
+    if (!error.empty()) {
+        return error;
+    }
+    error = select_targets(capture, plans);
+    if (!error.empty()) {
+        return error;
+    }
+    const auto & imports = res.get_skippy_activation_imports();
+    if (imports.size() > 1) {
+        return "a stage with more than one activation import";
+    }
+    if (imports.size() == 1) {
+        capture.input = imports.front().tensor;
+        if (capture.input == nullptr || !ggml_is_contiguous(capture.input) || capture.input->ne[2] != 1 ||
+                capture.input->ne[3] != 1) {
+            return "the activation import is not a contiguous row per token";
+        }
+    }
+    for (const auto & target : capture.targets) {
+        if (target.rows != nullptr) {
+            continue;
+        }
+        const ggml_type type = target.tensor->type;
+        if (type != GGML_TYPE_F32 && type != GGML_TYPE_F16 && type != GGML_TYPE_BF16 && type != GGML_TYPE_I32) {
+            return std::string("receipt value ") + target.tensor->name + " has type " + ggml_type_name(type);
+        }
+    }
+    return {};
+}
+
+void keep_alive(ggml_tensor * t) {
+    ggml_set_output(t);
+    for (ggml_tensor * root = t->view_src; root != nullptr; root = root->view_src) {
+        ggml_set_output(root);
+    }
+}
+
+// Replay and glue: stop once every reported tensor is computed.
+void stop_after_targets(skippy_receipt_capture & capture, ggml_cgraph * gf) {
+    std::set<const ggml_tensor *> nodes;
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        nodes.insert(ggml_graph_node(gf, i));
+    }
+    for (const auto & target : capture.targets) {
+        const ggml_tensor * t = target.tensor;
+        if (nodes.count(t) == 0) {
+            t = root_of(t);
+        }
+        // a tensor outside the nodes is a graph input, set before compute
+        if (nodes.count(t) != 0) {
+            capture.stop_after.insert(t);
+        }
+    }
+}
+
+// A glue evaluation computes no substituted node; begin_compute writes the
+// opened value into it instead. Its inputs are dropped, so the weights it
+// read are never touched.
+//
+// The opened value is written before the graph runs, so it is allocated
+// with the graph inputs, before any node, and kept to the end: no other
+// tensor may use its memory. A scheduler can reuse the reserve graph's
+// allocation, so the reserve graph is substituted the same way.
+void substitute(skippy_receipt_capture & capture) {
+    for (const auto & s : capture.substitutes) {
+        ggml_tensor * node = s.node;
+        node->op = GGML_OP_NONE;
+        for (auto & src : node->src) {
+            src = nullptr;
+        }
+        ggml_set_input(node);
+        keep_alive(node);
+    }
+}
+
+void mark(skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens) {
+    capture.targets.clear();
+    capture.substitutes.clear();
+    capture.unchecked_weights.clear();
+    capture.input = nullptr;
+    capture.stop_after.clear();
+    capture.graph_error = find_targets(capture, res, n_tokens);
+    if (!capture.graph_error.empty()) {
+        capture.targets.clear();
+        capture.substitutes.clear();
+        capture.input = nullptr;
+        return;
+    }
+    if (capture.mode == skippy_receipt_mode::glue) {
+        substitute(capture);
+    }
+    if (capture.mode != skippy_receipt_mode::record) {
+        stop_after_targets(capture, res.get_gf());
+    }
+    for (const auto & target : capture.targets) {
+        if (target.rows == nullptr) {
+            keep_alive(target.tensor);
+        }
+    }
+    if (capture.input != nullptr) {
+        keep_alive(capture.input);
+    }
+}
+
+// ---- reading computed values ----
+
+// Calls f(element, byte offset in the root) for every element of column j,
+// i0 fastest, skipping the token axis.
+template <typename F>
+void for_each_element(const ggml_tensor * t, int32_t axis, int64_t j, F && f) {
+    int64_t ne[4] = {t->ne[0], t->ne[1], t->ne[2], t->ne[3]};
+    size_t base = offset_in_root(t);
+    if (tracked(axis)) {
+        ne[axis] = 1;
+        base += static_cast<size_t>(j) * t->nb[axis];
+    }
+    int64_t e = 0;
+    for (int64_t i3 = 0; i3 < ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < ne[2]; ++i2) {
+            for (int64_t i1 = 0; i1 < ne[1]; ++i1) {
+                const size_t row = base + i3 * t->nb[3] + i2 * t->nb[2] + i1 * t->nb[1];
+                for (int64_t i0 = 0; i0 < ne[0]; ++i0) {
+                    f(e++, row + i0 * t->nb[0]);
+                }
+            }
+        }
+    }
+}
+
+// Columns are contiguous, in order, starting at the tensor's offset.
+bool contiguous_columns(const ggml_tensor * t, int32_t axis) {
+    if (!ggml_is_contiguous(t)) {
+        return false;
+    }
+    if (!tracked(axis)) {
+        return true;
+    }
+    for (int k = axis + 1; k < 4; ++k) {
+        if (t->ne[k] != 1) {
+            return false;
+        }
+    }
+    return true;
+}
+
+ggml_type reported_type(ggml_type type) {
+    return type == GGML_TYPE_I32 ? GGML_TYPE_I32 : GGML_TYPE_F32;
+}
+
+float element_as_f32(ggml_type type, const uint8_t * p) {
+    switch (type) {
+        case GGML_TYPE_F16:
+            return ggml_fp16_to_fp32(*reinterpret_cast<const ggml_fp16_t *>(p));
+        case GGML_TYPE_BF16:
+            return ggml_bf16_to_fp32(*reinterpret_cast<const ggml_bf16_t *>(p));
+        default:
+            return *reinterpret_cast<const float *>(p);
+    }
+}
+
+// The columns of a value, from its root's bytes, as F32 or I32.
+const void * read_columns(const uint8_t * root, const ggml_tensor * t, int32_t axis, std::vector<uint8_t> & scratch) {
+    const ggml_type out = reported_type(t->type);
+    if (t->type == out && contiguous_columns(t, axis)) {
+        return root + offset_in_root(t);
+    }
+    const int64_t n_cols = columns_of(t, axis);
+    const int64_t len = column_len(t, axis);
+    scratch.resize(static_cast<size_t>(ggml_nelements(t)) * 4);
+    for (int64_t j = 0; j < n_cols; ++j) {
+        uint8_t * column = scratch.data() + static_cast<size_t>(j * len) * 4;
+        for_each_element(t, axis, j, [&](int64_t e, size_t offset) {
+            if (out == GGML_TYPE_I32) {
+                std::memcpy(column + e * 4, root + offset, 4);
+            } else {
+                const float v = element_as_f32(t->type, root + offset);
+                std::memcpy(column + e * 4, &v, 4);
+            }
+        });
+    }
+    return scratch.data();
+}
+
+void report_error(skippy_receipt_capture & capture, const std::string & message) {
+    skippy_receipt_ubatch report = {};
+    report.step = capture.step;
+    report.error = message.c_str();
+    capture.on_ubatch(capture.user_data, &report);
+}
+
+ggml_backend_t tensor_backend(ggml_backend_sched_t sched, const ggml_tensor * t) {
+    auto * mutable_t = const_cast<ggml_tensor *>(t);
+    ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched, mutable_t);
+    if (backend == nullptr && t->view_src != nullptr) {
+        backend = ggml_backend_sched_get_tensor_backend(sched, t->view_src);
+    }
+    return backend;
+}
+
+// Host memory of at least `size` bytes for one ubatch's copies. Pinned memory
+// lets the device copies run asynchronously; it is kept and grown as needed.
+uint8_t * host_block(skippy_receipt_capture::host_copy & copy, ggml_backend_sched_t sched,
+        const std::vector<const ggml_tensor *> & tensors, size_t size) {
+    if (copy.pinned && ggml_backend_buffer_get_size(copy.pinned.get()) >= size) {
+        return static_cast<uint8_t *>(ggml_backend_buffer_get_base(copy.pinned.get()));
+    }
+    copy.pinned.reset();
+    for (const ggml_tensor * t : tensors) {
+        ggml_backend_t backend = tensor_backend(sched, t);
+        ggml_backend_dev_t dev = backend != nullptr ? ggml_backend_get_device(backend) : nullptr;
+        ggml_backend_buffer_type_t buft = dev != nullptr ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+        if (buft == nullptr) {
+            continue;
+        }
+        copy.pinned.reset(ggml_backend_buft_alloc_buffer(buft, size + size / 4));
+        if (copy.pinned) {
+            copy.pageable = {};
+            return static_cast<uint8_t *>(ggml_backend_buffer_get_base(copy.pinned.get()));
+        }
+        break;
+    }
+    copy.pageable.resize(size);
+    return copy.pageable.data();
+}
+
+// Starts an asynchronous copy of bytes of a tensor to host memory.
+void fetch(ggml_backend_sched_t sched, const ggml_tensor * t, size_t offset, size_t size, uint8_t * dst) {
+    ggml_backend_t backend = tensor_backend(sched, t);
+    auto * mutable_t = const_cast<ggml_tensor *>(t);
+    if (backend != nullptr) {
+        ggml_backend_tensor_get_async(backend, mutable_t, dst, offset, size);
+    } else {
+        ggml_backend_tensor_get(mutable_t, dst, offset, size);
+    }
+}
+
+size_t aligned(size_t n) {
+    return (n + 63) & ~static_cast<size_t>(63);
+}
+
+// Fetches the stored rows of the ubatch's cells into `dst`, one per token.
+void fetch_rows(ggml_backend_sched_t sched, const ggml_tensor * rows, const std::vector<uint32_t> & cells,
+        uint8_t * dst) {
+    const ggml_tensor * root = root_of(rows);
+    const size_t row_bytes = ggml_row_size(rows->type, rows->ne[0]);
+    size_t i = 0;
+    while (i < cells.size()) {
+        size_t run = 1;
+        while (i + run < cells.size() && cells[i + run] == cells[i] + run) {
+            ++run;
+        }
+        if (rows->nb[1] == row_bytes || run == 1) {
+            const size_t offset = offset_in_root(rows) + static_cast<size_t>(cells[i]) * rows->nb[1];
+            fetch(sched, root, offset, row_bytes * run, dst + i * row_bytes);
+        } else {
+            for (size_t k = 0; k < run; ++k) {
+                const size_t offset = offset_in_root(rows) + static_cast<size_t>(cells[i] + k) * rows->nb[1];
+                fetch(sched, root, offset, row_bytes, dst + (i + k) * row_bytes);
+            }
+        }
+        i += run;
+    }
+}
+
+}  // namespace
+
+void skippy_receipt_mark_graph(skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens) {
+    mark(capture, res, n_tokens);
+}
+
+void skippy_receipt_mark_reserve_graph(const skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens) {
+    skippy_receipt_capture reserve;
+    reserve.mode = capture.mode;
+    reserve.layer = capture.layer;
+    mark(reserve, res, n_tokens);
+}
+
+void skippy_receipt_begin_compute(skippy_receipt_capture & capture) {
+    capture.stop_seen = 0;
+    capture.compute_error.clear();
+    if (capture.mode != skippy_receipt_mode::glue || capture.glue == nullptr || !capture.graph_error.empty()) {
+        return;
+    }
+    const skippy_receipt_glue_request & request = *capture.glue;
+    const skippy_receipt_glue_value residual = {
+        SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0, GGML_TYPE_F32, request.residual_len, request.residual};
+    for (size_t i = 0; i < request.n_values; ++i) {
+        const auto & v = request.values[i];
+        const bool used = std::any_of(capture.substitutes.begin(), capture.substitutes.end(),
+                [&](const skippy_receipt_substitute & s) { return s.kind == v.kind && s.index == v.index; });
+        if (!used) {
+            capture.compute_error = "an opened value (kind " + std::to_string(v.kind) + ", index " +
+                                    std::to_string(v.index) + ") matches nothing in the layer";
+            return;
+        }
+    }
+    std::vector<uint8_t> buffer;
+    for (const auto & s : capture.substitutes) {
+        const skippy_receipt_glue_value * value = s.kind == SKIPPY_RECEIPT_TENSOR_RESIDUAL ? &residual : nullptr;
+        for (size_t i = 0; i < request.n_values && value == nullptr; ++i) {
+            if (request.values[i].kind == s.kind && request.values[i].index == s.index) {
+                value = &request.values[i];
+            }
+        }
+        const int64_t n_cols = columns_of(s.node, s.axis);
+        const int64_t len = column_len(s.node, s.axis);
+        const ggml_type type = reported_type(s.node->type);
+        buffer.assign(ggml_nbytes(s.node), 0);
+        if (value == nullptr && s.kind == SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT) {
+            // every mixing output is committed, so an opening always has it
+            capture.compute_error = "no opened value for " + std::string(s.node->name);
+            return;
+        }
+        if (value == nullptr || value->values == nullptr) {
+            // nothing was opened (a row the layer did not keep): zeros
+            ggml_backend_tensor_set(s.node, buffer.data(), 0, buffer.size());
+            continue;
+        }
+        if (value->len != len || value->ggml_type != type || s.node->type != type || request.n_cols > n_cols) {
+            capture.compute_error = "the opened value for " + std::string(s.node->name) + " has " +
+                                    std::to_string(value->len) + " elements per column, the graph " +
+                                    std::to_string(len);
+            return;
+        }
+        const auto * values = static_cast<const uint8_t *>(value->values);
+        for (int64_t j = 0; j < n_cols; ++j) {
+            // columns past the request repeat its first column
+            const uint8_t * column = values + static_cast<size_t>((j < request.n_cols ? j : 0) * len) * 4;
+            for_each_element(s.node, s.axis, j, [&](int64_t e, size_t offset) {
+                std::memcpy(buffer.data() + offset, column + e * 4, 4);
+            });
+        }
+        ggml_backend_tensor_set(s.node, buffer.data(), 0, buffer.size());
+    }
+}
+
+bool skippy_receipt_eval(ggml_tensor * t, bool ask, void * user_data) {
+    auto & capture = *static_cast<skippy_receipt_capture *>(user_data);
+    if (capture.stop_after.empty()) {
+        // compute everything: no node is needed, and nothing stops
+        return !ask;
+    }
+    if (!ask) {
+        // called only after a needed node: the reported tensors are computed
+        return false;
+    }
+    if (capture.stop_seen == capture.stop_after.size()) {
+        // a later split: compute one node and stop
+        return true;
+    }
+    capture.stop_seen += capture.stop_after.count(t);
+    return capture.stop_seen == capture.stop_after.size();
+}
+
+void skippy_receipt_report_ubatch(
+        skippy_receipt_capture & capture,
+        ggml_backend_sched_t sched,
+        const llama_ubatch & ubatch,
+        llama_memory_context_i * mctx,
+        const llm_graph_result & res) {
+    GGML_UNUSED(res);
+    if (capture.on_ubatch == nullptr || !capture.report) {
+        return;
+    }
+    if (!capture.graph_error.empty()) {
+        report_error(capture, capture.graph_error);
+        return;
+    }
+    if (!capture.compute_error.empty()) {
+        report_error(capture, capture.compute_error);
+        return;
+    }
+    const auto * kv = dynamic_cast<const llama_kv_cache_context *>(mctx);
+    const std::vector<uint32_t> * cells = kv != nullptr ? kv->get_receipt_cells() : nullptr;
+    const uint32_t n = ubatch.n_tokens;
+    if (cells == nullptr || cells->size() != n) {
+        report_error(capture, "receipts need a plain KV cache with one stream");
+        return;
+    }
+    if (ubatch.pos == nullptr || ubatch.seq_id == nullptr || ubatch.output == nullptr) {
+        report_error(capture, "the ubatch has no positions, sequences or output flags");
+        return;
+    }
+    capture.token.resize(n);
+    capture.seq.resize(n);
+    capture.pos.resize(n);
+    capture.output.resize(n);
+    capture.cell.assign(cells->begin(), cells->end());
+    int64_t n_outputs = 0;
+    for (uint32_t i = 0; i < n; ++i) {
+        if (ubatch.n_seq_id[i] != 1) {
+            report_error(capture, "a token shared by several sequences cannot be receipted");
+            return;
+        }
+        capture.token[i] = ubatch.token != nullptr ? ubatch.token[i] : -1;
+        capture.seq[i] = ubatch.seq_id[i][0];
+        capture.pos[i] = ubatch.pos[i];
+        capture.output[i] = ubatch.output[i];
+        n_outputs += ubatch.output[i] != 0;
+    }
+    if (ubatch.token == nullptr && capture.input == nullptr) {
+        report_error(capture, "a ubatch of embeddings cannot be receipted");
+        return;
+    }
+
+    // One fetch per distinct root (the first layer's residual can be the
+    // import itself), and one block of stored rows per cache write.
+    std::vector<const ggml_tensor *> roots;
+    std::vector<size_t> slot(capture.targets.size());
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        const auto & target = capture.targets[i];
+        const ggml_tensor * root = target.rows != nullptr ? nullptr : root_of(target.tensor);
+        if (root == nullptr) {
+            continue;
+        }
+        size_t j = 0;
+        while (j < roots.size() && roots[j] != root) ++j;
+        if (j == roots.size()) roots.push_back(root);
+        slot[i] = j;
+    }
+    std::vector<size_t> offset(roots.size());
+    size_t size = 0;
+    for (size_t j = 0; j < roots.size(); ++j) {
+        offset[j] = size;
+        size += aligned(ggml_nbytes(roots[j]));
+    }
+    std::vector<size_t> rows_offset(capture.targets.size());
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        const ggml_tensor * rows = capture.targets[i].rows;
+        if (rows != nullptr) {
+            rows_offset[i] = size;
+            size += aligned(ggml_row_size(rows->type, rows->ne[0]) * n);
+        }
+    }
+    const size_t input_offset = size;
+    if (capture.input != nullptr) {
+        size += ggml_nbytes(capture.input);
+    }
+    auto & copy = capture.copies[capture.next_copy];
+    capture.next_copy ^= 1;
+    uint8_t * block = host_block(copy, sched, roots, size);
+    for (size_t j = 0; j < roots.size(); ++j) {
+        fetch(sched, roots[j], 0, ggml_nbytes(roots[j]), block + offset[j]);
+    }
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        if (capture.targets[i].rows != nullptr) {
+            fetch_rows(sched, capture.targets[i].rows, capture.cell, block + rows_offset[i]);
+        }
+    }
+    if (capture.input != nullptr) {
+        fetch(sched, capture.input, 0, ggml_nbytes(capture.input), block + input_offset);
+    }
+    ggml_backend_sched_synchronize(sched);
+
+    copy.converted.resize(capture.targets.size());
+    std::vector<skippy_receipt_tensor> tensors;
+    tensors.reserve(capture.targets.size());
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        const auto & target = capture.targets[i];
+        skippy_receipt_tensor tensor = {};
+        tensor.layer = target.layer;
+        tensor.kind = target.kind;
+        tensor.index = target.index;
+        tensor.flags = target.flags;
+        tensor.name = target.name;
+        if (target.rows != nullptr) {
+            tensor.ggml_type = target.rows->type;
+            tensor.len = target.rows->ne[0];
+            tensor.row_bytes = static_cast<int64_t>(ggml_row_size(target.rows->type, target.rows->ne[0]));
+            tensor.n_cols = n;
+            tensor.values = block + rows_offset[i];
+        } else {
+            const ggml_tensor * t = target.tensor;
+            tensor.n_cols = columns_of(t, target.axis);
+            if (tensor.n_cols != static_cast<int64_t>(n) && tensor.n_cols != n_outputs) {
+                report_error(capture, std::string("receipt tensor ") + t->name +
+                        " has neither a column per token nor per output");
+                return;
+            }
+            tensor.ggml_type = reported_type(t->type);
+            tensor.len = column_len(t, target.axis);
+            tensor.row_bytes = tensor.len * 4;
+            tensor.values = read_columns(block + offset[slot[i]], t, target.axis, copy.converted[i]);
+        }
+        tensors.push_back(tensor);
+    }
+    std::vector<const char *> unchecked;
+    for (const auto & name : capture.unchecked_weights) {
+        unchecked.push_back(name.c_str());
+    }
+
+    skippy_receipt_ubatch report = {};
+    report.step = capture.step;
+    report.n_tokens = static_cast<int32_t>(n);
+    report.token = capture.token.data();
+    report.seq = capture.seq.data();
+    report.pos = capture.pos.data();
+    report.output = capture.output.data();
+    report.cell = capture.cell.data();
+    report.n_kv = kv->get_n_kv();
+    if (capture.input != nullptr) {
+        report.input = block + input_offset;
+        report.input_row_bytes = static_cast<int64_t>(capture.input->nb[1]);
+        report.input_type = capture.input->type;
+    }
+    report.n_tensors = tensors.size();
+    report.tensors = tensors.data();
+    report.n_unchecked_weights = unchecked.size();
+    report.unchecked_weights = unchecked.data();
+    capture.on_ubatch(capture.user_data, &report);
+}
