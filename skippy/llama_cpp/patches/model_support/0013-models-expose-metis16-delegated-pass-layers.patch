@@ -258,133 +260,171 @@ ggml_tensor * llama_model_metis16::graph::route_features(const llama_model_metis
     return ggml_tanh(ctx0, ggml_add(ctx0, f, model.depth_mem_route_b));
 }
 
-llama_model_metis16::graph::graph(const llm_graph_params & params) :
-    llm_build_mamba_base(params) {
+void llama_model_metis16::graph::build_pass_layer(const llama_model_metis16 &  model,
+                                                  int                          il,
+                                                  llm_graph_input_mem_hybrid * inp,
+                                                  ggml_tensor *&               x,
+                                                  ggml_tensor *&               history,
+                                                  ggml_tensor *&               cont,
+                                                  ggml_tensor *&               summ,
+                                                  ggml_tensor *&               ent,
+                                                  ggml_tensor *&               conf,
+                                                  int &                        n_entry) {
+    const int     n_phys = model.n_layer_phys;
+    const int     p      = il / n_phys;
+    const int     il_p   = il % n_phys;
+    const int64_t n_r    = model.n_route;
+    const int64_t n_hd   = hparams.n_embd_head_k();
+    const int64_t n_exp  = hparams.n_expert;
+    const int64_t n_used = hparams.n_expert_used();
+
+    const auto & layer   = model.layers[il];
+    const bool   is_attn = !hparams.is_recr(il);
+    const bool   writes  = is_attn || il_p == n_phys - 1;
+
+    ggml_tensor * retrieved = bank_k ? mem_read(model, &x) : nullptr;
+    ggml_tensor * feats     = route_features(model, stream_mean(x), retrieved, nullptr, history);
+
+    ggml_tensor * mixed = nullptr;
+    ggml_tensor * cur   = hc_read(x, layer.hc_attn_mix, layer.hc_attn_read, layer.attn_norm, p, &mixed, il);
+    if (is_attn) {
+        ggml_tensor * qkv = build_lora_mm(layer.wqkv, cur);
+        ggml_tensor * lora =
+            ggml_mul_mat(ctx0, layer.attn_pass_lora_up, ggml_mul_mat(ctx0, layer.attn_pass_lora_down, cur));
+        qkv = ggml_add(
+            ctx0, qkv,
+            ggml_mul(ctx0, lora, ggml_view_1d(ctx0, layer.attn_pass_gate, 1, p * layer.attn_pass_gate->nb[0])));
+
+        const int64_t n_head    = hparams.n_head(il);
+        const int64_t n_head_kv = hparams.n_head_kv(il);
+        const size_t  es        = ggml_element_size(qkv);
+        ggml_tensor * Q = ggml_cont(ctx0, ggml_view_3d(ctx0, qkv, n_hd, n_head, n_tokens, n_hd * es, qkv->nb[1], 0));
+        ggml_tensor * K = ggml_cont(
+            ctx0, ggml_view_3d(ctx0, qkv, n_hd, n_head_kv, n_tokens, n_hd * es, qkv->nb[1], n_hd * n_head * es));
+        ggml_tensor * V = ggml_cont(ctx0, ggml_view_3d(ctx0, qkv, n_hd, n_head_kv, n_tokens, n_hd * es, qkv->nb[1],
+                                                       n_hd * (n_head + n_head_kv) * es));
+
+        cur = build_attn(inp->get_attn(), layer.wo, nullptr, nullptr, Q, K, V, nullptr, nullptr, nullptr,
+                         1.0f / sqrtf(float(n_hd)), il);
+    } else {
+        cur = build_mamba2_layer(inp->get_recr(), cur, ubatch, il);
+    }
+    cb(cur, "mixer_out", il);
+    x = hc_write(mixed, layer.hc_attn_write, cur, p);
+
+    cur = hc_read(x, layer.hc_ffn_mix, layer.hc_ffn_read, layer.ffn_norm, p, &mixed, il);
+    {
+        ggml_tensor * latent = ggml_mul_mat(ctx0, layer.ffn_latent_down, cur);
+        ggml_tensor * logits = ggml_mul_mat(ctx0, layer.ffn_gate_inp, ggml_concat(ctx0, latent, feats, 0));
+        logits               = ggml_add(ctx0, logits, layer.ffn_gate_inp_b);
+
+        // the balance bias picks the experts; the weights come from the unbiased logits
+        ggml_tensor * selected = ggml_argsort_top_k(ctx0, ggml_add(ctx0, logits, layer.ffn_exp_probs_b), n_used);
+
+        ggml_tensor * moe_out =
+            build_moe_ffn(latent, nullptr, nullptr, nullptr, layer.ffn_down_exps, nullptr, n_exp, n_used, LLM_FFN_SILU,
+                          false, 0.0f, LLAMA_EXPERT_GATING_FUNC_TYPE_SOFTMAX_WEIGHT, il_p, logits,
+                          layer.ffn_gate_up_exps, nullptr, nullptr, nullptr, selected);
+        ggml_tensor * shexp = build_ffn(latent, layer.ffn_up_shexp, NULL, NULL, layer.ffn_gate_shexp, NULL, NULL,
+                                        layer.ffn_down_shexp, NULL, NULL, NULL, LLM_FFN_SILU, LLM_FFN_PAR, il_p);
+        cur                 = ggml_mul_mat(ctx0, layer.ffn_latent_up, ggml_add(ctx0, moe_out, shexp));
+        cb(cur, "ffn_out", il);
+
+        // routing summary: the chosen experts' identity vectors blended by their weights
+        ggml_tensor * logits3 = ggml_reshape_3d(ctx0, logits, 1, n_exp, n_tokens);
+        ggml_tensor * weights =
+            ggml_soft_max(ctx0, ggml_reshape_2d(ctx0, ggml_get_rows(ctx0, logits3, selected), n_used, n_tokens));
+        ggml_tensor * rows = ggml_get_rows(ctx0, layer.ffn_exp_embd,
+                                           ggml_reshape_1d(ctx0, ggml_cont(ctx0, selected), n_used * n_tokens));
+        rows = ggml_cont(ctx0, ggml_permute(ctx0, ggml_reshape_3d(ctx0, rows, n_r, n_used, n_tokens), 1, 0, 2, 3));
+        summ = ggml_reshape_2d(ctx0, ggml_mul_mat(ctx0, rows, ggml_reshape_3d(ctx0, weights, n_used, 1, n_tokens)), n_r,
+                               n_tokens);
+
+        cb(summ, "route_summary", il);
+
+        if (writes) {
+            ggml_tensor * probs = ggml_soft_max(ctx0, logits);
+            ent  = ggml_sum_rows(ctx0, ggml_mul(ctx0, probs, ggml_log(ctx0, ggml_clamp(ctx0, probs, 1.0e-9f, 1.0f))));
+            ent  = ggml_scale(ctx0, ent, -1.0f);
+            conf = ggml_get_rows(ctx0, ggml_reshape_3d(ctx0, probs, 1, n_exp, n_tokens),
+                                 ggml_reshape_2d(ctx0, ggml_argmax(ctx0, probs), 1, n_tokens));
+            conf = ggml_reshape_2d(ctx0, conf, 1, n_tokens);
+            cb(ent, "route_entropy", il);
+            cb(conf, "route_confidence", il);
+        }
+    }
+    x = hc_write(mixed, layer.hc_ffn_write, cur, p);
+    cb(x, "streams", il);
+
+    history = history ? ggml_add(ctx0, ggml_scale(ctx0, history, 0.5f), ggml_scale(ctx0, summ, 0.5f)) :
+                        ggml_scale(ctx0, summ, 0.5f);
+    cb(history, "route_history", il);
+
+    if (is_attn) {
+        mem_write(model, x, summ, ent, conf, cont, n_entry++);
+    }
+}
