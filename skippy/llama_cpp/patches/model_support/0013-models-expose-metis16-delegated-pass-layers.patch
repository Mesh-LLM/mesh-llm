+++ b/src/models/metis16.cpp
@@ -241,6 +241,8 @@ void llama_model_metis16::graph::mem_write(const llama_model_metis16 & model, gg
     v = ggml_reshape_3d(ctx0, v, 1, n_m, n_tokens);
     bank_k  = bank_k  ? ggml_concat(ctx0, bank_k,  k, 1) : k;
