diff --git a/src/skippy/receipts_state.cpp b/src/skippy/receipts_state.cpp
new file mode 100644
index 000000000..582607858
--- /dev/null
+++ b/src/skippy/receipts_state.cpp
@@ -0,0 +1,261 @@
+// Receipts for hybrid memory: the recurrent state each turn starts from.
+//
+// A replay recomputes a turn's ubatches in a scratch context. Attention
+// layers read the KV cells of the turn's prefix, which the replay copies
+// from the stage's cache. A recurrent layer reads one state per sequence
+// that every ubatch overwrites, so after the turn the stage no longer
+// holds the state the turn started from. The recorder exports it before
+// the turn's first ubatch, and a replay imports it again.
+
+#include "skippy/receipts.h"
+
+#include "errors.h"
+#include "receipts_internal.h"
+#include "runtime_types.h"
+
+#include "ggml-backend.h"
+#include "llama-batch.h"
+#include "llama-context.h"
+#include "llama-io.h"
+#include "llama-kv-cache.h"
+#include "llama-memory-hybrid.h"
+#include "llama-memory-recurrent.h"
+
+#include <cstring>
+#include <mutex>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+
+// Writes the state into a growing buffer, reading each tensor range as it
+// comes.
+class state_writer : public llama_io_write_i {
+public:
+    void write(const void * src, size_t size) override {
+        const auto * bytes = static_cast<const uint8_t *>(src);
+        buffer.insert(buffer.end(), bytes, bytes + size);
+    }
+
+    void write_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        const size_t start = buffer.size();
+        buffer.resize(start + size);
+        ggml_backend_tensor_get(tensor, buffer.data() + start, offset, size);
+    }
+
+    size_t n_bytes() override { return buffer.size(); }
+
+    std::vector<uint8_t> buffer;
+};
+
+// Reads the state from a buffer, writing each tensor range as it comes.
+class state_reader : public llama_io_read_i {
+public:
+    state_reader(const uint8_t * bytes, size_t n_bytes) : ptr(bytes), left(n_bytes) {}
+
+    void read(void * dst, size_t size) override { std::memcpy(dst, take(size), size); }
+
+    void read_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        ggml_backend_tensor_set(tensor, take(size), offset, size);
+    }
+
+    size_t n_bytes() override { return read_bytes; }
+
+    size_t remaining() const { return left; }
+
+private:
+    const uint8_t * take(size_t size) {
+        if (size > left) {
+            throw std::runtime_error("the recurrent state ends early");
+        }
+        const uint8_t * at = ptr;
+        ptr += size;
+        left -= size;
+        read_bytes += size;
+        return at;
+    }
+
+    const uint8_t * ptr;
+    size_t left;
+    size_t read_bytes = 0;
+};
+
+llama_memory_recurrent * recurrent_memory(llama_context & ctx) {
+    auto * hybrid = dynamic_cast<llama_memory_hybrid *>(ctx.get_memory());
+    return hybrid != nullptr ? hybrid->get_mem_recr() : nullptr;
+}
+
+// Reports the state `seq` holds now, or no bytes when it cannot be read.
+void report_state(skippy_receipt_state_fn on_state, void * user_data, llama_context & ctx, llama_seq_id seq) {
+    llama_memory_recurrent * memory = recurrent_memory(ctx);
+    state_writer writer;
+    bool read = memory != nullptr;
+    if (read) {
+        try {
+            // the stage may still be computing the last ubatch
+            ctx.synchronize();
+            // The recurrent memory's own bytes, which skippy_receipt_read_state()
+            // reads back: it writes all of the sequence's state whatever the
+            // flags, and no header or KV cells as a whole sequence state has.
+            memory->state_write(writer, seq, LLAMA_STATE_SEQ_FLAGS_NONE);
+        } catch (const std::exception &) {
+            read = false;
+        }
+    }
+    if (read) {
+        on_state(user_data, seq, writer.buffer.data(), writer.buffer.size());
+    } else {
+        on_state(user_data, seq, nullptr, 0);
+    }
+}
+
+std::shared_ptr<skippy_receipt_capture> installed_recorder(skippy_model * model, skippy_error ** out_error) {
+    auto recorder = model != nullptr ? model->receipt_recorder.lock() : nullptr;
+    if (!recorder) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the receipt recorder is not installed");
+    }
+    return recorder;
+}
+
+}  // namespace
+
+llama_kv_cache * skippy_receipt_attention_cache(llama_context * ctx) {
+    llama_memory_i * memory = ctx->get_memory();
+    if (auto * kv = dynamic_cast<llama_kv_cache *>(memory)) {
+        return kv;
+    }
+    if (auto * hybrid = dynamic_cast<llama_memory_hybrid *>(memory)) {
+        return hybrid->get_mem_attn();
+    }
+    return nullptr;
+}
+
+const llama_kv_cache_context * skippy_receipt_attention_context(const llama_memory_context_i * mctx) {
+    if (const auto * kv = dynamic_cast<const llama_kv_cache_context *>(mctx)) {
+        return kv;
+    }
+    if (const auto * hybrid = dynamic_cast<const llama_memory_hybrid_context *>(mctx)) {
+        return hybrid->get_attn();
+    }
+    return nullptr;
+}
+
+void skippy_receipt_begin_batch(skippy_receipt_capture & capture, llama_context & ctx, const llama_batch_ext & batch) {
+    std::vector<llama_seq_id> starting;
+    skippy_receipt_state_fn on_state = nullptr;
+    void * user_data = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(capture.state_mutex);
+        if (capture.on_state == nullptr) {
+            return;
+        }
+        on_state = capture.on_state;
+        user_data = capture.state_user_data;
+        for (const auto & token : batch.tokens) {
+            for (const llama_seq_id seq : token.seq_ids) {
+                if (capture.state_reported.insert(seq).second) {
+                    starting.push_back(seq);
+                }
+            }
+        }
+    }
+    if (starting.empty()) {
+        return;
+    }
+    // the recorder sees the ubatches before the turn first
+    skippy_receipt_flush(capture);
+    for (const llama_seq_id seq : starting) {
+        report_state(on_state, user_data, ctx, seq);
+    }
+}
+
+void skippy_receipt_state_event(skippy_receipt_capture & capture, const skippy_receipt_memory_event & event) {
+    std::lock_guard<std::mutex> lock(capture.state_mutex);
+    const bool whole = event.p0 <= 0 && event.p1 < 0;
+    switch (event.op) {
+        case SKIPPY_RECEIPT_MEMORY_CLEAR:
+            capture.state_reported.clear();
+            break;
+        case SKIPPY_RECEIPT_MEMORY_SEQ_RM:
+            if (!whole) {
+                break;
+            }
+            if (event.seq < 0) {
+                capture.state_reported.clear();
+            } else {
+                capture.state_reported.erase(event.seq);
+            }
+            break;
+        case SKIPPY_RECEIPT_MEMORY_SEQ_KEEP:
+            for (auto it = capture.state_reported.begin(); it != capture.state_reported.end();) {
+                it = *it == event.seq ? std::next(it) : capture.state_reported.erase(it);
+            }
+            break;
+        default:
+            break;
+    }
+}
+
+bool skippy_receipt_read_state(
+        llama_context & ctx, llama_seq_id seq, const uint8_t * bytes, size_t n_bytes, std::string & error) {
+    llama_memory_recurrent * memory = recurrent_memory(ctx);
+    if (memory == nullptr) {
+        error = "the replay context has no recurrent memory";
+        return false;
+    }
+    state_reader reader(bytes, n_bytes);
+    try {
+        memory->state_read(reader, seq, LLAMA_STATE_SEQ_FLAGS_NONE);
+    } catch (const std::exception & exception) {
+        error = std::string("cannot import the recurrent state: ") + exception.what();
+        return false;
+    }
+    if (reader.remaining() != 0) {
+        error = "the recurrent state has bytes past its end";
+        return false;
+    }
+    return true;
+}
+
+enum skippy_status skippy_model_set_receipt_state_observer(
+        struct skippy_model * model,
+        skippy_receipt_state_fn on_state,
+        void * user_data,
+        bool * out_recurrent,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->ctx == nullptr || out_recurrent == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model with a context and out_recurrent are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto recorder = installed_recorder(model, out_error);
+    if (!recorder) {
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    const bool recurrent = recurrent_memory(*model->ctx) != nullptr;
+    std::lock_guard<std::mutex> lock(recorder->state_mutex);
+    recorder->on_state = recurrent ? on_state : nullptr;
+    recorder->state_user_data = recurrent ? user_data : nullptr;
+    // every sequence starts a turn with its next ubatch
+    recorder->state_reported.clear();
+    *out_recurrent = recurrent;
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_model_arm_receipt_state(
+        struct skippy_model * model,
+        int32_t seq,
+        struct skippy_error ** out_error) {
+    if (seq < 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "a sequence is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto recorder = installed_recorder(model, out_error);
+    if (!recorder) {
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    std::lock_guard<std::mutex> lock(recorder->state_mutex);
+    recorder->state_reported.erase(seq);
+    return skippy_success(out_error);
+}
diff --git a/src/skippy/receipts_storage.h b/src/skippy/receipts_storage.h
new file mode 100644
index 000000000..1f4adbb1c
--- /dev/null
+++ b/src/skippy/receipts_storage.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+// True means synchronous tensor_get reads CPU-accessible storage without a device copy.
+// This does not imply CPU backend compatibility or synchronization with pending device work.
+inline bool skippy_receipt_storage_host_readable(ggml_backend_buffer_t buffer) {
+    if (buffer == nullptr) {
+        return false;
+    }
+    if (ggml_backend_buffer_is_host(buffer)) {
+        return true;
+    }
+    ggml_backend_dev_t dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buffer));
+    ggml_backend_reg_t reg = dev != nullptr ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    if (reg == nullptr) {
+        return false;
+    }
+    using host_readable_fn = bool (*)(ggml_backend_buffer_t);
+    auto host_readable = reinterpret_cast<host_readable_fn>(
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_buffer_is_host_readable"));
+    return host_readable != nullptr && host_readable(buffer);
+}
diff --git a/src/skippy/receipts_token_axis.cpp b/src/skippy/receipts_token_axis.cpp
new file mode 100644
index 000000000..bd0ff1b4c
--- /dev/null
+++ b/src/skippy/receipts_token_axis.cpp
@@ -0,0 +1,425 @@
+// Token-axis rules of the layer classifier; see receipts_token_axis.h.
+
+#include "receipts_token_axis.h"
+
+using skippy_receipt_values::columns_of;
+using skippy_receipt_values::root_of;
+using skippy_receipt_values::tracked;
+
+namespace skippy_receipt_token_axis {
+
+namespace {
+
+bool same_shape(const ggml_tensor * a, const ggml_tensor * b) {
+    return a->ne[0] == b->ne[0] && a->ne[1] == b->ne[1] && a->ne[2] == b->ne[2] && a->ne[3] == b->ne[3];
+}
+
+}  // namespace
+
+
+axis_rule token_axis_rules::binary(const ggml_tensor * node) const {
+    const ggml_tensor * x = node->src[0];
+    const ggml_tensor * y = node->src[1];
+    const value_info xi = info(x);
+    const value_info yi = info(y);
+    if (yi.cls == value_class::constant) {
+        return keep(xi.axis);
+    }
+    if (xi.cls == value_class::constant) {
+        // y broadcasts into x's shape
+        if (tracked(yi.axis) && node->ne[yi.axis] != y->ne[yi.axis]) {
+            return mixes(yi.axis);
+        }
+        if (yi.axis == AXIS_SINGLE && ggml_nelements(y) != ggml_nelements(node)) {
+            return single_ ? keep(AXIS_SINGLE) : mixes();
+        }
+        return keep(yi.axis);
+    }
+    return agree(xi.axis, x, yi.axis, y);
+}
+
+axis_rule token_axis_rules::agree(int ax, const ggml_tensor * x, int ay, const ggml_tensor * y) const {
+    if (ax == AXIS_LOST || ay == AXIS_LOST) {
+        const int other = ax == AXIS_LOST ? ay : ax;
+        return keep(same_shape(x, y) ? other : AXIS_LOST);
+    }
+    if (ax == AXIS_SINGLE && ay == AXIS_SINGLE) {
+        return keep(AXIS_SINGLE);
+    }
+    if (ax == AXIS_SINGLE || ay == AXIS_SINGLE) {
+        const int axis = ax == AXIS_SINGLE ? ay : ax;
+        const ggml_tensor * t = ax == AXIS_SINGLE ? y : x;
+        return columns_of(t, axis) == 1 ? keep(axis) : mixes(axis);
+    }
+    if (ax == ay && x->ne[ax] == y->ne[ay]) {
+        return keep(ax);
+    }
+    return mixes(ax);
+}
+
+// An op that reduces, sorts or normalizes along ne0.
+axis_rule token_axis_rules::along_rows(const ggml_tensor * node) const {
+    const ggml_tensor * x = node->src[0];
+    const int axis = info(x).axis;
+    if (axis == 0 && x->ne[0] > 1) {
+        return mixes(axis);
+    }
+    return keep(axis);
+}
+
+axis_rule token_axis_rules::logical_reshape(const ggml_tensor * src, int axis, const ggml_tensor * out) const {
+    if (!tracked(axis)) {
+        return keep(axis);
+    }
+    const int64_t n = src->ne[axis];
+    if (n == 1) {
+        return keep(AXIS_SINGLE);
+    }
+    int64_t below = 1;
+    for (int k = 0; k < axis; ++k) {
+        below *= src->ne[k];
+    }
+    int64_t prefix = 1;
+    for (int b = 0; b < 4; ++b) {
+        if (prefix == below && out->ne[b] == n) {
+            return keep(b);
+        }
+        prefix *= out->ne[b];
+    }
+    return keep(AXIS_LOST);
+}
+
+// llama.cpp rotates a value by a constant square matrix in chunks of n
+// values: it flattens the value to rows of n and multiplies them. The
+// product holds the rotated value in the value's own order. When the
+// tokens are the value's outermost axis and n divides a token's values,
+// each row lies in one token, so a view of the product steps through
+// tokens as the same view of the value would. Returns the value, its
+// token axis in `axis` and the bytes between its tokens in `stride`, or
+// null when `product` is no such rotation.
+const ggml_tensor * token_axis_rules::rotated_value(const ggml_tensor * product, int & axis, size_t & stride) const {
+    if (product->op != GGML_OP_MUL_MAT || product->view_src != nullptr || !ggml_is_contiguous(product)) {
+        return nullptr;
+    }
+    const ggml_tensor * rotation = product->src[0];
+    const ggml_tensor * rows = product->src[1];
+    const int64_t n = rotation->ne[0];
+    if (info(rotation).cls != value_class::constant || rotation->ne[1] != n || ggml_nelements(rotation) != n * n ||
+            (rows->op != GGML_OP_RESHAPE && rows->op != GGML_OP_CONT) || rows->ne[0] != n) {
+        return nullptr;
+    }
+    const ggml_tensor * x = rows->src[0];
+    const value_info xi = info(x);
+    if ((xi.cls != value_class::clean && xi.cls != value_class::taint) ||
+            (xi.axis != AXIS_SINGLE && !tracked(xi.axis))) {
+        return nullptr;
+    }
+    if (xi.axis == AXIS_SINGLE) {
+        axis = AXIS_SINGLE;
+        return x;
+    }
+    int64_t below = 1;
+    for (int b = 0; b < 4; ++b) {
+        if (b < xi.axis) {
+            below *= x->ne[b];
+        } else if (b > xi.axis && x->ne[b] != 1) {
+            return nullptr;
+        }
+    }
+    if (below % n != 0) {
+        return nullptr;
+    }
+    axis = xi.axis;
+    stride = static_cast<size_t>(below) * ggml_type_size(product->type);
+    return x;
+}
+
+// A view addresses its root's memory; find which of its axes steps
+// through the root's tokens.
+axis_rule token_axis_rules::view(const ggml_tensor * node) const {
+    const ggml_tensor * root = root_of(node);
+    int a = info(root).axis;
+    size_t stride = 0;
+    const ggml_tensor * rotated = tracked(a) || a == AXIS_SINGLE ? nullptr : rotated_value(root, a, stride);
+    if (a == AXIS_SINGLE) {
+        return keep(AXIS_SINGLE);
+    }
+    if (!tracked(a) || !ggml_is_contiguous(root)) {
+        return keep(AXIS_LOST);
+    }
+    const int64_t n = rotated != nullptr ? rotated->ne[a] : root->ne[a];
+    if (rotated == nullptr) {
+        stride = root->nb[a];
+    }
+    if (n == 1) {
+        return keep(AXIS_SINGLE);
+    }
+    if (n == 0) {
+        // an empty token axis: the output rows of a ubatch with no outputs
+        for (int c = 0; c < 4; ++c) {
+            if (node->ne[c] == 0) {
+                return keep(c);
+            }
+        }
+        return keep(AXIS_LOST);
+    }
+    const size_t offset = node->view_src != nullptr ? node->view_offs : 0;
+    if ((offset / stride) % static_cast<size_t>(n) != 0) {
+        return mixes();
+    }
+    int b = -1;
+    bool subset = false;
+    for (int c = 0; c < 4; ++c) {
+        if (node->nb[c] == stride && node->ne[c] == n && b < 0) {
+            b = c;
+        } else if (node->nb[c] == stride && node->ne[c] > 1 && node->ne[c] < n) {
+            subset = true;
+        }
+    }
+    if (b < 0) {
+        return subset ? mixes() : keep(AXIS_LOST);
+    }
+    size_t extent = offset % stride + ggml_type_size(node->type);
+    for (int c = 0; c < 4; ++c) {
+        if (c == b || node->ne[c] <= 1) {
+            continue;
+        }
+        if (node->nb[c] < stride) {
+            extent += static_cast<size_t>(node->ne[c] - 1) * node->nb[c];
+        } else if (node->nb[c] % (stride * static_cast<size_t>(n)) != 0) {
+            return keep(AXIS_LOST);
+        }
+    }
+    if (extent > stride) {
+        return keep(AXIS_LOST);
+    }
+    return keep(b);
+}
+
+axis_rule token_axis_rules::matmul(const ggml_tensor * node) const {
+    const ggml_tensor * a = node->src[0];
+    const ggml_tensor * b = node->src[1];
+    const value_info ai = info(a);
+    const value_info bi = info(b);
+    const int guess = tracked(bi.axis) && bi.axis >= 1 ? bi.axis : bi.axis == AXIS_SINGLE ? AXIS_SINGLE : AXIS_LOST;
+    if (ai.cls == value_class::constant) {
+        if (bi.axis == 0 && b->ne[0] > 1) {
+            return mixes(guess);
+        }
+        return keep(bi.axis);
+    }
+    if (bi.cls == value_class::constant) {
+        if (ai.axis == 0 && a->ne[0] > 1) {
+            return mixes(guess);
+        }
+        if (ai.axis == 1) {
+            return keep(a->ne[1] == 1 ? AXIS_SINGLE : 0);
+        }
+        return keep(ai.axis);
+    }
+    if (ai.axis == AXIS_SINGLE && bi.axis == AXIS_SINGLE) {
+        return keep(AXIS_SINGLE);
+    }
+    if (tracked(ai.axis) && ai.axis == bi.axis && ai.axis >= 2 && a->ne[ai.axis] == b->ne[bi.axis]) {
+        return keep(ai.axis);
+    }
+    if (columns_of(a, ai.axis) == 1 && columns_of(b, bi.axis) == 1 && readable_axis(ai.axis) &&
+            readable_axis(bi.axis)) {
+        return keep(guess);
+    }
+    return mixes(guess);
+}
+
+axis_rule token_axis_rules::get_rows(const ggml_tensor * node) const {
+    const ggml_tensor * a = node->src[0];
+    const ggml_tensor * idx = node->src[1];
+    const value_info ai = info(a);
+    const value_info ii = info(idx);
+    if (facts_.output_indices.count(idx) != 0) {
+        // keeps the output rows
+        if (tracked(ai.axis) && ai.axis != 1 && a->ne[ai.axis] > 1) {
+            return mixes();
+        }
+        return keep(single_ || node->ne[1] == 1 ? AXIS_SINGLE : 1);
+    }
+    if (ai.cls == value_class::constant) {
+        if (tracked(ii.axis)) {
+            return keep(ii.axis < 3 ? ii.axis + 1 : AXIS_LOST);
+        }
+        return keep(ii.axis);
+    }
+    if (ii.cls == value_class::constant) {
+        if (ai.axis == 1 && a->ne[1] > 1) {
+            return mixes();
+        }
+        return keep(ai.axis);
+    }
+    if (ai.axis == AXIS_SINGLE && ii.axis == AXIS_SINGLE) {
+        return keep(AXIS_SINGLE);
+    }
+    if ((ai.axis == 2 && ii.axis == 1) || (ai.axis == 3 && ii.axis == 2)) {
+        return keep(ai.axis);
+    }
+    return mixes(tracked(ai.axis) && ai.axis >= 2 ? ai.axis : AXIS_LOST);
+}
+
+axis_rule token_axis_rules::concat(const ggml_tensor * node) const {
+    const int dim = reinterpret_cast<const int32_t *>(node->op_params)[0];
+    int axis = AXIS_SINGLE;
+    bool first = true;
+    for (int i = 0; i < 2; ++i) {
+        const ggml_tensor * s = node->src[i];
+        const value_info si = info(s);
+        if (si.cls == value_class::constant) {
+            continue;
+        }
+        if (si.axis == dim && s->ne[dim] > 1) {
+            return mixes();
+        }
+        if (!first && si.axis != axis) {
+            return mixes();
+        }
+        axis = si.axis;
+        first = false;
+    }
+    return keep(axis);
+}
+
+// The receipt op table was written against this set of ggml ops, and it
+// reads operand layouts that ggml does not promise to keep. An op the table
+// does not list is refused, so a new op is safe by default; a changed layout
+// of a listed op is not. When this fails after an upstream update, review
+// before changing the count:
+// - every new op: add it to clean_rule() below if it treats each token
+//   column by itself, to mixes_tokens() (receipts_token_axis.h) if it reads
+//   other tokens or state by definition, or leave it refused;
+// - FLASH_ATTN_EXT: q, k, v, mask in src[0..3], sinks in src[4], and scale,
+//   max_bias, logit_softcap in op_params[0..2] (mixing_axis() here,
+//   receipts_attention.cpp);
+// - ROPE: positions index ne2 of src[0];
+// - SET_ROWS: operands kept as (source, indices, destination) in src[0..2]
+//   (cache_write() in receipts_layers.cpp, bound_selections() in
+//   receipts_graph.cpp);
+// - GET_ROWS, MUL_MAT_ID, ADD_ID: which operand holds the ids and which
+//   dimension they index (get_rows() here, bound_selections());
+// - ARGSORT, TOP_K: they rank along ne0 (along_rows() here);
+// - CONCAT: the dimension in op_params[0] (concat() here);
+// - CPY: src[1] is the destination, written and not read
+//   (receipts_layers.cpp, receipts_mixing_state.cpp).
+static_assert(GGML_OP_COUNT == 102, "ggml ops changed: review the receipt op table (see the comment above)");
+
+axis_rule token_axis_rules::clean_rule(const ggml_tensor * node) const {
+    const ggml_tensor * x = node->src[0];
+    const int a0 = x != nullptr ? info(x).axis : AXIS_LOST;
+    switch (node->op) {
+        case GGML_OP_DUP:
+        case GGML_OP_SQR:
+        case GGML_OP_SQRT:
+        case GGML_OP_LOG:
+        case GGML_OP_SIN:
+        case GGML_OP_COS:
+        case GGML_OP_UNARY:
+        case GGML_OP_SCALE:
+        case GGML_OP_CLAMP:
+        case GGML_OP_LEAKY_RELU:
+        case GGML_OP_ADD1:
+        case GGML_OP_ADD_ID:
+            return keep(a0);
+        case GGML_OP_CONT:
+        case GGML_OP_CPY:
+            return same_shape(x, node) ? keep(a0) : logical_reshape(x, a0, node);
+        case GGML_OP_ADD:
+        case GGML_OP_SUB:
+        case GGML_OP_MUL:
+        case GGML_OP_DIV:
+            return binary(node);
+        case GGML_OP_GLU:
+            if (node->src[1] != nullptr) {
+                const axis_rule both = agree(a0, x, info(node->src[1]).axis, node->src[1]);
+                if (both.kind != axis_rule::per_token) {
+                    return both;
+                }
+            }
+            return along_rows(node);
+        case GGML_OP_NORM:
+        case GGML_OP_RMS_NORM:
+        case GGML_OP_L2_NORM:
+        case GGML_OP_SUM_ROWS:
+        case GGML_OP_MEAN:
+        case GGML_OP_ARGSORT:
+        case GGML_OP_TOP_K:
+        case GGML_OP_CUMSUM:
+            return along_rows(node);
+        case GGML_OP_SOFT_MAX:
+            if (node->src[1] != nullptr) {
+                // a mask that is not persistent state
+                return unknown_op();
+            }
+            return along_rows(node);
+        case GGML_OP_GROUP_NORM:
+            if (tracked(a0) && a0 != 3 && x->ne[a0] > 1) {
+                return mixes(a0);
+            }
+            return keep(a0);
+        case GGML_OP_SUM:
+            return columns_of(x, a0) > 1 || a0 == AXIS_LOST ? mixes() : keep(AXIS_SINGLE);
+        case GGML_OP_ROPE:
+            // positions index ne2
+            if (tracked(a0) && a0 != 2 && x->ne[a0] > 1) {
+                return mixes(a0);
+            }
+            return keep(a0);
+        case GGML_OP_MUL_MAT:
+            return matmul(node);
+        case GGML_OP_GET_ROWS:
+            return get_rows(node);
+        case GGML_OP_CONCAT:
+            return concat(node);
+        case GGML_OP_REPEAT:
+            if (tracked(a0) && node->ne[a0] != x->ne[a0]) {
+                return mixes(a0);
+            }
+            if (a0 == AXIS_SINGLE && ggml_nelements(x) != ggml_nelements(node) && !single_) {
+                return mixes();
+            }
+            return keep(a0);
+        case GGML_OP_PAD:
+            if (tracked(a0) && node->ne[a0] != x->ne[a0]) {
+                return mixes(a0);
+            }
+            return keep(a0);
+        case GGML_OP_DIAG:
+        case GGML_OP_DIAG_MASK_INF:
+        case GGML_OP_DIAG_MASK_ZERO:
+        case GGML_OP_TRI:
+            if (tracked(a0) && a0 <= 1 && x->ne[a0] > 1) {
+                return mixes(a0);
+            }
+            return keep(a0);
+        case GGML_OP_VIEW:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_TRANSPOSE:
+            return view(node);
+        default:
+            return unknown_op();
+    }
+}
+
+int token_axis_rules::mixing_axis(const ggml_tensor * node) const {
+    if (single_) {
+        return AXIS_SINGLE;
+    }
+    if (node->op == GGML_OP_FLASH_ATTN_EXT) {
+        // q is [head, tokens, heads]; the output is [head, heads, tokens]
+        const int q = info(node->src[0]).axis;
+        return q == 1 ? 2 : q == AXIS_SINGLE ? AXIS_SINGLE : AXIS_LOST;
+    }
+    if (mixes_tokens(node->op)) {
+        return AXIS_LOST;
+    }
+    const axis_rule rule = clean_rule(node);
+    return rule.axis;
+}
+
+}  // namespace skippy_receipt_token_axis
diff --git a/src/skippy/receipts_token_axis.h b/src/skippy/receipts_token_axis.h
new file mode 100644
index 000000000..812d2d1c8
--- /dev/null
+++ b/src/skippy/receipts_token_axis.h
@@ -0,0 +1,116 @@
+#pragma once
+
+// How each ggml op treats the token axis of its per-token and constant
+// inputs, which decides whether a node is glue the client evaluates, part
+// of a token-mixing region, or an op receipts cannot follow
+// (receipts_layers.h).
+
+#include "receipts_layers.h"
+#include "receipts_values.h"
+
+#include "ggml.h"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace skippy_receipt_token_axis {
+
+// a per-token value whose token axis the classifier could not follow
+constexpr int AXIS_LOST = -1;
+constexpr int AXIS_SINGLE = SKIPPY_RECEIPT_AXIS_SINGLE;
+
+inline bool readable_axis(int axis) {
+    return skippy_receipt_values::tracked(axis) || axis == AXIS_SINGLE;
+}
+
+// Ops whose output column depends on other tokens' columns or on persistent
+// state by definition.
+inline bool mixes_tokens(ggml_op op) {
+    switch (op) {
+        case GGML_OP_FLASH_ATTN_EXT:
+        case GGML_OP_SSM_CONV:
+        case GGML_OP_SSM_SCAN:
+        case GGML_OP_RWKV_WKV6:
+        case GGML_OP_RWKV_WKV7:
+        case GGML_OP_GATED_LINEAR_ATTN:
+        case GGML_OP_GATED_DELTA_NET:
+        case GGML_OP_LIGHTNING_INDEXER:
+            return true;
+        default:
+            return false;
+    }
+}
+
+enum class value_class : uint8_t {
+    // no token dependence: weights, values computed from weights only
+    constant,
+    // per-token values the client computes itself
+    clean,
+    // values inside a token-mixing region
+    taint,
+    // values the client cannot compute: persistent state and the inputs
+    // that select it (attention masks, cell and state indices), and values
+    // nothing commits (see value_info::foreign)
+    opaque,
+};
+
+struct value_info {
+    value_class cls = value_class::opaque;
+    int axis = AXIS_LOST;
+    // An opaque value that is, or depends on, something other than
+    // persistent state and its selectors: a value from another layer or
+    // from outside every layer, a token input, a graph input the facts do
+    // not name. Nothing commits it, so no node of a layer may read it.
+    bool foreign = false;
+};
+
+// How an op treats the token axis of per-token inputs.
+struct axis_rule {
+    enum kind_t { per_token, mixes, unknown } kind = unknown;
+    int axis = AXIS_LOST;
+};
+
+inline axis_rule keep(int axis) {
+    return {axis_rule::per_token, axis};
+}
+
+inline axis_rule mixes(int axis_guess = AXIS_LOST) {
+    return {axis_rule::mixes, axis_guess};
+}
+
+inline axis_rule unknown_op() {
+    return {axis_rule::unknown, AXIS_LOST};
+}
+
+// The token-axis rules, over what the classifier knows of each value.
+class token_axis_rules {
+public:
+    virtual ~token_axis_rules() = default;
+
+protected:
+    explicit token_axis_rules(const skippy_receipt_graph_facts & facts)
+        : facts_(facts), single_(facts.n_tokens == 1) {}
+
+    // The class and token axis of a value the rules read.
+    virtual value_info info(const ggml_tensor * t) const = 0;
+
+    // Token axis of a node whose inputs are per-token or constant.
+    axis_rule clean_rule(const ggml_tensor * node) const;
+    int mixing_axis(const ggml_tensor * node) const;
+    const ggml_tensor * rotated_value(const ggml_tensor * product, int & axis, size_t & stride) const;
+
+    const skippy_receipt_graph_facts & facts_;
+    const bool single_;
+
+private:
+    axis_rule binary(const ggml_tensor * node) const;
+    axis_rule agree(int ax, const ggml_tensor * x, int ay, const ggml_tensor * y) const;
+    axis_rule along_rows(const ggml_tensor * node) const;
+    axis_rule logical_reshape(const ggml_tensor * src, int axis, const ggml_tensor * out) const;
+    axis_rule view(const ggml_tensor * node) const;
+    axis_rule matmul(const ggml_tensor * node) const;
+    axis_rule get_rows(const ggml_tensor * node) const;
+    axis_rule concat(const ggml_tensor * node) const;
+};
+
+}  // namespace skippy_receipt_token_axis
diff --git a/src/skippy/receipts_values.h b/src/skippy/receipts_values.h
new file mode 100644
index 000000000..04d9a0d8c
--- /dev/null
+++ b/src/skippy/receipts_values.h
@@ -0,0 +1,80 @@
+#pragma once
+
+// How a receipt value is laid out in the tensor that holds it: its columns
+// (one per token, along the tracked axis) and their elements. Shared by the
+// graph marking, which writes opened values into a glue graph, and the
+// readback, which reads computed values on the host.
+
+#include "ggml.h"
+#include "skippy/receipts.h"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace skippy_receipt_values {
+
+inline bool tracked(int32_t axis) {
+    return axis >= 0 && axis < 4;
+}
+
+inline int64_t columns_of(const ggml_tensor * t, int32_t axis) {
+    if (ggml_nelements(t) == 0) {
+        return 0;  // no output rows
+    }
+    return tracked(axis) ? t->ne[axis] : 1;
+}
+
+// Elements per column; a value can have no columns (no output rows).
+inline int64_t column_len(const ggml_tensor * t, int32_t axis) {
+    int64_t len = 1;
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (!tracked(axis) || d != axis) {
+            len *= t->ne[d];
+        }
+    }
+    return len;
+}
+
+inline const ggml_tensor * root_of(const ggml_tensor * t) {
+    return t->view_src != nullptr ? t->view_src : t;
+}
+
+inline size_t offset_in_root(const ggml_tensor * t) {
+    return t->view_src != nullptr ? t->view_offs : 0;
+}
+
+inline ggml_type reported_type(ggml_type type) {
+    return type == GGML_TYPE_I32 ? GGML_TYPE_I32 : GGML_TYPE_F32;
+}
+
+// Calls f(element, byte offset in the root) for every element of column j,
+// i0 fastest, skipping the token axis. `base` is the tensor's offset in its
+// root.
+template <typename F>
+void for_each_element(const ggml_tensor * t, int32_t axis, int64_t j, size_t base, F && f) {
+    int64_t ne[4] = {t->ne[0], t->ne[1], t->ne[2], t->ne[3]};
+    if (tracked(axis)) {
+        ne[axis] = 1;
+        base += static_cast<size_t>(j) * t->nb[axis];
+    }
+    int64_t e = 0;
+    for (int64_t i3 = 0; i3 < ne[3]; ++i3) {
+        for (int64_t i2 = 0; i2 < ne[2]; ++i2) {
+            for (int64_t i1 = 0; i1 < ne[1]; ++i1) {
+                const size_t row = base + i3 * t->nb[3] + i2 * t->nb[2] + i1 * t->nb[1];
+                for (int64_t i0 = 0; i0 < ne[0]; ++i0) {
+                    f(e++, row + i0 * t->nb[0]);
+                }
+            }
+        }
+    }
+}
+
+// A zeroed state cell keeps the sign of each value it held, and the sign of
+// a zero changes nothing the state is used for. A state is reported with
+// positive zeros, so its digest does not depend on what the cell held.
+inline bool unsigned_zeros(int32_t kind) {
+    return kind == SKIPPY_RECEIPT_TENSOR_MIXING_STATE || kind == SKIPPY_RECEIPT_TENSOR_MIXING_STATE_OUT;
+}
+
+}  // namespace skippy_receipt_values
