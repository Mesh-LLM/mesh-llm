+#pragma once
+
+// The recurrent states a layer's token-mixing regions read and write.
+//
+// A recurrent op (the gated delta net, Mamba's scan, a short convolution)
+// reads one state per sequence that the ubatch's tokens continue, and
+// writes it back after them. A receipt commits the state each ubatch reads,
+// so a client can recompute the ubatch from it and compare what the op
+// wrote with what the next ubatch read.
+
+#include "receipts_layers.h"
+
+#include <functional>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+struct ggml_cgraph;
+struct ggml_tensor;
+
+// What the scan needs from the classifier.
+struct skippy_receipt_state_scan {
+    // the node is inside a token-mixing region
+    std::function<bool(const ggml_tensor *)> in_region;
+    // canonical storage of persistent state
+    const std::unordered_set<const ggml_tensor *> * storage = nullptr;
+    int64_t n_seqs = 1;
+};
+
+// Finds the states read and written by the token-mixing regions among the
+// nodes `lo + 1..hi` of `gf`, in the order the graph reads them. Returns an
+// empty string, or why a state cannot be committed.
+std::string skippy_receipt_find_states(ggml_cgraph * gf, int lo, int hi, const skippy_receipt_state_scan & scan,
+        std::vector<skippy_receipt_state> & states);
diff --git a/src/skippy/receipts_readback.cpp b/src/skippy/receipts_readback.cpp
new file mode 100644
index 000000000..971d193c1
--- /dev/null
+++ b/src/skippy/receipts_readback.cpp
@@ -0,0 +1,985 @@
+// Reading a computed ubatch's receipt tensors back to the host, and reporting
+// them.
+//
+// A recorder on a device that copies asynchronously does not wait for its
+// ubatch's values. Right after the graph, on the compute stream, it copies
+// them on the device into a staging buffer; a copy thread then copies the
+// staging buffer to the host on a second stream while later ubatches compute.
+// The ubatch is reported two ubatches later, when that copy is normally done,
+// or earlier when a memory event or a flush needs every report made in order.
+// Waiting for the copy sooner would hold the decoding thread, which in a
+// split hands the ubatch's activations to the next stage, for as long as the
+// copy takes. The copy thread submits the copy in small pieces: the device's
+// copy engine serves copies in submission order across streams, and one
+// large copy would hold the stage's own small readbacks behind it.
+//
+// Replays and glue evaluations, devices without asynchronous copies, and
+// values the host holds or can read in place, such as those in Metal's shared
+// buffers, are read and reported at once.
+
+#include "receipts_internal.h"
+#include "receipts_values.h"
+#include "receipts_storage.h"
+
+#include "ggml-backend.h"
+#include "llama-batch.h"
+#include "llama-kv-cache.h"
+
+#include <algorithm>
+#include <condition_variable>
+#include <cstring>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+
+using namespace skippy_receipt_values;
+
+// Reads `n` bytes of `src` at `offset` into host memory. A device reads
+// asynchronously only into pinned memory, which it has mapped, and the
+// caller then synchronizes `backend`; pageable memory is filled by a
+// blocking read.
+static void read_to_host(ggml_backend_t backend, ggml_tensor * src, uint8_t * dst, size_t offset, size_t n, bool pinned) {
+    if (backend != nullptr && pinned) {
+        ggml_backend_tensor_get_async(backend, src, dst, offset, n);
+    } else {
+        ggml_backend_tensor_get(src, dst, offset, n);
+    }
+}
+
+struct skippy_receipt_transfer {
+    static constexpr int STAGING = 2;
+    // a host copy of a staged ubatch: the block ranges to fill from staging
+    // buffer s, and the work that needs the copied values
+    struct job {
+        int s = 0;
+        uint8_t * block = nullptr;
+        // a block in pageable memory is filled by blocking copies: a
+        // device may read asynchronously only into memory it has mapped
+        bool pinned = false;
+        std::vector<std::pair<size_t, size_t>> ranges;
+        uint64_t ticket = 0;
+        // run once the block is filled: puts the values in column order
+        std::function<void()> then;
+    };
+    // pieces small enough that a copy the graph waits on, such as a stage's
+    // activations, never queues long behind one: the device's copy engine
+    // takes copies in the order they are submitted, from every stream
+    static constexpr size_t PIECE = 1u << 20;
+
+    // the backend the graph computes on; not owned
+    ggml_backend_t compute = nullptr;
+    // a second backend of the same device, whose stream copies to the host
+    ggml_backend_t copier = nullptr;
+    // per staging buffer: the device copy into it is done
+    ggml_backend_event_t staged[STAGING] = {};
+    ggml_backend_buffer_t staging[STAGING] = {};
+    // a tensor over the whole of each staging buffer, for the host copies
+    ggml_context * whole_ctx[STAGING] = {};
+    ggml_tensor * whole[STAGING] = {};
+    // per staging buffer: the digest plan of the ubatch that uses it, which
+    // the device reads from this host memory after the digests are queued
+    skippy_receipt_digest_plan plans[STAGING];
+    int next_staging = 0;
+    // headers of the tensors that alias the copied ranges
+    ggml_context * aliases = nullptr;
+    size_t alias_capacity = 0;
+
+    // The copy thread: it submits each job's pieces one at a time and waits
+    // for each, so the decoding thread never waits for a host copy it did not
+    // need yet.
+    std::mutex mutex;
+    std::condition_variable changed;
+    std::deque<job> jobs;
+    uint64_t submitted = 0;
+    uint64_t completed = 0;
+    bool stopping = false;
+    std::thread worker;
+
+    void start() { worker = std::thread([this] { run(); }); }
+
+    uint64_t enqueue(int s, uint8_t * block, bool pinned, std::vector<std::pair<size_t, size_t>> ranges,
+            std::function<void()> then) {
+        std::lock_guard<std::mutex> lock(mutex);
+        jobs.push_back({s, block, pinned, std::move(ranges), ++submitted, std::move(then)});
+        changed.notify_all();
+        return submitted;
+    }
+
+    void wait(uint64_t ticket) {
+        std::unique_lock<std::mutex> lock(mutex);
+        changed.wait(lock, [&] { return completed >= ticket; });
+    }
+
+    void run() {
+        for (;;) {
+            job next;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                changed.wait(lock, [&] { return stopping || !jobs.empty(); });
+                if (stopping) {
+                    return;
+                }
+                next = std::move(jobs.front());
+                jobs.pop_front();
+            }
+            ggml_backend_event_synchronize(staged[next.s]);
+            for (const auto & [start, end] : next.ranges) {
+                for (size_t at = start; at < end; at += PIECE) {
+                    const size_t n = std::min(PIECE, end - at);
+                    read_to_host(copier, whole[next.s], next.block + at, at, n, next.pinned);
+                    if (next.pinned) {
+                        ggml_backend_synchronize(copier);
+                    }
+                }
+            }
+            if (next.then) {
+                next.then();
+            }
+            std::lock_guard<std::mutex> lock(mutex);
+            completed = next.ticket;
+            changed.notify_all();
+        }
+    }
+
+    ~skippy_receipt_transfer() {
+        if (worker.joinable()) {
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                stopping = true;
+            }
+            changed.notify_all();
+            // the thread waits for each piece, so no copy into a host block
+            // is left running once it has stopped
+            worker.join();
+        }
+        if (compute != nullptr) {
+            // device copies into the staging buffers may still be running
+            ggml_backend_synchronize(compute);
+        }
+        for (int s = 0; s < STAGING; ++s) {
+            if (staged[s] != nullptr) {
+                ggml_backend_event_free(staged[s]);
+            }
+            if (staging[s] != nullptr) {
+                ggml_backend_buffer_free(staging[s]);
+            }
+            if (whole_ctx[s] != nullptr) {
+                ggml_free(whole_ctx[s]);
+            }
+        }
+        if (copier != nullptr) {
+            ggml_backend_free(copier);
+        }
+        if (aliases != nullptr) {
+            ggml_free(aliases);
+        }
+    }
+};
+
+void skippy_receipt_capture::transfer_deleter::operator()(skippy_receipt_transfer * transfer) const {
+    delete transfer;
+}
+
+namespace {
+
+// Columns are contiguous, in order, starting at the tensor's offset.
+bool contiguous_columns(const ggml_tensor * t, int32_t axis) {
+    if (!ggml_is_contiguous(t)) {
+        return false;
+    }
+    if (!tracked(axis)) {
+        return true;
+    }
+    for (int k = axis + 1; k < 4; ++k) {
+        if (t->ne[k] != 1) {
+            return false;
+        }
+    }
+    return true;
+}
+
+float element_as_f32(ggml_type type, const uint8_t * p) {
+    switch (type) {
+        case GGML_TYPE_F16:
+            return ggml_fp16_to_fp32(*reinterpret_cast<const ggml_fp16_t *>(p));
+        case GGML_TYPE_BF16:
+            return ggml_bf16_to_fp32(*reinterpret_cast<const ggml_bf16_t *>(p));
+        default:
+            return *reinterpret_cast<const float *>(p);
+    }
+}
+
+// The columns of a value, as F32 or I32, from its root's bytes. `base` is the
+// value's offset in the root.
+const void * read_columns(
+        const uint8_t * root, const ggml_tensor * t, size_t base, int32_t axis, std::vector<uint8_t> & scratch) {
+    const ggml_type out = reported_type(t->type);
+    if (t->type == out && contiguous_columns(t, axis)) {
+        return root + base;
+    }
+    const int64_t n_cols = columns_of(t, axis);
+    const int64_t len = column_len(t, axis);
+    scratch.resize(static_cast<size_t>(ggml_nelements(t)) * 4);
+    if (t->type == out && t->nb[0] == 4 && axis != 0) {
+        // whole rows of dimension 0 at a time
+        const size_t row = static_cast<size_t>(t->ne[0]) * 4;
+        int64_t ne[4] = {t->ne[0], t->ne[1], t->ne[2], t->ne[3]};
+        if (tracked(axis)) {
+            ne[axis] = 1;
+        }
+        for (int64_t j = 0; j < n_cols; ++j) {
+            uint8_t * column = scratch.data() + static_cast<size_t>(j * len) * 4;
+            const size_t start = base + (tracked(axis) ? static_cast<size_t>(j) * t->nb[axis] : 0);
+            for (int64_t i3 = 0; i3 < ne[3]; ++i3) {
+                for (int64_t i2 = 0; i2 < ne[2]; ++i2) {
+                    for (int64_t i1 = 0; i1 < ne[1]; ++i1) {
+                        std::memcpy(column, root + start + i3 * t->nb[3] + i2 * t->nb[2] + i1 * t->nb[1], row);
+                        column += row;
+                    }
+                }
+            }
+        }
+        return scratch.data();
+    }
+    for (int64_t j = 0; j < n_cols; ++j) {
+        uint8_t * column = scratch.data() + static_cast<size_t>(j * len) * 4;
+        for_each_element(t, axis, j, base, [&](int64_t e, size_t offset) {
+            if (out == GGML_TYPE_I32) {
+                std::memcpy(column + e * 4, root + offset, 4);
+            } else {
+                const float v = element_as_f32(t->type, root + offset);
+                std::memcpy(column + e * 4, &v, 4);
+            }
+        });
+    }
+    return scratch.data();
+}
+
+// A graph value whose columns must be gathered or converted before reporting.
+bool needs_columns(const skippy_receipt_layout & layout) {
+    return !layout.stored_rows && !layout.digested &&
+            !(layout.shape.type == reported_type(layout.shape.type) && contiguous_columns(&layout.shape, layout.axis));
+}
+
+void report_error(skippy_receipt_capture & capture, const std::string & message) {
+    skippy_receipt_ubatch report = {};
+    report.step = capture.step;
+    report.error = message.c_str();
+    capture.on_ubatch(capture.user_data, &report);
+}
+
+ggml_backend_t tensor_backend(ggml_backend_sched_t sched, const ggml_tensor * t) {
+    auto * mutable_t = const_cast<ggml_tensor *>(t);
+    ggml_backend_t backend = ggml_backend_sched_get_tensor_backend(sched, mutable_t);
+    if (backend == nullptr && t->view_src != nullptr) {
+        backend = ggml_backend_sched_get_tensor_backend(sched, t->view_src);
+    }
+    return backend;
+}
+
+// Places `rec`'s values in host memory of at least `size` bytes, in its
+// host copy. Pinned memory lets the device copies run asynchronously; it is
+// kept and grown as needed.
+void place_in_host_block(skippy_receipt_capture & capture, ggml_backend_sched_t sched, skippy_receipt_recorded & rec,
+        const std::vector<const ggml_tensor *> & tensors, size_t size) {
+    skippy_receipt_capture::host_copy & copy = capture.copies[rec.slot];
+    rec.pinned = true;
+    if (copy.pinned && ggml_backend_buffer_get_size(copy.pinned.get()) >= size) {
+        rec.block = static_cast<uint8_t *>(ggml_backend_buffer_get_base(copy.pinned.get()));
+        return;
+    }
+    copy.pinned.reset();
+    for (const ggml_tensor * t : tensors) {
+        ggml_backend_t backend = tensor_backend(sched, t);
+        ggml_backend_dev_t dev = backend != nullptr ? ggml_backend_get_device(backend) : nullptr;
+        ggml_backend_buffer_type_t buft = dev != nullptr ? ggml_backend_dev_host_buffer_type(dev) : nullptr;
+        if (buft == nullptr) {
+            continue;
+        }
+        copy.pinned.reset(ggml_backend_buft_alloc_buffer(buft, size + size / 4));
+        if (copy.pinned) {
+            copy.pageable = {};
+            rec.block = static_cast<uint8_t *>(ggml_backend_buffer_get_base(copy.pinned.get()));
+            return;
+        }
+        break;
+    }
+    copy.pageable.resize(size);
+    rec.block = copy.pageable.data();
+    rec.pinned = false;
+}
+
+using value_copy = skippy_receipt_value_copy;
+
+// The ranges of the stored rows of the ubatch's tokens, rows `cells` of the
+// cache tensor (stream * size + cell), one row per token from `dst` on.
+void add_row_copies(std::vector<value_copy> & copies, const ggml_tensor * rows, const std::vector<uint32_t> & cells,
+        size_t dst) {
+    const ggml_tensor * root = root_of(rows);
+    const size_t row_bytes = ggml_row_size(rows->type, rows->ne[0]);
+    size_t i = 0;
+    while (i < cells.size()) {
+        size_t run = 1;
+        while (i + run < cells.size() && cells[i + run] == cells[i] + run) {
+            ++run;
+        }
+        if (rows->nb[1] == row_bytes || run == 1) {
+            const size_t offset = offset_in_root(rows) + static_cast<size_t>(cells[i]) * rows->nb[1];
+            copies.push_back({root, offset, row_bytes * run, dst + i * row_bytes});
+        } else {
+            for (size_t k = 0; k < run; ++k) {
+                const size_t offset = offset_in_root(rows) + static_cast<size_t>(cells[i] + k) * rows->nb[1];
+                copies.push_back({root, offset, row_bytes, dst + (i + k) * row_bytes});
+            }
+        }
+        i += run;
+    }
+}
+
+// The ubatch's tokens and cells, its tensors' layouts, the copies that read
+// them (in the capture's readback buffers), and the host block size they
+// need, or why it cannot be receipted.
+std::string describe(skippy_receipt_capture & capture, const llama_ubatch & ubatch, llama_memory_context_i * mctx,
+        skippy_receipt_recorded & rec, size_t & size) {
+    std::vector<value_copy> & copies = capture.readback.copies;
+    std::vector<const ggml_tensor *> & roots = capture.readback.roots;
+    std::vector<size_t> & slot = capture.readback.slots;
+    std::vector<size_t> & offset = capture.readback.offsets;
+    copies.clear();
+    roots.clear();
+    const auto * kv = skippy_receipt_attention_context(mctx);
+    const uint32_t n = ubatch.n_tokens;
+    if (kv == nullptr || !kv->get_receipt_cells(rec.cell, rec.row) || rec.cell.size() != n) {
+        return "receipts need a plain KV cache";
+    }
+    if (ubatch.pos == nullptr || ubatch.seq_id == nullptr || ubatch.output == nullptr) {
+        return "the ubatch has no positions, sequences or output flags";
+    }
+    rec.step = capture.step;
+    rec.n_tokens = n;
+    rec.n_kv = kv->get_n_kv();
+    rec.token.resize(n);
+    rec.seq.resize(n);
+    rec.pos.resize(n);
+    rec.output.resize(n);
+    for (uint32_t i = 0; i < n; ++i) {
+        if (ubatch.n_seq_id[i] != 1) {
+            return "a token shared by several sequences cannot be receipted";
+        }
+        rec.token[i] = ubatch.token != nullptr ? ubatch.token[i] : -1;
+        rec.seq[i] = ubatch.seq_id[i][0];
+        rec.pos[i] = ubatch.pos[i];
+        // one position per token is kept: a replay rebuilds the others
+        for (uint32_t section = 1; section < ubatch.n_pos; ++section) {
+            if (ubatch.pos[static_cast<size_t>(section) * n + i] != skippy_receipt_position_section(ubatch.pos[i], section)) {
+                return "a token whose positions are not a text token's cannot be receipted";
+            }
+        }
+        rec.output[i] = ubatch.output[i];
+        rec.n_outputs += ubatch.output[i] != 0;
+    }
+    if (ubatch.token == nullptr && capture.input == nullptr) {
+        return "a ubatch of embeddings cannot be receipted";
+    }
+
+    // One fetch per distinct root (the first layer's residual can be the
+    // import itself), and one block of stored rows per cache write.
+    slot.assign(capture.targets.size(), 0);
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        const auto & target = capture.targets[i];
+        if (target.rows != nullptr) {
+            continue;
+        }
+        const ggml_tensor * root = root_of(target.tensor);
+        size_t j = 0;
+        while (j < roots.size() && roots[j] != root) ++j;
+        if (j == roots.size()) roots.push_back(root);
+        slot[i] = j;
+    }
+    offset.resize(roots.size());
+    for (size_t j = 0; j < roots.size(); ++j) {
+        offset[j] = size;
+        copies.push_back({roots[j], 0, ggml_nbytes(roots[j]), size});
+        size += GGML_PAD(ggml_nbytes(roots[j]), 64);
+    }
+    rec.tensors.resize(capture.targets.size());
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        const auto & target = capture.targets[i];
+        skippy_receipt_layout & layout = rec.tensors[i];
+        // a reused record holds an earlier ubatch's layout: all of it is
+        // reset, and the name keeps its memory
+        std::string name = std::move(layout.name);
+        layout = {};
+        layout.name = std::move(name);
+        layout.name.assign(target.name);
+        layout.layer = target.layer;
+        layout.kind = target.kind;
+        layout.index = target.index;
+        layout.flags = target.flags;
+        if (target.rows != nullptr) {
+            layout.stored_rows = true;
+            layout.rows_type = target.rows->type;
+            layout.rows_len = target.rows->ne[0];
+            layout.offset = size;
+            add_row_copies(copies, target.rows, rec.row, size);
+            size += GGML_PAD(ggml_row_size(target.rows->type, target.rows->ne[0]) * n, 64);
+            continue;
+        }
+        const ggml_tensor * t = target.tensor;
+        const int64_t n_cols = columns_of(t, target.axis);
+        // a state has a column per sequence
+        const bool state =
+                target.kind == SKIPPY_RECEIPT_TENSOR_MIXING_STATE || target.kind == SKIPPY_RECEIPT_TENSOR_MIXING_STATE_OUT;
+        if (!state && n_cols != static_cast<int64_t>(n) && n_cols != rec.n_outputs) {
+            return std::string("receipt tensor ") + t->name + " has neither a column per token nor per output";
+        }
+        layout.shape = *t;
+        layout.shape.view_src = nullptr;
+        layout.shape.buffer = nullptr;
+        layout.shape.data = nullptr;
+        layout.base = offset_in_root(t);
+        layout.axis = target.axis;
+        layout.offset = offset[slot[i]];
+    }
+    if (capture.input != nullptr) {
+        rec.has_input = true;
+        rec.input_offset = size;
+        rec.input_row_bytes = static_cast<int64_t>(capture.input->nb[1]);
+        rec.input_type = capture.input->type;
+        copies.push_back({capture.input, 0, ggml_nbytes(capture.input), size});
+        size += ggml_nbytes(capture.input);
+    }
+    rec.unchecked_weights = capture.unchecked_weights;
+    return "";
+}
+
+// The attention ops of the current graph's reported layers, which point
+// into the capture.
+std::vector<skippy_receipt_attention> attention_reports(skippy_receipt_capture & capture) {
+    std::vector<skippy_receipt_attention> reports;
+    if (capture.mode == skippy_receipt_mode::record) {
+        return reports;
+    }
+    for (auto & op : capture.attention) {
+        skippy_receipt_attention report = {};
+        report.layer = op.layer;
+        if (!op.error.empty()) {
+            report.error = op.error.c_str();
+            reports.push_back(report);
+            continue;
+        }
+        report.q_input = op.q_input;
+        report.k_store = op.k_store;
+        report.v_store = op.v_store;
+        report.output = op.output;
+        report.n_head = op.n_head;
+        report.n_head_kv = op.n_head_kv;
+        report.head_dim_k = op.head_dim_k;
+        report.head_dim_v = op.head_dim_v;
+        report.scale = op.scale;
+        report.softcap = op.softcap;
+        report.window_kind = op.window.kind;
+        report.window = op.window.size;
+        report.sinks = op.sinks.empty() ? nullptr : op.sinks.data();
+        report.output_gate = op.output_gate;
+        if (op.output_rotation_input != nullptr) {
+            // set with the graph's inputs, after the ops were described
+            op.output_rotation.resize(static_cast<size_t>(ggml_nelements(op.output_rotation_input)));
+            ggml_backend_tensor_get(op.output_rotation_input, op.output_rotation.data(), 0,
+                    op.output_rotation.size() * sizeof(float));
+        }
+        report.output_rotation_n = op.output_rotation_n;
+        report.output_rotation = op.output_rotation.empty() ? nullptr : op.output_rotation.data();
+        report.q_rounding = op.q_rounding;
+        reports.push_back(report);
+    }
+    return reports;
+}
+
+// `n` f32 values with each negative zero made positive, in `scratch`.
+const void * with_unsigned_zeros(const void * values, size_t n, std::vector<uint8_t> & scratch) {
+    if (values != scratch.data()) {
+        const auto * bytes = static_cast<const uint8_t *>(values);
+        scratch.assign(bytes, bytes + n * 4);
+    }
+    for (size_t k = 0; k < n; ++k) {
+        uint32_t word;
+        std::memcpy(&word, scratch.data() + k * 4, 4);
+        if (word == 0x80000000u) {
+            std::memset(scratch.data() + k * 4, 0, 4);
+        }
+    }
+    return scratch.data();
+}
+
+void deliver(skippy_receipt_capture & capture, const skippy_receipt_recorded & rec) {
+    auto & converted = capture.copies[rec.slot].converted;
+    converted.resize(rec.tensors.size());
+    std::vector<skippy_receipt_tensor> & tensors = capture.readback.tensors;
+    tensors.clear();
+    tensors.reserve(rec.tensors.size());
+    for (size_t i = 0; i < rec.tensors.size(); ++i) {
+        const skippy_receipt_layout & layout = rec.tensors[i];
+        skippy_receipt_tensor tensor = {};
+        tensor.layer = layout.layer;
+        tensor.kind = layout.kind;
+        tensor.index = layout.index;
+        tensor.flags = layout.flags;
+        tensor.name = layout.name.c_str();
+        if (layout.stored_rows) {
+            tensor.ggml_type = layout.rows_type;
+            tensor.len = layout.rows_len;
+            tensor.row_bytes = static_cast<int64_t>(ggml_row_size(layout.rows_type, layout.rows_len));
+            tensor.n_cols = rec.n_tokens;
+            if (layout.digested) {
+                tensor.digests = rec.block + layout.offset;
+            } else {
+                tensor.values = rec.block + layout.offset;
+            }
+        } else {
+            tensor.n_cols = columns_of(&layout.shape, layout.axis);
+            tensor.ggml_type = reported_type(layout.shape.type);
+            tensor.len = column_len(&layout.shape, layout.axis);
+            tensor.row_bytes = tensor.len * 4;
+            if (layout.digested) {
+                tensor.digests = rec.block + layout.offset;
+            } else if (rec.columns_ready && needs_columns(layout)) {
+                tensor.values = converted[i].data();
+            } else {
+                tensor.values = read_columns(rec.block + layout.offset, &layout.shape, layout.base, layout.axis, converted[i]);
+            }
+        }
+        if (tensor.values != nullptr && tensor.ggml_type == GGML_TYPE_F32 && unsigned_zeros(tensor.kind)) {
+            const auto n = static_cast<size_t>(tensor.len * tensor.n_cols);
+            tensor.values = with_unsigned_zeros(tensor.values, n, converted[i]);
+        }
+        tensors.push_back(tensor);
+    }
+    std::vector<const char *> & unchecked = capture.readback.unchecked;
+    unchecked.clear();
+    for (const auto & name : rec.unchecked_weights) {
+        unchecked.push_back(name.c_str());
+    }
+    // a replay or glue report is delivered before the next graph is built
+    const std::vector<skippy_receipt_attention> attention = attention_reports(capture);
+
+    skippy_receipt_ubatch report = {};
+    report.step = rec.step;
+    report.n_tokens = static_cast<int32_t>(rec.n_tokens);
+    report.token = rec.token.data();
+    report.seq = rec.seq.data();
+    report.pos = rec.pos.data();
+    report.output = rec.output.data();
+    report.cell = rec.cell.data();
+    report.n_kv = rec.n_kv;
+    if (rec.has_input) {
+        report.input = rec.block + rec.input_offset;
+        report.input_row_bytes = rec.input_row_bytes;
+        report.input_type = rec.input_type;
+    }
+    report.n_tensors = tensors.size();
+    report.tensors = tensors.data();
+    report.n_unchecked_weights = unchecked.size();
+    report.unchecked_weights = unchecked.data();
+    report.n_attention = attention.size();
+    report.attention = attention.data();
+    capture.on_ubatch(capture.user_data, &report);
+}
+
+ggml_tensor * alias(ggml_context * ctx, ggml_backend_buffer_t buffer, void * data, size_t size) {
+    ggml_tensor * t = ggml_new_tensor_1d(ctx, GGML_TYPE_I8, static_cast<int64_t>(size));
+    t->buffer = buffer;
+    t->data = data;
+    return t;
+}
+
+// The transfer state for copies from `compute`, with its next staging buffer
+// at least `size` bytes and room for `n_aliases` alias headers, or null when
+// the device cannot copy asynchronously or has no memory for the staging
+// buffer. The ubatch that used that staging buffer has been reported.
+skippy_receipt_transfer * ensure_transfer(
+        skippy_receipt_capture & capture, ggml_backend_t compute, size_t size, size_t n_aliases) {
+    auto & transfer = capture.transfer;
+    if (transfer && transfer->compute != compute) {
+        // pending ubatches keep their host blocks, once their copies are done
+        for (skippy_receipt_recorded & rec : capture.pending) {
+            if (rec.staging >= 0) {
+                transfer->wait(rec.ticket);
+                rec.staging = -1;
+            }
+        }
+        transfer.reset();
+    }
+    if (!transfer) {
+        ggml_backend_dev_t dev = ggml_backend_get_device(compute);
+        ggml_backend_dev_props props = {};
+        if (dev != nullptr) {
+            ggml_backend_dev_get_props(dev, &props);
+        }
+        if (dev == nullptr || ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_GPU || !props.caps.async ||
+                !props.caps.events) {
+            capture.transfer_unsupported = true;
+            return nullptr;
+        }
+        std::unique_ptr<skippy_receipt_transfer, skippy_receipt_capture::transfer_deleter> fresh(
+                new skippy_receipt_transfer());
+        fresh->compute = compute;
+        fresh->copier = ggml_backend_dev_init(dev, nullptr);
+        bool events = fresh->copier != nullptr;
+        for (int s = 0; s < skippy_receipt_transfer::STAGING && events; ++s) {
+            fresh->staged[s] = ggml_backend_event_new(dev);
+            events = fresh->staged[s] != nullptr;
+        }
+        if (!events) {
+            capture.transfer_unsupported = true;
+            return nullptr;
+        }
+        fresh->start();
+        transfer = std::move(fresh);
+    }
+    const int s = transfer->next_staging;
+    ggml_backend_buffer_t & staging = transfer->staging[s];
+    if (staging == nullptr || ggml_backend_buffer_get_size(staging) < size) {
+        if (staging != nullptr) {
+            ggml_backend_buffer_free(staging);
+            ggml_free(transfer->whole_ctx[s]);
+            transfer->whole_ctx[s] = nullptr;
+            transfer->whole[s] = nullptr;
+        }
+        staging = ggml_backend_buft_alloc_buffer(ggml_backend_get_default_buffer_type(compute), size + size / 4);
+        if (staging == nullptr) {
+            return nullptr;
+        }
+        ggml_init_params params = {ggml_tensor_overhead(), nullptr, true};
+        transfer->whole_ctx[s] = ggml_init(params);
+        if (transfer->whole_ctx[s] == nullptr) {
+            ggml_backend_buffer_free(staging);
+            staging = nullptr;
+            return nullptr;
+        }
+        transfer->whole[s] = alias(transfer->whole_ctx[s], staging, ggml_backend_buffer_get_base(staging),
+                ggml_backend_buffer_get_size(staging));
+    }
+    if (transfer->aliases == nullptr || transfer->alias_capacity < n_aliases) {
+        if (transfer->aliases != nullptr) {
+            ggml_free(transfer->aliases);
+        }
+        transfer->alias_capacity = n_aliases + n_aliases / 4 + 8;
+        ggml_init_params params = {transfer->alias_capacity * ggml_tensor_overhead(), nullptr, true};
+        transfer->aliases = ggml_init(params);
+        if (transfer->aliases == nullptr) {
+            transfer->alias_capacity = 0;
+            return nullptr;
+        }
+    } else {
+        ggml_reset(transfer->aliases);
+    }
+    return transfer.get();
+}
+
+// The one backend that computed the device values among `copies`, or null when
+// they are spread over several or none is on a device.
+ggml_backend_t compute_backend(ggml_backend_sched_t sched, const std::vector<value_copy> & copies) {
+    ggml_backend_t compute = nullptr;
+    for (const value_copy & c : copies) {
+        ggml_backend_buffer_t buffer = root_of(c.src)->buffer;
+        if (buffer == nullptr || c.src->data == nullptr) {
+            return nullptr;
+        }
+        if (ggml_backend_buffer_is_host(buffer)) {
+            continue;
+        }
+        ggml_backend_t backend = tensor_backend(sched, c.src);
+        if (backend == nullptr || (compute != nullptr && backend != compute)) {
+            return nullptr;
+        }
+        compute = backend;
+    }
+    return compute;
+}
+
+// Starts copying the ubatch's values without waiting for them: device values
+// into a staging buffer, right after the graph on the compute stream, and
+// host values into `rec.block` at once. The copy thread then copies the
+// staging buffer to the block. False, with nothing started, when the values
+// are not all on one asynchronous device.
+bool start_transfer(skippy_receipt_capture & capture, ggml_backend_t compute, skippy_receipt_recorded & rec,
+        std::vector<value_copy> & copies, size_t size) {
+    if (capture.transfer_unsupported || compute == nullptr) {
+        return false;
+    }
+    skippy_receipt_transfer * transfer = ensure_transfer(capture, compute, size, 2 * copies.size() + 1);
+    if (transfer == nullptr) {
+        return false;
+    }
+    const int s = transfer->next_staging;
+    transfer->next_staging = (s + 1) % skippy_receipt_transfer::STAGING;
+    rec.staging = s;
+    ggml_backend_buffer_t staging_buffer = transfer->staging[s];
+    auto * staging = static_cast<uint8_t *>(ggml_backend_buffer_get_base(staging_buffer));
+    std::sort(copies.begin(), copies.end(),
+            [](const value_copy & a, const value_copy & b) { return a.dst_offset < b.dst_offset; });
+    // ranges of the block the host copy fills; a host value splits them
+    std::vector<std::pair<size_t, size_t>> ranges;
+    bool extend = false;
+    for (const value_copy & c : copies) {
+        ggml_backend_buffer_t buffer = root_of(c.src)->buffer;
+        const auto * src = static_cast<const uint8_t *>(c.src->data) + c.src_offset;
+        if (ggml_backend_buffer_is_host(buffer)) {
+            std::memcpy(rec.block + c.dst_offset, src, c.size);
+            extend = false;
+            continue;
+        }
+        // one stream: the copies follow the graph that computes the values
+        ggml_backend_tensor_copy_async(compute, compute, alias(transfer->aliases, buffer, const_cast<uint8_t *>(src), c.size),
+                alias(transfer->aliases, staging_buffer, staging + c.dst_offset, c.size));
+        if (extend) {
+            ranges.back().second = c.dst_offset + c.size;
+        } else {
+            ranges.emplace_back(c.dst_offset, c.dst_offset + c.size);
+        }
+        extend = true;
+    }
+    ggml_backend_event_record(transfer->staged[s], compute);
+    // the copy thread also gathers the columns of values that need it, which
+    // would otherwise take the decoding thread milliseconds per ubatch
+    auto & converted = capture.copies[rec.slot].converted;
+    converted.resize(rec.tensors.size());
+    std::vector<std::pair<size_t, skippy_receipt_layout>> gather;
+    for (size_t i = 0; i < rec.tensors.size(); ++i) {
+        if (needs_columns(rec.tensors[i])) {
+            gather.emplace_back(i, rec.tensors[i]);
+        }
+    }
+    rec.columns_ready = true;
+    rec.ticket = transfer->enqueue(s, rec.block, rec.pinned, std::move(ranges), [block = rec.block, out = &converted, gather = std::move(gather)] {
+        for (const auto & [i, layout] : gather) {
+            read_columns(block + layout.offset, &layout.shape, layout.base, layout.axis, (*out)[i]);
+        }
+    });
+    return true;
+}
+
+// Starts hashing the ubatch's device values on the device that computed them
+// instead of copying them: right after the graph, on the compute stream, the
+// digests go to a staging buffer, followed by the stage input, and the copy
+// thread copies them to the host. Values in host memory, such as the token
+// embeddings or a stage's imported activations, are copied at once. The host
+// block holds the digests from 0, then those values, then the input. False,
+// with nothing started, when the device cannot hash or cannot read a value;
+// the graph's later ubatches then do not ask again.
+bool start_digests(skippy_receipt_capture & capture, ggml_backend_sched_t sched, ggml_backend_t compute,
+        skippy_receipt_recorded & rec, const std::vector<value_copy> & copies) {
+    if (capture.digest_unsupported || capture.digest_refused || capture.transfer_unsupported ||
+            capture.targets.empty() || compute == nullptr) {
+        return false;
+    }
+    skippy_receipt_digest_fn digest = skippy_receipt_digest_proc(compute);
+    if (digest == nullptr) {
+        capture.digest_unsupported = true;
+        return false;
+    }
+    skippy_receipt_digest_plan planned;
+    if (!skippy_receipt_plan_digests(capture, compute, rec.row, planned)) {
+        capture.digest_refused = true;
+        return false;
+    }
+    const size_t digest_bytes = static_cast<size_t>(planned.n_digests) * 32;
+    size_t size = GGML_PAD(digest_bytes, 64);
+    // the roots of the values on the host, each copied once
+    std::vector<std::pair<const ggml_tensor *, size_t>> host_roots;
+    std::vector<size_t> host_offset(capture.targets.size(), 0);
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        if (planned.first[i] != skippy_receipt_digest_plan::ON_HOST) {
+            continue;
+        }
+        const ggml_tensor * root = root_of(capture.targets[i].tensor);
+        size_t j = 0;
+        while (j < host_roots.size() && host_roots[j].first != root) ++j;
+        if (j == host_roots.size()) {
+            host_roots.emplace_back(root, size);
+            size += GGML_PAD(ggml_nbytes(root), 64);
+        }
+        host_offset[i] = host_roots[j].second;
+    }
+    // describe() adds the input's copy last
+    const value_copy * input = rec.has_input ? &copies.back() : nullptr;
+    const size_t input_offset = size;
+    size += input != nullptr ? input->size : 0;
+    skippy_receipt_transfer * transfer = ensure_transfer(capture, compute, size, 3);
+    if (transfer == nullptr) {
+        return false;
+    }
+    const int s = transfer->next_staging;
+    ggml_backend_buffer_t staging_buffer = transfer->staging[s];
+    auto * staging = static_cast<uint8_t *>(ggml_backend_buffer_get_base(staging_buffer));
+    // The device reads the plan from host memory when its stream reaches the
+    // digests, after this call. The plan stays with the staging buffer: the
+    // ubatch that used the buffer before has been reported, so the stream has
+    // run its digests, and this one's plan is kept until the same is true.
+    skippy_receipt_digest_plan & plan = transfer->plans[s];
+    plan = std::move(planned);
+    if (!digest(compute, plan.descs.data(), static_cast<int>(plan.descs.size() / 8), plan.cells.data(),
+                static_cast<int>(plan.cells.size()), plan.bases.data(), staging)) {
+        // the device refused a descriptor, which depends on the graph alone
+        capture.digest_refused = true;
+        return false;
+    }
+    transfer->next_staging = (s + 1) % skippy_receipt_transfer::STAGING;
+    rec.staging = s;
+    std::vector<const ggml_tensor *> sources;
+    for (const value_copy & c : copies) {
+        sources.push_back(c.src);
+    }
+    place_in_host_block(capture, sched, rec, sources, size);
+    for (const auto & [root, offset] : host_roots) {
+        std::memcpy(rec.block + offset, root->data, ggml_nbytes(root));
+    }
+    for (size_t i = 0; i < rec.tensors.size(); ++i) {
+        skippy_receipt_layout & layout = rec.tensors[i];
+        layout.digested = plan.first[i] != skippy_receipt_digest_plan::ON_HOST;
+        layout.offset = layout.digested ? static_cast<size_t>(plan.first[i]) * 32 : host_offset[i];
+    }
+    std::vector<std::pair<size_t, size_t>> ranges;
+    if (digest_bytes > 0) {
+        ranges.emplace_back(0, digest_bytes);
+    }
+    if (input != nullptr) {
+        rec.input_offset = input_offset;
+        ggml_backend_buffer_t buffer = root_of(input->src)->buffer;
+        const auto * src = static_cast<const uint8_t *>(input->src->data) + input->src_offset;
+        if (ggml_backend_buffer_is_host(buffer)) {
+            std::memcpy(rec.block + input_offset, src, input->size);
+        } else {
+            ggml_backend_tensor_copy_async(compute, compute,
+                    alias(transfer->aliases, buffer, const_cast<uint8_t *>(src), input->size),
+                    alias(transfer->aliases, staging_buffer, staging + input_offset, input->size));
+            ranges.emplace_back(input_offset, input_offset + input->size);
+        }
+    }
+    ggml_backend_event_record(transfer->staged[s], compute);
+    // the values copied from the host are few; deliver() reads their columns
+    rec.columns_ready = false;
+    rec.ticket = transfer->enqueue(s, rec.block, rec.pinned, std::move(ranges), nullptr);
+    return true;
+}
+
+// A record for the next ubatch: a reported one when there is one, so its
+// vectors and its tensors' names are not allocated again for every ubatch.
+skippy_receipt_recorded take_record(skippy_receipt_capture & capture) {
+    skippy_receipt_recorded rec;
+    if (!capture.readback.spare.empty()) {
+        rec = std::move(capture.readback.spare.back());
+        capture.readback.spare.pop_back();
+        rec.reuse();
+    }
+    return rec;
+}
+
+// Keeps a reported ubatch's record for take_record(): as many as can be
+// under way at once.
+void keep_record(skippy_receipt_capture & capture, skippy_receipt_recorded && rec) {
+    if (capture.readback.spare.size() <= skippy_receipt_capture::MAX_PENDING) {
+        capture.readback.spare.push_back(std::move(rec));
+    }
+}
+
+// Reports pending ubatches, oldest first, until at most `keep` are left.
+void finish_pending(skippy_receipt_capture & capture, size_t keep) {
+    size_t done = 0;
+    for (; capture.pending.size() - done > keep; ++done) {
+        skippy_receipt_recorded & rec = capture.pending[done];
+        if (capture.transfer && rec.staging >= 0) {
+            capture.transfer->wait(rec.ticket);
+        }
+        deliver(capture, rec);
+        keep_record(capture, std::move(rec));
+    }
+    capture.pending.erase(capture.pending.begin(), capture.pending.begin() + static_cast<std::ptrdiff_t>(done));
+}
+
+}  // namespace
+
+void skippy_receipt_flush(skippy_receipt_capture & capture) {
+    std::lock_guard<std::mutex> lock(capture.delivery);
+    if (capture.on_ubatch == nullptr) {
+        capture.pending.clear();
+        return;
+    }
+    finish_pending(capture, 0);
+}
+
+void skippy_receipt_report_ubatch(
+        skippy_receipt_capture & capture,
+        ggml_backend_sched_t sched,
+        const llama_ubatch & ubatch,
+        llama_memory_context_i * mctx,
+        const llm_graph_result & res) {
+    GGML_UNUSED(res);
+    if (capture.on_ubatch == nullptr || !capture.report) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(capture.delivery);
+    // the oldest copy ran while two ubatches computed; a report that is not
+    // deferred goes after every pending one
+    const bool deferrable = capture.mode == skippy_receipt_mode::record;
+    finish_pending(capture, deferrable ? skippy_receipt_capture::MAX_PENDING - 1 : 0);
+    if (!capture.graph_error.empty()) {
+        finish_pending(capture, 0);
+        report_error(capture, capture.graph_error);
+        return;
+    }
+    if (!capture.compute_error.empty()) {
+        finish_pending(capture, 0);
+        report_error(capture, capture.compute_error);
+        return;
+    }
+    skippy_receipt_recorded rec = take_record(capture);
+    std::vector<value_copy> & copies = capture.readback.copies;
+    const std::vector<const ggml_tensor *> & roots = capture.readback.roots;
+    size_t size = 0;
+    const std::string error = describe(capture, ubatch, mctx, rec, size);
+    if (!error.empty()) {
+        finish_pending(capture, 0);
+        report_error(capture, error);
+        keep_record(capture, std::move(rec));
+        return;
+    }
+    rec.slot = capture.next_copy;
+    capture.next_copy = (capture.next_copy + 1) % skippy_receipt_capture::HOST_COPIES;
+    // found once: hashing and copying ask for the same device
+    ggml_backend_t compute =
+            deferrable && !capture.transfer_unsupported ? compute_backend(sched, copies) : nullptr;
+    if (deferrable && start_digests(capture, sched, compute, rec, copies)) {
+        capture.pending.push_back(std::move(rec));
+        return;
+    }
+    place_in_host_block(capture, sched, rec, roots, size);
+    // values the host can read in place, such as Metal's shared buffers, need
+    // one fence rather than a staging copy for each tensor
+    const bool host_readable = std::all_of(copies.begin(), copies.end(), [](const value_copy & c) {
+        return skippy_receipt_storage_host_readable(root_of(c.src)->buffer);
+    });
+    if (deferrable && !host_readable && start_transfer(capture, compute, rec, copies, size)) {
+        capture.pending.push_back(std::move(rec));
+        return;
+    }
+    finish_pending(capture, 0);
+    const bool read_async = rec.pinned && !host_readable;
+    if (!read_async) {
+        // the blocking copies below must not read values still being computed
+        ggml_backend_sched_synchronize(sched);
+    }
+    for (const value_copy & c : copies) {
+        ggml_backend_t backend = tensor_backend(sched, c.src);
+        auto * src = const_cast<ggml_tensor *>(c.src);
+        read_to_host(backend, src, rec.block + c.dst_offset, c.src_offset, c.size, read_async);
+    }
+    ggml_backend_sched_synchronize(sched);
+    deliver(capture, rec);
+    keep_record(capture, std::move(rec));
+}
diff --git a/src/skippy/receipts_scratch.h b/src/skippy/receipts_scratch.h
new file mode 100644
index 000000000..8293c7348
--- /dev/null
+++ b/src/skippy/receipts_scratch.h
@@ -0,0 +1,48 @@
+#pragma once
+
+// The scratch contexts a model replays receipts and evaluates glue in.
+
+#include "llama.h"
+
+#include <memory>
+#include <mutex>
+
+struct skippy_receipt_capture;
+
+// A context an auditor evaluates opened values in, and the columns its
+// batches hold.
+struct skippy_receipt_eval_context {
+    llama_context * ctx = nullptr;
+    std::shared_ptr<skippy_receipt_capture> capture;
+    uint32_t columns = 0;
+
+    void release() {
+        llama_free(ctx);
+        ctx = nullptr;
+        capture.reset();
+        columns = 0;
+    }
+};
+
+// Each llama context is created on first use and freed when the scratch is
+// released.
+struct skippy_receipt_scratch {
+    std::mutex mutex;
+    llama_context * ctx = nullptr;
+    std::shared_ptr<skippy_receipt_capture> capture;
+    // KV cells the replay context holds
+    uint32_t cells = 0;
+    // the sequence whose cells skippy_model_seed_receipt_replay copied in for
+    // the next replay, or -1
+    llama_seq_id seeded = -1;
+    // every column its own sequence: glue and entry evaluations
+    skippy_receipt_eval_context glue;
+    // one sequence of consecutive columns: region evaluations
+    skippy_receipt_eval_context region;
+
+    ~skippy_receipt_scratch() {
+        llama_free(ctx);
+        glue.release();
+        region.release();
+    }
+};
