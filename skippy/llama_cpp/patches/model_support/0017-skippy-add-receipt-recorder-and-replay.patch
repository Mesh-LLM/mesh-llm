diff --git a/tests/skippy-receipt-storage.h b/tests/skippy-receipt-storage.h
new file mode 100644
index 000000000..0ba005299
--- /dev/null
+++ b/tests/skippy-receipt-storage.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include "../src/skippy/receipts_storage.h"
+#include "../ggml/src/ggml-backend-impl.h"
+
+#include <cstring>
+
+namespace receipt_storage_tests {
+
+inline bool readable(ggml_backend_buffer_t buffer) {
+    return buffer->context != nullptr;
+}
+
+inline void * lookup(ggml_backend_reg_t, const char * name) {
+    return std::strcmp(name, "ggml_backend_buffer_is_host_readable") == 0
+            ? reinterpret_cast<void *>(readable) : nullptr;
+}
+
+inline void run(void (*check)(bool, const char *)) {
+    check(!skippy_receipt_storage_host_readable(nullptr), "missing storage is not readable");
+    auto host = ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), 64);
+    check(host != nullptr && skippy_receipt_storage_host_readable(host), "CPU storage is readable");
+    ggml_backend_buffer_free(host);
+
+    ggml_backend_reg reg = {};
+    ggml_backend_device dev = {};
+    ggml_backend_buffer_type buft = {};
+    ggml_backend_buffer buffer = {};
+    buffer.buft = &buft;
+    check(!skippy_receipt_storage_host_readable(&buffer), "missing device fails closed");
+    buft.device = &dev;
+    check(!skippy_receipt_storage_host_readable(&buffer), "missing registry fails closed");
+    dev.reg = &reg;
+    check(!skippy_receipt_storage_host_readable(&buffer), "absent capability retains staging");
+    reg.iface.get_proc_address = lookup;
+    check(!skippy_receipt_storage_host_readable(&buffer), "private storage retains staging");
+    buffer.context = &buffer;
+    check(skippy_receipt_storage_host_readable(&buffer), "shared storage permits direct readback");
+    buffer.context = nullptr;
+    check(!skippy_receipt_storage_host_readable(&buffer), "storage decisions are not cached across batches");
+}
+
+} // namespace receipt_storage_tests
