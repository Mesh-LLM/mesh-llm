                 0,
                 desc,
@@ -280,6 +302,10 @@ int main() {
         fprintf(stderr, "K-only KV page import failed: %s\n", error.c_str());
         return 1;
     }
+    if (receipt_imports() != 1) {
+        fprintf(stderr, "a KV page import did not report its cells to the receipt recorder\n");
+        return 1;
+    }
 
     uint8_t empty_payload = 0;
     skippy_kv_page_desc invalid_range_desc = desc;
@@ -296,6 +322,10 @@ int main() {
         fprintf(stderr, "out-of-bounds KV page layer range was accepted\n");
         return 1;
     }
+    if (receipt_imports() != 1) {
+        fprintf(stderr, "a refused KV page import reported cells as written\n");
+        return 1;
+    }
     if (restore_kv.seq_pos_min(0) != 0) {
         fprintf(stderr, "out-of-bounds KV page import mutated the existing page\n");
         return 1;
@@ -421,5 +451,42 @@ int main() {
         return 1;
     }
 
+    // Receipt pins: a ubatch leaves pinned empty cells alone while it fits in
+    // the others, and takes the first cells it can use, pinned or not, when
+    // it does not.
+    llama_kv_cache pin_kv(*model, false, hparams, GGML_TYPE_F32, GGML_TYPE_F32, true, false, true, 4, 1, 0,
+            LLAMA_SWA_TYPE_NONE, nullptr, [](int32_t il) { return il == 0; }, {}, {});
+    llama_pos pin_pos[3] = {0, 1, 2};
+    llama_seq_id pin_seq = 0;
+    llama_seq_id * pin_seq_ids[3] = {&pin_seq, &pin_seq, &pin_seq};
+    int32_t pin_n_seq_id[3] = {1, 1, 1};
+    llama_ubatch pin_batch = {};
+    pin_batch.n_pos = 1;
+    pin_batch.n_seqs_unq = 1;
+    pin_batch.pos = pin_pos;
+    pin_batch.n_seq_id = pin_n_seq_id;
+    pin_batch.seq_id = pin_seq_ids;
+    pin_batch.seq_id_unq = &pin_seq;
+    const auto placed = [&](uint32_t n_tokens) {
+        pin_batch.n_tokens = n_tokens;
+        const auto found = pin_kv.find_slot(pin_batch, false);
+        return found.empty() ? std::vector<uint32_t>() : found.idxs[0];
+    };
+    pin_kv.receipt_pin({true, true, false, false});
+    if (placed(2) != std::vector<uint32_t>{2, 3} || placed(3) != std::vector<uint32_t>{0, 1, 2}) {
+        fprintf(stderr, "a ubatch was not placed around the pinned KV cells, or not in them when it had to be\n");
+        return 1;
+    }
+    pin_kv.receipt_pin({true, true, true, true});
+    if (placed(2) != std::vector<uint32_t>{0, 1}) {
+        fprintf(stderr, "a ubatch did not fall back to pinned KV cells when every empty cell was pinned\n");
+        return 1;
+    }
+    pin_kv.receipt_pin({});
+    if (placed(2) != std::vector<uint32_t>{0, 1} || !placed(5).empty()) {
+        fprintf(stderr, "a ubatch was not placed as without pins after the pins were removed\n");
+        return 1;
+    }
+
     return 0;
 }
diff --git a/tests/test-skippy-receipt-classify.cpp b/tests/test-skippy-receipt-classify.cpp
new file mode 100644
index 000000000..a8c9eb5aa
--- /dev/null
+++ b/tests/test-skippy-receipt-classify.cpp
@@ -0,0 +1,532 @@
+// Receipt layer classification on small synthetic graphs: what is a weight
+// matmul, what mixes tokens, what is glue, and which graphs are refused.
+
+#include "../src/skippy/receipts_layers.h"
+#include "skippy-receipt-storage.h"
+
+#include "ggml.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <unordered_set>
+
+namespace {
+
+constexpr int64_t N_EMBD = 64;
+constexpr int64_t HEAD = 16;
+constexpr int64_t N_HEAD = 4;
+constexpr int64_t N_FF = 128;
+constexpr int64_t N_KV = 32;
+constexpr int64_t N_EXPERT = 8;
+constexpr int64_t N_USED = 2;
+
+int failures = 0;
+
+void check(bool ok, const char * what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+struct graph_builder {
+    ggml_context * ctx = nullptr;
+    ggml_cgraph * gf = nullptr;
+    std::unordered_set<const ggml_tensor *> weights;
+    skippy_receipt_graph_facts facts;
+    int64_t n_tokens;
+
+    explicit graph_builder(int64_t n) : n_tokens(n) {
+        ggml_init_params params = {64 * 1024 * 1024, nullptr, true};
+        ctx = ggml_init(params);
+        gf = ggml_new_graph_custom(ctx, 4096, false);
+        facts.n_tokens = n;
+        facts.is_weight = [this](const ggml_tensor * t) { return weights.count(t) != 0; };
+    }
+
+    ~graph_builder() { ggml_free(ctx); }
+
+    ggml_tensor * weight(int64_t a, int64_t b, int64_t c = 1, ggml_type type = GGML_TYPE_F32) {
+        ggml_tensor * w = ggml_new_tensor_3d(ctx, type, a, b, c);
+        weights.insert(w);
+        return w;
+    }
+
+    ggml_tensor * input(ggml_type type, int64_t a, int64_t b = 1, int64_t c = 1) {
+        ggml_tensor * t = ggml_new_tensor_3d(ctx, type, a, b, c);
+        ggml_set_input(t);
+        return t;
+    }
+
+    ggml_tensor * state(int64_t row, int64_t rows) {
+        ggml_tensor * t = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, row, rows);
+        facts.state_storage.insert(t);
+        return t;
+    }
+
+    // a recurrent cache: one f32 state per row
+    ggml_tensor * recurrent_state(int64_t row, int64_t rows) {
+        ggml_tensor * t = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, row, rows);
+        facts.state_storage.insert(t);
+        facts.recurrent_storage.insert(t);
+        return t;
+    }
+};
+
+// A short convolution keeps the last values of every channel between
+// ubatches: CONV_KEEP values, in the cell CONV_CELL of a memory of
+// CONV_CELLS cells that holds CONV_SNAPSHOTS states per cell, the most
+// recent and rollback snapshots of the ones before it.
+constexpr int64_t CONV_KEEP = 2;
+constexpr int64_t CONV_SNAPSHOTS = 3;
+constexpr int64_t CONV_CELLS = 2;
+constexpr int64_t CONV_CELL = 1;
+
+enum class state_write { none, cpy, set_rows, set_rows_uncommitted_order };
+enum class rotation { none, constant, weight };
+
+// llama.cpp rotates a value in chunks of n values: it flattens the value to
+// rows of n and multiplies them by a square matrix (llama_mul_mat_hadamard).
+ggml_tensor * rotate(ggml_context * ctx, ggml_tensor * cur, ggml_tensor * rot) {
+    const int64_t n = rot->ne[0];
+    const int64_t n_rows = ggml_nelements(cur) / n;
+    ggml_tensor * rows = ggml_is_contiguous(cur) ? ggml_reshape_2d(ctx, cur, n, n_rows) : ggml_cont_2d(ctx, cur, n, n_rows);
+    return ggml_reshape_4d(ctx, ggml_mul_mat(ctx, rot, rows), cur->ne[0], cur->ne[1], cur->ne[2], cur->ne[3]);
+}
+
+struct layer_options {
+    bool moe = false;
+    bool transposed_v = false;
+    bool sinks = false;
+    bool big_mixing_weight = false;
+    bool cross_layer = false;
+    bool unknown_op = false;
+    bool boundary_past_stage = false;
+    // the attention mask is an input nothing names
+    bool unnamed_mask = false;
+    // a token-mixing op reads a value from outside the layer
+    bool mixing_reads_other_layer = false;
+    // a value from outside the layer joins a token-mixing region
+    bool region_reads_other_layer = false;
+    // a weight matmul of a value from outside the layer
+    bool matmul_of_other_layer = false;
+    // cache and state writes of values the client cannot compute
+    bool stores_mixing_output = false;
+    // the same write into a recurrent cache: a region writing its state back
+    bool recurrent_rows_write = false;
+    bool stores_other_layer = false;
+    bool state_write_of_other_layer = false;
+    // a large weight applied to the cache rows before attention reads them
+    bool big_state_weight = false;
+    // a short convolution before attention, which reads a recurrent state
+    // and writes it back
+    state_write conv = state_write::none;
+    // q, k, v and the attention output are rotated, as for a quantized KV
+    // cache: by a constant of the context, or by a matrix known only as a
+    // tensor in a weights buffer
+    rotation rotated = rotation::none;
+    // the FFN runs only for this many output rows, as in a final layer
+    int64_t output_rows = -1;
+};
+
+// One pre-norm layer: attention over a KV cache, then a SwiGLU or MoE FFN.
+std::string build_layer(graph_builder & g, const layer_options & options, skippy_receipt_layer_plan & plan) {
+    ggml_context * ctx = g.ctx;
+    const int64_t n = g.n_tokens;
+    ggml_tensor * import = g.input(GGML_TYPE_F32, N_EMBD, n);
+    ggml_tensor * outer = ggml_scale(ctx, import, 2.0f);
+    ggml_build_forward_expand(g.gf, outer);
+    ggml_tensor * entry = ggml_scale(ctx, import, 1.0f);
+    ggml_build_forward_expand(g.gf, entry);
+
+    ggml_tensor * pos = g.input(GGML_TYPE_I32, n);
+    g.facts.client_inputs.insert(pos);
+    ggml_tensor * cells = g.input(GGML_TYPE_I64, n);
+    g.facts.cell_indices.insert(cells);
+    ggml_tensor * mask = g.input(GGML_TYPE_F16, N_KV, n);
+    if (!options.unnamed_mask) {
+        g.facts.state_selectors.insert(mask);
+    }
+
+    ggml_tensor * cur = ggml_mul(ctx, ggml_rms_norm(ctx, entry, 1e-6f), g.weight(N_EMBD, 1));
+    if (options.cross_layer) {
+        cur = ggml_add(ctx, cur, outer);
+    }
+    if (options.unknown_op) {
+        cur = ggml_pool_1d(ctx, cur, GGML_OP_POOL_AVG, 1, 1, 0);
+    }
+    if (options.mixing_reads_other_layer) {
+        // CONCAT may read other tokens, so it would start a region here
+        ggml_tensor * both = ggml_concat(ctx, cur, outer, 0);
+        cur = ggml_view_2d(ctx, both, N_EMBD, n, both->nb[1], 0);
+    }
+    if (options.matmul_of_other_layer) {
+        cur = ggml_add(ctx, cur, ggml_mul_mat(ctx, g.weight(N_EMBD, N_EMBD), outer));
+    }
+    if (options.conv != state_write::none) {
+        ggml_tensor * storage = g.recurrent_state(CONV_KEEP * N_EMBD, CONV_CELLS * CONV_SNAPSHOTS);
+        const size_t element = ggml_element_size(storage);
+        const size_t row = storage->nb[1];
+        ggml_tensor * state = ggml_view_2d(ctx, storage, CONV_KEEP * N_EMBD, 1, row, CONV_CELL * row);
+        ggml_tensor * x = ggml_reshape_3d(ctx, ggml_cont(ctx, ggml_transpose(ctx, cur)), n, N_EMBD, 1);
+        ggml_tensor * conv_x = ggml_concat(ctx, ggml_reshape_3d(ctx, state, CONV_KEEP, N_EMBD, 1), x, 0);
+        if (options.conv == state_write::cpy) {
+            ggml_tensor * last = ggml_view_3d(ctx, conv_x, CONV_KEEP, N_EMBD, 1, conv_x->nb[1], conv_x->nb[2], n * element);
+            ggml_build_forward_expand(g.gf, ggml_cpy(ctx, last, ggml_view_2d(ctx, storage, CONV_KEEP * N_EMBD, 1, row, CONV_CELL * row)));
+        } else {
+            // the last windows of the ubatch, oldest first, written into the
+            // snapshot slots in the order an index tensor gives
+            const int64_t n_written = n < CONV_SNAPSHOTS ? n : CONV_SNAPSHOTS;
+            ggml_tensor * windows = ggml_view_4d(ctx, conv_x, CONV_KEEP, n_written, N_EMBD, 1,
+                    element, conv_x->nb[1], conv_x->nb[2], (n - (n_written - 1)) * element);
+            ggml_tensor * slots = ggml_view_4d(ctx, storage, CONV_KEEP, CONV_SNAPSHOTS, N_EMBD, 1,
+                    CONV_CELLS * row, CONV_KEEP * element, row, CONV_CELL * row);
+            ggml_tensor * order = options.conv == state_write::set_rows_uncommitted_order
+                    ? g.input(GGML_TYPE_I32, n_written)
+                    : ggml_cast(ctx, ggml_arange(ctx, 0.0f, static_cast<float>(n_written), 1.0f), GGML_TYPE_I32);
+            ggml_build_forward_expand(g.gf, ggml_set_rows(ctx, slots, windows, order));
+        }
+        ggml_tensor * conv = ggml_ssm_conv(ctx, conv_x, g.weight(CONV_KEEP + 1, N_EMBD));
+        // the product with a per-token value of its shape tells the tokens' axis
+        ggml_tensor * mixed = ggml_mul(ctx, ggml_reshape_2d(ctx, conv, N_EMBD, n), cur);
+        cur = ggml_add(ctx, cur, ggml_mul_mat(ctx, g.weight(N_EMBD, N_EMBD), mixed));
+    }
+    ggml_tensor * q = ggml_mul_mat(ctx, g.weight(N_EMBD, N_EMBD), cur);
+    ggml_tensor * k = ggml_mul_mat(ctx, g.weight(N_EMBD, HEAD * N_HEAD), cur);
+    ggml_tensor * v = ggml_mul_mat(ctx, g.weight(N_EMBD, HEAD * N_HEAD), cur);
+    q = ggml_rope(ctx, ggml_reshape_3d(ctx, q, HEAD, N_HEAD, n), pos, HEAD, 0);
+    k = ggml_rope(ctx, ggml_reshape_3d(ctx, k, HEAD, N_HEAD, n), pos, HEAD, 0);
+    ggml_tensor * rot = nullptr;
+    if (options.rotated != rotation::none) {
+        // the cache fills it once, in a buffer marked as weights
+        rot = g.weight(HEAD, HEAD);
+        if (options.rotated == rotation::constant) {
+            g.facts.constant_inputs.insert(rot);
+        }
+        q = rotate(ctx, q, rot);
+        k = rotate(ctx, k, rot);
+        v = rotate(ctx, v, rot);
+    }
+
+    ggml_tensor * k_cache = g.state(HEAD * N_HEAD, N_KV);
+    ggml_tensor * v_cache = options.transposed_v ? g.state(1, HEAD * N_HEAD * N_KV) : g.state(HEAD * N_HEAD, N_KV);
+    ggml_build_forward_expand(g.gf, ggml_set_rows(ctx, k_cache, ggml_view_2d(ctx, k, HEAD * N_HEAD, n, k->nb[2], 0), cells));
+    if (options.transposed_v) {
+        // one index per element, as llama.cpp writes a transposed V cache
+        ggml_tensor * element_cells = g.input(GGML_TYPE_I64, ggml_nelements(v));
+        g.facts.cell_indices.insert(element_cells);
+        ggml_build_forward_expand(g.gf, ggml_set_rows(ctx, v_cache, ggml_reshape_2d(ctx, v, 1, ggml_nelements(v)), element_cells));
+    } else {
+        ggml_build_forward_expand(g.gf, ggml_set_rows(ctx, v_cache, v, cells));
+    }
+    if (options.stores_other_layer) {
+        ggml_build_forward_expand(g.gf, ggml_set_rows(ctx, g.state(N_EMBD, N_KV), outer, cells));
+    }
+    if (options.state_write_of_other_layer) {
+        ggml_build_forward_expand(g.gf, ggml_cpy(ctx, outer, g.state(N_EMBD, n)));
+    }
+    ggml_tensor * k_view = ggml_view_3d(ctx, k_cache, HEAD, N_HEAD, N_KV, HEAD * 2, HEAD * N_HEAD * 2, 0);
+    if (options.big_state_weight) {
+        // no token-mixing node reads the weight, only the cache rows it scaled
+        k_view = ggml_mul(ctx, k_view, g.weight(HEAD, N_HEAD, N_KV));
+    }
+    ggml_tensor * v_view = ggml_view_3d(ctx, options.transposed_v ? g.state(HEAD * N_HEAD, N_KV) : v_cache, HEAD,
+            N_HEAD, N_KV, HEAD * 2, HEAD * N_HEAD * 2, 0);
+    ggml_tensor * attn = ggml_flash_attn_ext(ctx, ggml_permute(ctx, q, 0, 2, 1, 3), ggml_permute(ctx, k_view, 0, 2, 1, 3),
+            ggml_permute(ctx, v_view, 0, 2, 1, 3), mask, 0.25f, 0.0f, 0.0f);
+    if (options.sinks) {
+        ggml_flash_attn_ext_add_sinks(attn, g.weight(N_HEAD, 1));
+    }
+    if (rot != nullptr) {
+        attn = rotate(ctx, attn, rot);
+    }
+    if (options.big_mixing_weight) {
+        // a value computed from a large weight, applied inside the region
+        ggml_tensor * scale = ggml_sum_rows(ctx, g.weight(4 * N_FF, HEAD * N_HEAD));
+        attn = ggml_mul(ctx, attn, ggml_reshape_2d(ctx, scale, HEAD, N_HEAD));
+    }
+    if (options.region_reads_other_layer) {
+        attn = ggml_mul(ctx, attn, ggml_reshape_3d(ctx, outer, HEAD, N_HEAD, n));
+    }
+    if (options.stores_mixing_output || options.recurrent_rows_write) {
+        ggml_tensor * rows = g.state(N_EMBD, N_KV);
+        if (options.recurrent_rows_write) {
+            g.facts.recurrent_storage.insert(rows);
+        }
+        ggml_build_forward_expand(g.gf, ggml_set_rows(ctx, rows, ggml_reshape_2d(ctx, attn, N_EMBD, n), cells));
+    }
+    cur = ggml_mul_mat(ctx, g.weight(N_EMBD, N_EMBD), ggml_reshape_2d(ctx, attn, N_EMBD, n));
+    ggml_tensor * mid = ggml_add(ctx, entry, cur);
+    if (options.output_rows >= 0) {
+        ggml_tensor * out_ids = g.input(GGML_TYPE_I32, options.output_rows);
+        g.facts.output_indices.insert(out_ids);
+        mid = ggml_get_rows(ctx, mid, out_ids);
+    }
+    const int64_t rows = mid->ne[1];
+
+    cur = ggml_mul(ctx, ggml_rms_norm(ctx, mid, 1e-6f), g.weight(N_EMBD, 1));
+    if (options.moe) {
+        ggml_tensor * logits = ggml_mul_mat(ctx, g.weight(N_EMBD, N_EXPERT), cur);
+        ggml_tensor * probs = ggml_soft_max(ctx, logits);
+        ggml_tensor * selected = ggml_top_k(ctx, probs, N_USED);
+        ggml_tensor * weights = ggml_get_rows(ctx, ggml_reshape_3d(ctx, probs, 1, N_EXPERT, rows), selected);
+        ggml_tensor * x = ggml_reshape_3d(ctx, cur, N_EMBD, 1, rows);
+        ggml_tensor * gate = ggml_mul_mat_id(ctx, g.weight(N_EMBD, N_FF, N_EXPERT), x, selected);
+        ggml_tensor * up = ggml_mul_mat_id(ctx, g.weight(N_EMBD, N_FF, N_EXPERT), x, selected);
+        ggml_tensor * experts = ggml_mul_mat_id(ctx, g.weight(N_FF, N_EMBD, N_EXPERT), ggml_swiglu_split(ctx, gate, up), selected);
+        experts = ggml_mul(ctx, experts, weights);
+        cur = ggml_add(ctx, ggml_view_2d(ctx, experts, N_EMBD, rows, experts->nb[2], 0),
+                ggml_view_2d(ctx, experts, N_EMBD, rows, experts->nb[2], experts->nb[1]));
+    } else {
+        ggml_tensor * gate = ggml_mul_mat(ctx, g.weight(N_EMBD, N_FF), cur);
+        ggml_tensor * up = ggml_mul_mat(ctx, g.weight(N_EMBD, N_FF), cur);
+        cur = ggml_mul_mat(ctx, g.weight(N_FF, N_EMBD), ggml_swiglu_split(ctx, gate, up));
+    }
+    ggml_tensor * exit = ggml_add(ctx, mid, cur);
+    ggml_build_forward_expand(g.gf, exit);
+
+    g.facts.layers.push_back({0, entry, exit});
+    if (options.boundary_past_stage) {
+        // a stage that ends here still registers the next layer's boundary,
+        // whose exit it never computes
+        g.facts.layers.push_back({1, exit, ggml_scale(ctx, exit, 1.0f)});
+    }
+    std::vector<skippy_receipt_layer_plan> plans;
+    std::string error = skippy_receipt_classify(g.gf, g.facts, plans);
+    if (error.empty()) {
+        check(plans.size() == 1, "only the computed layer is planned");
+        plan = plans.at(0);
+    }
+    return error;
+}
+
+void dense_attention_layer(int64_t n) {
+    graph_builder g(n);
+    skippy_receipt_layer_plan plan;
+    const std::string error = build_layer(g, {}, plan);
+    check(error.empty(), ("dense layer classifies: " + error).c_str());
+    if (!error.empty()) {
+        return;
+    }
+    check(plan.matmuls.size() == 7, "seven weight matmuls");
+    check(plan.mixing_inputs.size() == 1, "q enters the attention region");
+    check(plan.mixing_inputs[0].tensor->op == GGML_OP_PERMUTE, "the attention input is q as attention reads it");
+    check(plan.stores.size() == 2, "k and v are committed as stored");
+    check(plan.mixing_outputs.size() == 1 && plan.mixing_outputs[0].tensor->op == GGML_OP_FLASH_ATTN_EXT,
+            "the attention output is the flash attention node");
+    check(plan.selections.empty(), "a dense layer selects nothing");
+    check(plan.unchecked_weights.empty(), "no weight hides in attention");
+    for (const auto & m : plan.matmuls) {
+        check(!m.router, "a dense layer has no router");
+        check(skippy_receipt_columns(m.input) == n, "matmul inputs have a column per token");
+    }
+    check(skippy_receipt_columns(plan.mixing_outputs[0]) == n, "the attention output has a column per token");
+    check(skippy_receipt_columns(plan.exit) == n, "the exit has a column per token");
+}
+
+void moe_layer(int64_t n) {
+    graph_builder g(n);
+    skippy_receipt_layer_plan plan;
+    layer_options options;
+    options.moe = true;
+    const std::string error = build_layer(g, options, plan);
+    check(error.empty(), ("MoE layer classifies: " + error).c_str());
+    if (!error.empty()) {
+        return;
+    }
+    check(plan.matmuls.size() == 8, "attention, router and three expert matmuls");
+    int routers = 0;
+    int experts = 0;
+    for (const auto & m : plan.matmuls) {
+        routers += m.router;
+        experts += m.ids.tensor != nullptr;
+    }
+    check(routers == 1, "exactly the router feeds the selection");
+    check(experts == 3, "three expert matmuls name their experts");
+    check(plan.selections.size() == 1 && plan.selections[0].node->op == GGML_OP_TOP_K, "the top-k is a selection");
+}
+
+void attention_sinks_are_unchecked(int64_t n) {
+    graph_builder g(n);
+    skippy_receipt_layer_plan plan;
+    layer_options options;
+    options.sinks = true;
+    const std::string error = build_layer(g, options, plan);
+    check(error.empty(), ("sinks classify: " + error).c_str());
+    check(plan.unchecked_weights.size() == 1, "the sinks are listed as unchecked");
+}
+
+// A region that reads a recurrent state and writes it back, with a copy or
+// with rows in an order an index gives: the state it leaves is the most
+// recent one in the storage, one column per sequence.
+void recurrent_state_is_followed(int64_t n) {
+    for (const state_write write : {state_write::cpy, state_write::set_rows}) {
+        graph_builder g(n);
+        skippy_receipt_layer_plan plan;
+        layer_options options;
+        options.conv = write;
+        const std::string error = build_layer(g, options, plan);
+        const std::string how = write == state_write::cpy ? "a copy" : "rows";
+        check(error.empty(), ("a region writing its recurrent state back with " + how + " classifies: " + error).c_str());
+        if (!error.empty()) {
+            continue;
+        }
+        check(plan.stores.size() == 2, "a recurrent state write is no stored KV row");
+        check(plan.mixing_outputs.size() == 2, "the convolution and the attention leave their regions");
+        check(plan.states.size() == 1, "the region reads one state");
+        if (plan.states.size() != 1) {
+            continue;
+        }
+        const skippy_receipt_state & state = plan.states[0];
+        check(skippy_receipt_columns(state.read) == 1, "the state read has a column per sequence");
+        check(state.write != nullptr && state.write->op == (write == state_write::cpy ? GGML_OP_CPY : GGML_OP_SET_ROWS),
+                "the state's write is the node that stores it");
+        const size_t row = state.storage->nb[1];
+        int64_t left = 1;
+        for (const int64_t ne : state.left.ne) {
+            left *= ne;
+        }
+        check(state.left.axis == SKIPPY_RECEIPT_AXIS_SINGLE, "the state left has one column for one sequence");
+        check(state.left.offset == CONV_CELL * row, "the state left is the first snapshot of the sequence's cell");
+        check(left == CONV_KEEP * N_EMBD, "the state left is one state, without the rollback snapshots");
+    }
+}
+
+// A quantized KV cache rotates q, k, v and the attention output by a matrix
+// the cache keeps. The products are glue and a token-mixing step, not weight
+// matmuls, although the matrix sits in a weights buffer.
+void rotated_cache_layer(int64_t n) {
+    graph_builder g(n);
+    skippy_receipt_layer_plan plan;
+    layer_options options;
+    options.rotated = rotation::constant;
+    const std::string error = build_layer(g, options, plan);
+    check(error.empty(), ("a layer with a rotated KV cache classifies: " + error).c_str());
+    if (!error.empty()) {
+        return;
+    }
+    check(plan.matmuls.size() == 7, "a rotation is no weight matmul");
+    check(plan.mixing_inputs.size() == 1, "the rotated q enters the attention region");
+    check(plan.stores.size() == 2, "the rotated k and v are committed as stored");
+    check(plan.mixing_outputs.size() == 1, "the rotated attention output leaves the region");
+    check(plan.unchecked_weights.empty(), "a rotation is no unchecked weight");
+    check(skippy_receipt_columns(plan.mixing_inputs[0]) == n, "the rotated q has a column per token");
+    check(skippy_receipt_columns(plan.mixing_outputs[0]) == n, "the rotated output has a column per token");
+    for (const auto & store : plan.stores) {
+        check(skippy_receipt_columns(store.source) == n, "a rotated stored row has a column per token");
+    }
+}
+
+// The same matrix, known only as a tensor in a weights buffer, makes each
+// product a weight matmul of rows that no longer follow the tokens.
+void rotation_by_a_weight_is_no_glue() {
+    graph_builder g(5);
+    skippy_receipt_layer_plan plan;
+    layer_options options;
+    options.rotated = rotation::weight;
+    const std::string error = build_layer(g, options, plan);
+    check(error.find("cannot follow tokens into weight matmul") != std::string::npos,
+            ("a rotation by a matrix that is no constant of the context is refused: got \"" + error + "\"").c_str());
+}
+
+void boundary_past_the_stage_is_skipped(int64_t n) {
+    graph_builder g(n);
+    skippy_receipt_layer_plan plan;
+    layer_options options;
+    options.boundary_past_stage = true;
+    const std::string error = build_layer(g, options, plan);
+    check(error.empty(), ("a boundary past the stage is skipped: " + error).c_str());
+}
+
+void final_layer_output_rows(int64_t n) {
+    for (const bool moe : {false, true}) {
+        for (const int64_t rows : {int64_t(0), int64_t(1)}) {
+            graph_builder g(n);
+            skippy_receipt_layer_plan plan;
+            layer_options options;
+            options.moe = moe;
+            options.output_rows = rows;
+            const std::string error = build_layer(g, options, plan);
+            const std::string what = std::string(moe ? "MoE" : "dense") + " final layer with " +
+                    std::to_string(rows) + " output rows classifies: " + error;
+            check(error.empty(), what.c_str());
+            if (error.empty()) {
+                check(skippy_receipt_columns(plan.exit) == rows, "the exit has a column per output row");
+            }
+        }
+    }
+}
+
+void refused(const layer_options & options, const char * expected, const char * what) {
+    for (const int64_t n : {1, 5}) {
+        graph_builder g(n);
+        skippy_receipt_layer_plan plan;
+        const std::string error = build_layer(g, options, plan);
+        check(error.find(expected) != std::string::npos, (std::string(what) + ": got \"" + error + "\"").c_str());
+    }
+}
+
+}  // namespace
+
+int main() {
+    receipt_storage_tests::run(check);
+    for (const int64_t n : {1, 2, 7}) {
+        dense_attention_layer(n);
+        moe_layer(n);
+        attention_sinks_are_unchecked(n);
+        boundary_past_the_stage_is_skipped(n);
+        recurrent_state_is_followed(n);
+        rotated_cache_layer(n);
+        final_layer_output_rows(n);
+    }
+    layer_options options;
+    options.transposed_v = true;
+    refused(options, "transposed", "a transposed V cache is refused");
+    options = {};
+    options.cross_layer = true;
+    refused(options, "nothing commits", "glue reading a value from outside the layer is refused");
+    options = {};
+    options.unknown_op = true;
+    refused(options, "not in the receipt op table", "an op outside the table is refused");
+    options = {};
+    options.big_mixing_weight = true;
+    refused(options, "unchecked", "a large weight inside a token-mixing op is refused");
+    options = {};
+    options.big_state_weight = true;
+    refused(options, "unchecked", "a large weight applied to state a token-mixing op reads is refused");
+    options = {};
+    options.unnamed_mask = true;
+    refused(options, "neither persistent state", "a token-mixing op reading an input nothing names is refused");
+    options = {};
+    options.mixing_reads_other_layer = true;
+    refused(options, "neither persistent state", "an op that may mix tokens reading another layer's value is refused");
+    options = {};
+    options.region_reads_other_layer = true;
+    refused(options, "neither persistent state", "a token-mixing region reading another layer's value is refused");
+    options = {};
+    options.matmul_of_other_layer = true;
+    refused(options, "which nothing commits", "a weight matmul of another layer's value is refused");
+    options = {};
+    options.stores_mixing_output = true;
+    refused(options, "computed inside a token-mixing region", "a cache write of a token-mixing output is refused");
+    options = {};
+    options.recurrent_rows_write = true;
+    refused(options, "writes a state its region did not read", "a recurrent state written but not read is refused");
+    options = {};
+    options.conv = state_write::set_rows_uncommitted_order;
+    refused(options, "orders its rows by", "a state write in an order nothing commits is refused");
+    rotation_by_a_weight_is_no_glue();
+    options = {};
+    options.stores_other_layer = true;
+    refused(options, "which nothing commits", "a cache write of another layer's value is refused");
+    options = {};
+    options.state_write_of_other_layer = true;
+    refused(options, "state write", "a state write of another layer's value is refused");
+    if (failures != 0) {
+        std::fprintf(stderr, "%d failures\n", failures);
+        return 1;
+    }
+    std::printf("ok\n");
+    return 0;
+}
