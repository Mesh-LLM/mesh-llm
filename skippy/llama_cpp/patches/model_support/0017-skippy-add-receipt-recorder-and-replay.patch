+bool llama_kv_cache::receipt_seed_from(const llama_kv_cache & src, llama_seq_id seq, const std::vector<uint32_t> & cells,
+        const std::vector<llama_pos> & pos, std::string & err) {
+    if (n_stream != src.n_stream || seq < 0 || (size_t) seq >= seq_to_stream.size() || cells.size() != pos.size()) {
+        err = "seeding needs caches of the same streams, a sequence of theirs and a position per cell";
+        return false;
+    }
+    if (v_trans || src.v_trans || layers.size() != src.layers.size() || key_type != src.key_type ||
+            value_type != src.value_type) {
+        err = "seeding needs caches of the same layers and types, with untransposed values";
+        return false;
+    }
+    // the sequence's cells, in its stream of either cache
+    const uint32_t strm = seq_to_stream[seq];
+    const llama_kv_cells & from = src.v_cells[strm];
+    llama_kv_cells & to = v_cells[strm];
+    // A freed cell keeps its rows until a ubatch writes it, which the
+    // recorder sees; only the positions beyond the first are lost with it.
+    const bool freed_cells_hold = hparams.n_pos_per_embd() == 1;
+    for (size_t i = 0; i < cells.size(); ++i) {
+        const uint32_t c = cells[i];
+        const bool held = c < from.size() &&
+            (from.is_empty(c) ? freed_cells_hold : from.pos_get(c) == pos[i]);
+        if (!held) {
+            err = "cell " + std::to_string(c) + " no longer holds position " + std::to_string(pos[i]);
+            return false;
+        }
+        if (c >= to.size()) {
+            err = "cell " + std::to_string(c) + " is outside the replay cache";
+            return false;
+        }
+    }
+    // runs of consecutive cells, copied a run of rows at a time
+    std::vector<std::pair<uint32_t, uint32_t>> runs;
+    std::vector<uint32_t> sorted = cells;
+    std::sort(sorted.begin(), sorted.end());
+    for (const uint32_t c : sorted) {
+        if (!runs.empty() && runs.back().first + runs.back().second == c) {
+            runs.back().second++;
+        } else if (runs.empty() || runs.back().first + runs.back().second <= c) {
+            runs.emplace_back(c, 1);
+        }
+    }
+    std::vector<std::pair<ggml_tensor *, ggml_tensor *>> tensors;
+    for (size_t il = 0; il < layers.size(); ++il) {
+        if (layers[il].il != src.layers[il].il) {
+            err = "the caches hold different layers";
+            return false;
+        }
+        tensors.emplace_back(src.layers[il].k, layers[il].k);
+        tensors.emplace_back(src.layers[il].v, layers[il].v);
+        if (layers[il].k_idx != nullptr && src.layers[il].k_idx != nullptr) {
+            tensors.emplace_back(src.layers[il].k_idx, layers[il].k_idx);
+        }
+    }
+    ggml_init_params params = {2 * runs.size() * ggml_tensor_overhead() + ggml_tensor_overhead(), nullptr, true};
+    for (const auto & [s, d] : tensors) {
+        if (s == nullptr || d == nullptr || s->type != d->type || s->ne[0] != d->ne[0] || s->nb[1] != d->nb[1]) {
+            err = "the caches' rows differ";
+            return false;
+        }
+        ggml_context * ctx = ggml_init(params);
+        if (ctx == nullptr) {
+            err = "cannot allocate the copy views";
+            return false;
+        }
+        const size_t row = ggml_row_size(s->type, s->ne[0]);
+        auto view = [&](ggml_tensor * t, uint32_t first, uint32_t n) {
+            const size_t bytes = (static_cast<size_t>(n) - 1) * t->nb[1] + row;
+            ggml_tensor * v = ggml_new_tensor_1d(ctx, GGML_TYPE_I8, static_cast<int64_t>(bytes));
+            v->buffer = t->view_src != nullptr ? t->view_src->buffer : t->buffer;
+            v->data = static_cast<char *>(t->data) + strm * t->nb[2] + static_cast<size_t>(first) * t->nb[1];
+            return v;
+        };
+        for (const auto & [first, n] : runs) {
+            ggml_backend_tensor_copy(view(s, first, n), view(d, first, n));
+        }
+        ggml_free(ctx);
+    }
+    for (size_t i = 0; i < cells.size(); ++i) {
+        const uint32_t c = cells[i];
+        if (!to.is_empty(c)) {
+            to.rm(c);
+        }
+        to.pos_set(c, pos[i]);
+        to.ext_set(c, from.is_empty(c) ? llama_kv_cell_ext{} : from.ext_get(c));
+        to.seq_add(c, seq);
+    }
+    return true;
+}
