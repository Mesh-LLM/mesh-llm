+// Ops that may combine per-token values with persistent state or other
+// values nothing commits, and so start a token-mixing region.
+bool may_read_other_tokens(ggml_op op) {
+    return mixes_tokens(op) || op == GGML_OP_MUL_MAT || op == GGML_OP_SOFT_MAX || op == GGML_OP_CONCAT;
