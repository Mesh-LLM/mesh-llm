+std::vector<int32_t> skippy_receipt_batch_positions(const llama_model * model, const int32_t * pos, size_t n) {
+    const uint32_t n_sections = std::max<uint32_t>(model->hparams.n_pos_per_embd(), 1);
+    std::vector<int32_t> positions(n * n_sections);
+    for (uint32_t section = 0; section < n_sections; ++section) {
+        for (size_t i = 0; i < n; ++i) {
+            positions[section * n + i] = section == 0 ? pos[i] : skippy_receipt_position_section(pos[i], section);
+        }
+    }
+    return positions;
+}
