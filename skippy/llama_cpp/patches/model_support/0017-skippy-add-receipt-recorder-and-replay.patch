+bool skippy_receipt_stage_input(const skippy_model & model, ggml_type & type, int64_t & width) {
+    const skippy_activation_boundary_desc & boundary = model.input_activation_boundary;
+    const skippy_activation_part_desc & part = boundary.parts[0];
+    if (model.config.activation_import_identity_count != 1 || !model.has_input_activation_boundary ||
+            boundary.part_count != 1 || part.ggml_type >= GGML_TYPE_COUNT || part.rank != 2 || part.token_axis != 1 ||
+            part.dimensions[0] <= 0) {
+        return false;
+    }
+    type = static_cast<ggml_type>(part.ggml_type);
+    width = part.dimensions[0];
+    return ggml_type_size(type) > 0;
+}
