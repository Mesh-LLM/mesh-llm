+enum skippy_status skippy_model_set_receipt_recorder(
+        struct skippy_model * model,
+        skippy_receipt_ubatch_fn on_ubatch,
+        skippy_receipt_memory_fn on_memory,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->ctx == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model with a context is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    llama_kv_cache * kv = plain_kv_cache(model->ctx);
+    if (on_ubatch == nullptr && on_memory == nullptr) {
+        model->ctx->set_receipt_capture(nullptr);
+        model->receipt_recorder.reset();
+        if (kv != nullptr) {
+            kv->receipt_memory_observer = nullptr;
+        }
+        return skippy_success(out_error);
+    }
+    if (on_ubatch == nullptr || on_memory == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "both receipt callbacks are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (kv == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "receipts need a plain KV cache");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    auto capture = std::make_shared<skippy_receipt_capture>();
+    capture->on_ubatch = on_ubatch;
+    capture->user_data = user_data;
+    capture->f32_matmuls = skippy_receipt_needs_f32_matmuls(model->model);
+    capture->f32_attention = skippy_receipt_needs_f32_attention(model->model);
+    std::weak_ptr<skippy_receipt_capture> reports = capture;
+    kv->receipt_memory_observer = [on_memory, user_data, reports](
+            int32_t op, llama_seq_id seq, llama_seq_id seq_dst, llama_pos p0, llama_pos p1) {
+        const skippy_receipt_memory_event event = {op, seq, seq_dst, p0, p1};
+        // the ubatches before the event are reported first
+        if (auto recorder = reports.lock()) {
+            skippy_receipt_flush(*recorder);
+            skippy_receipt_state_event(*recorder, event);
+        }
+        on_memory(user_data, &event);
+    };
+    model->receipt_recorder = capture;
+    model->ctx->set_receipt_capture(std::move(capture));
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_model_flush_receipt_recorder(struct skippy_model * model, struct skippy_error ** out_error) {
+    if (model == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (auto recorder = model->receipt_recorder.lock()) {
+        skippy_receipt_flush(*recorder);
+    }
+    return skippy_success(out_error);
+}
