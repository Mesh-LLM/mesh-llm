--- /dev/null
+++ b/src/skippy/receipts_draw.h
@@ -0,0 +1,33 @@
+#pragma once
+
+// The draw of a sampled turn that gets a receipt.
+//
+// llama.cpp's `dist` sampler draws from a std::mt19937 stream, in the order
+// the earlier samplers left the candidates in. Neither is the same on every
+// platform, so a client could not replay it. This sampler takes its place at
+// the end of the chain: the uniform is a function of the seed and of the
+// position the sampled token takes, and the candidates are walked in token id
+// order. A client that knows the seed, the position and the logits finds the
+// token the draw must have picked.
+
+#include "llama.h"
+
+#include <cstddef>
+#include <cstdint>
+
+// The uniform in [0, 1) that picks the token at position `index` of its
+// sequence: the 53 high bits of SplitMix64 over the seed and the index.
+double skippy_receipt_draw_uniform(uint32_t seed, uint64_t index);
+
+// The index in `data` of the candidate `u` picks: the first, in token id
+// order, whose running softmax weight passes `u` times the total, else the
+// last. Sets every candidate's normalized `p`. `size` is at least 1.
+size_t skippy_receipt_draw_pick(llama_token_data * data, size_t size, double u);
+
+// Replaces the `dist` sampler that ends `chain` with the indexed draw of
+// `seed`. False, with the chain unchanged, when it ends in another sampler.
+bool skippy_receipt_draw_install(llama_sampler * chain, uint32_t seed);
+
+// The next draw of `chain` picks the token at position `index`. Does nothing
+// to a chain without the indexed draw.
+void skippy_receipt_draw_set_index(llama_sampler * chain, uint64_t index);
diff --git a/src/skippy/receipts_glue.cpp b/src/skippy/receipts_glue.cpp
new file mode 100644
index 000000000..8d8c8086e
--- /dev/null
+++ b/src/skippy/receipts_glue.cpp
@@ -0,0 +1,406 @@
+// Evaluations an auditor runs in the glue context of a stage model: one
+// layer's glue on opened values, the residual entering layer 0, and the
+// recurrent token mixing of one layer.
+
+#include "skippy/receipts.h"
+
+#include "errors.h"
+#include "graph_build_inputs.h"
+#include "receipts_internal.h"
+#include "receipts_scratch.h"
+#include "runtime_types.h"
+
+#include "ggml-backend.h"
+#include "llama-batch.h"
+#include "llama-context.h"
+#include "llama-graph.h"
+#include "llama-kv-cache.h"
+#include "llama-model.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace {
+
+// Columns of a glue evaluation, at least two so the classifier can tell the
+// token axis from other axes of size one.
+constexpr int32_t MIN_GLUE_COLUMNS = 2;
+
+// The sequences a region evaluation's context holds: its own, and the
+// padding of a region of one position.
+constexpr uint32_t REGION_SEQUENCES = 2;
+
+// The contexts an evaluation runs in: glue and entry evaluations compute
+// every column as its own sequence, a region evaluation one sequence.
+enum class eval_kind { columns, sequence };
+
+skippy_receipt_eval_context & eval_context(skippy_receipt_scratch & scratch, eval_kind kind) {
+    return kind == eval_kind::columns ? scratch.glue : scratch.region;
+}
+
+enum skippy_status ensure_context(skippy_model * model, skippy_receipt_eval_context & eval, eval_kind kind,
+        uint32_t columns, skippy_error ** out_error) {
+    if (eval.ctx != nullptr && eval.columns >= columns) {
+        return SKIPPY_STATUS_OK;
+    }
+    eval.release();
+    if (!model->has_receipt_ctx_params) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the stage context parameters were not kept");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    eval.capture = std::make_shared<skippy_receipt_capture>();
+    eval.capture->mode = kind == eval_kind::columns ? skippy_receipt_mode::glue : skippy_receipt_mode::region;
+    llama_context_params params = model->receipt_ctx_params;
+    // a recurrent memory keeps a state per sequence, so a region of many
+    // positions holds one sequence of them
+    params.n_seq_max = kind == eval_kind::columns ? columns : REGION_SEQUENCES;
+    params.kv_unified = true;
+    params.n_ctx = std::max<uint32_t>(256, columns);
+    params.n_batch = std::max<uint32_t>(params.n_batch, columns);
+    params.n_ubatch = std::max<uint32_t>(params.n_ubatch, columns);
+    params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+    params.cb_eval = skippy_receipt_eval;
+    params.cb_eval_user_data = eval.capture.get();
+    // a hybrid memory splits a batch whose every token is an output by
+    // sequence, one column per ubatch; nothing reads the glue's outputs
+    if (llama_model_is_hybrid(model->model)) {
+        params.embeddings = false;
+    }
+    params.samplers = nullptr;
+    params.n_samplers = 0;
+    eval.ctx = llama_init_from_model_with_graph_inputs(
+            model->model, params, skippy_graph_build_inputs_from_config(&model->config));
+    if (eval.ctx == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to create the receipt glue context");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (skippy_receipt_attention_cache(eval.ctx) == nullptr) {
+        eval.release();
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the glue context has no plain KV cache");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    eval.capture->windows = skippy_receipt_attention_windows(model->model, eval.ctx->get_cparams().causal_attn);
+    eval.columns = columns;
+    eval.ctx->set_receipt_capture(eval.capture);
+    return SKIPPY_STATUS_OK;
+}
+
+// Columns of an evaluation. A glue or entry evaluation computes each as its
+// own sequence of one token, a region evaluation all of them as one
+// sequence. A residual, when given, is the stage's activation import.
+struct glue_columns {
+    int32_t n_cols = 0;
+    const int32_t * tokens = nullptr;
+    const int32_t * pos = nullptr;
+    const float * residual = nullptr;
+    int64_t residual_len = 0;
+    eval_kind kind = eval_kind::columns;
+};
+
+glue_columns request_columns(const skippy_receipt_glue_request & request, eval_kind kind) {
+    glue_columns columns;
+    columns.n_cols = request.n_cols;
+    columns.pos = request.pos;
+    columns.residual = request.residual;
+    columns.residual_len = request.residual_len;
+    columns.kind = kind;
+    return columns;
+}
+
+// An auditor evaluates what the node it audits opened, so every count,
+// length, position and token of a request is checked here, before a graph is
+// built on it: a graph input of the wrong shape, or an id outside the table
+// it indexes, stops the process in ggml instead of returning an error.
+
+// Why a request's values cannot be used, or an empty string.
+std::string glue_values_error(const skippy_receipt_glue_request & request, eval_kind kind) {
+    if (request.values == nullptr && request.n_values != 0) {
+        return "a glue request with a value count needs the values";
+    }
+    for (size_t i = 0; i < request.n_values; ++i) {
+        const skippy_receipt_glue_value & v = request.values[i];
+        const bool glue = v.kind == SKIPPY_RECEIPT_TENSOR_MATMUL_OUTPUT || v.kind == SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT ||
+                          v.kind == SKIPPY_RECEIPT_TENSOR_SELECTION;
+        const bool region = v.kind == SKIPPY_RECEIPT_TENSOR_MIXING_INPUT || v.kind == SKIPPY_RECEIPT_TENSOR_MIXING_STATE;
+        const ggml_type type = v.kind == SKIPPY_RECEIPT_TENSOR_SELECTION ? GGML_TYPE_I32 : GGML_TYPE_F32;
+        if (!(glue || (kind == eval_kind::sequence && region)) || v.index < 0 || v.len < 0 || v.ggml_type != type) {
+            return "opened value " + std::to_string(i) + " (kind " + std::to_string(v.kind) + ", index " +
+                   std::to_string(v.index) + ") has a kind, index, length or type the evaluation does not take";
+        }
+    }
+    return {};
+}
+
+// The positions a region evaluation may hold. A region is part of one
+// sequence, so it is no longer than a context: the one the model was trained
+// with, or this stage's when that is larger. An auditor's own context is
+// small; the evaluation context grows to the region.
+int64_t max_region_columns(const skippy_model * model) {
+    const int64_t n_ctx = model->has_receipt_ctx_params ? model->receipt_ctx_params.n_ctx : 0;
+    return std::max<int64_t>(n_ctx, llama_model_n_ctx_train(model->model));
+}
+
+// Why the columns' count, positions or tokens cannot be computed, or an
+// empty string.
+std::string columns_error(const skippy_model * model, const glue_columns & request) {
+    const int64_t max_cols = request.kind == eval_kind::columns ? LLAMA_MAX_SEQ : max_region_columns(model);
+    if (request.n_cols <= 0 || request.n_cols > max_cols) {
+        return "an evaluation takes 1 to " + std::to_string(max_cols) + " columns, not " + std::to_string(request.n_cols);
+    }
+    // a model with a table of learned positions gathers a row per position
+    const ggml_tensor * learned = model->model->pos_embd;
+    const int64_t max_pos = learned != nullptr ? learned->ne[1] : int64_t{INT32_MAX};
+    for (int32_t j = 0; j < request.n_cols; ++j) {
+        if (request.pos[j] < 0 || request.pos[j] >= max_pos) {
+            return "position " + std::to_string(request.pos[j]) + " of column " + std::to_string(j) +
+                   " is not a position of the model";
+        }
+        if (request.kind == eval_kind::sequence && j > 0 && request.pos[j] - 1 != request.pos[j - 1]) {
+            return "a region's positions must be consecutive";
+        }
+    }
+    const int32_t n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model->model));
+    for (int32_t j = 0; request.tokens != nullptr && j < request.n_cols; ++j) {
+        if (request.tokens[j] < 0 || request.tokens[j] >= n_vocab) {
+            return "token " + std::to_string(request.tokens[j]) + " of column " + std::to_string(j) +
+                   " is not in the vocabulary";
+        }
+    }
+    return {};
+}
+
+// Why the opened residual is not what the stage's layers read, or an empty
+// string. A stage after the first imports the residual as its one input: an
+// f32 row per token of the width the loaded graph declared. The first stage
+// computes its residual from tokens and the opened one replaces a graph node,
+// whose width begin_compute checks; here it only bounds the copy.
+std::string residual_error(const skippy_model * model, const glue_columns & request, bool & unsupported) {
+    unsupported = false;
+    if (request.residual == nullptr) {
+        return {};
+    }
+    if (model->config.activation_import_identity_count == 0) {
+        const int64_t widest = std::max(llama_model_n_embd(model->model), llama_model_n_embd_inp(model->model));
+        if (request.residual_len <= 0 || request.residual_len > widest) {
+            return "the residual has " + std::to_string(request.residual_len) + " values per column, the model at most " +
+                   std::to_string(widest);
+        }
+        return {};
+    }
+    ggml_type type = GGML_TYPE_COUNT;
+    int64_t width = 0;
+    if (!skippy_receipt_stage_input(*model, type, width) || type != GGML_TYPE_F32) {
+        unsupported = true;
+        return "the stage's input is not one f32 row per token";
+    }
+    if (request.residual_len != width) {
+        return "the residual has " + std::to_string(request.residual_len) + " values per column, the stage reads " +
+               std::to_string(width);
+    }
+    return {};
+}
+
+// Checks an evaluation's columns before anything is allocated or computed
+// from them.
+enum skippy_status check_columns(const skippy_model * model, const glue_columns & request, skippy_error ** out_error) {
+    bool unsupported = false;
+    std::string error = columns_error(model, request);
+    if (error.empty()) {
+        error = residual_error(model, request, unsupported);
+    }
+    if (error.empty()) {
+        return SKIPPY_STATUS_OK;
+    }
+    const enum skippy_status status = unsupported ? SKIPPY_STATUS_UNSUPPORTED : SKIPPY_STATUS_INVALID_ARGUMENT;
+    skippy_set_error(out_error, status, error.c_str());
+    return status;
+}
+
+// Checks a glue or region request: its pointers, its values, and its columns.
+enum skippy_status check_glue_request(const skippy_model * model, const skippy_receipt_glue_request * request,
+        eval_kind kind, skippy_error ** out_error) {
+    if (request == nullptr || request->pos == nullptr || request->residual == nullptr || request->layer < 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                "a request needs a layer, positions and a residual");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const std::string error = glue_values_error(*request, kind);
+    if (!error.empty()) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, error.c_str());
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    return check_columns(model, request_columns(*request, kind), out_error);
+}
+
+// The sequence of column `j`. A region of one position is padded with a
+// second sequence, so the token axis stays apart from axes of size one.
+llama_seq_id column_sequence(const glue_columns & request, size_t j) {
+    if (request.kind == eval_kind::columns || request.n_cols == 1) {
+        return static_cast<llama_seq_id>(j);
+    }
+    return 0;
+}
+
+enum skippy_status decode_columns(
+        skippy_model * model, llama_context * ctx, const glue_columns & request, skippy_error ** out_error) {
+    const int32_t n = std::max(request.n_cols, MIN_GLUE_COLUMNS);
+    const auto columns = static_cast<size_t>(n);
+    // columns past the request repeat its first column
+    auto source = [&](size_t j) { return j < static_cast<size_t>(request.n_cols) ? j : 0; };
+    std::vector<llama_token> tokens(columns, 0);
+    std::vector<llama_pos> positions(columns);
+    std::vector<int32_t> n_seq_id(columns, 1);
+    std::vector<llama_seq_id> seq_values(columns);
+    std::vector<llama_seq_id *> seq_ids(columns);
+    std::vector<int8_t> logits(columns, 1);
+    const auto row = static_cast<size_t>(request.residual_len);
+    std::vector<float> residual(columns * row);
+    for (size_t j = 0; j < columns; ++j) {
+        positions[j] = request.pos[source(j)];
+        if (request.tokens != nullptr) {
+            tokens[j] = request.tokens[source(j)];
+        }
+        seq_values[j] = column_sequence(request, j);
+        seq_ids[j] = &seq_values[j];
+        if (request.residual != nullptr) {
+            std::memcpy(residual.data() + j * row, request.residual + source(j) * row, row * sizeof(float));
+        }
+    }
+    // a decode with an imported residual reads every position section
+    positions = skippy_receipt_batch_positions(model->model, positions.data(), columns);
+    skippy_graph_build_inputs inputs = skippy_graph_build_inputs_from_config(&model->config);
+    skippy_graph_build_inputs_set_activation_tokens(inputs, tokens.data(), columns);
+    skippy_activation_frontier_part_input part;
+    part.values = residual.data();
+    part.payload_bytes = residual.size() * sizeof(float);
+    part.ggml_type = GGML_TYPE_F32;
+    part.rank = 2;
+    part.token_axis = 1;
+    part.dimensions[0] = request.residual_len;
+    part.dimensions[1] = n;
+    part.byte_strides[0] = sizeof(float);
+    part.byte_strides[1] = row * sizeof(float);
+    part.pos_start = positions[0];
+    if (request.residual != nullptr && model->config.activation_import_identity_count > 0) {
+        inputs.activation_frontier.push_back(part);
+    }
+    llama_batch batch = {
+        n, tokens.data(), nullptr, positions.data(), n_seq_id.data(), seq_ids.data(), logits.data(),
+    };
+    int32_t rc = 0;
+    if (!skippy_contain_native_failure(out_error, [&] { rc = ctx->decode(batch, inputs); })) {
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (rc != 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "the receipt glue evaluation failed to decode");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    return SKIPPY_STATUS_OK;
+}
+
+// Runs one evaluation: `mode` and `layers` select what the graph reports,
+// `request` the columns it computes.
+enum skippy_status eval_columns(skippy_model * model, skippy_receipt_mode mode, std::vector<int32_t> layers,
+        const glue_columns & request, const skippy_receipt_glue_request * glue, skippy_receipt_ubatch_fn on_result,
+        void * user_data, skippy_error ** out_error) {
+    auto scratch = model->receipt_scratch;
+    if (!scratch) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the model cannot evaluate receipt glue");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    std::lock_guard<std::mutex> lock(scratch->mutex);
+    skippy_receipt_eval_context & eval = eval_context(*scratch, request.kind);
+    const auto columns = static_cast<uint32_t>(std::max(request.n_cols, MIN_GLUE_COLUMNS));
+    enum skippy_status status = ensure_context(model, eval, request.kind, columns, out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    llama_context * ctx = eval.ctx;
+    llama_memory_t memory = ctx->get_memory();
+    llama_memory_clear(memory, false);
+    auto & capture = *eval.capture;
+    capture.on_ubatch = on_result;
+    capture.user_data = user_data;
+    capture.glue = glue;
+    if (capture.mode != mode || capture.layers != layers) {
+        capture.mode = mode;
+        capture.layers = std::move(layers);
+        // the next ubatch rebuilds its graph for this evaluation
+        ctx->set_receipt_capture(eval.capture);
+    }
+    status = decode_columns(model, ctx, request, out_error);
+    capture.on_ubatch = nullptr;
+    capture.user_data = nullptr;
+    capture.glue = nullptr;
+    llama_memory_clear(memory, false);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    return skippy_success(out_error);
+}
+
+}  // namespace
+
+enum skippy_status skippy_model_eval_receipt_glue(
+        struct skippy_model * model,
+        const struct skippy_receipt_glue_request * request,
+        skippy_receipt_ubatch_fn on_result,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->model == nullptr || on_result == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model, a glue request and a result callback are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const enum skippy_status status = check_glue_request(model, request, eval_kind::columns, out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    return eval_columns(model, skippy_receipt_mode::glue, {request->layer}, request_columns(*request, eval_kind::columns),
+            request, on_result, user_data, out_error);
+}
+
+enum skippy_status skippy_model_eval_receipt_region(
+        struct skippy_model * model,
+        const struct skippy_receipt_glue_request * request,
+        skippy_receipt_ubatch_fn on_result,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->model == nullptr || on_result == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model, a region request and a result callback are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const enum skippy_status status = check_glue_request(model, request, eval_kind::sequence, out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    return eval_columns(model, skippy_receipt_mode::region, {request->layer},
+            request_columns(*request, eval_kind::sequence), request, on_result, user_data, out_error);
+}
+
+enum skippy_status skippy_model_eval_receipt_entry(
+        struct skippy_model * model,
+        const int32_t * tokens,
+        const int32_t * pos,
+        int32_t n_cols,
+        skippy_receipt_ubatch_fn on_result,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->model == nullptr || tokens == nullptr || pos == nullptr || on_result == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model, tokens, positions and a result callback are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    glue_columns columns;
+    columns.n_cols = n_cols;
+    columns.tokens = tokens;
+    columns.pos = pos;
+    const enum skippy_status status = check_columns(model, columns, out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    return eval_columns(model, skippy_receipt_mode::entry, {}, columns, nullptr, on_result, user_data, out_error);
+}
diff --git a/src/skippy/receipts_graph.cpp b/src/skippy/receipts_graph.cpp
new file mode 100644
index 000000000..74a183141
--- /dev/null
+++ b/src/skippy/receipts_graph.cpp
@@ -0,0 +1,812 @@
+// Receipt tensors of a built graph: which ones a recorder, replay or glue
+// evaluation reports. Reading them back is in receipts_readback.cpp.
+
+#include "receipts_internal.h"
+#include "receipts_layers.h"
+#include "receipts_values.h"
+
+#include "ggml-backend.h"
+#include "llama-batch.h"
+#include "llama-graph.h"
+#include "llama-kv-cache.h"
+#include "llama-model.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <set>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+using namespace skippy_receipt_values;
+
+namespace {
+
+// The request input identity without its ordinal suffix.
+std::string identity_name(const std::string & identity) {
+    const size_t dot = identity.rfind('.');
+    return dot == std::string::npos ? identity : identity.substr(0, dot);
+}
+
+bool starts_with(const std::string & s, const std::string & prefix) {
+    return s.compare(0, prefix.size(), prefix) == 0;
+}
+
+// Request inputs that address persistent state: the builders name the masks
+// and cell indices of attention under "attention." and the state indices of
+// recurrent ops under "recurrent.".
+bool selects_state(const std::string & name) {
+    return starts_with(name, "attention.") || starts_with(name, "recurrent.");
+}
+
+skippy_receipt_graph_facts graph_facts(const llm_graph_result & res, int64_t n_tokens, int64_t n_seqs) {
+    skippy_receipt_graph_facts facts;
+    facts.n_tokens = n_tokens;
+    facts.n_seqs = n_seqs;
+    std::map<int32_t, skippy_receipt_graph_facts::layer_bounds> layers;
+    for (const auto & boundary : res.get_block_boundaries()) {
+        auto & bounds = layers[boundary.layer];
+        bounds.layer = boundary.layer;
+        // a stage holds its import in place of the boundary it was built with
+        auto * tensor = const_cast<ggml_tensor *>(res.get_stage_block_boundary(boundary.tensor));
+        if (boundary.kind == skippy_block_boundary_kind::entry) {
+            bounds.entry = tensor;
+        } else {
+            bounds.exit = tensor;
+        }
+    }
+    for (const auto & entry : layers) {
+        facts.layers.push_back(entry.second);
+    }
+    // Persistent tensors a graph of the context writes are state. One that
+    // no cache holds and no graph node writes is a constant of the context:
+    // it has no per-token data and is the same for every request, and a
+    // context of the same model and cache types builds the same one (the
+    // rotations of a quantized KV cache, which the cache fills once).
+    std::unordered_set<const ggml_tensor *> written;
+    for (const auto & effect : res.get_state_effects()) {
+        if (effect.storage != nullptr && effect.access == skippy_state_access::write) {
+            written.insert(effect.storage);
+        }
+    }
+    for (const auto & effect : res.get_state_effects()) {
+        if (effect.storage == nullptr) {
+            continue;
+        }
+        if (effect.kind == skippy_state_kind::derived_persistent && written.count(effect.storage) == 0) {
+            facts.constant_inputs.insert(effect.storage);
+            continue;
+        }
+        facts.state_storage.insert(effect.storage);
+        if (effect.kind == skippy_state_kind::recurrent_conv || effect.kind == skippy_state_kind::recurrent_ssm) {
+            facts.recurrent_storage.insert(effect.storage);
+        }
+    }
+    for (const auto & binding : res.get_request_input_bindings()) {
+        const std::string name = identity_name(binding.identity);
+        if (name == "positions" || name == "attention.scale") {
+            facts.client_inputs.insert(binding.tensor);
+        } else if (name == "output.indices") {
+            facts.output_indices.insert(binding.tensor);
+        } else if (name == "attention.key_indices" || name == "attention.value_indices") {
+            facts.cell_indices.insert(binding.tensor);
+        } else if (selects_state(name)) {
+            facts.state_selectors.insert(binding.tensor);
+        }
+    }
+    facts.is_weight = [](const ggml_tensor * t) {
+        return t->op == GGML_OP_NONE && t->buffer != nullptr &&
+               ggml_backend_buffer_get_usage(t->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS;
+    };
+    return facts;
+}
+
+void add_value(skippy_receipt_capture & capture, const skippy_receipt_value & value, int32_t layer, int32_t kind,
+        int32_t index, int32_t flags = 0, const char * name = nullptr) {
+    skippy_receipt_target target;
+    target.tensor = value.tensor;
+    target.axis = value.axis;
+    target.layer = layer;
+    target.kind = kind;
+    target.index = index;
+    target.flags = flags;
+    target.name = name != nullptr ? name : value.tensor->name;
+    capture.targets.push_back(target);
+}
+
+void add_committed(skippy_receipt_capture & capture, const skippy_receipt_layer_plan & plan) {
+    add_value(capture, plan.entry, plan.layer, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0);
+    for (size_t i = 0; i < plan.mixing_inputs.size(); ++i) {
+        add_value(capture, plan.mixing_inputs[i], plan.layer, SKIPPY_RECEIPT_TENSOR_MIXING_INPUT, static_cast<int32_t>(i));
+    }
+    for (size_t i = 0; i < plan.stores.size(); ++i) {
+        skippy_receipt_target target;
+        target.tensor = plan.stores[i].node;
+        target.layer = plan.layer;
+        target.kind = SKIPPY_RECEIPT_TENSOR_MIXING_STORED;
+        target.index = static_cast<int32_t>(i);
+        target.name = plan.stores[i].source.tensor->name;
+        target.rows = plan.stores[i].rows;
+        capture.targets.push_back(target);
+    }
+    for (size_t i = 0; i < plan.mixing_outputs.size(); ++i) {
+        add_value(capture, plan.mixing_outputs[i], plan.layer, SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT, static_cast<int32_t>(i));
+    }
+    for (size_t i = 0; i < plan.states.size(); ++i) {
+        add_value(capture, plan.states[i].read, plan.layer, SKIPPY_RECEIPT_TENSOR_MIXING_STATE, static_cast<int32_t>(i));
+    }
+}
+
+void add_matmuls(skippy_receipt_capture & capture, const skippy_receipt_layer_plan & plan, bool outputs) {
+    for (size_t i = 0; i < plan.matmuls.size(); ++i) {
+        const auto & m = plan.matmuls[i];
+        const auto index = static_cast<int32_t>(i);
+        const int32_t flags = m.router ? SKIPPY_RECEIPT_TENSOR_ROUTER : 0;
+        add_value(capture, m.input, plan.layer, SKIPPY_RECEIPT_TENSOR_MATMUL_INPUT, index, flags, m.weight->name);
+        if (outputs) {
+            add_value(capture, m.output, plan.layer, SKIPPY_RECEIPT_TENSOR_MATMUL_OUTPUT, index, flags, m.weight->name);
+        }
+        if (m.ids.tensor != nullptr) {
+            add_value(capture, m.ids, plan.layer, SKIPPY_RECEIPT_TENSOR_EXPERT_IDS, index, flags, m.weight->name);
+        }
+    }
+}
+
+void add_glue(skippy_receipt_capture & capture, const skippy_receipt_layer_plan & plan) {
+    const int32_t layer = plan.layer;
+    ggml_tensor * entry = plan.entry.tensor;
+    if ((entry->flags & GGML_TENSOR_FLAG_INPUT) == 0 && entry->view_src == nullptr) {
+        // a first stage computes its entry from tokens; the opened residual replaces it
+        capture.substitutes.push_back({entry, plan.entry.axis, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0});
+    }
+    add_matmuls(capture, plan, false);
+    for (size_t i = 0; i < plan.matmuls.size(); ++i) {
+        capture.substitutes.push_back(
+                {plan.matmuls[i].node, plan.matmuls[i].output.axis, SKIPPY_RECEIPT_TENSOR_MATMUL_OUTPUT, static_cast<int32_t>(i)});
+    }
+    for (size_t i = 0; i < plan.mixing_inputs.size(); ++i) {
+        add_value(capture, plan.mixing_inputs[i], layer, SKIPPY_RECEIPT_TENSOR_MIXING_INPUT, static_cast<int32_t>(i));
+    }
+    for (size_t i = 0; i < plan.stores.size(); ++i) {
+        add_value(capture, plan.stores[i].source, layer, SKIPPY_RECEIPT_TENSOR_MIXING_STORED, static_cast<int32_t>(i));
+    }
+    // reported so the auditor learns from its own graph which layers keep a
+    // recurrent state; the region evaluation checks them
+    for (size_t i = 0; i < plan.states.size(); ++i) {
+        add_value(capture, plan.states[i].read, layer, SKIPPY_RECEIPT_TENSOR_MIXING_STATE, static_cast<int32_t>(i));
+    }
+    for (size_t i = 0; i < plan.mixing_outputs.size(); ++i) {
+        const auto & out = plan.mixing_outputs[i];
+        capture.substitutes.push_back({out.tensor, out.axis, SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT, static_cast<int32_t>(i)});
+    }
+    for (size_t i = 0; i < plan.selections.size(); ++i) {
+        const auto & s = plan.selections[i];
+        add_value(capture, s.scores, layer, SKIPPY_RECEIPT_TENSOR_SELECTION_SCORES, static_cast<int32_t>(i));
+        capture.substitutes.push_back({s.node, s.output.axis, SKIPPY_RECEIPT_TENSOR_SELECTION, static_cast<int32_t>(i)});
+    }
+    for (const ggml_tensor * w : plan.unchecked_weights) {
+        capture.unchecked_weights.emplace_back(w->name);
+    }
+}
+
+// The state a region leaves: the most recent state of each sequence, read
+// from the state's storage once the region's write has run. The graph holds
+// no tensor of that slice, so the capture keeps a view of the storage with
+// the slice's shape; the readback reads a value from its root's bytes.
+void add_state_left(skippy_receipt_capture & capture, const skippy_receipt_state & state, int32_t layer, int32_t index) {
+    capture.state_views.emplace_back();
+    ggml_tensor & view = capture.state_views.back();
+    view.type = state.storage->type;
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        view.ne[d] = state.left.ne[d];
+        view.nb[d] = state.left.nb[d];
+    }
+    view.view_src = const_cast<ggml_tensor *>(state.storage);
+    view.view_offs = state.left.offset;
+    std::snprintf(view.name, sizeof(view.name), "%s", state.storage->name);
+    skippy_receipt_target target;
+    target.tensor = &view;
+    target.axis = state.left.axis;
+    target.layer = layer;
+    target.kind = SKIPPY_RECEIPT_TENSOR_MIXING_STATE_OUT;
+    target.index = index;
+    target.name = view.name;
+    target.after = state.write;
+    capture.targets.push_back(target);
+}
+
+// A region evaluation computes the recurrent token mixing from opened
+// inputs and states. The weight matmuls and selections take zeros: nothing
+// the mixing reads depends on them once its inputs are given.
+std::string add_region(skippy_receipt_capture & capture, const skippy_receipt_layer_plan & plan) {
+    const int32_t layer = plan.layer;
+    if (!plan.stores.empty()) {
+        return "the token mixing of layer " + std::to_string(layer) + " reads a KV cache";
+    }
+    if (plan.states.empty()) {
+        return "layer " + std::to_string(layer) + " keeps no recurrent state";
+    }
+    ggml_tensor * entry = plan.entry.tensor;
+    if ((entry->flags & GGML_TENSOR_FLAG_INPUT) == 0 && entry->view_src == nullptr) {
+        capture.substitutes.push_back({entry, plan.entry.axis, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0});
+    }
+    for (size_t i = 0; i < plan.matmuls.size(); ++i) {
+        capture.substitutes.push_back(
+                {plan.matmuls[i].node, plan.matmuls[i].output.axis, SKIPPY_RECEIPT_TENSOR_MATMUL_OUTPUT, static_cast<int32_t>(i)});
+    }
+    for (size_t i = 0; i < plan.selections.size(); ++i) {
+        const auto & s = plan.selections[i];
+        capture.substitutes.push_back({s.node, s.output.axis, SKIPPY_RECEIPT_TENSOR_SELECTION, static_cast<int32_t>(i)});
+    }
+    // after the matmuls: an input may view a matmul's output
+    for (size_t i = 0; i < plan.mixing_inputs.size(); ++i) {
+        const auto & in = plan.mixing_inputs[i];
+        capture.substitutes.push_back({in.tensor, in.axis, SKIPPY_RECEIPT_TENSOR_MIXING_INPUT, static_cast<int32_t>(i)});
+    }
+    for (size_t i = 0; i < plan.states.size(); ++i) {
+        const auto & state = plan.states[i];
+        const auto index = static_cast<int32_t>(i);
+        if (state.write == nullptr || state.left.axis < 0) {
+            return "cannot follow the state " + std::to_string(i) + " layer " + std::to_string(layer) + " writes";
+        }
+        capture.substitutes.push_back({state.read.tensor, state.read.axis, SKIPPY_RECEIPT_TENSOR_MIXING_STATE, index});
+        add_state_left(capture, state, layer, index);
+    }
+    for (size_t i = 0; i < plan.mixing_outputs.size(); ++i) {
+        add_value(capture, plan.mixing_outputs[i], layer, SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT, static_cast<int32_t>(i));
+    }
+    return {};
+}
+
+// The nodes an anchored replay writes committed values into: the residual
+// entering the layer, where the graph computes it, and its token-mixing
+// outputs. A residual the stage imports is set from the turn's own input.
+void add_anchor_nodes(skippy_receipt_capture & capture, const skippy_receipt_layer_plan & plan) {
+    ggml_tensor * entry = plan.entry.tensor;
+    if (entry->op != GGML_OP_NONE && (entry->flags & GGML_TENSOR_FLAG_INPUT) == 0) {
+        capture.anchor_nodes.push_back({entry, plan.entry.axis, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0, plan.layer});
+    }
+    for (size_t i = 0; i < plan.mixing_outputs.size(); ++i) {
+        const auto & out = plan.mixing_outputs[i];
+        capture.anchor_nodes.push_back(
+                {out.tensor, out.axis, SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT, static_cast<int32_t>(i), plan.layer});
+    }
+}
+
+// A final stage's logits, which a replay of its last layer reports, or null.
+ggml_tensor * stage_logits(const skippy_receipt_capture & capture, llm_graph_result & res,
+        const std::vector<skippy_receipt_layer_plan> & plans) {
+    ggml_tensor * logits = res.get_logits();
+    const bool last = !capture.layers.empty() && capture.layers.back() == plans.back().layer;
+    if (logits == nullptr || !last || capture.n_vocab <= 0 || logits->ne[0] != capture.n_vocab ||
+            logits->ne[2] != 1 || logits->ne[3] != 1) {
+        return nullptr;
+    }
+    return logits;
+}
+
+std::string select_targets(skippy_receipt_capture & capture, const std::vector<skippy_receipt_layer_plan> & plans,
+        ggml_tensor * logits) {
+    if (capture.mode == skippy_receipt_mode::record) {
+        for (const auto & plan : plans) {
+            add_committed(capture, plan);
+        }
+        add_value(capture, plans.back().exit, plans.back().layer + 1, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0);
+        return {};
+    }
+    if (capture.mode == skippy_receipt_mode::entry) {
+        if (plans.front().layer != 0) {
+            return "the graph does not hold layer 0";
+        }
+        add_value(capture, plans.front().entry, 0, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0);
+        return {};
+    }
+    if (capture.layers.empty()) {
+        return "no layer to report";
+    }
+    for (const int32_t layer : capture.layers) {
+        const auto found = std::find_if(plans.begin(), plans.end(),
+                [&](const skippy_receipt_layer_plan & plan) { return plan.layer == layer; });
+        if (found == plans.end()) {
+            return "layer " + std::to_string(layer) + " is not in the graph";
+        }
+        const auto & plan = *found;
+        if (capture.mode == skippy_receipt_mode::replay) {
+            add_committed(capture, plan);
+            if (!capture.committed_only) {
+                add_matmuls(capture, plan, true);
+                for (size_t i = 0; i < plan.selections.size(); ++i) {
+                    add_value(capture, plan.selections[i].output, plan.layer, SKIPPY_RECEIPT_TENSOR_SELECTION,
+                            static_cast<int32_t>(i));
+                }
+                add_anchor_nodes(capture, plan);
+            }
+        } else if (capture.mode == skippy_receipt_mode::region) {
+            const std::string error = add_region(capture, plan);
+            if (!error.empty()) {
+                return error;
+            }
+            continue;
+        } else {
+            add_glue(capture, plan);
+        }
+        // a reported next layer already holds this residual as its entry
+        if (std::find(capture.layers.begin(), capture.layers.end(), layer + 1) == capture.layers.end()) {
+            add_value(capture, plan.exit, plan.layer + 1, SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0);
+        }
+    }
+    if (capture.mode == skippy_receipt_mode::replay && logits != nullptr) {
+        // the head reads the residual leaving the last layer: its logits
+        // let an auditor check the head against a key, not the whole matrix
+        add_value(capture, {logits, 1}, plans.back().layer + 1, SKIPPY_RECEIPT_TENSOR_LOGITS, 0);
+    }
+    return {};
+}
+
+// The attention ops of the layers a replay or glue evaluation reports.
+void describe_attention(skippy_receipt_capture & capture, llm_graph_result & res,
+        const std::vector<skippy_receipt_layer_plan> & plans, const skippy_receipt_graph_facts & facts) {
+    if (capture.mode != skippy_receipt_mode::replay && capture.mode != skippy_receipt_mode::glue) {
+        return;
+    }
+    for (const auto & plan : plans) {
+        if (!std::binary_search(capture.layers.begin(), capture.layers.end(), plan.layer)) {
+            continue;
+        }
+        skippy_receipt_attention_window window;
+        window.kind = -1;
+        if (plan.layer >= 0 && static_cast<size_t>(plan.layer) < capture.windows.size()) {
+            window = capture.windows[static_cast<size_t>(plan.layer)];
+        }
+        for (auto & op : skippy_receipt_describe_attention(res.get_gf(), plan, window, facts.constant_inputs)) {
+            capture.attention.push_back(std::move(op));
+        }
+    }
+}
+
+std::string find_targets(skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens, int64_t n_seqs) {
+    std::vector<skippy_receipt_layer_plan> plans;
+    const skippy_receipt_graph_facts facts = graph_facts(res, n_tokens, n_seqs);
+    std::string error = skippy_receipt_classify(res.get_gf(), facts, plans);
+    if (!error.empty()) {
+        return error;
+    }
+    error = select_targets(capture, plans, stage_logits(capture, res, plans));
+    if (!error.empty()) {
+        return error;
+    }
+    describe_attention(capture, res, plans, facts);
+    const auto & imports = res.get_skippy_activation_imports();
+    if (imports.size() > 1) {
+        return "a stage with more than one activation import";
+    }
+    if (imports.size() == 1) {
+        capture.input = imports.front().tensor;
+        if (capture.input == nullptr || !ggml_is_contiguous(capture.input) || capture.input->ne[2] != 1 ||
+                capture.input->ne[3] != 1) {
+            return "the activation import is not a contiguous row per token";
+        }
+    }
+    for (const auto & target : capture.targets) {
+        if (target.rows != nullptr) {
+            continue;
+        }
+        const ggml_type type = target.tensor->type;
+        if (type != GGML_TYPE_F32 && type != GGML_TYPE_F16 && type != GGML_TYPE_BF16 && type != GGML_TYPE_I32) {
+            return std::string("receipt value ") + target.tensor->name + " has type " + ggml_type_name(type);
+        }
+    }
+    return {};
+}
+
+void keep_alive(ggml_tensor * t) {
+    ggml_set_output(t);
+    for (ggml_tensor * root = t->view_src; root != nullptr; root = root->view_src) {
+        ggml_set_output(root);
+    }
+}
+
+// Replay and glue: stop once every reported tensor is computed.
+void stop_after_targets(skippy_receipt_capture & capture, ggml_cgraph * gf) {
+    std::set<const ggml_tensor *> nodes;
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        nodes.insert(ggml_graph_node(gf, i));
+    }
+    for (const auto & target : capture.targets) {
+        // a state a region leaves is in its storage once the write has run
+        const ggml_tensor * t = target.after != nullptr ? target.after : target.tensor;
+        if (nodes.count(t) == 0) {
+            t = root_of(t);
+        }
+        // a tensor outside the nodes is a graph input, set before compute
+        if (nodes.count(t) != 0) {
+            capture.stop_after.insert(t);
+        }
+    }
+}
+
+// The ids of an opened selection come from the node an auditor checks, and
+// the graph gathers rows with them. An id is a row of the scores the
+// selection ranks (ARGSORT and TOP_K rank along ne0), and of every tensor
+// the graph indexes with the selection or a view of it: the rows of
+// GET_ROWS, the matrices of MUL_MAT_ID, the rows of ADD_ID and SET_ROWS.
+// Called before the selections lose their operands.
+void bound_selections(skippy_receipt_capture & capture, ggml_cgraph * gf) {
+    for (auto & s : capture.substitutes) {
+        if (s.kind != SKIPPY_RECEIPT_TENSOR_SELECTION) {
+            continue;
+        }
+        const ggml_tensor * ids = root_of(s.node);
+        int64_t limit = s.node->src[0] != nullptr ? s.node->src[0]->ne[0] : 0;
+        for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+            const ggml_tensor * node = ggml_graph_node(gf, i);
+            const auto reads = [&](int operand) {
+                return node->src[operand] != nullptr && root_of(node->src[operand]) == ids;
+            };
+            if (node->op == GGML_OP_GET_ROWS && reads(1)) {
+                limit = std::min(limit, node->src[0]->ne[1]);
+            } else if (node->op == GGML_OP_MUL_MAT_ID && reads(2)) {
+                limit = std::min(limit, node->src[0]->ne[2]);
+            } else if (node->op == GGML_OP_ADD_ID && reads(2)) {
+                limit = std::min(limit, node->src[1]->ne[1]);
+            } else if (node->op == GGML_OP_SET_ROWS && reads(1) && node->src[2] != nullptr) {
+                limit = std::min(limit, node->src[2]->ne[1]);
+            }
+        }
+        s.id_limit = limit;
+    }
+}
+
+// A glue evaluation computes no substituted node; begin_compute writes the
+// opened value into it instead. Its inputs are dropped, so the weights it
+// read are never touched.
+//
+// The opened value is written before the graph runs, so it is allocated
+// with the graph inputs, before any node, and kept to the end: no other
+// tensor may use its memory. A scheduler can reuse the reserve graph's
+// allocation, so the reserve graph is substituted the same way.
+void substitute(skippy_receipt_capture & capture) {
+    for (const auto & s : capture.substitutes) {
+        // a substituted view (of a rotation product) holds its value in the
+        // product, which then computes nothing either
+        for (ggml_tensor * node : {s.node, s.node->view_src}) {
+            if (node == nullptr) {
+                continue;
+            }
+            node->op = GGML_OP_NONE;
+            for (auto & src : node->src) {
+                src = nullptr;
+            }
+            ggml_set_input(node);
+        }
+        keep_alive(s.node);
+    }
+}
+
+// Keeps where the graph's stored rows sit in the cache, for an attention
+// check that reads them once the graph is gone.
+void remember_cache_rows(skippy_receipt_capture & capture) {
+    capture.cache_rows.clear();
+    for (const auto & target : capture.targets) {
+        if (target.rows == nullptr) {
+            continue;
+        }
+        skippy_receipt_cache_rows rows;
+        rows.layer = target.layer;
+        rows.index = target.index;
+        rows.root = root_of(target.rows);
+        rows.offset = offset_in_root(target.rows);
+        rows.stride = target.rows->nb[1];
+        rows.type = target.rows->type;
+        rows.len = target.rows->ne[0];
+        capture.cache_rows.push_back(rows);
+    }
+}
+
+// Asks every matrix product of the graph to accumulate in f32.
+void force_f32_matmuls(ggml_cgraph * gf) {
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        if (node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) {
+            ggml_prec_set_acc(node, GGML_PREC_F32);
+        }
+    }
+}
+
+// Asks every attention op of the graph to accumulate in f32. A backend that
+// sums f16 values in f16 (the CPU kernel, for a ubatch smaller than a tile)
+// drifts from the exact output by percents over a long context, which the
+// attention check of a receipt would take for a cut context.
+void force_f32_attention(ggml_cgraph * gf) {
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        if (node->op == GGML_OP_FLASH_ATTN_EXT) {
+            ggml_prec_set_acc(node, GGML_PREC_F32);
+            ggml_flash_attn_ext_set_f32_value_sum(node, true);
+        }
+    }
+}
+
+void mark(skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens, int64_t n_seqs) {
+    if (capture.f32_matmuls) {
+        force_f32_matmuls(res.get_gf());
+    }
+    if (capture.f32_attention) {
+        force_f32_attention(res.get_gf());
+    }
+    capture.targets.clear();
+    capture.state_views.clear();
+    capture.substitutes.clear();
+    capture.anchor_nodes.clear();
+    capture.attention.clear();
+    capture.unchecked_weights.clear();
+    capture.input = nullptr;
+    capture.stop_after.clear();
+    // a new graph has new targets, which the device may be able to hash
+    capture.digest_refused = false;
+    capture.graph_error = find_targets(capture, res, n_tokens, n_seqs);
+    if (!capture.graph_error.empty()) {
+        capture.targets.clear();
+        capture.state_views.clear();
+        capture.substitutes.clear();
+        capture.anchor_nodes.clear();
+        capture.attention.clear();
+        capture.input = nullptr;
+        return;
+    }
+    if (capture.mode == skippy_receipt_mode::glue || capture.mode == skippy_receipt_mode::region) {
+        bound_selections(capture, res.get_gf());
+        substitute(capture);
+    }
+    if (capture.mode != skippy_receipt_mode::record) {
+        stop_after_targets(capture, res.get_gf());
+    }
+    if (capture.mode == skippy_receipt_mode::record) {
+        remember_cache_rows(capture);
+    }
+    for (const auto & target : capture.targets) {
+        // stored rows and left states are read from caches, which stay
+        if (target.rows == nullptr && target.after == nullptr) {
+            keep_alive(target.tensor);
+        }
+    }
+    if (capture.input != nullptr) {
+        keep_alive(capture.input);
+    }
+    // read when the attention ops are reported
+    for (const auto & op : capture.attention) {
+        if (op.output_rotation_input != nullptr) {
+            keep_alive(const_cast<ggml_tensor *>(op.output_rotation_input));
+        }
+    }
+}
+
+// The column of each anchor of the current step in `ubatch`, and the nodes
+// that get one.
+void find_anchor_columns(skippy_receipt_capture & capture, const llama_ubatch & ubatch) {
+    capture.anchor_columns.assign(capture.n_anchors, -1);
+    capture.anchored.clear();
+    if (capture.mode != skippy_receipt_mode::replay || !capture.graph_error.empty()) {
+        return;
+    }
+    for (size_t i = 0; i < capture.n_anchors; ++i) {
+        const auto & a = capture.anchors[i];
+        if (static_cast<int64_t>(a.step) != capture.step) {
+            continue;
+        }
+        for (uint32_t j = 0; j < ubatch.n_tokens; ++j) {
+            if (ubatch.pos[j] == a.pos && ubatch.seq_id[j][0] == a.seq) {
+                capture.anchor_columns[i] = j;
+            }
+        }
+        for (const auto & node : capture.anchor_nodes) {
+            if (capture.anchor_columns[i] >= 0 && node.layer == a.layer && node.kind == a.kind && node.index == a.index) {
+                capture.anchored.insert(node.node);
+            }
+        }
+    }
+}
+
+// Writes the anchors of a node the graph just computed into their columns.
+void write_anchors(skippy_receipt_capture & capture, const ggml_tensor * t) {
+    for (const auto & node : capture.anchor_nodes) {
+        if (node.node != t) {
+            continue;
+        }
+        auto * root = const_cast<ggml_tensor *>(root_of(t));
+        std::vector<uint8_t> buffer;
+        for (size_t i = 0; i < capture.n_anchors; ++i) {
+            const auto & a = capture.anchors[i];
+            const int64_t column = capture.anchor_columns[i];
+            if (column < 0 || a.layer != node.layer || a.kind != node.kind || a.index != node.index) {
+                continue;
+            }
+            if (t->type != GGML_TYPE_F32 || a.len != column_len(t, node.axis) || column >= columns_of(t, node.axis)) {
+                capture.compute_error = std::string("an anchor does not fit ") + t->name;
+                continue;
+            }
+            if (buffer.empty()) {
+                buffer.resize(ggml_nbytes(root));
+                ggml_backend_tensor_get(root, buffer.data(), 0, buffer.size());
+            }
+            for_each_element(t, node.axis, column, offset_in_root(t), [&](int64_t e, size_t offset) {
+                std::memcpy(buffer.data() + offset, a.values + e, sizeof(float));
+            });
+            ++capture.anchors_written;
+        }
+        if (!buffer.empty()) {
+            ggml_backend_tensor_set(root, buffer.data(), 0, buffer.size());
+        }
+    }
+}
+
+// The bytes of every substituted root, by root: a view's value lives in its
+// root, which is written once with the values of all its substituted views.
+using substitute_roots = std::map<ggml_tensor *, std::vector<uint8_t>>;
+
+ggml_tensor * substitute_root(const skippy_receipt_substitute & s) {
+    return s.node->view_src != nullptr ? s.node->view_src : s.node;
+}
+
+// The first id of `n` opened ids that is no row of what the selection
+// indexes, or null.
+const int32_t * id_out_of_range(const void * ids, size_t n, int64_t limit) {
+    const auto * id = static_cast<const int32_t *>(ids);
+    const auto * bad = std::find_if(id, id + n, [limit](int32_t v) { return v < 0 || v >= limit; });
+    return bad == id + n ? nullptr : bad;
+}
+
+// Copies the request's opened values into the bytes of the nodes they
+// replace. Returns an empty string, or why a value cannot be used; the
+// values come from the node an auditor checks, so nothing here trusts them.
+std::string fill_substitutes(const skippy_receipt_capture & capture, const skippy_receipt_glue_request & request,
+        substitute_roots & roots) {
+    const skippy_receipt_glue_value residual = {
+        SKIPPY_RECEIPT_TENSOR_RESIDUAL, 0, GGML_TYPE_F32, request.residual_len, request.residual};
+    for (size_t i = 0; i < request.n_values; ++i) {
+        const auto & v = request.values[i];
+        const bool used = std::any_of(capture.substitutes.begin(), capture.substitutes.end(),
+                [&](const skippy_receipt_substitute & s) { return s.kind == v.kind && s.index == v.index; });
+        if (!used) {
+            return "an opened value (kind " + std::to_string(v.kind) + ", index " + std::to_string(v.index) +
+                   ") matches nothing in the layer";
+        }
+    }
+    for (const auto & s : capture.substitutes) {
+        const skippy_receipt_glue_value * value = s.kind == SKIPPY_RECEIPT_TENSOR_RESIDUAL ? &residual : nullptr;
+        for (size_t i = 0; i < request.n_values && value == nullptr; ++i) {
+            if (request.values[i].kind == s.kind && request.values[i].index == s.index) {
+                value = &request.values[i];
+            }
+        }
+        const int64_t n_cols = columns_of(s.node, s.axis);
+        const int64_t len = column_len(s.node, s.axis);
+        const ggml_type type = reported_type(s.node->type);
+        std::vector<uint8_t> & buffer = roots.at(substitute_root(s));
+        if (value == nullptr && s.kind == SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT) {
+            // every mixing output is committed, so an opening always has it
+            return "no opened value for " + std::string(s.node->name);
+        }
+        if (value == nullptr || value->values == nullptr) {
+            // nothing was opened (a row the layer did not keep): zeros
+            continue;
+        }
+        // a state is one column: the state before the first position
+        const int64_t value_cols = s.kind == SKIPPY_RECEIPT_TENSOR_MIXING_STATE ? 1 : request.n_cols;
+        if (value->len != len || value->ggml_type != type || s.node->type != type || value_cols > n_cols) {
+            return "the opened value for " + std::string(s.node->name) + " has " + std::to_string(value->len) +
+                   " elements per column of type " + std::to_string(value->ggml_type) + ", the graph " +
+                   std::to_string(len) + " of type " + std::to_string(type);
+        }
+        if (s.kind == SKIPPY_RECEIPT_TENSOR_SELECTION) {
+            const auto n = static_cast<size_t>(value_cols * len);
+            if (const int32_t * bad = id_out_of_range(value->values, n, s.id_limit)) {
+                return "the opened selection for " + std::string(s.node->name) + " holds id " +
+                       std::to_string(*bad) + ", outside the " + std::to_string(s.id_limit) + " rows it selects from";
+            }
+        }
+        const auto * values = static_cast<const uint8_t *>(value->values);
+        for (int64_t j = 0; j < n_cols; ++j) {
+            // columns past the request repeat its first column
+            const uint8_t * column = values + static_cast<size_t>((j < value_cols ? j : 0) * len) * 4;
+            for_each_element(s.node, s.axis, j, offset_in_root(s.node), [&](int64_t e, size_t offset) {
+                std::memcpy(buffer.data() + offset, column + e * 4, 4);
+            });
+        }
+    }
+    return {};
+}
+
+}  // namespace
+
+bool skippy_receipt_mark_graph(skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens, int64_t n_seqs) {
+    mark(capture, res, n_tokens, n_seqs);
+    if (!capture.replan || !capture.graph_error.empty()) {
+        return false;
+    }
+    capture.replan = false;
+    return true;
+}
+
+void skippy_receipt_mark_reserve_graph(
+        skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens, int64_t n_seqs) {
+    skippy_receipt_capture reserve;
+    reserve.mode = capture.mode;
+    reserve.layers = capture.layers;
+    // what select_targets() reads, so the reserve marks the tensors the capture marks
+    reserve.committed_only = capture.committed_only;
+    reserve.n_vocab = capture.n_vocab;
+    reserve.f32_matmuls = capture.f32_matmuls;
+    reserve.f32_attention = capture.f32_attention;
+    mark(reserve, res, n_tokens, n_seqs);
+    capture.replan = !reserve.graph_error.empty();
+}
+
+void skippy_receipt_begin_compute(skippy_receipt_capture & capture, const llama_ubatch & ubatch) {
+    capture.stop_seen = 0;
+    capture.compute_error.clear();
+    find_anchor_columns(capture, ubatch);
+    const bool substitutes = capture.mode == skippy_receipt_mode::glue || capture.mode == skippy_receipt_mode::region;
+    if (!substitutes || capture.glue == nullptr || !capture.graph_error.empty()) {
+        return;
+    }
+    substitute_roots roots;
+    std::vector<ggml_tensor *> order;
+    for (const auto & s : capture.substitutes) {
+        ggml_tensor * root = substitute_root(s);
+        if (roots.try_emplace(root, ggml_nbytes(root), uint8_t{0}).second) {
+            order.push_back(root);
+        }
+    }
+    capture.compute_error = fill_substitutes(capture, *capture.glue, roots);
+    for (ggml_tensor * root : order) {
+        std::vector<uint8_t> & buffer = roots[root];
+        if (!capture.compute_error.empty()) {
+            // The graph still runs and the error is reported after it. A
+            // substituted node is an input no op computes, so it must not
+            // keep what its memory held: zeros are values and ids every op
+            // accepts.
+            std::fill(buffer.begin(), buffer.end(), uint8_t{0});
+        }
+        ggml_backend_tensor_set(root, buffer.data(), 0, buffer.size());
+    }
+}
+
+bool skippy_receipt_eval(ggml_tensor * t, bool ask, void * user_data) {
+    auto & capture = *static_cast<skippy_receipt_capture *>(user_data);
+    if (capture.stop_after.empty() && capture.anchored.empty()) {
+        // compute everything: no node is needed, and nothing stops
+        return !ask;
+    }
+    const bool done = !capture.stop_after.empty() && capture.stop_seen == capture.stop_after.size();
+    if (!ask) {
+        // called after a needed node: an anchored one, or the last reported
+        if (capture.anchored.count(t) != 0) {
+            write_anchors(capture, t);
+        }
+        return !done;
+    }
+    if (done) {
+        // a later split: compute one node and stop
+        return true;
+    }
+    capture.stop_seen += capture.stop_after.count(t);
+    const bool last = !capture.stop_after.empty() && capture.stop_seen == capture.stop_after.size();
+    return last || capture.anchored.count(t) != 0;
+}
+
+
+bool skippy_receipt_needs_f32_attention(const llama_model * model) {
+    // a Vulkan device reads the same request and would switch its attention
+    // pipeline, which no receipt was measured with
+    return !skippy_receipt_needs_f32_matmuls(model);
+}
+
+bool skippy_receipt_needs_f32_matmuls(const llama_model * model) {
+    return std::any_of(model->devices.begin(), model->devices.end(), [](const llama_device & device) {
+        ggml_backend_reg_t reg = device.dev == nullptr ? nullptr : ggml_backend_dev_backend_reg(device.dev);
+        return reg != nullptr && std::strcmp(ggml_backend_reg_name(reg), "Vulkan") == 0;
+    });
+}
diff --git a/src/skippy/receipts_internal.h b/src/skippy/receipts_internal.h
new file mode 100644
index 000000000..f52ce9f0e
--- /dev/null
+++ b/src/skippy/receipts_internal.h
@@ -0,0 +1,407 @@
+#pragma once
+
+#include "receipts_attention.h"
+#include "skippy/receipts.h"
+
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <set>
+#include <string>
+#include <vector>
+
+struct ggml_tensor;
+struct llama_ubatch;
+struct llama_memory_context_i;
+class llm_graph_result;
+struct skippy_receipt_scratch;
+struct skippy_receipt_transfer;
+
+enum class skippy_receipt_mode {
+    // serving: every layer's committed tensors
+    record,
+    // opening a challenge: also the weight matmuls of some layers
+    replay,
+    // auditing: one layer computed on opened values
+    glue,
+    // auditing: the residual entering layer 0, computed from tokens
+    entry,
+    // auditing: the recurrent token mixing of one layer computed on opened
+    // inputs and states
+    region,
+};
+
+struct skippy_receipt_target {
+    // the value as the graph holds it; for a stored row, the cache write
+    ggml_tensor * tensor = nullptr;
+    int32_t axis = 0;
+    int32_t layer = 0;
+    int32_t kind = 0;
+    int32_t index = 0;
+    int32_t flags = 0;
+    const char * name = "";
+    // a stored row: the cache rows, read at the ubatch's cells
+    const ggml_tensor * rows = nullptr;
+    // a state a region leaves: `tensor` is a view of the state's storage that
+    // the graph does not hold (skippy_receipt_capture::state_views), read
+    // once this node, which writes the state, has run
+    const ggml_tensor * after = nullptr;
+};
+
+// Where one layer's stored rows sit in the cache, which outlives the graph
+// that named them: row `cell` starts at `offset + cell * stride` in `root`.
+struct skippy_receipt_cache_rows {
+    int32_t layer = 0;
+    int32_t index = 0;
+    const ggml_tensor * root = nullptr;
+    size_t offset = 0;
+    size_t stride = 0;
+    ggml_type type = GGML_TYPE_F32;
+    int64_t len = 0;
+};
+
+// Where a reported tensor's values sit in a ubatch's host block, and how to
+// read them, kept apart from the graph: a ubatch delivered after the next
+// one's graph is built cannot look at its own graph's tensors.
+struct skippy_receipt_layout {
+    int32_t layer = 0;
+    int32_t kind = 0;
+    int32_t index = 0;
+    int32_t flags = 0;
+    std::string name;
+    // where the values start in the host block
+    size_t offset = 0;
+    // a stored row: one row of this type and length per token
+    bool stored_rows = false;
+    ggml_type rows_type = GGML_TYPE_F32;
+    int64_t rows_len = 0;
+    // a graph value: its shape (type, ne, nb), its offset in the fetched
+    // root, and the token axis
+    ggml_tensor shape = {};
+    size_t base = 0;
+    int32_t axis = 0;
+    // hashed on the device: `offset` is where its 32-byte column digests
+    // start in the host block, and the values are not copied
+    bool digested = false;
+};
+
+// One recorded ubatch, ready to report once its values reach the host.
+struct skippy_receipt_recorded {
+    int64_t step = -1;
+    uint32_t n_tokens = 0;
+    int64_t n_outputs = 0;
+    uint32_t n_kv = 0;
+    std::vector<int32_t> token;
+    std::vector<int32_t> seq;
+    std::vector<int32_t> pos;
+    std::vector<int8_t> output;
+    // each token's cell in its sequence's stream, and its row in the cache tensors
+    std::vector<uint32_t> cell;
+    std::vector<uint32_t> row;
+    std::vector<skippy_receipt_layout> tensors;
+    bool has_input = false;
+    size_t input_offset = 0;
+    int64_t input_row_bytes = 0;
+    int32_t input_type = 0;
+    std::vector<std::string> unchecked_weights;
+    // the host copy that holds the values, and the staging buffer they were
+    // copied through (-1: copied synchronously)
+    int slot = 0;
+    int staging = -1;
+    // asynchronous copies: the copy's place in the copy thread's queue
+    uint64_t ticket = 0;
+    // the copy thread has put the values that need it in column order, in
+    // the host copy's converted buffers
+    bool columns_ready = false;
+    uint8_t * block = nullptr;
+    // the block is pinned memory, which a device may copy into asynchronously
+    bool pinned = false;
+
+    // Empties a reported ubatch for the next one, keeping the memory of its
+    // vectors and of its tensors' names.
+    void reuse() {
+        skippy_receipt_recorded next;
+        next.token = std::move(token);
+        next.seq = std::move(seq);
+        next.pos = std::move(pos);
+        next.output = std::move(output);
+        next.cell = std::move(cell);
+        next.row = std::move(row);
+        next.tensors = std::move(tensors);
+        next.unchecked_weights = std::move(unchecked_weights);
+        *this = std::move(next);
+    }
+};
+
+// A contiguous range of a tensor's bytes, and where it goes in the host block.
+struct skippy_receipt_value_copy {
+    const ggml_tensor * src = nullptr;
+    size_t src_offset = 0;
+    size_t size = 0;
+    size_t dst_offset = 0;
+};
+
+// A node a glue evaluation sets to an opened value instead of computing.
+struct skippy_receipt_substitute {
+    ggml_tensor * node = nullptr;
+    int32_t axis = 0;
+    int32_t kind = 0;
+    int32_t index = 0;
+    int32_t layer = 0;
+    // a selection: its ids index the scores it ranks and the tensors the
+    // graph gathers with them, so every opened id must be below this
+    int64_t id_limit = 0;
+};
+
+// Receipt state of one llama_context: the serving recorder, a replay, or a
+// glue evaluation.
+struct skippy_receipt_capture {
+    skippy_receipt_ubatch_fn on_ubatch = nullptr;
+    void * user_data = nullptr;
+    skippy_receipt_mode mode = skippy_receipt_mode::record;
+    // replay: the layers, sorted; glue: the one layer
+    std::vector<int32_t> layers;
+    // replay: report only the committed tensors and the logits, which the
+    // recorder marks too, so the graph fuses ops as it did when serving
+    bool committed_only = false;
+    // replay: committed values written into the columns of anchored tokens,
+    // the nodes they replace in the current graph, and, for the ubatch being
+    // computed, the column of each anchor (-1 for another step), the nodes
+    // that get one, and how many anchors the replay has written
+    const skippy_receipt_anchor * anchors = nullptr;
+    size_t n_anchors = 0;
+    std::vector<skippy_receipt_substitute> anchor_nodes;
+    std::vector<int64_t> anchor_columns;
+    std::set<const ggml_tensor *> anchored;
+    size_t anchors_written = 0;
+    // replay: the current step, and whether to report it
+    int64_t step = -1;
+    bool report = true;
+    // replay: the vocabulary size, by which a final stage's logits are known
+    int64_t n_vocab = 0;
+    // replay and glue: every layer's attention window, and the attention ops
+    // of the reported layers in the current graph
+    std::vector<skippy_receipt_attention_window> windows;
+    std::vector<skippy_receipt_attention_op> attention;
+    // record: the stored rows of every layer the last graph named, by
+    // layer and index
+    std::vector<skippy_receipt_cache_rows> cache_rows;
+    // glue: the opened values, during an evaluation
+    const skippy_receipt_glue_request * glue = nullptr;
+
+    // targets of the current graph; graph_error is set when it has none
+    std::vector<skippy_receipt_target> targets;
+    // region: the states the current graph leaves, as views of their storage
+    // that targets point to; a deque, so they stay where they are
+    std::deque<ggml_tensor> state_views;
+    std::vector<skippy_receipt_substitute> substitutes;
+    std::vector<std::string> unchecked_weights;
+    ggml_tensor * input = nullptr;
+    std::string graph_error;
+    // the reserve graph had no receipt tensors to mark
+    bool replan = false;
+    // set by a glue evaluation that cannot use its opened values
+    std::string compute_error;
+    // record and replay: every matrix product accumulates in f32. Vulkan
+    // accumulates quantized products in f16 by default, which leaves honest
+    // outputs further from the reference than the audit allows.
+    bool f32_matmuls = false;
+    // attention ops are asked to accumulate in f32 (see force_f32_attention)
+    bool f32_attention = false;
+    // replay and glue: the nodes that compute the reported tensors. The
+    // graph stops once all of them have run, since later layers are not
+    // needed.
+    std::set<const ggml_tensor *> stop_after;
+    size_t stop_seen = 0;
+
+    // per-ubatch host copies: one block for every fetched tensor and the
+    // stage input, pinned when the backend has pinned host memory. Ubatches
+    // take turns, so a ubatch's values outlive the next ubatch's callback,
+    // and two ubatches can be on their way while a third is reported.
+    struct buffer_deleter {
+        void operator()(ggml_backend_buffer_t buffer) const { ggml_backend_buffer_free(buffer); }
+    };
+    struct host_copy {
+        std::unique_ptr<ggml_backend_buffer, buffer_deleter> pinned;
+        std::vector<uint8_t> pageable;
+        // values that are not already contiguous f32 or i32 columns
+        std::vector<std::vector<uint8_t>> converted;
+    };
+    static constexpr int HOST_COPIES = 3;
+    host_copy copies[HOST_COPIES];
+    int next_copy = 0;
+
+    // record: ubatches whose values are still on their way to the host,
+    // oldest first. A ubatch is reported two ubatches later, when its host
+    // copy is normally done, or before a memory event or a flush, so reports
+    // keep their order.
+    // The mutex orders the decoding thread's reports and a flush from another
+    // thread.
+    static constexpr size_t MAX_PENDING = 2;
+    std::mutex delivery;
+    std::vector<skippy_receipt_recorded> pending;
+    // The device copies of a deferred ubatch. Declared after the host copies
+    // so it is destroyed first: it waits for copies into them in flight.
+    struct transfer_deleter {
+        void operator()(skippy_receipt_transfer * transfer) const;
+    };
+    std::unique_ptr<skippy_receipt_transfer, transfer_deleter> transfer;
+    // the device cannot copy asynchronously: record synchronously
+    bool transfer_unsupported = false;
+    // the device cannot hash receipt values: copy them
+    bool digest_unsupported = false;
+    // The device cannot hash the targets of the current graph (one is on
+    // another device, or laid out so the device cannot read it as its
+    // reported bytes): every ubatch of the graph copies its values, without
+    // planning the digests again. A new graph is planned again.
+    bool digest_refused = false;
+
+    // Buffers of the readback, kept for their capacity. A ubatch is described
+    // and reported under `delivery`, one at a time.
+    struct readback_buffers {
+        // the ubatch being described: the copies that read its values, the
+        // distinct roots they fetch, and each root's place in the host block
+        std::vector<skippy_receipt_value_copy> copies;
+        std::vector<const ggml_tensor *> roots;
+        std::vector<size_t> slots;
+        std::vector<size_t> offsets;
+        // the ubatch being reported
+        std::vector<skippy_receipt_tensor> tensors;
+        std::vector<const char *> unchecked;
+        // reported ubatches, for the next ones to reuse
+        std::vector<skippy_receipt_recorded> spare;
+    };
+    readback_buffers readback;
+
+    // record, for a model with recurrent memory: the state observer, and
+    // the sequences whose current turn has reported its state. The mutex
+    // lets another thread start a sequence's next turn.
+    skippy_receipt_state_fn on_state = nullptr;
+    void * state_user_data = nullptr;
+    std::mutex state_mutex;
+    std::set<int32_t> state_reported;
+};
+
+// The scratch context a model replays receipts in; created empty with the model.
+std::shared_ptr<skippy_receipt_scratch> skippy_receipt_new_scratch();
+
+// Section `section` of the positions of a text token at position `p`. A
+// model with several positions per token (M-RoPE) gives a text token the
+// sections [p, p, p, 0], as llama_batch_allocr does. Receipts follow text
+// tokens only: a recorder keeps one position per token, and a replay or an
+// evaluation rebuilds the others with this.
+inline int32_t skippy_receipt_position_section(int32_t p, uint32_t section) {
+    return section < 3 ? p : 0;
+}
+
+// The positions of `n` text tokens for a decode in a context of `model`:
+// every section of every token, section after section. A decode with an
+// imported activation reads all of them; a decode of tokens alone reads the
+// first section and expands it itself.
+std::vector<int32_t> skippy_receipt_batch_positions(const llama_model * model, const int32_t * pos, size_t n);
+
+// The activation a stage after the first imports, as its loaded graph
+// declared it: one row per token of `width` elements of `type`. False for a
+// first stage, and for a stage that imports anything else. A replay step and
+// a glue evaluation set that import from rows the caller gives, and the
+// graph asserts on rows of another shape.
+bool skippy_receipt_stage_input(const skippy_model & model, ggml_type & type, int64_t & width);
+
+// Finds the receipt tensors of a freshly built graph and marks them as
+// outputs. A glue evaluation also turns the nodes it substitutes into inputs.
+// Returns true when the scheduler must plan its allocation again for this
+// graph: the reserve graph had no receipt tensors to mark, so the plan the
+// scheduler reuses lets later nodes overwrite them.
+bool skippy_receipt_mark_graph(skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens, int64_t n_seqs);
+
+// Whether a model runs on a backend whose matrix products receipts must
+// force to accumulate in f32 (Vulkan).
+bool skippy_receipt_needs_f32_matmuls(const llama_model * model);
+// Whether a recorder on `model` asks its attention ops for f32 accumulation.
+bool skippy_receipt_needs_f32_attention(const llama_model * model);
+
+// Marks the receipt tensors of a reserve graph as outputs, so the scheduler's
+// planned allocation keeps them alive. The capture's current targets are kept.
+// When the reserve graph has none (a hybrid model's reserve ubatch spreads its
+// tokens over several sequences), the next marked graph plans again.
+void skippy_receipt_mark_reserve_graph(skippy_receipt_capture & capture, llm_graph_result & res, int64_t n_tokens, int64_t n_seqs);
+
+// Before a graph is computed: resets the early stop, writes a glue
+// evaluation's opened values into the nodes it substitutes, and finds the
+// columns of an anchored replay's anchors in `ubatch`.
+void skippy_receipt_begin_compute(skippy_receipt_capture & capture, const llama_ubatch & ubatch);
+
+// The scheduler's eval callback of a replay or glue context: writes an
+// anchored replay's anchors into the nodes they replace, and stops the graph
+// once the reported tensors are computed. user_data is the capture.
+bool skippy_receipt_eval(ggml_tensor * t, bool ask, void * user_data);
+
+// The device digests of one ubatch's receipt values: one 8-word descriptor
+// per hashed target (see ggml-cuda/receipt-digest.cuh), and per capture
+// target where its column digests start, counted in digests, or ON_HOST for a
+// value in host memory, which is copied instead.
+//
+// The device reads `descs`, `cells` and `bases` from this host memory when
+// its stream reaches the digests, which can be after the digest function
+// returns. The plan a digest function was called with therefore stays alive
+// and unchanged until the stream has run the digests.
+struct skippy_receipt_digest_plan {
+    static constexpr uint64_t ON_HOST = UINT64_MAX;
+    std::vector<uint64_t> descs;
+    std::vector<uint64_t> first;
+    std::vector<uint32_t> cells;
+    // scratch of the digest function: 2 * (descriptors + 1) words
+    std::vector<uint64_t> bases;
+    uint64_t n_digests = 0;
+};
+
+using skippy_receipt_digest_fn = bool (*)(ggml_backend_t backend, const uint64_t * descs, int n_descs,
+        const uint32_t * cells, int n_cells, uint64_t * bases, void * out);
+
+// The backend's receipt digest function, or null when its device cannot hash.
+skippy_receipt_digest_fn skippy_receipt_digest_proc(ggml_backend_t backend);
+
+// Plans the digests of the capture's targets computed on `compute`, whose
+// stored rows are rows `cells` of the cache tensors (stream * size + cell).
+// False when a target is on another device or laid out so the device cannot
+// read it as its reported bytes, or when nothing is on the device.
+bool skippy_receipt_plan_digests(const skippy_receipt_capture & capture, ggml_backend_t compute,
+        const std::vector<uint32_t> & cells, skippy_receipt_digest_plan & plan);
+
+// Reports the deferred ubatches, if there are any.
+void skippy_receipt_flush(skippy_receipt_capture & capture);
+
+// Reads the receipt tensors of a computed ubatch and reports them.
+void skippy_receipt_report_ubatch(
+        skippy_receipt_capture & capture,
+        ggml_backend_sched_t sched,
+        const llama_ubatch & ubatch,
+        llama_memory_context_i * mctx,
+        const llm_graph_result & res);
+
+struct llama_batch_ext;
+struct llama_context;
+
+// Before a batch is split into ubatches: reports the recurrent state of
+// every sequence of `batch` whose turn starts with it.
+void skippy_receipt_begin_batch(skippy_receipt_capture & capture, llama_context & ctx, const llama_batch_ext & batch);
+
+// A memory event of the stage context: the sequences it replaces or
+// removes whole start a new turn.
+void skippy_receipt_state_event(skippy_receipt_capture & capture, const skippy_receipt_memory_event & event);
+
+class llama_kv_cache;
+class llama_kv_cache_context;
+
+// The plain KV cache of a context's memory: the memory itself, or the
+// attention cache of hybrid memory. nullptr for any other memory.
+llama_kv_cache * skippy_receipt_attention_cache(llama_context * ctx);
+const llama_kv_cache_context * skippy_receipt_attention_context(const llama_memory_context_i * mctx);
+
+// Imports a state the recorder reported into `seq` of a context with
