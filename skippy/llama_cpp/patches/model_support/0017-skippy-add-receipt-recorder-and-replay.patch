+#include "llama-model.h"
+
+#include <algorithm>
+#include <cstring>
+#include <iterator>
+#include <unordered_set>
+
+using skippy_receipt_values::root_of;
+
+namespace {
+
+using constant_set = std::unordered_set<const ggml_tensor *>;
+
+// The cache tensor a K or V operand reads, through views and type casts.
+const ggml_tensor * cache_source(const ggml_tensor * t) {
+    while (t != nullptr && t->view_src == nullptr && (t->op == GGML_OP_CPY || t->op == GGML_OP_CONT)) {
+        t = t->src[0];
+    }
+    return t == nullptr ? nullptr : root_of(t);
+}
+
+int32_t store_reading(const skippy_receipt_layer_plan & plan, const ggml_tensor * operand) {
+    const ggml_tensor * source = cache_source(operand);
+    for (size_t i = 0; i < plan.stores.size(); ++i) {
+        if (source != nullptr && root_of(plan.stores[i].rows) == source) {
+            return static_cast<int32_t>(i);
+        }
+    }
+    return -1;
+}
+
+template <typename F>
+int32_t index_where(const std::vector<skippy_receipt_value> & values, F && matches) {
+    for (size_t i = 0; i < values.size(); ++i) {
+        if (matches(values[i].tensor)) {
+            return static_cast<int32_t>(i);
+        }
+    }
+    return -1;
+}
+
+// The one node of `gf` that reads `t`, or null when none or several do.
+const ggml_tensor * only_reader(ggml_cgraph * gf, const ggml_tensor * t) {
+    const ggml_tensor * found = nullptr;
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        const ggml_tensor * node = ggml_graph_node(gf, i);
+        if (std::find(std::begin(node->src), std::end(node->src), t) == std::end(node->src)) {
+            continue;
+        }
+        if (found != nullptr) {
+            return nullptr;
+        }
+        found = node;
+    }
+    return found;
+}
+
+// A node that holds `src`'s values in the same order.
+bool keeps_order(const ggml_tensor * node, const ggml_tensor * src) {
+    if (node->src[0] != src || ggml_nelements(node) != ggml_nelements(src) || !ggml_is_contiguous(src)) {
+        return false;
+    }
+    return node->op == GGML_OP_RESHAPE || node->op == GGML_OP_CONT ||
+           (node->op == GGML_OP_VIEW && node->view_offs == 0 && ggml_is_contiguous(node));
+}
+
+// A rotation of `rows`, a flattened output whose rows of n values each lie
+// in one head, by a square matrix that is one of the context's constants
+// (skippy_receipt_graph_facts::constant_inputs).
+bool is_rotation(const ggml_tensor * product, const ggml_tensor * rows, int64_t head_dim, const constant_set & constants) {
+    const ggml_tensor * rotation = product->src[0];
+    const int64_t n = rotation->ne[0];
+    return product->op == GGML_OP_MUL_MAT && product->src[1] == rows && rotation->op == GGML_OP_NONE &&
+           constants.count(rotation) != 0 && rotation->type == GGML_TYPE_F32 &&
+           rotation->ne[1] == n && ggml_nelements(rotation) == n * n && rows->ne[0] == n && head_dim % n == 0;
+}
+
+// Follows the op's output to the mixing output it becomes: through layout
+// changes, a rotation in chunks, and then a gate among the mixing inputs.
+void follow_output(ggml_cgraph * gf, const ggml_tensor * node, const skippy_receipt_layer_plan & plan,
+        const constant_set & constants, skippy_receipt_attention_op & op) {
+    const ggml_tensor * t = node;
+    for (int step = 0; step < 8; ++step) {
+        op.output = index_where(plan.mixing_outputs, [&](const ggml_tensor * x) { return x == t; });
+        const ggml_tensor * next = op.output < 0 ? only_reader(gf, t) : nullptr;
+        if (next == nullptr) {
+            return;
+        }
+        if (keeps_order(next, t)) {
+            t = next;
+        } else if (op.output_gate < 0 && op.output_rotation_input == nullptr && is_rotation(next, t, op.head_dim_v, constants)) {
+            op.output_rotation_input = next->src[0];
+            op.output_rotation_n = static_cast<int32_t>(next->src[0]->ne[0]);
+            t = next;
+        } else if (op.output_gate < 0 && next->op == GGML_OP_MUL && ggml_are_same_shape(next->src[0], next->src[1])) {
+            const ggml_tensor * gate = next->src[0] == t ? next->src[1] : next->src[0];
+            op.output_gate = index_where(plan.mixing_inputs, [&](const ggml_tensor * x) { return x == gate; });
+            if (op.output_gate < 0 || gate == t) {
+                return;
+            }
+            t = next;
+        } else {
+            return;
+        }
+    }
+    op.output = -1;
+}
+
+skippy_receipt_attention_op describe(ggml_cgraph * gf, const ggml_tensor * node, const skippy_receipt_layer_plan & plan,
+        const skippy_receipt_attention_window & window, const constant_set & constants) {
+    skippy_receipt_attention_op op;
+    op.layer = plan.layer;
+    const ggml_tensor * q = node->src[0];
+    const ggml_tensor * k = node->src[1];
+    const ggml_tensor * v = node->src[2];
+    op.q_input = index_where(plan.mixing_inputs, [&](const ggml_tensor * t) { return t == q; });
+    op.k_store = store_reading(plan, k);
+    op.v_store = store_reading(plan, v);
+    // q is [head, tokens, heads], K and V [head, cells, kv heads]
+    op.head_dim_k = static_cast<int32_t>(q->ne[0]);
+    op.n_head = static_cast<int32_t>(q->ne[2]);
+    op.n_head_kv = static_cast<int32_t>(k->ne[2]);
+    op.head_dim_v = static_cast<int32_t>(v->ne[0]);
+    follow_output(gf, node, plan, constants, op);
+    // the kernels round q to 8-bit blocks for their dot with quantized K
+    op.q_rounding = ggml_is_quantized(k->type) ? GGML_TYPE_Q8_0 : -1;
+    float params[3];
+    std::memcpy(params, node->op_params, sizeof(params));
+    op.scale = params[0];
+    op.softcap = params[2];
+    op.window = window;
+    if (op.k_store < 0 || op.v_store < 0 || op.k_store == op.v_store) {
+        op.error = "attention reads K or V rows the layer does not store";
+    } else if (op.output < 0) {
+        op.error = "the attention output passes through other ops before it leaves the token-mixing region";
+    } else if (params[1] != 0.0f) {
+        op.error = "attention with positional biases (ALiBi)";
+    } else if (window.kind < 0) {
+        op.error = "an attention mask the check cannot follow";
+    } else if (k->ne[0] != q->ne[0] || op.n_head_kv <= 0 || op.n_head % op.n_head_kv != 0 || q->ne[3] != 1) {
+        op.error = "an attention shape the check cannot follow";
+    }
+    const ggml_tensor * sinks = node->src[4];
+    if (op.error.empty() && sinks != nullptr) {
+        if (sinks->type != GGML_TYPE_F32 || ggml_nelements(sinks) != op.n_head) {
+            op.error = "attention sinks the check cannot read";
+        } else {
+            op.sinks.resize(static_cast<size_t>(op.n_head));
+            ggml_backend_tensor_get(sinks, op.sinks.data(), 0, op.sinks.size() * sizeof(float));
+        }
+    }
+    return op;
+}
+
+}  // namespace
+
+std::vector<skippy_receipt_attention_window> skippy_receipt_attention_windows(const llama_model * model, bool causal) {
+    const llama_hparams & hparams = model->hparams;
+    std::vector<skippy_receipt_attention_window> windows(hparams.n_layer());
+    for (uint32_t il = 0; il < hparams.n_layer(); ++il) {
+        auto & window = windows[il];
+        if (!causal) {
+            window.kind = -1;
+        } else if (hparams.is_swa(il)) {
+            window.size = static_cast<int32_t>(hparams.n_swa);
+            switch (hparams.swa_type) {
+                case LLAMA_SWA_TYPE_STANDARD:
+                    window.kind = SKIPPY_RECEIPT_ATTENTION_SLIDING;
+                    break;
+                case LLAMA_SWA_TYPE_CHUNKED:
+                    window.kind = SKIPPY_RECEIPT_ATTENTION_CHUNKED;
+                    break;
+                default:
+                    window.kind = -1;
+                    break;
+            }
+        } else {
+            window.kind = SKIPPY_RECEIPT_ATTENTION_CAUSAL;
+        }
+    }
+    return windows;
+}
+
+std::vector<skippy_receipt_attention_op> skippy_receipt_describe_attention(
+        ggml_cgraph * gf,
+        const skippy_receipt_layer_plan & plan,
+        const skippy_receipt_attention_window & window,
+        const std::unordered_set<const ggml_tensor *> & constants) {
+    std::vector<skippy_receipt_attention_op> ops;
+    for (int i = 0; i < ggml_graph_n_nodes(gf); ++i) {
+        const ggml_tensor * node = ggml_graph_node(gf, i);
+        if (node->op != GGML_OP_FLASH_ATTN_EXT) {
+            continue;
+        }
+        const bool in_layer = index_where(plan.mixing_inputs, [&](const ggml_tensor * t) { return t == node->src[0]; }) >= 0;
+        if (in_layer) {
+            ops.push_back(describe(gf, node, plan, window, constants));
+        }
+    }
+    return ops;
+}
diff --git a/src/skippy/receipts_attention.h b/src/skippy/receipts_attention.h
new file mode 100644
index 000000000..d55842022
--- /dev/null
+++ b/src/skippy/receipts_attention.h
@@ -0,0 +1,70 @@
+#pragma once
+
+// The attention ops of a classified layer, for the loose attention check
+// (mesh/docs/design/RECEIPTS.md, Verification, step 5): which committed
+// values are q, K, V and the output, and how the op combines them. An op is
+// described from its FLASH_ATTN_EXT node and the attention window the
+// model's hyperparameters give the layer. No architecture is consulted.
+
+#include "receipts_layers.h"
+
+#include <cstdint>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+struct ggml_cgraph;
+struct ggml_tensor;
+struct llama_model;
+
+// Which positions a layer's queries attend to: a
+// skippy_receipt_attention_window_kind and its size, or a negative kind for
+// a mask the check cannot follow.
+struct skippy_receipt_attention_window {
+    int32_t kind = 0;
+    int32_t size = 0;
+};
+
+struct skippy_receipt_attention_op {
+    int32_t layer = -1;
+    // indices among the layer's mixing inputs, stores and mixing outputs
+    int32_t q_input = -1;
+    int32_t k_store = -1;
+    int32_t v_store = -1;
+    int32_t output = -1;
+    int32_t n_head = 0;
+    int32_t n_head_kv = 0;
+    int32_t head_dim_k = 0;
+    int32_t head_dim_v = 0;
+    float scale = 0.0f;
+    float softcap = 0.0f;
+    skippy_receipt_attention_window window;
+    // per query head, or empty
+    std::vector<float> sinks;
+    // a gate among the mixing inputs that multiplies the output, or -1
+    int32_t output_gate = -1;
+    // a rotation of the output in chunks of output_rotation_n values, row
+    // after row; empty for none
+    int32_t output_rotation_n = 0;
+    std::vector<float> output_rotation;
+    // the constant of the context that holds the rotation, read after the graph ran
+    const ggml_tensor * output_rotation_input = nullptr;
+    // a ggml type q is rounded to before its dot with K, or -1
+    int32_t q_rounding = -1;
+    // why the check cannot follow the op; empty when it can
+    std::string error;
+};
+
+// Every layer's attention window, by layer, from the model's
+// hyperparameters. `causal` is the context's causal attention.
+std::vector<skippy_receipt_attention_window> skippy_receipt_attention_windows(const llama_model * model, bool causal);
+
+// The attention ops whose q is one of the plan's token-mixing inputs.
+// `constants` are the context's constants the graph reads
+// (skippy_receipt_graph_facts::constant_inputs): a rotation of the output is
+// a product with one of them.
+std::vector<skippy_receipt_attention_op> skippy_receipt_describe_attention(
+        ggml_cgraph * gf,
+        const skippy_receipt_layer_plan & plan,
+        const skippy_receipt_attention_window & window,
+        const std::unordered_set<const ggml_tensor *> & constants);
diff --git a/src/skippy/receipts_digest.cpp b/src/skippy/receipts_digest.cpp
new file mode 100644
index 000000000..88852b621
--- /dev/null
+++ b/src/skippy/receipts_digest.cpp
@@ -0,0 +1,149 @@
+// Digests of a ubatch's receipt values, computed on the device that holds
+// them. A recorder that copies 32 bytes per value instead of the value moves
+// about a thousandth of the bytes over the host link.
+//
+// The device's backend exports "ggml_backend_receipt_digest" (the CUDA
+// backend does). Each value column becomes one message, in the order the
+// readback would report its bytes: f32 or i32 elements, i0 fastest, skipping
+// the token axis; f16 and bf16 elements become f32 on the device; a stored row
+// is its cache row as stored. A value the device cannot read that way, or one
+// on another device, makes the ubatch fall back to copying its values. Values
+// in host memory are copied as they are.
+
+#include "receipts_internal.h"
+#include "receipts_values.h"
+
+#include "ggml-backend.h"
+
+using namespace skippy_receipt_values;
+
+namespace {
+
+constexpr uint64_t DIGEST_RAW = 0;
+constexpr uint64_t DIGEST_F16 = 1;
+constexpr uint64_t DIGEST_BF16 = 2;
+constexpr uint64_t DIGEST_CELLS = 1u << 8;
+constexpr uint64_t DIGEST_UNSIGNED_ZERO = 1u << 9;
+
+// The tensor's memory is host memory, such as the token embeddings or a
+// stage's imported activations; the recorder copies those values.
+bool on_host(const ggml_tensor * t) {
+    ggml_backend_buffer_t buffer = root_of(t)->buffer;
+    return buffer != nullptr && t->data != nullptr && ggml_backend_buffer_is_host(buffer);
+}
+
+// The tensor's memory is on `dev`, not on the host.
+bool on_device(const ggml_tensor * t, ggml_backend_dev_t dev) {
+    ggml_backend_buffer_t buffer = root_of(t)->buffer;
+    if (buffer == nullptr || t->data == nullptr || ggml_backend_buffer_is_host(buffer)) {
+        return false;
+    }
+    return ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buffer)) == dev;
+}
+
+// The descriptor of a graph value's columns, or false when its columns are
+// not a uniform run of rows of dimension 0.
+bool value_desc(const ggml_tensor * t, int32_t axis, uint64_t desc[8]) {
+    uint64_t conversion = 0;
+    switch (t->type) {
+        case GGML_TYPE_F32:
+        case GGML_TYPE_I32:
+            conversion = DIGEST_RAW;
+            break;
+        case GGML_TYPE_F16:
+            conversion = DIGEST_F16;
+            break;
+        case GGML_TYPE_BF16:
+            conversion = DIGEST_BF16;
+            break;
+        default:
+            return false;
+    }
+    if (axis == 0 || t->nb[0] != ggml_type_size(t->type)) {
+        return false;
+    }
+    const uint64_t seg_bytes = static_cast<uint64_t>(t->ne[0]) * t->nb[0];
+    // the other dimensions of a column must step through rows evenly
+    uint64_t n_segs = 1;
+    uint64_t seg_stride = seg_bytes;
+    bool first = true;
+    for (int d = 1; d < GGML_MAX_DIMS; ++d) {
+        if ((tracked(axis) && d == axis) || t->ne[d] == 1) {
+            continue;
+        }
+        if (first) {
+            seg_stride = t->nb[d];
+            first = false;
+        } else if (t->nb[d] != seg_stride * n_segs) {
+            return false;
+        }
+        n_segs *= static_cast<uint64_t>(t->ne[d]);
+    }
+    desc[0] = reinterpret_cast<uint64_t>(t->data);
+    desc[1] = seg_bytes;
+    desc[2] = seg_stride;
+    desc[3] = n_segs;
+    desc[4] = tracked(axis) ? t->nb[axis] : 0;
+    desc[5] = static_cast<uint64_t>(columns_of(t, axis));
+    desc[6] = conversion;
+    desc[7] = 0;
+    return true;
+}
+
+// The descriptor of the stored rows at the ubatch's cells.
+void rows_desc(const ggml_tensor * rows, size_t n_tokens, uint64_t desc[8]) {
+    desc[0] = reinterpret_cast<uint64_t>(rows->data);
+    desc[1] = ggml_row_size(rows->type, rows->ne[0]);
+    desc[2] = desc[1];
+    desc[3] = 1;
+    desc[4] = rows->nb[1];
+    desc[5] = n_tokens;
+    desc[6] = DIGEST_RAW | DIGEST_CELLS;
+    desc[7] = 0;
+}
+
+}  // namespace
+
+skippy_receipt_digest_fn skippy_receipt_digest_proc(ggml_backend_t backend) {
+    ggml_backend_dev_t dev = backend != nullptr ? ggml_backend_get_device(backend) : nullptr;
+    ggml_backend_reg_t reg = dev != nullptr ? ggml_backend_dev_backend_reg(dev) : nullptr;
+    if (reg == nullptr) {
+        return nullptr;
+    }
+    return reinterpret_cast<skippy_receipt_digest_fn>(
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_receipt_digest"));
+}
+
+bool skippy_receipt_plan_digests(const skippy_receipt_capture & capture, ggml_backend_t compute,
+        const std::vector<uint32_t> & cells, skippy_receipt_digest_plan & plan) {
+    ggml_backend_dev_t dev = ggml_backend_get_device(compute);
+    if (dev == nullptr) {
+        return false;
+    }
+    plan.descs.clear();
+    plan.first.assign(capture.targets.size(), skippy_receipt_digest_plan::ON_HOST);
+    plan.cells = cells;
+    plan.n_digests = 0;
+    for (size_t i = 0; i < capture.targets.size(); ++i) {
+        const auto & target = capture.targets[i];
+        uint64_t desc[8] = {};
+        if (target.rows != nullptr) {
+            if (!on_device(target.rows, dev)) {
+                return false;
+            }
+            rows_desc(target.rows, cells.size(), desc);
+        } else if (on_host(target.tensor)) {
+            continue;
+        } else if (!on_device(target.tensor, dev) || !value_desc(target.tensor, target.axis, desc)) {
+            return false;
+        }
+        if (unsigned_zeros(target.kind)) {
+            desc[6] |= DIGEST_UNSIGNED_ZERO;
+        }
+        plan.descs.insert(plan.descs.end(), desc, desc + 8);
+        plan.first[i] = plan.n_digests;
+        plan.n_digests += desc[5];
+    }
+    plan.bases.assign(2 * (plan.descs.size() / 8 + 1), 0);
+    return !plan.descs.empty();
+}
diff --git a/src/skippy/receipts_draw.cpp b/src/skippy/receipts_draw.cpp
new file mode 100644
index 000000000..44aaed8bf
--- /dev/null
+++ b/src/skippy/receipts_draw.cpp
@@ -0,0 +1,172 @@
+// The replayable draw of a sampled turn that gets a receipt.
+
+#include "receipts_draw.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <numeric>
+#include <vector>
+
+namespace {
+
+// Up to this many candidates are ordered by a sort; more by a table over
+// the token ids, which costs the same whatever order they arrive in.
+constexpr size_t SORTED_MAX = 4096;
+
+struct draw_state {
+    uint32_t seed = 0;
+    uint64_t index = 0;
+};
+
+const char * draw_name(const llama_sampler *) {
+    return "skippy-indexed-draw";
+}
+
+void draw_apply(llama_sampler * smpl, llama_token_data_array * cur_p) {
+    const auto * state = static_cast<const draw_state *>(smpl->ctx);
+    if (cur_p->size == 0) {
+        cur_p->selected = -1;
+        return;
+    }
+    const double u = skippy_receipt_draw_uniform(state->seed, state->index);
+    cur_p->selected = static_cast<int64_t>(skippy_receipt_draw_pick(cur_p->data, cur_p->size, u));
+}
+
+void draw_reset(llama_sampler * smpl) {
+    static_cast<draw_state *>(smpl->ctx)->index = 0;
+}
+
+llama_sampler * draw_clone(const llama_sampler * smpl);
+
+void draw_free(llama_sampler * smpl) {
+    delete static_cast<draw_state *>(smpl->ctx);
+}
+
+llama_sampler_i draw_iface = {
+    /* .name              = */ draw_name,
+    /* .accept            = */ nullptr,
+    /* .apply             = */ draw_apply,
+    /* .reset             = */ draw_reset,
+    /* .clone             = */ draw_clone,
+    /* .free              = */ draw_free,
+    /* .backend_init      = */ nullptr,
+    /* .backend_accept    = */ nullptr,
+    /* .backend_apply     = */ nullptr,
+    /* .backend_set_input = */ nullptr,
+    /* .backend_reset     = */ nullptr,
+    /* .copy_state        = */ nullptr,
+};
+
+llama_sampler * draw_init(const draw_state & state) {
+    return llama_sampler_init(&draw_iface, new draw_state(state));
+}
+
+llama_sampler * draw_clone(const llama_sampler * smpl) {
+    return draw_init(*static_cast<const draw_state *>(smpl->ctx));
+}
+
+// The indexed draw that ends `chain`, or null.
+draw_state * draw_of(llama_sampler * chain) {
+    const int32_t n = chain == nullptr ? 0 : llama_sampler_chain_n(chain);
+    auto * last = n > 0 ? llama_sampler_chain_get(chain, n - 1) : nullptr;
+    return last != nullptr && last->iface == &draw_iface ? static_cast<draw_state *>(last->ctx) : nullptr;
+}
+
+// The softmax weight of a candidate against the best logit. A candidate a
+// sampler turned off (a logit of minus infinity) weighs nothing.
+double weight(float logit, float best) {
+    const double w = std::exp(static_cast<double>(logit) - static_cast<double>(best));
+    return std::isfinite(w) ? w : 0.0;
+}
+
+// The candidates' indices in token id order.
+std::vector<uint32_t> by_token_id(const llama_token_data * data, size_t size) {
+    std::vector<uint32_t> order(size);
+    std::iota(order.begin(), order.end(), 0u);
+    bool ascending = true;
+    llama_token top = data[0].id;
+    for (size_t i = 1; i < size; ++i) {
+        ascending = ascending && data[i - 1].id < data[i].id;
+        top = std::max(top, data[i].id);
+    }
+    if (ascending) {
+        return order;
+    }
+    if (size <= SORTED_MAX || top < 0) {
+        std::sort(order.begin(), order.end(), [data](uint32_t a, uint32_t b) { return data[a].id < data[b].id; });
+        return order;
+    }
+    // one slot per token id, then the taken slots in order
+    constexpr uint32_t EMPTY = UINT32_MAX;
+    std::vector<uint32_t> slots(static_cast<size_t>(top) + 1, EMPTY);
+    for (size_t i = 0; i < size; ++i) {
+        if (data[i].id >= 0) {
+            slots[static_cast<size_t>(data[i].id)] = static_cast<uint32_t>(i);
+        }
+    }
+    order.clear();
+    for (const uint32_t slot : slots) {
+        if (slot != EMPTY) {
+            order.push_back(slot);
+        }
+    }
+    return order;
+}
+
+} // namespace
+
+double skippy_receipt_draw_uniform(uint32_t seed, uint64_t index) {
+    uint64_t x = (static_cast<uint64_t>(seed) << 32) | (index & 0xFFFFFFFFull);
+    x += 0x9E3779B97F4A7C15ull;
+    x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ull;
+    x = (x ^ (x >> 27)) * 0x94D049BB133111EBull;
+    x ^= x >> 31;
+    return static_cast<double>(x >> 11) * 0x1.0p-53;
+}
+
+size_t skippy_receipt_draw_pick(llama_token_data * data, size_t size, double u) {
+    float best = data[0].logit;
+    for (size_t i = 1; i < size; ++i) {
+        best = std::max(best, data[i].logit);
+    }
+    std::vector<double> weights(size);
+    double total = 0.0;
+    for (size_t i = 0; i < size; ++i) {
+        weights[i] = weight(data[i].logit, best);
+        total += weights[i];
+    }
+    for (size_t i = 0; i < size; ++i) {
+        data[i].p = total > 0.0 ? static_cast<float>(weights[i] / total) : 0.0f;
+    }
+    const auto order = by_token_id(data, size);
+    const double target = u * total;
+    double running = 0.0;
+    for (const uint32_t i : order) {
+        running += weights[i];
+        if (running > target) {
+            return i;
+        }
+    }
+    return order.back();
+}
+
+bool skippy_receipt_draw_install(llama_sampler * chain, uint32_t seed) {
+    const int32_t n = chain == nullptr ? 0 : llama_sampler_chain_n(chain);
+    auto * last = n > 0 ? llama_sampler_chain_get(chain, n - 1) : nullptr;
+    const char * name = last == nullptr ? nullptr : llama_sampler_name(last);
+    if (name == nullptr || std::strcmp(name, "dist") != 0) {
+        return false;
+    }
+    llama_sampler_free(llama_sampler_chain_remove(chain, n - 1));
+    draw_state state;
+    state.seed = seed;
+    llama_sampler_chain_add(chain, draw_init(state));
+    return true;
+}
+
+void skippy_receipt_draw_set_index(llama_sampler * chain, uint64_t index) {
+    if (auto * state = draw_of(chain)) {
+        state->index = index;
+    }
+}
