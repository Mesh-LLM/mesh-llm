diff --git a/ggml/src/ggml-cuda/receipt-digest.cu b/ggml/src/ggml-cuda/receipt-digest.cu
new file mode 100644
index 000000000..adfeff560
--- /dev/null
+++ b/ggml/src/ggml-cuda/receipt-digest.cu
@@ -0,0 +1,353 @@
+#include "receipt-digest.cuh"
+
+#include "ggml-backend-impl.h"
+#include "ggml-cuda.h"
+
+// BLAKE3 (unkeyed hash, 32-byte output), as in the reference implementation.
+// One thread compresses one 1 KiB chunk of a message; a second pass merges a
+// message's chunk chaining values into its root.
+
+static constexpr uint32_t CHUNK_START = 1u << 0;
+static constexpr uint32_t CHUNK_END   = 1u << 1;
+static constexpr uint32_t PARENT      = 1u << 2;
+static constexpr uint32_t ROOT        = 1u << 3;
+static constexpr uint64_t CHUNK_LEN   = 1024;
+static constexpr uint64_t BLOCK_LEN   = 64;
+static constexpr int      DESC_WORDS  = 8;
+// a message's chaining-value stack: enough for 2^54 chunks
+static constexpr int      MAX_DEPTH   = 54;
+
+static __constant__ uint32_t BLAKE3_IV[8] = {
+    0x6A09E667u, 0xBB67AE85u, 0x3C6EF372u, 0xA54FF53Au, 0x510E527Fu, 0x9B05688Cu, 0x1F83D9ABu, 0x5BE0CD19u,
+};
+
+static __device__ __forceinline__ uint32_t rotr(uint32_t x, int n) {
+    return (x >> n) | (x << (32 - n));
+}
+
+static __device__ __forceinline__ void g(uint32_t * s, int a, int b, int c, int d, uint32_t mx, uint32_t my) {
+    s[a] = s[a] + s[b] + mx;
+    s[d] = rotr(s[d] ^ s[a], 16);
+    s[c] = s[c] + s[d];
+    s[b] = rotr(s[b] ^ s[c], 12);
+    s[a] = s[a] + s[b] + my;
+    s[d] = rotr(s[d] ^ s[a], 8);
+    s[c] = s[c] + s[d];
+    s[b] = rotr(s[b] ^ s[c], 7);
+}
+
+// The first 8 words of the compression output: a chaining value, or with
+// ROOT in the flags the first 32 bytes of the hash.
+static __device__ void compress(uint32_t cv[8], const uint32_t block[16], uint64_t counter, uint32_t block_len,
+        uint32_t flags) {
+    constexpr int PERMUTATION[16] = {2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8};
+    uint32_t s[16] = {
+        cv[0], cv[1], cv[2], cv[3], cv[4], cv[5], cv[6], cv[7],
+        BLAKE3_IV[0], BLAKE3_IV[1], BLAKE3_IV[2], BLAKE3_IV[3],
+        (uint32_t) counter, (uint32_t) (counter >> 32), block_len, flags,
+    };
+    uint32_t m[16];
+    for (int i = 0; i < 16; ++i) {
+        m[i] = block[i];
+    }
+    for (int round = 0; round < 7; ++round) {
+        g(s, 0, 4,  8, 12, m[0],  m[1]);
+        g(s, 1, 5,  9, 13, m[2],  m[3]);
+        g(s, 2, 6, 10, 14, m[4],  m[5]);
+        g(s, 3, 7, 11, 15, m[6],  m[7]);
+        g(s, 0, 5, 10, 15, m[8],  m[9]);
+        g(s, 1, 6, 11, 12, m[10], m[11]);
+        g(s, 2, 7,  8, 13, m[12], m[13]);
+        g(s, 3, 4,  9, 14, m[14], m[15]);
+        if (round < 6) {
+            uint32_t p[16];
+            for (int i = 0; i < 16; ++i) {
+                p[i] = m[PERMUTATION[i]];
+            }
+            for (int i = 0; i < 16; ++i) {
+                m[i] = p[i];
+            }
+        }
+    }
+    for (int i = 0; i < 8; ++i) {
+        cv[i] = s[i] ^ s[i + 8];
+    }
+}
+
+struct receipt_desc {
+    uint64_t ptr;
+    uint64_t seg_bytes;
+    uint64_t seg_stride;
+    uint64_t n_segs;
+    uint64_t col_stride;
+    uint64_t n_cols;
+    uint64_t flags;
+    uint64_t reserved;
+};
+
+static __device__ __forceinline__ uint32_t conversion(const receipt_desc & d) {
+    return (uint32_t) (d.flags & 0xffu);
+}
+
+// Bytes of one message: the elements as f32 when converted.
+static __host__ __device__ __forceinline__ uint64_t message_bytes(const receipt_desc & d) {
+    const uint32_t conv = (uint32_t) (d.flags & 0xffu);
+    const uint64_t source = d.seg_bytes * d.n_segs;
+    return conv == RECEIPT_DIGEST_RAW ? source : source * 2;
+}
+
+static __host__ __device__ __forceinline__ uint64_t chunks_of(const receipt_desc & d) {
+    const uint64_t bytes = message_bytes(d);
+    return bytes == 0 ? 1 : (bytes + CHUNK_LEN - 1) / CHUNK_LEN;
+}
+
+// Word `w` (little endian) of column `col`'s message, as the value holds it.
+static __device__ uint32_t source_word(const receipt_desc & d, const uint32_t * cells, uint64_t col, uint64_t w) {
+    const uint64_t column = (d.flags & RECEIPT_DIGEST_CELLS) ? (uint64_t) cells[col] * d.col_stride
+                                                             : col * d.col_stride;
+    const uint8_t * base = (const uint8_t *) d.ptr + column;
+    const uint32_t conv = conversion(d);
+    if (conv == RECEIPT_DIGEST_RAW) {
+        const uint64_t byte = w * 4;
+        const uint64_t seg = byte / d.seg_bytes;
+        return *(const uint32_t *) (base + seg * d.seg_stride + byte % d.seg_bytes);
+    }
+    // one f32 per 2-byte source element
+    const uint64_t per_seg = d.seg_bytes / 2;
+    const uint64_t seg = w / per_seg;
+    const uint16_t bits = *(const uint16_t *) (base + seg * d.seg_stride + (w % per_seg) * 2);
+    if (conv == RECEIPT_DIGEST_F16) {
+        return __float_as_uint(__half2float(__ushort_as_half(bits)));
+    }
+    return (uint32_t) bits << 16;
+}
+
+// Word `w` (little endian) of column `col`'s message.
+static __device__ uint32_t message_word(const receipt_desc & d, const uint32_t * cells, uint64_t col, uint64_t w) {
+    const uint32_t word = source_word(d, cells, col, w);
+    return (d.flags & RECEIPT_DIGEST_UNSIGNED_ZERO) && word == 0x80000000u ? 0u : word;
+}
+
+// Finds the descriptor whose range in `bases` (n + 1 prefix sums) holds `i`.
+static __device__ int find_desc(const uint64_t * bases, int n, uint64_t i) {
+    int lo = 0;
+    int hi = n - 1;
+    while (lo < hi) {
+        const int mid = (lo + hi + 1) / 2;
+        if (bases[mid] <= i) {
+            lo = mid;
+        } else {
+            hi = mid - 1;
+        }
+    }
+    return lo;
+}
+
+static __device__ void store_digest(uint8_t * out, const uint32_t cv[8]) {
+    for (int i = 0; i < 8; ++i) {
+        out[4 * i + 0] = (uint8_t) (cv[i]);
+        out[4 * i + 1] = (uint8_t) (cv[i] >> 8);
+        out[4 * i + 2] = (uint8_t) (cv[i] >> 16);
+        out[4 * i + 3] = (uint8_t) (cv[i] >> 24);
+    }
+}
+
+// One thread per chunk: its chaining value, or the digest of a one-chunk message.
+static __global__ void chunk_kernel(const receipt_desc * descs, int n_descs, const uint64_t * chunk_bases,
+        const uint64_t * message_bases, const uint32_t * cells, uint64_t n_chunks, uint32_t * cvs, uint8_t * out) {
+    const uint64_t g = (uint64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (g >= n_chunks) {
+        return;
+    }
+    const int di = find_desc(chunk_bases, n_descs, g);
+    const receipt_desc d = descs[di];
+    const uint64_t per_message = chunks_of(d);
+    const uint64_t local = g - chunk_bases[di];
+    const uint64_t col = local / per_message;
+    const uint64_t chunk = local % per_message;
+    const uint64_t bytes = message_bytes(d);
+    const uint64_t start = chunk * CHUNK_LEN;
+    const uint64_t len = bytes - start < CHUNK_LEN ? bytes - start : CHUNK_LEN;
+    const uint64_t n_blocks = len == 0 ? 1 : (len + BLOCK_LEN - 1) / BLOCK_LEN;
+
+    uint32_t cv[8];
+    for (int i = 0; i < 8; ++i) {
+        cv[i] = BLAKE3_IV[i];
+    }
+    for (uint64_t b = 0; b < n_blocks; ++b) {
+        const uint64_t block_start = start + b * BLOCK_LEN;
+        const uint64_t block_len = len - b * BLOCK_LEN < BLOCK_LEN ? len - b * BLOCK_LEN : BLOCK_LEN;
+        uint32_t block[16];
+        for (int i = 0; i < 16; ++i) {
+            const uint64_t byte = block_start + 4 * (uint64_t) i;
+            block[i] = byte < start + len ? message_word(d, cells, col, byte / 4) : 0;
+        }
+        uint32_t flags = 0;
+        if (b == 0) {
+            flags |= CHUNK_START;
+        }
+        if (b == n_blocks - 1) {
+            flags |= CHUNK_END;
+            if (per_message == 1) {
+                flags |= ROOT;
+            }
+        }
+        compress(cv, block, chunk, (uint32_t) block_len, flags);
+    }
+    if (per_message == 1) {
+        store_digest(out + 32 * (message_bases[di] + col), cv);
+    } else {
+        for (int i = 0; i < 8; ++i) {
+            cvs[8 * g + i] = cv[i];
+        }
+    }
+}
+
+static __device__ void parent(uint32_t out[8], const uint32_t left[8], const uint32_t right[8], uint32_t flags) {
+    uint32_t block[16];
+    for (int i = 0; i < 8; ++i) {
+        block[i] = left[i];
+        block[i + 8] = right[i];
+        out[i] = BLAKE3_IV[i];
+    }
+    compress(out, block, 0, (uint32_t) BLOCK_LEN, PARENT | flags);
+}
+
+// One thread per message of more than one chunk: merges its chunks' chaining
+// values as the reference hasher's stack does, the last merge with ROOT.
+static __global__ void merge_kernel(const receipt_desc * descs, int n_descs, const uint64_t * chunk_bases,
+        const uint64_t * message_bases, uint64_t n_messages, const uint32_t * cvs, uint8_t * out) {
+    const uint64_t m = (uint64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (m >= n_messages) {
+        return;
+    }
+    const int di = find_desc(message_bases, n_descs, m);
+    const receipt_desc d = descs[di];
+    const uint64_t per_message = chunks_of(d);
+    if (per_message == 1) {
+        return;
+    }
+    const uint64_t col = m - message_bases[di];
+    const uint32_t * chunk_cvs = cvs + 8 * (chunk_bases[di] + col * per_message);
+
+    uint32_t stack[MAX_DEPTH][8];
+    int depth = 0;
+    for (uint64_t c = 0; c + 1 < per_message; ++c) {
+        uint32_t cv[8];
+        for (int i = 0; i < 8; ++i) {
+            cv[i] = chunk_cvs[8 * c + i];
+        }
+        for (uint64_t total = c + 1; (total & 1) == 0; total >>= 1) {
+            --depth;
+            uint32_t merged[8];
+            parent(merged, stack[depth], cv, 0);
+            for (int i = 0; i < 8; ++i) {
+                cv[i] = merged[i];
+            }
+        }
+        for (int i = 0; i < 8; ++i) {
+            stack[depth][i] = cv[i];
+        }
+        ++depth;
+    }
+    uint32_t cv[8];
+    for (int i = 0; i < 8; ++i) {
+        cv[i] = chunk_cvs[8 * (per_message - 1) + i];
+    }
+    while (depth > 0) {
+        --depth;
+        uint32_t merged[8];
+        parent(merged, stack[depth], cv, depth == 0 ? ROOT : 0);
+        for (int i = 0; i < 8; ++i) {
+            cv[i] = merged[i];
+        }
+    }
+    store_digest(out + 32 * m, cv);
+}
+
+static bool valid(const receipt_desc & d, int n_cells) {
+    const uint32_t conv = (uint32_t) (d.flags & 0xffu);
+    const uint64_t known = 0xffu | RECEIPT_DIGEST_CELLS | RECEIPT_DIGEST_UNSIGNED_ZERO;
+    if (d.ptr == 0 || d.n_segs == 0 || d.reserved != 0 || (d.flags & ~known)) {
+        return false;
+    }
+    if ((d.flags & RECEIPT_DIGEST_CELLS) && d.n_cols > (uint64_t) n_cells) {
+        return false;
+    }
+    if (conv == RECEIPT_DIGEST_RAW) {
+        // whole words, read aligned
+        return d.seg_bytes % 4 == 0 && d.ptr % 4 == 0 && d.seg_stride % 4 == 0 && d.col_stride % 4 == 0;
+    }
+    if (conv == RECEIPT_DIGEST_F16 || conv == RECEIPT_DIGEST_BF16) {
+        return d.seg_bytes % 2 == 0 && d.ptr % 2 == 0 && d.seg_stride % 2 == 0 && d.col_stride % 2 == 0;
+    }
+    return false;
+}
+
+bool ggml_cuda_receipt_digest(
+        ggml_backend_t   backend,
+        const uint64_t * descs,
+        int              n_descs,
+        const uint32_t * cells,
+        int              n_cells,
+        uint64_t       * bases,
+        void           * out) {
+    if (backend == nullptr || !ggml_backend_is_cuda(backend) || descs == nullptr || n_descs <= 0 || out == nullptr ||
+            bases == nullptr || (n_cells > 0 && cells == nullptr)) {
+        return false;
+    }
+    static_assert(sizeof(receipt_desc) == DESC_WORDS * sizeof(uint64_t), "descriptor layout");
+    const receipt_desc * host = reinterpret_cast<const receipt_desc *>(descs);
+    // prefix sums in the caller's memory, which outlives the copies queued below
+    const size_t n_bases = 2 * ((size_t) n_descs + 1);
+    uint64_t * chunk_bases = bases;
+    uint64_t * message_bases = bases + n_descs + 1;
+    chunk_bases[0] = 0;
+    message_bases[0] = 0;
+    for (int i = 0; i < n_descs; ++i) {
+        if (!valid(host[i], n_cells)) {
+            return false;
+        }
+        chunk_bases[i + 1] = chunk_bases[i] + host[i].n_cols * chunks_of(host[i]);
+        message_bases[i + 1] = message_bases[i] + host[i].n_cols;
+    }
+    const uint64_t n_chunks = chunk_bases[n_descs];
+    const uint64_t n_messages = message_bases[n_descs];
+    if (n_messages == 0) {
+        return true;
+    }
+
+    auto * ctx = (ggml_backend_cuda_context *) backend->context;
+    ggml_cuda_set_device(ctx->device);
+    cudaStream_t stream = ctx->stream();
+    const size_t desc_bytes = (size_t) n_descs * sizeof(receipt_desc);
+    const size_t base_bytes = n_bases * sizeof(uint64_t);
+    const size_t cell_bytes = (size_t) n_cells * sizeof(uint32_t);
+    ggml_cuda_pool_alloc<uint8_t> inputs(ctx->pool(), desc_bytes + base_bytes + cell_bytes);
+    // chaining values of the chunks: only a message of more than one chunk has them
+    ggml_cuda_pool_alloc<uint32_t> cvs(ctx->pool());
+    if (n_chunks > n_messages) {
+        cvs.alloc(8 * n_chunks);
+    }
+    uint8_t * dev = inputs.get();
+    CUDA_CHECK(cudaMemcpyAsync(dev, descs, desc_bytes, cudaMemcpyHostToDevice, stream));
+    CUDA_CHECK(cudaMemcpyAsync(dev + desc_bytes, bases, base_bytes, cudaMemcpyHostToDevice, stream));
+    if (cell_bytes > 0) {
+        CUDA_CHECK(cudaMemcpyAsync(dev + desc_bytes + base_bytes, cells, cell_bytes, cudaMemcpyHostToDevice, stream));
+    }
+    const auto * dev_descs = (const receipt_desc *) dev;
+    const auto * dev_chunk_bases = (const uint64_t *) (dev + desc_bytes);
+    const auto * dev_message_bases = dev_chunk_bases + n_descs + 1;
+    const auto * dev_cells = cell_bytes > 0 ? (const uint32_t *) (dev + desc_bytes + base_bytes) : nullptr;
+
+    constexpr int THREADS = 128;
+    chunk_kernel<<<(unsigned) ((n_chunks + THREADS - 1) / THREADS), THREADS, 0, stream>>>(
+            dev_descs, n_descs, dev_chunk_bases, dev_message_bases, dev_cells, n_chunks, cvs.get(), (uint8_t *) out);
+    CUDA_CHECK(cudaGetLastError());
+    if (n_chunks > n_messages) {
+        merge_kernel<<<(unsigned) ((n_messages + THREADS - 1) / THREADS), THREADS, 0, stream>>>(
+                dev_descs, n_descs, dev_chunk_bases, dev_message_bases, n_messages, cvs.get(), (uint8_t *) out);
+        CUDA_CHECK(cudaGetLastError());
+    }
+    return true;
+}
diff --git a/ggml/src/ggml-cuda/receipt-digest.cuh b/ggml/src/ggml-cuda/receipt-digest.cuh
new file mode 100644
index 000000000..c4100f38c
--- /dev/null
+++ b/ggml/src/ggml-cuda/receipt-digest.cuh
@@ -0,0 +1,46 @@
+#pragma once
+
+#include "common.cuh"
+
+// BLAKE3 digests of receipt values, computed where the values are, so a
+// receipt recorder copies 32 bytes per value to the host instead of the value.
+//
+// A value is a column of a tensor: `n_segs` segments of `seg_bytes` bytes,
+// `seg_stride` bytes apart, read as one message. Each descriptor is 8 uint64:
+//
+//   0 ptr         device address of column 0
+//   1 seg_bytes   source bytes per segment
+//   2 seg_stride  bytes between segments
+//   3 n_segs
+//   4 col_stride  bytes between columns, or between cache rows with cells
+//   5 n_cols
+//   6 flags       bits 0-7: RECEIPT_DIGEST_RAW, _F16 or _BF16 (the message is
+//                 the elements as f32); bit 8: column j starts at
+//                 cells[j] * col_stride; bit 9: a negative zero f32 is
+//                 read as a positive zero
+//   7 reserved, 0
+//
+// The digests go to `out` (device memory) in descriptor order, then column
+// order, 32 bytes each. The work runs on the backend's stream, after what is
+// queued there. Returns false when the backend is not a CUDA backend or a
+// descriptor is malformed; nothing is queued then.
+//
+// `bases` is scratch of 2 * (n_descs + 1) uint64, which the call fills. The
+// stream copies `descs`, `cells` and `bases` to the device when it reaches
+// them, which can be after the call returns: the caller keeps all three
+// alive and unchanged until the stream has run the digests.
+
+#define RECEIPT_DIGEST_RAW  0
+#define RECEIPT_DIGEST_F16  1
+#define RECEIPT_DIGEST_BF16 2
+#define RECEIPT_DIGEST_CELLS (1u << 8)
+#define RECEIPT_DIGEST_UNSIGNED_ZERO (1u << 9)
+
+bool ggml_cuda_receipt_digest(
+        ggml_backend_t   backend,
+        const uint64_t * descs,
+        int              n_descs,
+        const uint32_t * cells,
+        int              n_cells,
+        uint64_t       * bases,
+        void           * out);
