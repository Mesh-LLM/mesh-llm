diff --git a/include/skippy/receipts.h b/include/skippy/receipts.h
new file mode 100644
index 000000000..a790a193c
--- /dev/null
+++ b/include/skippy/receipts.h
@@ -0,0 +1,719 @@
+#ifndef SKIPPY_RECEIPTS_H
+#define SKIPPY_RECEIPTS_H
+
+/**
+ * @file skippy/receipts.h
+ * @brief Recording and replay for verifiable inference receipts.
+ *
+ * A receipt commits, for every layer a stage runs, to the residual stream
+ * entering the layer and to the values entering and leaving its
+ * token-mixing regions (attention, recurrent state updates), with KV-cache
+ * rows as stored. Which ops mix tokens is decided per ggml op from the built
+ * graph; a graph with an op outside that table, or one that breaks a receipt
+ * guard, is reported as unreceiptable with the reason
+ * (mesh/docs/design/RECEIPTS_GLUE.md).
+ *
+ * While serving, the recorder reports each ubatch: its geometry (tokens,
+ * sequences, positions, output rows, KV cells, n_kv), the stage input rows,
+ * and the committed tensors of every layer. It also reports every KV-cache
+ * operation that changes which cells a sequence holds.
+ *
+ * To open a challenge, the caller replays the recorded ubatches of one
+ * sequence in a scratch context of the same model. Other sequences' columns
+ * are replaced by dummy columns at the recorded cells, and the recorded cells
+ * and n_kv are forced, so the challenged sequence computes bit for bit what it
+ * computed while serving. The replay also reports the inputs and outputs of
+ * every weight matmul of the challenged layer.
+ *
+ * An auditor checks the glue between those values by evaluating the layer
+ * itself: skippy_model_eval_receipt_glue() computes one layer on opened
+ * values, with every weight matmul and token-mixing output replaced by the
+ * opened value.
+ */
+
+#include "runtime.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** @brief A per-layer tensor reported by the recorder, a replay or a glue evaluation. */
+enum skippy_receipt_tensor_kind {
+    /** Residual stream entering the layer; layer == layer_end is the stage output. */
+    SKIPPY_RECEIPT_TENSOR_RESIDUAL         = 0,
+    /** A per-token value entering a token-mixing region. */
+    SKIPPY_RECEIPT_TENSOR_MIXING_INPUT     = 1,
+    /**
+     * A row written to a KV cache, as stored and in the cache's type. A glue
+     * evaluation reports the f32 row before it is stored instead.
+     */
+    SKIPPY_RECEIPT_TENSOR_MIXING_STORED    = 2,
+    /** A value leaving a token-mixing region. */
+    SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT    = 3,
+    /** Replay and glue evaluation: the input of a weight matmul. */
+    SKIPPY_RECEIPT_TENSOR_MATMUL_INPUT     = 4,
+    /** Replay: the output of a weight matmul. */
+    SKIPPY_RECEIPT_TENSOR_MATMUL_OUTPUT    = 5,
+    /** Replay and glue evaluation: the expert of every slot of an expert matmul, I32. */
+    SKIPPY_RECEIPT_TENSOR_EXPERT_IDS       = 6,
+    /** Replay: the output of a selection (ARGSORT, TOP_K) made by glue, I32. */
+    SKIPPY_RECEIPT_TENSOR_SELECTION        = 7,
+    /** Glue evaluation: the scores a selection ranks. */
+    SKIPPY_RECEIPT_TENSOR_SELECTION_SCORES = 8,
+    /**
+     * Replay of a final stage that replays its last layer: the logits of
+     * the ubatch's output rows, F32, with layer == layer_end.
+     */
+    SKIPPY_RECEIPT_TENSOR_LOGITS           = 9,
+    /**
+     * The state a recurrent token-mixing op reads before the ubatch, F32.
+     * Column s is the state of the ubatch's s-th sequence, whose tokens are
+     * the s-th run of n_tokens / n_cols tokens. A region evaluation takes
+     * one column: the state before its first position.
+     */
+    SKIPPY_RECEIPT_TENSOR_MIXING_STATE     = 10,
+    /**
+     * Region evaluation: the state the op writes back after the tokens,
+     * F32, with the index of the MIXING_STATE it replaces.
+     */
+    SKIPPY_RECEIPT_TENSOR_MIXING_STATE_OUT = 11,
+};
+
+/** @brief Flags of a reported tensor. */
+enum skippy_receipt_tensor_flag {
+    /**
+     * MATMUL_*: the matmul's output reaches a selection before any other
+     * weight matmul, so an auditor checks all of its rows.
+     */
+    SKIPPY_RECEIPT_TENSOR_ROUTER = 1,
+};
+
+/** @brief One reported tensor, column per token. */
+struct skippy_receipt_tensor {
+    int32_t layer;
+    /** A skippy_receipt_tensor_kind. */
+    int32_t kind;
+    /**
+     * Ordinal among the layer's tensors of this kind, in graph order.
+     * MATMUL_INPUT, MATMUL_OUTPUT and EXPERT_IDS share their matmul's
+     * ordinal; SELECTION and SELECTION_SCORES share their selection's.
+     */
+    int32_t index;
+    /** ggml type of the values: F32, I32, or the cache type of a stored row. */
+    int32_t ggml_type;
+    /** skippy_receipt_tensor_flag bits. */
+    int32_t flags;
+    /** Elements per column. */
+    int64_t len;
+    /** Bytes per column. */
+    int64_t row_bytes;
+    /**
+     * Number of columns: the ubatch's token count, or its output-row count when
+     * the layer keeps only output rows (the last layer of a final stage).
+     */
+    int64_t n_cols;
+    /** Column j at `values + j * row_bytes`, or NULL when `digests` is set. */
+    const void * values;
+    /** MATMUL_* and EXPERT_IDS: the weight's tensor name. Otherwise the graph node's name, for diagnostics. */
+    const char * name;
+    /**
+     * While serving on a device that can hash: per column, the 32-byte BLAKE3
+     * hash of its `row_bytes` bytes, computed on the device so the values
+     * never reach the host. `values` is NULL then. NULL otherwise.
+     */
+    const uint8_t * digests;
+};
+
+/** @brief Which positions an attention op's queries read. */
+enum skippy_receipt_attention_window_kind {
+    /** Every earlier position, and its own. */
+    SKIPPY_RECEIPT_ATTENTION_CAUSAL  = 0,
+    /** The last `window` positions up to its own. */
+    SKIPPY_RECEIPT_ATTENTION_SLIDING = 1,
+    /** Earlier positions in its own chunk of `window` positions. */
+    SKIPPY_RECEIPT_ATTENTION_CHUNKED = 2,
+};
+
+/**
+ * @brief One attention op of a reported layer.
+ *
+ * Says which of the layer's committed values the op reads and writes, and
+ * how it combines them: `output = softmax(scale * q k^T, softcapped, over
+ * the window) v` per query head, with K and V heads shared by
+ * `n_head / n_head_kv` query heads. Values are head-major: head h of a
+ * column is its elements `h * head_dim` to `(h + 1) * head_dim`.
+ */
+struct skippy_receipt_attention {
+    int32_t layer;
+    /** Non-NULL when the attention check cannot follow the op: the reason. Nothing else is set. */
+    const char * error;
+    /** Indices of q among the MIXING_INPUT values, K and V among the MIXING_STORED rows, and the output among the MIXING_OUTPUT values. */
+    int32_t q_input;
+    int32_t k_store;
+    int32_t v_store;
+    int32_t output;
+    int32_t n_head;
+    int32_t n_head_kv;
+    int32_t head_dim_k;
+    int32_t head_dim_v;
+    /** Multiplies q k. */
+    float scale;
+    /** Nonzero: a logit x becomes `softcap * tanh(x / softcap)`. */
+    float softcap;
+    /** A skippy_receipt_attention_window_kind, and its size. */
+    int32_t window_kind;
+    int32_t window;
+    /** Per query head, a logit that only adds to the softmax's denominator, or NULL. */
+    const float * sinks;
+    /**
+     * Index among the MIXING_INPUT values of a gate that multiplies the
+     * output, value by value, before it leaves the token-mixing region; or -1.
+     * `output` is then the gated value.
+     */
+    int32_t output_gate;
+    /**
+     * Nonzero: before the gate, each head of the output is rotated in chunks
+     * of this many values, value i of a chunk becoming
+     * `sum_k output_rotation[i * output_rotation_n + k] * value k` (llama.cpp
+     * rotates V before a quantized KV cache stores it).
+     */
+    int32_t output_rotation_n;
+    const float * output_rotation;
+    /**
+     * A ggml type the kernel rounds each head of q to before its dot with K,
+     * or -1: GGML_TYPE_Q8_0 (8-bit blocks of 32 values) for a quantized K
+     * cache, as the CPU and CUDA kernels do.
+     */
+    int32_t q_rounding;
+};
+
+/**
+ * @brief One computed ubatch.
+ *
+ * The tensor values and stage input rows of a ubatch reported by the
+ * recorder stay valid until the callback for the next ubatch returns, or the
+ * recorder is removed or replaced, so a caller can hash them while the next
+ * ubatch computes. Every other pointer is valid only during the callback.
+ */
+struct skippy_receipt_ubatch {
+    /** Replay step index, or -1 while serving. */
+    int64_t step;
+    int32_t n_tokens;
+    /** Per column: token id, sequence, position, output flag, and KV cell. */
+    const int32_t * token;
+    const int32_t * seq;
+    const int32_t * pos;
+    const int8_t * output;
+    const uint32_t * cell;
+    /** KV cells the attention graph covered. */
+    uint32_t n_kv;
+    /** Stage input rows (a stage after the first), or NULL. Row j at `input + j * input_row_bytes`. */
+    const void * input;
+    int64_t input_row_bytes;
+    /** ggml type of the input rows. */
+    int32_t input_type;
+    size_t n_tensors;
+    const struct skippy_receipt_tensor * tensors;
+    /** Non-NULL when the ubatch cannot be receipted: the reason. Nothing else is set. */
+    const char * error;
+    /** Glue evaluation: weights read inside token-mixing regions, which nothing checks. */
+    size_t n_unchecked_weights;
+    const char * const * unchecked_weights;
+    /** Replay and glue evaluation: the attention ops of the reported layers. */
+    size_t n_attention;
+    const struct skippy_receipt_attention * attention;
+};
+
+/** @brief KV-cache operations that the recorder reports. */
+enum skippy_receipt_memory_op {
+    /** Every sequence lost all its cells. */
+    SKIPPY_RECEIPT_MEMORY_CLEAR      = 0,
+    /** Cells of `seq` (every sequence if -1) in positions [p0, p1) were removed; p1 < 0 means no end. */
+    SKIPPY_RECEIPT_MEMORY_SEQ_RM     = 1,
+    /** Cells of `seq` in [p0, p1) were shared with `seq_dst`. */
+    SKIPPY_RECEIPT_MEMORY_SEQ_CP     = 2,
+    /** Every sequence except `seq` lost its cells. */
+    SKIPPY_RECEIPT_MEMORY_SEQ_KEEP   = 3,
+    /** Positions of `seq` in [p0, p1) were shifted or divided. */
+    SKIPPY_RECEIPT_MEMORY_SEQ_SHIFT  = 4,
+    /**
+     * Cells of `seq` (every sequence if -1) were loaded from saved state or
+     * from an imported KV page. Reported before the rows are written. The
+     * cells they go to are not reported, and may be freed cells that an
+     * earlier turn still reads, so any cell may hold other rows afterwards.
+     */
+    SKIPPY_RECEIPT_MEMORY_STATE_READ = 5,
+    /** Cells moved to close gaps. */
+    SKIPPY_RECEIPT_MEMORY_COMPACT    = 6,
+};
+
+struct skippy_receipt_memory_event {
+    /** A skippy_receipt_memory_op. */
+    int32_t op;
+    int32_t seq;
+    int32_t seq_dst;
+    int32_t p0;
+    int32_t p1;
+};
+
+typedef void (*skippy_receipt_ubatch_fn)(void * user_data, const struct skippy_receipt_ubatch * ubatch);
+typedef void (*skippy_receipt_memory_fn)(void * user_data, const struct skippy_receipt_memory_event * event);
+
+/**
+ * @brief Installs or, with both callbacks NULL, removes the receipt recorder.
+ *
+ * The memory callback runs on the thread that changes the KV cache. On a
+ * device that copies asynchronously, a ubatch's values reach the host while
+ * later ubatches compute, and the ubatch is reported late: on the decoding
+ * thread two ubatches later, before the next memory event, or on the thread
+ * that calls skippy_model_flush_receipt_recorder(). Otherwise each ubatch is
+ * reported on the decoding thread as soon as it is computed. Reports always
+ * arrive in the order the ubatches and memory events happened. The recorder
+ * marks the committed tensors as graph outputs, which keeps them
+ * alive and may disable some kernel fusions; replay marks the same tensors.
+ * The stage needs a plain KV cache, unified or with a stream per sequence
+ * (skippy_model_receipt_kv_streams()), and flash attention, so V rows are
+ * stored untransposed.
+ *
+ * The caller keeps the stage context idle during the call: nothing decodes
+ * on it, changes its KV cache, or flushes the recorder, on any thread. The
+ * decoding thread reads the recorder and the memory callback without a
+ * lock, so installing, replacing or removing them under it is a data race.
+ * `user_data` must stay valid until the call that removes or replaces the
+ * recorder returns.
+ *
+ * A context with a receipt capture (the stage context once a recorder is
+ * installed, and the contexts that replay and evaluate receipts) uses the
+ * dense-mask attention of a unified KV cache: the attention mask hides the
+ * cells of other sequences, and the attention op is not given each
+ * sequence's rows (ggml_flash_attn_ext_rows). The layer classifier, the
+ * replay and the attention opening do not read those row lists. Both ways
+ * attend to the same cells; a stage that serves several sequences from a
+ * unified cache loses the speedup of the row lists. The stage context keeps
+ * the dense mask after the recorder is removed.
+ */
+LLAMA_API enum skippy_status skippy_model_set_receipt_recorder(
+        struct skippy_model * model,
+        skippy_receipt_ubatch_fn on_ubatch,
+        skippy_receipt_memory_fn on_memory,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Reports the ubatches the recorder still holds back, if any.
+ *
+ * Call it before reading what the recorder reported, for example to commit
+ * a turn: the last ubatches of a turn are otherwise reported only with later
+ * ubatches or the next memory event. It waits for their values to reach the
+ * host. Safe to call from any thread, and when no recorder is installed.
+ */
+LLAMA_API enum skippy_status skippy_model_flush_receipt_recorder(
+        struct skippy_model * model,
+        struct skippy_error ** out_error);
+
+enum skippy_receipt_replay_kind {
+    /** Decode one recorded ubatch. */
+    SKIPPY_RECEIPT_REPLAY_DECODE = 0,
+    /** Remove positions [p0, p1) of the replayed sequence (p1 < 0: no end). */
+    SKIPPY_RECEIPT_REPLAY_SEQ_RM = 1,
+};
+
+/** @brief One replay step. A decode step has the fields of a recorded ubatch. */
+struct skippy_receipt_replay_step {
+    /** A skippy_receipt_replay_kind. */
+    int32_t kind;
+    int32_t n_tokens;
+    const int32_t * token;
+    const int32_t * seq;
+    const int32_t * pos;
+    const int8_t * output;
+    const uint32_t * cell;
+    uint32_t n_kv;
+    const void * input;
+    int64_t input_row_bytes;
+    int32_t input_type;
+    /** SEQ_RM range. */
+    int32_t p0;
+    int32_t p1;
+    /** Nonzero to report this step's tensors through the capture callback. */
+    int32_t capture;
+};
+
+/**
+ * @brief Replays one sequence in the model's scratch context.
+ *
+ * The scratch context is created on first use with the stage context's
+ * parameters and room for the KV cells the steps use, not the stage's whole
+ * context. It is kept until skippy_model_release_receipt_scratch(), and a
+ * later replay that needs more cells creates it again. A replay of the
+ * sequence skippy_model_seed_receipt_replay() seeded last starts from the
+ * seeded cells, which must cover the cells its steps use; any other starts
+ * from an empty cache. After every decode step, the columns of sequences
+ * other than `seq` are removed. A captured step reports, for each
+ * of the `n_layers` sorted `layers`, the layer's committed tensors, its
+ * weight matmuls' inputs, outputs and experts, its selections, and the
+ * residual leaving it. Every step stops computing once those are done, so
+ * later layers and the output head are skipped and their values are
+ * undefined.
+ *
+ * `seq` and the sequences of every step must be sequences of the stage
+ * context, a step's `n_kv` must fit the replay cache, and a step's input
+ * rows must have the type and size of the stage's imported activation. The
+ * call fails with SKIPPY_STATUS_INVALID_ARGUMENT, before any step runs, when
+ * a step breaks one of these.
+ */
+LLAMA_API enum skippy_status skippy_model_replay_receipt(
+        struct skippy_model * model,
+        int32_t seq,
+        const int32_t * layers,
+        size_t n_layers,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Replays like skippy_model_replay_receipt(), reporting only the committed tensors.
+ *
+ * A captured step reports, for each of the `layers`, the tensors the
+ * recorder commits (the residual entering it, its token-mixing values and
+ * the residual leaving it) and a final stage's logits, and no matmul or
+ * selection. The recorder marks the same tensors, so a backend fuses the
+ * layer's ops as it did when serving, and the committed values are
+ * reproduced bit for bit even where the extra tensors of a full replay
+ * keep a backend from fusing them.
+ */
+LLAMA_API enum skippy_status skippy_model_replay_receipt_committed(
+        struct skippy_model * model,
+        int32_t seq,
+        const int32_t * layers,
+        size_t n_layers,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/** @brief A committed value an anchored replay writes into one token's column. */
+struct skippy_receipt_anchor {
+    /** The decode step, as an index into the replay's steps. */
+    size_t step;
+    /** The token: its sequence and position in that step. */
+    int32_t seq;
+    int32_t pos;
+    int32_t layer;
+    /** RESIDUAL, the residual entering `layer`, or MIXING_OUTPUT. */
+    int32_t kind;
+    int32_t index;
+    /** f32 elements of the column. */
+    int64_t len;
+    const float * values;
+};
+
+/**
+ * @brief Replays like skippy_model_replay_receipt(), from committed values at anchored tokens.
+ *
+ * As soon as a step computes the residual entering an anchored layer, or one
+ * of its token-mixing outputs, the anchor's values replace the token's
+ * column, before anything reads it. The matmuls and selections the replay
+ * reports for the anchored tokens then follow from the committed values,
+ * even where this replay computes the layers before them, or the context
+ * the token-mixing ops read, differently from the turn: a backend fuses
+ * fewer ops when more tensors are reported. Every anchor's layer must be
+ * one of `layers`, and its step a decode step.
+ */
+LLAMA_API enum skippy_status skippy_model_replay_receipt_anchored(
+        struct skippy_model * model,
+        int32_t seq,
+        const int32_t * layers,
+        size_t n_layers,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        const struct skippy_receipt_anchor * anchors,
+        size_t n_anchors,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Seeds the next receipt replay of `seq` with cells of the stage context.
+ *
+ * Copies the K and V rows of `cells` from the stage context's KV cache into
+ * the same cells of the scratch context, which is made to hold `n_cells`
+ * cells, and marks them there as positions `pos` of `seq`. A turn that
+ * continued a sequence, or started from a cached prefix, then replays only
+ * its own ubatches on top of the prefix it attended to. Fails, seeding
+ * nothing, unless every cell holds position `pos[i]` in the stage context,
+ * or no sequence holds it any more; the sequences sharing it there do not
+ * matter. A freed cell keeps its rows until a ubatch writes it, which the
+ * recorder reports, so the caller checks its rows from what it recorded.
+ * Models with more than one position per token cannot seed a freed cell.
+ * The caller keeps the stage context idle during the call. The seed lasts
+ * until the next replay or seeding.
+ */
+LLAMA_API enum skippy_status skippy_model_seed_receipt_replay(
+        struct skippy_model * model,
+        int32_t seq,
+        const uint32_t * cells,
+        const int32_t * pos,
+        size_t n_seeded,
+        uint32_t n_cells,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Reads the rows the stage context stored in some KV cells for one layer.
+ *
+ * Calls `on_rows` once with a ubatch of `n_cells` columns, cell j holding
+ * `cells[j]` of the stream of `seq`, whose tensors are the MIXING_STORED
+ * rows of `layer`, by index, read from the stage context's cache exactly as
+ * the recorder commits them. The recorder must be installed and the stage
+ * context must have computed a ubatch since, so its graph names the layer's
+ * cache rows. The caller keeps the stage context idle during the call.
+ */
+LLAMA_API enum skippy_status skippy_model_read_receipt_rows(
+        struct skippy_model * model,
+        int32_t layer,
+        int32_t seq,
+        const uint32_t * cells,
+        size_t n_cells,
+        skippy_receipt_ubatch_fn on_rows,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Pins the KV cells a recent turn's opening may still read.
+ *
+ * Replaces the pinned cells of the stage context with `cells`, cell i in
+ * stream `streams[i]`; none when `n_cells` is 0. While a pinned cell is
+ * empty, which it is once its sequences free it, the stage context places
+ * ubatches in other cells, and uses it only when a ubatch fits nowhere else.
+ * A pin costs no memory: it keeps the rows of a finished turn readable for
+ * its challenge window while the cache has room. Safe while the stage context computes: a
+ * ubatch is placed with the cells pinned before it or after it.
+ */
+LLAMA_API enum skippy_status skippy_model_pin_receipt_cells(
+        struct skippy_model * model,
+        const uint32_t * streams,
+        const uint32_t * cells,
+        size_t n_cells,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Receives a sequence's recurrent state before a turn of it.
+ *
+ * `bytes` holds the recurrent state of `seq` in the stage context before the
+ * first ubatch of the turn computes, as the context's recurrent memory
+ * serializes it: the recurrent part of a sequence state alone, without the
+ * header and the KV cells that llama_state_seq_get_data_ext() writes around
+ * it, so only skippy_model_seed_receipt_state() reads it. It is null, with
+ * `n_bytes` 0, when the state could not be exported. Valid for the call
+ * only.
+ */
+typedef void (*skippy_receipt_state_fn)(void * user_data, int32_t seq, const void * bytes, size_t n_bytes);
+
+/**
+ * @brief Reports the recurrent state each turn of a sequence starts from.
+ *
+ * A replay cannot recompute a recurrent layer's state from the turn's own
+ * ubatches, so for a hybrid model, whose attention layers use a plain KV
+ * cache and whose other layers keep recurrent state (the gated delta net,
+ * Mamba), the recorder installed by skippy_model_set_receipt_recorder()
+ * calls `on_state` on the decoding thread before the first ubatch of each
+ * turn, after it reports the ubatches before it. `bytes` is null when the
+ * state cannot be read, and is valid only during the call. A turn starts
+ * at a sequence's first ubatch, after the sequence is removed whole, and
+ * after skippy_model_arm_receipt_state().
+ * Sets `*out_recurrent` to whether the model has hybrid memory; without
+ * it `on_state` is never called. A null `on_state` stops the reports.
+ */
+LLAMA_API enum skippy_status skippy_model_set_receipt_state_observer(
+        struct skippy_model * model,
+        skippy_receipt_state_fn on_state,
+        void * user_data,
+        bool * out_recurrent,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Starts a new turn of `seq` for the receipt state observer.
+ *
+ * Its next ubatch reports the sequence's recurrent state first. Safe while
+ * the stage context computes.
+ */
+LLAMA_API enum skippy_status skippy_model_arm_receipt_state(
+        struct skippy_model * model,
+        int32_t seq,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Seeds the next receipt replay of `seq` with recurrent state.
+ *
+ * Imports `bytes`, a state the observer reported, into `seq` of the
+ * scratch context, after skippy_model_seed_receipt_replay() seeded its KV
+ * cells (possibly none). The replay then starts its first ubatch from the
+ * state the turn started from. The seed lasts until the next replay or
+ * seeding.
+ */
+LLAMA_API enum skippy_status skippy_model_seed_receipt_state(
+        struct skippy_model * model,
+        int32_t seq,
+        const void * bytes,
+        size_t n_bytes,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Reports how the stage context's KV cache lays out its cells.
+ *
+ * Writes the number of streams: 1 for a unified cache, which every
+ * sequence shares, or one per sequence, stream s holding the cells of
+ * sequence s. The cells the recorder reports, a replay places, a seed
+ * copies and a pin holds are indices in the stream of their sequence. A
+ * `seq_cp` between sequences of different streams copies the source's
+ * whole stream into the destination's.
+ */
+LLAMA_API enum skippy_status skippy_model_receipt_kv_streams(
+        struct skippy_model * model,
+        uint32_t * out_streams,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Frees the scratch context that receipt replays run in.
+ *
+ * The next replay creates it again. When a replay is running, the context
+ * is kept and the call still succeeds.
+ */
+LLAMA_API enum skippy_status skippy_model_release_receipt_scratch(
+        struct skippy_model * model,
+        struct skippy_error ** out_error);
+
+/** @brief A value a glue evaluation uses instead of computing it. */
+struct skippy_receipt_glue_value {
+    /** MATMUL_OUTPUT, MIXING_OUTPUT or SELECTION. */
+    int32_t kind;
+    int32_t index;
+    /** F32, or I32 for SELECTION. */
+    int32_t ggml_type;
+    /** Elements per column. Column j at `values + j * len` elements. */
+    int64_t len;
+    const void * values;
+};
+
+/** @brief Opened values of one layer at a few positions. */
+struct skippy_receipt_glue_request {
+    int32_t layer;
+    int32_t n_cols;
+    /** Per column: the position. */
+    const int32_t * pos;
+    /** Residual stream entering the layer. Column j at `residual + j * residual_len`. */
+    const float * residual;
+    int64_t residual_len;
+    /** One value for every weight matmul output, token-mixing output and selection of the layer. */
+    size_t n_values;
+    const struct skippy_receipt_glue_value * values;
+};
+
+/**
+ * @brief Evaluates the glue of one layer on opened values.
+ *
+ * The model must hold `layer`; an auditor loads a stage of that layer alone.
+ * Each column is computed as its own sequence at its position, starting
+ * from the opened residual. Every weight matmul, token-mixing output and
+ * selection takes the given value instead of being computed, so the
+ * layer's large weights are never read. `on_result` is called once with the
+ * computed values: weight matmul inputs and experts, token-mixing inputs,
+ * KV rows before storage, selection scores, the residual leaving the layer,
+ * and the weights read inside token-mixing regions.
+ *
+ * The opened values come from the node being audited, so none is trusted.
+ * The call fails with SKIPPY_STATUS_INVALID_ARGUMENT when the request has
+ * more columns than a context has sequences, a negative position, a
+ * residual of another width than the layer reads, or a value of a kind,
+ * type or length the evaluation does not take. A value that does not fit
+ * the node it replaces, or a SELECTION id that is no row of what the
+ * selection chooses from, is reported through `on_result` as an error.
+ */
+LLAMA_API enum skippy_status skippy_model_eval_receipt_glue(
+        struct skippy_model * model,
+        const struct skippy_receipt_glue_request * request,
+        skippy_receipt_ubatch_fn on_result,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Evaluates the recurrent token mixing of one layer on opened values.
+ *
+ * The model must hold `layer`, as for skippy_model_eval_receipt_glue(). The
+ * columns are consecutive positions of one sequence, computed in one
+ * ubatch. Every MIXING_INPUT of the layer takes the given value, each
+ * MIXING_STATE the given state (one column), and the weight matmuls compute
+ * nothing; the token mixing reads no residual, so it may be zeros.
+ * `on_result` is called once with the MIXING_OUTPUT values the
+ * token-mixing ops compute from them and the MIXING_STATE_OUT states they
+ * leave. A layer whose token mixing reads a KV cache, or keeps no
+ * recurrent state, is refused. The request is checked as for
+ * skippy_model_eval_receipt_glue(); a region holds at most a context of
+ * positions.
+ */
+LLAMA_API enum skippy_status skippy_model_eval_receipt_region(
+        struct skippy_model * model,
+        const struct skippy_receipt_glue_request * request,
+        skippy_receipt_ubatch_fn on_result,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Computes the residual entering layer 0 for tokens at positions.
+ *
+ * The model must hold layer 0. Each of the `n_cols` columns is its own
+ * sequence of one token. `on_result` is called once with the RESIDUAL
+ * tensor of layer 0, a column per token, as the stage computes it from the
+ * token embedding. A token outside the vocabulary, a negative position or
+ * more columns than a context has sequences fails the call with
+ * SKIPPY_STATUS_INVALID_ARGUMENT.
+ */
+LLAMA_API enum skippy_status skippy_model_eval_receipt_entry(
+        struct skippy_model * model,
+        const int32_t * tokens,
+        const int32_t * pos,
+        int32_t n_cols,
+        skippy_receipt_ubatch_fn on_result,
+        void * user_data,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Compares a stored KV row with the f32 row an auditor computed.
+ *
+ * Sets `stored_error` to the L2 distance between the dequantized stored row
+ * and `computed`, `rounding_error` to the distance between `computed` and
+ * its own round trip through `ggml_type`, and `norm` to the L2 norm of
+ * `computed`. An honestly stored row is about one rounding error away.
+ * `stored` holds `stored_len` bytes, which must be the size of a row of `n`
+ * values of `ggml_type`: the type and the bytes come from the opening, so a
+ * row of any other size is refused, not read.
+ */
+LLAMA_API enum skippy_status skippy_receipt_stored_row_error(
+        int32_t ggml_type,
+        const void * stored,
+        size_t stored_len,
+        const float * computed,
+        int64_t n,
+        double * stored_error,
+        double * rounding_error,
+        double * norm,
+        struct skippy_error ** out_error);
+
+/**
+ * @brief Names the source the runtime was built from.
+ *
+ * `llama.cpp <upstream commit> patches <patch queue digest>`, as the
+ * prepared llama.cpp checkout recorded them when the library was built, or
+ * `unknown` for a checkout without that record. A receipt names it, so an
+ * auditor knows whether its own runtime computes like the node's.
+ */
+LLAMA_API const char * skippy_receipt_runtime_source(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SKIPPY_RECEIPTS_H
