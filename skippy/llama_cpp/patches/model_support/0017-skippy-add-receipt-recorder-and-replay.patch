+    if (!receipt_has_pins.load(std::memory_order_acquire)) {
+        return find_slot(ubatch, cont, nullptr);
+    }
+    // a snapshot: the pins may be replaced while the ubatch is placed
+    std::shared_ptr<const std::vector<bool>> pinned;
+    {
+        std::lock_guard<std::mutex> lock(receipt_pinned_mutex);
