+
+class classifier : private token_axis_rules {
+public:
+    classifier(ggml_cgraph * gf, const skippy_receipt_graph_facts & facts) : token_axis_rules(facts), gf_(gf) {
+        const int n = ggml_graph_n_nodes(gf);
+        for (int i = 0; i < n; ++i) {
+            index_[ggml_graph_node(gf, i)] = i;
+        }
+    }
+
+    std::string run(std::vector<skippy_receipt_layer_plan> & plans) {
+        classify_outside_layers();
+        int32_t previous = -1;
+        for (const auto & bounds : facts_.layers) {
+            if (bounds.exit != nullptr && node_index(bounds.exit) < 0) {
+                // a boundary past the stage: the graph registers the next
+                // layer's entry (the stage output) but never computes it
+                continue;
+            }
+            if (previous >= 0 && bounds.layer != previous + 1) {
+                return "the graph's layers are not contiguous";
+            }
+            previous = bounds.layer;
+            skippy_receipt_layer_plan plan;
+            std::string error = classify_layer(bounds, plan);
+            if (!error.empty()) {
+                return "layer " + std::to_string(bounds.layer) + ": " + error;
+            }
+            plans.push_back(std::move(plan));
+        }
+        if (plans.empty()) {
+            return "the graph has no layers";
+        }
+        return {};
+    }
+
+private:
+    ggml_cgraph * gf_;
+    std::unordered_map<const ggml_tensor *, int> index_;
+    // every node as seen from outside any layer
+    std::vector<value_info> outside_;
+
+    // the layer being classified
+    bool in_layer_ = false;
+    const ggml_tensor * entry_ = nullptr;
+    value_info entry_info_;
+    std::unordered_map<const ggml_tensor *, value_info> local_;
+    skippy_receipt_layer_plan * plan_ = nullptr;
+    std::string error_;
+
+    // A model weight. A constant of the context is none, wherever it is kept.
+    bool is_weight(const ggml_tensor * t) const {
+        return t != nullptr && t->view_src == nullptr && facts_.is_weight(t) && facts_.constant_inputs.count(t) == 0;
+    }
+
+    bool is_state(const ggml_tensor * t) const {
+        return facts_.state_storage.count(root_of(t)) != 0;
+    }
+
+    int node_index(const ggml_tensor * t) const {
+        const auto found = index_.find(t);
+        return found == index_.end() ? -1 : found->second;
+    }
+
+    int input_axis(const ggml_tensor * t, int64_t count) const {
+        if (single_ || count == 1) {
+            return AXIS_SINGLE;
+        }
+        for (int b = 3; b >= 0; --b) {
+            if (t->ne[b] == count) {
+                return b;
+            }
+        }
+        return AXIS_LOST;
+    }
+
+    value_info leaf_info(const ggml_tensor * t) const {
+        if (is_weight(t)) {
+            return {value_class::constant, AXIS_LOST};
+        }
+        if (is_state(t)) {
+            return {value_class::opaque, AXIS_LOST};
+        }
+        if (facts_.client_inputs.count(t) != 0) {
+            return {value_class::clean, input_axis(t, facts_.n_tokens)};
+        }
+        if (facts_.constant_inputs.count(t) != 0) {
+            return {value_class::constant, AXIS_LOST};
+        }
+        if (facts_.output_indices.count(t) != 0) {
+            return {value_class::clean, input_axis(t, t->ne[0])};
+        }
+        if (facts_.state_selectors.count(t) != 0 || facts_.cell_indices.count(t) != 0) {
+            return {value_class::opaque, AXIS_LOST};
+        }
+        // a token input, an activation from another stage, or an input
+        // the facts do not name
+        return uncommitted();
+    }
+
+    // A value nothing commits; also what a refused node yields.
+    static value_info uncommitted() {
+        return {value_class::opaque, AXIS_LOST, true};
+    }
+
+    value_info info(const ggml_tensor * t) const override {
+        if (in_layer_) {
+            if (t == entry_) {
+                return entry_info_;
+            }
+            const auto found = local_.find(t);
+            if (found != local_.end()) {
+                return found->second;
+            }
+        }
+        const int i = node_index(t);
+        if (i >= 0 && i < static_cast<int>(outside_.size())) {
+            return outside_[i];
+        }
+        return leaf_info(t);
+    }
+
+    void fail(const std::string & message) {
+        if (error_.empty()) {
+            error_ = message;
+        }
+    }
+
+    // ---- node classification ----
+
+    value_info weight_matmul(ggml_tensor * node) {
+        const ggml_tensor * weight = node->src[0];
+        ggml_tensor * x = node->src[1];
+        const value_info xi = info(x);
+        if (xi.cls == value_class::opaque) {
+            if (xi.foreign) {
+                fail(std::string("weight matmul ") + node->name + " reads " + x->name + ", which nothing commits");
+                return uncommitted();
+            }
+            // reads state directly: part of a token-mixing region
+            return {value_class::taint, AXIS_LOST};
+        }
+        if (xi.cls == value_class::constant) {
+            return {value_class::constant, AXIS_LOST};
+        }
+        skippy_receipt_matmul m;
+        m.node = node;
+        m.weight = weight;
+        int axis = xi.axis;
+        if (node->op == GGML_OP_MUL_MAT) {
+            if (weight->ne[2] > 1 || weight->ne[3] > 1) {
+                fail(std::string("weight matmul ") + node->name + " multiplies by a batched weight");
+                return uncommitted();
+            }
+            if (axis == 0 && x->ne[0] > 1) {
+                fail(std::string("weight matmul ") + node->name + " contracts over tokens");
+                return uncommitted();
+            }
+        } else {
+            ggml_tensor * ids = node->src[2];
+            const value_info ii = info(ids);
+            if (ii.cls != value_class::clean) {
+                fail(std::string("the experts of ") + node->name + " come from a value nothing commits");
+                return uncommitted();
+            }
+            if (!single_ && !((axis == 2 || axis == AXIS_SINGLE) && (ii.axis == 1 || ii.axis == AXIS_SINGLE))) {
+                fail(std::string("cannot follow tokens through expert matmul ") + node->name);
+                return uncommitted();
+            }
+            m.ids = {ids, ii.axis};
+        }
+        if (!readable_axis(axis)) {
+            fail(std::string("cannot follow tokens into weight matmul ") + node->name);
+            return uncommitted();
+        }
+        m.input = {x, axis};
+        m.output = {node, axis};
+        if (in_layer_) {
+            plan_->matmuls.push_back(m);
+        }
+        return {value_class::clean, axis};
+    }
+
+    value_info cache_write(ggml_tensor * node) {
+        // SET_ROWS keeps its operands as (source, indices, destination)
+        ggml_tensor * source = node->src[0];
+        const ggml_tensor * idx = node->src[1];
+        const ggml_tensor * rows = node->src[2];
+        const value_info si = info(source);
+        if (si.cls == value_class::taint && facts_.recurrent_storage.count(root_of(rows)) != 0) {
+            // a recurrent op writes its state back, rows of it at a time;
+            // the layer commits the state its region read (find_states)
+            if (info(idx).foreign) {
+                fail(std::string("state write ") + node->name + " orders its rows by " + idx->name +
+                        ", which nothing commits");
+                return uncommitted();
+            }
+            return {value_class::taint, AXIS_LOST};
+        }
+        if (si.cls != value_class::clean) {
+            // A stored row is committed as stored, and the client checks it
+            // against the row it computes from the layer's glue. It cannot
+            // compute a row from inside a token-mixing region, from state,
+            // or from a value nothing commits, so the row would go unchecked
+            // into everything that reads the cache.
+            const char * what = si.cls == value_class::taint ? ", a value computed inside a token-mixing region"
+                              : si.foreign                   ? ", which nothing commits"
+                                                             : ", which is not a per-token value";
+            fail(std::string("cache write ") + node->name + " stores " + source->name + what);
+            return uncommitted();
+        }
+        if (rows->ne[0] == 1) {
+            fail("the V cache is stored transposed; receipts need flash attention");
+            return uncommitted();
+        }
+        if (facts_.cell_indices.count(idx) == 0) {
+            fail(std::string("cache write ") + node->name + " uses row indices that are not the tokens' cells");
+            return uncommitted();
+        }
+        if (si.axis != 1 && si.axis != AXIS_SINGLE) {
+            fail(std::string("cannot follow tokens into cache write ") + node->name);
+            return uncommitted();
+        }
+        if (in_layer_) {
+            skippy_receipt_store store;
+            store.node = node;
+            store.rows = rows;
+            store.source = {source, si.axis};
+            plan_->stores.push_back(store);
+        }
+        return {value_class::opaque, AXIS_LOST};
+    }
+
+    value_info classify(ggml_tensor * node) {
+        const ggml_tensor * src0 = node->src[0];
+        if ((node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) && is_weight(src0)) {
+            return weight_matmul(node);
+        }
+        if (node->op == GGML_OP_SET_ROWS && node->src[2] != nullptr && is_state(node->src[2])) {
+            return cache_write(node);
+        }
+        bool any_taint = false;
+        bool any_opaque = false;
+        bool any_clean = false;
+        const ggml_tensor * opaque_src = nullptr;
+        const ggml_tensor * foreign_src = nullptr;
+        for (int i = 0; i < GGML_MAX_SRC; ++i) {
+            const ggml_tensor * s = node->src[i];
+            // a copy's destination is overwritten, not read
+            if (s == nullptr || (node->op == GGML_OP_CPY && i == 1 && !is_state(s))) {
+                continue;
+            }
+            const value_info si = info(s);
+            if (si.foreign && foreign_src == nullptr) {
+                foreign_src = s;
+            }
+            switch (si.cls) {
+                case value_class::taint:
+                    any_taint = true;
+                    break;
+                case value_class::opaque:
+                    any_opaque = true;
+                    opaque_src = opaque_src != nullptr ? opaque_src : s;
+                    break;
+                case value_class::clean:
+                    any_clean = true;
+                    break;
+                case value_class::constant:
+                    break;
+            }
+        }
+        if (node->op == GGML_OP_CPY && node->src[1] != nullptr && is_state(node->src[1])) {
+            const value_info source = info(src0);
+            if (source.foreign) {
+                fail(std::string("state write ") + node->name + " stores " + src0->name + ", which nothing commits");
+                return uncommitted();
+            }
+            if (source.cls == value_class::taint) {
+                return {value_class::taint, AXIS_LOST};
+            }
+            if (source.cls == value_class::clean) {
+                fail(std::string("a per-token value is copied into persistent state by ") + node->name);
+                return uncommitted();
+            }
+            return {value_class::opaque, AXIS_LOST};
+        }
+        if (any_taint || (any_opaque && any_clean && may_read_other_tokens(node->op))) {
+            // A region's inputs are the per-token values it commits and the
+            // persistent state its layer commits as stored. Anything else it
+            // reads would shape the output with no commitment to check.
+            if (foreign_src != nullptr) {
+                fail(std::string("token-mixing node ") + node->name + " reads " + foreign_src->name +
+                        ", which is neither persistent state nor a value the layer commits");
+                return uncommitted();
+            }
+            return {value_class::taint, mixing_axis(node)};
+        }
+        if (any_opaque) {
+            if (!any_clean) {
+                return {value_class::opaque, AXIS_LOST, foreign_src != nullptr};
+            }
+            fail(std::string("glue node ") + node->name + " reads " + opaque_src->name +
+                    ", which nothing commits and the client cannot compute");
+            return uncommitted();
+        }
+        if (!any_clean) {
+            return {value_class::constant, AXIS_LOST};
+        }
+        if (mixes_tokens(node->op)) {
+            return {value_class::taint, mixing_axis(node)};
+        }
+        const axis_rule rule = clean_rule(node);
+        switch (rule.kind) {
+            case axis_rule::per_token:
+                return {value_class::clean, single_ ? AXIS_SINGLE : rule.axis};
+            case axis_rule::mixes:
+                return {value_class::taint, single_ ? AXIS_SINGLE : rule.axis};
+            case axis_rule::unknown:
+                break;
+        }
+        fail(std::string("op ") + ggml_op_name(node->op) + " (node " + node->name +
+                ") is not in the receipt op table");
+        return uncommitted();
+    }
+
+    void classify_outside_layers() {
+        const int n = ggml_graph_n_nodes(gf_);
+        outside_.assign(static_cast<size_t>(n), value_info{});
+        in_layer_ = false;
+        for (int i = 0; i < n; ++i) {
+            value_info v = classify(ggml_graph_node(gf_, i));
+            // outside a layer, only values the client derives itself count:
+            // no layer commits what a token-mixing op computes there
+            if (v.cls == value_class::taint) {
+                v = uncommitted();
+            }
+            outside_[static_cast<size_t>(i)] = v;
+        }
+        error_.clear();
+    }
+
+    // ---- one layer ----
+
+    // The weights a value a token-mixing region reads is computed from,
+    // through values of no token (constant) and values of persistent state
+    // (opaque): nothing checks how those were computed.
+    void collect_weights(const ggml_tensor * t, std::unordered_set<const ggml_tensor *> & weights,
+            std::unordered_set<const ggml_tensor *> & seen) const {
+        if (t == nullptr || !seen.insert(t).second) {
+            return;
+        }
+        if (is_weight(t)) {
+            weights.insert(t);
+            return;
+        }
+        const value_class cls = info(t).cls;
+        if (cls != value_class::constant && cls != value_class::opaque) {
+            return;
+        }
+        for (int i = 0; i < GGML_MAX_SRC; ++i) {
+            collect_weights(t->src[i], weights, seen);
+        }
+        if (t->view_src != nullptr) {
+            collect_weights(t->view_src, weights, seen);
+        }
+    }
+
+    // A view of all of a rotation product, in its order: the rotated value
+    // with its shape.
+    bool views_rotation(const ggml_tensor * t) const {
+        const ggml_tensor * root = root_of(t);
+        int axis = AXIS_LOST;
+        size_t stride = 0;
+        return t->view_src != nullptr && t->view_offs == 0 && ggml_is_contiguous(t) &&
+               ggml_nelements(t) == ggml_nelements(root) && rotated_value(root, axis, stride) != nullptr;
+    }
+
+    // The non-view producer of a value leaving a region, or a view of a
+    // rotation product, whose own shape does not follow the tokens.
+    skippy_receipt_value region_output(ggml_tensor * t) {
+        while (is_view_op(t->op) && t->src[0] != nullptr && info(t->src[0]).cls == value_class::taint &&
+                (readable_axis(info(t->src[0]).axis) || !views_rotation(t))) {
+            t = t->src[0];
+        }
+        const value_info v = info(t);
+        if (t->view_src != nullptr && !views_rotation(t)) {
+            fail(std::string("token-mixing output ") + t->name + " is a view");
+        } else if (!readable_axis(v.axis)) {
+            fail(std::string("cannot follow tokens out of token-mixing output ") + t->name);
+        }
+        return {t, v.axis};
+    }
+
+    void find_regions(int lo, int hi, const ggml_tensor * exit) {
+        std::unordered_set<const ggml_tensor *> unchecked;
+        std::unordered_set<const ggml_tensor *> layer_weights;
+        std::unordered_set<const ggml_tensor *> seen_inputs;
+        std::unordered_set<const ggml_tensor *> seen_sources;
+        std::vector<ggml_tensor *> inputs;
+        for (int i = lo + 1; i <= hi; ++i) {
+            ggml_tensor * node = ggml_graph_node(gf_, i);
+            const bool taint = local_[node].cls == value_class::taint;
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                ggml_tensor * src = node->src[s];
+                if (src == nullptr) {
+                    continue;
+                }
+                if (is_weight(src)) {
+                    layer_weights.insert(src);
+                }
+                if (!taint) {
+                    continue;
+                }
+                const value_info si = info(src);
+                if (si.cls == value_class::constant || si.cls == value_class::opaque) {
+                    // a weight applied to state before the region reads it
+                    // is as unchecked as one the region reads itself
+                    collect_weights(src, unchecked, seen_sources);
+                } else if (si.cls == value_class::clean && seen_inputs.insert(src).second) {
+                    if (!readable_axis(si.axis)) {
+                        fail(std::string("cannot follow tokens into token-mixing input ") + src->name);
+                    }
+                    inputs.push_back(src);
+                }
+            }
+        }
+        std::stable_sort(inputs.begin(), inputs.end(), [this](const ggml_tensor * a, const ggml_tensor * b) {
+            return node_index(a) < node_index(b);
+        });
+        for (ggml_tensor * t : inputs) {
+            plan_->mixing_inputs.push_back({t, info(t).axis});
+        }
+        std::unordered_set<const ggml_tensor *> seen_outputs;
+        for (const auto & m : plan_->matmuls) {
+            if (info(m.input.tensor).cls != value_class::taint) {
+                continue;
+            }
+            const skippy_receipt_value out = region_output(m.input.tensor);
+            if (seen_outputs.insert(out.tensor).second) {
+                plan_->mixing_outputs.push_back(out);
+            }
+        }
+        if (info(exit).cls == value_class::taint) {
+            fail("token mixing reaches the layer output without a weight matmul");
+        }
+        size_t total = 0;
+        size_t hidden = 0;
+        for (const ggml_tensor * w : layer_weights) {
+            total += ggml_nbytes(w);
+        }
+        for (const ggml_tensor * w : unchecked) {
+            hidden += ggml_nbytes(w);
+            plan_->unchecked_weights.push_back(w);
+        }
+        std::sort(plan_->unchecked_weights.begin(), plan_->unchecked_weights.end(),
+                [](const ggml_tensor * a, const ggml_tensor * b) { return std::string(a->name) < b->name; });
+        if (static_cast<double>(hidden) > SKIPPY_RECEIPT_MAX_UNCHECKED_WEIGHTS * static_cast<double>(total)) {
+            fail("token-mixing ops read " + std::to_string(hidden) + " of the layer's " + std::to_string(total) +
+                    " weight bytes, more than receipts leave unchecked");
+        }
+    }
+
+    void find_routers_and_selections(int lo, int hi) {
+        std::unordered_map<const ggml_tensor *, std::vector<ggml_tensor *>> consumers;
+        for (int i = lo + 1; i <= hi; ++i) {
+            ggml_tensor * node = ggml_graph_node(gf_, i);
+            for (int s = 0; s < GGML_MAX_SRC; ++s) {
+                if (node->src[s] != nullptr && local_.count(node->src[s]) != 0) {
+                    consumers[node->src[s]].push_back(node);
+                }
+            }
+            if (is_selection_op(node->op) && local_[node].cls == value_class::clean) {
+                skippy_receipt_selection selection;
+                selection.node = node;
+                selection.scores = {node->src[0], info(node->src[0]).axis};
+                selection.output = {node, local_[node].axis};
+                plan_->selections.push_back(selection);
+            }
+        }
+        for (auto & m : plan_->matmuls) {
+            std::deque<const ggml_tensor *> queue = {m.node};
+            std::unordered_set<const ggml_tensor *> seen = {m.node};
+            while (!queue.empty() && !m.router) {
+                const ggml_tensor * t = queue.front();
+                queue.pop_front();
+                for (ggml_tensor * c : consumers[t]) {
+                    const bool weight_matmul =
+                            (c->op == GGML_OP_MUL_MAT || c->op == GGML_OP_MUL_MAT_ID) && is_weight(c->src[0]);
+                    if (weight_matmul || local_[c].cls != value_class::clean || !seen.insert(c).second) {
+                        continue;
+                    }
+                    if (is_selection_op(c->op)) {
+                        m.router = true;
+                        break;
+                    }
+                    queue.push_back(c);
+                }
+            }
+        }
+    }
+
+    void find_states(int lo, int hi) {
+        skippy_receipt_state_scan scan;
+        scan.in_region = [this](const ggml_tensor * t) { return info(t).cls == value_class::taint; };
+        scan.storage = &facts_.recurrent_storage;
+        scan.n_seqs = facts_.n_seqs;
+        const std::string error = skippy_receipt_find_states(gf_, lo, hi, scan, plan_->states);
+        if (!error.empty()) {
+            fail(error);
+        }
+    }
+
+    std::string classify_layer(const skippy_receipt_graph_facts::layer_bounds & bounds,
+            skippy_receipt_layer_plan & plan) {
+        if (bounds.entry == nullptr || bounds.exit == nullptr) {
+            return "no block boundary";
+        }
+        const int lo = node_index(bounds.entry);
+        const int hi = node_index(bounds.exit);
+        if (hi < 0 || hi <= lo) {
+            return "the block exit is not computed after its entry";
+        }
+        const ggml_tensor * entry = bounds.entry;
+        if (entry->ne[2] != 1 || entry->ne[3] != 1) {
+            return "the block entry is not one row per token";
+        }
+        plan.layer = bounds.layer;
+        plan_ = &plan;
+        error_.clear();
+        local_.clear();
+        in_layer_ = true;
+        entry_ = entry;
+        entry_info_ = {value_class::clean, single_ || entry->ne[1] == 1 ? AXIS_SINGLE : 1};
+        plan.entry = {bounds.entry, entry_info_.axis};
+        for (int i = lo + 1; i <= hi; ++i) {
+            ggml_tensor * node = ggml_graph_node(gf_, i);
+            local_[node] = classify(node);
+        }
+        const value_info exit = info(bounds.exit);
+        if (exit.cls != value_class::clean || !readable_axis(exit.axis)) {
+            fail("the block exit is not a per-token value the client computes");
+        }
+        plan.exit = {bounds.exit, exit.axis};
+        if (error_.empty()) {
+            find_regions(lo, hi, bounds.exit);
+        }
+        if (error_.empty()) {
+            find_states(lo, hi);
+        }
+        if (error_.empty()) {
+            find_routers_and_selections(lo, hi);
+        }
+        in_layer_ = false;
+        plan_ = nullptr;
+        return error_;
+    }
+};
+
+}  // namespace
+
+std::string skippy_receipt_classify(
+        ggml_cgraph * gf,
+        const skippy_receipt_graph_facts & facts,
+        std::vector<skippy_receipt_layer_plan> & plans) {
+    plans.clear();
+    if (!facts.is_weight) {
+        return "no weight predicate";
+    }
+    classifier c(gf, facts);
+    std::string error = c.run(plans);
+    if (!error.empty()) {
+        plans.clear();
+    }
+    return error;
+}
+
+int64_t skippy_receipt_columns(const skippy_receipt_value & value) {
+    return columns_of(value.tensor, value.axis);
+}
diff --git a/src/skippy/receipts_layers.h b/src/skippy/receipts_layers.h
new file mode 100644
index 000000000..3d2c83217
--- /dev/null
+++ b/src/skippy/receipts_layers.h
@@ -0,0 +1,162 @@
+#pragma once
+
+// Splits every layer of a built graph into what receipts check
+// (mesh/docs/design/RECEIPTS_GLUE.md):
+//
+// - weight matmuls: MUL_MAT or MUL_MAT_ID with a model weight as the matrix;
+//   the client row-checks them against the claimed GGUF;
+// - token-mixing regions: ops whose token column depends on other tokens or
+//   on persistent state, with every op downstream of them up to the next
+//   weight matmul. Their inputs and outputs are committed; the arithmetic
+//   inside is not checked;
+// - glue: everything else, a function of one token that the client
+//   evaluates itself.
+//
+// The split is decided per ggml op by how the op treats the token axis. No
+// architecture, tensor name or node name is consulted. A layer that uses an
+// op the table does not cover, or that breaks one of the guards, cannot be
+// receipted, and the reason is returned.
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+struct ggml_cgraph;
+struct ggml_tensor;
+
+// The axis of a value that holds one column per token: 0..3, or this when
+// the whole value is one column (a graph of one token).
+constexpr int32_t SKIPPY_RECEIPT_AXIS_SINGLE = 4;
+
+// A per-token value as the graph holds it.
+struct skippy_receipt_value {
+    ggml_tensor * tensor = nullptr;
+    int32_t axis = SKIPPY_RECEIPT_AXIS_SINGLE;
+};
+
+struct skippy_receipt_matmul {
+    // the MUL_MAT or MUL_MAT_ID node; also its output
+    ggml_tensor * node = nullptr;
+    const ggml_tensor * weight = nullptr;
+    skippy_receipt_value input;
+    skippy_receipt_value output;
+    // MUL_MAT_ID: the expert of every slot
+    skippy_receipt_value ids;
+    // the output reaches a selection (ARGSORT, TOP_K) before any other
+    // weight matmul: the client checks every row, not a sample
+    bool router = false;
+};
+
+// A per-token row written to a KV cache, committed as stored.
+struct skippy_receipt_store {
+    ggml_tensor * node = nullptr;
+    // the destination rows: row r is cell r
+    const ggml_tensor * rows = nullptr;
+    skippy_receipt_value source;
+};
+
+// Part of a recurrent state's storage, laid out as a view of it would be:
+// one state per column.
+struct skippy_receipt_state_slice {
+    int64_t ne[4] = {1, 1, 1, 1};
+    size_t nb[4] = {0, 0, 0, 0};
+    // bytes from the start of the storage
+    size_t offset = 0;
+    // the axis of the ubatch's sequences, SKIPPY_RECEIPT_AXIS_SINGLE for
+    // one sequence, negative when the sequences cannot be followed
+    int32_t axis = -1;
+};
+
+// A recurrent state of one sequence per column: what a token-mixing region
+// reads before the ubatch, and what it writes back after it.
+struct skippy_receipt_state {
+    // canonical storage of the state
+    const ggml_tensor * storage = nullptr;
+    skippy_receipt_value read;
+    // the node that writes the state back (a CPY or SET_ROWS into the
+    // storage), null when the region writes nothing back
+    ggml_tensor * write = nullptr;
+    // Where the write leaves the most recent state of each sequence. A
+    // region may also write rollback snapshots of earlier states, in any
+    // order of rows; they lie after the most recent one in the storage. The
+    // state is read from the storage once the write has run, so it does not
+    // depend on how the write orders its rows.
+    skippy_receipt_state_slice left;
+};
+
+// A discrete choice made by glue (MoE routing).
+struct skippy_receipt_selection {
+    ggml_tensor * node = nullptr;
+    skippy_receipt_value scores;
+    skippy_receipt_value output;
+};
+
+struct skippy_receipt_layer_plan {
+    int32_t layer = -1;
+    skippy_receipt_value entry;
+    skippy_receipt_value exit;
+    std::vector<skippy_receipt_matmul> matmuls;
+    // per-token values entering token-mixing regions
+    std::vector<skippy_receipt_value> mixing_inputs;
+    std::vector<skippy_receipt_store> stores;
+    // values leaving token-mixing regions, as their non-view producers
+    std::vector<skippy_receipt_value> mixing_outputs;
+    std::vector<skippy_receipt_selection> selections;
+    // recurrent states the token-mixing regions read and write
+    std::vector<skippy_receipt_state> states;
+    // weights read inside token-mixing regions, which nothing checks
+    std::vector<const ggml_tensor *> unchecked_weights;
+};
+
+// What the classifier needs to know about a graph besides its nodes.
+struct skippy_receipt_graph_facts {
+    struct layer_bounds {
+        int32_t layer = -1;
+        ggml_tensor * entry = nullptr;
+        ggml_tensor * exit = nullptr;
+    };
+    // ascending, contiguous layers
+    std::vector<layer_bounds> layers;
+    // canonical storage of persistent state (KV and recurrent caches)
+    std::unordered_set<const ggml_tensor *> state_storage;
+    // the recurrent caches among them: one state per sequence
+    std::unordered_set<const ggml_tensor *> recurrent_storage;
+    // per-token graph inputs the client sets itself from positions
+    std::unordered_set<const ggml_tensor *> client_inputs;
+    // Constants of the context: persistent tensors that hold no per-token
+    // data, that no graph writes, and that the client's own context builds
+    // with the same values from the model and the cache types (the rotations
+    // of a quantized KV cache). They are no model weights, even where their
+    // buffer is marked as one: a product with one is glue, not a weight
+    // matmul the client checks against the GGUF.
+    std::unordered_set<const ggml_tensor *> constant_inputs;
+    // indices of the output rows among the tokens
+    std::unordered_set<const ggml_tensor *> output_indices;
+    // the KV cell of every token, as row indices for cache writes
+    std::unordered_set<const ggml_tensor *> cell_indices;
+    // graph inputs that tell a token-mixing op which persistent state it
+    // reads: attention masks, the cells an indexer gathers, the states a
+    // recurrent op continues. The stage sets them from the cache layout, not
+    // from token values, so a token-mixing region may read them.
+    std::unordered_set<const ggml_tensor *> state_selectors;
+    std::function<bool(const ggml_tensor *)> is_weight;
+    int64_t n_tokens = 0;
+    // sequences of the ubatch, each a run of n_tokens / n_seqs tokens
+    int64_t n_seqs = 1;
+};
+
+// Weights read inside token-mixing regions may total at most this fraction
+// of the layer's weight bytes (guard 2).
+constexpr double SKIPPY_RECEIPT_MAX_UNCHECKED_WEIGHTS = 0.01;
+
+// Classifies every layer in `facts.layers`. Returns an empty string, or why
+// the graph cannot be receipted.
+std::string skippy_receipt_classify(
+        ggml_cgraph * gf,
+        const skippy_receipt_graph_facts & facts,
+        std::vector<skippy_receipt_layer_plan> & plans);
+
+// Number of token columns of a value.
+int64_t skippy_receipt_columns(const skippy_receipt_value & value);
diff --git a/src/skippy/receipts_mixing_state.cpp b/src/skippy/receipts_mixing_state.cpp
new file mode 100644
index 000000000..2996be495
--- /dev/null
+++ b/src/skippy/receipts_mixing_state.cpp
@@ -0,0 +1,156 @@
+// The recurrent states a layer's token-mixing regions read and write.
+
+#include "receipts_mixing_state.h"
+#include "receipts_values.h"
+
+#include "ggml.h"
+
+#include <unordered_map>
+
+using skippy_receipt_values::root_of;
+
+namespace {
+
+// Views, gathers and copies a state read may pass through, at most.
+constexpr int MAX_HOPS = 8;
+
+// The recurrent storage `t` holds values of, through views, the gather of
+// the ubatch's sequences and copies, or null.
+const ggml_tensor * read_storage(const ggml_tensor * t, const std::unordered_set<const ggml_tensor *> & storage) {
+    for (int hop = 0; t != nullptr && hop < MAX_HOPS; ++hop) {
+        if (storage.count(t) != 0) {
+            return t;
+        }
+        if (t->view_src != nullptr) {
+            t = t->view_src;
+        } else if (t->op == GGML_OP_GET_ROWS || t->op == GGML_OP_CONT || t->op == GGML_OP_DUP) {
+            t = t->src[0];
+        } else {
+            return nullptr;
+        }
+    }
+    return nullptr;
+}
+
+// The axis whose columns are the ubatch's sequences, outermost, or -1.
+int32_t sequence_axis(const ggml_tensor * t, int64_t n_seqs) {
+    if (n_seqs == 1) {
+        return SKIPPY_RECEIPT_AXIS_SINGLE;
+    }
+    for (int32_t axis = GGML_MAX_DIMS - 1; axis >= 0; --axis) {
+        if (t->ne[axis] != 1) {
+            return t->ne[axis] == n_seqs ? axis : -1;
+        }
+    }
+    return -1;
+}
+
+// The destination of a node that writes into recurrent storage, or null: the
+// region writes a state back. CPY copies into src[1]; SET_ROWS, which keeps
+// its operands as (source, indices, destination), writes rows of src[2].
+const ggml_tensor * written_destination(const ggml_tensor * node, const std::unordered_set<const ggml_tensor *> & storage) {
+    const ggml_tensor * dst = node->op == GGML_OP_CPY ? node->src[1] : node->op == GGML_OP_SET_ROWS ? node->src[2] : nullptr;
+    return dst != nullptr && storage.count(root_of(dst)) != 0 ? dst : nullptr;
+}
+
+// Where a write to `dst`, a view of recurrent storage, leaves the most recent
+// state of the ubatch's sequences.
+//
+// The storage holds one state per row. A destination steps through the
+// values of a state with strides below the row's, through the cells of the
+// ubatch's sequences with the row's stride, and through rollback snapshots of
+// earlier states with a larger stride: a memory that keeps them for
+// speculative decoding stores each snapshot group after the one before it,
+// the most recent first. The slice keeps the first two and takes the first
+// snapshot. Its axis is negative when the destination is no such view.
+skippy_receipt_state_slice left_slice(const ggml_tensor * dst, int64_t n_seqs) {
+    skippy_receipt_state_slice slice;
+    const ggml_tensor * storage = root_of(dst);
+    const size_t row = storage->nb[1];
+    const size_t element = ggml_type_size(storage->type);
+    slice.offset = dst->view_src != nullptr ? dst->view_offs : 0;
+    if (row == 0 || dst->type != storage->type || dst->nb[0] != element || storage->ne[2] != 1 || storage->ne[3] != 1) {
+        return slice;
+    }
+    int kept = 0;
+    int32_t axis = -1;
+    // bytes of a row the state's values reach, from the start of the slice
+    size_t extent = element;
+    for (int d = 0; d < GGML_MAX_DIMS; ++d) {
+        if (dst->ne[d] == 1) {
+            continue;
+        }
+        if (dst->nb[d] >= row) {
+            if (dst->nb[d] % row != 0) {
+                return slice;
+            }
+            if (dst->nb[d] != row || dst->ne[d] != n_seqs || n_seqs == 1 || axis >= 0) {
+                continue;  // snapshots: the most recent is the first
+            }
+            axis = kept;
+        } else {
+            extent += static_cast<size_t>(dst->ne[d] - 1) * dst->nb[d];
+        }
+        slice.ne[kept] = dst->ne[d];
+        slice.nb[kept] = dst->nb[d];
+        ++kept;
+    }
+    for (int d = kept; d < GGML_MAX_DIMS; ++d) {
+        slice.nb[d] = d == 0 ? element : slice.nb[d - 1] * static_cast<size_t>(slice.ne[d - 1]);
+    }
+    const size_t end = slice.offset + static_cast<size_t>(n_seqs - 1) * row + extent;
+    if (slice.offset % row + extent > row || end > ggml_nbytes(storage) || (n_seqs > 1 && axis < 0)) {
+        return slice;
+    }
+    slice.axis = n_seqs == 1 ? SKIPPY_RECEIPT_AXIS_SINGLE : axis;
+    return slice;
+}
+
+}  // namespace
+
+std::string skippy_receipt_find_states(ggml_cgraph * gf, int lo, int hi, const skippy_receipt_state_scan & scan,
+        std::vector<skippy_receipt_state> & states) {
+    states.clear();
+    std::unordered_map<const ggml_tensor *, size_t> by_storage;
+    std::unordered_set<const ggml_tensor *> seen;
+    for (int i = lo + 1; i <= hi; ++i) {
+        ggml_tensor * node = ggml_graph_node(gf, i);
+        if (!scan.in_region(node)) {
+            continue;
+        }
+        if (const ggml_tensor * dst = written_destination(node, *scan.storage)) {
+            const auto found = by_storage.find(root_of(dst));
+            if (found == by_storage.end()) {
+                return std::string("token-mixing node ") + node->name + " writes a state its region did not read";
+            }
+            // of several writes, the one that reaches the start of the
+            // storage's snapshots leaves the most recent state
+            auto & state = states[found->second];
+            const skippy_receipt_state_slice left = left_slice(dst, scan.n_seqs);
+            if (state.write == nullptr || left.offset < state.left.offset) {
+                state.write = node;
+                state.left = left;
+            }
+            continue;
+        }
+        for (ggml_tensor * src : node->src) {
+            if (src == nullptr || scan.in_region(src) || !seen.insert(src).second) {
+                continue;
+            }
+            const ggml_tensor * storage = read_storage(src, *scan.storage);
+            if (storage == nullptr) {
+                continue;
+            }
+            const int32_t axis = sequence_axis(src, scan.n_seqs);
+            if (by_storage.count(storage) != 0 || axis < 0) {
+                return std::string("cannot follow the sequences of state ") + src->name;
+            }
+            by_storage[storage] = states.size();
+            skippy_receipt_state state;
+            state.storage = storage;
+            state.read = {src, axis};
+            states.push_back(state);
+        }
+    }
+    return {};
+}
