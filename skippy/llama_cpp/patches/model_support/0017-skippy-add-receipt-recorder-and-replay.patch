+// The indexed draw of a receipted turn: the uniform is the one a receipt's
+// client computes, and the pick walks the candidates in token id order
+// whatever order the chain left them in.
+
+#include "../src/skippy/receipts_draw.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+int failures = 0;
+
+void check(bool ok, const char * what) {
+    if (!ok) {
+        std::fprintf(stderr, "FAIL: %s\n", what);
+        ++failures;
+    }
+}
+
+struct vector_case {
+    uint32_t seed;
+    uint64_t index;
+    uint64_t bits; // the uniform times 2^53
+};
+
+// Shared with skippy-receipts (head/draw.rs): both sides must agree.
+const vector_case VECTORS[] = {
+    {0u, 0ull, 0x1c4415072f63b9ull},
+    {0u, 1ull, 0x122145bd91204bull},
+    {0u, 4096ull, 0x1ae75347b283cfull},
+    {1u, 0ull, 0x18858b43547040ull},
+    {1u, 7ull, 0x04f9e2e0f8dc3aull},
+    {42u, 1ull, 0x0d32e6600c0afeull},
+    {42u, 4294967295ull, 0x1f14ea3899a69full},
+    {4294967295u, 4096ull, 0x00ca3fff389d1dull},
+    {123456789u, 7ull, 0x1f660139cb7f55ull},
+};
+
+void uniform_matches_the_shared_vectors() {
+    for (const auto & v : VECTORS) {
+        const double u = skippy_receipt_draw_uniform(v.seed, v.index);
+        check(u == static_cast<double>(v.bits) * 0x1.0p-53, "uniform vector");
+        check(u >= 0.0 && u < 1.0, "uniform range");
+    }
+    // only the low 32 bits of the index enter
+    check(skippy_receipt_draw_uniform(7, 5) == skippy_receipt_draw_uniform(7, (1ull << 32) + 5), "index width");
+}
+
+llama_token pick(std::vector<llama_token_data> data, double u) {
+    return data[skippy_receipt_draw_pick(data.data(), data.size(), u)].id;
+}
+
+void pick_walks_token_ids_in_order() {
+    // weights 1, 2, 1 for tokens 3, 5, 9: boundaries at 0.25 and 0.75
+    const float l = 0.0f;
+    const float h = std::log(2.0f);
+    const std::vector<llama_token_data> ascending = {{3, l, 0}, {5, h, 0}, {9, l, 0}};
+    const std::vector<llama_token_data> by_logit = {{5, h, 0}, {9, l, 0}, {3, l, 0}};
+    for (const auto & data : {ascending, by_logit}) {
+        check(pick(data, 0.0) == 3, "u = 0 picks the lowest id");
+        check(pick(data, 0.24) == 3, "below the first boundary");
+        check(pick(data, 0.26) == 5, "above the first boundary");
+        check(pick(data, 0.74) == 5, "below the second boundary");
+        check(pick(data, 0.76) == 9, "above the second boundary");
+        check(pick(data, 0.9999999) == 9, "u near 1 picks the highest id");
+    }
+    // a candidate a sampler turned off is never picked
+    const float off = -INFINITY;
+    const std::vector<llama_token_data> masked = {{1, off, 0}, {2, l, 0}, {4, off, 0}};
+    check(pick(masked, 0.0) == 2 && pick(masked, 0.999) == 2, "masked candidates weigh nothing");
+    // probabilities are normalized in place
+    auto data = by_logit;
+    skippy_receipt_draw_pick(data.data(), data.size(), 0.5);
+    check(std::fabs(data[0].p - 0.5f) < 1e-6f && std::fabs(data[1].p - 0.25f) < 1e-6f, "normalized p");
+}
+
+void a_large_unordered_set_is_walked_in_id_order() {
+    // more candidates than a sort handles, in descending id order, equal weights
+    const size_t n = 10000;
+    std::vector<llama_token_data> data;
+    for (size_t i = 0; i < n; ++i) {
+        data.push_back({static_cast<llama_token>(n - 1 - i), 0.0f, 0});
+    }
+    check(pick(data, 0.0) == 0, "lowest id first");
+    check(pick(data, 0.50001) == 5000, "the middle id at the middle of the mass");
+    check(pick(data, 0.99999) == static_cast<llama_token>(n - 1), "highest id last");
+}
+
+void the_draw_replaces_a_dist_sampler_and_follows_its_index() {
+    auto * chain = llama_sampler_chain_init(llama_sampler_chain_default_params());
+    llama_sampler_chain_add(chain, llama_sampler_init_top_k(40));
+    check(!skippy_receipt_draw_install(chain, 42), "a chain that does not end in dist is left alone");
+    llama_sampler_chain_add(chain, llama_sampler_init_dist(42));
+    check(skippy_receipt_draw_install(chain, 42), "dist is replaced");
+    check(llama_sampler_chain_n(chain) == 2, "the chain keeps its length");
+    check(std::strcmp(llama_sampler_name(llama_sampler_chain_get(chain, 1)), "skippy-indexed-draw") == 0, "name");
+
+    const std::vector<llama_token_data> candidates = {{3, 0.0f, 0}, {5, std::log(2.0f), 0}, {9, 0.0f, 0}};
+    for (const uint64_t index : {0ull, 1ull, 7ull, 4096ull}) {
+        auto data = candidates;
+        llama_token_data_array cur = {data.data(), data.size(), -1, false};
+        skippy_receipt_draw_set_index(chain, index);
+        llama_sampler_apply(chain, &cur);
+        check(cur.selected >= 0, "a token is selected");
+        const double u = skippy_receipt_draw_uniform(42, index);
+        const llama_token expected = u < 0.25 ? 3 : u < 0.75 ? 5 : 9;
+        check(cur.selected >= 0 && cur.data[cur.selected].id == expected, "the chain draws with the indexed uniform");
+    }
+    // a clone keeps the seed and the index
+    skippy_receipt_draw_set_index(chain, 7);
+    auto * clone = llama_sampler_clone(chain);
+    auto data = candidates;
+    llama_token_data_array cur = {data.data(), data.size(), -1, false};
+    llama_sampler_apply(clone, &cur);
+    const double u = skippy_receipt_draw_uniform(42, 7);
+    check(cur.data[cur.selected].id == (u < 0.25 ? 3 : u < 0.75 ? 5 : 9), "clone");
+    llama_sampler_free(clone);
+    llama_sampler_free(chain);
+}
+
+} // namespace
+
+int main() {
+    uniform_matches_the_shared_vectors();
+    pick_walks_token_ids_in_order();
+    a_large_unordered_set_is_walked_in_id_order();
+    the_draw_replaces_a_dist_sampler_and_follows_its_index();
+    if (failures != 0) {
+        std::fprintf(stderr, "%d check(s) failed\n", failures);
+        return 1;
+    }
+    std::printf("receipt draw: ok\n");
+    return 0;
+}
