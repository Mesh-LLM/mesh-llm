+// KV cells a replay needs: every step's forced cells lie below its n_kv.
+uint32_t replay_cells(const skippy_receipt_replay_step * steps, size_t n_steps) {
+    uint32_t cells = 0;
+    for (size_t index = 0; index < n_steps; ++index) {
+        if (steps[index].kind == SKIPPY_RECEIPT_REPLAY_DECODE && steps[index].n_kv > 0) {
+            cells = std::max(cells, steps[index].n_kv);
+        }
+    }
+    return cells;
+}
+
+// The stage context keeps every row through its last layer when an MTP head
+// reads the hidden state of each, so a replay keeps them too: the last
+// layer then computes the rows the stage computed.
+void match_stage_outputs(const skippy_model * model, llama_context * scratch) {
+    const llama_cparams & stage = model->ctx->get_cparams();
+    scratch->set_embeddings_nextn(stage.embeddings_nextn, stage.embeddings_nextn_masked);
+}
+
+// Creates the replay context with room for `cells` KV cells, or keeps the
+// current one if it has that room. It is sized to the replay, not to the
+// stage context, so an opening does not hold a second full KV cache. The
+// batch sizes stay the stage's, so every step computes the same graph.
+enum skippy_status ensure_scratch(
+        skippy_model * model, skippy_receipt_scratch & scratch, uint32_t cells, skippy_error ** out_error) {
+    if (scratch.ctx != nullptr && scratch.cells >= cells) {
+        match_stage_outputs(model, scratch.ctx);
+        return SKIPPY_STATUS_OK;
+    }
+    llama_free(scratch.ctx);
+    scratch.ctx = nullptr;
+    scratch.cells = 0;
+    if (!model->has_receipt_ctx_params) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the stage context parameters were not kept");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    scratch.capture = std::make_shared<skippy_receipt_capture>();
+    scratch.capture->n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model->model));
+    scratch.capture->f32_matmuls = skippy_receipt_needs_f32_matmuls(model->model);
+    scratch.capture->f32_attention = skippy_receipt_needs_f32_attention(model->model);
+    llama_context_params params = model->receipt_ctx_params;
+    // the batch is clamped to the context, so the context holds a full batch
+    constexpr uint32_t CELL_PADDING = 256;
+    const uint32_t wanted = std::max({cells, params.n_batch, params.n_ubatch});
+    const uint32_t padded = (wanted + CELL_PADDING - 1) / CELL_PADDING * CELL_PADDING;
+    // a cache that is not unified holds `n_ctx` over a stream per sequence
+    const uint32_t streams = params.kv_unified ? 1 : std::max<uint32_t>(params.n_seq_max, 1);
+    if (params.n_ctx == 0 || padded * streams < params.n_ctx) {
+        params.n_ctx = padded * streams;
+    }
+    params.cb_eval = skippy_receipt_eval;
+    params.cb_eval_user_data = scratch.capture.get();
+    params.samplers = nullptr;
+    params.n_samplers = 0;
+    scratch.ctx = llama_init_from_model_with_graph_inputs(
+            model->model, params, skippy_graph_build_inputs_from_config(&model->config));
+    if (scratch.ctx == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to create the receipt replay context");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (plain_kv_cache(scratch.ctx) == nullptr) {
+        // not kept: a later call would take it for a replay context
+        llama_free(scratch.ctx);
+        scratch.ctx = nullptr;
+        scratch.capture.reset();
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the replay context has no plain KV cache");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    scratch.capture->windows =
+            skippy_receipt_attention_windows(model->model, scratch.ctx->get_cparams().causal_attn);
+    scratch.cells = plain_kv_cache(scratch.ctx)->get_size();
+    scratch.ctx->set_receipt_capture(scratch.capture);
+    match_stage_outputs(model, scratch.ctx);
+    return SKIPPY_STATUS_OK;
+}
+
+// Why a replay cannot run a step, or an empty string. Its sequences must be
+// sequences of the context, its cells must fit the context's cache, and its
+// input must be the stage's one imported row per token: the graph asserts
+// on an input of another shape.
+std::string step_error(const skippy_model * model, const skippy_receipt_replay_step & step, uint32_t n_seq_max,
+        uint32_t cells) {
+    if (step.kind == SKIPPY_RECEIPT_REPLAY_SEQ_RM) {
+        return {};
+    }
+    if (step.kind != SKIPPY_RECEIPT_REPLAY_DECODE || step.n_tokens <= 0 || step.token == nullptr ||
+            step.seq == nullptr || step.pos == nullptr || step.output == nullptr || step.cell == nullptr) {
+        return "malformed receipt replay step";
+    }
+    for (int32_t i = 0; i < step.n_tokens; ++i) {
+        if (step.seq[i] < 0 || static_cast<uint32_t>(step.seq[i]) >= n_seq_max) {
+            return "a replay step names sequence " + std::to_string(step.seq[i]) + ", which the context does not hold";
+        }
+    }
+    if (step.n_kv > cells) {
+        return "a replay step covers " + std::to_string(step.n_kv) + " KV cells, the replay cache holds " +
+               std::to_string(cells);
+    }
+    if (step.input == nullptr) {
+        return {};
+    }
+    ggml_type type = GGML_TYPE_COUNT;
+    int64_t width = 0;
+    if (!skippy_receipt_stage_input(*model, type, width)) {
+        return "a replay step has input rows, but the stage does not import one row per token";
+    }
+    if (step.input_type != type || step.input_row_bytes != static_cast<int64_t>(ggml_row_size(type, width))) {
+        return "a replay step's input rows are not the " + std::to_string(width) + " " + ggml_type_name(type) +
+               " values the stage imports";
+    }
+    return {};
+}
+
+enum skippy_status replay_decode(
+        skippy_model * model,
+        llama_context * ctx,
+        llama_kv_cache * kv,
+        const skippy_receipt_replay_step & step,
+        skippy_error ** out_error) {
+    const auto n = static_cast<size_t>(step.n_tokens);
+    std::vector<llama_token> tokens(step.token, step.token + n);
+    std::vector<llama_pos> positions = skippy_receipt_batch_positions(model->model, step.pos, n);
+    std::vector<int32_t> n_seq_id(n, 1);
+    std::vector<llama_seq_id> seq_values(step.seq, step.seq + n);
+    std::vector<llama_seq_id *> seq_ids(n);
+    std::vector<int8_t> logits(step.output, step.output + n);
+    for (size_t i = 0; i < n; ++i) {
+        seq_ids[i] = &seq_values[i];
+    }
+    skippy_graph_build_inputs inputs = skippy_graph_build_inputs_from_config(&model->config);
+    skippy_graph_build_inputs_set_activation_tokens(inputs, tokens.data(), n);
+    if (step.input != nullptr) {
+        // step_error() checked the type and the row size
+        const size_t element = ggml_type_size(static_cast<ggml_type>(step.input_type));
+        skippy_activation_frontier_part_input part;
+        part.values = step.input;
+        part.payload_bytes = static_cast<uint64_t>(step.input_row_bytes) * n;
+        part.ggml_type = static_cast<uint32_t>(step.input_type);
+        part.rank = 2;
+        part.token_axis = 1;
+        part.dimensions[0] = step.input_row_bytes / static_cast<int64_t>(element);
+        part.dimensions[1] = static_cast<int64_t>(n);
+        part.byte_strides[0] = element;
+        part.byte_strides[1] = static_cast<uint64_t>(step.input_row_bytes);
+        part.pos_start = n > 0 ? step.pos[0] : 0;
+        inputs.activation_frontier.push_back(part);
+    }
+    llama_batch batch = {
+        step.n_tokens, tokens.data(), nullptr, positions.data(), n_seq_id.data(), seq_ids.data(), logits.data(),
+    };
+    kv->receipt_forced_cells.assign(step.cell, step.cell + n);
+    kv->receipt_forced_n_kv = step.n_kv;
+    int32_t rc = 0;
+    const bool contained = skippy_contain_native_failure(out_error, [&] { rc = ctx->decode(batch, inputs); });
+    kv->receipt_forced_cells.clear();
+    kv->receipt_forced_n_kv = 0;
+    if (!contained) {
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (rc != 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "a receipt replay step failed to decode");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    return SKIPPY_STATUS_OK;
+}
+
+bool valid_anchors(const std::vector<int32_t> & layers, const skippy_receipt_replay_step * steps, size_t n_steps,
+        const skippy_receipt_anchor * anchors, size_t n_anchors) {
+    if (anchors == nullptr) {
+        return n_anchors == 0;
+    }
+    for (size_t i = 0; i < n_anchors; ++i) {
+        const auto & a = anchors[i];
+        const bool kind = a.kind == SKIPPY_RECEIPT_TENSOR_RESIDUAL || a.kind == SKIPPY_RECEIPT_TENSOR_MIXING_OUTPUT;
+        if (!kind || a.values == nullptr || a.len <= 0 || a.step >= n_steps ||
+                steps[a.step].kind != SKIPPY_RECEIPT_REPLAY_DECODE ||
+                !std::binary_search(layers.begin(), layers.end(), a.layer)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+enum skippy_status replay_receipt(
+        struct skippy_model * model,
+        int32_t seq,
+        const int32_t * layers,
+        size_t n_layers,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        bool committed_only,
+        const skippy_receipt_anchor * anchors,
+        size_t n_anchors,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->model == nullptr || (steps == nullptr && n_steps > 0) || on_capture == nullptr ||
+            layers == nullptr || n_layers == 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                "model, layers, steps and a capture callback are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    std::vector<int32_t> wanted(layers, layers + n_layers);
+    if (!std::is_sorted(wanted.begin(), wanted.end()) ||
+            std::adjacent_find(wanted.begin(), wanted.end()) != wanted.end()) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "replayed layers must be sorted and distinct");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (!valid_anchors(wanted, steps, n_steps, anchors, n_anchors)) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                "an anchor needs values, one of the replayed layers and a decode step");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto scratch = model->receipt_scratch;
+    if (!scratch) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the model cannot replay receipts");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    std::lock_guard<std::mutex> lock(scratch->mutex);
+    const uint32_t cells = replay_cells(steps, n_steps);
+    if (scratch->seeded == seq && scratch->cells < cells) {
+        scratch->seeded = -1;
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "the replay needs more cells than were seeded");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    enum skippy_status status = ensure_scratch(model, *scratch, cells, out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    llama_context * ctx = scratch->ctx;
+    llama_kv_cache * kv = plain_kv_cache(ctx);
+    llama_memory_t memory = ctx->get_memory();
+    // checked before anything changes the cache: its operations assert on a
+    // sequence it does not hold
+    const uint32_t n_seq_max = llama_n_seq_max(ctx);
+    std::string invalid;
+    if (kv == nullptr) {
+        invalid = "the replay context has no plain KV cache";
+    } else if (seq < 0 || static_cast<uint32_t>(seq) >= n_seq_max) {
+        invalid = "the replayed sequence " + std::to_string(seq) + " is not a sequence of the context";
+    }
+    for (size_t index = 0; index < n_steps && invalid.empty(); ++index) {
+        invalid = step_error(model, steps[index], n_seq_max, scratch->cells);
+    }
+    if (!invalid.empty()) {
+        scratch->seeded = -1;
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, invalid.c_str());
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    // a seeded replay starts from the copied cells, any other from nothing
+    if (scratch->seeded != seq) {
+        llama_memory_clear(memory, false);
+    }
+    scratch->seeded = -1;
+
+    auto & capture = *scratch->capture;
+    capture.on_ubatch = on_capture;
+    capture.user_data = user_data;
+    capture.mode = skippy_receipt_mode::replay;
+    capture.anchors = anchors;
+    capture.n_anchors = n_anchors;
+    capture.anchors_written = 0;
+    if (capture.layers != wanted || capture.committed_only != committed_only) {
+        capture.layers = std::move(wanted);
+        capture.committed_only = committed_only;
+        // the next ubatch rebuilds its graph with these layers' matmuls marked
+        ctx->set_receipt_capture(scratch->capture);
+    }
+    for (size_t index = 0; index < n_steps && status == SKIPPY_STATUS_OK; ++index) {
+        const auto & step = steps[index];
+        if (step.kind == SKIPPY_RECEIPT_REPLAY_SEQ_RM) {
+            llama_memory_seq_rm(memory, seq, step.p0, step.p1);
+            continue;
+        }
+        capture.step = static_cast<int64_t>(index);
+        capture.report = step.capture != 0;
+        status = replay_decode(model, ctx, kv, step, out_error);
+        std::set<llama_seq_id> foreign;
+        for (int32_t i = 0; i < step.n_tokens; ++i) {
+            if (step.seq[i] != seq) foreign.insert(step.seq[i]);
+        }
+        for (const llama_seq_id other : foreign) {
+            llama_memory_seq_rm(memory, other, -1, -1);
+        }
+    }
+    const bool anchored = capture.anchors_written == n_anchors;
+    capture.anchors = nullptr;
+    capture.n_anchors = 0;
+    capture.on_ubatch = nullptr;
+    capture.user_data = nullptr;
+    llama_memory_clear(memory, false);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    if (!anchored) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "an anchor matched no token the replay computed");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    return skippy_success(out_error);
+}
+
+}  // namespace
+
+enum skippy_status skippy_model_replay_receipt(
+        struct skippy_model * model,
+        int32_t seq,
+        const int32_t * layers,
+        size_t n_layers,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    return replay_receipt(model, seq, layers, n_layers, steps, n_steps, false, nullptr, 0, on_capture, user_data, out_error);
+}
+
+enum skippy_status skippy_model_replay_receipt_committed(
+        struct skippy_model * model,
+        int32_t seq,
+        const int32_t * layers,
+        size_t n_layers,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    return replay_receipt(model, seq, layers, n_layers, steps, n_steps, true, nullptr, 0, on_capture, user_data, out_error);
+}
+
+enum skippy_status skippy_model_replay_receipt_anchored(
+        struct skippy_model * model,
+        int32_t seq,
+        const int32_t * layers,
+        size_t n_layers,
+        const struct skippy_receipt_replay_step * steps,
+        size_t n_steps,
+        const struct skippy_receipt_anchor * anchors,
+        size_t n_anchors,
+        skippy_receipt_ubatch_fn on_capture,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    return replay_receipt(
+            model, seq, layers, n_layers, steps, n_steps, false, anchors, n_anchors, on_capture, user_data, out_error);
+}
+
+enum skippy_status skippy_model_seed_receipt_replay(
+        struct skippy_model * model,
+        int32_t seq,
+        const uint32_t * cells,
+        const int32_t * pos,
+        size_t n_seeded,
+        uint32_t n_cells,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->model == nullptr || model->ctx == nullptr || seq < 0 ||
+            (n_seeded > 0 && (cells == nullptr || pos == nullptr))) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model, sequence, cells and positions are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto scratch = model->receipt_scratch;
+    llama_kv_cache * live = plain_kv_cache(model->ctx);
+    if (!scratch || live == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the model cannot replay receipts");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    std::lock_guard<std::mutex> lock(scratch->mutex);
+    scratch->seeded = -1;
+    enum skippy_status status = ensure_scratch(model, *scratch, n_cells, out_error);
+    if (status != SKIPPY_STATUS_OK) {
+        return status;
+    }
+    llama_memory_clear(scratch->ctx->get_memory(), false);
+    std::vector<uint32_t> wanted(cells, cells + n_seeded);
+    std::vector<llama_pos> positions(pos, pos + n_seeded);
+    std::string error;
+    bool seeded = false;
+    const bool contained = skippy_contain_native_failure(out_error, [&] {
+        // the stage context may still be computing its last ubatch
+        model->ctx->synchronize();
+        seeded = plain_kv_cache(scratch->ctx)->receipt_seed_from(*live, seq, wanted, positions, error);
+    });
+    if (!contained) {
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (!seeded) {
+        llama_memory_clear(scratch->ctx->get_memory(), false);
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, error.c_str());
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    scratch->seeded = seq;
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_model_seed_receipt_state(
+        struct skippy_model * model,
+        int32_t seq,
+        const void * bytes,
+        size_t n_bytes,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || seq < 0 || bytes == nullptr || n_bytes == 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model, sequence and state bytes are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto scratch = model->receipt_scratch;
+    if (!scratch) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the model cannot replay receipts");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    std::lock_guard<std::mutex> lock(scratch->mutex);
+    if (scratch->ctx == nullptr || scratch->seeded != seq) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                "the replay's KV cells must be seeded before its recurrent state");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    std::string error;
+    bool read = false;
+    const bool contained = skippy_contain_native_failure(out_error, [&] {
+        read = skippy_receipt_read_state(*scratch->ctx, seq, static_cast<const uint8_t *>(bytes), n_bytes, error);
+    });
+    if (!contained || !read) {
+        scratch->seeded = -1;
+        llama_memory_clear(scratch->ctx->get_memory(), false);
+        if (contained) {
+            skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, error.c_str());
+        }
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_model_read_receipt_rows(
+        struct skippy_model * model,
+        int32_t layer,
+        int32_t seq,
+        const uint32_t * cells,
+        size_t n_cells,
+        skippy_receipt_ubatch_fn on_rows,
+        void * user_data,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->ctx == nullptr || on_rows == nullptr || layer < 0 || seq < 0 ||
+            seq >= static_cast<int32_t>(llama_n_seq_max(model->ctx)) || (n_cells > 0 && cells == nullptr)) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                "model, layer, a sequence of the context, cells and callback are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    llama_kv_cache * kv = plain_kv_cache(model->ctx);
+    if (kv == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "receipts need a plain KV cache");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    // the cache tensors hold the streams one after another
+    const size_t first_row = static_cast<size_t>(kv->get_stream(seq)) * kv->get_size();
+    auto recorder = model->receipt_recorder.lock();
+    if (!recorder) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the receipt recorder is not installed");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    std::vector<skippy_receipt_cache_rows> stores;
+    for (const auto & rows : recorder->cache_rows) {
+        if (rows.layer == layer) {
+            stores.push_back(rows);
+        }
+    }
+    std::sort(stores.begin(), stores.end(),
+            [](const skippy_receipt_cache_rows & a, const skippy_receipt_cache_rows & b) { return a.index < b.index; });
+    if (stores.empty()) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "the stage stored no rows for this layer");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    std::vector<std::vector<uint8_t>> values(stores.size());
+    std::string error;
+    const bool contained = skippy_contain_native_failure(out_error, [&] {
+        // the stage context may still be computing its last ubatch
+        model->ctx->synchronize();
+        for (size_t s = 0; s < stores.size() && error.empty(); ++s) {
+            const auto & rows = stores[s];
+            const size_t row_bytes = ggml_row_size(rows.type, rows.len);
+            values[s].resize(row_bytes * n_cells);
+            for (size_t j = 0; j < n_cells;) {
+                // packed rows of consecutive cells are read at once
+                size_t run = 1;
+                while (rows.stride == row_bytes && j + run < n_cells && cells[j + run] == cells[j] + run) {
+                    ++run;
+                }
+                const size_t offset = rows.offset + (first_row + cells[j]) * rows.stride;
+                if (offset + row_bytes * run > ggml_nbytes(rows.root)) {
+                    error = "a cell past the end of the cache";
+                    break;
+                }
+                ggml_backend_tensor_get(rows.root, values[s].data() + j * row_bytes, offset, row_bytes * run);
+                j += run;
+            }
+        }
+    });
+    if (!contained) {
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (!error.empty()) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, error.c_str());
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    std::vector<skippy_receipt_tensor> tensors;
+    for (size_t s = 0; s < stores.size(); ++s) {
+        const auto & rows = stores[s];
+        skippy_receipt_tensor tensor = {};
+        tensor.layer = layer;
+        tensor.kind = SKIPPY_RECEIPT_TENSOR_MIXING_STORED;
+        tensor.index = rows.index;
+        tensor.ggml_type = rows.type;
+        tensor.len = rows.len;
+        tensor.row_bytes = static_cast<int64_t>(ggml_row_size(rows.type, rows.len));
+        tensor.n_cols = static_cast<int64_t>(n_cells);
+        tensor.values = values[s].data();
+        tensor.name = rows.root->name;
+        tensors.push_back(tensor);
+    }
+    const std::vector<int32_t> zeros(n_cells, 0);
+    const std::vector<int8_t> outputs(n_cells, 0);
+    skippy_receipt_ubatch report = {};
+    report.step = -1;
+    report.n_tokens = static_cast<int32_t>(n_cells);
+    report.token = zeros.data();
+    report.seq = zeros.data();
+    report.pos = zeros.data();
+    report.output = outputs.data();
+    report.cell = cells;
+    report.n_tensors = tensors.size();
+    report.tensors = tensors.data();
+    on_rows(user_data, &report);
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_model_pin_receipt_cells(
+        struct skippy_model * model,
+        const uint32_t * streams,
+        const uint32_t * cells,
+        size_t n_cells,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->ctx == nullptr || (n_cells > 0 && (cells == nullptr || streams == nullptr))) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                "model with a context, streams and cells are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    llama_kv_cache * kv = plain_kv_cache(model->ctx);
+    if (kv == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "receipts need a plain KV cache");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    // by row of the cache tensors, which hold the streams one after another
+    std::vector<bool> pinned;
+    if (n_cells > 0) {
+        pinned.assign(static_cast<size_t>(kv->get_size()) * kv->get_n_stream(), false);
+        for (size_t i = 0; i < n_cells; ++i) {
+            if (streams[i] >= kv->get_n_stream() || cells[i] >= kv->get_size()) {
+                skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                        ("cell " + std::to_string(cells[i]) + " of stream " + std::to_string(streams[i]) +
+                                " is outside the KV cache").c_str());
+                return SKIPPY_STATUS_INVALID_ARGUMENT;
+            }
+            pinned[static_cast<size_t>(streams[i]) * kv->get_size() + cells[i]] = true;
+        }
+    }
+    kv->receipt_pin(std::move(pinned));
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_model_receipt_kv_streams(
+        struct skippy_model * model,
+        uint32_t * out_streams,
+        struct skippy_error ** out_error) {
+    if (model == nullptr || model->ctx == nullptr || out_streams == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model with a context and an output are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    llama_kv_cache * kv = plain_kv_cache(model->ctx);
+    if (kv == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "receipts need a plain KV cache");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    *out_streams = kv->get_n_stream();
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_model_release_receipt_scratch(struct skippy_model * model, struct skippy_error ** out_error) {
+    if (model == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "model is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    auto scratch = model->receipt_scratch;
+    if (!scratch) {
+        return skippy_success(out_error);
+    }
+    std::unique_lock<std::mutex> lock(scratch->mutex, std::try_to_lock);
+    if (!lock.owns_lock()) {
+        // a replay holds the context; it stays until the next release
+        return skippy_success(out_error);
+    }
+    llama_free(scratch->ctx);
+    scratch->ctx = nullptr;
+    scratch->capture.reset();
+    scratch->cells = 0;
+    scratch->seeded = -1;
+    scratch->glue.release();
+    scratch->region.release();
+    return skippy_success(out_error);
+}
+
+enum skippy_status skippy_receipt_stored_row_error(
+        int32_t ggml_type,
+        const void * stored,
+        size_t stored_len,
+        const float * computed,
+        int64_t n,
+        double * stored_error,
+        double * rounding_error,
+        double * norm,
+        struct skippy_error ** out_error) {
+    if (ggml_type < 0 || ggml_type >= GGML_TYPE_COUNT || stored == nullptr || computed == nullptr || n <= 0 ||
+            stored_error == nullptr || rounding_error == nullptr || norm == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "a cache type, both rows and the outputs are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const auto type = static_cast<enum ggml_type>(ggml_type);
+    const auto * traits = ggml_get_type_traits(type);
+    if ((type != GGML_TYPE_F32 && traits->to_float == nullptr) || ggml_quantize_requires_imatrix(type) ||
+            ggml_blck_size(type) <= 0 || n % ggml_blck_size(type) != 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED,
+                (std::string("cannot compare stored rows of type ") + ggml_type_name(type)).c_str());
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    // the type and the stored bytes come from the opening an auditor checks:
+    // the row is read only when it is the whole row of that type
+    if (stored_len != ggml_row_size(type, n)) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT,
+                ("a stored row of " + std::to_string(n) + " " + ggml_type_name(type) + " values has " +
+                        std::to_string(ggml_row_size(type, n)) + " bytes, not " + std::to_string(stored_len)).c_str());
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    const auto count = static_cast<size_t>(n);
+    std::vector<float> stored_values(count);
+    std::vector<float> rounded(count);
+    std::vector<uint8_t> quantized(ggml_row_size(type, n));
+    if (type == GGML_TYPE_F32) {
+        std::memcpy(stored_values.data(), stored, count * sizeof(float));
+        std::memcpy(rounded.data(), computed, count * sizeof(float));
+    } else {
+        traits->to_float(stored, stored_values.data(), n);
+        ggml_quantize_chunk(type, computed, quantized.data(), 0, 1, n, nullptr);
+        traits->to_float(quantized.data(), rounded.data(), n);
+    }
+    double stored_sum = 0.0;
+    double rounding_sum = 0.0;
+    double norm_sum = 0.0;
+    for (size_t i = 0; i < count; ++i) {
+        const double c = computed[i];
+        stored_sum += (stored_values[i] - c) * (stored_values[i] - c);
+        rounding_sum += (rounded[i] - c) * (rounded[i] - c);
+        norm_sum += c * c;
+    }
+    *stored_error = std::sqrt(stored_sum);
+    *rounding_error = std::sqrt(rounding_sum);
+    *norm = std::sqrt(norm_sum);
+    return skippy_success(out_error);
+}
