diff --git a/conversion/laguna.py b/conversion/laguna.py
index 29e0b3d6b..748f90f3b 100644
--- a/conversion/laguna.py
+++ b/conversion/laguna.py
@@ -10,6 +10,7 @@ if TYPE_CHECKING:
     from torch import Tensor
 
 from .base import ModelBase, TextModel, gguf, logger
+from .qwen import DFlashModel
 
 
 @ModelBase.register("LagunaForCausalLM")
@@ -206,3 +207,63 @@ class LagunaModel(TextModel):
                     f"declared {gate_type} gate (expected {expected}); weights and config disagree.")
 
         yield from TextModel.modify_tensors(self, data_torch, name, bid)
+
+
+@ModelBase.register("DFlashLagunaForCausalLM")
+@ModelBase.example("poolside/Laguna-XS-2.1-DFlash", "poolside/Laguna-S-2.1-DFlash")
+class DFlashLagunaModel(DFlashModel):
+    """Laguna DFlash drafter: dense Laguna-style draft layers on the DFlash
+    contract. The checkpoint fuses q/k/v (split here), gates the attention
+    output (g_proj), RMS-norms each captured target feature before fc
+    (aux_hidden_norms, stacked here into enc.aux_norm) and attends causally
+    within the noise block. dflash.decoder_arch = "laguna" selects that
+    contract at load. The draft shares embeddings and the output head with
+    the target."""
+
+    model_arch = gguf.MODEL_ARCH.DFLASH
+    _aux_norms: dict[int, Tensor] | None = None
+
+    def set_gguf_parameters(self) -> None:
+        # The dense drafter config carries num_experts = 0; drop the expert
+        # keys so the GGUF does not pair expert_count 0 with a used count.
+        if not self.hparams.get("num_experts") and not self.hparams.get("num_local_experts"):
+            for key in ("num_experts", "num_local_experts", "num_experts_per_tok", "num_experts_per_token"):
+                self.hparams.pop(key, None)
+        super().set_gguf_parameters()
+        self.gguf_writer.add_decoder_arch("laguna")
+
+        # Laguna drafters use sliding-window attention per layer_types, which
+        # the generic DFlash path only writes under use_sliding_window.
+        dflash_config = self.hparams.get("dflash_config", {})
+        generic_swa = self.hparams.get("use_sliding_window", False) or dflash_config.get("use_swa", False)
+        layer_types = self.hparams.get("layer_types") or []
+        sliding_window = self.hparams.get("sliding_window") or 0
+        if not generic_swa and sliding_window > 0 and "sliding_attention" in layer_types:
+            self.gguf_writer.add_sliding_window(sliding_window)
+            self.gguf_writer.add_sliding_window_pattern([t == "sliding_attention" for t in layer_types])
+
+    def modify_tensors(self, data_torch: Tensor, name: str, bid: int | None) -> Iterable[tuple[str, Tensor]]:
+        # Stack the per-feature norms into one [n_aux, n_embd] tensor once all
+        # of them have arrived.
+        if m := re.fullmatch(r"model\.aux_hidden_norms\.(\d+)\.weight", name):
+            if self._aux_norms is None:
+                self._aux_norms = {}
+            self._aux_norms[int(m.group(1))] = data_torch
+            n_aux = len(self.hparams.get("dflash_config", {}).get("target_layer_ids", []))
+            if n_aux and len(self._aux_norms) == n_aux:
+                stacked = torch.stack([self._aux_norms[i] for i in range(n_aux)], dim=0)
+                yield (self.format_tensor_name(gguf.MODEL_TENSOR.ENC_AUX_NORM), stacked)
+            return
+
+        if name.endswith("self_attn.qkv_proj.weight"):
+            head_dim = self.hparams["head_dim"]
+            q_size = self.hparams["num_attention_heads"] * head_dim
+            kv_size = self.hparams["num_key_value_heads"] * head_dim
+            q, k, v = data_torch.split([q_size, kv_size, kv_size], dim=0)
+            base = name.removesuffix("qkv_proj.weight")
+            yield from super().modify_tensors(q, base + "q_proj.weight", bid)
+            yield from super().modify_tensors(k, base + "k_proj.weight", bid)
+            yield from super().modify_tensors(v, base + "v_proj.weight", bid)
+            return
+
+        yield from super().modify_tensors(data_torch, name, bid)
