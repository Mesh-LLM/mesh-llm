diff --git a/src/models/dflash.cpp b/src/models/dflash.cpp
index 6f28d2f1d..7aa2cf710 100644
--- a/src/models/dflash.cpp
+++ b/src/models/dflash.cpp
@@ -106,6 +106,16 @@ void llama_model_dflash::load_arch_hparams(llama_model_loader & ml) {
         return;
     }
 
+    // Laguna drafters follow the Laguna decoder contract: an attention output
+    // gate, a norm per captured target feature, context K/V through each
+    // layer's input norm, and a causal noise block.
+    std::string decoder_arch;
+    ml.get_key(LLM_KV_DFLASH_DECODER_ARCH, decoder_arch, false);
+    if (!decoder_arch.empty() && decoder_arch != "laguna") {
+        throw std::runtime_error("unsupported DFlash decoder architecture: " + decoder_arch);
+    }
+    decoder_laguna = decoder_arch == "laguna";
+
     // optional interleaved sliding-window attention with per-layer pattern array.
     // DFlash has a single rope, so the SWA rope == main rope.
     if (ml.get_key(LLM_KV_ATTENTION_SLIDING_WINDOW, hparams.n_swa, false) && hparams.n_swa > 0) {
@@ -241,6 +251,12 @@ void llama_model_dflash::load_arch_tensors(llama_model_loader &) {
     output_norm_enc = create_tensor(tn(LLM_TENSOR_ENC_OUTPUT_NORM, "weight"), { n_embd }, 0); // encoder hidden_norm (after fc)
     output_norm     = create_tensor(tn(LLM_TENSOR_OUTPUT_NORM,    "weight"), { n_embd }, 0); // decoder final norm
 
+    // Laguna drafters RMS-norm each captured target feature before fc; the
+    // per-feature weights are stacked to [n_embd, n_target_layers].
+    if (decoder_laguna) {
+        aux_norm = create_tensor(tn(LLM_TENSOR_ENC_AUX_NORM, "weight"), { n_embd, (int64_t) target_layer_ids.size() }, 0);
+    }
+
     // optional: reduced-vocab drafts ship their own lm head, full-vocab drafts can share the target's via ctx_other
     // a draft with its own embeddings + head references no target tensors and can run on devices the target does not use (e.g. -devd with a tensor-split target)
     output   = create_tensor(tn(LLM_TENSOR_OUTPUT,     "weight"), { n_embd, n_vocab_draft }, TENSOR_NOT_REQUIRED);
@@ -316,6 +332,20 @@ void llama_model_dflash::load_arch_tensors(llama_model_loader &) {
         // optional per-head attention sinks (e.g. Nemotron DSpark)
         layer.attn_sinks = create_tensor(tn(LLM_TENSOR_ATTN_SINKS, "weight", i), { n_head }, TENSOR_NOT_REQUIRED);
 
+        // Laguna drafters gate the attention output per head or per element,
+        // told apart by the gate's width as in the Laguna target.
+        if (decoder_laguna) {
+            const ggml_tensor * gate_meta = ml->get_tensor_meta(tn(LLM_TENSOR_ATTN_GATE, "weight", i).str().c_str());
+            if (gate_meta != nullptr) {
+                const int64_t n_gate_out = gate_meta->ne[1];
+                if (n_gate_out != n_head && n_gate_out != n_embd_head_k * n_head) {
+                    throw std::runtime_error(format("DFlash: attention gate of layer %d is %lld wide, expected %lld or %lld",
+                            i, (long long) n_gate_out, (long long) n_head, (long long) (n_embd_head_k * n_head)));
+                }
+                layer.wqkv_gate = create_tensor(tn(LLM_TENSOR_ATTN_GATE, "weight", i), { n_embd, n_gate_out }, 0);
+            }
+        }
+
         layer.ffn_norm = create_tensor(tn(LLM_TENSOR_FFN_NORM, "weight", i), { n_embd }, 0);
         layer.ffn_gate = create_tensor(tn(LLM_TENSOR_FFN_GATE, "weight", i), { n_embd, n_ff }, 0);
         layer.ffn_down = create_tensor(tn(LLM_TENSOR_FFN_DOWN, "weight", i), { n_ff, n_embd }, 0);
@@ -333,6 +363,26 @@ void llama_model_dflash::load_arch_tensors(llama_model_loader &) {
     }
 }
 
+// Laguna drafters RMS-norm each captured target feature before fc: view the
+// concatenated input as [n_feat, n_aux, n_tokens], norm over n_feat and scale
+// by the stacked per-feature weights. Other drafters pass through.
+static ggml_tensor * build_dflash_aux_norm(llm_graph_context & g, const llama_model & model, ggml_tensor * cur) {
+    ggml_tensor * aux_norm = static_cast<const llama_model_dflash &>(model).aux_norm;
+    if (aux_norm == nullptr) {
+        return cur;
+    }
+    const int64_t n_aux    = aux_norm->ne[1];
+    const int64_t n_feat   = cur->ne[0] / n_aux;
+    const int64_t n_tokens = cur->ne[1];
+
+    cur = ggml_reshape_3d(g.ctx0, cur, n_feat, n_aux, n_tokens);
+    cur = ggml_rms_norm(g.ctx0, cur, g.hparams.f_norm_rms_eps);
+    cur = ggml_mul(g.ctx0, cur, aux_norm);
+    cur = ggml_reshape_2d(g.ctx0, cur, n_feat * n_aux, n_tokens);
+    g.cb(cur, "enc_aux_norm", -1);
+    return cur;
+}
+
 template <>
 ggml_tensor * llama_model_dflash::graph<true>::build_inp_embd_enc() const {
     const int64_t n_embd_inp = hparams.n_embd_inp_enc();
@@ -354,6 +404,7 @@ template <>
 llama_model_dflash::graph<true>::graph(const llama_model & model, const llm_graph_params & params) : llm_graph_context(params) {
     ggml_tensor * cur = build_inp_embd_enc();
 
+    cur = build_dflash_aux_norm(*this, model, cur);
     cur = build_lora_mm(model.fc, cur, model.fc_s);
     cb(cur, "fc_out", -1);
 
@@ -853,16 +904,27 @@ llama_model_dflash::graph<false>::graph(const llama_model & model, const llm_gra
         res->add_input(std::move(inp));
 
         // fuse the target features through the encoder
-        ggml_tensor * inp_g = build_lora_mm(model.fc, inp_target, model.fc_s);
+        ggml_tensor * inp_g = build_dflash_aux_norm(*this, model, inp_target);
+        inp_g = build_lora_mm(model.fc, inp_g, model.fc_s);
         inp_g = build_norm(inp_g, model.output_norm_enc, NULL, LLM_NORM_RMS, -1);
         cb(inp_g, "inp_g_embeddings", -1);
 
+        const bool decoder_laguna = static_cast<const llama_model_dflash &>(model).decoder_laguna;
+
         for (int il = 0; il < n_layer; ++il) {
             const auto & layer = model.layers[il];
 
-            ggml_tensor * Kcur = build_lora_mm(layer.wk, inp_g, layer.wk_s);
+            // Laguna drafters project context K/V from the layer's input norm,
+            // as they do the noise block; generic DFlash projects them raw.
+            ggml_tensor * kv_inp = inp_g;
+            if (decoder_laguna) {
+                kv_inp = build_norm(inp_g, layer.attn_norm, NULL, LLM_NORM_RMS, il);
+                cb(kv_inp, "kv_inp_normed", il);
+            }
+
+            ggml_tensor * Kcur = build_lora_mm(layer.wk, kv_inp, layer.wk_s);
             const bool shared_kv = layer.wv == nullptr;
-            ggml_tensor * Vcur = shared_kv ? Kcur : build_lora_mm(layer.wv, inp_g, layer.wv_s);
+            ggml_tensor * Vcur = shared_kv ? Kcur : build_lora_mm(layer.wv, kv_inp, layer.wv_s);
 
             Kcur = ggml_reshape_3d(ctx0, Kcur, n_embd_head, n_head_kv, n_tokens);
             Vcur = ggml_reshape_3d(ctx0, Vcur, n_embd_head, n_head_kv, n_tokens);
@@ -984,10 +1046,34 @@ llama_model_dflash::graph<false>::graph(const llama_model & model, const llm_gra
         cb(Kcur, "Kcur", il);
         cb(Vcur, "Vcur", il);
 
-        // cache-aware, non-causal attention
+        // cache-aware attention: non-causal for generic DFlash, causal for
+        // Laguna drafters (the context's causal_attn flag picks the mask).
+        // A gated layer applies its output projection after the gate.
+        const bool gated = layer.wqkv_gate != nullptr;
         ggml_tensor * cur = use_iswa
-            ? build_attn(inp_attn_iswa, layer.wo, NULL, layer.wo_s, Qcur, Kcur, Vcur, nullptr, layer.attn_sinks, nullptr, kq_scale, il)
-            : build_attn(inp_attn,      layer.wo, NULL, layer.wo_s, Qcur, Kcur, Vcur, nullptr, layer.attn_sinks, nullptr, kq_scale, il);
+            ? build_attn(inp_attn_iswa, gated ? nullptr : layer.wo, NULL, gated ? nullptr : layer.wo_s, Qcur, Kcur, Vcur, nullptr, layer.attn_sinks, nullptr, kq_scale, il)
+            : build_attn(inp_attn,      gated ? nullptr : layer.wo, NULL, gated ? nullptr : layer.wo_s, Qcur, Kcur, Vcur, nullptr, layer.attn_sinks, nullptr, kq_scale, il);
+
+        if (gated) {
+            // softplus gate on the normed block input, per head (broadcast
+            // over head_dim) or per element, as in the Laguna target
+            ggml_tensor * gate = build_lora_mm(layer.wqkv_gate, noise_norm);
+            gate = ggml_softplus(ctx0, gate);
+            cb(gate, "attn_gate_softplus", il);
+
+            const int64_t n_tok = cur->ne[1];
+            if (layer.wqkv_gate->ne[1] == n_head) {
+                cur  = ggml_reshape_3d(ctx0, cur,  n_embd_head, n_head, n_tok);
+                gate = ggml_reshape_3d(ctx0, gate, 1,           n_head, n_tok);
+                cur  = ggml_mul(ctx0, cur, gate);
+                cur  = ggml_reshape_2d(ctx0, cur, n_embd_head * n_head, n_tok);
+            } else {
+                cur = ggml_mul(ctx0, cur, gate);
+            }
+            cb(cur, "attn_gated", il);
+
+            cur = build_lora_mm(layer.wo, cur, layer.wo_s);
