 // realized stage graph must keep every such capture. `targets_csv` names the
 // draft's target layers; without it, GLM-5.3-Flash's draft on its two- and
 // four-stage cuts.
+// llama_layer_inp_published reports whether a model's graph can serve a
+// draft's capture of layer `lid` ("head" is n_layer, the last layer's
+// output) without decoding, and the answer matches what a decode does.
+static int check_layer_inp_published(const char * model_path, const char * layer, bool expected) {
+    llama_model_params model_params = llama_model_default_params();
+    model_params.n_gpu_layers = 0;
+    llama_model * model = llama_model_load_from_file(model_path, model_params);
+    if (model == nullptr) {
+        return 140;
+    }
+    llama_context_params context_params = llama_context_default_params();
+    context_params.n_ctx = 64;
+    context_params.n_batch = 8;
+    context_params.n_ubatch = 8;
+    llama_context * ctx = llama_init_from_model(model, context_params);
+    if (ctx == nullptr) {
+        llama_model_free(model);
+        return 141;
+    }
+    const uint32_t n_layer = (uint32_t) llama_model_n_layer(model);
+    const uint32_t lid = std::strcmp(layer, "head") == 0 ? n_layer : (uint32_t) std::stoul(layer);
+    int rc = 0;
+    if (llama_layer_inp_published(ctx, lid) != expected) {
+        std::fprintf(stderr, "layer %u input published: expected %d\n", lid, expected ? 1 : 0);
+        rc = 142;
+    }
+    if (rc == 0 && llama_layer_inp_published(ctx, n_layer + 1)) {
+        std::fprintf(stderr, "layer %u past the head was reported published\n", n_layer + 1);
+        rc = 143;
+    }
+    // The probe leaves the context usable, and a published layer decodes.
+    if (rc == 0 && expected) {
+        llama_set_embeddings_layer_inp(ctx, lid, true);
+        llama_token tokens[] = {1, 2, 3, 4};
+        if (llama_decode(ctx, llama_batch_get_one(tokens, 4)) != 0 ||
+                llama_get_embeddings_layer_inp(ctx, lid) == nullptr) {
+            std::fprintf(stderr, "published layer %u was not captured\n", lid);
+            rc = 144;
+        }
+    }
+    llama_free(ctx);
+    llama_model_free(model);
+    return rc;
+}
