From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Daniel Winter <danielwinterw@gmail.com>
Date: Sat, 7 Nov 2026 14:20:44 +1100
Subject: [PATCH] skippy: report which layer inputs a graph publishes

Speculative drafts capture the residual entering chosen target layers,
including layer n_layer (the last layer's output) for some drafts. Only
graphs that record a layer's input can serve that capture; asking any
other graph for it aborts the next decode.

llama_layer_inp_published() builds the architecture graph for one token
with the layer captured and reports whether it names the tensor. It
stops before the output pass and scheduling, so it leaves reserved
graphs and the scheduler alone, and lets a host refuse a draft before
it attaches.
---
 src/llama-context.cpp | 35 +++++++++++++++++++++++++++++++++++
 src/llama-context.h   |  4 ++++
 src/llama-ext.h       |  5 +++++
 3 files changed, 44 insertions(+)

diff --git a/src/llama-context.cpp b/src/llama-context.cpp
index 483b5d16b..de8bc31f9 100644
--- a/src/llama-context.cpp
+++ b/src/llama-context.cpp
@@ -2811,6 +2811,37 @@ bool llama_context::get_input_activation_frontier(std::vector<skippy_activation_
     return true;
 }
 
+bool llama_context::layer_inp_published(uint32_t lid) {
+    if (lid >= cparams.embeddings_layer_inp.size()) {
+        return false;
+    }
+    // Build the architecture graph for one token with the layer captured and
+    // see whether it names the tensor. This stops short of the output pass,
+    // which aborts on a capture the graph cannot satisfy, and of scheduling,
+    // so the reserved graphs and the scheduler are left as they are.
+    const std::vector<bool> saved_layer_inp = cparams.embeddings_layer_inp;
+    const auto saved_n_outputs = n_outputs;
+    cparams.embeddings_layer_inp[lid] = true;
+    n_outputs = 1;
+    bool published = false;
+    try {
+        const auto mctx = memory ? memory->init_full() : nullptr;
+        llama_batch_allocr balloc(model.hparams.n_pos_per_embd());
+        llama_ubatch ubatch = balloc.ubatch_reserve(1, 1);
+        ubatch_prepare_reserve(ubatch, n_outputs, sampling.samplers, cparams.n_outputs_max_per_seq);
+        llm_graph_result res(graph_max_nodes(1));
+        res.reset();
+        const auto graph = model.build_arch_graph(
+                graph_params(&res, ubatch, mctx.get(), ctx_type_to_graph_type(cparams.ctx_type)));
+        published = graph->res->get_layer_inp((int) lid) != nullptr;
+    } catch (const std::exception & err) {
+        LLAMA_LOG_WARN("%s: could not build the graph to check layer %u: %s\n", __func__, lid, err.what());
+    }
+    n_outputs = saved_n_outputs;
+    cparams.embeddings_layer_inp = saved_layer_inp;
+    return published;
+}
+
 ggml_cgraph * llama_context::graph_reserve(uint32_t                          n_tokens,
                                            uint32_t                          n_seqs,
                                            uint32_t                          n_outputs,
@@ -4628,6 +4659,10 @@ void llama_set_embeddings_layer_inp(llama_context * ctx, uint32_t lid, bool valu
     ctx->set_embeddings_layer_inp(lid, value);
 }
 
+bool llama_layer_inp_published(llama_context * ctx, uint32_t lid) {
+    return ctx->layer_inp_published(lid);
+}
+
 void llama_set_nextn_layer_offset(llama_context * ctx, int32_t offset) {
     ctx->set_nextn_layer_offset(offset);
 }
diff --git a/src/llama-context.h b/src/llama-context.h
index a9b05f5dd..a2c701f79 100644
--- a/src/llama-context.h
+++ b/src/llama-context.h
@@ -152,6 +152,10 @@ struct llama_context {
     void set_embeddings (bool value);
     void set_embeddings_nextn(bool value, bool masked);
     void set_embeddings_layer_inp(uint32_t lid, bool enable);
+
+    // whether the model's graph publishes layer lid's input when it is captured;
+    // lid == n_layer is the last layer's output, the output head's input
+    bool layer_inp_published(uint32_t lid);
     void set_nextn_layer_offset(int32_t offset);
     void set_causal_attn(bool value);
     void set_warmup(bool value);
diff --git a/src/llama-ext.h b/src/llama-ext.h
index 1e24ccaa5..9cb6bf853 100644
--- a/src/llama-ext.h
+++ b/src/llama-ext.h
@@ -138,6 +138,11 @@ LLAMA_API float * llama_get_embeddings_nextn_ith(struct llama_context * ctx, int
 // Set whether the context outputs the input embeddings of a specific layer
 LLAMA_API void llama_set_embeddings_layer_inp(struct llama_context * ctx, uint32_t lid, bool value);
 
+// Whether the model's graph publishes the input of layer lid (lid == n_layer: the
+// last layer's output) when it is captured. Builds the graph once, without
+// running it; capturing a layer the graph does not publish aborts the decode.
+LLAMA_API bool llama_layer_inp_published(struct llama_context * ctx, uint32_t lid);
+
 // mirrors:
 // LLAMA_API float * llama_get_embeddings(struct llama_context * ctx);
 LLAMA_API float * llama_get_embeddings_layer_inp(struct llama_context * ctx, uint32_t lid);
