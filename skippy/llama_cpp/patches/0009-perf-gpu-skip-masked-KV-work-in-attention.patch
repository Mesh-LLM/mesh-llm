diff --git a/ggml/src/ggml-metal/ggml-metal-attention-dispatch.h b/ggml/src/ggml-metal/ggml-metal-attention-dispatch.h
new file mode 100644
index 000000000..49eab36da
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-attention-dispatch.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include "ggml-metal-device.h"
+#include "ggml-impl.h"
+
+#include <algorithm>
+
+struct ggml_metal_attention_reduction {
+    int32_t nsg;
+    ggml_metal_pipeline_with_params pipeline;
+};
+
+// Keep the producer's partial-result count unchanged. Each reduction SIMD group
+// reads all 32 partials, but fewer groups can cover the output head in more steps
+// when the compiled pipeline has a lower thread limit (e.g. shader validation).
+static inline ggml_metal_attention_reduction ggml_metal_select_attention_reduction(
+        ggml_metal_library_t lib, const ggml_tensor * op, int32_t dv, int32_t nwg) {
+    auto pipeline = ggml_metal_library_get_pipeline_flash_attn_ext_vec_reduce(lib, op, dv, nwg);
+    const int32_t nsg = std::min(nwg, ggml_metal_pipeline_max_theads_per_threadgroup(pipeline)/32);
+    GGML_ASSERT(nsg > 0);
+    return { nsg, pipeline };
+}
