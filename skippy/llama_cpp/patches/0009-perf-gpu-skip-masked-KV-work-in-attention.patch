     std::vector<std::unique_ptr<test_case>> test_cases;
+    add_flash_attn_kv_bounds_perf_tests(test_cases);
 
     // SWIGLU at a 27B-class FFN width, fused [gate|up] vs split operands
     // note: same bytes either way, so a backend that indexes them differently shows it here
diff --git a/tests/test-flash-attn-kv-bounds.h b/tests/test-flash-attn-kv-bounds.h
new file mode 100644
index 000000000..c7ab3c12b
--- /dev/null
+++ b/tests/test-flash-attn-kv-bounds.h
@@ -0,0 +1,210 @@
+#pragma once
+
+// Exercise physical KV layouts that arise from unified caches. Each query has
+// its own mask, so a query tile must use the union, not one representative row.
+struct test_flash_attn_kv_bounds : public test_flash_attn_ext {
+    const int pattern;
+
+    test_flash_attn_kv_bounds(int       pattern,
+                              int64_t   queries,
+                              int64_t   streams,
+                              ggml_type kv_type,
+                              bool      with_sinks,
+                              int64_t   kv_size = 4096, int64_t head_size = 128) :
+        test_flash_attn_ext(head_size,
+                            head_size,
+                            2,
+                            { 4, streams },
+                            kv_size,
+                            queries,
+                            true,
+                            with_sinks,
+                            0,
+                            0,
+                            GGML_PREC_F32,
+                            kv_type,
+                            kv_type),
+        pattern(pattern) {}
+
+    std::string vars() override {
+        return test_flash_attn_ext::vars() + ",kv_bounds_pattern=" + std::to_string(pattern);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_flash_attn_ext::initialize_tensors(ctx);
+        for (auto * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "m") != 0) {
+                continue;
+            }
+            std::vector<ggml_fp16_t> values(ggml_nelements(t), ggml_fp32_to_fp16(-INFINITY));
+            for (int64_t s = 0; s < t->ne[3]; ++s) {
+                for (int64_t q = 0; q < t->ne[1]; ++q) {
+                    for (int64_t k = 0; k < t->ne[0]; ++k) {
+                        if (q >= nb) {
+                            // Deliberately visible padding must not expand the
+                            // live query tile's mask or alter its output.
+                            values[(s * t->ne[1] + q) * t->ne[0] + k] = ggml_fp32_to_fp16(0.0f);
+                            continue;
+                        }
+                        bool visible = false;
+                        switch (pattern) {
+                            case 0:
+                                visible = k >= 2051 && k < 3077;
+                                break;  // unaligned middle
+                            case 1:
+                                visible = k < 513;
+                                break;  // masked suffix
+                            case 2:
+                                visible = k >= kv - 515;
+                                break;  // masked prefix
+                            case 3:     // unrelated interleaved sequences in one query tile
+                                visible = (q + s) % 2 ? k >= 3071 : k < 257;
+                                break;
+                            case 4:
+                                visible = k < 129 || (k >= 2053 && k < 3073);
+                                break;  // shared prefix + hole
+                            case 5:
+                                visible = k == (q * 257 + s * 131) % kv;
+                                break;  // one live column
+                            case 6:
+                                visible = q % 2 && k >= 2051 && k < 3077;
+                                break;  // empty rows, with sinks
+                            case 7:
+                                visible = true;
+                                break;  // finite negative biases must remain live
+                            case 8:
+                                visible = k < 129 || k >= kv - 515;
+                                break;  // large interior hole with live endpoints
+                            case 9:
+                                visible = (q + s) % 2 ? k >= kv / 2 : k < kv / 2;
+                                break;  // each row sparse, but a two-row union is dense
+                            case 10:
+                                visible = (k / 512) % 4 == (q / 16 + s) % 4;
+                                break;  // chunk-interleaved physical lanes
+                            case 11:
+                                visible = k <= kv - nb + q;
+                                break;  // ordinary contiguous causal prefill
+                            default:
+
+                                GGML_ABORT("invalid KV bounds pattern");
+                        }
+                        if (visible) {
+                            const float bias                          = -float((k + q) % 7) / 8.0f;
+                            values[(s * t->ne[1] + q) * t->ne[0] + k] = ggml_fp32_to_fp16(bias);
+                        }
+                    }
+                }
+            }
+            ggml_backend_tensor_set(t, values.data(), 0, values.size() * sizeof(values[0]));
+        }
+    }
+};
+
+// Vacant physical cells in a unified cache can retain non-finite payloads.
+// An invisible cell must not contribute even when K or V contains NaN.
+struct test_flash_attn_masked_nan : public test_flash_attn_kv_bounds {
+    explicit test_flash_attn_masked_nan(int64_t queries) :
+        test_flash_attn_kv_bounds(8, queries, 1, GGML_TYPE_F16, false, 1024, 256) {}
+
+    std::string vars() override {
+        return test_flash_attn_kv_bounds::vars() + ",masked_nan=1";
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_flash_attn_kv_bounds::initialize_tensors(ctx);
+        for (auto * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "k") != 0 && strcmp(t->name, "v") != 0) {
+                continue;
+            }
+            const std::vector<ggml_fp16_t> nan_row(t->ne[0], ggml_fp32_to_fp16(NAN));
+            for (int64_t head = 0; head < t->ne[2]; ++head) {
+                for (int64_t key = 129; key < kv - 515; ++key) {
+                    ggml_backend_tensor_set(t, nan_row.data(), head * t->nb[2] + key * t->nb[1],
+                                            nan_row.size() * sizeof(nan_row[0]));
+                }
+            }
+        }
+    }
+};
+
+static void add_flash_attn_kv_bounds_tests(std::vector<std::unique_ptr<test_case>> & tests) {
+    for (int64_t queries : { 1, 17, 64, 512 }) {
+        tests.emplace_back(new test_flash_attn_masked_nan(queries));
+    }
+    // The one-query 256-wide vector path needs a long physical KV with live
+    // endpoints to exercise skipping a fully masked interior tile.
+    for (int pattern : { 2, 7, 8, 10 }) {
+        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, 1, 1, GGML_TYPE_F16, false, 65536, 256));
+    }
+    tests.emplace_back(new test_flash_attn_kv_bounds(8, 1, 1, GGML_TYPE_F16, true, 65536, 256));
+    for (int pattern : { 2, 6, 7, 8, 10, 11 }) {
+        for (int64_t queries : { 1, 2, 17, 512 }) {
+            tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, 1, GGML_TYPE_F16, true, 4096, 256));
+        }
+    }
+    for (int pattern : { 7, 8, 10, 11 }) {
+        for (int64_t queries : { 17, 512 }) {
+            tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, 1, GGML_TYPE_F16, true, 65536, 256));
+        }
+    }
+    for (int pattern : { 7, 8, 9 }) {
+        for (int64_t queries : { 1, 2, 3 }) {
+            for (auto type : { GGML_TYPE_F16, GGML_TYPE_Q8_0 }) {
+                for (bool sinks : { false, true }) {
+                    tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, 1, type, sinks, 65536));
+                }
+            }
+        }
+    }
+    for (int pattern = 0; pattern < 8; ++pattern) {
+        for (int64_t queries : { 1, 2, 3, 4, 17, 64 }) {
+            for (int64_t streams : { 1, 2 }) {
+                for (auto type : { GGML_TYPE_F16, GGML_TYPE_Q8_0 }) {
+                    for (bool sinks : { false, true }) {
+                        if (pattern == 6 && !sinks) {
+                            continue;  // all-masked rows need a sink for a defined CPU reference
+                        }
+                        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, streams, type, sinks));
+                    }
+                }
+            }
+        }
+    }
+    // Chunked prefill below the former 1024-query cutoff, and unaligned KV
+    // extents which must retain the existing unoptimized path.
+    for (int pattern : { 0, 3, 4 }) {
+        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, 65, 1, GGML_TYPE_F16, false));
+        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, 512, 1, GGML_TYPE_F16, false));
+        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, 513, 1, GGML_TYPE_F16, false));
+        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, 3, 1, GGML_TYPE_F16, true, 4097));
+    }
+}
+
+static void add_flash_attn_kv_bounds_perf_tests(std::vector<std::unique_ptr<test_case>> & tests) {
+    for (int pattern : { 2, 7, 8, 10, 11 }) {
+        for (int64_t queries : { 1, 2, 17, 512 }) {
+            for (int64_t kv_size : { 4096, 65536, 196608 }) {
+                tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, 1, GGML_TYPE_F16, false, kv_size, 256));
+            }
+        }
+    }
+    for (int pattern : { 0, 3, 4 }) {
+        for (int64_t queries : { 65, 513 }) {
+            tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, 1, GGML_TYPE_F16, false, 16384));
+        }
+    }
+    // Include dense masks and short contexts to expose classification overhead,
+    // alongside long unified layouts with masked prefixes and interior holes.
+    for (int pattern : { 0, 2, 3, 4, 7, 8, 9 }) {
+        for (int64_t kv_size : { 1024, 4096, 16384, 65536 }) {
+            if (kv_size < 4096 && pattern != 7) {
+                continue;
+            }
+            for (int64_t queries : { 1, 2, 3, 17 }) {
+                for (auto type : { GGML_TYPE_F16, GGML_TYPE_Q8_0 }) {
+                    tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, 1, type, false, kv_size));
+                }
+            }
+        }
+    }
+}
diff --git a/tests/test-metal-attention-dispatch.cpp b/tests/test-metal-attention-dispatch.cpp
new file mode 100644
index 000000000..0a0673d0d
--- /dev/null
+++ b/tests/test-metal-attention-dispatch.cpp
@@ -0,0 +1,49 @@
+#include "ggml-metal/ggml-metal-attention-dispatch.h"
+
+#include <array>
+#include <cassert>
+#include <cstdint>
+
+static int compiled_limit;
+static int compiled_partials;
+static ggml_metal_pipeline_with_params selected_pipeline = {};
+
+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_flash_attn_ext_vec_reduce(
+        ggml_metal_library_t, const ggml_tensor *, int32_t, int32_t nwg) {
+    compiled_partials = nwg;
+    return selected_pipeline;
+}
+
+int ggml_metal_pipeline_max_theads_per_threadgroup(ggml_metal_pipeline_with_params) {
+    return compiled_limit;
+}
+
+int main() {
+    // 832 reproduces the instrumented M1 Ultra pipeline limit. Nonmultiples
+    // ensure the host rounds down to complete SIMD groups, never up past it.
+    for (const int limit : { 1024, 832, 831, 512, 63, 32 }) {
+        compiled_limit = limit;
+        const auto dispatch = ggml_metal_select_attention_reduction(nullptr, nullptr, 256, 32);
+        GGML_ASSERT(compiled_partials == 32);
+        GGML_ASSERT(dispatch.nsg*32 <= limit);
+        GGML_ASSERT(dispatch.nsg > 0);
+        if (limit == 1024) {
+            GGML_ASSERT(dispatch.nsg == 32);
+        }
+        if (limit == 832) {
+            GGML_ASSERT(dispatch.nsg == 26);
+        }
+        for (const int head_values : { 16, 32, 64, 128 }) {
+            std::array<int, 128> writes = {};
+            for (int group = 0; group < dispatch.nsg; ++group) {
+                for (int value = group; value < head_values; value += dispatch.nsg) {
+                    ++writes[value];
+                }
+            }
+            for (int value = 0; value < head_values; ++value) {
+                GGML_ASSERT(writes[value] == 1);
+            }
+        }
+    }
+    return 0;
+}
