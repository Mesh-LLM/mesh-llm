diff --git a/src/skippy/sample_executor.cpp b/src/skippy/sample_executor.cpp
new file mode 100644
index 000000000..614074d52
--- /dev/null
+++ b/src/skippy/sample_executor.cpp
@@ -0,0 +1,17 @@
+#include "skippy/sample_executor.h"
+
+#include <algorithm>
+#include <limits>
+#include <numeric>
+#include <vector>
+
+void skippy_inline_sampling::run(size_t count, const skippy_task_pool::task_fn & task) const {
+    std::vector<size_t> indices(count);
+    std::iota(indices.begin(), indices.end(), size_t { 0 });
+    std::for_each(indices.begin(), indices.end(), [&](size_t index) { task(index, false); });
+}
+
+void skippy_pooled_sampling::run(size_t count, const skippy_task_pool::task_fn & task) const {
+    const size_t max_helpers = threads == 0 ? std::numeric_limits<size_t>::max() : threads - 1;
+    skippy_task_pool::shared().run(count, task, max_helpers);
+}
diff --git a/src/skippy/sample_executor.h b/src/skippy/sample_executor.h
new file mode 100644
index 000000000..7eeb5937c
--- /dev/null
+++ b/src/skippy/sample_executor.h
@@ -0,0 +1,50 @@
+#pragma once
+
+// How the requests of a wave are sampled. `sample_threads` in
+// skippy_runtime_config picks the executor; a new strategy is a new
+// implementation and a new case in skippy_with_sample_executor.
+
+#include "skippy/task_pool.h"
+
+#include <cstddef>
+#include <cstdint>
+
+class skippy_sample_executor {
+  public:
+    virtual ~skippy_sample_executor() = default;
+
+    // names the executor on the wave's trace span
+    virtual const char * name() const = 0;
+    // Runs task for every index below count and returns once all have run.
+    virtual void run(size_t count, const skippy_task_pool::task_fn & task) const = 0;
+};
+
+// The calling thread samples every request in turn.
+class skippy_inline_sampling final : public skippy_sample_executor {
+  public:
+    const char * name() const override { return "inline"; }
+    void run(size_t count, const skippy_task_pool::task_fn & task) const override;
+};
+
+// The calling thread and helpers from the shared pool, `threads` at most; 0
+// is as many as the wave and the hardware allow.
+class skippy_pooled_sampling final : public skippy_sample_executor {
+  public:
+    explicit skippy_pooled_sampling(uint32_t threads) : threads(threads) {
+    }
+    const char * name() const override { return "pool"; }
+    void run(size_t count, const skippy_task_pool::task_fn & task) const override;
+
+  private:
+    uint32_t threads;
+};
+
+// Calls use(executor) with the executor `sample_threads` selects: 0 the pool
+// at its widest, 1 the calling thread alone, N the pool with N threads at most.
+template <typename Use>
+auto skippy_with_sample_executor(uint32_t sample_threads, Use && use) {
+    if (sample_threads == 1) {
+        return use(skippy_inline_sampling());
+    }
+    return use(skippy_pooled_sampling(sample_threads));
+}
diff --git a/src/skippy/task_pool.cpp b/src/skippy/task_pool.cpp
new file mode 100644
index 000000000..88f8d3b59
--- /dev/null
+++ b/src/skippy/task_pool.cpp
@@ -0,0 +1,97 @@
+#include "skippy/task_pool.h"
+
+#include <algorithm>
+#include <iterator>
+#include <system_error>
+#include <utility>
+
+skippy_task_pool::skippy_task_pool(size_t ceiling) : limit(ceiling) {
+}
+
+skippy_task_pool::~skippy_task_pool() {
+    {
+        const std::lock_guard<std::mutex> lock(mutex);
+        stopping = true;
+    }
+    wake.notify_all();
+    std::for_each(threads.begin(), threads.end(), [](std::thread & thread) { thread.join(); });
+}
+
+skippy_task_pool & skippy_task_pool::shared() {
+    static skippy_task_pool pool(std::max(2u, std::thread::hardware_concurrency()) - 1);
+    return pool;
+}
+
+size_t skippy_task_pool::helpers() const {
+    const std::lock_guard<std::mutex> lock(mutex);
+    return threads.size();
+}
+
+void skippy_task_pool::run(size_t n, const task_fn & fn, size_t max_helpers) {
+    if (n == 0) {
+        return;
+    }
+    const std::lock_guard<std::mutex> one_run(turn);
+    const size_t wanted = std::min({ max_helpers, limit, n - 1 });
+    {
+        const std::lock_guard<std::mutex> lock(mutex);
+        try {
+            std::generate_n(std::back_inserter(threads), wanted - std::min(wanted, threads.size()), [this] {
+                return std::thread([this, ordinal = threads.size()] { serve(ordinal); });
+            });
+        } catch (const std::system_error &) {
+            // the helpers that did start, and the caller, still run every task
+        }
+        task    = &fn;
+        count   = n;
+        next    = 0;
+        pending = n;
+        allowed = wanted;
+        failure = nullptr;
+    }
+    wake.notify_all();
+    work(false);
+
+    std::unique_lock<std::mutex> lock(mutex);
+    idle.wait(lock, [this] { return pending == 0; });
+    task = nullptr;
+    if (failure) {
+        std::rethrow_exception(std::exchange(failure, nullptr));
+    }
+}
+
+// Takes indices until none are left.
+void skippy_task_pool::work(bool on_helper) {
+    std::unique_lock<std::mutex> lock(mutex);
+    while (task != nullptr && next < count) {
+        const size_t    index = next++;
+        const task_fn * fn    = task;
+        lock.unlock();
+        std::exception_ptr thrown;
+        try {
+            (*fn)(index, on_helper);
+        } catch (...) {
+            thrown = std::current_exception();
+        }
+        lock.lock();
+        if (thrown && !failure) {
+            failure = thrown;
+        }
+        if (--pending == 0) {
+            idle.notify_all();
+        }
+    }
+}
+
+void skippy_task_pool::serve(size_t ordinal) {
+    std::unique_lock<std::mutex> lock(mutex);
+    while (true) {
+        wake.wait(lock, [&] { return stopping || (task != nullptr && next < count && ordinal < allowed); });
+        if (stopping) {
+            return;
+        }
+        lock.unlock();
+        work(true);
+        lock.lock();
+    }
+}
diff --git a/src/skippy/task_pool.h b/src/skippy/task_pool.h
new file mode 100644
index 000000000..e33523ea7
--- /dev/null
+++ b/src/skippy/task_pool.h
@@ -0,0 +1,59 @@
+#pragma once
+
+// Helper threads that outlive a call. A decode step samples one token for
+// every request of a wave; starting and joining a thread per request per step
+// costs more than the sampling it spreads, and has no bound.
+
+#include <condition_variable>
+#include <cstddef>
+#include <exception>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+class skippy_task_pool {
+  public:
+    // on_helper: the task runs on a pool thread, not the thread that called run()
+    using task_fn = std::function<void(size_t index, bool on_helper)>;
+
+    // ceiling: the most helper threads the pool ever starts
+    explicit skippy_task_pool(size_t ceiling);
+    ~skippy_task_pool();
+
+    skippy_task_pool(const skippy_task_pool &)             = delete;
+    skippy_task_pool & operator=(const skippy_task_pool &) = delete;
+
+    // The pool every caller shares. Its ceiling is one helper per spare
+    // hardware thread, so it is as wide as the machine and no wider.
+    static skippy_task_pool & shared();
+
+    size_t ceiling() const { return limit; }
+    // helper threads started so far
+    size_t helpers() const;
+
+    // Runs task for every index below count and returns once all have run,
+    // on the calling thread and at most max_helpers helpers. Helpers start
+    // the first time a run can use them: a run of n tasks uses n - 1 at most.
+    // Rethrows the first exception a task threw. Calls from different threads
+    // take turns.
+    void run(size_t count, const task_fn & task, size_t max_helpers);
+
+  private:
+    void work(bool on_helper);
+    void serve(size_t ordinal);
+
+    const size_t            limit;
+    std::mutex              turn;
+    mutable std::mutex      mutex;
+    std::condition_variable wake;
+    std::condition_variable idle;
+    const task_fn *         task    = nullptr; // owned by the run() in progress
+    size_t                  count   = 0;
+    size_t                  next    = 0;
+    size_t                  pending = 0;
+    size_t                  allowed = 0; // helpers the run in progress may use
+    std::exception_ptr      failure;
+    bool                    stopping = false;
+    std::vector<std::thread> threads; // grown by run() under `turn`
+};
