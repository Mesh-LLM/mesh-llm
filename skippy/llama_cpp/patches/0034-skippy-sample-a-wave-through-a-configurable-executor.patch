diff --git a/tests/test-skippy-task-pool.cpp b/tests/test-skippy-task-pool.cpp
new file mode 100644
index 000000000..6bb6b040f
--- /dev/null
+++ b/tests/test-skippy-task-pool.cpp
@@ -0,0 +1,171 @@
+// skippy_task_pool and the sampling executors over it: every index runs once, on a bounded
+// set of threads that later runs reuse, and a task's exception reaches the caller.
+#include "../src/skippy/sample_executor.h"
+#include "../src/skippy/task_pool.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <mutex>
+#include <numeric>
+#include <set>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { ++failures; std::printf("FAIL line %d: %s\n", __LINE__, #cond); } } while (0)
+
+static void every_index_runs_once() {
+    skippy_task_pool pool(3);
+    std::vector<int> rounds(200);
+    std::for_each(rounds.begin(), rounds.end(), [&](int) {
+        std::vector<std::atomic<int>> hits(17);
+        pool.run(hits.size(), [&](size_t index, bool) { hits[index]++; }, 3);
+        CHECK(std::all_of(hits.begin(), hits.end(), [](const std::atomic<int> & hit) { return hit == 1; }));
+    });
+}
+
+static void threads_are_bounded_and_reused() {
+    skippy_task_pool pool(3);
+    std::mutex mutex;
+    std::set<std::thread::id> seen;
+    std::atomic<int> running { 0 };
+    std::atomic<int> most { 0 };
+    std::atomic<int> on_helpers { 0 };
+    std::vector<int> rounds(300);
+    std::for_each(rounds.begin(), rounds.end(), [&](int) {
+        pool.run(16, [&](size_t, bool on_helper) {
+            const int now = ++running;
+            int before = most.load();
+            while (now > before && !most.compare_exchange_weak(before, now)) {
+            }
+            on_helpers += on_helper ? 1 : 0;
+            {
+                const std::lock_guard<std::mutex> lock(mutex);
+                seen.insert(std::this_thread::get_id());
+            }
+            std::this_thread::yield();
+            --running;
+        }, 3);
+    });
+    CHECK(pool.helpers() == 3);
+    CHECK(seen.size() <= pool.helpers() + 1);
+    CHECK(most <= (int) pool.helpers() + 1);
+    CHECK(on_helpers > 0);
+    CHECK(seen.count(std::this_thread::get_id()) == 1);
+}
+
+static void a_pool_without_helpers_runs_on_the_caller() {
+    skippy_task_pool pool(0);
+    int sum = 0;
+    pool.run(10, [&](size_t index, bool on_helper) {
+        CHECK(!on_helper);
+        sum += (int) index;
+    }, 8);
+    CHECK(sum == 45);
+    CHECK(pool.helpers() == 0);
+    pool.run(0, [&](size_t, bool) { CHECK(false); }, 8);
+}
+
+static void an_exception_reaches_the_caller_and_the_pool_keeps_working() {
+    skippy_task_pool pool(2);
+    std::atomic<int> ran { 0 };
+    bool caught = false;
+    try {
+        pool.run(8, [&](size_t index, bool) {
+            ++ran;
+            if (index == 3) {
+                throw std::runtime_error("task 3");
+            }
+        }, 2);
+    } catch (const std::runtime_error &) {
+        caught = true;
+    }
+    CHECK(caught);
+    CHECK(ran == 8);
+    std::atomic<int> again { 0 };
+    pool.run(8, [&](size_t, bool) { ++again; }, 2);
+    CHECK(again == 8);
+}
+
+static void callers_on_different_threads_take_turns() {
+    skippy_task_pool pool(2);
+    std::atomic<int> total { 0 };
+    std::vector<std::thread> callers;
+    std::generate_n(std::back_inserter(callers), 4, [&] {
+        return std::thread([&] {
+            std::vector<int> rounds(100);
+            std::for_each(rounds.begin(), rounds.end(), [&](int) { pool.run(5, [&](size_t, bool) { ++total; }, 2); });
+        });
+    });
+    std::for_each(callers.begin(), callers.end(), [](std::thread & caller) { caller.join(); });
+    CHECK(total == 4 * 100 * 5);
+}
+
+// Helpers start when a run can use them, and a run never uses more than it asked for.
+static void the_pool_grows_to_demand_and_honours_each_runs_limit() {
+    skippy_task_pool pool(6);
+    CHECK(pool.helpers() == 0);
+    pool.run(1, [](size_t, bool) {}, 6);
+    CHECK(pool.helpers() == 0);
+    pool.run(3, [](size_t, bool) {}, 6);
+    CHECK(pool.helpers() == 2);
+    pool.run(64, [](size_t, bool) {}, 100);
+    CHECK(pool.helpers() == 6);
+
+    std::atomic<int> running { 0 };
+    std::atomic<int> most { 0 };
+    std::atomic<int> on_helpers { 0 };
+    std::vector<int> rounds(200);
+    std::for_each(rounds.begin(), rounds.end(), [&](int) {
+        pool.run(32, [&](size_t, bool on_helper) {
+            const int now = ++running;
+            int before = most.load();
+            while (now > before && !most.compare_exchange_weak(before, now)) {
+            }
+            on_helpers += on_helper ? 1 : 0;
+            std::this_thread::yield();
+            --running;
+        }, 1);
+    });
+    CHECK(most <= 2);
+    std::for_each(rounds.begin(), rounds.end(), [&](int) {
+        pool.run(32, [&](size_t, bool on_helper) { CHECK(!on_helper); }, 0);
+    });
+}
+
+static void sample_threads_select_the_executor() {
+    const auto name_of = [](uint32_t sample_threads) {
+        return std::string(skippy_with_sample_executor(sample_threads,
+                [](const skippy_sample_executor & executor) { return executor.name(); }));
+    };
+    CHECK(name_of(0) == "pool");
+    CHECK(name_of(1) == "inline");
+    CHECK(name_of(4) == "pool");
+
+    std::vector<std::atomic<int>> hits(9);
+    skippy_inline_sampling().run(hits.size(), [&](size_t index, bool on_helper) {
+        CHECK(!on_helper);
+        hits[index]++;
+    });
+    skippy_pooled_sampling(3).run(hits.size(), [&](size_t index, bool) { hits[index]++; });
+    skippy_pooled_sampling(0).run(hits.size(), [&](size_t index, bool) { hits[index]++; });
+    CHECK(std::all_of(hits.begin(), hits.end(), [](const std::atomic<int> & hit) { return hit == 3; }));
+}
+
+int main() {
+    every_index_runs_once();
+    threads_are_bounded_and_reused();
+    a_pool_without_helpers_runs_on_the_caller();
+    an_exception_reaches_the_caller_and_the_pool_keeps_working();
+    callers_on_different_threads_take_turns();
+    the_pool_grows_to_demand_and_honours_each_runs_limit();
+    sample_threads_select_the_executor();
+    CHECK(skippy_task_pool::shared().helpers() <= skippy_task_pool::shared().ceiling());
+    if (failures == 0) {
+        std::printf("ok\n");
+    }
+    return failures == 0 ? 0 : 1;
+}
