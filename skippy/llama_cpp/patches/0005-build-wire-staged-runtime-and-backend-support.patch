+    int physical_device = -1;
+    uint8_t * dst = nullptr;
+    uint32_t channels = 0;
+    uint32_t element_bytes = 0;
+    uint64_t token_stride = 0;
+    uint64_t channel_stride = 0;
+    size_t payload_bytes = 0;
+    std::vector<ggml_cuda_cachegen_payload_copy> payload_copies;
