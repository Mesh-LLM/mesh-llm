+static bool skippy_ngram_cache_valid_config(uint16_t ngram_min, uint16_t ngram_max) {
+    return ngram_min >= LLAMA_NGRAM_MIN && ngram_min <= ngram_max && ngram_max <= LLAMA_NGRAM_MAX;
