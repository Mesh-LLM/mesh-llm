+        (void) cudaSetDevice(original_device);
+        return ggml_cuda_cachegen_cuda_error(error, error_capacity, "CUDA/HIP CacheGen staging release failed", status);
+    }
+    status = cudaSetDevice(original_device);
+    if (status != cudaSuccess) {
