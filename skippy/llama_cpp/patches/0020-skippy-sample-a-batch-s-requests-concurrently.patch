+
+// the session's configured sampler already serves this request
+static bool skippy_uses_session_sampler(
+        const skippy_session * session,
+        const skippy_sampling_config * sampling) {
+    return session->sampler != nullptr &&
+            (!session->chat_sampling_metadata.empty() ||
+             (skippy_sampling_enabled(sampling) && session->sampling_config_valid &&
+              skippy_sampling_configs_equal(session->sampling_config, *sampling)));
+}
+
+bool skippy_prepare_concurrent_sample(
+        skippy_session * session,
+        const skippy_sampling_config * sampling) {
+    if (!skippy_sampling_session_ready(session)) {
+        return false;
+    }
+    try {
+        if (!skippy_uses_session_sampler(session, sampling) &&
+                !skippy_ensure_plain_sampling_chain(session, sampling)) {
+            return false;
+        }
+    } catch (...) {
+        // sampling on the calling thread reports the failure
+        return false;
+    }
+    // a backend sampler reads and retires through the shared context
+    return session->sampler != nullptr && !session->sampling_backend_enabled;
+}
