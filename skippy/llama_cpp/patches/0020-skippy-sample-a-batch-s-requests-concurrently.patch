diff --git a/src/skippy/batch_sampling.cpp b/src/skippy/batch_sampling.cpp
new file mode 100644
index 000000000..e59c89857
--- /dev/null
+++ b/src/skippy/batch_sampling.cpp
@@ -0,0 +1,91 @@
+#include "skippy/batch_sampling.h"
+
+#include "llama-context.h"
+#include "skippy/runtime_types.h"
+#include "skippy/sampling_internal.h"
+#include "skippy/trace_scope.h"
+
+#include <algorithm>
+#include <iterator>
+#include <numeric>
+#include <system_error>
+#include <thread>
+
+namespace {
+
+bool distinct_sessions(const std::vector<skippy_sample_request> & requests) {
+    std::vector<const skippy_session *> sessions(requests.size());
+    std::transform(requests.begin(), requests.end(), sessions.begin(),
+            [](const skippy_sample_request & request) { return request.session; });
+    std::sort(sessions.begin(), sessions.end());
+    return std::adjacent_find(sessions.begin(), sessions.end()) == sessions.end();
+}
+
+llama_token sample(const skippy_sample_request & request) {
+    return skippy_sample_token_ith(request.session, request.sampling, request.logits_index);
+}
+
+// One helper thread per index after the first, which this thread samples.
+// Each thread writes only its own slot of `tokens`.
+void sample_concurrently(
+        const std::vector<skippy_sample_request> & requests,
+        std::vector<size_t>::const_iterator first,
+        std::vector<size_t>::const_iterator last,
+        const llama_synchronized_outputs & outputs,
+        std::vector<llama_token> & tokens) {
+    skippy_trace::scope trace("skippy.sample_concurrent", "requests", std::distance(first, last));
+    const uint64_t parent = skippy_trace::current_parent();
+    const auto sample_reading = [&requests, &tokens, &outputs](size_t index) {
+        const llama_output_reader reader(outputs);
+        tokens[index] = sample(requests[index]);
+    };
+    std::vector<std::thread> helpers;
+    helpers.reserve(static_cast<size_t>(std::distance(first, last)));
+    std::for_each(std::next(first), last, [&](size_t index) {
+        try {
+            helpers.emplace_back([&sample_reading, index, parent] {
+                const skippy_trace::adopt joined(parent);
+                sample_reading(index);
+            });
+        } catch (const std::system_error &) {
+            sample_reading(index);
+        }
+    });
+    sample_reading(*first);
+    std::for_each(helpers.begin(), helpers.end(), [](std::thread & helper) { helper.join(); });
+}
+
+bool share_context(
+        const std::vector<skippy_sample_request> & requests,
+        std::vector<size_t>::const_iterator first,
+        std::vector<size_t>::const_iterator last) {
+    const llama_context * ctx = requests[*first].session->ctx;
+    return std::all_of(first, last, [&](size_t index) { return requests[index].session->ctx == ctx; });
+}
+
+} // namespace
+
+std::vector<llama_token> skippy_sample_requests(const std::vector<skippy_sample_request> & requests) {
+    std::vector<llama_token> tokens(requests.size(), LLAMA_TOKEN_NULL);
+    if (requests.size() < 2 || !distinct_sessions(requests)) {
+        std::transform(requests.begin(), requests.end(), tokens.begin(), sample);
+        return tokens;
+    }
+
+    // Readying a sampler may attach or retire a backend sampler on the shared
+    // context, and those that remain on it sample through it: both stay here.
+    std::vector<size_t> order(requests.size());
+    std::iota(order.begin(), order.end(), size_t { 0 });
+    const auto concurrent = std::stable_partition(order.begin(), order.end(), [&](size_t index) {
+        return !skippy_prepare_concurrent_sample(requests[index].session, requests[index].sampling);
+    });
+    std::for_each(order.begin(), concurrent, [&](size_t index) { tokens[index] = sample(requests[index]); });
+
+    if (std::distance(concurrent, order.end()) < 2 || !share_context(requests, concurrent, order.end())) {
+        std::for_each(concurrent, order.end(), [&](size_t index) { tokens[index] = sample(requests[index]); });
+        return tokens;
+    }
+    const llama_synchronized_outputs outputs = requests[*concurrent].session->ctx->synchronize_outputs();
+    sample_concurrently(requests, concurrent, order.end(), outputs, tokens);
+    return tokens;
+}
