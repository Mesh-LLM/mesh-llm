+++ b/src/skippy/tests/concurrent_sampling.cpp
@@ -0,0 +1,175 @@
+#include "skippy.h"
+#include "../runtime_types.h"
+#include "../sampling_internal.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <iterator>
+#include <numeric>
+#include <string>
+#include <vector>
+
+#define CHECK(condition) do { if (!(condition)) { \
+    std::fprintf(stderr, "CHECK failed: %s at %s:%d\n", #condition, __FILE__, __LINE__); \
+    std::exit(1); } } while (0)
+
+namespace {
+
+constexpr size_t LANES = 4;
+constexpr int STEPS = 12;
+
+void ok(skippy_status status, skippy_error * error) {
+    if (status != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "native failure: %s\n", error ? error->message : "no detail");
+        std::exit(1);
+    }
+    skippy_error_free(error);
+}
+
+struct span {
+    uint64_t    id;
+    uint64_t    parent;
+    std::string name;
+};
+
+// spans arrive from every sampling thread
+std::vector<span> g_spans;
+std::atomic<bool>  g_receiving { false };
+
+void receive(const skippy_native_span_v1 * received, void *) {
+    while (g_receiving.exchange(true, std::memory_order_acquire)) {}
+    g_spans.push_back({ received->id, received->parent, received->name });
+    g_receiving.store(false, std::memory_order_release);
+}
+
+skippy_session * create(skippy_model * model) {
+    skippy_session * session = nullptr;
+    skippy_error * error = nullptr;
+    ok(skippy_session_create(model, &session, &error), error);
+    return session;
+}
+
+// a seeded random sampler: not greedy, so it samples on the CPU
+skippy_sampling_config random_sampling(uint32_t seed) {
+    skippy_sampling_config config{};
+    config.version = 1;
+    config.flags = SKIPPY_SAMPLING_FLAG_ENABLED;
+    config.seed = seed;
+    config.top_k = 40;
+    config.temperature = 1.3f;
+    config.top_p = 0.95f;
+    config.repeat_penalty = 1.0f;
+    config.reasoning_budget_tokens = -1;
+    return config;
+}
+
+std::array<llama_token, LANES> decode_together(
+        const std::array<skippy_session *, LANES> & sessions,
+        const std::array<llama_token, LANES> & tokens,
+        const std::array<skippy_sampling_config, LANES> & sampling) {
+    std::array<skippy_iteration_request, LANES> requests{};
+    std::array<size_t, LANES> order{};
+    std::iota(order.begin(), order.end(), size_t { 0 });
+    std::transform(order.begin(), order.end(), requests.begin(), [&](size_t lane) {
+        skippy_iteration_request request{};
+        request.session = sessions[lane];
+        request.token_ids = &tokens[lane];
+        request.token_count = 1;
+        request.sampling = &sampling[lane];
+        request.sample_last = true;
+        return request;
+    });
+    std::array<size_t, LANES> indexes{};
+    std::array<llama_token, LANES> predicted{};
+    size_t count = 0;
+    skippy_error * error = nullptr;
+    ok(skippy_iteration_batch_sampled(requests.data(), LANES, nullptr, nullptr, nullptr, nullptr,
+            indexes.data(), predicted.data(), LANES, &count, &error), error);
+    CHECK(count == LANES);
+    CHECK(indexes == order);
+    return predicted;
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    CHECK(argc == 2);
+    auto config = skippy_runtime_config_default();
+    config.selected_backend_device = "CPU";
+    config.n_gpu_layers = 0;
+    config.ctx_size = 512;
+    config.lane_count = 2 * LANES;
+    config.kv_unified = 1;
+    skippy_model * model = nullptr;
+    skippy_error * error = nullptr;
+    ok(skippy_model_open(argv[1], &config, &model, &error), error);
+    const auto n_vocab = static_cast<llama_token>(model->model->vocab.n_tokens());
+    CHECK(n_vocab > 64);
+
+    std::array<skippy_session *, LANES> together{};
+    std::array<skippy_session *, LANES> alone{};
+    std::array<skippy_sampling_config, LANES> sampling{};
+    std::array<llama_token, LANES> next{};
+    std::array<size_t, LANES> lanes{};
+    std::iota(lanes.begin(), lanes.end(), size_t { 0 });
+    std::for_each(lanes.begin(), lanes.end(), [&](size_t lane) {
+        together[lane] = create(model);
+        alone[lane] = create(model);
+        sampling[lane] = random_sampling(17 + static_cast<uint32_t>(lane));
+        const std::vector<llama_token> prompt = { static_cast<llama_token>(3 + lane), 7, 5 };
+        size_t bytes = 0;
+        skippy_error * prefill_error = nullptr;
+        ok(skippy_prefill_chunk(together[lane], prompt.data(), prompt.size(),
+                nullptr, 0, nullptr, 0, &bytes, &prefill_error), prefill_error);
+        next[lane] = static_cast<llama_token>(9 + lane);
+    });
+
+    CHECK(skippy_set_native_span_callback(receive, nullptr) == SKIPPY_STATUS_OK);
+    std::vector<llama_token> generated;
+    for (int step = 0; step < STEPS; ++step) {
+        g_spans.clear();
+        const auto predicted = decode_together(together, next, sampling);
+        // Samplers with the same seeds read the same rows, one after another.
+        std::array<llama_token, LANES> expected{};
+        std::transform(lanes.begin(), lanes.end(), expected.begin(), [&](size_t lane) {
+            return skippy_sample_token_ith(alone[lane], &sampling[lane], static_cast<int32_t>(lane));
+        });
+        CHECK(predicted == expected);
+        CHECK(std::all_of(predicted.begin(), predicted.end(),
+                [&](llama_token token) { return token >= 0 && token < n_vocab; }));
+
+        // all four sampled under one concurrent span, which nests in the batch outputs
+        const auto named = [](const char * name) {
+            return [name](const span & candidate) { return candidate.name == name; };
+        };
+        const auto concurrent = std::find_if(g_spans.begin(), g_spans.end(), named("skippy.sample_concurrent"));
+        const auto outputs = std::find_if(g_spans.begin(), g_spans.end(), named("skippy.batch_outputs"));
+        CHECK(concurrent != g_spans.end() && outputs != g_spans.end());
+        CHECK(concurrent->parent == outputs->id);
+        const auto under_concurrent = std::count_if(g_spans.begin(), g_spans.end(), [&](const span & candidate) {
+            return candidate.name == "skippy.sample" && candidate.parent == concurrent->id;
+        });
+        CHECK(under_concurrent == static_cast<long>(LANES));
+
+        generated.insert(generated.end(), predicted.begin(), predicted.end());
+        next = predicted;
+    }
+    CHECK(skippy_set_native_span_callback(nullptr, nullptr) == SKIPPY_STATUS_OK);
+    // seeded random sampling over a random model varies its choices
+    std::sort(generated.begin(), generated.end());
+    CHECK(std::distance(generated.begin(), std::unique(generated.begin(), generated.end())) > 4);
+
+    std::for_each(lanes.begin(), lanes.end(), [&](size_t lane) {
+        skippy_error * free_error = nullptr;
+        ok(skippy_session_free(together[lane], &free_error), free_error);
+        ok(skippy_session_free(alone[lane], &free_error), free_error);
+    });
+    ok(skippy_model_free(model, &error), error);
+    std::printf("ok\n");
+    return 0;
+}
