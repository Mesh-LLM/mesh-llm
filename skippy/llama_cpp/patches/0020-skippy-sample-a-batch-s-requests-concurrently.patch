+struct llama_context;
+
+// Proof that a context's outputs were synchronized and reordered; made only
+// by llama_context::synchronize_outputs.
+class llama_synchronized_outputs {
+  public:
+    const llama_context & context() const { return ctx; }
+
+  private:
+    friend struct llama_context;
+    explicit llama_synchronized_outputs(const llama_context & ctx) : ctx(ctx) {}
+
+    const llama_context & ctx;
+};
+
+// While one lives, its thread reads the context's outputs without
+// synchronizing or reordering them, so several threads may read at once. The
+// thread that synchronized queues no work on the context meanwhile.
+class llama_output_reader {
+  public:
+    explicit llama_output_reader(const llama_synchronized_outputs & outputs);
+    ~llama_output_reader();
+
+    llama_output_reader(const llama_output_reader &)             = delete;
+    llama_output_reader & operator=(const llama_output_reader &) = delete;
+
+  private:
+    const llama_context * previous;
+};
