+++ b/src/skippy/tracing.cpp
@@ -199,6 +199,10 @@ uint64_t current_parent() noexcept {
     return t_current != 0 ? t_current : t_tag;
 }
 
+bool active() noexcept {
+    return g_span_callback.load(std::memory_order_relaxed) != nullptr;
+}
+
 adopt::adopt(uint64_t parent) noexcept : previous_(t_current) {
     if (parent != 0) {
         t_current = parent;
