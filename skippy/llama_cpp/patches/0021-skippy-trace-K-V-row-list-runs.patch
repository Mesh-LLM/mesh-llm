diff --git a/src/skippy/kv_rows_trace.cpp b/src/skippy/kv_rows_trace.cpp
new file mode 100644
index 000000000..e5f06b614
--- /dev/null
+++ b/src/skippy/kv_rows_trace.cpp
@@ -0,0 +1,41 @@
+#include "skippy/kv_rows_trace.h"
+
+#include "skippy/trace_scope.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <string>
+
+// The span's value is the most contiguous cell runs one list holds, and its
+// detail gives cells:runs per slice, so a trace shows how fragmented the
+// unified pool is for each query slice. -1 entries are padding, between runs
+// and after the last.
+void skippy_trace_kv_rows(const int32_t * data, int64_t n_per_slice, int64_t n_slices) {
+    if (!skippy_trace::active()) {
+        return;
+    }
+    thread_local std::string detail;
+    detail.clear();
+    int64_t max_runs = 0;
+    for (int64_t s = 0; s < n_slices; ++s) {
+        const int32_t * begin = data + s * n_per_slice;
+        const int32_t * end   = begin + n_per_slice;
+        int64_t cells = 0;
+        int64_t runs  = 0;
+        int32_t previous = -2;
+        std::for_each(begin, end, [&](int32_t cell) {
+            if (cell < 0) {
+                return;
+            }
+            runs += cell != previous + 1;
+            ++cells;
+            previous = cell;
+        });
+        max_runs = std::max(max_runs, runs);
+        char item[48];
+        std::snprintf(item, sizeof(item), "%s%lld:%lld", s ? " " : "", (long long) cells, (long long) runs);
+        detail += item;
+    }
+    skippy_trace::scope trace("llama.kv_rows", "runs", max_runs);
+    trace.set_detail(detail.c_str());
+}
diff --git a/src/skippy/kv_rows_trace.h b/src/skippy/kv_rows_trace.h
