+
+// Reports one llama.kv_rows span for the row lists a ubatch attends through:
+// `n_slices` lists of `n_per_slice` cell indices each, -1 where padded.
+void skippy_trace_kv_rows(const int32_t * data, int64_t n_per_slice, int64_t n_slices);
