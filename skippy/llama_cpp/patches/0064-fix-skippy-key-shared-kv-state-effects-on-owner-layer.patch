     const ggml_tensor * canonical = skippy_state_canonical_storage(storage);
     int64_t ordinal = 0;
     for (const auto & effect : res->state_effects) {
@@ -2012,7 +2013,8 @@ void llm_graph_context::state_write(skippy_state_kind kind, ggml_tensor * storag
