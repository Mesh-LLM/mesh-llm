@@ -1524,6 +1524,13 @@ ggml_tensor * llama_kv_cache::graph_k_storage(ggml_context * ctx, int32_t il) co
     return result;
 }
 
+int32_t llama_kv_cache::state_owner_layer(int32_t il) const {
+    // shared-KV readers admit under the owner cache layer; layers with no
+    // reuse mapping own themselves
+    const auto found = map_layer_ids.find(il);
+    return found == map_layer_ids.end() ? il : static_cast<int32_t>(layers[found->second].il);
+}
+
 ggml_tensor * llama_kv_cache::graph_v_storage(ggml_context * ctx, int32_t il) const {
     const auto found = map_layer_ids.find(il);
     if (found != map_layer_ids.end()) {
@@ -4388,6 +4395,10 @@ ggml_tensor * llama_kv_cache_context::get_k_storage(int32_t il) const {
     return kv->get_k_storage(il);
 }
 
+int32_t llama_kv_cache_context::state_owner_layer(int32_t il) const {
+    return kv->state_owner_layer(il);
+}
+
 ggml_tensor * llama_kv_cache_context::get_v_storage(int32_t il) const {
     return kv->get_v_storage(il);
 }
