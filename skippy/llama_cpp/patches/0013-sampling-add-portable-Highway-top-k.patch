diff --git a/tests/test-sampler-highway.cpp b/tests/test-sampler-highway.cpp
new file mode 100644
index 000000000..4b3453056
--- /dev/null
+++ b/tests/test-sampler-highway.cpp
@@ -0,0 +1,213 @@
+#include "llama-sampler-top-k.h"
+
+#include <algorithm>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include <random>
+#include <stdexcept>
+#include <vector>
+
+static constexpr size_t vocabulary = 248320;
+static constexpr int32_t top_k = 40;
+
+static void check(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+static bool same(const std::vector<llama_token_data> & a, const std::vector<llama_token_data> & b) {
+    return a.size() == b.size() && (a.empty() || std::memcmp(a.data(), b.data(), a.size() * sizeof(a[0])) == 0);
+}
+
+static std::vector<llama_token_data> input(size_t size, unsigned pattern) {
+    std::vector<llama_token_data> result(size);
+    for (size_t i = 0; i < size; ++i) {
+        const auto rank = static_cast<int64_t>(i) - static_cast<int64_t>(size / 2);
+        result[i] = {static_cast<llama_token>(i), static_cast<float>(rank), static_cast<float>(i % 17) / 17.0f};
+    }
+    if (pattern == 1) {
+        std::reverse(result.begin(), result.end());
+    } else if (pattern == 2) {
+        std::mt19937 rng(73);
+        std::shuffle(result.begin(), result.end(), rng);
+    } else if (pattern == 3) {
+        for (auto & token : result) { token.logit = 0.0f; }
+    }
+    return result;
+}
+
+static void native_select(std::vector<llama_token_data> & values, size_t count) {
+    std::partial_sort(values.begin(), values.begin() + count, values.end(),
+                     [](const auto & a, const auto & b) { return a.logit > b.logit; });
+    values.resize(count);
+}
+
+// Success promises the selected prefix, not native partial_sort's tail swaps.
+// Refusal promises all records and every descriptor field remain unchanged.
+static bool differential(std::vector<llama_token_data> values, int32_t k, int expected = -1) {
+    auto original = values;
+    llama_top_k_scratch scratch;
+    llama_token_data_array candidates{values.data(), values.size(), 7, false};
+    const bool used = llama_sampler_top_k_highway(scratch, &candidates, k, true);
+    if (expected >= 0) { check(used == (expected != 0), "unexpected eligibility/fallback"); }
+    if (!used) {
+        check(same(values, original), "fallback mutated input");
+        check(candidates.size == original.size() && !candidates.sorted && candidates.selected == 7,
+              "fallback mutated descriptor");
+        return false;
+    }
+    check(k == top_k && values.size() >= vocabulary, "unsupported fast path");
+    native_select(original, top_k);
+    values.resize(candidates.size);
+    check(candidates.size == top_k && candidates.sorted && candidates.selected == 7, "wrong descriptor");
+    check(same(values, original), "selected records/order differ from native partial_sort");
+    return true;
+}
+
+static void exceptional_positions() {
+    const float infinity = std::numeric_limits<float>::infinity();
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    // Covers the initial heap, all capped SIMD lane positions and the scalar tail.
+    for (size_t position : {size_t(0), size_t(39), size_t(40), size_t(41), size_t(43),
+                            size_t(47), size_t(55), vocabulary, vocabulary + 2}) {
+        for (float value : {nan, infinity, -infinity, -0.0f, 0.0f}) {
+            auto values = input(vocabulary + 3, 1);
+            values[position].logit = value;
+            differential(std::move(values), top_k);
+        }
+    }
+    for (size_t tied_rank : {size_t(0), size_t(38), size_t(39), size_t(40)}) {
+        auto values = input(vocabulary, 1);
+        values[tied_rank + 1].logit = values[tied_rank].logit;
+        differential(std::move(values), top_k, tied_rank <= 39 ? 0 : 1);
+    }
+    auto values = input(vocabulary, 0);
+    values[0].logit = values[1].logit;
+    differential(std::move(values), top_k, 1); // A rising cutoff retires this tie.
+
+    values = input(vocabulary, 1);
+    for (size_t i = 0; i < values.size(); ++i) {
+        values[i].logit = i < 39 ? static_cast<float>(100 - i) : -1.0f;
+    }
+    values[39].logit = -0.0f;
+    values[40].logit = 0.0f;
+    differential(std::move(values), top_k, 0);
+
+    values = input(vocabulary, 1);
+    for (size_t i = top_k; i < values.size(); ++i) { values[i].logit = -infinity; }
+    differential(values, top_k, 1); // Finite prefix followed by a heavily masked tail.
+    values[40].logit = values[39].logit;
+    differential(std::move(values), top_k, 0); // Delayed fallback restores the entire buffer.
+}
+
+static void guards() {
+    auto values = input(vocabulary, 2);
+    const auto original = values;
+    llama_top_k_scratch scratch;
+    llama_token_data_array candidates{values.data(), values.size(), 7, false};
+    check(!llama_sampler_top_k_highway(scratch, &candidates, top_k, false), "disabled control used Highway");
+    check(same(values, original) && candidates.size == vocabulary && candidates.selected == 7 && !candidates.sorted,
+          "disabled control changed input");
+    candidates.size = static_cast<size_t>(std::numeric_limits<int32_t>::max()) + 1;
+    check(!llama_sampler_top_k_highway(scratch, &candidates, top_k, true), "unsupported native array size accepted");
+    check(same(values, original) && candidates.selected == 7 && !candidates.sorted,
+          "oversized refusal changed input");
+    candidates.size = vocabulary;
+    candidates.sorted = true;
+    check(!llama_sampler_top_k_highway(scratch, &candidates, top_k, true), "sorted candidates reselected");
+    check(same(values, original) && candidates.size == vocabulary && candidates.selected == 7 && candidates.sorted,
+          "sorted control changed input");
+    for (int32_t k : {-1, 0}) {
+        auto * sampler = llama_sampler_init_top_k(k);
+        candidates.sorted = false;
+        llama_sampler_apply(sampler, &candidates);
+        llama_sampler_free(sampler);
+        check(same(values, original) && candidates.size == vocabulary && candidates.selected == 7 && !candidates.sorted,
+              "nonpositive k changed native no-op behavior");
+    }
+}
+
+static llama_sampler * downstream() {
+    auto * chain = llama_sampler_chain_init(llama_sampler_chain_default_params());
+    llama_sampler_chain_add(chain, llama_sampler_init_temp(0.7f));
+    llama_sampler_chain_add(chain, llama_sampler_init_top_p(0.9f, 1));
+    llama_sampler_chain_add(chain, llama_sampler_init_dist(73));
+    return chain;
+}
+
+static void reuse_and_refill() {
+    auto * sampler = llama_sampler_init_top_k(top_k);
+    auto * actual_chain = downstream();
+    auto * reference_chain = downstream();
+    std::vector<llama_token_data> values;
+    // Native common_sampler calls set_logits before each sample and before
+    // grammar rejection/resampling. Refill every record before enlarging size.
+    for (unsigned iteration = 0; iteration < 32; ++iteration) {
+        const size_t size = iteration % 3 == 0 ? 32768 : vocabulary + iteration;
+        values = input(size, iteration % 3);
+        if (iteration % 4 == 1) {
+            for (size_t i = 0; i < values.size(); ++i) {
+                if (i % 3 != 0) { values[i].logit = -std::numeric_limits<float>::infinity(); }
+            }
+        }
+        auto expected = values;
+        if (iteration % 7 == 0) {
+            auto clone_values = values;
+            auto * clone = llama_sampler_clone(sampler);
+            llama_token_data_array cloned{clone_values.data(), clone_values.size(), -1, false};
+            llama_sampler_apply(clone, &cloned);
+            auto clone_expected = values;
+            native_select(clone_expected, top_k);
+            check(cloned.size == top_k && cloned.sorted && cloned.selected == -1 &&
+                  std::memcmp(clone_values.data(), clone_expected.data(), top_k * sizeof(values[0])) == 0,
+                  "cloned sampler prefix/descriptor mismatch");
+            llama_sampler_free(clone);
+        }
+        native_select(expected, top_k);
+        llama_token_data_array actual{values.data(), values.size(), -1, false};
+        llama_sampler_apply(sampler, &actual);
+        check(actual.size == top_k && actual.sorted && actual.selected == -1, "integrated top-k descriptor mismatch");
+        check(std::memcmp(values.data(), expected.data(), top_k * sizeof(values[0])) == 0,
+              "integrated/refilled top-k prefix mismatch");
+        llama_token_data_array reference{expected.data(), expected.size(), -1, true};
+        llama_sampler_apply(actual_chain, &actual);
+        llama_sampler_apply(reference_chain, &reference);
+        check(actual.size == reference.size && actual.selected == reference.selected && actual.sorted == reference.sorted,
+              "downstream sampler descriptor mismatch");
+        check(std::memcmp(actual.data, reference.data, actual.size * sizeof(values[0])) == 0,
+              "downstream sampler records mismatch");
+        check(actual.selected >= 0 && static_cast<size_t>(actual.selected) < actual.size, "no selected token");
+        const llama_token token = actual.data[actual.selected].id;
+        llama_sampler_accept(sampler, token);
+        llama_sampler_accept(actual_chain, token);
+        llama_sampler_accept(reference_chain, token);
+        if (iteration % 7 == 0) {
+            llama_sampler_reset(sampler);
+            llama_sampler_reset(actual_chain);
+            llama_sampler_reset(reference_chain);
+        }
+    }
+    llama_sampler_free(sampler);
+    llama_sampler_free(actual_chain);
+    llama_sampler_free(reference_chain);
+}
+
+int main() {
+    try {
+        for (size_t size : {0, 1, 3, 4, 7, 8, 15, 16, 31, 32, 39, 40, 41, 127, 128, 129, 1024, 4096, 32768, 248319, 248320, 248321, 248323, 248337}) {
+            for (int32_t k : {-1, 0, 1, 2, 4, 39, 40, 41, 128, 129, static_cast<int32_t>(size), static_cast<int32_t>(size + 1)}) {
+                for (unsigned pattern = 0; pattern != 4; ++pattern) {
+                    differential(input(size, pattern), k, size >= vocabulary && k == top_k && pattern != 3 ? 1 : 0);
+                }
+            }
+        }
+        exceptional_positions();
+        guards();
+        reuse_and_refill();
+        std::cout << "Highway heap top-k differential/edge/fallback/refill/downstream checks passed\n";
+        return 0;
+    } catch (const std::exception & error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
-- 
2.56.0

