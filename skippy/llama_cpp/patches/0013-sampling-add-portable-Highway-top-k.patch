diff --git a/src/llama-sampler-top-k.cpp b/src/llama-sampler-top-k.cpp
new file mode 100644
index 000000000..737fee8db
--- /dev/null
+++ b/src/llama-sampler-top-k.cpp
@@ -0,0 +1,113 @@
+#include "llama-sampler-top-k.h"
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+
+#undef HWY_TARGET_INCLUDE
+#define HWY_TARGET_INCLUDE "llama-sampler-top-k.cpp"
+#include "hwy/foreach_target.h"
+#include "hwy/highway.h"
+
+HWY_BEFORE_NAMESPACE();
+namespace llama_top_k {
+namespace HWY_NAMESPACE {
+namespace hn = hwy::HWY_NAMESPACE;
+
+// A named target frame lets the experiment verify executed SIMD dispatch.
+static HWY_NOINLINE bool HeapFilter(llama_top_k_scratch & scratch, llama_token_data * data, size_t size) {
+    constexpr size_t k = 40;
+    for (size_t i = 0; i < k; ++i) {
+        uint32_t bits;
+        static_assert(sizeof(bits) == sizeof(data[i].logit), "32-bit logits required");
+        std::memcpy(&bits, &data[i].logit, sizeof(bits));
+        // A masked or exceptional initial heap stays on the native path.
+        if ((bits & 0x7fffffffU) >= 0x7f800000U) {
+            return false;
+        }
+    }
+    const auto compare = [](const llama_token_data & a, const llama_token_data & b) {
+        return a.logit > b.logit;
+    };
+    std::copy_n(data, k, scratch.original.data());
+    std::make_heap(data, data + k, compare);
+    bool boundary_tie = false;
+    const auto consider = [&](const llama_token_data & token) {
+        const float previous = data[0].logit;
+        if (token.logit > previous) {
+            std::pop_heap(data, data + k, compare);
+            data[k - 1] = token;
+            std::push_heap(data, data + k, compare);
+            // Raising the cutoff retires ambiguity at earlier, lower cutoffs.
+            boundary_tie = data[0].logit == previous;
+        } else if (token.logit == previous) {
+            boundary_tie = true;
+        }
+    };
+    const hn::CappedTag<float, 16> df;
+    const size_t lanes = hn::Lanes(df);
+    HWY_ALIGN_MAX float logits[16];
+    size_t i = k;
+    for (; i + lanes <= size; i += lanes) {
+        for (size_t lane = 0; lane < lanes; ++lane) {
+            logits[lane] = data[i + lane].logit;
+        }
+        const auto scores = hn::LoadU(df, logits);
+        const auto cutoff = hn::Set(df, data[0].logit);
+        // Equal logits must reach scalar tie detection. Tail NaNs fail ordered
+        // comparisons, as in the admitted libc++/libstdc++ partial_sort paths.
+        if (hn::AllFalse(df, hn::Ge(scores, cutoff))) {
+            continue;
+        }
+        for (size_t lane = 0; lane < lanes; ++lane) {
+            consider(data[i + lane]);
+        }
+    }
+    for (; i < size; ++i) {
+        consider(data[i]);
+    }
+    std::sort_heap(data, data + k, compare);
+    for (size_t j = 1; j < k; ++j) {
+        boundary_tie |= data[j - 1].logit == data[j].logit;
+    }
+    if (boundary_tie) {
+        // The tail was never changed, so restoring this prefix restores all input.
+        std::copy_n(scratch.original.data(), k, data);
+        return false;
+    }
+    return true;
+}
+}
+}
+HWY_AFTER_NAMESPACE();
+
+#if HWY_ONCE
+namespace llama_top_k {
+HWY_EXPORT(HeapFilter);
+static bool dispatch(llama_top_k_scratch & scratch, llama_token_data * data, size_t size) {
+    return HWY_DYNAMIC_DISPATCH(HeapFilter)(scratch, data, size);
+}
+}
+
+bool llama_sampler_top_k_highway(llama_top_k_scratch & scratch,
+                                llama_token_data_array * candidates,
+                                int32_t k, bool enabled) {
+    // Local development showed regressions for smaller arrays. The first fresh
+    // candidate is restricted to the demonstrated vocabulary size and k.
+    if (!enabled || candidates->sorted || k != 40 || candidates->size < 248320 ||
+            candidates->size > static_cast<size_t>(std::numeric_limits<int32_t>::max()) || !std::numeric_limits<float>::is_iec559) {
+        return false;
+    }
+#if defined(__FAST_MATH__)
+    // Exceptional-value equivalence requires ordered comparisons.
+    return false;
+#else
+    if (!llama_top_k::dispatch(scratch, candidates->data, candidates->size)) {
+        return false;
+    }
+    candidates->size = 40;
+    candidates->sorted = true;
+    return true;
+#endif
+}
+#endif
diff --git a/src/llama-sampler-top-k.h b/src/llama-sampler-top-k.h
new file mode 100644
index 000000000..b147ac231
--- /dev/null
+++ b/src/llama-sampler-top-k.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include "llama.h"
+
+#include <array>
+#include <cstdint>
+
+struct llama_top_k_scratch {
+    std::array<llama_token_data, 40> original;
+};
+
+// False preserves every record and the descriptor for the native fallback.
+// On success only the selected prefix is meaningful; callers must refill logits
+// before expanding the candidate array, as with native bucket-based selection.
+bool llama_sampler_top_k_highway(llama_top_k_scratch & scratch,
+                                llama_token_data_array * candidates,
+                                int32_t k, bool enabled);
