diff --git a/tests/test-sampler-highway.cpp b/tests/test-sampler-highway.cpp
new file mode 100644
index 000000000..38a6965f6
--- /dev/null
+++ b/tests/test-sampler-highway.cpp
@@ -0,0 +1,125 @@
+#include "llama-sampler-top-k.h"
+
+#include <algorithm>
+#include <cstring>
+#include <iostream>
+#include <limits>
+#include <random>
+#include <stdexcept>
+#include <vector>
+
+static void check(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+static bool same(const std::vector<llama_token_data> & a, const std::vector<llama_token_data> & b) {
+    return a.size() == b.size() && (a.empty() || std::memcmp(a.data(), b.data(), a.size() * sizeof(a[0])) == 0);
+}
+
+static std::vector<llama_token_data> input(size_t size, unsigned pattern) {
+    std::vector<llama_token_data> result(size);
+    for (size_t i = 0; i < size; ++i) {
+        const auto rank = static_cast<int64_t>(i) - static_cast<int64_t>(size / 2);
+        result[i] = {static_cast<llama_token>(i), static_cast<float>(rank), static_cast<float>(i % 17) / 17.0f};
+    }
+    if (pattern == 1) {
+        std::reverse(result.begin(), result.end());
+    } else if (pattern == 2) {
+        std::mt19937 rng(73);
+        std::shuffle(result.begin(), result.end(), rng);
+    } else if (pattern == 3) {
+        for (auto & token : result) { token.logit = 0.0f; }
+    }
+    return result;
+}
+
+static void differential(size_t size, int32_t k, unsigned pattern) {
+    auto original = input(size, pattern);
+    auto actual = original;
+    llama_top_k_scratch scratch;
+    llama_token_data_array candidates{actual.data(), actual.size(), -1, false};
+    const bool used = llama_sampler_top_k_highway(scratch, &candidates, k, true);
+    if (!used) {
+        check(same(original, actual), "fallback mutated input");
+        check(candidates.size == size && !candidates.sorted && candidates.selected == -1, "fallback mutated descriptor");
+        return;
+    }
+    check(k > 0 && k <= 128 && size >= 1024, "unsupported fast path");
+    const size_t count = std::min(size, static_cast<size_t>(k));
+    std::partial_sort(original.begin(), original.begin() + count, original.end(),
+                     [](const auto & a, const auto & b) { return a.logit > b.logit; });
+    original.resize(count); actual.resize(candidates.size);
+    check(candidates.sorted && candidates.selected == -1, "wrong descriptor");
+    check(same(original, actual), "selected records/order differ from native partial_sort");
+}
+
+static void exceptional_inputs() {
+    for (float exceptional : {std::numeric_limits<float>::quiet_NaN(),
+                              std::numeric_limits<float>::infinity(),
+                              -std::numeric_limits<float>::infinity(), -0.0f, 0.0f}) {
+        auto values = input(4096, 2);
+        values[17].logit = exceptional;
+        auto original = values;
+        llama_token_data_array candidates{values.data(), values.size(), -1, false};
+        llama_top_k_scratch scratch;
+        const bool used = llama_sampler_top_k_highway(scratch, &candidates, 40, true);
+        if (!used) {
+            check(same(values, original), "exceptional fallback mutated input");
+        } else {
+            std::partial_sort(original.begin(), original.begin() + 40, original.end(),
+                             [](const auto & a, const auto & b) { return a.logit > b.logit; });
+            original.resize(40); values.resize(candidates.size);
+            check(same(values, original), "exceptional selection mismatch");
+        }
+    }
+    for (size_t tied_rank : {size_t(0), size_t(38), size_t(39), size_t(40)}) {
+        auto values = input(4096, 1);
+        values[tied_rank + 1].logit = values[tied_rank].logit;
+        const auto original = values;
+        llama_top_k_scratch scratch;
+        llama_token_data_array candidates{values.data(), values.size(), -1, false};
+        const bool used = llama_sampler_top_k_highway(scratch, &candidates, 40, true);
+        if (tied_rank <= 39) { check(!used, "selected/boundary tie did not fall back"); }
+        if (!used) { check(same(values, original), "tie fallback mutated input"); }
+    }
+    auto values = input(4096, 2);
+    const auto original = values;
+    llama_top_k_scratch scratch;
+    llama_token_data_array candidates{values.data(), values.size(), -1, false};
+    check(!llama_sampler_top_k_highway(scratch, &candidates, 40, false), "disabled control used Highway");
+    check(same(values, original), "disabled control mutated input");
+    candidates.sorted = true;
+    check(!llama_sampler_top_k_highway(scratch, &candidates, 40, true), "sorted candidates reselected");
+    check(same(values, original), "sorted input mutated");
+}
+
+static void scratch_reuse() {
+    llama_top_k_scratch scratch;
+    for (size_t size : {size_t(248320), size_t(1024), size_t(4096)}) {
+        auto values = input(size, 2);
+        auto expected = values;
+        llama_token_data_array candidates{values.data(), values.size(), -1, false};
+        check(llama_sampler_top_k_highway(scratch, &candidates, 40, true), "unique input unexpectedly refused");
+        std::partial_sort(expected.begin(), expected.begin() + 40, expected.end(),
+                         [](const auto & a, const auto & b) { return a.logit > b.logit; });
+        expected.resize(40); values.resize(candidates.size);
+        check(same(values, expected), "reused scratch changed selected records");
+    }
+}
+
+int main() {
+    try {
+        for (size_t size : {0,1,3,4,7,8,15,16,31,32,39,40,41,127,128,129,1024,248320}) {
+            for (int32_t k : {-1,0,1,2,4,40,128,129,static_cast<int32_t>(size),static_cast<int32_t>(size + 1)}) {
+                for (unsigned pattern = 0; pattern != 4; ++pattern) { differential(size, k, pattern); }
+            }
+        }
+        exceptional_inputs();
+        scratch_reuse();
+        std::cout << "Highway top-k differential/edge/fallback/scratch checks passed\n";
+        return 0;
+    } catch (const std::exception & error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
