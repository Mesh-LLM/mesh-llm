diff --git a/src/llama-sampler-top-k.cpp b/src/llama-sampler-top-k.cpp
new file mode 100644
index 000000000..a0d56d445
--- /dev/null
+++ b/src/llama-sampler-top-k.cpp
@@ -0,0 +1,52 @@
+#include "llama-sampler-top-k.h"
+
+#include "hwy/contrib/sort/vqsort.h"
+
+#include <algorithm>
+#include <cstring>
+#include <limits>
+
+bool llama_sampler_top_k_highway(llama_top_k_scratch & scratch,
+                                llama_token_data_array * candidates,
+                                int32_t k, bool enabled) {
+    if (!enabled || candidates->sorted || k <= 0 || k > 128 ||
+            candidates->size < 1024 || candidates->size > UINT32_MAX ||
+            !std::numeric_limits<float>::is_iec559) {
+        return false;
+    }
+    const size_t selected = std::min(static_cast<size_t>(k), candidates->size);
+    // The extra key detects a tie across the selection boundary as well as
+    // ties inside the selected range. Native ordering stays authoritative.
+    const size_t checked = std::min(selected + 1, candidates->size);
+    scratch.keys.resize(candidates->size);
+    for (size_t i = 0; i < candidates->size; ++i) {
+        uint32_t bits;
+        static_assert(sizeof(bits) == sizeof(candidates->data[i].logit), "32-bit logits required");
+        std::memcpy(&bits, &candidates->data[i].logit, sizeof(bits));
+        const auto magnitude = bits & 0x7fffffffU;
+        // Preserve the existing implementation for NaN and positive infinity.
+        // Bit tests remain valid even under an aggressive floating-point build.
+        if (magnitude > 0x7f800000U || bits == 0x7f800000U) {
+            return false;
+        }
+        if (magnitude == 0) {
+            bits = 0; // Native float comparisons treat both signed zeros equally.
+        }
+        const uint32_t key = bits ^ ((bits & 0x80000000U) ? 0xffffffffU : 0x80000000U);
+        scratch.keys[i] = {static_cast<uint32_t>(i), key};
+    }
+    hwy::VQPartialSort(scratch.keys.data(), scratch.keys.size(), checked, hwy::SortDescending{});
+    for (size_t i = 1; i < checked; ++i) {
+        if (scratch.keys[i - 1].key == scratch.keys[i].key) {
+            return false;
+        }
+    }
+    scratch.selected.resize(selected);
+    for (size_t i = 0; i < selected; ++i) {
+        scratch.selected[i] = candidates->data[scratch.keys[i].value];
+    }
+    std::copy(scratch.selected.begin(), scratch.selected.end(), candidates->data);
+    candidates->size = selected;
+    candidates->sorted = true;
+    return true;
+}
diff --git a/src/llama-sampler-top-k.h b/src/llama-sampler-top-k.h
new file mode 100644
index 000000000..01e9cffa6
--- /dev/null
+++ b/src/llama-sampler-top-k.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include "llama.h"
+#include "hwy/base.h"
+
+#include <cstdint>
+#include <vector>
+
+struct llama_top_k_scratch {
+    std::vector<hwy::K32V32> keys;
+    std::vector<llama_token_data> selected;
+};
+
+// False leaves the input untouched so the original selector owns all fallbacks.
+bool llama_sampler_top_k_highway(llama_top_k_scratch & scratch,
+                                llama_token_data_array * candidates,
+                                int32_t k, bool enabled);
