+bool llama_kv_cache::stage_export_kv_page(
+        llama_seq_id seq_id,
+        int32_t layer_start,
+        int32_t layer_end,
+        uint64_t token_start,
+        uint64_t token_count,
+        skippy_kv_page_desc * out_desc,
+        void * output,
+        size_t output_capacity,
+        size_t * out_bytes,
+        std::string & error) const {
+    if (out_desc == nullptr || out_bytes == nullptr) {
+        error = "out_desc and out_bytes are required";
+        return false;
+    }
+    llama_kv_page_layout layout;
+    if (!stage_kv_page_layout(seq_id, layer_start, layer_end, token_start, token_count, layout, error)) {
+        return false;
+    }
+    *out_desc = layout.desc;
+    *out_bytes = static_cast<size_t>(layout.desc.payload_bytes);
+
+    if (output == nullptr) {
+        return true;
+    }
+    if (output_capacity < static_cast<size_t>(layout.desc.payload_bytes)) {
+        error = "output buffer is too small";
+        return false;
+    }
+
+    char * dst = static_cast<char *>(output);
+    stage_kv_page_walk(layout, [&dst](ggml_tensor * tensor, size_t offset, size_t bytes) {
+        ggml_backend_tensor_get(tensor, dst, offset, bytes);
+        dst += bytes;
+    });
+    return true;
+}
+
+static bool llama_kv_cache_tensor_host_visible(const ggml_tensor * tensor) {
+    return tensor == nullptr || (tensor->buffer != nullptr && tensor->data != nullptr && ggml_backend_buffer_is_host(tensor->buffer));
+}
+
+bool llama_kv_cache::stage_kv_page_host_visible() const {
+    for (const auto & layer : layers) {
+        for (const auto * k : layer.k_stream) {
+            if (!llama_kv_cache_tensor_host_visible(k)) {
+                return false;
+            }
+        }
+        for (const auto * v : layer.v_stream) {
+            if (!llama_kv_cache_tensor_host_visible(v)) {
+                return false;
+            }
+        }
+        for (const auto * k_idx : layer.k_idx_stream) {
+            if (!llama_kv_cache_tensor_host_visible(k_idx)) {
+                return false;
+            }
+        }
+    }
+    return !layers.empty();
+}
+
+bool llama_kv_cache::stage_export_kv_page_spans(
+        llama_seq_id seq_id,
+        int32_t layer_start,
+        int32_t layer_end,
+        uint64_t token_start,
+        uint64_t token_count,
+        skippy_kv_page_desc * out_desc,
+        skippy_kv_page_span * spans,
+        size_t span_capacity,
+        size_t * out_span_count,
+        std::string & error) const {
+    if (out_desc == nullptr || out_span_count == nullptr) {
+        error = "out_desc and out_span_count are required";
+        return false;
+    }
+    if (!stage_kv_page_host_visible()) {
+        error = "KV cells are not host visible";
+        return false;
+    }
+    llama_kv_page_layout layout;
+    if (!stage_kv_page_layout(seq_id, layer_start, layer_end, token_start, token_count, layout, error)) {
+        return false;
+    }
+    *out_desc = layout.desc;
+
+    size_t count = 0;
+    stage_kv_page_walk(layout, [&](ggml_tensor * tensor, size_t offset, size_t bytes) {
+        if (spans != nullptr && count < span_capacity) {
+            spans[count].data = static_cast<const char *>(tensor->data) + offset;
+            spans[count].bytes = bytes;
+        }
+        ++count;
+    });
+    *out_span_count = count;
+    if (spans == nullptr) {
+        return true;
+    }
+    if (span_capacity < count) {
+        error = "span buffer is too small";
+        return false;
+    }
     return true;
 }
 
