 }
 
+// Composite pages place the base spans before the SWA spans, matching the
+// byte order skippy_export_iswa_kv_page writes.
+static bool skippy_export_iswa_kv_page_spans(
+        skippy_session * session,
+        llama_kv_cache_iswa * iswa,
+        int32_t layer_start,
+        int32_t layer_end,
+        uint64_t token_start,
+        uint64_t token_count,
+        skippy_kv_page_desc * out_desc,
+        skippy_kv_page_span * spans,
+        size_t span_capacity,
+        size_t * out_span_count,
+        std::string & error) {
+    if (out_desc == nullptr || out_span_count == nullptr) {
+        error = "out_desc and out_span_count are required";
+        return false;
+    }
+    if (token_start + token_count < token_start) {
+        error = "token range is too large";
+        return false;
+    }
+    const uint64_t n_swa = iswa->get_swa()->get_n_swa();
+    const uint64_t token_end = token_start + token_count;
+    const uint64_t swa_start = n_swa == 0 || token_count <= n_swa ? token_start : token_end - n_swa;
+    const uint64_t swa_count = token_end - swa_start;
+
+    skippy_kv_page_desc base = {};
+    skippy_kv_page_desc swa = {};
+    size_t base_spans = 0;
+    size_t swa_spans = 0;
+    if (!iswa->get_base()->stage_export_kv_page_spans(session->seq_id, layer_start, layer_end, token_start, token_count, &base, nullptr, 0, &base_spans, error) ||
+            !iswa->get_swa()->stage_export_kv_page_spans(session->seq_id, layer_start, layer_end, swa_start, swa_count, &swa, nullptr, 0, &swa_spans, error)) {
+        return false;
+    }
+    if (base.payload_bytes > std::numeric_limits<size_t>::max() - swa.payload_bytes ||
+            base_spans > std::numeric_limits<size_t>::max() - swa_spans) {
+        error = "composite KV page payload is too large";
+        return false;
+    }
+    *out_desc = {};
+    out_desc->version = 2;
+    out_desc->layer_start = layer_start;
+    out_desc->layer_end = layer_end;
+    out_desc->token_start = token_start;
+    out_desc->token_count = token_count;
+    out_desc->payload_bytes = base.payload_bytes + swa.payload_bytes;
+    out_desc->codec = SKIPPY_KV_PAGE_CODEC_ISWA_COMPOSITE_V1;
+    out_desc->component_count = 2;
+    out_desc->components[0] = skippy_component_from_page(base, SKIPPY_KV_PAGE_COMPONENT_BASE, 0);
+    out_desc->components[1] = skippy_component_from_page(swa, SKIPPY_KV_PAGE_COMPONENT_SWA, base.payload_bytes);
+    *out_span_count = base_spans + swa_spans;
+    if (spans == nullptr) {
+        return true;
+    }
+    if (span_capacity < base_spans + swa_spans) {
+        error = "span buffer is too small";
+        return false;
+    }
+    return iswa->get_base()->stage_export_kv_page_spans(session->seq_id, layer_start, layer_end, token_start, token_count, &base, spans, base_spans, &base_spans, error) &&
+           iswa->get_swa()->stage_export_kv_page_spans(session->seq_id, layer_start, layer_end, swa_start, swa_count, &swa, spans + base_spans, swa_spans, &swa_spans, error);
+}
+
+enum skippy_status skippy_export_kv_page_spans(
+        struct skippy_session * session,
+        int32_t layer_start,
+        int32_t layer_end,
+        uint64_t token_start,
+        uint64_t token_count,
+        struct skippy_kv_page_desc * out_desc,
+        struct skippy_kv_page_span * spans,
+        size_t span_capacity,
+        size_t * out_span_count,
+        struct skippy_error ** out_error) {
+    if (session == nullptr || session->ctx == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "session is required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    if (!session->stage_model ||
+            !(skippy_model_memory_cache_capabilities(session->stage_model) & SKIPPY_MEMORY_CACHE_HOST_VISIBLE_KV)) {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "loaded KV cells are not host visible");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    // Pending graph work may still be writing these cells; the spans must
+    // describe settled bytes.
+    session->ctx->synchronize();
+    std::string error;
+    bool ok = false;
+    if (auto * iswa = skippy_get_iswa_cache(session)) {
+        ok = skippy_export_iswa_kv_page_spans(session, iswa, layer_start, layer_end, token_start, token_count, out_desc, spans, span_capacity, out_span_count, error);
+    } else if (auto * kv = skippy_get_kv_cache(session, out_error)) {
+        ok = kv->stage_export_kv_page_spans(session->seq_id, layer_start, layer_end, token_start, token_count, out_desc, spans, span_capacity, out_span_count, error);
+        if (ok && out_desc != nullptr) {
+            out_desc->codec = SKIPPY_KV_PAGE_CODEC_SINGLE_V1;
+        }
+    } else {
+        skippy_set_error(out_error, SKIPPY_STATUS_UNSUPPORTED, "runtime memory type is not supported for native KV pages");
+        return SKIPPY_STATUS_UNSUPPORTED;
+    }
+    if (!ok) {
+        const bool too_small = out_span_count != nullptr && *out_span_count > span_capacity;
+        const enum skippy_status status = too_small ? SKIPPY_STATUS_BUFFER_TOO_SMALL : SKIPPY_STATUS_RUNTIME_ERROR;
+        skippy_set_error(out_error, status, error.c_str());
+        return status;
+    }
+    if (spans == nullptr || (out_span_count != nullptr && *out_span_count > span_capacity)) {
+        skippy_set_error(out_error, SKIPPY_STATUS_BUFFER_TOO_SMALL, "native KV page span buffer is too small");
+        return SKIPPY_STATUS_BUFFER_TOO_SMALL;
+    }
+    return skippy_success(out_error);
+}
