         size_t * out_bytes,
         struct skippy_error ** out_error);
 
+/** @brief One host-addressable slice of a KV page, in payload order. */
+struct skippy_kv_page_span {
+    const void * data;
+    size_t bytes;
+};
+
+/** @brief Describes a KV page as spans into the live cells instead of copying it.
+ *
+ *  Requires SKIPPY_MEMORY_CACHE_HOST_VISIBLE_KV. Concatenating the spans in
+ *  order yields exactly the bytes skippy_export_kv_page writes for the same
+ *  arguments, with the same descriptor. The spans alias the session's cells:
+ *  they stay valid until the session decodes, trims below token_start +
+ *  token_count, resets, imports state, or is freed. Pass spans = NULL to size.
+ *  Returns SKIPPY_STATUS_UNSUPPORTED when the loaded memory is not host
+ *  visible, so callers fall back to the copying export. */
+LLAMA_API enum skippy_status skippy_export_kv_page_spans(
+        struct skippy_session * session,
+        int32_t layer_start,
+        int32_t layer_end,
+        uint64_t token_start,
+        uint64_t token_count,
+        struct skippy_kv_page_desc * out_desc,
+        struct skippy_kv_page_span * spans,
+        size_t span_capacity,
+        size_t * out_span_count,
+        struct skippy_error ** out_error);
+
 /** @brief Imports a described KV page. Composite pages require a fresh session and are cleared on failure. */
 LLAMA_API enum skippy_status skippy_import_kv_page(
         struct skippy_session * session,
