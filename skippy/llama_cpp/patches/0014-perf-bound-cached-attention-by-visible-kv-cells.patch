     require_extent(kv.get_cells(1).seq_used_max_p1(1) == 1901, "parked session must stay resident");
     check_mask_extent(kv, ubatch, 256);
 
@@ -156,16 +173,79 @@ static void test_cache_extents(bool unified, bool v_trans = false) {
     }) {
         ubatch.n_seqs_unq = group.first;
         require_extent(kv.get_n_kv(slot, ubatch) == group.second, "active sequence union is incomplete");
+        uint32_t physical_count = 0;
+        for (uint32_t i = 0; i < group.first; ++i) {
+            const auto & cells = kv.get_cells(active[i]);
+            for (uint32_t cell = 0; cell < cells.size(); ++cell) {
+                physical_count += !cells.is_empty(cell) && cells.seq_has(cell, active[i]);
+            }
+        }
+        require_extent(kv.get_n_kv_visible_bound(ubatch) == (unified ? physical_count : 0u),
+                       "active visible bound omitted a sequence");
     }
     // Missing or invalid metadata must preserve the conservative old extent.
     ubatch.seq_id_unq = nullptr;
     require_extent(kv.get_n_kv(slot, ubatch) == 2048, "missing metadata must fall back");
+    require_extent(kv.get_n_kv_visible_bound(ubatch) == 0, "missing metadata must disable sparse hint");
     active[0]         = -1;
     ubatch.seq_id_unq = active;
     require_extent(kv.get_n_kv(slot, ubatch) == 2048, "invalid metadata must fall back");
+    require_extent(kv.get_n_kv_visible_bound(ubatch) == 0, "invalid metadata must disable sparse hint");
     active[0]             = 0;
     ubatch.n_seqs_unq     = 1;
     // The cache holds hparams by reference, matching the owning model lifetime.
     hparams.indexer_kpool = 4;
     require_extent(kv.get_n_kv(slot, ubatch) == 2048, "pooled indexer gathers need the complete extent");
+    require_extent(kv.get_n_kv_visible_bound(ubatch) == 0, "indexed attention must disable sparse hint");
+}
+
+static void test_sparse_hint_gate() {
+    std::unique_ptr<llama_model> model(llama_model_create(LLM_ARCH_LLAMA, llama_model_default_params()));
+    require_extent(model != nullptr, "test model creation failed");
+    llama_hparams hparams      = {};
+    hparams.n_layer_all        = 1;
+    hparams.n_embd_head_k_full = 4;
+    hparams.n_embd_head_v_full = 4;
+    hparams.n_head_arr[0]      = 1;
+    hparams.n_head_kv_arr[0]   = 1;
+    llama_kv_cache kv(*model, hparams, GGML_TYPE_F32, GGML_TYPE_F32, false, false, true, 8192, 4, 256, 0,
+                      LLAMA_SWA_TYPE_NONE, nullptr, [](int32_t) { return true; }, {}, {});
+
+    llama_pos      pos             = 0;
+    llama_seq_id   seq             = 0;
+    llama_seq_id * ids             = &seq;
+    int32_t        count           = 1;
+    llama_ubatch   ubatch          = {};
+    ubatch.n_tokens                = 1;
+    ubatch.n_pos                   = 1;
+    ubatch.pos                     = &pos;
+    ubatch.n_seq_id                = &count;
+    ubatch.seq_id                  = &ids;
+    ubatch.n_seqs_unq              = 1;
+    ubatch.seq_id_unq              = &seq;
+    llama_kv_cache::slot_info slot = {};
+    slot.s0 = slot.s1              = 0;
+    slot.strm                     = { 0 };
+    slot.idxs                     = { { 3 } };
+    kv.apply_ubatch(slot, ubatch);
+    pos       = 3900;
+    slot.idxs = { { 3900 } };
+    kv.apply_ubatch(slot, ubatch);
+    pos       = 3901;
+    slot.idxs = { { 3901 } };
+    llama_kv_cache_context fragmented(&kv, { slot }, { ubatch });
+    require_extent(fragmented.apply(), "fragmented context apply failed");
+    require_extent(fragmented.get_n_kv() == 4096 && fragmented.get_n_kv_visible_bound() == 256,
+                   "fragmented view should enable a bounded sparse hint");
+
+    seq       = 1;
+    pos       = 0;
+    slot.idxs = { { 3902 } };
+    kv.apply_ubatch(slot, ubatch);
+    pos       = 1;
+    slot.idxs = { { 3903 } };
+    llama_kv_cache_context compact(&kv, { slot }, { ubatch });
+    require_extent(compact.apply(), "compact context apply failed");
+    require_extent(compact.get_n_kv() == 256 && compact.get_n_kv_visible_bound() == 0,
+                   "compact view should not request sparse gathering");
 }
