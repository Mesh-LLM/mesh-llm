diff --git a/tests/test-skippy-kv-cache-extent.h b/tests/test-skippy-kv-cache-extent.h
index 990ae9911..e92a991b6 100644
--- a/tests/test-skippy-kv-cache-extent.h
+++ b/tests/test-skippy-kv-cache-extent.h
@@ -22,18 +22,23 @@ static void check_mask_extent(const llama_kv_cache & kv,
     for (bool causal : { false, true }) {
         kv.set_input_kq_mask(full, &ubatch, causal);
         kv.set_input_kq_mask(active, &ubatch, causal, begin);
+        const uint32_t visible_bound = kv.get_n_kv_visible_bound(ubatch);
         const auto * full_data   = static_cast<const float *>(full->data);
         const auto * active_data = static_cast<const float *>(active->data);
         for (uint32_t row = 0; row < ubatch.n_tokens; ++row) {
+            uint32_t visible = 0;
             for (uint32_t cell = 0; cell < 2048; ++cell) {
                 const auto value = full_data[row * 2048 + cell];
                 if (cell >= begin && cell < begin + end) {
                     require_extent(value == active_data[row * end + cell - begin],
                                    "active mask changed a retained cell");
+                    visible += std::isfinite(value);
                 } else {
                     require_extent(std::isinf(value) && value < 0, "active extent excluded an unmasked cell");
                 }
             }
+            require_extent(visible_bound == 0 || visible <= visible_bound,
+                           "visible KV bound is smaller than the attention mask");
         }
     }
 }
@@ -51,6 +56,10 @@ static void check_extent_graph_reuse(llama_kv_cache &                  kv,
     next_batch.pos          = &next_pos;
     llama_kv_cache_context context(&kv, { next_slot }, { next_batch });
     require_extent(context.apply(), "cache context apply failed");
+    const auto visible_bound = context.get_n_kv_visible_bound();
+    require_extent(visible_bound == 0 || (visible_bound >= kv.get_n_kv_visible_bound(next_batch) &&
+                                          visible_bound <= context.get_n_kv()),
+                   "padded visible bound exceeds the attention view");
     llama_cparams cparams = {};
     cparams.kv_unified    = kv.get_n_stream() == 1;
     llm_graph_input_attn_kv input(hparams, cparams, &context);
@@ -65,6 +74,12 @@ static void check_extent_graph_reuse(llama_kv_cache &                  kv,
     graph_params.ubatch           = ubatch;
     graph_params.cparams          = cparams;
     require_extent(input.can_reuse(graph_params), "unchanged physical view should reuse the graph");
+    input.self_kq_mask_visible_bound      = context.get_n_kv_visible_bound();
+    input.self_kq_mask_visible_bound_used = true;
+    require_extent(input.can_reuse(graph_params), "unchanged sparse bound should reuse the graph");
+    ++input.self_kq_mask_visible_bound;
+    require_extent(!input.can_reuse(graph_params), "changed sparse bound must rebuild the graph");
+    --input.self_kq_mask_visible_bound;
     input.self_kq_mask_begin += 256;
     require_extent(!input.can_reuse(graph_params), "same shape at a different physical origin must rebuild the graph");
 }
@@ -112,6 +127,8 @@ static void test_cache_extents(bool unified, bool v_trans = false) {
     slot.s0 = slot.s1 = 0;
     slot.strm         = { 0 };
     require_extent(kv.get_n_kv(slot, ubatch) == 256, "parked sessions must not extend an active view");
