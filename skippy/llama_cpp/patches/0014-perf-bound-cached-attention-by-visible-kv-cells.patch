diff --git a/src/llama-kv-cache-extent.cpp b/src/llama-kv-cache-extent.cpp
index 23edf3c64..24ca3014d 100644
--- a/src/llama-kv-cache-extent.cpp
+++ b/src/llama-kv-cache-extent.cpp
@@ -71,6 +71,21 @@ uint32_t llama_kv_cache::get_n_kv(const slot_info & sinfo, const llama_ubatch &
     return span;
 }
 
+uint32_t llama_kv_cache::get_n_kv_visible_bound(const llama_ubatch & ubatch) const {
+    if (n_stream != 1 || !supports_active_extent(ubatch)) {
+        return 0;
+    }
+
+    // A query can see at most the union of cells owned by its active sequences.
+    // Summing their indexed counts can overestimate shared cells, which is safe:
+    // the attention mask remains the source of truth for sparse gathering.
+    uint64_t bound = 0;
+    for (uint32_t i = 0; i < ubatch.n_seqs_unq; ++i) {
+        bound += v_cells[0].seq_used_count(ubatch.seq_id_unq[i]);
+    }
+    return static_cast<uint32_t>(std::min<uint64_t>(bound, v_cells[0].size()));
+}
+
 uint32_t llama_kv_cache::get_n_kv_pos_contiguous(const slot_info & sinfo, const llama_ubatch & ubatch) const {
     if (sinfo.n_stream() != 1 || ubatch.n_seqs_unq != 1 || ubatch.n_tokens == 0 || ubatch.pos == nullptr ||
         ubatch.n_seq_id == nullptr || ubatch.seq_id == nullptr || ubatch.seq_id[0] == nullptr) {
diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 741d0ef30..70bf31bcc 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -3907,6 +3907,21 @@ uint32_t llama_kv_cache_context::get_kv_begin() const {
     return sinfos[i_cur].kv_begin;
 }
 
+uint32_t llama_kv_cache_context::get_n_kv_visible_bound() const {
+    if (kv == nullptr || ubatches.empty() || i_cur >= ubatches.size()) {
+        return 0;
+    }
+    const uint32_t bound = kv->get_n_kv_visible_bound(ubatches[i_cur]);
+    if (bound == 0) {
+        return 0;
+    }
+    const uint32_t span = static_cast<uint32_t>(n_kv);
+    const uint32_t padded_bound = std::min(span, static_cast<uint32_t>(GGML_PAD(bound, 256)));
+    // A sparse index list is useful only when parked cells make the physical
+    // attention span at least twice as large as the visible KV set.
+    return span >= std::max<uint32_t>(4096, 2*padded_bound) ? padded_bound : 0;
+}
+
