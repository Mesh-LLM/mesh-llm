@@ -272,6 +272,13 @@ public:
     // return empty slot_info on failure
     slot_info find_slot(const llama_ubatch & ubatch, bool cont) const;
 
+    // cells a sequence claims at a time in the unified pool; a multiple of the
+    // row-attention kernels' 32-row block
+    static constexpr uint32_t kv_chunk_cells = 64;
+
+    std::vector<uint32_t> find_chunked_cells(
+            const llama_ubatch & ubatch, const llama_kv_cells & cells, uint32_t head_cur) const;
+
     // emplace the ubatch context into slot: [sinfo.idxs[0...ubatch.n_tokens - 1]]
     void apply_ubatch(const slot_info & sinfo, const llama_ubatch & ubatch);
 
diff --git a/src/llama-kv-cells.h b/src/llama-kv-cells.h
index 4b50afe71..9190ad55f 100644
--- a/src/llama-kv-cells.h
+++ b/src/llama-kv-cells.h
@@ -34,6 +34,17 @@ static inline int ctz64(uint64_t x) {
 #endif
 }
 
+// Index of the highest set bit; called for x != 0.
+static inline int fls64(uint64_t x) {
+#if defined(_MSC_VER)
+    unsigned long i;
+    _BitScanReverse64(&i, x);
+    return (int) i;
+#else
+    return 63 - __builtin_clzll(x);
+#endif
+}
+
 struct llama_kv_cell_ext {
     // 2D spatial positions, typically used for M-RoPE
     llama_pos x = 0;
@@ -514,6 +525,19 @@ public:
                positions.size() == static_cast<size_t>(pos_max) + 1;
     }
 
+    // The highest cell the sequence occupies, or -1.
+    int64_t seq_cell_max(llama_seq_id seq_id) const {
+        assert(seq_id >= 0 && seq_id < LLAMA_MAX_SEQ);
+        const auto & bits = seq_bits[seq_id];
+        const uint32_t n_words = std::min<uint32_t>((used_max_p1() + 63) / 64, bits.size());
+        for (uint32_t w = n_words; w-- > 0;) {
+            if (bits[w] != 0) {
+                return 64 * w + fls64(bits[w]);
+            }
+        }
+        return -1;
+    }
+
     // note: call only if the cell is not empty
     llama_pos pos_get(uint32_t i) const {
         assert(i < pos.size());
