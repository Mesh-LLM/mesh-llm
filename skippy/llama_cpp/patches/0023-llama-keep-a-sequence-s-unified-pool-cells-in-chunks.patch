 src/llama-kv-cache.cpp | 84 ++++++++++++++++++++++++++++++++++++++++++
 src/llama-kv-cache.h   |  7 ++++
 src/llama-kv-cells.h   | 24 ++++++++++++
 3 files changed, 115 insertions(+)

diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index d00c1fe4a..a2d3418e9 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -9,6 +9,7 @@
 #include "skippy.h"
 
 #include <algorithm>
+#include <array>
 #include <cassert>
 #include <cmath>
 #include <cstring>
@@ -1045,6 +1046,81 @@ bool llama_kv_cache::update(llama_context * lctx, bool do_shift, const stream_co
     return updated;
 }
 
+// Unified pool placement that keeps each sequence's cells together: a token
+// goes to the cell after its sequence's highest one while that stays inside the
+// same chunk and free, else to the first cell of a fresh all-empty chunk. Row
+// lists then hold long runs instead of one cell per decode step, which is what
+// the row-attention kernels read at dense speed. A pool too fragmented for a
+// fresh chunk falls back to any empty cell.
+std::vector<uint32_t> llama_kv_cache::find_chunked_cells(
+        const llama_ubatch & ubatch, const llama_kv_cells & cells, uint32_t head_cur) const {
+    const uint32_t n_tokens = ubatch.n_tokens;
+    const uint32_t n_cells  = cells.size();
+    const uint32_t n_chunks = n_cells / kv_chunk_cells;
+
+    std::vector<uint32_t> idxs;
+    idxs.reserve(n_tokens);
+
+    std::vector<uint8_t> taken(n_cells, 0);
+    const auto free_cell = [&](uint32_t idx) { return cells.is_empty(idx) && !taken[idx]; };
+    const auto take = [&](uint32_t idx) { taken[idx] = 1; idxs.push_back(idx); };
+
+    // next cell of each sequence's open chunk, resolved on first use
+    std::array<int64_t, LLAMA_MAX_SEQ> next;
+    next.fill(-2);
+
+    uint32_t chunk_cur = n_chunks ? (head_cur / kv_chunk_cells) % n_chunks : 0;
+
+    for (uint32_t i = 0; i < n_tokens; ++i) {
+        const llama_seq_id seq_id = ubatch.n_seq_id[i] > 0 ? ubatch.seq_id[i][0] : 0;
+
+        if (next[seq_id] == -2) {
+            const int64_t last = cells.seq_cell_max(seq_id);
+            next[seq_id] = last >= 0 && (last + 1) % kv_chunk_cells != 0 ? last + 1 : -1;
+        }
+
+        const int64_t cand = next[seq_id];
+        if (cand >= 0 && cand < (int64_t) n_cells && free_cell((uint32_t) cand)) {
+            take((uint32_t) cand);
+            next[seq_id] = (cand + 1) % kv_chunk_cells != 0 ? cand + 1 : -1;
+            continue;
+        }
+
+        // a fresh chunk: every cell empty and unclaimed, searched from the head onward
+        bool placed = false;
+        for (uint32_t tested = 0; tested < n_chunks && !placed; ++tested) {
+            const uint32_t start = chunk_cur * kv_chunk_cells;
+            chunk_cur = (chunk_cur + 1) % n_chunks;
+            bool empty = true;
+            for (uint32_t c = start; c < start + kv_chunk_cells && empty; ++c) {
+                empty = free_cell(c);
+            }
+            if (empty) {
+                take(start);
+                next[seq_id] = kv_chunk_cells > 1 ? start + 1 : -1;
+                placed = true;
+            }
+        }
+        if (placed) {
+            continue;
+        }
+
+        // the pool is fragmented: any empty cell keeps the batch going
+        for (uint32_t tested = 0; tested < n_cells && !placed; ++tested) {
+            const uint32_t idx = (head_cur + tested) % n_cells;
+            if (free_cell(idx)) {
+                take(idx);
+                placed = true;
+            }
+        }
+        if (!placed) {
+            return { };
+        }
+    }
+
+    return idxs;
+}
+
 llama_kv_cache::slot_info llama_kv_cache::find_slot(const llama_ubatch & ubatch, bool cont) const {
 
     if (debug > 0) {
@@ -1194,6 +1270,14 @@ llama_kv_cache::slot_info llama_kv_cache::find_slot(const llama_ubatch & ubatch,
             head_cur = 0;
         }
 
+        if (n_stream == 1 && n_swa == 0) {
+            res.idxs[s] = find_chunked_cells(ubatch, cells, head_cur);
+            if (res.idxs[s].size() < n_tokens) {
+                return { };
+            }
+            continue;
+        }
+
         uint32_t n_tested = 0;
 
         // for continuous slots, we test that all tokens in the ubatch fit, starting from the current head
diff --git a/src/llama-kv-cache.h b/src/llama-kv-cache.h
index 874c3739d..fd3054514 100644
