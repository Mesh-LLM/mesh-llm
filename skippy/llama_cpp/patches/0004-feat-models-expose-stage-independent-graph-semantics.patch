+void llm_graph_context::state_write(skippy_state_kind kind, ggml_tensor * storage, ggml_tensor * effect_node, int il) const {
+    const ggml_tensor * canonical = skippy_state_canonical_storage(storage);
+    int64_t ordinal = 0;
+    for (const auto & effect : res->state_effects) {
+        if (effect.access == skippy_state_access::write && effect.kind == kind &&
+                effect.layer == il && effect.storage == canonical) {
+            ++ordinal;
+        }
+    }
+    res->state_effects.push_back({kind, skippy_state_access::write, il, canonical, effect_node, ordinal,
+            il >= n_layer ? skippy_state_residency::per_stage : skippy_state_residency::layer_local});
+}
