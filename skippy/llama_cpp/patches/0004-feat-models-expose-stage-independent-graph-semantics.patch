+bool skippy_graph_build_inputs::topology_equal(const skippy_graph_build_inputs & other) const {
+    if (activation_import_identities != other.activation_import_identities ||
+            activation_import_bindings != other.activation_import_bindings ||
+            activation_export_identities != other.activation_export_identities ||
+            activation_export_bindings != other.activation_export_bindings ||
+            resident_tensor_names != other.resident_tensor_names ||
+            execution_contract != other.execution_contract) return false;
+    if (activation_frontier.size() != other.activation_frontier.size()) return false;
+    for (size_t index = 0; index < activation_frontier.size(); ++index) {
+        const auto & left = activation_frontier[index];
+        const auto & right = other.activation_frontier[index];
+        if ((left.values != nullptr) != (right.values != nullptr) ||
+                left.payload_bytes != right.payload_bytes || left.ggml_type != right.ggml_type ||
+                left.rank != right.rank || left.token_axis != right.token_axis) return false;
+        for (int dimension = 0; dimension < GGML_MAX_DIMS; ++dimension) {
+            if (left.dimensions[dimension] != right.dimensions[dimension] ||
+                    left.byte_strides[dimension] != right.byte_strides[dimension]) return false;
+        }
+    }
+    return selection.enabled == other.selection.enabled &&
+           selection.layer_start == other.selection.layer_start &&
+           selection.layer_end == other.selection.layer_end &&
+           selection.glm_dsa_policy_profile == other.selection.glm_dsa_policy_profile &&
+           selection.glm_dsa_policy_flags == other.selection.glm_dsa_policy_flags &&
+           selection.glm_dsa_short_prefill_max_tokens == other.selection.glm_dsa_short_prefill_max_tokens &&
+           selection.glm_dsa_direct_sparse_decode_max_top_k == other.selection.glm_dsa_direct_sparse_decode_max_top_k &&
+           selection.glm_dsa_dense_sparse_mask_max_bytes == other.selection.glm_dsa_dense_sparse_mask_max_bytes &&
+           selection.glm_dsa_compact_flash_min_kv == other.selection.glm_dsa_compact_flash_min_kv &&
+           selection.glm_dsa_phase_hint == other.selection.glm_dsa_phase_hint &&
+           (activation_tokens.tokens != nullptr) == (other.activation_tokens.tokens != nullptr) &&
+           activation_tokens.token_count == other.activation_tokens.token_count &&
+           (mtp_embeddings.values != nullptr) == (other.mtp_embeddings.values != nullptr) &&
+           mtp_embeddings.token_count == other.mtp_embeddings.token_count &&
+           mtp_embeddings.n_embd == other.mtp_embeddings.n_embd;
+}
