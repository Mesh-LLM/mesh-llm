+void llm_graph_result::replace_with_stage_graph(
+        ggml_cgraph * graph,
+        std::vector<skippy_activation_port> imports,
+        std::vector<skippy_activation_port> exports,
+        std::vector<skippy_state_effect> effects) {
+    GGML_ASSERT(graph != nullptr);
+    const auto retain_if_present = [graph](ggml_tensor *& tensor) {
+        if (tensor == nullptr) return;
+        for (int index = 0; index < ggml_graph_n_nodes(graph); ++index) {
+            if (ggml_graph_node(graph, index) == tensor) return;
+        }
+        tensor = nullptr;
+    };
+    gf = graph;
+    state_effects = std::move(effects);
+    activation_imports = std::move(imports);
+    activation_exports = std::move(exports);
+    retain_if_present(t_logits);
+    retain_if_present(t_embd);
+    retain_if_present(t_embd_pooled);
+    retain_if_present(t_h_nextn);
+    for (auto *& tensor : t_layer_inp) retain_if_present(tensor);
+    for (auto *& tensor : t_sampled) retain_if_present(tensor);
+    for (auto *& tensor : t_sampled_probs) retain_if_present(tensor);
+    for (auto *& tensor : t_sampled_logits) retain_if_present(tensor);
+    for (auto *& tensor : t_candidates) retain_if_present(tensor);
+
+    // resolve_fused_ops() compares the backend of every fused node with the
+    // device of its layer. Fused nodes of layers outside this stage are not in
+    // the stage graph, so the scheduler never assigns them a backend and they
+    // would read as a device mismatch. Keep only the nodes this stage computes.
+    std::unordered_set<const ggml_tensor *> stage_nodes;
+    for (int index = 0; index < ggml_graph_n_nodes(graph); ++index) {
+        stage_nodes.insert(ggml_graph_node(graph, index));
+    }
+    fused_nodes.erase(std::remove_if(fused_nodes.begin(), fused_nodes.end(),
+            [&stage_nodes](const llm_graph_fused_node & node) {
+                return stage_nodes.count(node.tensor) == 0;
+            }), fused_nodes.end());
+}
