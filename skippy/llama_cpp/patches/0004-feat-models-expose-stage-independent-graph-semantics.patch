+    state_read_rotation(input->self_k_rot);
+    request_input(input->self_k_idxs_swa, "attention.swa.key_indices");
+    request_attn_mask(input->self_attn_mask_swa, "attention.swa.mask");
+    state_read_rotation(input->self_k_rot_swa);
+}
+
+void llm_graph_context::request_inputs(llm_graph_input_attn_k_dsa * input) const {
+    request_input(input->self_k_idxs_mla, "attention.dsa.mla.key_indices");
+    request_input(input->self_k_idxs_lid, "attention.dsa.indexer.key_indices");
+    request_attn_mask(input->self_attn_mask_mla, "attention.dsa.mla.mask");
+    request_attn_mask(input->self_attn_mask_lid, "attention.dsa.indexer.mask");
+    state_read_rotation(input->self_k_rot_lid);
+}
