+
 void llm_graph_result::set_inputs(const llama_ubatch * ubatch) {
     for (auto & input : inputs) {
+        input->set_build_inputs(build_inputs);
         input->set_input(ubatch);
     }
+    GGML_ASSERT(build_inputs.activation_frontier.empty() ||
+            build_inputs.activation_frontier.size() == activation_imports.size());
+    for (size_t index = 0; index < build_inputs.activation_frontier.size(); ++index) {
+        const auto & source = build_inputs.activation_frontier[index];
+        ggml_tensor * destination = activation_imports[index].tensor;
+        if (source.values == nullptr) {
+            GGML_ASSERT(activation_imports[index].optional);
+            continue;
+        }
+        GGML_ASSERT(destination != nullptr && destination->buffer != nullptr);
+        GGML_ASSERT(source.rank > 0 && source.rank <= GGML_MAX_DIMS &&
+                source.token_axis >= 0 && source.token_axis < static_cast<int32_t>(source.rank));
+        if (destination->type != static_cast<ggml_type>(source.ggml_type)) {
+            throw std::runtime_error(
+                    "activation frontier part type mismatch at index " + std::to_string(index) +
+                    " binding=" + activation_imports[index].binding +
+                    " destination=" + ggml_type_name(destination->type) +
+                    " source=" + ggml_type_name(static_cast<ggml_type>(source.ggml_type)));
+        }
+        for (uint32_t dimension = 0; dimension < source.rank; ++dimension) {
+            const int64_t expected = static_cast<int32_t>(dimension) == source.token_axis ?
+                    ubatch->n_tokens : source.dimensions[dimension];
+            GGML_ASSERT(destination->ne[dimension] == expected);
+        }
+
+        size_t token_offset = 0;
+        if (!source.sequence_ids.empty() && ubatch->seq_id != nullptr && ubatch->seq_id[0] != nullptr) {
+            const llama_seq_id seq_id = ubatch->seq_id[0][0];
+            const auto found = std::find(source.sequence_ids.begin(), source.sequence_ids.end(), seq_id);
+            GGML_ASSERT(found != source.sequence_ids.end());
+            const size_t sequence_index = static_cast<size_t>(found - source.sequence_ids.begin());
+            token_offset = source.sequence_offsets[sequence_index];
+            if (ubatch->pos != nullptr) {
+                GGML_ASSERT(ubatch->pos[0] >= source.sequence_pos_starts[sequence_index]);
+                token_offset += static_cast<size_t>(ubatch->pos[0] - source.sequence_pos_starts[sequence_index]);
+            }
+        } else if (ubatch->pos != nullptr && source.dimensions[source.token_axis] > ubatch->n_tokens) {
+            GGML_ASSERT(ubatch->pos[0] >= source.pos_start);
+            token_offset = static_cast<size_t>(ubatch->pos[0] - source.pos_start);
+        }
+        GGML_ASSERT(token_offset + static_cast<size_t>(ubatch->n_tokens) <=
+                static_cast<size_t>(source.dimensions[source.token_axis]));
+        const size_t inner_bytes = static_cast<size_t>(source.byte_strides[source.token_axis]);
+        const size_t source_plane_bytes = inner_bytes * static_cast<size_t>(source.dimensions[source.token_axis]);
+        const size_t destination_plane_bytes = inner_bytes * static_cast<size_t>(ubatch->n_tokens);
+        GGML_ASSERT(source_plane_bytes > 0 && source.payload_bytes % source_plane_bytes == 0);
+        const size_t outer_count = static_cast<size_t>(source.payload_bytes) / source_plane_bytes;
+        for (size_t outer = 0; outer < outer_count; ++outer) {
+            const size_t source_offset = outer * source_plane_bytes + token_offset * inner_bytes;
+            const size_t destination_offset = outer * destination_plane_bytes;
+            ggml_backend_tensor_set(
+                    destination,
+                    static_cast<const uint8_t *>(source.values) + source_offset,
+                    destination_offset,
+                    destination_plane_bytes);
+        }
+    }
