+        common_chat_params params = common_chat_templates_apply(tmpls, inputs);
+        if (grammar != nullptr && grammar[0] != '\0') {
+            params.grammar = grammar;
+            params.grammar_lazy = false;
+            params.grammar_triggers.clear();
+        }
+        prompt = params.prompt.str();
