diff --git a/ggml/src/ggml-cuda/fattn-mask.cuh b/ggml/src/ggml-cuda/fattn-mask.cuh
new file mode 100644
index 000000000..5242acd4c
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-mask.cuh
@@ -0,0 +1,62 @@
+#pragma once
+
+// Dense attention keeps the physical KV layout (and resident prefix aliases).
+// Bound each query tile by the union of its visible columns. Bounds are aligned
+// outwards to FATTN_KQ_STRIDE; holes inside the interval still use the full mask.
+// The first plane contains exclusive ends, the second inclusive starts.
+template <int ncols1>
+__launch_bounds__(FATTN_KQ_STRIDE / 2, 1) static __global__ void flash_attn_mask_to_KV_bounds(
+    const half2 * mask,
+    int *         bounds,
+    const int     ntiles_k,
+    const int     n_queries,
+    const int     n_mask_sequences,
+    const int64_t s31,
+    const int64_t s33) {
+    const int tid = threadIdx.x;
+    const int row = blockIdx.x * ncols1;
+    mask += (blockIdx.y % n_mask_sequences) * s33 + row * s31;
+    ggml_cuda_pdl_sync();
+
+    int first = 0;
+    int last  = ntiles_k;
+    // __syncthreads_and makes the result uniform across the entire block.
+    // Only -infinity is invisible; finite biases (and NaNs) must not be skipped.
+    for (; first < last; ++first) {
+        int invisible = 1;
+#pragma unroll
+        for (int j = 0; j < ncols1; ++j) {
+            if (row + j < n_queries) {
+                const float2 value = __half22float2(mask[j * s31 + first * (FATTN_KQ_STRIDE / 2) + tid]);
+                invisible &= value.x == -INFINITY && value.y == -INFINITY;
+            }
+        }
+        if (!__syncthreads_and(invisible)) {
+            break;
+        }
+    }
+    for (; last > first; --last) {
+        int invisible = 1;
+#pragma unroll
+        for (int j = 0; j < ncols1; ++j) {
+            if (row + j < n_queries) {
+                const float2 value = __half22float2(mask[j * s31 + (last - 1) * (FATTN_KQ_STRIDE / 2) + tid]);
+                invisible &= value.x == -INFINITY && value.y == -INFINITY;
+            }
+        }
+        if (!__syncthreads_and(invisible)) {
+            break;
+        }
+    }
+    if (tid == 0) {
+        const int index                       = blockIdx.y * gridDim.x + blockIdx.x;
+        bounds[index]                         = last * FATTN_KQ_STRIDE;
+        bounds[gridDim.x * gridDim.y + index] = first * FATTN_KQ_STRIDE;
+    }
+}
+
+// Preserve each parallel block's original strided partition while skipping
+// complete masked rounds at its beginning.
+static __device__ __forceinline__ int flash_attn_KV_first(const int start, const int lower, const int stride) {
+    return start + (lower > start ? (lower - start + stride - 1) / stride : 0) * stride;
+}
