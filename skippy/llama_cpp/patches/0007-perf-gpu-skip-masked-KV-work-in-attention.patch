+#pragma once
+
+// Exercise physical KV layouts that arise from unified caches. Each query has
+// its own mask, so a query tile must use the union, not one representative row.
+struct test_flash_attn_kv_bounds : public test_flash_attn_ext {
+    const int pattern;
+
+    test_flash_attn_kv_bounds(int       pattern,
+                              int64_t   queries,
+                              int64_t   streams,
+                              ggml_type kv_type,
+                              bool      with_sinks,
+                              int64_t   kv_size = 4096) :
+        test_flash_attn_ext(128,
+                            128,
+                            2,
+                            { 4, streams },
+                            kv_size,
+                            queries,
+                            true,
+                            with_sinks,
+                            0,
+                            0,
+                            GGML_PREC_F32,
+                            kv_type,
+                            kv_type),
+        pattern(pattern) {}
+
+    std::string vars() override {
+        return test_flash_attn_ext::vars() + ",kv_bounds_pattern=" + std::to_string(pattern);
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        test_flash_attn_ext::initialize_tensors(ctx);
+        for (auto * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (strcmp(t->name, "m") != 0) {
+                continue;
+            }
+            std::vector<ggml_fp16_t> values(ggml_nelements(t), ggml_fp32_to_fp16(-INFINITY));
+            for (int64_t s = 0; s < t->ne[3]; ++s) {
+                for (int64_t q = 0; q < t->ne[1]; ++q) {
+                    for (int64_t k = 0; k < t->ne[0]; ++k) {
+                        if (q >= nb) {
+                            // Deliberately visible padding must not expand the
+                            // live query tile's mask or alter its output.
+                            values[(s * t->ne[1] + q) * t->ne[0] + k] = ggml_fp32_to_fp16(0.0f);
+                            continue;
+                        }
+                        bool visible = false;
+                        switch (pattern) {
+                            case 0:
+                                visible = k >= 2051 && k < 3077;
+                                break;  // unaligned middle
+                            case 1:
+                                visible = k < 513;
+                                break;  // masked suffix
+                            case 2:
+                                visible = k >= kv - 515;
+                                break;  // masked prefix
+                            case 3:     // unrelated interleaved sequences in one query tile
+                                visible = (q + s) % 2 ? k >= 3071 : k < 257;
+                                break;
+                            case 4:
+                                visible = k < 129 || (k >= 2053 && k < 3073);
+                                break;  // shared prefix + hole
+                            case 5:
+                                visible = k == (q * 257 + s * 131) % kv;
+                                break;  // one live column
+                            case 6:
+                                visible = q % 2 && k >= 2051 && k < 3077;
+                                break;  // empty rows, with sinks
+                            case 7:
+                                visible = true;
+                                break;  // finite negative biases must remain live
+                            default:
+                                GGML_ABORT("invalid KV bounds pattern");
+                        }
+                        if (visible) {
+                            const float bias                          = -float((k + q) % 7) / 8.0f;
+                            values[(s * t->ne[1] + q) * t->ne[0] + k] = ggml_fp32_to_fp16(bias);
+                        }
+                    }
+                }
+            }
+            ggml_backend_tensor_set(t, values.data(), 0, values.size() * sizeof(values[0]));
+        }
+    }
+};
+
+static void add_flash_attn_kv_bounds_tests(std::vector<std::unique_ptr<test_case>> & tests) {
+    for (int pattern = 0; pattern < 8; ++pattern) {
+        for (int64_t queries : { 1, 3, 17, 64 }) {
+            for (int64_t streams : { 1, 2 }) {
+                for (auto type : { GGML_TYPE_F16, GGML_TYPE_Q8_0 }) {
+                    for (bool sinks : { false, true }) {
+                        if (pattern == 6 && !sinks) {
+                            continue;  // all-masked rows need a sink for a defined CPU reference
+                        }
+                        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, streams, type, sinks));
+                    }
+                }
+            }
+        }
+    }
+    // Chunked prefill below the former 1024-query cutoff, and unaligned KV
+    // extents which must retain the existing unoptimized path.
+    for (int pattern : { 0, 3, 4 }) {
+        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, 65, 1, GGML_TYPE_F16, false));
+        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, 512, 1, GGML_TYPE_F16, false));
+        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, 513, 1, GGML_TYPE_F16, false));
+        tests.emplace_back(new test_flash_attn_kv_bounds(pattern, 3, 1, GGML_TYPE_F16, true, 4097));
+    }
+}
+
+static void add_flash_attn_kv_bounds_perf_tests(std::vector<std::unique_ptr<test_case>> & tests) {
+    for (int pattern : { 0, 3, 4 }) {
+        for (int64_t queries : { 65, 513 }) {
+            tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, 1, GGML_TYPE_F16, false, 16384));
+        }
+    }
+    // Include dense masks and short contexts to expose classification overhead,
+    // alongside long unified layouts with masked prefixes and interior holes.
+    for (int pattern : { 0, 2, 4, 7 }) {
+        for (int64_t kv_size : { 1024, 4096, 16384, 65536 }) {
+            if (kv_size < 4096 && pattern != 7) {
+                continue;
+            }
+            for (int64_t queries : { 1, 3, 17 }) {
+                for (auto type : { GGML_TYPE_F16, GGML_TYPE_Q8_0 }) {
+                    tests.emplace_back(new test_flash_attn_kv_bounds(pattern, queries, 1, type, false, kv_size));
+                }
+            }
+        }
+    }
+}
