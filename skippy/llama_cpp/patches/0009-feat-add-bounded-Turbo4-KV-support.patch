@@ -0,0 +1,25 @@
+#pragma once
+
+#include "ggml-impl.h"
+
+// This fusion only covers the dense single-query, 128-value decode reduction.
+static inline bool ggml_metal_turbo4_decode_inverse_compatible(
+        const ggml_tensor * attention, const ggml_tensor * inverse) {
+    if (!attention || !inverse || attention->op != GGML_OP_FLASH_ATTN_EXT ||
+        inverse->op != GGML_OP_TURBO_WHT || inverse->src[0] != attention || inverse->src[1] ||
+        inverse->op_params[0] != 1 || inverse->op_params[1] != 128 ||
+        attention->type != GGML_TYPE_F32 || inverse->type != GGML_TYPE_F32 ||
+        attention->view_src || inverse->view_src ||
+        !ggml_is_contiguous(attention) || !ggml_is_contiguous(inverse)) {
+        return false;
+    }
+
+    const ggml_tensor * q = attention->src[0];
+    const ggml_tensor * k = attention->src[1];
+    const ggml_tensor * v = attention->src[2];
+    return q && k && v && q->type == GGML_TYPE_F32 &&
+        k->type == GGML_TYPE_F16 && v->type == GGML_TYPE_TURBO4_0 &&
+        q->ne[0] == 128 && k->ne[0] == 128 && v->ne[0] == 128 &&
+        q->ne[1] == 1 && q->ne[3] == 1 && k->ne[3] == 1 && v->ne[3] == 1 &&
+        q->ne[2] > 0 && q->ne[2] <= 64 && ggml_are_same_shape(attention, inverse);
+}
diff --git a/ggml/src/ggml-metal/ggml-metal-turbo4-reduce.h b/ggml/src/ggml-metal/ggml-metal-turbo4-reduce.h
new file mode 100644
index 000000000..39f03a1d7
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-turbo4-reduce.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include "ggml-metal-common.h"
+#include "ggml-metal-device.h"
+
+static inline bool ggml_metal_turbo4_reduce_inverse(
+        ggml_metal_library_t lib, ggml_metal_encoder_t enc,
+        ggml_metal_buffer_id temporary, size_t temporary_size,
+        ggml_metal_buffer_id destination, size_t destination_size, int32_t rows) {
+    if (temporary.metal == destination.metal) {
+        const bool overlaps = temporary.offs <= destination.offs
+            ? destination.offs - temporary.offs < temporary_size
+            : temporary.offs - destination.offs < destination_size;
+        if (overlaps) {
+            return false;
+        }
+    }
+
+    const char * name = "kernel_flash_attn_ext_vec_reduce_turbo4_wht";
+    auto pipeline = ggml_metal_library_get_pipeline(lib, name);
+    if (!pipeline.pipeline) {
+        pipeline = ggml_metal_library_compile_pipeline(lib, name, name, nullptr);
+    }
+    if (!pipeline.pipeline || ggml_metal_pipeline_max_theads_per_threadgroup(pipeline) < 256) {
+        return false;
+    }
+
+    ggml_metal_kargs_flash_attn_ext_vec_reduce args = { rows };
+    ggml_metal_encoder_set_pipeline(enc, pipeline);
+    ggml_metal_encoder_set_bytes(enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer(enc, temporary, 1);
+    ggml_metal_encoder_set_buffer(enc, destination, 2);
+    ggml_metal_encoder_dispatch_threadgroups(enc, rows, 1, 1, 256, 1, 1);
+    return true;
+}
