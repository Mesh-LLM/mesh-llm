+        : key_type(key_type), gqa(gqa), kv(kv), permuted(permuted), norm_set(norm_set) {}
+
+    std::string vars() override { return "t4_centroid_" + VARS_TO_STR5(key_type, gqa, kv, permuted, norm_set); }
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "FLASH_ATTN_EXT";
+    }
+    bool run_whole_graph() override { return true; }
+    double max_nmse_err() override { return 0.0; }
+    std::vector<ggml_tensor *> fusion_test_nodes() override {
+        auto nodes = sentinels;
+        nodes.push_back(output);
+        return nodes;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * keys = tensor(ctx, key_type, kv, kv_heads);
+        values = tensor(ctx, GGML_TYPE_TURBO4_0, kv, kv_heads);
+        ggml_set_name(keys, "centroid_k");
+        ggml_set_name(values, "centroid_v");
+        auto * decode = attention(ctx, keys, 1, "centroid_decode");
+        auto * prefill = attention(ctx, keys, 32, "centroid_prefill");
+        output = ggml_concat(ctx, decode, prefill, 2);
+        ggml_set_name(output, "centroid_comparison");
+        return output;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (auto * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+            if (strncmp(t->name, "sent_", 5) == 0) {
+                init_tensor_uniform(t);
+            } else {
+                ggml_backend_tensor_memset(t, 0, 0, ggml_nbytes(t));
+            }
+        }
+        auto * buffer = values->view_src ? values->view_src->buffer : values->buffer;
+        auto * buft = ggml_backend_buffer_get_type(buffer);
+        auto * device = ggml_backend_buft_get_device(buft);
+        if (!device && buft == ggml_backend_cpu_buffer_type()) {
+            device = ggml_backend_dev_by_name("CPU");
+        }
+        GGML_ASSERT(device);
+        const char * backend = ggml_backend_reg_name(ggml_backend_dev_backend_reg(device));
+        target_metal = strcmp(backend, "MTL") == 0;
+        target_supported = target_metal || strcmp(backend, "CPU") == 0;
+        GGML_ASSERT(ggml_row_size(GGML_TYPE_TURBO4_0, width) == 66);
+        for (int64_t h = 0; h < kv_heads; ++h) {
+            for (int64_t t = 0; t < kv; ++t) {
+                std::array<uint8_t, 66> packed = {};
+                const ggml_fp16_t norm = norm_bits(h);
+                memcpy(packed.data(), &norm, sizeof(norm));
+                for (int d = 0; d < width; ++d) {
+                    packed[2 + d/2] |= uint8_t(code(h, t, d) << (4*(d%2)));
+                }
+                ggml_backend_tensor_set(values, packed.data(), h*values->nb[2] + t*values->nb[1], packed.size());
+            }
+        }
+        for (const char * name : {"centroid_mask_1", "centroid_mask_32"}) {
+            auto * mask = ggml_get_tensor(ctx, name);
+            std::vector<ggml_fp16_t> row(kv, ggml_fp32_to_fp16(-INFINITY));
+            row[kv - 1] = ggml_fp32_to_fp16(0.0f);
+            for (int64_t q = 0; q < mask->ne[1]; ++q) {
+                ggml_backend_tensor_set(mask, row.data(), q*mask->nb[1], row.size()*sizeof(ggml_fp16_t));
+            }
+        }
+        packed_before.resize(ggml_nbytes(values));
+        ggml_backend_tensor_get(values, packed_before.data(), 0, packed_before.size());
+        uint64_t hash = UINT64_C(14695981039346656037);
+        for (uint8_t byte : packed_before) {
+            hash = (hash ^ byte)*UINT64_C(1099511628211);
+        }
+        for (const char * name : {"centroid_decode", "centroid_prefill", "centroid_comparison"}) {
+            auto * t = ggml_get_tensor(ctx, name);
+            ggml_backend_tensor_memset(t, 0xff, 0, ggml_nbytes(t));
+        }
+        GGML_ASSERT(canonical_half(1, ggml_fp16_t(0x3c01)) == -0.18310546875f);
+        GGML_ASSERT(old_half(1, ggml_fp16_t(0x3c01)) == -0.1829833984375f);
+        fprintf(stderr, "TQ_T4_CENTROID_INPUT backend=%s key=%s gqa=%d kv=%lld permuted=%d norm_set=%d bytes=%zu fnv1a64=%016llx\n",
+                backend, ggml_type_name(key_type), gqa, (long long) kv, int(permuted), norm_set,
+                packed_before.size(), (unsigned long long) hash);
+    }
+
+    double err(const float * a, const float * b, size_t n) override {
+        if (n == sentinel_size) {
+            return memcmp(a, b, n*sizeof(float)) == 0 ? 0.0 : INFINITY;
+        }
+        if (!target_supported || n != size_t(33*width*kv_heads*gqa)) {
+            return INFINITY;
+        }
+        std::vector<uint8_t> packed_after(packed_before.size());
+        ggml_backend_tensor_get(values, packed_after.data(), 0, packed_after.size());
+        if (packed_after != packed_before) {
+            fprintf(stderr, "TQ_T4_CENTROID_PACKED_CHANGED\n");
+            return INFINITY;
+        }
+        size_t mismatches[2] = {}, boundary[2] = {}, old_matches[2] = {};
+        size_t cpu_mismatches = 0;
+        for (int q = 0; q < 33; ++q) {
+            const int phase = q == 0 ? 0 : 1;
+            for (int h = 0; h < kv_heads*gqa; ++h) {
+                const auto norm = norm_bits(h/gqa);
+                for (int d = 0; d < width; ++d) {
+                    const int c = code(h/gqa, kv - 1, d);
+                    const size_t i = (size_t(q)*kv_heads*gqa + h)*width + d;
+                    const float full = centroids()[c]*ggml_fp16_to_fp32(norm);
+                    const float half = canonical_half(c, norm);
+                    const float expected = target_metal ? half : full;
+                    if (!std::isfinite(b[i]) || b[i] != full) {
+                        ++cpu_mismatches;
+                    }
+                    if (!std::isfinite(a[i]) || a[i] != expected) {
+                        ++mismatches[phase];
+                        const bool edge = (norm > 0 && norm < 0x0400) || (half != 0.0f && fabsf(half) < 0x1p-14f);
+                        boundary[phase] += edge;
+                        old_matches[phase] += target_metal && a[i] == old_half(c, norm);
+                        if (mismatches[phase] == 1) {
+                            fprintf(stderr, "TQ_T4_CENTROID_MISMATCH phase=%s head=%d dim=%d norm_bits=%04x code=%d actual=%.9g expected=%.9g boundary=%d\n",
+                                    phase == 0 ? "decode" : "prefill", h, d, unsigned(norm), c, a[i], expected, int(edge));
+                        }
+                    }
+                }
+            }
+        }
+        fprintf(stderr, "TQ_T4_CENTROID_ORACLE decode=%zu prefill=%zu boundary_decode=%zu boundary_prefill=%zu old_lut_decode=%zu old_lut_prefill=%zu cpu_float=%zu packed_unchanged=1\n",
+                mismatches[0], mismatches[1], boundary[0], boundary[1], old_matches[0], old_matches[1], cpu_mismatches);
+        return mismatches[0] == 0 && mismatches[1] == 0 && cpu_mismatches == 0 ? 0.0 : INFINITY;
+    }
+
+private:
+    ggml_tensor * tensor(ggml_context * ctx, ggml_type type, int64_t rows, int64_t heads) {
+        if (!permuted) {
+            return ggml_new_tensor_4d(ctx, type, width, rows, heads, 1);
+        }
+        return ggml_permute(ctx, ggml_new_tensor_4d(ctx, type, width, heads, rows, 1), 0, 2, 1, 3);
+    }
+
+    ggml_tensor * attention(ggml_context * ctx, ggml_tensor * keys, int64_t queries, const char * name) {
+        auto * q = tensor(ctx, GGML_TYPE_F32, queries, kv_heads*gqa);
+        auto * mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, kv, queries, 1, 1);
+        ggml_set_name(mask, queries == 1 ? "centroid_mask_1" : "centroid_mask_32");
+        auto * result = ggml_flash_attn_ext(ctx, q, keys, values, mask, 1.0f/sqrtf(width), 0.0f, 0.0f);
+        ggml_prec_set_acc(result, GGML_PREC_F32);
+        ggml_set_name(result, name);
+        return result;
+    }
+
+    static int code(int64_t head, int64_t token, int d) { return int((d + 3*head + 5*token)%16); }
+
+    ggml_fp16_t norm_bits(int64_t head) const {
+        // The second set isolates half-subnormal boundaries without weakening exact comparisons.
+        static const ggml_fp16_t norms[16] = {
+            0x0000, 0x3c00, 0x3c01, 0x3bff, 0x3555, 0x3c02, 0x4201, 0x7bff,
+            0x0001, 0x0002, 0x03ff, 0x0400, 0x0401, 0x1000, 0x1401, 0x2e66,
+        };
+        GGML_ASSERT(norm_set >= 0 && norm_set < 2 && head >= 0 && head < kv_heads);
+        return norms[norm_set*kv_heads + head];
+    }
+
+    static const float * centroids() {
+        static const float values[16] = {
+            -0.241529f, -0.182877f, -0.143016f, -0.111036f,
+            -0.083292f, -0.058050f, -0.034299f, -0.011349f,
+             0.011349f,  0.034299f,  0.058050f,  0.083292f,
+             0.111036f,  0.143016f,  0.182877f,  0.241529f,
+        };
+        return values;
+    }
+
+    static float canonical_half(int code, ggml_fp16_t norm) {
+        return ggml_fp16_to_fp32(ggml_fp32_to_fp16(centroids()[code]*ggml_fp16_to_fp32(norm)));
+    }
+
+    static float old_half(int code, ggml_fp16_t norm) {
+        const float rounded = ggml_fp16_to_fp32(ggml_fp32_to_fp16(centroids()[code]));
+        return ggml_fp16_to_fp32(ggml_fp32_to_fp16(rounded*ggml_fp16_to_fp32(norm)));
+    }
+};
+
+static void add_turbo4_centroid_tests(std::vector<std::unique_ptr<test_case>> & cases) {
+    for (auto key : {GGML_TYPE_F16, GGML_TYPE_Q8_0}) {
+        for (int gqa : {1, 2, 4}) {
+            for (int64_t kv : {113, 512}) {
+                for (bool permuted : {false, true}) {
+                    for (int norm_set : {0, 1}) {
+                        cases.emplace_back(new test_turbo4_centroids(key, gqa, kv, permuted, norm_set));
+                    }
+                }
+            }
+        }
+    }
+}
diff --git a/tests/test-backend-ops-turbo4-decode-inverse.h b/tests/test-backend-ops-turbo4-decode-inverse.h
new file mode 100644
index 000000000..0d944b3c5
--- /dev/null
+++ b/tests/test-backend-ops-turbo4-decode-inverse.h
@@ -0,0 +1,76 @@
+#pragma once
+
+struct test_turbo4_decode_inverse : public test_skippy_turbo4_attention {
+    // 0: inverse, 1: live attention output, 2: forward transform, 3: fused/unfused parity.
+    const int mode;
+
+    test_turbo4_decode_inverse(int64_t gqa, int64_t extent, int64_t queries,
+            std::array<int32_t, 4> permutation, bool masked, int mode)
+        : test_skippy_turbo4_attention(128, 128, 8, {gqa, 1}, extent, queries,
+              masked, false, 0.0f, 0.0f, GGML_PREC_F32, GGML_TYPE_F16,
+              GGML_TYPE_TURBO4_0, permutation), mode(mode) {}
+
+    std::string vars() override {
+        return "turbo4_decode_inverse_mode=" + std::to_string(mode) + "," + test_flash_attn_ext::vars();
+    }
+
+    std::string op_desc(ggml_tensor *) override { return "TURBO_WHT"; }
+    bool run_whole_graph() override { return true; }
+
+    double max_nmse_err() override {
+        return mode == 3 ? 1e-6 : test_skippy_turbo4_attention::max_nmse_err();
+    }
+
+    double err(const float * a, const float * b, size_t count) override {
+        if (mode != 3) {
+            return test_skippy_turbo4_attention::err(a, b, count);
+        }
+        if (!support_ok) {
+            return INFINITY;
+        }
+        double maximum = 0.0;
+        for (size_t i = 0; i < count; ++i) {
+            if (!std::isfinite(a[i]) || !std::isfinite(b[i])) {
+                return INFINITY;
+            }
+            maximum = std::max(maximum, std::abs(double(a[i]) - double(b[i])));
+        }
+        return maximum;
+    }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        auto * attention = test_flash_attn_ext::build_graph(ctx);
+        ggml_set_name(attention, "attention");
+        auto * inverse = ggml_turbo_wht(ctx, attention, mode == 2 ? 0 : 1, 128, nullptr);
+        if (mode == 1) {
+            return ggml_add(ctx, inverse, attention);
+        }
+        if (mode != 3) {
+            return inverse;
+        }
+
+        // A real copy prevents the second attention from matching the fusion chain.
+        auto * separate = ggml_flash_attn_ext(ctx, attention->src[0], attention->src[1],
+            attention->src[2], attention->src[3], 1.0f/sqrtf(hsk), 0.0f, 0.0f);
+        ggml_prec_set_acc(separate, GGML_PREC_F32);
+        ggml_set_output(separate);
+        auto * copied = ggml_dup(ctx, separate);
+        auto * reference = ggml_turbo_wht(ctx, copied, 1, 128, nullptr);
+        return ggml_sub(ctx, inverse, reference);
+    }
+};
+
+static void add_turbo4_decode_inverse_tests(std::vector<std::unique_ptr<test_case>> & cases) {
+    for (int64_t gqa : {2, 4}) {
+        for (int64_t extent : {113, 512, 5632}) {
+            for (auto permutation : {std::array<int32_t, 4>{0, 1, 2, 3}, std::array<int32_t, 4>{0, 2, 1, 3}}) {
+                for (bool masked : {false, true}) {
+                    for (int mode : {0, 1, 2, 3}) {
+                        cases.emplace_back(new test_turbo4_decode_inverse(gqa, extent, 1, permutation, masked, mode));
+                    }
+                    cases.emplace_back(new test_turbo4_decode_inverse(gqa, extent, 2, permutation, masked, 0));
+                }
+            }
+        }
+    }
+}
diff --git a/tests/test-backend-ops-turbo4-gqa.h b/tests/test-backend-ops-turbo4-gqa.h
new file mode 100644
index 000000000..1155e38af
--- /dev/null
+++ b/tests/test-backend-ops-turbo4-gqa.h
@@ -0,0 +1,174 @@
+#pragma once
+
+// Included after test_flash_attn_ext in test-backend-ops.cpp.
+struct test_flash_attn_ext_turbo4_gqa : public test_flash_attn_ext {
+    enum class mask_pattern { NONE, PARTIAL, ALL };
+
+    const mask_pattern pattern;
+    const bool opposed_queries;
+    const int head_repeat;
+
+    test_flash_attn_ext_turbo4_gqa(int64_t kv, bool permuted, mask_pattern pattern, bool opposed_queries = false,
+                                 int head_repeat = 2, ggml_type key_type = GGML_TYPE_Q8_0)
+        : test_flash_attn_ext(128, 128, 8, {head_repeat, 1}, kv, 1, pattern != mask_pattern::NONE, false, 0, 0,
+              GGML_PREC_F32, key_type, GGML_TYPE_TURBO4_0,
+              permuted ? std::array<int32_t, 4>{0, 2, 1, 3} : std::array<int32_t, 4>{0, 1, 2, 3}),
+          pattern(pattern), opposed_queries(opposed_queries), head_repeat(head_repeat) {
+        GGML_ASSERT(head_repeat == 2 || head_repeat == 4);
+    }
+
+    std::string vars() override {
+        const char * mask_name = pattern == mask_pattern::NONE ? "none" :
+                                pattern == mask_pattern::PARTIAL ? "partial" : "all";
+        const std::string prefix = type_K == GGML_TYPE_F16 ? "f16_turbo4_gqa_" :
+                                  head_repeat == 4 ? "q8_turbo4_paired_gqa4_" : "q8_turbo4_paired_";
+        return prefix + test_flash_attn_ext::vars() + ",mask_pattern=" + mask_name +
+               ",opposed_queries=" + (opposed_queries ? "true" : "false");
+    }
+
+    std::string op_desc(ggml_tensor * t) override {
+        GGML_UNUSED(t);
+        return "FLASH_ATTN_EXT";
+    }
+
+    bool run_whole_graph() override { return true; }
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * grouped = test_flash_attn_ext::build_graph(ctx);
+        ggml_set_name(grouped, head_repeat == 4 ? "gqa4" : "gqa2");
+
+        ggml_tensor * k_copy = ggml_new_tensor_4d(ctx, type_K, hsk, kv, head_repeat*nh, 1);
+        ggml_tensor * v_copy = ggml_new_tensor_4d(ctx, type_V, hsv, kv, head_repeat*nh, 1);
+        ggml_set_name(k_copy, "k_gqa1");
+        ggml_set_name(v_copy, "v_gqa1");
+
+        // GQA1 uses the same query and duplicated packed KV, bypassing paired-head kernels.
+        ggml_tensor * separate = ggml_flash_attn_ext(ctx, grouped->src[0], k_copy, v_copy, grouped->src[3],
+                                                   1.0f/sqrtf(hsk), 0, 0);
+        ggml_prec_set_acc(separate, GGML_PREC_F32);
+        ggml_set_name(separate, "gqa1");
+
+        ggml_tensor * out = ggml_concat(ctx, grouped, separate, 1);
+        ggml_set_name(out, "gqa_comparison");
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            if (strncmp(t->name, "sent_", 5) == 0) {
+                init_tensor_uniform(t);
+            } else {
+                ggml_backend_tensor_memset(t, 0, 0, ggml_nbytes(t));
+            }
+        }
+
+        initialize_queries(ggml_get_tensor(ctx, "q"));
+        initialize_cache(ggml_get_tensor(ctx, "k"), ggml_get_tensor(ctx, "k_gqa1"), true);
+        initialize_cache(ggml_get_tensor(ctx, "v"), ggml_get_tensor(ctx, "v_gqa1"), false);
+        if (mask) {
+            initialize_mask(ggml_get_tensor(ctx, "m"));
+        }
+        // All-masked cases must write zeros rather than inherit the initial buffer contents.
+        for (const char * name : {head_repeat == 4 ? "gqa4" : "gqa2", "gqa1", "gqa_comparison"}) {
+            ggml_tensor * t = ggml_get_tensor(ctx, name);
+            ggml_backend_tensor_memset(t, 0xff, 0, ggml_nbytes(t));
+        }
+    }
+
+    double err(const float * a, const float * b, size_t n) override {
+        const size_t head_size = size_t(hsv);
+        const size_t half_size = head_size*head_repeat*nh;
+        if (n != 2*half_size) {
+            return INFINITY;
+        }
+
+        if (pattern == mask_pattern::ALL) {
+            for (size_t i = 0; i < n; ++i) {
+                if (!std::isfinite(a[i]) || !std::isfinite(b[i]) || a[i] != 0.0f || b[i] != 0.0f) {
+                    return INFINITY;
+                }
+            }
+            return 0.0;
+        }
+
+        double result = 0.0;
+        for (size_t i = 0; i < half_size; i += head_size) {
+            // Compare each head separately so another head cannot hide a failure.
+            result = std::max(result, finite_nmse(b + i, a + i, head_size));
+            result = std::max(result, finite_nmse(b + half_size + i, a + half_size + i, head_size));
+            result = std::max(result, finite_nmse(a + half_size + i, a + i, head_size));
+            result = std::max(result, finite_nmse(b + half_size + i, b + i, head_size));
+        }
+        return result;
+    }
+
+private:
+    static double finite_nmse(const float * reference, const float * actual, size_t n) {
+        double error = 0.0;
+        double energy = 0.0;
+        for (size_t i = 0; i < n; ++i) {
+            if (!std::isfinite(reference[i]) || !std::isfinite(actual[i])) {
+                return INFINITY;
+            }
+            const double delta = double(reference[i]) - actual[i];
+            error += delta*delta;
+            energy += double(reference[i])*reference[i];
+        }
+        return energy == 0.0 ? (error == 0.0 ? 0.0 : INFINITY) : error/energy;
+    }
+
+    void initialize_queries(ggml_tensor * q) const {
+        std::array<float, 128> row;
+        for (int64_t h = 0; h < head_repeat*nh; ++h) {
+            for (int d = 0; d < 128; ++d) {
+                if (opposed_queries) {
+                    // The second GQA4 pair has distinct scores and less concentrated weights.
+                    const float magnitude = head_repeat == 4 && h % 4 >= 2 ? 0.125f : 1.5f;
+                    row[d] = (h % 2 == 0 ? magnitude : -magnitude)*(d % 2 == 0 ? 1.0f : -1.0f);
+                } else {
+                    row[d] = float((d*5 + h*13) % 29 - 14)/16.0f;
+                }
+            }
+            ggml_backend_tensor_set(q, row.data(), h*q->nb[2], sizeof(row));
+        }
+    }
+
+    void initialize_cache(ggml_tensor * cache, ggml_tensor * copy, bool is_key) const {
+        std::array<float, 128> row;
+        std::vector<uint8_t> packed(ggml_row_size(cache->type, 128));
+        for (int64_t h = 0; h < nh; ++h) {
+            for (int64_t t = 0; t < kv; ++t) {
+                for (int d = 0; d < 128; ++d) {
+                    if (is_key && opposed_queries) {
+                        row[d] = (t % 2 == 0 ? 0.5f : -0.5f)*(d % 2 == 0 ? 1.0f : -1.0f);
+                    } else if (is_key) {
+                        row[d] = float((d*7 + t*3 + h*11) % 37 - 18)/32.0f;
+                    } else {
+                        row[d] = float((d*11 + t*17 + h*3) % 41 - 20)/32.0f;
+                    }
+                }
+                const size_t written = ggml_quantize_chunk(cache->type, row.data(), packed.data(), 0, 1, 128, nullptr);
+                GGML_ASSERT(written == packed.size());
+                ggml_backend_tensor_set(cache, packed.data(), t*cache->nb[1] + h*cache->nb[2], packed.size());
+                for (int repeat = 0; repeat < head_repeat; ++repeat) {
+                    ggml_backend_tensor_set(copy, packed.data(), t*copy->nb[1] + (head_repeat*h + repeat)*copy->nb[2], packed.size());
+                }
+            }
+        }
+    }
+
+    void initialize_mask(ggml_tensor * m) const {
+        std::vector<float> values(kv, 0.0f);
+        for (int64_t t = 0; t < kv; ++t) {
+            // Include whole skipped tiles, isolated masked positions, and a live padded tail.
+            if (pattern == mask_pattern::ALL || (t != kv - 1 && ((t/32) % 3 == 0 || t % 11 == 5))) {
+                values[t] = -INFINITY;
+            } else {
+                values[t] = -float(t % 7)/8.0f;
+            }
+        }
+        std::vector<ggml_fp16_t> packed(kv);
+        ggml_fp32_to_fp16_row(values.data(), packed.data(), kv);
+        ggml_backend_tensor_set(m, packed.data(), 0, packed.size()*sizeof(ggml_fp16_t));
+    }
+};
diff --git a/tests/test-backend-ops-turbo4-write-bytes.h b/tests/test-backend-ops-turbo4-write-bytes.h
