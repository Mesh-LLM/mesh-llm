+        turbo_centroids_4bit[(qb0 >> 4) & 0xF] * norm,
+        turbo_centroids_4bit[(qb1     ) & 0xF] * norm,
+        turbo_centroids_4bit[(qb1 >> 4) & 0xF] * norm
+    ));
+}
