From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate llama4 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/llama4.cpp b/src/models/llama4.cpp
index 5fa2a623f7438c548a3c63dd680c95a375f2ba33..22f069769476b7ce9bfb7ba2df26ab086f7f5ef9 100644
--- a/src/models/llama4.cpp
+++ b/src/models/llama4.cpp
@@ -138,6 +138,8 @@ llama_model_llama4::graph<iswa>::graph(const llm_graph_params & params) : llm_gr
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
 
         ggml_tensor * inpSA = inpL;
 
@@ -238,6 +240,7 @@ llama_model_llama4::graph<iswa>::graph(const llm_graph_params & params) : llm_gr
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
-- 
