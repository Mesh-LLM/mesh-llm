From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate gemma4 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index 4758ce172daa41eca3d24a4724446b32539eb6e8..1c203dfc26a5fef9ffc64dc88c65458fddef41cd 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -191,6 +191,8 @@ llama_model_gemma4::graph::graph(const llama_model & model, const llm_graph_para
     }
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const int64_t n_embd_head = hparams.n_embd_head_k(il);
         GGML_ASSERT(n_embd_head == hparams.n_embd_head_v(il));
 
@@ -408,6 +410,7 @@ llama_model_gemma4::graph::graph(const llama_model & model, const llm_graph_para
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
-- 
