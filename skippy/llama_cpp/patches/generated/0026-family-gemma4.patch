From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate gemma4 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/gemma4.cpp b/src/models/gemma4.cpp
index 75478afa48e01ac877b580405f5a67e708e05f1e..7f1ec4bf90dfca268ee8542cd98fabfced1bb3d6 100644
--- a/src/models/gemma4.cpp
+++ b/src/models/gemma4.cpp
@@ -209,6 +209,8 @@ llama_model_gemma4::graph::graph(const llm_graph_params & params) :
     int64_t n_rows = n_tokens;
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         if (prune_shared && il == (int) hparams.n_layer_kv_from_start) {
             inpL    = ggml_get_rows(ctx0, inpL, inp_out_ids);
             inp_pos = ggml_reshape_1d(ctx0, ggml_get_rows(ctx0, ggml_reshape_2d(ctx0, inp_pos, 1, n_tokens), inp_out_ids), n_outputs);
@@ -431,6 +433,7 @@ llama_model_gemma4::graph::graph(const llm_graph_params & params) :
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
