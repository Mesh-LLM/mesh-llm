From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate mimo2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/mimo2.cpp b/src/models/mimo2.cpp
index 3577ddb85bdffc6776f00531234ca2f6abeac56e..2da51fc2d4f394fac80af82fcb9f74fce2f03c8e 100644
--- a/src/models/mimo2.cpp
+++ b/src/models/mimo2.cpp
@@ -110,6 +110,8 @@ llama_model_mimo2::graph::graph(const llama_model & model, const llm_graph_param
     const bool crop_last_layer = inp_out_ids && (!emit_h_nextn || cparams.embeddings_nextn_masked) && !extract_final_inp;
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         ggml_tensor * inpSA = inpL;
@@ -241,6 +243,7 @@ llama_model_mimo2::graph::graph(const llama_model & model, const llm_graph_param
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
