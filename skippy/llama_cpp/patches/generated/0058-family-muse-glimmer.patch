From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate muse-glimmer graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/muse-glimmer.cpp b/src/models/muse-glimmer.cpp
index 0e5f75ebed9e66a02873e82d08b189cf89c77a75..13437b41c34da6558454cd7847691cd6537073d9 100644
--- a/src/models/muse-glimmer.cpp
+++ b/src/models/muse-glimmer.cpp
@@ -76,6 +76,8 @@ llama_model_muse_glimmer::graph::graph(const llama_model & model, const llm_grap
     const float kq_scale = 1.0f / sqrtf(float(n_embd_head));
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         // expose per-layer residual for speculative drafts (see LLM_KV_TARGET_LAYERS).
         res->t_layer_inp[il] = inpL;
 
@@ -172,6 +174,7 @@ llama_model_muse_glimmer::graph::graph(const llama_model & model, const llm_grap
         cb(cur, "l_out", il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
-- 
