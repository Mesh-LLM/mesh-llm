From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate arcee graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/arcee.cpp b/src/models/arcee.cpp
index 81e3b828f7e26090eb5a00d5324ea9fd82dc6a9d..c65db4bd6ad6f19ff9b7e9a48d3683d65a698bc9 100644
--- a/src/models/arcee.cpp
+++ b/src/models/arcee.cpp
@@ -66,6 +66,8 @@ llama_model_arcee::graph::graph(const llama_model & model, const llm_graph_param
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -136,6 +138,7 @@ llama_model_arcee::graph::graph(const llama_model & model, const llm_graph_param
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
