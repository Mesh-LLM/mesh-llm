From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate glm45-air--glm47-flash graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/glm4-moe.cpp b/src/models/glm4-moe.cpp
index 9aba87bfb4613fd0d946411d7734981e043e0136..d18e3827d6c37a9fef2e00be6c23640991b11420 100644
--- a/src/models/glm4-moe.cpp
+++ b/src/models/glm4-moe.cpp
@@ -312,6 +312,8 @@ llama_model_glm4_moe::graph::graph(const llama_model & model, const llm_graph_pa
 
     // NextN layers are processed by graph_mtp.
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // Pre-attention norm
@@ -416,6 +418,7 @@ llama_model_glm4_moe::graph::graph(const llama_model & model, const llm_graph_pa
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
     cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
-- 
2.54.0

