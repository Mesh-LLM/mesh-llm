From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate gemma3n graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/gemma3n.cpp b/src/models/gemma3n.cpp
index 64809def800cadd8b8acbb440607296784027498..440538a8a3f8decf481d77343f6953a0f400cb42 100644
--- a/src/models/gemma3n.cpp
+++ b/src/models/gemma3n.cpp
@@ -131,6 +131,8 @@ llama_model_gemma3n::graph::graph(const llm_graph_params & params) :
     // inpL now has shape: [n_embd, n_tokens, n_altup]
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         // this block is made to be closely resemble Gemma3p5DecoderLayer on python code
 
         ggml_tensor * cur         = inpL;                    // [n_embd, n_tokens, n_altup]
@@ -260,6 +262,7 @@ llama_model_gemma3n::graph::graph(const llm_graph_params & params) :
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;  // [n_embd, n_tokens, n_altup]
 
-- 
