From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate kimi-linear graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/kimi-linear.cpp b/src/models/kimi-linear.cpp
index b8c45536013c501e79d5ef73a577d9aa5180f571..26bc95bd7c1eb149e5e302c570a403916e860d07 100644
--- a/src/models/kimi-linear.cpp
+++ b/src/models/kimi-linear.cpp
@@ -276,6 +276,8 @@ llama_model_kimi_linear::graph::graph(const llama_model & model, const llm_graph
     const float kq_scale_mla = 1.0f / sqrtf((float)n_embd_head_k_mla);
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const auto & layer = model.layers[il];
         ggml_tensor * inpSA = inpL;
 
@@ -544,6 +546,7 @@ llama_model_kimi_linear::graph::graph(const llama_model & model, const llm_graph
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
