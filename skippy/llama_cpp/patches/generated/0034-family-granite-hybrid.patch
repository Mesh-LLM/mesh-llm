Subject: [PATCH] skippy: annotate granite-hybrid graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/granite-hybrid.cpp b/src/models/granite-hybrid.cpp
index fb3bf7024be3d9deead8a1fa546c9b7fc920e012..f5e54d4230ea0c0ae77602465b5e5fc8246edb47 100644
--- a/src/models/granite-hybrid.cpp
+++ b/src/models/granite-hybrid.cpp
@@ -153,6 +153,8 @@ llama_model_granite_hybrid::graph::graph(const llama_model & model, const llm_gr
     }
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         struct ggml_tensor * inpSA = inpL;
 
         // norm
@@ -177,6 +179,7 @@ llama_model_granite_hybrid::graph::graph(const llama_model & model, const llm_gr
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
