From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate glm4--glm4-expansion graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/glm4.cpp b/src/models/glm4.cpp
index 98946925e78cb3a855dd503b34e8c99579f8fe7d..95637da8cbf1f92b012ae134d23a086bcd3b8a14 100644
--- a/src/models/glm4.cpp
+++ b/src/models/glm4.cpp
@@ -86,6 +86,8 @@ llama_model_glm4::graph::graph(const llm_graph_params & params) : llm_graph_cont
     // Only process up to last layer (skip final NextN layer)
     // Final layer tensors are loaded but not processed in forward pass
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // Pre-attention norm
@@ -146,6 +148,7 @@ llama_model_glm4::graph::graph(const llm_graph_params & params) : llm_graph_cont
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     // Final norm
     cur = build_norm(inpL, model.output_norm, NULL, LLM_NORM_RMS, -1);
-- 
2.54.0

