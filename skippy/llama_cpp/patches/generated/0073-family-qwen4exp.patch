From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate qwen4exp graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/qwen4exp.cpp b/src/models/qwen4exp.cpp
index f3496af78905f01f9f0fd889d5984408e0f9d815..4d3cad519b8fec76da448cb5091545e62868d4c7 100644
--- a/src/models/qwen4exp.cpp
+++ b/src/models/qwen4exp.cpp
@@ -492,6 +492,8 @@ llama_model_qwen4exp::graph::graph(const llm_graph_params & params) :
     ggml_build_forward_expand(gf, res_hc);
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(res_hc, il);
+
         if ((size_t) il < cparams.embeddings_layer_inp.size() && cparams.embeddings_layer_inp[il]) {
             res->t_layer_inp[il] = hc_stream_mean(ctx0, res_hc);
             cb(res->t_layer_inp[il], "layer_inp", il);
@@ -547,6 +549,7 @@ llama_model_qwen4exp::graph::graph(const llm_graph_params & params) :
 
         // "l_last" is the layer output name that build_cvec and imatrix look for
         cb(res_hc, "l_last", il);
+        end_block(res_hc, il);
     }
 
     // the MTP head reads the hc-wide residual, before the final mixer
