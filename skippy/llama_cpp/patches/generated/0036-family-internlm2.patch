From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate internlm2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/internlm2.cpp b/src/models/internlm2.cpp
index f6cfdfb9458f81c197c2dbf4349522ed43d33187..af10be02e880e69b87d2f74aaa6a88a550dd4d90 100644
--- a/src/models/internlm2.cpp
+++ b/src/models/internlm2.cpp
@@ -57,6 +57,8 @@ llama_model_internlm2::graph::graph(const llama_model & model, const llm_graph_p
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -119,6 +121,7 @@ llama_model_internlm2::graph::graph(const llama_model & model, const llm_graph_p
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
