From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate beam graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/beam.cpp b/src/models/beam.cpp
index 55817dd4839a85aa60e054ea487e0711a06b4db6..09060bc6ffee965bd22af3f2ab9dcfbfe1348563 100644
--- a/src/models/beam.cpp
+++ b/src/models/beam.cpp
@@ -136,6 +136,8 @@ llama_model_beam::graph::graph(const llama_model & model, const llm_graph_params
     const float kq_scale = 1.0f / sqrtf(float(n_embd_head));
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const auto & layer = model.layers[il];
 
         const bool is_swa = hparams.is_swa(il);
@@ -240,6 +242,7 @@ llama_model_beam::graph::graph(const llama_model & model, const llm_graph_params
         cb(cur, "l_out", il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
-- 
