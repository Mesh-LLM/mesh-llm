From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate granite-switch graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/granite-switch.cpp b/src/models/granite-switch.cpp
index 1af4c6ed42deb59cb279bf6987d3c921561da1d1..42fa6702cc214a244c50ee882f55acc5e8d96328 100644
--- a/src/models/granite-switch.cpp
+++ b/src/models/granite-switch.cpp
@@ -320,6 +320,8 @@ llama_model_granite_switch::graph::graph(
     ggml_tensor * cur;
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
@@ -340,6 +342,7 @@ llama_model_granite_switch::graph::graph(
         cur = build_layer_ffn(cur, inpSA, adapter_ids, model, il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
-- 
