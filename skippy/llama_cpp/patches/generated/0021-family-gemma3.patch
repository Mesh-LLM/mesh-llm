From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate gemma3 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/gemma3.cpp b/src/models/gemma3.cpp
index f99bbaacd8adcdd34810064eb4b2320ff28e2d71..a4db2a0546735dd18de8e733fbe6b4ef815b45c3 100644
--- a/src/models/gemma3.cpp
+++ b/src/models/gemma3.cpp
@@ -107,6 +107,8 @@ llama_model_gemma3::graph<iswa>::graph(const llama_model & model, const llm_grap
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         float freq_base_l  = 0.0f;
         float freq_scale_l = 0.0f;
 
@@ -194,6 +196,7 @@ llama_model_gemma3::graph<iswa>::graph(const llama_model & model, const llm_grap
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
