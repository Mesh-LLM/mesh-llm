From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate lfm2--lfm2-moe--lfm2-vl graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/lfm2.cpp b/src/models/lfm2.cpp
index 86b948cf3de9ac7a5b54f50c20377fa6011eedb4..b76f4e35026dc2ee9760298e7c260118ea40d447 100644
--- a/src/models/lfm2.cpp
+++ b/src/models/lfm2.cpp
@@ -208,6 +208,8 @@ llama_model_lfm2::graph<iswa>::graph(const llm_graph_params & params) :
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(cur, il);
+
         res->t_layer_inp[il] = cur;
 
         const bool is_moe_layer = il >= static_cast<int>(hparams.n_layer_dense_lead);
@@ -241,6 +243,7 @@ llama_model_lfm2::graph<iswa>::graph(const llm_graph_params & params) :
 
         cur = build_cvec(cur, il);
         cb(cur, "l_out", il);
+        end_block(cur, il);
     }
 
     cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
@@ -353,6 +356,8 @@ llama_model_lfm2::graph_decision::graph_decision(const llm_graph_params & params
     res->add_input(std::move(inp_conv));
 
     for (int il = 0; il < n_layer_enc; ++il) {
+        begin_block(cur, il);
+
         const auto & layer = model.layers[il];
 
         ggml_tensor * inpL = cur;
@@ -412,6 +417,7 @@ llama_model_lfm2::graph_decision::graph_decision(const llm_graph_params & params
 
         cur = ggml_add(ctx0, cur, ffn_out);
         cb(cur, "l_out", il);
+        end_block(cur, il);
     }
 
     cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
-- 
2.54.0

