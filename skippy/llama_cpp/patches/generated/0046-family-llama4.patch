From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate llama4 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/llama4.cpp b/src/models/llama4.cpp
index 4f79b4d1eefeced8eaa7512b2649b50e854af100..7dd31312954d58b618246dd8383510cd8bdf6ee7 100644
--- a/src/models/llama4.cpp
+++ b/src/models/llama4.cpp
@@ -134,6 +134,8 @@ llama_model_llama4::graph<iswa>::graph(const llama_model & model, const llm_grap
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const float freq_base_l  = model.get_rope_freq_base (cparams, il);
         const float freq_scale_l = model.get_rope_freq_scale(cparams, il);
 
@@ -248,6 +250,7 @@ llama_model_llama4::graph<iswa>::graph(const llama_model & model, const llm_grap
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
-- 
