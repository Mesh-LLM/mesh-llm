From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate xing4-0 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/xing4-0.cpp b/src/models/xing4-0.cpp
index c95acd6b83c28127e8628b2f3c2b3a89109456c8..fce2459b1082f78759d505c2caa126eca0ab7451 100644
--- a/src/models/xing4-0.cpp
+++ b/src/models/xing4-0.cpp
@@ -628,6 +628,8 @@ llama_model_xing4_0::graph::graph(const llama_model & model, const llm_graph_par
     cb(inpL, "hc_init", -1);
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const auto & layer = model.layers[il];
 
         ggml_tensor * residual = inpL;
@@ -796,6 +798,7 @@ llama_model_xing4_0::graph::graph(const llama_model & model, const llm_graph_par
         inpL = build_hc_post(cur, residual, post, comb, il);
         inpL = build_cvec(inpL, il);
         cb(inpL, "l_out", il);
+        end_block(inpL, il);
     }
     cur = inpL;
 
-- 
