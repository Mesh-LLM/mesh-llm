From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate mellum graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/mellum.cpp b/src/models/mellum.cpp
index 3ab79747af276a93631ebe2d052edb63277e8971..685ab5c7bf1d7d17cd18ac0d807d2831479bf2e9 100644
--- a/src/models/mellum.cpp
+++ b/src/models/mellum.cpp
@@ -97,6 +97,8 @@ llama_model_mellum::graph<iswa>::graph(const llama_model & model, const llm_grap
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -196,6 +198,7 @@ llama_model_mellum::graph<iswa>::graph(const llama_model & model, const llm_grap
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
