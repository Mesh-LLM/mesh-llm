From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate muse-glimmer graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/muse-glimmer.cpp b/src/models/muse-glimmer.cpp
index e3f478fe3480cda14096e55c8ee9c56d63e64ccc..a8bbfaa30d517ed0f492c2338663d6b3fa194a5f 100644
--- a/src/models/muse-glimmer.cpp
+++ b/src/models/muse-glimmer.cpp
@@ -77,6 +77,8 @@ llama_model_muse_glimmer::graph::graph(const llm_graph_params & params)
     const float kq_scale = 1.0f / sqrtf(float(n_embd_head));
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         // expose per-layer residual for speculative drafts (see LLM_KV_TARGET_LAYERS).
         res->t_layer_inp[il] = inpL;
 
@@ -159,6 +161,7 @@ llama_model_muse_glimmer::graph::graph(const llm_graph_params & params)
         cb(cur, "l_out", il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
-- 
