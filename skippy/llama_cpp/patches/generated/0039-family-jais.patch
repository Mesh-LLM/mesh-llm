From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate jais graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/jais.cpp b/src/models/jais.cpp
index 415103ce23a86c475c32e2b60db39575dec669be..33314fe5672b88239270251e53d250d988858154 100644
--- a/src/models/jais.cpp
+++ b/src/models/jais.cpp
@@ -67,6 +67,8 @@ llama_model_jais::graph::graph(const llama_model & model, const llm_graph_params
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         cur = build_norm(inpL,
                 model.layers[il].attn_norm,
                 model.layers[il].attn_norm_b,
@@ -114,6 +116,7 @@ llama_model_jais::graph::graph(const llama_model & model, const llm_graph_params
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = build_norm(inpL,
             model.output_norm,
