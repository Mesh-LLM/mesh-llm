From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate limite graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/limite.cpp b/src/models/limite.cpp
index 8c6ba8b8f854db725d992cd735320c42c052ffc5..c5c90a1fa9a990dcaa89a0a4fb93713d87053113 100644
--- a/src/models/limite.cpp
+++ b/src/models/limite.cpp
@@ -118,6 +118,8 @@ llama_model_limite::graph::graph(const llm_graph_params & params) : llm_graph_co
     std::vector<ggml_tensor *> hist(n_layer, nullptr);
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const auto & layer = model.layers[il];
 
         hist[il] = inpL;
@@ -243,6 +245,7 @@ llama_model_limite::graph::graph(const llm_graph_params & params) : llm_graph_co
         cb(cur, "l_out", il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = build_norm(inpL, nullptr, nullptr, LLM_NORM_RMS, -1);
-- 
