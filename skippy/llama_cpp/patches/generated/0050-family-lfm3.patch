From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate lfm3 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/lfm3.cpp b/src/models/lfm3.cpp
index 0746394ce31cb7b0977680d68281c41303955950..ec5c2a030f88b7f92fac834c20b96ca6addc8e3a 100644
--- a/src/models/lfm3.cpp
+++ b/src/models/lfm3.cpp
@@ -149,6 +149,8 @@ llama_model_lfm3::graph<decision>::graph(const llm_graph_params & params) :
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(cur, il);
+
         res->t_layer_inp[il] = cur;
 
         auto * prev_cur = cur;
@@ -195,6 +197,7 @@ llama_model_lfm3::graph<decision>::graph(const llm_graph_params & params) :
 
         cur = build_cvec(cur, il);
         cb(cur, "l_out", il);
+        end_block(cur, il);
     }
 
     cur = build_norm(cur, model.output_norm, NULL, LLM_NORM_RMS, -1);
-- 
