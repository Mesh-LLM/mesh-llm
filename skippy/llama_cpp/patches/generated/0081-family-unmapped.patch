     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -150,6 +152,7 @@ llama_model_arctic::graph::graph(const llm_graph_params & params) : llm_graph_co
 
         // input for next layer
