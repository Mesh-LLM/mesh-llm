From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate minimax-m2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/minimax-m2.cpp b/src/models/minimax-m2.cpp
index 8b80eab2da1979b16629d4ef66c4eca0282390f8..2d6175807b8794215a96e08a2ab58f361cbb4953 100644
--- a/src/models/minimax-m2.cpp
+++ b/src/models/minimax-m2.cpp
@@ -60,6 +60,8 @@ llama_model_minimax_m2::graph::graph(const llama_model & model, const llm_graph_
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         ggml_tensor * inpSA = inpL;
@@ -147,6 +149,7 @@ llama_model_minimax_m2::graph::graph(const llama_model & model, const llm_graph_
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
