From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate clef-flash graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/clef.cpp b/src/models/clef.cpp
index cd2889b2251c7fd89365da55e00ce3efe0e1470d..9399f40a17ce0ccaf9d8a22539f2ced1e2c0796e 100644
--- a/src/models/clef.cpp
+++ b/src/models/clef.cpp
@@ -265,6 +265,8 @@ llama_model_clef::graph::graph(const llama_model & model_base, const llm_graph_p
     res->add_input(std::move(inp_decision_ptr));
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         cur = build_norm(inpL, model.layers[il].attn_norm, nullptr, LLM_NORM_RMS, il);
@@ -296,6 +298,7 @@ llama_model_clef::graph::graph(const llama_model & model_base, const llm_graph_p
         cb(cur, "l_out", il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = build_norm(inpL, model.output_norm, nullptr, LLM_NORM_RMS, -1);
-- 
