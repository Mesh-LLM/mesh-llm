From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate sensenova-u1 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/sensenova-u1.cpp b/src/models/sensenova-u1.cpp
index 3326db0313b9e248772c91c14bd015bdabbd77e6..ba2b8f1ae956249668520ba8a5250b40da3af897 100644
--- a/src/models/sensenova-u1.cpp
+++ b/src/models/sensenova-u1.cpp
@@ -127,6 +127,8 @@ llama_model_sensenova_u1::graph::graph(const llm_graph_params & params) : llm_gr
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         ggml_tensor * inpSA = inpL;
@@ -178,6 +180,7 @@ llama_model_sensenova_u1::graph::graph(const llm_graph_params & params) : llm_gr
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
