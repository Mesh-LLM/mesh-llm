From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate granite-swa graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/granite-swa.cpp b/src/models/granite-swa.cpp
index 1bfa9b508ac8d74b2d9f5cd9421d290c40e49253..acb3ecb2800daa4d3f6edc407a37294cf14b15ff 100644
--- a/src/models/granite-swa.cpp
+++ b/src/models/granite-swa.cpp
@@ -156,6 +156,8 @@ llama_model_granite_swa::graph::graph(const llm_graph_params & params) : llm_gra
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
 
         // Granite Vision 4.1 deepstack: inject the projector stream that
         // targets decoder layer `il` before the decoder runs.
@@ -194,6 +196,7 @@ llama_model_granite_swa::graph::graph(const llm_graph_params & params) : llm_gra
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
