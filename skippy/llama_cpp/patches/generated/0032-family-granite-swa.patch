From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate granite-swa graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/granite-swa.cpp b/src/models/granite-swa.cpp
index e993cfc9101afbff9e108a7fad1c4c7b55a98f71..c34923c2e60be2b60c255b8055135d95a95757c6 100644
--- a/src/models/granite-swa.cpp
+++ b/src/models/granite-swa.cpp
@@ -149,6 +149,8 @@ llama_model_granite_swa::graph::graph(
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
 
         // Granite Vision 4.1 deepstack: inject the projector stream that
         // targets decoder layer `il` before the decoder runs.
@@ -185,6 +187,7 @@ llama_model_granite_swa::graph::graph(
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
