From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate gemma graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/gemma.cpp b/src/models/gemma.cpp
index 1d42acd0127cbe5c4a62771301eb1aa521fee243..30a45b1f8d089ac72e84a25842152adc46380b06 100644
--- a/src/models/gemma.cpp
+++ b/src/models/gemma.cpp
@@ -57,6 +57,8 @@ llama_model_gemma::graph::graph(const llm_graph_params & params) : llm_graph_con
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         // norm
         cur = build_norm(inpL,
                 model.layers[il].attn_norm, NULL,
@@ -112,6 +114,7 @@ llama_model_gemma::graph::graph(const llm_graph_params & params) : llm_graph_con
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
