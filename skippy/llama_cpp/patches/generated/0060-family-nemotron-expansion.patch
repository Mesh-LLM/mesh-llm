From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate nemotron-expansion graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/nemotron.cpp b/src/models/nemotron.cpp
index 6b5b771074b77b82babb78a9897fd53d65cee2ae..eccf25efe41861161c26bccc209ac950648f86d4 100644
--- a/src/models/nemotron.cpp
+++ b/src/models/nemotron.cpp
@@ -69,6 +69,8 @@ llama_model_nemotron::graph::graph(const llama_model & model, const llm_graph_pa
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -133,6 +135,7 @@ llama_model_nemotron::graph::graph(const llama_model & model, const llm_graph_pa
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
