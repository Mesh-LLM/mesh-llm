From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate bailingmoe2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/bailingmoe2.cpp b/src/models/bailingmoe2.cpp
index 24fc4e0226b4d3380786a3e0428673373d016154..e091409cf727878360c6f891ad0d91f5c6fcd0c7 100644
--- a/src/models/bailingmoe2.cpp
+++ b/src/models/bailingmoe2.cpp
@@ -106,6 +106,8 @@ llama_model_bailingmoe2::graph::graph(const llama_model & model, const llm_graph
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -192,6 +194,7 @@ llama_model_bailingmoe2::graph::graph(const llama_model & model, const llm_graph
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
