From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate qwen3-dense graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/qwen3.cpp b/src/models/qwen3.cpp
index bf7e622fb9d456c2a782ebff0b45e86fe79d5aff..22bd80b65f7d8ccb92425d5397f3a98a7a9cd6d6 100644
--- a/src/models/qwen3.cpp
+++ b/src/models/qwen3.cpp
@@ -79,6 +79,8 @@ ggml_tensor * llama_model_qwen3::graph::build_backbone(const llama_model & model
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         ggml_tensor * inpSA = inpL;
@@ -149,6 +151,7 @@ ggml_tensor * llama_model_qwen3::graph::build_backbone(const llama_model & model
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
