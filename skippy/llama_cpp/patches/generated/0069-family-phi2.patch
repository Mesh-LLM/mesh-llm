From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate phi2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/phi2.cpp b/src/models/phi2.cpp
index 90c502cfdee47cd9658cce0a15818fab0392c2f3..4d56f0abb926d8c8de588f3b7719b6f1c7040fb5 100644
--- a/src/models/phi2.cpp
+++ b/src/models/phi2.cpp
@@ -64,6 +64,8 @@ llama_model_phi2::graph::graph(const llm_graph_params & params) : llm_graph_cont
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         attn_norm_output = build_norm(inpL,
                 model.layers[il].attn_norm,
                 model.layers[il].attn_norm_b,
@@ -112,6 +114,7 @@ llama_model_phi2::graph::graph(const llm_graph_params & params) : llm_graph_cont
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = build_norm(inpL,
             model.output_norm,
-- 
