From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate mellum graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/mellum.cpp b/src/models/mellum.cpp
index 57dd5b79a28e836e57b427dff38e782149652464..4382edd66ab9cfe35e7a65f69d9331258553eddd 100644
--- a/src/models/mellum.cpp
+++ b/src/models/mellum.cpp
@@ -144,6 +144,8 @@ llama_model_mellum::graph<iswa>::graph(const llm_graph_params & params) : llm_gr
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -215,6 +217,7 @@ llama_model_mellum::graph<iswa>::graph(const llm_graph_params & params) : llm_gr
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
