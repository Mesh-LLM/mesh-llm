From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate maincoder graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/maincoder.cpp b/src/models/maincoder.cpp
index 1a2d2c695b6c1b72afe8dfc540f34d2e3467b16a..74ad18db79df606c082704c57bfbfd9ee6c2fb29 100644
--- a/src/models/maincoder.cpp
+++ b/src/models/maincoder.cpp
@@ -71,6 +71,8 @@ llama_model_maincoder::graph::graph(const llm_graph_params & params) : llm_graph
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -130,6 +132,7 @@ llama_model_maincoder::graph::graph(const llm_graph_params & params) : llm_graph
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
