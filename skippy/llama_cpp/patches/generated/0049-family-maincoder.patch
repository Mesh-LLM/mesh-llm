From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate maincoder graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/maincoder.cpp b/src/models/maincoder.cpp
index 1eeab45a156e9ff6f05fddc370401bb47e61bff2..1e3d4025254a85570e0a56ec1178875dd489acc3 100644
--- a/src/models/maincoder.cpp
+++ b/src/models/maincoder.cpp
@@ -63,6 +63,8 @@ llama_model_maincoder::graph::graph(const llama_model & model, const llm_graph_p
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -131,6 +133,7 @@ llama_model_maincoder::graph::graph(const llama_model & model, const llm_graph_p
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
