From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate stablelm graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/stablelm.cpp b/src/models/stablelm.cpp
index 5aec7beee520986ad6ba4c4563ad2bb7c8647517..a68cc0d623e3d48c65862e6cb739dbd93eba34a2 100644
--- a/src/models/stablelm.cpp
+++ b/src/models/stablelm.cpp
@@ -66,6 +66,8 @@ llama_model_stablelm::graph::graph(const llm_graph_params & params) : llm_graph_
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         // norm
         cur = build_norm(inpL,
                 model.layers[il].attn_norm,
@@ -142,6 +144,7 @@ llama_model_stablelm::graph::graph(const llm_graph_params & params) : llm_graph_
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
