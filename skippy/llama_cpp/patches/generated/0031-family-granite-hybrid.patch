From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate granite-hybrid graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/granite-hybrid.cpp b/src/models/granite-hybrid.cpp
index be352dfd770dc6b14091f4d0e534d58e04fdce9f..f8cb79e93cdd1b62b18927d6ea0a4b67f6b3ddca 100644
--- a/src/models/granite-hybrid.cpp
+++ b/src/models/granite-hybrid.cpp
@@ -153,6 +153,8 @@ llama_model_granite_hybrid::graph::graph(const llm_graph_params & params) :
     }
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         struct ggml_tensor * inpSA = inpL;
@@ -179,6 +181,7 @@ llama_model_granite_hybrid::graph::graph(const llm_graph_params & params) :
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
