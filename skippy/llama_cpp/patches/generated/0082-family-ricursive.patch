From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate ricursive graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/ricursive.cpp b/src/models/ricursive.cpp
index e14caa8b3c1ae561a2625bfd592ce1859d1441ff..149de00e00afdfa8b5ab01993af4b34ba5375a97 100644
--- a/src/models/ricursive.cpp
+++ b/src/models/ricursive.cpp
@@ -130,6 +130,8 @@ llama_model_ricursive::graph::graph(const llm_graph_params & params) : llm_graph
     const float kq_scale = 1.0f / sqrtf(float(n_embd_head));
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const auto & layer = model.layers[il];
 
         ggml_tensor * inpSA = inpL;
@@ -215,6 +217,7 @@ llama_model_ricursive::graph::graph(const llm_graph_params & params) : llm_graph
         cb(cur, "l_out", il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = build_norm(inpL, model.output_norm, NULL, LLM_NORM_RMS, -1);
-- 
