From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate falcon-dense graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/falcon.cpp b/src/models/falcon.cpp
index b2ad90b327243c35096f8a596fe82aca6f6ab8d2..3d4f80120f201b608c22a14b05fcc656d4ce8837 100644
--- a/src/models/falcon.cpp
+++ b/src/models/falcon.cpp
@@ -66,6 +66,8 @@ llama_model_falcon::graph::graph(const llama_model & model, const llm_graph_para
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * attn_norm;
 
         attn_norm = build_norm(inpL,
@@ -139,6 +141,7 @@ llama_model_falcon::graph::graph(const llama_model & model, const llm_graph_para
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
-- 
