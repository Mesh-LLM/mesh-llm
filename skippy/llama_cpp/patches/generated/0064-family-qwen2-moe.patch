From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate qwen2-moe graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/qwen2moe.cpp b/src/models/qwen2moe.cpp
index 256c91a8f209364616dc3ea9aafbf6ff9f62809a..f851bb076aae95a35af921fc2c0e0fe040d3c85d 100644
--- a/src/models/qwen2moe.cpp
+++ b/src/models/qwen2moe.cpp
@@ -84,6 +84,8 @@ llama_model_qwen2moe::graph::graph(const llm_graph_params & params) : llm_graph_
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -168,6 +170,7 @@ llama_model_qwen2moe::graph::graph(const llm_graph_params & params) : llm_graph_
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
