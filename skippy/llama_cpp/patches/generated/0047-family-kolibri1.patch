From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate kolibri1 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/kolibri1.cpp b/src/models/kolibri1.cpp
index a703ddfdac800912fb9d5b699af2fb7ec3e76cab..2fb2e5752396df4b0957f829fcca42bc57408755 100644
--- a/src/models/kolibri1.cpp
+++ b/src/models/kolibri1.cpp
@@ -82,6 +82,8 @@ llama_model_kolibri1::graph::graph(const llm_graph_params & params)
     const float kq_scale = 1.0f / sqrtf(float(n_embd_head));
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const auto & layer = model.layers[il];
 
         ggml_tensor * residual = inpL;
@@ -160,6 +162,7 @@ llama_model_kolibri1::graph::graph(const llm_graph_params & params)
 
         inpL = build_cvec(cur, il);
         cb(inpL, "l_out", il);
+        end_block(inpL, il);
     }
 
     cur = build_norm(inpL, model.output_norm, NULL, LLM_NORM_RMS, -1);
-- 
