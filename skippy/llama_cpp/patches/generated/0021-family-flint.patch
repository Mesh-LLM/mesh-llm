From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate flint graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/flint.cpp b/src/models/flint.cpp
index 520334ce656f2a1c2b235ddf8cd3329ac04cea64..1658a1d2aa3b7107f7cc8445f8c03ed10ffcbb37 100644
--- a/src/models/flint.cpp
+++ b/src/models/flint.cpp
@@ -104,6 +104,8 @@ llama_model_flint::graph::graph(const llm_graph_params & params) :
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
         ggml_tensor * inpSA = inpL;
 
@@ -184,6 +186,7 @@ llama_model_flint::graph::graph(const llm_graph_params & params) :
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
-- 
