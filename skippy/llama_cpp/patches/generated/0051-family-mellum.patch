From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate mellum graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/mellum.cpp b/src/models/mellum.cpp
index eaa540310c7fe55e59f43b570e030639bc704c8b..73cabbf829fd375b27d9302979c2759f03e79056 100644
--- a/src/models/mellum.cpp
+++ b/src/models/mellum.cpp
@@ -131,6 +131,8 @@ llama_model_mellum::graph<iswa>::graph(const llama_model & model, const llm_grap
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -220,6 +222,7 @@ llama_model_mellum::graph<iswa>::graph(const llama_model & model, const llm_grap
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
