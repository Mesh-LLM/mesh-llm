From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate chameleon graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/chameleon.cpp b/src/models/chameleon.cpp
index 23402da4ab2ed1fed57f5502c6cd25735d345c7f..8f44cdd2f07c5e72ba7c88e38ff51d1fc61d5a4c 100644
--- a/src/models/chameleon.cpp
+++ b/src/models/chameleon.cpp
@@ -69,6 +69,8 @@ llama_model_chameleon::graph::graph(const llm_graph_params & params) : llm_graph
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -160,6 +162,7 @@ llama_model_chameleon::graph::graph(const llm_graph_params & params) : llm_graph
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
-- 
