From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate jamba2 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/jamba.cpp b/src/models/jamba.cpp
index 842df63b6a80440794e3b823668e4cb1a532d555..5fac6dd53f0b5edc2be65ed2e0864299133ad1f1 100644
--- a/src/models/jamba.cpp
+++ b/src/models/jamba.cpp
@@ -119,6 +119,8 @@ llama_model_jamba::graph::graph(const llm_graph_params & params) : llm_build_mam
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         const int64_t n_head_kv = hparams.n_head_kv(il);
 
         cur = build_norm(inpL, model.layers[il].attn_norm, NULL, LLM_NORM_RMS, il);
@@ -181,6 +183,7 @@ llama_model_jamba::graph::graph(const llm_graph_params & params) : llm_build_mam
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
     // final rmsnorm
     cur = build_norm(inpL, model.output_norm, NULL, LLM_NORM_RMS, -1);
-- 
2.54.0

