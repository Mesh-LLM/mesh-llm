From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate minimax-m3 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/minimax-m3.cpp b/src/models/minimax-m3.cpp
index 52d40e2f1d70ca86f72723eec064f0b5978f2dce..3c41aeebb8cd7a629e6ae4b04f37555a8b55459a 100644
--- a/src/models/minimax-m3.cpp
+++ b/src/models/minimax-m3.cpp
@@ -322,6 +322,8 @@ llama_model_minimax_m3::graph::graph(const llm_graph_params & params) : llm_grap
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         // self-attention
@@ -607,6 +609,7 @@ llama_model_minimax_m3::graph::graph(const llm_graph_params & params) : llm_grap
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
-- 
