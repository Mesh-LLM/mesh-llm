Subject: [PATCH] skippy: annotate glm4-expansion graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/chatglm.cpp b/src/models/chatglm.cpp
index e7442b75f981d5700f6ac704a1d3fcafe15e8ca4..eefb617808b8cb495742e9d8142e149724105547 100644
--- a/src/models/chatglm.cpp
+++ b/src/models/chatglm.cpp
@@ -73,6 +73,8 @@ llama_model_chatglm::graph::graph(const llm_graph_params & params) : llm_graph_c
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         cur = build_norm(inpL,
@@ -133,6 +135,7 @@ llama_model_chatglm::graph::graph(const llm_graph_params & params) : llm_graph_c
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = build_norm(inpL,
