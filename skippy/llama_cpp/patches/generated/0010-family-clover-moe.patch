From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate clover-moe graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/clover-moe.cpp b/src/models/clover-moe.cpp
index 22fa83f0e26aa089d574734e5cdb1a23926bc5e5..f42a63a41b627402fb8baba131db37bbede0e385 100644
--- a/src/models/clover-moe.cpp
+++ b/src/models/clover-moe.cpp
@@ -137,6 +137,8 @@ llama_model_clover_moe::graph::graph(const llm_graph_params & params) :
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         res->t_layer_inp[il] = inpL;
 
         ggml_tensor * inpSA = inpL;
@@ -175,6 +177,7 @@ llama_model_clover_moe::graph::graph(const llm_graph_params & params) :
         cb(cur, "l_out", il);
 
         inpL = cur;
+        end_block(inpL, il);
     }
     cur = inpL;
 
