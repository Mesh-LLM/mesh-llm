From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate metis16 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/metis16.cpp b/src/models/metis16.cpp
index 6f0b32b547e940a17808161762de0a4ccf2f4535..8b80ce07eab489be317302e42118718482dce0cb 100644
--- a/src/models/metis16.cpp
+++ b/src/models/metis16.cpp
@@ -273,6 +273,8 @@ void llama_model_metis16::graph::build_pass_layers(const llama_model_metis16 & m
         const bool is_attn  = !hparams.is_recr(il);
         const bool writes   = is_attn || il_p == n_phys - 1;
 
+        begin_block(x, il);
+
         ggml_tensor * retrieved = bank_k ? mem_read(model, &x) : nullptr;
         ggml_tensor * feats = route_features(model, stream_mean(x), retrieved, nullptr, history);
 
@@ -341,6 +343,7 @@ void llama_model_metis16::graph::build_pass_layers(const llama_model_metis16 & m
         if (is_attn) {
             mem_write(model, x, summ, ent, conf, cont, n_entry++);
         }
+        end_block(x, il);
     }
 }
 
