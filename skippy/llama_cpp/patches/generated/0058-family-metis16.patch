From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate metis16 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/metis16.cpp b/src/models/metis16.cpp
index d79985497cb0f23acf0e4ce7a685438ff0edf189..4ec066ee41f43b8bf1f49e6d6fc67b159a37d552 100644
--- a/src/models/metis16.cpp
+++ b/src/models/metis16.cpp
@@ -382,6 +382,8 @@ llama_model_metis16::graph::graph(const llm_graph_params & params) : llm_build_m
     ggml_tensor * ent  = nullptr;
     ggml_tensor * conf = nullptr;
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(x, il);
+
 
         const int p = il / n_phys;
         if (il % n_phys == 0) {
@@ -416,6 +418,7 @@ llama_model_metis16::graph::graph(const llm_graph_params & params) : llm_build_m
             prev_state = state;
         }
         cb(x, "l_out", il);
+        end_block(x, il);
     }
 
     ggml_tensor * cur = stream_mean(x);
-- 
