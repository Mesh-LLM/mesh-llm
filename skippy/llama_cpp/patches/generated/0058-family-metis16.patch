From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate metis16 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/metis16.cpp b/src/models/metis16.cpp
index f482ff224785ef153a1a10bdf39362205fb48e14..a62f8f950174905828001a54da12ec23a0d34b47 100644
--- a/src/models/metis16.cpp
+++ b/src/models/metis16.cpp
@@ -388,6 +388,8 @@ llama_model_metis16::graph::graph(const llm_graph_params & params) : llm_build_m
     ggml_tensor * ent  = nullptr;
     ggml_tensor * conf = nullptr;
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(x, il);
+
 
         const int p = il / n_phys;
         if (il % n_phys == 0) {
@@ -423,6 +425,7 @@ llama_model_metis16::graph::graph(const llm_graph_params & params) : llm_build_m
             cb(prev_state, "previous_pass_state", il);
         }
         cb(x, "l_out", il);
+        end_block(x, il);
     }
 
     ggml_tensor * cur = stream_mean(x);
-- 
