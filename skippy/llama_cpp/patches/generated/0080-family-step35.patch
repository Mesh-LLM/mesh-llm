From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Thu, 1 Jan 1970 00:00:00 +0000
Subject: [PATCH] skippy: annotate step35 graph semantics

Generated by tools/skippy-stage-rewriter from compiler-proven builder
shapes. Auxiliary sidecars and whole-model multi-domain graphs are proven
separately and remain outside the primary decoder stage interval.

---
diff --git a/src/models/step35.cpp b/src/models/step35.cpp
index ad8a3a1c78c4e202e288e4ce7ac96c6812466e84..3f9e0530d8f0a1eb9790c880443b916297c49805 100644
--- a/src/models/step35.cpp
+++ b/src/models/step35.cpp
@@ -200,6 +200,8 @@ llama_model_step35::graph::graph(const llm_graph_params & params) : llm_graph_co
 
     // MTP/NextN layers are loaded as extra decoder blocks but not executed in the main pass.
     for (int il = 0; il < n_layer; ++il) {
+        begin_block(inpL, il);
+
         ggml_tensor * inpSA = inpL;
 
         const uint32_t n_head_l    = hparams.n_head(il);
@@ -329,6 +331,7 @@ llama_model_step35::graph::graph(const llm_graph_params & params) : llm_graph_co
 
         // input for next layer
         inpL = cur;
+        end_block(inpL, il);
     }
 
     cur = inpL;
-- 
