+// Batch placement (llama_kv_cells::place_together): every token gets its own free cell, and
+// a sequence's share of a batch lands in as few runs as the free space allows.
+#include "../src/llama-kv-cells.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <numeric>
+#include <random>
+#include <set>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { ++failures; std::printf("FAIL line %d: %s\n", __LINE__, #cond); } } while (0)
+
+static const uint32_t chunk = 64;
+
+static void commit(llama_kv_cells & cells, const std::vector<llama_seq_id> & seqs, const std::vector<uint32_t> & idxs,
+                   std::vector<llama_pos> & next_pos) {
+    std::vector<size_t> tokens(seqs.size());
+    std::iota(tokens.begin(), tokens.end(), size_t(0));
+    std::for_each(tokens.begin(), tokens.end(), [&](size_t i) {
+        cells.pos_set(idxs[i], next_pos[seqs[i]]++);
+        cells.seq_add(idxs[i], seqs[i]);
+    });
+}
+
+static size_t runs_of(const llama_kv_cells & cells, llama_seq_id seq) {
+    std::vector<uint32_t> own;
+    std::vector<uint32_t> all(cells.size());
+    std::iota(all.begin(), all.end(), 0u);
+    std::copy_if(all.begin(), all.end(), std::back_inserter(own), [&](uint32_t i) {
+        return !cells.is_empty(i) && cells.seq_has(i, seq);
+    });
+    if (own.empty()) {
+        return 0;
+    }
+    std::vector<uint32_t> gaps(own.size());
+    std::adjacent_difference(own.begin(), own.end(), gaps.begin());
+    return 1 + (size_t) std::count_if(gaps.begin() + 1, gaps.end(), [](uint32_t gap) { return gap != 1; });
+}
+
+static std::vector<llama_seq_id> batch_of(int n_seq, uint32_t per_seq) {
+    std::vector<llama_seq_id> seqs((size_t) n_seq*per_seq);
+    std::vector<size_t> tokens(seqs.size());
+    std::iota(tokens.begin(), tokens.end(), size_t(0));
+    std::transform(tokens.begin(), tokens.end(), seqs.begin(), [&](size_t i) { return (llama_seq_id) (i / per_seq); });
+    return seqs;
+}
+
+// four prompts in one batch, then their generation, then a follow-up prompt each
+static void concurrent_prompts() {
+    llama_kv_cells cells;
+    cells.resize(16384);
+    std::vector<llama_pos> next_pos(4, 0);
+
+    const auto prompt = batch_of(4, 512);
+    auto idxs = cells.place_together(prompt, 0, chunk);
+    CHECK(idxs.size() == prompt.size());
+    commit(cells, prompt, idxs, next_pos);
+    std::vector<llama_seq_id> each = { 0, 1, 2, 3 };
+    CHECK(std::all_of(each.begin(), each.end(), [&](llama_seq_id s) { return runs_of(cells, s) == 1; }));
+
+    std::vector<int> steps(128);
+    std::for_each(steps.begin(), steps.end(), [&](int) {
+        const auto placed = cells.place_together(each, 0, chunk);
+        CHECK(placed.size() == each.size());
+        commit(cells, each, placed, next_pos);
+    });
+    // a prompt run, then generation in chunks
+    CHECK(std::all_of(each.begin(), each.end(), [&](llama_seq_id s) { return runs_of(cells, s) <= 1 + 128/chunk + 1; }));
+
+    std::vector<size_t> before(each.size());
+    std::transform(each.begin(), each.end(), before.begin(), [&](llama_seq_id s) { return runs_of(cells, s); });
+    idxs = cells.place_together(prompt, 0, chunk);
+    CHECK(idxs.size() == prompt.size());
+    commit(cells, prompt, idxs, next_pos);
+    // a follow-up adds the rest of the open chunk and one stretch
+    CHECK(std::all_of(each.begin(), each.end(), [&](llama_seq_id s) { return runs_of(cells, s) <= before[s] + 1; }));
+}
+
+// a request that resumes from cells placed above its own keeps one run per chunk of
+// generation, not one per token
+static void resumed_from_higher_cells() {
+    llama_kv_cells cells;
+    cells.resize(16384);
+    std::vector<uint32_t> prefix(4096);
+    std::iota(prefix.begin(), prefix.end(), 8192u);
+    std::for_each(prefix.begin(), prefix.end(), [&](uint32_t i) {
+        cells.pos_set(i, (llama_pos) (i - 8192));
+        cells.seq_add(i, 0);
+        cells.seq_add(i, 1);
+    });
+    // the cell after the prefix belongs to someone else
+    cells.pos_set(8192 + 4096, 0);
+    cells.seq_add(8192 + 4096, 5);
+
+    std::vector<llama_pos> next_pos(8, 4096);
+    const std::vector<llama_seq_id> prompt(512, 1);
+    commit(cells, prompt, cells.place_together(prompt, 0, chunk), next_pos);
+    CHECK(runs_of(cells, 1) == 2);
+
+    std::vector<int> steps(128);
+    std::for_each(steps.begin(), steps.end(), [&](int) {
+        const std::vector<llama_seq_id> one = { 1 };
+        commit(cells, one, cells.place_together(one, 0, chunk), next_pos);
+    });
+    CHECK(runs_of(cells, 1) == 2);
+}
+
+// the smallest stretch that holds the share wins over a larger one
+static void best_fit() {
+    llama_kv_cells cells;
+    cells.resize(4096);
+    std::vector<uint32_t> all(cells.size());
+    std::iota(all.begin(), all.end(), 0u);
+    llama_pos pos = 0;
+    // free: [512, 1024) and [2048, 2560 + 1024)
+    std::for_each(all.begin(), all.end(), [&](uint32_t i) {
+        const bool hole = (i >= 512 && i < 1024) || (i >= 2048 && i < 3584);
+        if (!hole) {
+            cells.pos_set(i, pos++);
+            cells.seq_add(i, 7);
+        }
+    });
+    const std::vector<llama_seq_id> share(512, 1);
+    const auto idxs = cells.place_together(share, 2048, chunk);
+    CHECK(idxs.size() == 512);
+    CHECK(idxs.front() == 512 && idxs.back() == 1023);
+}
+
+// no stretch holds the share: the longest ones are filled first
+static void fragmented_pool() {
+    llama_kv_cells cells;
+    cells.resize(4096);
+    std::vector<uint32_t> all(cells.size());
+    std::iota(all.begin(), all.end(), 0u);
+    llama_pos pos = 0;
+    // every chunk keeps its first 16 cells busy, two chunks are fully free
+    std::for_each(all.begin(), all.end(), [&](uint32_t i) {
+        const bool free_chunk = i / chunk == 10 || i / chunk == 11;
+        if (!free_chunk && i % chunk < 16) {
+            cells.pos_set(i, pos++);
+            cells.seq_add(i, 7);
+        }
+    });
+    std::vector<llama_pos> next_pos(8, 0);
+    const std::vector<llama_seq_id> share(512, 1);
+    const auto idxs = cells.place_together(share, 0, chunk);
+    CHECK(idxs.size() == 512);
+    CHECK(idxs.front() == 10*chunk);
+    commit(cells, share, idxs, next_pos);
+    // 128 free cells together, then 48 at a time
+    CHECK(runs_of(cells, 1) == 1 + (512 - 128 + 47)/48);
+}
+
+static void random_pools() {
+    std::mt19937 rng(11);
+    for (int round = 0; round < 300; ++round) {
+        const uint32_t n_cells = chunk * (4 + rng() % 60);
+        llama_kv_cells cells;
+        cells.resize(n_cells);
+        const int n_seq = 1 + rng() % 4;
+        std::vector<llama_pos> next_pos(n_seq, 0);
+        const uint32_t fill = rng() % n_cells;
+        std::vector<uint32_t> tries(fill);
+        std::for_each(tries.begin(), tries.end(), [&](uint32_t) {
+            const uint32_t cell = rng() % n_cells;
+            if (cells.is_empty(cell)) {
+                const llama_seq_id seq = (llama_seq_id) (rng() % n_seq);
+                cells.pos_set(cell, next_pos[seq]++);
+                cells.seq_add(cell, seq);
+            }
+        });
+        const uint32_t n_free = n_cells - cells.get_used();
+
+        std::vector<llama_seq_id> seqs(1 + rng() % 600);
+        std::generate(seqs.begin(), seqs.end(), [&] { return (llama_seq_id) (rng() % n_seq); });
+        const auto idxs = cells.place_together(seqs, rng() % n_cells, chunk);
+
+        if (seqs.size() > n_free) {
+            CHECK(idxs.empty());
+            continue;
+        }
+        CHECK(idxs.size() == seqs.size());
+        CHECK(std::set<uint32_t>(idxs.begin(), idxs.end()).size() == idxs.size());
+        CHECK(std::all_of(idxs.begin(), idxs.end(), [&](uint32_t i) { return i < n_cells && cells.is_empty(i); }));
+    }
+}
+
+int main() {
+    concurrent_prompts();
+    resumed_from_higher_cells();
+    best_fit();
+    fragmented_pool();
+    random_pools();
+    if (failures == 0) {
+        std::printf("ok\n");
+    }
+    return failures == 0 ? 0 : 1;
+}
