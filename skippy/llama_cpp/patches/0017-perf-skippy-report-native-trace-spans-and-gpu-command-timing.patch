+namespace {
+
+// install once: a replacement racing a completion may pair the new callback with the old data
+std::atomic<ggml_backend_command_timing_callback_t> g_callback { nullptr };
+std::atomic<void *>                                 g_user_data { nullptr };
+
+std::atomic<ggml_backend_trace_span_callback_t> g_span_callback { nullptr };
+std::atomic<void *>                             g_span_user_data { nullptr };
+
+std::atomic<uint32_t> g_next_context_id { 0 };
+
+std::mutex    g_graph_ops_mutex;
+std::set<int> g_graph_ops_reported; // node counts, guarded by g_graph_ops_mutex
+
+thread_local uint64_t g_tag = 0;
+
+// spans that ended before the first span callback arrived: device
+// initialisation compiles the kernel libraries before anyone can listen
+struct pending_span {
+    uint64_t     tag;
+    const char * name;
+    bool         has_detail;
+    std::string  detail;
+    int64_t      start_unix_ns;
+    int64_t      end_unix_ns;
+};
+
+constexpr size_t MAX_PENDING_SPANS = 256;
+
+std::mutex                g_pending_mutex;
+std::vector<pending_span> g_pending;          // guarded by g_pending_mutex
+std::atomic<bool>         g_span_installed { false };
+
+// seconds on the host clock that Metal stamps command buffers with
+double host_now_s() {
+#if defined(__APPLE__)
+    static const double ns_per_tick = [] {
+        mach_timebase_info_data_t info {};
+        mach_timebase_info(&info);
+        return (double) info.numer / (double) info.denom;
+    }();
+    return (double) mach_absolute_time() * ns_per_tick * 1e-9;
+#else
+    timespec ts {};
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double) ts.tv_sec + (double) ts.tv_nsec * 1e-9;
+#endif
+}
+
+int64_t unix_now_ns() {
+    timespec ts {};
+    clock_gettime(CLOCK_REALTIME, &ts);
+    return (int64_t) ts.tv_sec * 1000000000 + (int64_t) ts.tv_nsec;
+}
+
+void deliver_span(ggml_backend_trace_span_callback_t callback, void * user_data, const ggml_backend_trace_span & span) {
+    if (callback != nullptr) {
+        callback(&span, user_data);
+    }
+}
+
+// views and reshapes: no work, so they join the run around them
+constexpr int OP_CLASS_NONE = -1;
+
+bool has_prefix(const char * name, std::string_view prefix) {
+    return std::string_view(name).compare(0, prefix.size(), prefix) == 0;
+}
+
+// the cache a node writes, or reads with a view: its root tensor's name
+const char * cache_name(const ggml_tensor * t) {
+    const ggml_tensor * root = t->view_src != nullptr ? t->view_src : t;
+    return has_prefix(root->name, "cache_") ? root->name : nullptr;
+}
+
+// llama-memory-recurrent names its state cache_r_l<i> and cache_s_l<i>
+bool is_recurrent_cache(const char * name) {
+    return has_prefix(name, "cache_r_l") || has_prefix(name, "cache_s_l");
+}
+
+// the cache class of a node that copies into or gathers from a cache
+int cache_class(const ggml_tensor * node) {
+    const char * name = cache_name(node);
+    if (name == nullptr && node->op == GGML_OP_GET_ROWS && node->src[0] != nullptr) {
+        name = cache_name(node->src[0]);
+        return name != nullptr && is_recurrent_cache(name) ? GGML_BACKEND_OP_CLASS_RECURRENT : GGML_BACKEND_OP_CLASS_OTHER;
+    }
+    if (name == nullptr) {
+        return GGML_BACKEND_OP_CLASS_OTHER;
+    }
+    return is_recurrent_cache(name) ? GGML_BACKEND_OP_CLASS_RECURRENT : GGML_BACKEND_OP_CLASS_KV_WRITE;
+}
+
+// the K/Q and K/Q/V products of llama-graph's unfused attention ("kq-<il>",
+// "kqv-<il>") and its output ("kqv_out-<il>")
+bool is_named_attention(const ggml_tensor * node) {
+    return has_prefix(node->name, "kq-") || has_prefix(node->name, "kqv-") ||
+        has_prefix(node->name, "kq_") || has_prefix(node->name, "kqv_");
+}
+
+int op_class(const ggml_tensor * node) {
+    switch (node->op) {
+        case GGML_OP_NONE:
+        case GGML_OP_RESHAPE:
+        case GGML_OP_VIEW:
+        case GGML_OP_PERMUTE:
+        case GGML_OP_TRANSPOSE:
+            return OP_CLASS_NONE;
+        case GGML_OP_FLASH_ATTN_EXT:
+            return GGML_BACKEND_OP_CLASS_ATTENTION;
+        case GGML_OP_SSM_CONV:
+        case GGML_OP_SSM_SCAN:
+        case GGML_OP_RWKV_WKV6:
+        case GGML_OP_RWKV_WKV7:
+        case GGML_OP_GATED_LINEAR_ATTN:
+        case GGML_OP_GATED_DELTA_NET:
+            return GGML_BACKEND_OP_CLASS_RECURRENT;
+        case GGML_OP_SOFT_MAX:
+            // a masked soft max is unfused attention; MoE routing has no mask
+            return node->src[1] != nullptr || is_named_attention(node) ?
+                GGML_BACKEND_OP_CLASS_ATTENTION : GGML_BACKEND_OP_CLASS_OTHER;
+        case GGML_OP_MUL_MAT:
+        case GGML_OP_MUL_MAT_ID:
+            return is_named_attention(node) ? GGML_BACKEND_OP_CLASS_ATTENTION : GGML_BACKEND_OP_CLASS_MATMUL;
+        case GGML_OP_SET_ROWS:
+        case GGML_OP_CPY:
+        case GGML_OP_GET_ROWS:
+            return cache_class(node);
+        default:
+            return is_named_attention(node) ? GGML_BACKEND_OP_CLASS_ATTENTION : GGML_BACKEND_OP_CLASS_OTHER;
+    }
+}
+
+uint64_t input_bytes(const ggml_tensor * node) {
+    return std::accumulate(std::begin(node->src), std::end(node->src), uint64_t { 0 },
+            [](uint64_t sum, const ggml_tensor * src) { return src != nullptr ? sum + ggml_nbytes(src) : sum; });
+}
+
+uint64_t bytes_of(const ggml_tensor * t) {
+    return t != nullptr ? ggml_nbytes(t) : 0;
+}
+
+// a gather reads only its rows, and a row write writes only its rows, of the
+// tensor they index: get_rows(a, ids) has a as src[0], set_rows(a, b, ids) as src[2]
+uint64_t bytes_read(const ggml_tensor * node) {
+    switch (node->op) {
+        case GGML_OP_GET_ROWS:
+            return ggml_nbytes(node) + bytes_of(node->src[1]);
+        case GGML_OP_SET_ROWS:
+            return input_bytes(node) - bytes_of(node->src[2]);
+        default:
+            return input_bytes(node);
+    }
+}
+
+bool in_recurrent_cache(const ggml_tensor * t) {
+    const char * name = t != nullptr ? cache_name(t) : nullptr;
+    return name != nullptr && is_recurrent_cache(name);
+}
+
+struct state_rows {
+    uint32_t gathered;
+    uint32_t carried;
+};
+
+// llama-graph's build_rs gathers the states from the batch's first state cell
+// to its last, then copies the gathered states no sequence of the batch owns
+// back unchanged
+state_rows state_rows_of(const ggml_tensor * node) {
+    if (node->op == GGML_OP_GET_ROWS && in_recurrent_cache(node->src[0]) && node->src[1] != nullptr) {
+        return { (uint32_t) ggml_nelements(node->src[1]), 0 };
+    }
+    if (node->op != GGML_OP_CPY || node->src[0] == nullptr || !in_recurrent_cache(node->src[1])) {
+        return { 0, 0 };
+    }
+    const ggml_tensor * gathered = node->src[0]->view_src;
+    const bool unchanged = gathered != nullptr && gathered->op == GGML_OP_GET_ROWS && in_recurrent_cache(gathered->src[0]);
+    return { 0, unchanged ? (uint32_t) ggml_nrows(node->src[0]) : 0 };
+}
+
+// ggml_flash_attn_ext_rows passes its I32 row lists [padded_rows, slices] as src[5]
+const ggml_tensor * attention_rows(const ggml_tensor * node) {
+    return node->op == GGML_OP_FLASH_ATTN_EXT ? node->src[5] : nullptr;
+}
+
+struct attention_shape {
+    uint32_t kv_cells;
+    uint32_t queries;
+    bool     row_lists;
+    bool     flash;
+    uint64_t bytes;
+};
+
+// unfused attention's K/Q product, kq = mul_mat(k, q): k is
+// [head_dim, n_kv, n_head_kv, ...], q is [head_dim, n_tokens, n_head, ...]
+attention_shape unfused_shape_of(const ggml_tensor * node) {
+    const ggml_tensor * k = node->src[0];
+    const ggml_tensor * q = node->src[1];
+    if (k == nullptr || q == nullptr) {
+        return { 0, 0, false, false, input_bytes(node) };
+    }
+    return { (uint32_t) k->ne[1], (uint32_t) (q->ne[1] * q->ne[3]), false, false, input_bytes(node) };
+}
+
+// what one attention node addresses: with row lists only the listed K/V
+// rows of the shared pool, otherwise the whole K/V span it was given
+attention_shape attention_shape_of(const ggml_tensor * node) {
+    if (node->op == GGML_OP_MUL_MAT && has_prefix(node->name, "kq-")) {
+        return unfused_shape_of(node);
+    }
+    const ggml_tensor * q    = node->src[0];
+    const ggml_tensor * k    = node->src[1];
+    const ggml_tensor * v    = node->src[2];
+    const ggml_tensor * rows = attention_rows(node);
+    if (node->op != GGML_OP_FLASH_ATTN_EXT || q == nullptr || k == nullptr || v == nullptr) {
+        return { 0, 0, false, false, input_bytes(node) };
+    }
+    const uint32_t queries = (uint32_t) (q->ne[1] * q->ne[3]);
+    if (rows == nullptr) {
+        return { (uint32_t) k->ne[1], queries, false, true, input_bytes(node) };
+    }
+    const uint64_t row_bytes =
+        ggml_row_size(k->type, k->ne[0]) * (uint64_t) k->ne[2] +
+        ggml_row_size(v->type, v->ne[0]) * (uint64_t) v->ne[2];
+    const uint64_t listed = (uint64_t) rows->ne[0] * (uint64_t) rows->ne[1];
+    const uint64_t other  = input_bytes(node) - ggml_nbytes(k) - ggml_nbytes(v);
+    return { (uint32_t) rows->ne[0], queries, true, true, other + listed * row_bytes };
+}
+
+// llama-graph names a layer's tensors "<name>-<il>"
+int32_t layer_of(const ggml_tensor * node) {
+    const std::string_view name(node->name);
+    const size_t dash = name.rfind('-');
+    if (dash == std::string_view::npos || dash + 1 == name.size()) {
+        return -1;
+    }
+    const std::string_view digits = name.substr(dash + 1);
+    if (!std::all_of(digits.begin(), digits.end(), [](char c) { return c >= '0' && c <= '9'; })) {
+        return -1;
+    }
+    return (int32_t) std::strtol(std::string(digits).c_str(), nullptr, 10);
+}
+
+} // namespace
+
+struct ggml_metal_timing_record {
+    ggml_backend_command_timing timing {};
+
+    // the encoding thread's own tag, restored once it has encoded this buffer
+    uint64_t saved_tag = 0;
+
+    // written by the encoding thread, read on Metal's completion thread
+    std::atomic<double> encode_start_host_s { 0.0 };
+    std::atomic<double> encode_end_host_s   { 0.0 };
+};
+
+uint32_t ggml_metal_timing_next_context_id(void) {
+    return g_next_context_id.fetch_add(1, std::memory_order_relaxed) + 1;
+}
+
+ggml_metal_timing_record_t ggml_metal_timing_begin(
+        uint32_t context_id,
+        uint32_t compute_index,
+        uint32_t command_index,
+        uint32_t command_count,
+        uint32_t node_count) {
+    if (g_callback.load(std::memory_order_acquire) == nullptr &&
+            g_span_callback.load(std::memory_order_acquire) == nullptr) {
+        return nullptr;
+    }
+
+    auto * record = new (std::nothrow) ggml_metal_timing_record {};
+    if (record == nullptr) {
+        return nullptr;
+    }
+
+    record->timing.tag           = g_tag;
+    record->timing.context_id    = context_id;
+    record->timing.compute_index = compute_index;
+    record->timing.command_index = command_index;
+    record->timing.command_count = command_count;
+    record->timing.node_count    = node_count;
+    record->timing.op_class      = GGML_BACKEND_OP_CLASS_COUNT;
+    record->timing.layer         = -1;
+
+    return record;
+}
+
+void ggml_metal_timing_account(
+        ggml_metal_timing_record_t record,
+        struct ggml_cgraph * gf,
+        int start,
+        int end,
+        bool split_by_class) {
+    if (record == nullptr || gf == nullptr || start >= end) {
+        return;
+    }
+    ggml_backend_command_timing & timing = record->timing;
+    timing.split_by_class = split_by_class ? 1 : 0;
+
+    ggml_tensor ** first = gf->nodes + start;
+    ggml_tensor ** last  = gf->nodes + std::min(end, gf->n_nodes);
+
+    std::for_each(first, last, [&timing](const ggml_tensor * node) {
+        const int cls = op_class(node);
+        if (cls == OP_CLASS_NONE) {
+            return;
+        }
+        if (timing.layer < 0) {
+            timing.layer = layer_of(node);
+        }
+        timing.class_nodes[cls] += 1;
+        const state_rows states = state_rows_of(node);
+        timing.recurrent_states         = std::max(timing.recurrent_states, states.gathered);
+        timing.recurrent_states_carried = std::max(timing.recurrent_states_carried, states.carried);
+        if (cls != GGML_BACKEND_OP_CLASS_ATTENTION) {
+            timing.class_bytes[cls] += bytes_read(node);
+            return;
+        }
+        const attention_shape shape = attention_shape_of(node);
+        timing.class_bytes[cls] += shape.bytes;
+        timing.attention_kv_cells = std::max(timing.attention_kv_cells, shape.kv_cells);
+        timing.attention_queries  = std::max(timing.attention_queries, shape.queries);
+        timing.attention_row_list_nodes += shape.row_lists ? 1 : 0;
+        timing.attention_flash_nodes    += shape.flash ? 1 : 0;
+    });
+
+    const uint32_t * counts_begin = std::cbegin(timing.class_nodes);
+    const uint32_t * counts_end   = std::cend(timing.class_nodes);
+    const auto       nonzero      = [](uint32_t n) { return n > 0; };
+    const auto classes_used = std::count_if(counts_begin, counts_end, nonzero);
+    if (classes_used == 0) {
+        timing.op_class = GGML_BACKEND_OP_CLASS_OTHER;
+    } else if (classes_used == 1) {
+        timing.op_class = (int32_t) std::distance(counts_begin, std::find_if(counts_begin, counts_end, nonzero));
+    }
+}
+
+int ggml_metal_timing_class_run_end(struct ggml_cgraph * gf, int start) {
+    ggml_tensor ** first = gf->nodes + start;
+    ggml_tensor ** last  = gf->nodes + gf->n_nodes;
+
+    const auto classified = [](const ggml_tensor * node) { return op_class(node) != OP_CLASS_NONE; };
+    ggml_tensor ** lead = std::find_if(first, last, classified);
+    if (lead == last) {
+        return gf->n_nodes;
+    }
+    const int cls = op_class(*lead);
+    ggml_tensor ** next = std::find_if(lead + 1, last, [cls](const ggml_tensor * node) {
+        const int other = op_class(node);
+        return other != OP_CLASS_NONE && other != cls;
+    });
+    return (int) std::distance(gf->nodes, next);
+}
+
+bool ggml_metal_timing_op_profile(void) {
+    static const bool requested = [] {
+        const char * value = std::getenv("GGML_METAL_OP_PROFILE");
+        return value != nullptr && value[0] != '\0' && std::string_view(value) != "0";
+    }();
+    return requested && g_callback.load(std::memory_order_acquire) != nullptr;
+}
+
+void ggml_metal_timing_encode_start(ggml_metal_timing_record_t record) {
+    if (record != nullptr) {
+        record->saved_tag = g_tag;
+        g_tag = record->timing.tag;
+        record->encode_start_host_s.store(host_now_s(), std::memory_order_release);
+    }
+}
+
+void ggml_metal_timing_encode_end(ggml_metal_timing_record_t record) {
+    if (record != nullptr) {
+        record->encode_end_host_s.store(host_now_s(), std::memory_order_release);
+        g_tag = record->saved_tag;
+    }
+}
+
+void ggml_metal_timing_finish(
+        ggml_metal_timing_record_t record,
+        double execute_start_host_s,
+        double execute_end_host_s,
+        int32_t status) {
+    const std::unique_ptr<ggml_metal_timing_record> owned(record);
+    if (!owned) {
+        return;
+    }
+
+    const auto callback = g_callback.load(std::memory_order_acquire);
+    if (callback == nullptr) {
+        return;
+    }
+    void * user_data = g_user_data.load(std::memory_order_acquire);
+
+    // one paired reading converts every host time on this record
+    const double  host_now = host_now_s();
+    const int64_t unix_now = unix_now_ns();
+    const auto to_unix_ns = [&](double host_s) -> int64_t {
+        return host_s > 0.0 ? unix_now - (int64_t) ((host_now - host_s) * 1e9) : 0;
+    };
+
+    ggml_backend_command_timing timing = owned->timing;
+    timing.status                = status;
+    timing.encode_start_unix_ns  = to_unix_ns(owned->encode_start_host_s.load(std::memory_order_acquire));
+    timing.encode_end_unix_ns    = to_unix_ns(owned->encode_end_host_s.load(std::memory_order_acquire));
+    timing.execute_start_unix_ns = to_unix_ns(execute_start_host_s);
+    timing.execute_end_unix_ns   = to_unix_ns(execute_end_host_s);
+
+    callback(&timing, user_data);
+}
+
+int64_t ggml_metal_timing_span_start(void) {
+    if (g_span_callback.load(std::memory_order_acquire) == nullptr &&
+            g_span_installed.load(std::memory_order_acquire)) {
+        return 0;
+    }
+    return unix_now_ns();
+}
+
+void ggml_metal_timing_span_end(const char * name, const char * detail, int64_t start_unix_ns) {
+    if (start_unix_ns == 0 || name == nullptr) {
+        return;
+    }
+    const ggml_backend_trace_span span = { g_tag, name, detail, start_unix_ns, unix_now_ns() };
+
+    if (g_span_installed.load(std::memory_order_acquire)) {
+        deliver_span(g_span_callback.load(std::memory_order_acquire),
+                g_span_user_data.load(std::memory_order_acquire), span);
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(g_pending_mutex);
+        if (!g_span_installed.load(std::memory_order_acquire)) {
+            if (g_pending.size() < MAX_PENDING_SPANS) {
+                g_pending.push_back({ span.tag, name, detail != nullptr, detail != nullptr ? detail : "",
+                        span.start_unix_ns, span.end_unix_ns });
+            }
+            return;
+        }
+    }
+    // the first callback arrived while this span was ending
+    deliver_span(g_span_callback.load(std::memory_order_acquire),
+            g_span_user_data.load(std::memory_order_acquire), span);
+}
+
+void ggml_metal_timing_set_callback(ggml_backend_command_timing_callback_t callback, void * user_data) {
+    if (callback == nullptr) {
+        g_callback.store(nullptr, std::memory_order_release);
+        return;
+    }
+    g_user_data.store(user_data, std::memory_order_relaxed);
+    g_callback.store(callback, std::memory_order_release);
+}
+
+void ggml_metal_timing_graph_ops(struct ggml_cgraph * gf) {
+    if (gf == nullptr || g_callback.load(std::memory_order_acquire) == nullptr) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lock(g_graph_ops_mutex);
+        if (!g_graph_ops_reported.insert(gf->n_nodes).second) {
+            return;
+        }
+    }
+    const int64_t start = ggml_metal_timing_span_start();
+
+    std::map<std::string_view, int> counts;
+    std::for_each(gf->nodes, gf->nodes + gf->n_nodes, [&counts](const ggml_tensor * node) {
+        ++counts[ggml_op_desc(node)];
+    });
+    const std::string detail = std::accumulate(counts.begin(), counts.end(), "nodes=" + std::to_string(gf->n_nodes),
+        [](std::string text, const auto & op) {
+            return std::move(text) + ' ' + std::string(op.first) + ':' + std::to_string(op.second);
+        });
+
+    ggml_metal_timing_span_end("mtl.graph_ops", detail.c_str(), start);
+}
+
+void ggml_metal_timing_set_tag(uint64_t tag) {
+    g_tag = tag;
+}
+
+void ggml_metal_timing_set_span_callback(ggml_backend_trace_span_callback_t callback, void * user_data) {
+    if (callback == nullptr) {
+        g_span_callback.store(nullptr, std::memory_order_release);
+        return;
+    }
+
+    std::vector<pending_span> pending;
+    {
+        std::lock_guard<std::mutex> lock(g_pending_mutex);
+        g_span_user_data.store(user_data, std::memory_order_relaxed);
+        g_span_callback.store(callback, std::memory_order_release);
+        g_span_installed.store(true, std::memory_order_release);
+        pending.swap(g_pending);
+    }
+
+    // kept spans reach the first callback in the order they ended
+    for (const auto & kept : pending) {
+        const ggml_backend_trace_span span = {
+            kept.tag, kept.name, kept.has_detail ? kept.detail.c_str() : nullptr,
+            kept.start_unix_ns, kept.end_unix_ns,
+        };
+        deliver_span(callback, user_data, span);
+    }
+}
diff --git a/ggml/src/ggml-metal/ggml-metal-timing.h b/ggml/src/ggml-metal/ggml-metal-timing.h
new file mode 100644
index 000000000..3cbe29099
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-timing.h
@@ -0,0 +1,102 @@
+// tracing for ggml-metal:
+//  - command timing: one record per command buffer, reported through
+//    ggml_backend_set_command_timing_callback once the GPU has finished it
+//  - trace spans: host-side work such as library and pipeline compilation,
+//    reported through ggml_backend_set_trace_span_callback
+
+#pragma once
+
+#include "ggml-backend.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct ggml_metal_timing_record * ggml_metal_timing_record_t;
+
+// a process-unique id for a new Metal context
+uint32_t ggml_metal_timing_next_context_id(void);
+
+// NULL unless a command timing or trace span callback is installed;
+// captures the calling thread's tag
+ggml_metal_timing_record_t ggml_metal_timing_begin(
+        uint32_t context_id,
+        uint32_t compute_index,
+        uint32_t command_index,
+        uint32_t command_count,
+        uint32_t node_count);
+
+// accept NULL records; between the two, the encoding thread carries the
+// record's tag, so spans it reports (a pipeline compiled on first use) land
+// under the call that submitted the graph even on a dispatch worker
+void ggml_metal_timing_encode_start(ggml_metal_timing_record_t record);
+void ggml_metal_timing_encode_end  (ggml_metal_timing_record_t record);
+
+// classifies the graph nodes [start, end) the record's command encodes (see
+// ggml_backend_op_class); `split_by_class` marks a command of a graph split
+// at class boundaries; accepts a NULL record
+void ggml_metal_timing_account(
+        ggml_metal_timing_record_t record,
+        struct ggml_cgraph * gf,
+        int start,
+        int end,
+        bool split_by_class);
+
+// the end of the run of nodes from `start` that share one class; views and
+// reshapes join the run they sit in
+int ggml_metal_timing_class_run_end(struct ggml_cgraph * gf, int start);
+
+// the first compute of a graph with this many nodes reports an "mtl.graph_ops"
+// span whose detail counts its nodes by op ("nodes=N ADD:12 CPY:4 ..."), while
+// a command timing callback is installed
+void ggml_metal_timing_graph_ops(struct ggml_cgraph * gf);
+
+// whether to split each graph at class boundaries, one command buffer per
+// run, so the GPU times every class by itself: GGML_METAL_OP_PROFILE=1 with
+// a command timing callback installed
+bool ggml_metal_timing_op_profile(void);
+
+// reports and frees the record; times are MTLCommandBuffer GPUStartTime/GPUEndTime
+void ggml_metal_timing_finish(
+        ggml_metal_timing_record_t record,
+        double execute_start_host_s,
+        double execute_end_host_s,
+        int32_t status);
+
+// the start of a trace span, in Unix nanoseconds; 0 when nothing would
+// record it (a callback was installed once and has since been cleared)
+int64_t ggml_metal_timing_span_start(void);
+
+// report a span begun by ggml_metal_timing_span_start; `name` must have
+// static storage, `detail` may be NULL and is copied when the span is kept
+// for later delivery; ignores a zero start
+void ggml_metal_timing_span_end(const char * name, const char * detail, int64_t start_unix_ns);
+
+// a trace span from here to the end of the enclosing scope, for C and
+// Objective-C callers with several exits; `detail` must outlive the scope
+struct ggml_metal_timing_span_scope {
+    const char * name;
+    const char * detail;
+    int64_t      start_unix_ns;
+};
+
+static inline void ggml_metal_timing_span_scope_end(struct ggml_metal_timing_span_scope * scope) {
+    ggml_metal_timing_span_end(scope->name, scope->detail, scope->start_unix_ns);
+}
+
+#define GGML_METAL_TIMING_SPAN(var, name, detail) \
+    __attribute__((cleanup(ggml_metal_timing_span_scope_end), unused)) \
+    struct ggml_metal_timing_span_scope var = { (name), (detail), ggml_metal_timing_span_start() }
+
+// the ggml_backend_set_command_timing_callback, _tag and
+// ggml_backend_set_trace_span_callback procs
+void ggml_metal_timing_set_callback(ggml_backend_command_timing_callback_t callback, void * user_data);
+void ggml_metal_timing_set_tag(uint64_t tag);
+void ggml_metal_timing_set_span_callback(ggml_backend_trace_span_callback_t callback, void * user_data);
+
+#ifdef __cplusplus
+}
+#endif
