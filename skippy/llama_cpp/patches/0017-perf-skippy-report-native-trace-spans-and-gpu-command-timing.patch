diff --git a/ggml/include/ggml-backend.h b/ggml/include/ggml-backend.h
index fbc940129..65b031822 100644
--- a/ggml/include/ggml-backend.h
+++ b/ggml/include/ggml-backend.h
@@ -253,6 +253,111 @@ extern "C" {
             char * error,
             size_t error_capacity);
 
+    // Command timing, exposed by a backend registry as the procs
+    // "ggml_backend_set_command_timing_callback" and
+    // "ggml_backend_set_command_timing_tag". A backend reports one record per
+    // unit of submitted device work (a Metal command buffer) once the device
+    // has finished it. Times are Unix nanoseconds; 0 when unknown.
+    // What a command's graph nodes do. Views and reshapes do no work and
+    // belong to no class.
+    enum ggml_backend_op_class {
+        GGML_BACKEND_OP_CLASS_OTHER,
+        // attention over the KV cache: flash attention, or the masked soft
+        // max and the K/Q and K/Q/V products the graph names "kq" and "kqv"
+        GGML_BACKEND_OP_CLASS_ATTENTION,
+        // matrix products with weights
+        GGML_BACKEND_OP_CLASS_MATMUL,
+        // recurrent and linear-attention state: SSM, RWKV, gated linear
+        // attention and delta-net updates, and copies to or from their cache
+        GGML_BACKEND_OP_CLASS_RECURRENT,
+        // writes into the attention KV cache
+        GGML_BACKEND_OP_CLASS_KV_WRITE,
+        GGML_BACKEND_OP_CLASS_COUNT,
+    };
+
+    struct ggml_backend_command_timing {
+        // the submitting thread's tag when the graph was submitted
+        uint64_t tag;
+        // backend instance, and its 1-based graph compute count
+        uint32_t context_id;
+        uint32_t compute_index;
+        // execution order of this command within the graph compute
+        uint32_t command_index;
+        uint32_t command_count;
+        uint32_t node_count;
+        // 0 when the device completed the command
+        int32_t  status;
+        int64_t  encode_start_unix_ns;
+        int64_t  encode_end_unix_ns;
+        int64_t  execute_start_unix_ns;
+        int64_t  execute_end_unix_ns;
+        // The class every classified node of the command belongs to, or
+        // GGML_BACKEND_OP_CLASS_COUNT when it mixes classes. A backend that
+        // splits a graph at class boundaries (op profiling) sets one class
+        // per command and `split_by_class`.
+        int32_t  op_class;
+        // the model layer of the command's first layer-named node, -1 if none
+        int32_t  layer;
+        uint32_t split_by_class;
+        // attention nodes: the most KV cells one query addresses (the row
+        // list length when attention reads per-sequence row lists, else the
+        // K/V span; for unfused attention the K/Q product's K span), the
+        // most query rows one node processes, how many nodes read row lists,
+        // and how many are flash attention (the rest are unfused)
+        uint32_t attention_kv_cells;
+        uint32_t attention_queries;
+        uint32_t attention_row_list_nodes;
+        uint32_t attention_flash_nodes;
+        // per class: nodes, and the bytes they read; a gather counts the rows
+        // it reads and a row write the rows it writes, not the tensor they
+        // index, and attention counts only the K/V rows a node addresses
+        uint32_t class_nodes[GGML_BACKEND_OP_CLASS_COUNT];
+        uint64_t class_bytes[GGML_BACKEND_OP_CLASS_COUNT];
+        // recurrent state caches: the most states one gather reads (the
+        // states of the batch's sequences and every state between them), and
+        // the most of those a copy writes back unchanged
+        uint32_t recurrent_states;
+        uint32_t recurrent_states_carried;
+    };
+
+    // Called on a backend-owned thread; keep it short.
+    typedef void (*ggml_backend_command_timing_callback_t)(
+            const struct ggml_backend_command_timing * timing,
+            void * user_data);
+    // A null callback stops reporting.
+    typedef void (*ggml_backend_set_command_timing_callback_t)(
+            ggml_backend_command_timing_callback_t callback,
+            void * user_data);
+    // Thread-local: graphs this thread submits afterwards carry `tag`, and so
+    // do the backend's trace spans on this thread.
+    typedef void (*ggml_backend_set_command_timing_tag_t)(uint64_t tag);
+
+    // Trace spans, exposed by a backend registry as the proc
+    // "ggml_backend_set_trace_span_callback": host-side backend work worth a
+    // timeline entry, such as compiling a kernel library or pipeline. A
+    // backend reports each span when it ends, on the thread that did the
+    // work. Spans that end before any callback was ever installed (device
+    // initialisation can run first) are kept, a bounded number of them, and
+    // delivered on the installing thread when the first callback arrives.
+    struct ggml_backend_trace_span {
+        // the reporting thread's tag (see the command timing tag); 0 when none
+        uint64_t     tag;
+        // static storage, such as "mtl.pipeline_compile"
+        const char * name;
+        // NULL, or what the span worked on; valid only during the callback
+        const char * detail;
+        int64_t      start_unix_ns;
+        int64_t      end_unix_ns;
+    };
+
+    typedef void (*ggml_backend_trace_span_callback_t)(
+            const struct ggml_backend_trace_span * span,
+            void * user_data);
+    // A null callback stops reporting.
+    typedef void (*ggml_backend_set_trace_span_callback_t)(
+            ggml_backend_trace_span_callback_t callback,
+            void * user_data);
+
     //
     // Backend registry
     //
