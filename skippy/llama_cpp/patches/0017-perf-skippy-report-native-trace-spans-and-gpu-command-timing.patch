diff --git a/include/skippy/tracing.h b/include/skippy/tracing.h
new file mode 100644
index 000000000..e9e57357c
--- /dev/null
+++ b/include/skippy/tracing.h
@@ -0,0 +1,197 @@
+#ifndef SKIPPY_TRACING_H
+#define SKIPPY_TRACING_H
+
+/**
+ * @file skippy/tracing.h
+ * @brief Where time goes inside native calls: native spans and GPU command timing.
+ *
+ * Requires SKIPPY_FEATURE_NATIVE_TRACING. Two callbacks report what a native
+ * call did, for a caller that already times the call itself. Native spans
+ * name the phases of host work (preparing a batch, building and allocating
+ * the llama graph, encoding it, waiting for the device, extracting outputs,
+ * sampling, and in a backend that reports them, compiling kernel libraries
+ * and pipelines); each arrives when it ends, on the thread that did the work.
+ * GPU command timing reports each unit of device work (Metal: a command
+ * buffer) once the device has finished it, on a backend completion thread.
+ * Both carry the tag the calling thread set with skippy_set_trace_tag, so a
+ * caller that sets a fresh tag before each native call can place everything
+ * the call caused under it, though spans and device records arrive later.
+ */
+
+#include "common.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define SKIPPY_NATIVE_SPAN_V1_ABI_VERSION 1
+
+/**
+ * @brief Set in every native span id, so ids never collide with caller tags
+ * that leave the top bit clear.
+ */
+#define SKIPPY_NATIVE_SPAN_ID_BIT (UINT64_C(1) << 63)
+
+/** @brief One finished phase of native work. */
+struct skippy_native_span_v1 {
+    uint32_t abi_version;
+    uint32_t struct_size;
+    /** Process-unique and nonzero; SKIPPY_NATIVE_SPAN_ID_BIT is set. */
+    uint64_t id;
+    /**
+     * The enclosing native span's id when there is one, else the reporting
+     * thread's trace tag, else 0. Children end, and so arrive, before their
+     * parent.
+     */
+    uint64_t parent;
+    /** Dotted span name such as "llama.graph_compute"; static storage. */
+    const char * name;
+    /** Null, or what the span worked on; valid only during the callback. */
+    const char * detail;
+    /** Unix nanoseconds. */
+    int64_t start_unix_ns;
+    int64_t end_unix_ns;
+    /** Null, or the name of one measured quantity; static storage. */
+    const char * value_name;
+    int64_t value;
+};
+
+/**
+ * @brief Receives one native span, on the thread that did the work.
+ *
+ * That is usually the thread inside the native call, so a slow callback
+ * slows the call it measures. The span is valid only for the call.
+ */
+typedef void (*skippy_native_span_callback)(
+        const struct skippy_native_span_v1 * span,
+        void * user_data);
+
+/**
+ * @brief Installs the process-global native span callback.
+ *
+ * Install once, before the calls to observe; a null callback stops
+ * reporting. A callback already running may finish after it is cleared.
+ * Installing reaches every loaded backend, which may initialise the backend
+ * registry on the calling thread. Backend spans that ended before a backend
+ * received its first callback (device initialisation compiles kernel
+ * libraries) are delivered from within this call: those that began during
+ * it under the calling thread's tag, earlier ones with no parent.
+ */
+LLAMA_API enum skippy_status skippy_set_native_span_callback(
+        skippy_native_span_callback callback,
+        void * user_data);
+
+#define SKIPPY_GPU_COMMAND_TIMING_V1_ABI_VERSION 1
+
+/** @brief Timing of one unit of device work, such as a Metal command buffer. */
+struct skippy_gpu_command_timing_v1 {
+    uint32_t abi_version;
+    uint32_t struct_size;
+    /** The submitting thread's trace tag; 0 when none was set. */
+    uint64_t tag;
+    /** The ggml backend registry name, such as "MTL"; static storage. */
+    const char * backend_name;
+    /** Backend instance, and its 1-based graph compute count. */
+    uint32_t context_id;
+    uint32_t compute_index;
+    /** Execution order of this command within its graph compute. */
+    uint32_t command_index;
+    uint32_t command_count;
+    /** Graph nodes encoded into this command. */
+    uint32_t node_count;
+    /** 0 when the device completed the command, else a backend status. */
+    int32_t status;
+    /** Unix nanoseconds; 0 when the backend did not observe the instant. */
+    int64_t encode_start_unix_ns;
+    int64_t encode_end_unix_ns;
+    int64_t execute_start_unix_ns;
+    int64_t execute_end_unix_ns;
+    /**
+     * What the command's graph nodes do: "attention", "matmul", "recurrent",
+     * "kv_write" or "other" when every classified node shares that class,
+     * else "mixed"; static storage. Views and reshapes have no class.
+     * Attention is flash attention, or the masked soft max and K/Q, K/Q/V
+     * products of unfused attention; recurrent is SSM, RWKV, gated linear
+     * attention and delta-net state, and copies to or from its cache.
+     */
+    const char * op_class;
+    /** The model layer of the command's first layer-named node; -1 when unknown. */
+    int32_t layer;
+    /**
+     * 1 when the backend split this graph at op class boundaries so each
+     * command holds one class (Metal: GGML_METAL_OP_PROFILE=1), else 0.
+     */
+    uint32_t split_by_class;
+    /**
+     * Attention nodes: the most KV cells one query addresses (the row list
+     * length for attention that reads per-sequence row lists, else the K/V
+     * span; for unfused attention, the K/Q product's K span), the most query
+     * rows one node processes, how many nodes read row lists, and how many
+     * are flash attention (unfused attention has none).
+     */
+    uint32_t attention_kv_cells;
+    uint32_t attention_queries;
+    uint32_t attention_row_list_nodes;
+    uint32_t attention_flash_nodes;
+    /** Graph nodes by class. */
+    uint32_t attention_nodes;
+    uint32_t matmul_nodes;
+    uint32_t recurrent_nodes;
+    uint32_t kv_write_nodes;
+    uint32_t other_nodes;
+    /**
+     * Bytes the nodes read, by class: weights and activations for mat-muls;
+     * for gathers from and row writes into a cache, only the rows read or
+     * written; for attention only the K/V rows its nodes address.
+     */
+    uint64_t attention_bytes;
+    uint64_t matmul_bytes;
+    uint64_t recurrent_bytes;
+    uint64_t kv_write_bytes;
+    uint64_t other_bytes;
+    /**
+     * Recurrent state caches: the most states one gather reads (the states
+     * of the batch's sequences and every state between them), and the most
+     * of those a copy writes back unchanged because no sequence in the batch
+     * owns them.
+     */
+    uint32_t recurrent_states;
+    uint32_t recurrent_states_carried;
+};
+
+/**
+ * @brief Receives one timing record, on a backend-owned completion thread.
+ *
+ * The record is valid only for the duration of the call. Return quickly:
+ * the thread may be serving completion for every command on the device.
+ */
+typedef void (*skippy_gpu_command_timing_callback)(
+        const struct skippy_gpu_command_timing_v1 * timing,
+        void * user_data);
+
+/**
+ * @brief Installs the process-global GPU command timing callback.
+ *
+ * Install once, before submitting work; a null callback stops reporting. A
+ * callback already running may finish after it is cleared. Returns
+ * SKIPPY_STATUS_UNSUPPORTED when no loaded backend reports command timing.
+ */
+LLAMA_API enum skippy_status skippy_set_gpu_command_timing_callback(
+        skippy_gpu_command_timing_callback callback,
+        void * user_data);
+
+/**
+ * @brief Sets the calling thread's trace tag for the work it does afterwards.
+ *
+ * Native spans without an enclosing native span, and GPU work the thread
+ * submits, carry the tag. Thread-local and cheap; pass 0 to stop tagging.
+ * Tags should leave SKIPPY_NATIVE_SPAN_ID_BIT clear. Backends see the tag
+ * once either callback has been installed.
+ */
+LLAMA_API void skippy_set_trace_tag(uint64_t tag);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // SKIPPY_TRACING_H
