diff --git a/tests/test-skippy-tracing-metal.cpp b/tests/test-skippy-tracing-metal.cpp
new file mode 100644
index 000000000..365052e0e
--- /dev/null
+++ b/tests/test-skippy-tracing-metal.cpp
@@ -0,0 +1,155 @@
+// skippy native tracing on the real Metal backend: library initialisation
+// that ran before the install is still reported, and a tagged graph compute
+// reports the pipelines it compiled and the command buffers that ran, in
+// order, on the GPU
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-metal.h"
+#include "ggml.h"
+#include "skippy/common.h"
+#include "skippy/tracing.h"
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#define CHECK(cond)                                                     \
+    do {                                                                \
+        if (!(cond)) {                                                  \
+            std::fprintf(stderr, "%s:%d: CHECK(%s)\n", __FILE__, __LINE__, #cond); \
+            return 1;                                                   \
+        }                                                               \
+    } while (0)
+
+namespace {
+
+constexpr uint64_t TAG = 0x5eed;
+
+struct received_span {
+    std::string name;
+    std::string detail;
+    uint64_t    parent;
+    int64_t     start_unix_ns;
+    int64_t     end_unix_ns;
+};
+
+// timings arrive on Metal's completion thread, spans on encoding threads
+std::mutex                                g_mutex;
+std::vector<skippy_gpu_command_timing_v1> g_received;
+std::vector<received_span>                g_spans;
+
+void receive(const skippy_gpu_command_timing_v1 * timing, void *) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_received.push_back(*timing);
+}
+
+void receive_span(const skippy_native_span_v1 * span, void *) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    g_spans.push_back({ span->name, span->detail != nullptr ? span->detail : "", span->parent,
+            span->start_unix_ns, span->end_unix_ns });
+}
+
+size_t received_count() {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    return g_received.size();
+}
+
+bool has_span(const char * name, uint64_t parent) {
+    std::lock_guard<std::mutex> lock(g_mutex);
+    for (const auto & span : g_spans) {
+        if (span.name == name && span.parent == parent && span.start_unix_ns <= span.end_unix_ns) {
+            return true;
+        }
+    }
+    return false;
+}
+
+} // namespace
+
+int main() {
+    ggml_backend_t backend = ggml_backend_metal_init();
+    if (backend == nullptr) {
+        std::fprintf(stderr, "no Metal device; skipping\n");
+        return 0;
+    }
+
+    // the device compiled its libraries before anyone listened
+    CHECK(skippy_set_native_span_callback(receive_span, nullptr) == SKIPPY_STATUS_OK);
+    CHECK(has_span("mtl.library_init", 0));
+    CHECK(skippy_set_gpu_command_timing_callback(receive, nullptr) == SKIPPY_STATUS_OK);
+
+    ggml_init_params params = { ggml_tensor_overhead() * 8 + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(params);
+    CHECK(ctx != nullptr);
+    ggml_tensor * a = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4096);
+    ggml_tensor * b = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 4096);
+    ggml_tensor * c = ggml_add(ctx, ggml_mul(ctx, a, b), b);
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, c);
+
+    ggml_backend_buffer_t buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    CHECK(buffer != nullptr);
+    const std::vector<float> ones(4096, 1.0f);
+    ggml_backend_tensor_set(a, ones.data(), 0, ggml_nbytes(a));
+    ggml_backend_tensor_set(b, ones.data(), 0, ggml_nbytes(b));
+
+    const auto submitted = std::chrono::system_clock::now();
+    skippy_set_trace_tag(TAG);
+    CHECK(ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS);
+    skippy_set_trace_tag(0);
+
+    // the graph's kernels were first used here, by this call
+    CHECK(has_span("mtl.pipeline_compile", TAG));
+
+    // completion handlers run after the GPU finishes, possibly after synchronize returns
+    for (int i = 0; i < 200 && received_count() == 0; ++i) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(10));
+    }
+
+    std::vector<skippy_gpu_command_timing_v1> received;
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        received = g_received;
+    }
+    CHECK(!received.empty());
+
+    const char * backend_name = ggml_backend_reg_name(ggml_backend_metal_reg());
+    const int64_t submitted_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            submitted.time_since_epoch()).count();
+    // mul and add are neither attention, mat-muls, recurrent state nor KV writes
+    uint32_t other_nodes = 0;
+    for (const auto & t : received) {
+        other_nodes += t.other_nodes;
+        CHECK(std::strcmp(t.op_class, "other") == 0);
+        CHECK(t.attention_nodes == 0 && t.matmul_nodes == 0 && t.recurrent_nodes == 0 && t.kv_write_nodes == 0);
+        CHECK(t.layer == -1);
+    }
+    CHECK(other_nodes == 2);
+    for (const auto & t : received) {
+        CHECK(t.tag == TAG);
+        CHECK(std::strcmp(t.backend_name, backend_name) == 0);
+        CHECK(t.status == 0);
+        CHECK(t.compute_index >= 1);
+        CHECK(t.command_index < t.command_count);
+        CHECK(t.encode_start_unix_ns <= t.encode_end_unix_ns);
+        CHECK(t.execute_start_unix_ns > 0 && t.execute_start_unix_ns <= t.execute_end_unix_ns);
+        // a clock-conversion error would land far from the submission time
+        CHECK(t.execute_start_unix_ns > submitted_ns - 1000000000LL);
+        CHECK(t.execute_end_unix_ns < submitted_ns + 10000000000LL);
+    }
+
+    CHECK(skippy_set_gpu_command_timing_callback(nullptr, nullptr) == SKIPPY_STATUS_OK);
+    CHECK(skippy_set_native_span_callback(nullptr, nullptr) == SKIPPY_STATUS_OK);
+    ggml_backend_buffer_free(buffer);
+    ggml_free(ctx);
+    ggml_backend_free(backend);
+
+    std::printf("ok: %zu command buffer(s)\n", received.size());
+    return 0;
+}
diff --git a/tests/test-skippy-tracing.cpp b/tests/test-skippy-tracing.cpp
new file mode 100644
index 000000000..804c2f7e0
--- /dev/null
+++ b/tests/test-skippy-tracing.cpp
@@ -0,0 +1,306 @@
+// skippy native tracing on any platform: scope nesting and tags, and a fake
+// backend registry for span and GPU command timing forwarding
+
+#include "ggml-backend-impl.h"
+#include "ggml-backend.h"
+#include "skippy/common.h"
+#include "skippy/trace_scope.h"
+#include "skippy/tracing.h"
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <vector>
+
+#define CHECK(cond)                                                     \
+    do {                                                                \
+        if (!(cond)) {                                                  \
+            std::fprintf(stderr, "%s:%d: CHECK(%s)\n", __FILE__, __LINE__, #cond); \
+            return 1;                                                   \
+        }                                                               \
+    } while (0)
+
+namespace {
+
+// what the fake backend was handed
+ggml_backend_command_timing_callback_t g_backend_callback       = nullptr;
+void *                                 g_backend_user_data      = nullptr;
+ggml_backend_trace_span_callback_t     g_backend_span_callback  = nullptr;
+void *                                 g_backend_span_user_data = nullptr;
+uint64_t                               g_backend_tag            = 0;
+
+void fake_set_callback(ggml_backend_command_timing_callback_t callback, void * user_data) {
+    g_backend_callback  = callback;
+    g_backend_user_data = user_data;
+}
+
+void fake_set_span_callback(ggml_backend_trace_span_callback_t callback, void * user_data) {
+    g_backend_span_callback  = callback;
+    g_backend_span_user_data = user_data;
+}
+
+void fake_set_tag(uint64_t tag) {
+    g_backend_tag = tag;
+}
+
+const char * fake_name(ggml_backend_reg_t) {
+    return "FakeGPU";
+}
+
+size_t fake_device_count(ggml_backend_reg_t) {
+    return 0;
+}
+
+ggml_backend_dev_t fake_device(ggml_backend_reg_t, size_t) {
+    return nullptr;
+}
+
+void * fake_proc(ggml_backend_reg_t, const char * name) {
+    if (std::strcmp(name, "ggml_backend_set_command_timing_callback") == 0) {
+        return (void *) (ggml_backend_set_command_timing_callback_t) fake_set_callback;
+    }
+    if (std::strcmp(name, "ggml_backend_set_command_timing_tag") == 0) {
+        return (void *) (ggml_backend_set_command_timing_tag_t) fake_set_tag;
+    }
+    if (std::strcmp(name, "ggml_backend_set_trace_span_callback") == 0) {
+        return (void *) (ggml_backend_set_trace_span_callback_t) fake_set_span_callback;
+    }
+    return nullptr;
+}
+
+ggml_backend_reg g_fake_reg = {
+    /* .api_version = */ GGML_BACKEND_API_VERSION,
+    /* .iface       = */ { fake_name, fake_device_count, fake_device, fake_proc },
+    /* .context     = */ nullptr,
+};
+
+struct received_span {
+    skippy_native_span_v1 span;
+    std::string           name;
+    std::string           detail;
+};
+
+int g_user_marker = 0;
+
+std::vector<received_span>                g_spans;
+std::vector<skippy_gpu_command_timing_v1> g_timings;
+
+// built-in backends may report their own spans; keep the test's
+void receive_span(const skippy_native_span_v1 * span, void * user_data) {
+    if (span == nullptr || user_data != &g_user_marker || std::strncmp(span->name, "test.", 5) != 0) {
+        return;
+    }
+    g_spans.push_back({ *span, span->name, span->detail != nullptr ? span->detail : "" });
+}
+
+void receive_timing(const skippy_gpu_command_timing_v1 * timing, void * user_data) {
+    if (timing != nullptr && user_data == &g_user_marker) {
+        g_timings.push_back(*timing);
+    }
+}
+
+const received_span * find_span(const char * name) {
+    for (const auto & span : g_spans) {
+        if (span.name == name) {
+            return &span;
+        }
+    }
+    return nullptr;
+}
+
+int64_t unix_now_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+int check_scopes() {
+    // nothing is reported before a callback is installed
+    {
+        skippy_trace::scope early("test.early");
+    }
+    CHECK(skippy_set_native_span_callback(receive_span, &g_user_marker) == SKIPPY_STATUS_OK);
+    CHECK(find_span("test.early") == nullptr);
+
+    skippy_set_trace_tag(42);
+    {
+        skippy_trace::scope outer("test.outer", "tokens", 7);
+        {
+            skippy_trace::scope inner("test.inner");
+            inner.set_detail("reuse");
+        }
+        skippy_trace::scope sibling("test.sibling");
+        sibling.end();
+        sibling.end();
+    }
+    skippy_set_trace_tag(0);
+    {
+        skippy_trace::scope untagged("test.untagged");
+    }
+
+    CHECK(g_spans.size() == 4);
+    const auto * outer    = find_span("test.outer");
+    const auto * inner    = find_span("test.inner");
+    const auto * sibling  = find_span("test.sibling");
+    const auto * untagged = find_span("test.untagged");
+    CHECK(outer && inner && sibling && untagged);
+    // children end, and arrive, first
+    CHECK(g_spans[0].name == "test.inner" && g_spans[2].name == "test.outer");
+
+    for (const auto & got : g_spans) {
+        CHECK(got.span.abi_version == SKIPPY_NATIVE_SPAN_V1_ABI_VERSION);
+        CHECK(got.span.struct_size == sizeof(skippy_native_span_v1));
+        CHECK((got.span.id & SKIPPY_NATIVE_SPAN_ID_BIT) != 0);
+        CHECK(got.span.start_unix_ns > 0 && got.span.start_unix_ns <= got.span.end_unix_ns);
+    }
+    CHECK(outer->span.parent == 42);
+    CHECK(inner->span.parent == outer->span.id);
+    CHECK(sibling->span.parent == outer->span.id);
+    CHECK(untagged->span.parent == 0);
+    CHECK(inner->span.id != outer->span.id && sibling->span.id != inner->span.id);
+    CHECK(inner->span.start_unix_ns >= outer->span.start_unix_ns);
+    CHECK(inner->span.end_unix_ns <= outer->span.end_unix_ns);
+    CHECK(std::strcmp(outer->span.value_name, "tokens") == 0 && outer->span.value == 7);
+    CHECK(inner->span.value_name == nullptr && inner->detail == "reuse");
+
+    // work another thread does on this one's behalf joins the scope that handed it over
+    g_spans.clear();
+    {
+        skippy_trace::scope handing("test.handing");
+        const uint64_t parent = skippy_trace::current_parent();
+        CHECK(parent != 0);
+        std::thread([parent] {
+            skippy_trace::adopt joined(parent);
+            skippy_trace::scope adopted("test.adopted");
+        }).join();
+    }
+    std::thread([] {
+        skippy_trace::adopt none(skippy_trace::current_parent());
+        skippy_trace::scope lone("test.lone");
+    }).join();
+    const auto * handing = find_span("test.handing");
+    const auto * adopted = find_span("test.adopted");
+    const auto * lone    = find_span("test.lone");
+    CHECK(handing && adopted && lone);
+    CHECK(adopted->span.parent == handing->span.id);
+    CHECK(lone->span.parent == 0);
+    return 0;
+}
+
+int check_backend() {
+    ggml_backend_register(&g_fake_reg);
+
+    CHECK(skippy_set_native_span_callback(receive_span, &g_user_marker) == SKIPPY_STATUS_OK);
+    CHECK(g_backend_span_callback != nullptr);
+    CHECK(skippy_set_gpu_command_timing_callback(receive_timing, &g_user_marker) == SKIPPY_STATUS_OK);
+    CHECK(g_backend_callback != nullptr);
+    CHECK(g_backend_user_data == &g_fake_reg);
+
+    skippy_set_trace_tag(77);
+    CHECK(g_backend_tag == 77);
+
+    // a span the backend kept from before the install has no parent
+    g_spans.clear();
+    ggml_backend_trace_span span = { 0, "test.kept", "kept detail", 1000, 2000 };
+    g_backend_span_callback(&span, g_backend_span_user_data);
+    // one from this thread joins its tag, or its open scope
+    const int64_t now = unix_now_ns();
+    span = { 0, "test.backend", "pipeline", now, now + 10 };
+    g_backend_span_callback(&span, g_backend_span_user_data);
+    {
+        skippy_trace::scope open("test.open");
+        span = { 5, "test.nested", nullptr, now, now + 10 };
+        g_backend_span_callback(&span, g_backend_span_user_data);
+    }
+    // a backend tag wins outside a scope (a dispatch worker encoding)
+    span = { 9, "test.worker", nullptr, now, now + 10 };
+    g_backend_span_callback(&span, g_backend_span_user_data);
+
+    const auto * kept   = find_span("test.kept");
+    const auto * owned  = find_span("test.backend");
+    const auto * open   = find_span("test.open");
+    const auto * nested = find_span("test.nested");
+    const auto * worker = find_span("test.worker");
+    CHECK(kept && owned && open && nested && worker);
+    CHECK(kept->span.parent == 0 && kept->detail == "kept detail");
+    CHECK(owned->span.parent == 77 && owned->detail == "pipeline");
+    CHECK(nested->span.parent == open->span.id);
+    CHECK(worker->span.parent == 9);
+    CHECK((owned->span.id & SKIPPY_NATIVE_SPAN_ID_BIT) != 0);
+    CHECK(owned->span.start_unix_ns == now && owned->span.end_unix_ns == now + 10);
+
+    ggml_backend_command_timing timing = {};
+    timing.tag                   = 77;
+    timing.context_id            = 3;
+    timing.compute_index         = 7;
+    timing.command_index         = 1;
+    timing.command_count         = 2;
+    timing.node_count            = 64;
+    timing.encode_start_unix_ns  = 1000;
+    timing.encode_end_unix_ns    = 2000;
+    timing.execute_start_unix_ns = 2500;
+    timing.execute_end_unix_ns   = 9000;
+    timing.op_class                 = GGML_BACKEND_OP_CLASS_ATTENTION;
+    timing.layer                    = 11;
+    timing.split_by_class           = 1;
+    timing.attention_kv_cells       = 4096;
+    timing.attention_queries        = 4;
+    timing.attention_row_list_nodes = 2;
+    timing.attention_flash_nodes    = 2;
+    timing.class_nodes[GGML_BACKEND_OP_CLASS_ATTENTION] = 2;
+    timing.class_nodes[GGML_BACKEND_OP_CLASS_OTHER]     = 3;
+    timing.class_bytes[GGML_BACKEND_OP_CLASS_ATTENTION] = 1 << 20;
+    timing.class_bytes[GGML_BACKEND_OP_CLASS_MATMUL]    = 1 << 10;
+    timing.recurrent_states         = 9;
+    timing.recurrent_states_carried = 5;
+    g_backend_callback(&timing, g_backend_user_data);
+
+    CHECK(g_timings.size() == 1);
+    const skippy_gpu_command_timing_v1 & got = g_timings[0];
+    CHECK(got.abi_version == SKIPPY_GPU_COMMAND_TIMING_V1_ABI_VERSION);
+    CHECK(got.struct_size == sizeof(skippy_gpu_command_timing_v1));
+    CHECK(got.tag == 77);
+    CHECK(std::strcmp(got.backend_name, "FakeGPU") == 0);
+    CHECK(got.context_id == 3 && got.compute_index == 7);
+    CHECK(got.command_index == 1 && got.command_count == 2 && got.node_count == 64);
+    CHECK(got.status == 0);
+    CHECK(got.encode_start_unix_ns == 1000 && got.encode_end_unix_ns == 2000);
+    CHECK(got.execute_start_unix_ns == 2500 && got.execute_end_unix_ns == 9000);
+    CHECK(std::strcmp(got.op_class, "attention") == 0);
+    CHECK(got.layer == 11 && got.split_by_class == 1);
+    CHECK(got.attention_kv_cells == 4096 && got.attention_queries == 4 && got.attention_row_list_nodes == 2);
+    CHECK(got.attention_flash_nodes == 2);
+    CHECK(got.attention_nodes == 2 && got.other_nodes == 3 && got.matmul_nodes == 0);
+    CHECK(got.attention_bytes == (1 << 20) && got.matmul_bytes == (1 << 10) && got.other_bytes == 0);
+    CHECK(got.recurrent_states == 9 && got.recurrent_states_carried == 5);
+
+    // a command that mixes classes says so
+    timing.op_class = GGML_BACKEND_OP_CLASS_COUNT;
+    g_backend_callback(&timing, g_backend_user_data);
+    CHECK(g_timings.size() == 2 && std::strcmp(g_timings[1].op_class, "mixed") == 0);
+
+    // clearing stops both reports
+    CHECK(skippy_set_gpu_command_timing_callback(nullptr, nullptr) == SKIPPY_STATUS_OK);
+    CHECK(g_backend_callback == nullptr);
+    CHECK(skippy_set_native_span_callback(nullptr, nullptr) == SKIPPY_STATUS_OK);
+    CHECK(g_backend_span_callback == nullptr);
+    g_spans.clear();
+    {
+        skippy_trace::scope cleared("test.cleared");
+    }
+    CHECK(g_spans.empty());
+    skippy_set_trace_tag(0);
+    return 0;
+}
+
+} // namespace
+
+int main() {
+    if (check_scopes() != 0 || check_backend() != 0) {
+        return 1;
+    }
+    std::printf("ok\n");
+    return 0;
+}
