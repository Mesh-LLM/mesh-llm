diff --git a/src/skippy/trace_scope.h b/src/skippy/trace_scope.h
new file mode 100644
index 000000000..b64d9da37
--- /dev/null
+++ b/src/skippy/trace_scope.h
@@ -0,0 +1,61 @@
+#pragma once
+
+// Native trace spans (skippy/tracing.h) for Skippy and llama internals. With
+// no span callback installed a scope costs one atomic load.
+
+#include <cstdint>
+
+namespace skippy_trace {
+
+// A span from construction until end() or destruction, nested under the
+// scope already open on this thread, else under the thread's trace tag.
+// Scopes on one thread must end in reverse order of construction.
+class scope {
+  public:
+    explicit scope(const char * name) noexcept;
+    scope(const char * name, const char * value_name, int64_t value) noexcept;
+    ~scope() { end(); }
+
+    scope(const scope &)             = delete;
+    scope & operator=(const scope &) = delete;
+
+    // `detail` must outlive the scope
+    void set_detail(const char * detail) noexcept { detail_ = detail; }
+    void set_value(const char * value_name, int64_t value) noexcept {
+        value_name_ = value_name;
+        value_      = value;
+    }
+
+    // ends the span now; later calls and the destructor do nothing
+    void end() noexcept;
+
+  private:
+    const char * name_;
+    const char * detail_     = nullptr;
+    const char * value_name_ = nullptr;
+    int64_t      value_      = 0;
+    uint64_t     id_         = 0;
+    uint64_t     parent_     = 0;
+    uint64_t     previous_   = 0;
+    int64_t      start_unix_ns_ = 0;
+};
+
+// What a span begun now on this thread nests under: its open scope, else its
+// trace tag; 0 when there is neither.
+uint64_t current_parent() noexcept;
+
+// While it lives, spans this thread begins nest under `parent`, so work done
+// on another thread's behalf joins that thread's trace.
+class adopt {
+  public:
+    explicit adopt(uint64_t parent) noexcept;
+    ~adopt();
+
+    adopt(const adopt &)             = delete;
+    adopt & operator=(const adopt &) = delete;
+
+  private:
+    uint64_t previous_;
+};
+
+} // namespace skippy_trace
diff --git a/src/skippy/tracing.cpp b/src/skippy/tracing.cpp
new file mode 100644
index 000000000..9aa48e08c
--- /dev/null
+++ b/src/skippy/tracing.cpp
@@ -0,0 +1,272 @@
+#include "skippy/tracing.h"
+#include "skippy/trace_scope.h"
+
+#include "ggml-backend.h"
+
+#include <array>
+#include <atomic>
+#include <chrono>
+
+namespace {
+
+// Each supporting backend registry gets its own forwarder, so a record can
+// name the backend it came from.
+constexpr size_t MAX_TRACING_BACKENDS = 4;
+
+std::atomic<skippy_native_span_callback> g_span_callback { nullptr };
+std::atomic<void *>                      g_span_user_data { nullptr };
+
+std::atomic<skippy_gpu_command_timing_callback> g_gpu_callback { nullptr };
+std::atomic<void *>                             g_gpu_user_data { nullptr };
+
+// Read on every tagged native call, so lock-free.
+std::array<std::atomic<ggml_backend_set_command_timing_tag_t>, MAX_TRACING_BACKENDS> g_tag_setters {};
+
+std::atomic<uint64_t> g_next_span_id { 0 };
+
+// when the span callback was last installed; backend spans kept from before
+// then have no known parent
+std::atomic<int64_t> g_span_install_unix_ns { 0 };
+
+// the innermost open scope on this thread, and the tag its caller set
+thread_local uint64_t t_current = 0;
+thread_local uint64_t t_tag     = 0;
+
+int64_t unix_now_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+uint64_t next_span_id() {
+    return (g_next_span_id.fetch_add(1, std::memory_order_relaxed) + 1) | SKIPPY_NATIVE_SPAN_ID_BIT;
+}
+
+void deliver_span(
+        uint64_t id, uint64_t parent, const char * name, const char * detail,
+        int64_t start_unix_ns, int64_t end_unix_ns, const char * value_name, int64_t value) {
+    const auto callback = g_span_callback.load(std::memory_order_acquire);
+    if (callback == nullptr) {
+        return;
+    }
+    skippy_native_span_v1 span = {};
+    span.abi_version   = SKIPPY_NATIVE_SPAN_V1_ABI_VERSION;
+    span.struct_size   = sizeof(span);
+    span.id            = id;
+    span.parent        = parent;
+    span.name          = name;
+    span.detail        = detail;
+    span.start_unix_ns = start_unix_ns;
+    span.end_unix_ns   = end_unix_ns;
+    span.value_name    = value_name;
+    span.value         = value;
+    callback(&span, g_span_user_data.load(std::memory_order_acquire));
+}
+
+// A backend span joins the open scope on its thread when there is one (a
+// pipeline compiled inside llama.graph_compute), else the tag the backend
+// carried (a dispatch worker encoding for a tagged call), else the thread's
+// own tag: device initialisation that the install itself triggered. Spans
+// kept from before the install began have no parent.
+uint64_t backend_span_parent(const ggml_backend_trace_span & span) {
+    if (t_current != 0) {
+        return t_current;
+    }
+    if (span.tag != 0) {
+        return span.tag;
+    }
+    return span.start_unix_ns < g_span_install_unix_ns.load(std::memory_order_acquire) ? 0 : t_tag;
+}
+
+void forward_backend_span(const ggml_backend_trace_span * span, void *) {
+    if (span == nullptr || span->name == nullptr) {
+        return;
+    }
+    const uint64_t parent = backend_span_parent(*span);
+    deliver_span(next_span_id(), parent, span->name, span->detail,
+            span->start_unix_ns, span->end_unix_ns, nullptr, 0);
+}
+
+// the names skippy/tracing.h documents for ggml_backend_op_class
+const char * op_class_name(int32_t op_class) {
+    switch (op_class) {
+        case GGML_BACKEND_OP_CLASS_OTHER:     return "other";
+        case GGML_BACKEND_OP_CLASS_ATTENTION: return "attention";
+        case GGML_BACKEND_OP_CLASS_MATMUL:    return "matmul";
+        case GGML_BACKEND_OP_CLASS_RECURRENT: return "recurrent";
+        case GGML_BACKEND_OP_CLASS_KV_WRITE:  return "kv_write";
+        default:                              return "mixed";
+    }
+}
+
+void fill_op_classes(skippy_gpu_command_timing_v1 & record, const ggml_backend_command_timing & timing) {
+    record.op_class                 = op_class_name(timing.op_class);
+    record.layer                    = timing.layer;
+    record.split_by_class           = timing.split_by_class;
+    record.attention_kv_cells       = timing.attention_kv_cells;
+    record.attention_queries        = timing.attention_queries;
+    record.attention_row_list_nodes = timing.attention_row_list_nodes;
+    record.attention_flash_nodes    = timing.attention_flash_nodes;
+    record.attention_nodes          = timing.class_nodes[GGML_BACKEND_OP_CLASS_ATTENTION];
+    record.matmul_nodes             = timing.class_nodes[GGML_BACKEND_OP_CLASS_MATMUL];
+    record.recurrent_nodes          = timing.class_nodes[GGML_BACKEND_OP_CLASS_RECURRENT];
+    record.kv_write_nodes           = timing.class_nodes[GGML_BACKEND_OP_CLASS_KV_WRITE];
+    record.other_nodes              = timing.class_nodes[GGML_BACKEND_OP_CLASS_OTHER];
+    record.attention_bytes          = timing.class_bytes[GGML_BACKEND_OP_CLASS_ATTENTION];
+    record.matmul_bytes             = timing.class_bytes[GGML_BACKEND_OP_CLASS_MATMUL];
+    record.recurrent_bytes          = timing.class_bytes[GGML_BACKEND_OP_CLASS_RECURRENT];
+    record.kv_write_bytes           = timing.class_bytes[GGML_BACKEND_OP_CLASS_KV_WRITE];
+    record.other_bytes              = timing.class_bytes[GGML_BACKEND_OP_CLASS_OTHER];
+    record.recurrent_states         = timing.recurrent_states;
+    record.recurrent_states_carried = timing.recurrent_states_carried;
+}
+
+void forward_command_timing(const ggml_backend_command_timing * timing, void * user_data) {
+    const auto callback = g_gpu_callback.load(std::memory_order_acquire);
+    if (callback == nullptr || timing == nullptr) {
+        return;
+    }
+    auto * reg = static_cast<ggml_backend_reg_t>(user_data);
+
+    skippy_gpu_command_timing_v1 record = {};
+    record.abi_version           = SKIPPY_GPU_COMMAND_TIMING_V1_ABI_VERSION;
+    record.struct_size           = sizeof(record);
+    record.tag                   = timing->tag;
+    record.backend_name          = reg != nullptr ? ggml_backend_reg_name(reg) : "";
+    record.context_id            = timing->context_id;
+    record.compute_index         = timing->compute_index;
+    record.command_index         = timing->command_index;
+    record.command_count         = timing->command_count;
+    record.node_count            = timing->node_count;
+    record.status                = timing->status;
+    record.encode_start_unix_ns  = timing->encode_start_unix_ns;
+    record.encode_end_unix_ns    = timing->encode_end_unix_ns;
+    record.execute_start_unix_ns = timing->execute_start_unix_ns;
+    record.execute_end_unix_ns   = timing->execute_end_unix_ns;
+    fill_op_classes(record, *timing);
+
+    callback(&record, g_gpu_user_data.load(std::memory_order_acquire));
+}
+
+template <typename T>
+T backend_proc(ggml_backend_reg_t reg, const char * name) {
+    return reinterpret_cast<T>(ggml_backend_reg_get_proc_address(reg, name));
+}
+
+// Remember every backend that takes a tag, so skippy_set_trace_tag reaches
+// it whichever callback was installed. Returns how many there are.
+size_t register_tag_setters() {
+    size_t count = 0;
+    for (size_t i = 0; i < ggml_backend_reg_count() && count < MAX_TRACING_BACKENDS; ++i) {
+        const auto set_tag = backend_proc<ggml_backend_set_command_timing_tag_t>(
+                ggml_backend_reg_get(i), "ggml_backend_set_command_timing_tag");
+        if (set_tag != nullptr) {
+            g_tag_setters[count++].store(set_tag, std::memory_order_release);
+        }
+    }
+    return count;
+}
+
+} // namespace
+
+namespace skippy_trace {
+
+scope::scope(const char * name) noexcept : name_(name) {
+    if (g_span_callback.load(std::memory_order_relaxed) == nullptr) {
+        return;
+    }
+    id_            = next_span_id();
+    previous_      = t_current;
+    parent_        = t_current != 0 ? t_current : t_tag;
+    t_current      = id_;
+    start_unix_ns_ = unix_now_ns();
+}
+
+scope::scope(const char * name, const char * value_name, int64_t value) noexcept : scope(name) {
+    set_value(value_name, value);
+}
+
+void scope::end() noexcept {
+    if (id_ == 0) {
+        return;
+    }
+    const int64_t end_unix_ns = unix_now_ns();
+    t_current = previous_;
+    deliver_span(id_, parent_, name_, detail_, start_unix_ns_, end_unix_ns, value_name_, value_);
+    id_ = 0;
+}
+
+uint64_t current_parent() noexcept {
+    return t_current != 0 ? t_current : t_tag;
+}
+
+adopt::adopt(uint64_t parent) noexcept : previous_(t_current) {
+    if (parent != 0) {
+        t_current = parent;
+    }
+}
+
+adopt::~adopt() {
+    t_current = previous_;
+}
+
+} // namespace skippy_trace
+
+enum skippy_status skippy_set_native_span_callback(
+        skippy_native_span_callback callback,
+        void * user_data) {
+    if (callback == nullptr) {
+        g_span_callback.store(nullptr, std::memory_order_release);
+    } else {
+        g_span_install_unix_ns.store(unix_now_ns(), std::memory_order_release);
+        g_span_user_data.store(user_data, std::memory_order_relaxed);
+        g_span_callback.store(callback, std::memory_order_release);
+    }
+
+    register_tag_setters();
+    for (size_t i = 0; i < ggml_backend_reg_count(); ++i) {
+        const auto set_callback = backend_proc<ggml_backend_set_trace_span_callback_t>(
+                ggml_backend_reg_get(i), "ggml_backend_set_trace_span_callback");
+        if (set_callback != nullptr) {
+            set_callback(callback != nullptr ? forward_backend_span : nullptr, nullptr);
+        }
+    }
+
+    // Skippy and llama report their own spans with or without a backend.
+    return SKIPPY_STATUS_OK;
+}
+
+enum skippy_status skippy_set_gpu_command_timing_callback(
+        skippy_gpu_command_timing_callback callback,
+        void * user_data) {
+    if (callback == nullptr) {
+        g_gpu_callback.store(nullptr, std::memory_order_release);
+    } else {
+        g_gpu_user_data.store(user_data, std::memory_order_relaxed);
+        g_gpu_callback.store(callback, std::memory_order_release);
+    }
+
+    register_tag_setters();
+    size_t supported = 0;
+    for (size_t i = 0; i < ggml_backend_reg_count(); ++i) {
+        ggml_backend_reg_t reg = ggml_backend_reg_get(i);
+        const auto set_callback = backend_proc<ggml_backend_set_command_timing_callback_t>(
+                reg, "ggml_backend_set_command_timing_callback");
+        if (set_callback != nullptr) {
+            set_callback(callback != nullptr ? forward_command_timing : nullptr, reg);
+            ++supported;
+        }
+    }
+
+    return supported > 0 ? SKIPPY_STATUS_OK : SKIPPY_STATUS_UNSUPPORTED;
+}
+
+void skippy_set_trace_tag(uint64_t tag) {
+    t_tag = tag;
+    for (const auto & setter : g_tag_setters) {
+        const auto set_tag = setter.load(std::memory_order_acquire);
+        if (set_tag == nullptr) {
+            return;
+        }
+        set_tag(tag);
+    }
+}
