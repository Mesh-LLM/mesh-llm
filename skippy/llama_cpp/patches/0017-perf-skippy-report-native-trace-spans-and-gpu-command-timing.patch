+// time a command buffer that encodes the graph nodes [idx_start, idx_end)
+// when command timing is on; call before it is committed
+static ggml_metal_timing_record_t ggml_metal_time_nodes(
+        ggml_metal_t ctx, id<MTLCommandBuffer> cmd_buf, int command_index, int command_count,
+        int idx_start, int idx_end, bool split_by_class) {
+    ggml_metal_timing_record_t record = ggml_metal_timing_begin(
+            ctx->timing_context_id, ctx->timing_compute_index, command_index, command_count, MAX(idx_end - idx_start, 0));
+    if (record == NULL) {
+        return NULL;
+    }
+
+    ggml_metal_timing_account(record, ctx->gf, idx_start, idx_end, split_by_class);
+
+    [cmd_buf addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+        const MTLCommandBufferStatus status = [cb status];
+        ggml_metal_timing_finish(record, [cb GPUStartTime], [cb GPUEndTime],
+                status == MTLCommandBufferStatusCompleted ? 0 : (int32_t) status);
+    }];
+
+    return record;
+}
+
+static void ggml_metal_time_command_buffer(
+        ggml_metal_t ctx, id<MTLCommandBuffer> cmd_buf, int cb_idx, int command_index, int idx_start, int idx_end) {
+    ctx->timing[cb_idx] = ggml_metal_time_nodes(ctx, cmd_buf, command_index, ctx->n_cb + 1, idx_start, idx_end, false);
+}
+
+// op profiling: one command buffer per run of nodes of one class, encoded
+// and committed in order on the calling thread, so the GPU times each class
+// by itself. Splitting serialises the graph and stops fusion across class
+// boundaries, so totals grow; the shares are what this measures.
+static enum ggml_status ggml_metal_graph_compute_by_class(ggml_metal_t ctx, struct ggml_cgraph * gf, id<MTLCommandQueue> queue) {
+    const int n_nodes = gf->n_nodes;
+
+    int * run_ends = malloc(sizeof(int) * (size_t) n_nodes);
+    if (run_ends == NULL) {
+        return GGML_STATUS_ALLOC_FAILED;
+    }
+
+    int n_runs = 0;
+    for (int idx_start = 0; idx_start < n_nodes; idx_start = run_ends[n_runs - 1]) {
+        run_ends[n_runs++] = ggml_metal_timing_class_run_end(gf, idx_start);
+    }
+
+    int idx_start = 0;
+    for (int run = 0; run < n_runs; ++run) {
+        const int idx_end = run_ends[run];
+
+        id<MTLCommandBuffer> cmd_buf = [queue commandBufferWithUnretainedReferences];
+        ggml_metal_timing_record_t record = ggml_metal_time_nodes(ctx, cmd_buf, run, n_runs, idx_start, idx_end, true);
+
+        ggml_metal_timing_encode_start(record);
+
+        ggml_metal_op_t ctx_op = ggml_metal_op_init(
+            ctx->dev,
+            cmd_buf,
+            gf,
+            ctx->finfo,
+            idx_start,
+            idx_end,
+            ctx->use_concurrency,
+            false,
+            ctx->debug_graph);
+
+        for (int idx = 0; idx < ggml_metal_op_n_nodes(ctx_op); ++idx) {
+            const int res = ggml_metal_op_encode(ctx_op, idx);
+            if (res == 0) {
+                break;
+            }
+
+            idx += res - 1;
+        }
+
+        ggml_metal_op_free(ctx_op);
+
+        ggml_metal_timing_encode_end(record);
+
+        [cmd_buf commit];
+
+        // synchronize() waits for, checks and releases these
+        [ctx->cmd_bufs_ext addObject:cmd_buf];
+        ctx->cmd_buf_last = cmd_buf;
+
+        [cmd_buf retain];
+
+        idx_start = idx_end;
+    }
+
+    free(run_ends);
+
+    return GGML_STATUS_SUCCESS;
+}
