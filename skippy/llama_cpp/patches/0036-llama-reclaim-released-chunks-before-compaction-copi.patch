diff --git a/tests/test-skippy-kv-release-compact.cpp b/tests/test-skippy-kv-release-compact.cpp
new file mode 100644
index 000000000..9ea25b89f
--- /dev/null
+++ b/tests/test-skippy-kv-release-compact.cpp
@@ -0,0 +1,120 @@
+// A chunk whose pages went back to the kernel is zeroed when a ubatch next writes into it.
+// Compaction can move a live sequence into such a chunk; its rows must survive that write.
+#include "../src/llama-batch.h"
+#include "../src/llama-kv-cache.h"
+#include "../src/llama-model.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <memory>
+#include <numeric>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { ++failures; std::printf("FAIL line %d: %s\n", __LINE__, #cond); } } while (0)
+
+namespace {
+
+constexpr uint32_t chunk = llama_kv_cache::kv_chunk_cells;
+
+struct tokens_at {
+    std::vector<llama_pos>      pos;
+    std::vector<llama_seq_id>   seq;
+    std::vector<llama_seq_id *> seq_ptr;
+    std::vector<int32_t>        n_seq;
+    llama_seq_id                unq;
+    llama_ubatch                ubatch{};
+    llama_kv_cache::slot_info   slot{};
+
+    tokens_at(llama_seq_id id, llama_pos p0, uint32_t cell0, uint32_t n)
+        : pos(n), seq(n, id), seq_ptr(n), n_seq(n, 1), unq(id) {
+        std::iota(pos.begin(), pos.end(), p0);
+        std::transform(seq.begin(), seq.end(), seq_ptr.begin(), [](llama_seq_id & s) { return &s; });
+        ubatch.n_tokens     = n;
+        ubatch.n_pos        = 1;
+        ubatch.n_seq_tokens = n;
+        ubatch.n_seqs       = ubatch.n_seqs_unq = 1;
+        ubatch.pos          = pos.data();
+        ubatch.n_seq_id     = n_seq.data();
+        ubatch.seq_id       = seq_ptr.data();
+        ubatch.seq_id_unq   = &unq;
+        slot.s0   = slot.s1 = 0;
+        slot.strm = { 0 };
+        slot.idxs = { std::vector<uint32_t>(n) };
+        std::iota(slot.idxs[0].begin(), slot.idxs[0].end(), cell0);
+    }
+
+    tokens_at(const tokens_at &)             = delete;
+    tokens_at & operator=(const tokens_at &) = delete;
+};
+
+void fill(llama_kv_cache & kv, uint32_t cell0, uint32_t n, float value) {
+    std::for_each(kv.cell_tensors.begin(), kv.cell_tensors.end(), [&](ggml_tensor * t) {
+        const size_t per_row = t->nb[1]/sizeof(float);
+        std::vector<float> rows(per_row*n);
+        std::vector<size_t> at(rows.size());
+        std::iota(at.begin(), at.end(), size_t(0));
+        std::transform(at.begin(), at.end(), rows.begin(), [&](size_t i) { return value + (float) (cell0 + i/per_row); });
+        ggml_backend_tensor_set(t, rows.data(), (size_t) cell0*t->nb[1], rows.size()*sizeof(float));
+    });
+}
+
+bool holds(const llama_kv_cache & kv, uint32_t cell0, uint32_t n, float value, uint32_t from) {
+    return std::all_of(kv.cell_tensors.begin(), kv.cell_tensors.end(), [&](ggml_tensor * t) {
+        const size_t per_row = t->nb[1]/sizeof(float);
+        std::vector<float> rows(per_row*n);
+        ggml_backend_tensor_get(t, rows.data(), (size_t) cell0*t->nb[1], rows.size()*sizeof(float));
+        std::vector<size_t> at(rows.size());
+        std::iota(at.begin(), at.end(), size_t(0));
+        return std::all_of(at.begin(), at.end(), [&](size_t i) { return rows[i] == value + (float) (from + i/per_row); });
+    });
+}
+
+}
+
+int main() {
+    std::unique_ptr<llama_model> model(llama_model_create(LLM_ARCH_LLAMA, llama_model_default_params()));
+    if (!model) {
+        std::printf("failed to create test model\n");
+        return 1;
+    }
+    llama_hparams hparams{};
+    hparams.n_layer_all = 1;
+    hparams.n_embd_head_k_full = hparams.n_embd_head_v_full = 4;
+    hparams.n_embd_head_k_swa = hparams.n_embd_head_v_swa = 4;
+    hparams.n_embd_head_k_mla_impl = hparams.n_embd_head_v_mla_impl = 4;
+    hparams.n_head_arr[0] = hparams.n_head_kv_arr[0] = 1;
+    llama_kv_cache kv(*model, false, hparams, GGML_TYPE_F32, GGML_TYPE_F32,
+            false, false, true, 4*chunk, 2, 0, LLAMA_SWA_TYPE_NONE, nullptr,
+            [](int32_t il) { return il == 0; }, {}, {});
+    if (!kv.release_pages) {
+        std::printf("SKIP: this platform keeps freed KV pages\n");
+        return 0;
+    }
+
+    const uint32_t prefix = 20;
+    const float    mark   = 100.0f;
+    tokens_at other(1, 0, 0, chunk);
+    kv.apply_ubatch(other.slot, other.ubatch);
+    tokens_at kept(0, 0, chunk, prefix);
+    kv.apply_ubatch(kept.slot, kept.ubatch);
+    fill(kv, chunk, prefix, mark);
+
+    kv.seq_rm(1, -1, -1);
+    CHECK(kv.chunk_released[0]);
+
+    kv.init_update(nullptr, true);
+    CHECK(kv.seq_pos_min(0) == 0 && kv.seq_pos_max(0) == (llama_pos) prefix - 1);
+    CHECK(holds(kv, 0, prefix, mark, chunk));
+
+    tokens_at next(0, prefix, prefix, 1);
+    kv.apply_ubatch(next.slot, next.ubatch);
+    CHECK(holds(kv, 0, prefix, mark, chunk));
+
+    if (failures) {
+        std::printf("%d check(s) failed\n", failures);
+        return 1;
+    }
+    std::printf("OK\n");
+    return 0;
+}
