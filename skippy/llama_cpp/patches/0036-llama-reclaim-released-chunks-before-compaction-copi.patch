From bc0e2f85b4fc6db42178aff53ace97937a1da05b Mon Sep 17 00:00:00 2001
From: Jared Wyles <jared.wyles@gmail.com>
Date: Wed, 18 Nov 2026 20:03:10 +1100
Subject: [PATCH 36/39] llama: reclaim released chunks before compaction copies
 rows into them

A chunk whose cells are all free hands its pages back to the kernel and is
marked released; the next ubatch that writes into it zeroes the whole chunk
first. Compaction moved live rows into such a chunk without clearing the
mark, so the next write there, a decoded token appended after a compacted
prefix, zeroed the prefix it had just moved.

Compaction now reclaims each destination chunk before copying rows into it,
as apply_ubatch does before a ubatch writes. Every other writer already goes
through apply_ubatch.

test-skippy-kv-release-compact frees a chunk below a live sequence,
compacts the sequence into it and appends a token there, then checks the
moved rows.
---
 src/llama-kv-cache.cpp                   |  16 +++
 src/llama-kv-cache.h                     |   1 +
 tests/CMakeLists.txt                     |   1 +
 tests/test-skippy-kv-release-compact.cpp | 120 +++++++++++++++++++++++
 4 files changed, 138 insertions(+)
 create mode 100644 tests/test-skippy-kv-release-compact.cpp

diff --git a/src/llama-kv-cache.cpp b/src/llama-kv-cache.cpp
index 8dd006f9e..b8c00f857 100644
--- a/src/llama-kv-cache.cpp
+++ b/src/llama-kv-cache.cpp
@@ -678,6 +678,20 @@ void llama_kv_cache::reclaim_chunks(uint32_t stream, const std::vector<uint32_t>
     trace.set_value("bytes", (int64_t) bytes);
 }
 
+void llama_kv_cache::reclaim_compaction_targets(const std::vector<compaction_move> & moves) {
+    std::vector<uint32_t> streams(n_stream);
+    std::iota(streams.begin(), streams.end(), 0);
+    std::for_each(streams.begin(), streams.end(), [&](uint32_t s) {
+        std::vector<uint32_t> targets;
+        std::for_each(moves.begin(), moves.end(), [&](const compaction_move & move) {
+            if (move.strm == s) {
+                targets.push_back(move.dst);
+            }
+        });
+        reclaim_chunks(s, targets);
+    });
+}
+
 bool llama_kv_cache::seq_rm(llama_seq_id seq_id, llama_pos p0, llama_pos p1) {
     skippy_trace::scope trace("llama.kv_seq_rm", "seq", seq_id);
     // TODO: refactor [TAG_KV_CACHE_SHARE_CELLS]
@@ -1098,6 +1112,8 @@ llama_memory_context_ptr llama_kv_cache::init_update(llama_context * lctx, bool
             const auto moves = compact_cells();
             did_compact = !moves.empty();
             if (did_compact) {
+                // a row moved into a released chunk must not be zeroed by the next write there
+                reclaim_compaction_targets(moves);
                 copy_compacted_cells(moves);
                 LLAMA_LOG_DEBUG("%s: compacted %zu KV cells\n", __func__, moves.size());
             }
