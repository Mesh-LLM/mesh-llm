 }
 
@@ -756,6 +901,8 @@ void llama_kv_cache::seq_keep(llama_seq_id seq_id) {
     if (new_head != cells.size() && new_head < head) {
         head = new_head;
     }
+
+    release_free_chunks(seq_to_stream[seq_id]);
 }
 
 void llama_kv_cache::seq_add(llama_seq_id seq_id, llama_pos p0, llama_pos p1, llama_pos shift) {
@@ -807,6 +954,8 @@ void llama_kv_cache::seq_add(llama_seq_id seq_id, llama_pos p0, llama_pos p1, ll
     // If we freed up a slot, set head to it so searching can start there.
     // Otherwise we just start the next search from the beginning.
     head = new_head != cells.size() ? new_head : 0;
+
+    release_free_chunks(seq_to_stream[seq_id]);
 }
 
 void llama_kv_cache::seq_div(llama_seq_id seq_id, llama_pos p0, llama_pos p1, int d) {
@@ -1443,11 +1592,14 @@ void llama_kv_cache::apply_ubatch(const slot_info & sinfo, const llama_ubatch &
     assert(ubatch.n_tokens == sinfo.n_stream()*sinfo.size());
 
     // every cell this ubatch writes, and so every cell attention may read, lies below the mark
-    for (const auto & idxs : sinfo.idxs) {
+    // and holds zeros or data: released chunks are zeroed again
+    for (uint32_t s = 0; s < sinfo.n_stream(); ++s) {
+        const auto & idxs = sinfo.idxs[s];
         const auto top = std::max_element(idxs.begin(), idxs.end());
         if (top != idxs.end()) {
             clear_cells_through(*top);
         }
+        reclaim_chunks(sinfo.strm[s], idxs);
     }
 
     for (uint32_t s = 0; s < sinfo.n_stream(); ++s) {
