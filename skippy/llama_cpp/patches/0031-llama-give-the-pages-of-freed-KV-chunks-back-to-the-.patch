@@ -297,6 +298,22 @@ public:
     // the K, V and K_idx tensors this cache allocated; a layer shared with another cache has none here
     std::vector<ggml_tensor *> cell_tensors;
 
+    // A chunk whose cells are all free again hands its pages back to the
+    // kernel, so the pool's resident memory follows the cells in use rather
+    // than the high-water mark. A released chunk is zeroed again before a
+    // ubatch writes into it, as a chunk above the mark is. Indexed
+    // [stream][chunk]; only host-visible buffers take part.
+    bool release_pages = false;
+    std::vector<bool> chunk_released;
+    // on wherever the pool is zeroed lazily and the platform can take pages back
+    void set_page_release(bool enabled);
+    void release_free_chunks();
+    void release_free_chunks(uint32_t stream);
+    void reclaim_chunks(uint32_t stream, const std::vector<uint32_t> & idxs);
+    // the byte range of chunks [chunk0, chunk1) of `stream` in each cache tensor
+    void for_each_chunk_range(uint32_t stream, uint32_t chunk0, uint32_t chunk1,
+            const std::function<void(ggml_tensor *, size_t, size_t)> & fn) const;
+
     // emplace the ubatch context into slot: [sinfo.idxs[0...ubatch.n_tokens - 1]]
     void apply_ubatch(const slot_info & sinfo, const llama_ubatch & ubatch);
 
