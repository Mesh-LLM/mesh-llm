From 559ee045135d1b83a38d51fc78d817ea6ab24d2a Mon Sep 17 00:00:00 2001
From: Daniel Winter <danielwinterw@gmail.com>
Date: Sat, 10 Oct 2026 18:34:14 +0100
Subject: [PATCH 08/11] fix(skippy): stop re-attaching backend samplers between
 verify windows

A sampled verify window needs every row's prediction, so it detaches a
backend (in-graph) sampler before decoding. A rejected window then trims the
session, which rebuilds the sampler chain, and the rebuilt greedy chain was
attached to the backend again, only for the next window to detach it. Each
attach and each detach marks the scheduler for a reserve, so a speculating
session re-reserved compute buffers twice per rejected window. On Metal that
made a two-token Qwen3-MoE verify cost about twice a plain two-token decode.

A session that has verified a window now keeps sampling on the CPU until it
resets, instead of attaching rebuilt chains to the backend.
---
 src/skippy/runtime_types.h          |  5 +++++
 src/skippy/sampling.cpp             |  4 +++-
 src/skippy/session.cpp              |  1 +
 src/skippy/tests/runtime_events.cpp | 10 ++++++++++
 src/skippy/verification.cpp         |  1 +
 5 files changed, 20 insertions(+), 1 deletion(-)

diff --git a/src/skippy/runtime_types.h b/src/skippy/runtime_types.h
index 38ebae8d7..f44e874d9 100644
--- a/src/skippy/runtime_types.h
+++ b/src/skippy/runtime_types.h
@@ -158,6 +158,11 @@ struct skippy_session {
     // detached -- e.g. so a sampled verify window can output every row --
     // it must never be re-attached; only building a fresh chain clears this.
     bool sampling_backend_retired = false;
+    // Set when the session first verifies a speculative window and kept until the
+    // session resets: later chains sample on the CPU rather than attach to the
+    // backend only for the next window to detach them. Every attach and detach
+    // re-reserves the scheduler, and a rejected window rebuilds the chain.
+    bool sampling_backend_verifying = false;
     uint64_t sampling_reuse_hit_count = 0;
     uint64_t sampling_rebuild_count = 0;
     skippy_sampling_config sampling_config = {};
diff --git a/src/skippy/sampling.cpp b/src/skippy/sampling.cpp
index 6fd1240e3..de5fa6ba5 100644
--- a/src/skippy/sampling.cpp
+++ b/src/skippy/sampling.cpp
@@ -138,6 +138,7 @@ enum skippy_status skippy_verify_token_batch(
     if (!skippy_retire_backend_sampling(session, out_error)) {
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
+    session->sampling_backend_verifying = true;
 
     const int32_t n_tokens = static_cast<int32_t>(token_count);
     llama_batch batch = llama_batch_init(n_tokens, 0, 1);
@@ -542,7 +543,8 @@ static bool skippy_ensure_plain_sampling_chain(
 void skippy_refresh_backend_sampling(
         skippy_session * session,
         const skippy_sampling_config * sampling) {
-    if (session == nullptr || session->sampling_backend_enabled || session->sampling_backend_retired) {
+    if (session == nullptr || session->sampling_backend_enabled || session->sampling_backend_retired ||
+            session->sampling_backend_verifying) {
         // Backend initialization belongs to the sampler-chain lifetime. The
         // scheduler may reset and reuse the same chain on every iteration;
         // attaching it again violates llama_sampler_chain's one-shot init
diff --git a/src/skippy/session.cpp b/src/skippy/session.cpp
index f1de95cc5..36c972d92 100644
--- a/src/skippy/session.cpp
+++ b/src/skippy/session.cpp
@@ -392,6 +392,7 @@ enum skippy_status skippy_session_reset(
         skippy_clear_chat_sampling(session);
     }
     skippy_mtp_clear_session_state(session);
+    session->sampling_backend_verifying = false;
     session->sampling_backend_row_invalid = true;
     session->reset_required = false;
     session->verify_checkpoints.clear();
diff --git a/src/skippy/tests/runtime_events.cpp b/src/skippy/tests/runtime_events.cpp
index 00a6ff0ec..471d598a2 100644
--- a/src/skippy/tests/runtime_events.cpp
+++ b/src/skippy/tests/runtime_events.cpp
@@ -498,9 +498,19 @@ int test_native_model_load_production(const char * fixture_path) {
     CHECK(!session->sampling_backend_enabled);
     CHECK(session->sampling_backend_retired);
 
+    // A session that verified a window keeps sampling on the CPU: attaching a
+    // rebuilt chain would only be undone by the next window, re-reserving the
+    // scheduler both times. A reset lets the next request offload again.
+    const uint64_t reserves_after_verify = session->ctx->get_sched_reserve_count();
     CHECK(skippy_session_configure_chat_sampling(
             session, &sampling, "{\"grammar\":\"\"}", 2,
             &error) == SKIPPY_STATUS_OK);
+    CHECK(!session->sampling_backend_enabled);
+    CHECK(session->ctx->get_sched_reserve_count() == reserves_after_verify);
+    CHECK(skippy_session_reset(session, &error) == SKIPPY_STATUS_OK);
+    CHECK(skippy_session_configure_chat_sampling(
+            session, &sampling, "{\"grammar\":\"\"}", 0,
+            &error) == SKIPPY_STATUS_OK);
     CHECK(session->sampling_backend_enabled);
 
     // Embedding and rerank batches request every output row. Their shared
diff --git a/src/skippy/verification.cpp b/src/skippy/verification.cpp
index bb3c0e621..2e9b20c48 100644
--- a/src/skippy/verification.cpp
+++ b/src/skippy/verification.cpp
@@ -138,6 +138,7 @@ enum skippy_status skippy_verify_tokens_frame_sampled(
     if (!skippy_retire_backend_sampling(session, out_error)) {
         return SKIPPY_STATUS_RUNTIME_ERROR;
     }
+    session->sampling_backend_verifying = true;
 
     const bool activation_input = skippy_is_filtered(session) && session->stage_model->config.layer_start > 0;
     status = skippy_checkpoint_verify_window(
