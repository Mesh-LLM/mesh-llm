diff --git a/ggml/src/ggml-cuda/fattn-indexed.cuh b/ggml/src/ggml-cuda/fattn-indexed.cuh
new file mode 100644
index 000000000..c1d2fafdc
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-indexed.cuh
@@ -0,0 +1,45 @@
+#pragma once
+
+#include "dequantize.cuh"
+
+// A physical head view. Quantized row strides are byte strides (not half2
+// strides: e.g. a 96-element Q4_0 row occupies 54 bytes).
+struct ggml_cuda_fattn_row {
+    const char * data = nullptr;
+    int64_t stride = 0;
+    ggml_type type = GGML_TYPE_F16;
+};
+
+static __device__ __forceinline__ half ggml_cuda_fattn_read_half(
+        const ggml_cuda_fattn_row row, const int physical, const int element) {
+    const char * src = row.data + int64_t(physical)*row.stride;
+    if (row.type == GGML_TYPE_F16) {
+        return ((const half *) src)[element];
+    }
+    if (row.type == GGML_TYPE_F32) {
+        return __float2half(((const float *) src)[element]);
+    }
+    if (row.type == GGML_TYPE_BF16) {
+        const uint32_t bits = uint32_t(((const uint16_t *) src)[element]) << 16;
+        return __float2half(__uint_as_float(bits));
+    }
+    float2 value;
+    const int block = element / 32;
+    const int offset = element % 32;
+    switch (row.type) {
+        case GGML_TYPE_Q4_0: dequantize_q4_0(src, block, offset % 16, value); break;
+        case GGML_TYPE_Q4_1: dequantize_q4_1(src, block, offset % 16, value); break;
+        case GGML_TYPE_Q5_0: dequantize_q5_0(src, block, offset % 16, value); break;
+        case GGML_TYPE_Q5_1: dequantize_q5_1(src, block, offset % 16, value); break;
+        case GGML_TYPE_Q8_0: dequantize_q8_0(src, block, offset & ~1, value); break;
+        default: return __float2half(0.0f); // Rejected by host admission.
+    }
+    return __float2half(row.type == GGML_TYPE_Q8_0 ?
+            (offset & 1 ? value.y : value.x) : (offset >= 16 ? value.y : value.x));
+}
+
+static __device__ __forceinline__ half2 ggml_cuda_fattn_read_half2(
+        const ggml_cuda_fattn_row row, const int physical, const int element) {
+    return __halves2half2(ggml_cuda_fattn_read_half(row, physical, element),
+                         ggml_cuda_fattn_read_half(row, physical, element + 1));
+}
