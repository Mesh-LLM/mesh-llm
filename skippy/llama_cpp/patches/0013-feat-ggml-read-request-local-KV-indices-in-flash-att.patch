+++ b/ggml/include/ggml.h
@@ -2499,6 +2499,24 @@ extern "C" {
             float                 max_bias,
             float                 logit_softcap);
 
+    // Same attention operation with request-local reads from shared physical K/V.
+    // indices: I32 [logical_kv, query_rows, heads, requests], broadcast over Q.
+    // lengths: I32 [1, query_rows, heads, requests], matching indices dimensions.
+    // The F16 mask addresses logical slots; indices address physical K/V rows.
+    // Each valid index must be in [0, k->ne[1]); padding beyond lengths is -1.
+    // K/V sequence dimensions may be 1 (shared pool) or match Q.
+    GGML_API struct ggml_tensor * ggml_flash_attn_ext_indexed(
+            struct ggml_context * ctx,
+            struct ggml_tensor  * q,
+            struct ggml_tensor  * k,
+            struct ggml_tensor  * v,
+            struct ggml_tensor  * mask,
+            struct ggml_tensor  * indices,
+            struct ggml_tensor  * lengths,
+            float                 scale,
+            float                 max_bias,
+            float                 logit_softcap);
+
