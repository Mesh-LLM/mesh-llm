+    const int32_t * indices = nullptr;
+    const int32_t * lengths = nullptr;
+    int32_t physical_rows = 0;
+    int32_t sequences = 0;
+    int64_t index_stride = 0;
+    int64_t length_stride = 0;
+    ggml_type type_K = GGML_TYPE_F16;
+    ggml_type type_V = GGML_TYPE_F16;
+};
