new file mode 100644
index 000000000..813953ac1
--- /dev/null
+++ b/tests/test-flash-attn-indexed.cpp
@@ -0,0 +1,378 @@
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+constexpr int64_t kv_heads = 2;
+constexpr int64_t requests = 4;
+// Match test_flash_attn_ext::max_nmse_err in test-backend-ops.cpp.
+constexpr double max_nmse = 5e-4;
+
+struct attention_case {
+    int64_t queries;
+    int64_t logical_rows;
+    bool mask;
+    bool sinks;
+    bool query_local = false;
+    bool strided_query = false;
+    ggml_type type_k = GGML_TYPE_F16;
+    ggml_type type_v = GGML_TYPE_F16;
+    int64_t dk = 256;
+    int64_t dv = 256;
+    float max_bias = 1.5f;
+    int64_t heads = 8;
+};
+
+void require(bool condition, const char * message) {
+    if (!condition) {
+        throw std::runtime_error(message);
+    }
+}
+
+struct inputs {
+    const attention_case spec;
+    const int64_t physical_rows;
+    const int64_t mask_queries;
+    const int64_t index_queries;
+    std::vector<float> q;
+    const size_t row_k;
+    const size_t row_v;
+    std::vector<uint8_t> k, v, logical_k, logical_v;
+    std::vector<ggml_fp16_t> mask;
+    std::vector<int32_t> indices, lengths;
+    std::vector<float> sinks;
+
+    explicit inputs(attention_case value) : spec(value), physical_rows(2*value.logical_rows + 257),
+            mask_queries((value.queries + 63)/64*64), index_queries(value.query_local ? value.queries : 1),
+            q(value.dk*value.queries*value.heads*requests),
+            row_k(ggml_row_size(value.type_k, value.dk)), row_v(ggml_row_size(value.type_v, value.dv)),
+            k(row_k*physical_rows*kv_heads), v(row_v*physical_rows*kv_heads),
+            logical_k(row_k*value.logical_rows*kv_heads*requests),
+            logical_v(row_v*value.logical_rows*kv_heads*requests),
+            mask(value.logical_rows*mask_queries*requests),
+            indices(value.logical_rows*index_queries*requests), lengths(index_queries*requests), sinks(value.heads) {
+        std::mt19937 random(34791);
+        std::uniform_real_distribution<float> sample(-0.75f, 0.75f);
+        for (float & item : q) {
+            item = sample(random);
+        }
+        std::vector<float> values(std::max(value.dk, value.dv)*physical_rows*kv_heads);
+        for (float & item : values) {
+            item = sample(random);
+        }
+        ggml_quantize_chunk(value.type_k, values.data(), k.data(), 0, physical_rows*kv_heads, value.dk, nullptr);
+        for (float & item : values) {
+            item = sample(random);
+        }
+        ggml_quantize_chunk(value.type_v, values.data(), v.data(), 0, physical_rows*kv_heads, value.dv, nullptr);
+        for (float & item : sinks) {
+            item = sample(random);
+        }
+    }
+
+    void refresh(int phase) {
+        const int64_t width = spec.logical_rows;
+        std::fill(indices.begin(), indices.end(), -1);
+        std::fill(logical_k.begin(), logical_k.end(), 0);
+        std::fill(logical_v.begin(), logical_v.end(), 0);
+        const std::array<int32_t, requests> counts = phase == 0 ?
+                std::array<int32_t, requests>{0, 31, 65, int32_t(width - 7)} :
+                std::array<int32_t, requests>{65, int32_t(width - 9), 0, 31};
+        for (int64_t request = 0; request < requests; ++request) {
+            for (int64_t query = 0; query < index_queries; ++query) {
+                const int32_t count = std::max(0, counts[request] - int32_t(query % 3));
+                lengths[request*index_queries + query] = count;
+                for (int32_t slot = 0; slot < count; ++slot) {
+                    // Shared first rows plus interleaved, nonmonotonic physical rows.
+                    const int32_t physical = int32_t((slot*37 + (slot < 5 ? 0 : request*53) + phase*101) % physical_rows);
+                    indices[(request*index_queries + query)*width + slot] = physical;
+                }
+            }
+            for (int64_t slot = 0; slot < width; ++slot) {
+                const int32_t physical = indices[request*index_queries*width + slot];
+                if (physical < 0) {
+                    continue;
+                }
+                for (int64_t head = 0; head < kv_heads; ++head) {
+                    const size_t src = head*physical_rows + physical;
+                    const size_t dst = (request*kv_heads + head)*width + slot;
+                    // Preserve the exact encoded block bytes, not re-quantized floats.
+                    std::copy_n(k.data() + src*row_k, row_k, logical_k.data() + dst*row_k);
+                    std::copy_n(v.data() + src*row_v, row_v, logical_v.data() + dst*row_v);
+                }
+            }
+            for (int64_t query = 0; query < mask_queries; ++query) {
+                const int64_t iq = spec.query_local ? std::min(query, spec.queries - 1) : 0;
+                const int32_t count = lengths[request*index_queries + iq];
+                for (int64_t slot = 0; slot < width; ++slot) {
+                    float bias = -std::numeric_limits<float>::infinity();
+                    if (query < spec.queries && slot < count) {
+                        bias = spec.mask ? -0.025f*float(slot % 7) : 0.0f;
+                        if (spec.mask && slot % 11 == 3) {
+                            bias = -std::numeric_limits<float>::infinity();
+                        }
+                    }
+                    mask[(request*mask_queries + query)*width + slot] = ggml_fp32_to_fp16(bias);
+                }
+            }
+        }
+    }
+};
+
+struct graph_fixture {
+    ggml_context * ctx = nullptr;
+    ggml_backend_buffer_t buffer = nullptr;
+    ggml_tensor * q = nullptr;
+    ggml_tensor * k = nullptr;
+    ggml_tensor * v = nullptr;
+    ggml_tensor * mask = nullptr;
+    ggml_tensor * indices = nullptr;
+    ggml_tensor * lengths = nullptr;
+    ggml_tensor * sinks = nullptr;
+    ggml_tensor * output = nullptr;
+    ggml_cgraph * graph = nullptr;
+    const bool indexed;
+
+    graph_fixture(ggml_backend_t backend, const inputs & data, bool use_indices) : indexed(use_indices) {
+        ggml_init_params params{32*ggml_tensor_overhead() + ggml_graph_overhead_custom(32, false), nullptr, true};
+        ctx = ggml_init(params);
+        require(ctx != nullptr, "allocate graph context");
+        if (data.spec.strided_query) {
+            auto storage = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, data.spec.dk, 2*data.spec.queries, data.spec.heads, requests);
+            q = ggml_view_4d(ctx, storage, data.spec.dk, data.spec.queries, data.spec.heads, requests,
+                    2*storage->nb[1], storage->nb[2], storage->nb[3], 0);
+        } else {
+            q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, data.spec.dk, data.spec.queries, data.spec.heads, requests);
+        }
+        const int64_t rows = indexed ? data.physical_rows : data.spec.logical_rows;
+        const int64_t streams = indexed ? 1 : requests;
+        k = ggml_new_tensor_4d(ctx, data.spec.type_k, data.spec.dk, rows, kv_heads, streams);
+        v = ggml_new_tensor_4d(ctx, data.spec.type_v, data.spec.dv, rows, kv_heads, streams);
+        // Dense reference always masks the padding excluded by indexed lengths.
+        if (!indexed || data.spec.mask) {
+            mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, data.spec.logical_rows, data.mask_queries, 1, requests);
+        }
+        if (indexed) {
+            indices = ggml_new_tensor_4d(ctx, GGML_TYPE_I32, data.spec.logical_rows, data.index_queries, 1, requests);
+            lengths = ggml_new_tensor_4d(ctx, GGML_TYPE_I32, 1, data.index_queries, 1, requests);
+            output = ggml_flash_attn_ext_indexed(ctx, q, k, v, mask, indices, lengths,
+                    1.0f/std::sqrt(float(data.spec.dk)), data.spec.mask ? data.spec.max_bias : 0.0f, 0.0f);
+        } else {
+            output = ggml_flash_attn_ext(ctx, q, k, v, mask,
+                    1.0f/std::sqrt(float(data.spec.dk)), data.spec.mask ? data.spec.max_bias : 0.0f, 0.0f);
+        }
+        if (data.spec.sinks) {
+            sinks = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, data.spec.heads);
+            ggml_flash_attn_ext_add_sinks(output, sinks);
+        }
+        ggml_prec_set_acc(output, GGML_PREC_F32);
+        require(ggml_backend_supports_op(backend, output), "selected backend does not support indexed test shape");
+        graph = ggml_new_graph_custom(ctx, 32, false);
+        ggml_build_forward_expand(graph, output);
+        buffer = ggml_backend_alloc_ctx_tensors(ctx, backend);
+        require(buffer != nullptr, "allocate backend graph tensors");
+    }
+
+    ~graph_fixture() {
+        ggml_backend_buffer_free(buffer);
+        ggml_free(ctx);
+    }
+    graph_fixture(const graph_fixture &) = delete;
+    graph_fixture & operator=(const graph_fixture &) = delete;
+
+    std::vector<float> run(ggml_backend_t backend, const inputs & data) {
+        for (int64_t request = 0; request < requests; ++request) {
+            for (int64_t head = 0; head < data.spec.heads; ++head) {
+                for (int64_t query = 0; query < data.spec.queries; ++query) {
+                    const size_t offset = request*q->nb[3] + head*q->nb[2] + query*q->nb[1];
+                    const size_t source = ((request*data.spec.heads + head)*data.spec.queries + query)*data.spec.dk;
+                    ggml_backend_tensor_set(q, data.q.data() + source, offset, data.spec.dk*sizeof(float));
+                }
+            }
+        }
+        ggml_backend_tensor_set(k, indexed ? data.k.data() : data.logical_k.data(), 0, ggml_nbytes(k));
+        ggml_backend_tensor_set(v, indexed ? data.v.data() : data.logical_v.data(), 0, ggml_nbytes(v));
+        if (mask) {
+            ggml_backend_tensor_set(mask, data.mask.data(), 0, ggml_nbytes(mask));
+        }
+        if (indices) {
+            ggml_backend_tensor_set(indices, data.indices.data(), 0, ggml_nbytes(indices));
+            ggml_backend_tensor_set(lengths, data.lengths.data(), 0, ggml_nbytes(lengths));
+        }
+        if (sinks) {
+            ggml_backend_tensor_set(sinks, data.sinks.data(), 0, ggml_nbytes(sinks));
+        }
+        require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "compute attention graph");
+        std::vector<float> result(ggml_nelements(output));
+        ggml_backend_tensor_get(output, result.data(), 0, ggml_nbytes(output));
+        return result;
+    }
+};
+
+void compare(const std::vector<float> & expected, const std::vector<float> & actual,
+        const inputs & data, const char * backend, int phase) {
+    double maximum_nmse = 0.0;
+    float max_absolute = 0.0f;
+    const size_t request_elements = data.spec.dv*data.spec.heads*data.spec.queries;
+    for (int64_t request = 0; request < requests; ++request) {
+        double error = 0.0, energy = 0.0;
+        for (size_t i = request*request_elements; i < (request + 1)*request_elements; ++i) {
+            require(std::isfinite(expected[i]) && std::isfinite(actual[i]), "non-finite attention output");
+            const double delta = double(expected[i]) - actual[i];
+            error += delta*delta;
+            energy += double(expected[i])*expected[i];
+            max_absolute = std::max(max_absolute, float(std::abs(delta)));
+        }
+        if (energy == 0.0) {
+            require(error == 0.0, "empty request must produce exact zero output");
+        } else {
+            maximum_nmse = std::max(maximum_nmse, error/energy);
+            require(error/energy <= max_nmse, "indexed attention exceeds existing FA NMSE tolerance");
+        }
+    }
+    std::printf("PASS backend=%s K=%s V=%s dk=%lld dv=%lld heads=%lld bias=%.2f q=%lld logical=%lld mask=%d sinks=%d query_local=%d strided_q=%d phase=%d max_request_nmse=%.9g max_abs=%.9g\n",
+            backend, ggml_type_name(data.spec.type_k), ggml_type_name(data.spec.type_v),
+            (long long) data.spec.dk, (long long) data.spec.dv, (long long) data.spec.heads,
+            data.spec.mask ? data.spec.max_bias : 0.0f, (long long) data.spec.queries, (long long) data.spec.logical_rows,
+            data.spec.mask, data.spec.sinks, data.spec.query_local, data.spec.strided_query, phase, maximum_nmse, max_absolute);
+}
+
+void set_threads(ggml_backend_t backend) {
+    const auto reg = ggml_backend_dev_backend_reg(ggml_backend_get_device(backend));
+    const auto setter = reinterpret_cast<void (*)(ggml_backend_t, int)>(
+            ggml_backend_reg_get_proc_address(reg, "ggml_backend_set_n_threads"));
+    if (setter) {
+        setter(backend, 4);
+    }
+}
+
+// Accept an exact device (e.g. MTL0/CUDA0) or its registry (Metal/CUDA).
+ggml_backend_t open_backend(const char * name) {
+    if (auto exact = ggml_backend_init_by_name(name, nullptr)) {
+        return exact;
+    }
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        auto device = ggml_backend_dev_get(i);
+        const auto registry = ggml_backend_dev_backend_reg(device);
+        if (std::strcmp(ggml_backend_reg_name(registry), name) == 0) {
+            return ggml_backend_dev_init(device, nullptr);
+        }
+    }
+    return nullptr;
+}
+
+void run_case(ggml_backend_t cpu, ggml_backend_t target, attention_case spec) {
+    inputs data(spec);
+    graph_fixture reference(cpu, data, false);
+    graph_fixture indexed(cpu, data, true);
+    std::unique_ptr<graph_fixture> device;
+    if (target != cpu) {
+        if (ggml_backend_supports_op(target, indexed.output)) {
+            device = std::make_unique<graph_fixture>(target, data, true);
+        } else {
+            const bool dense_supported = ggml_backend_supports_op(target, reference.output);
+            require(!spec.mask || spec.query_local || !dense_supported,
+                    "selected backend must support the canonical masked request-local shape");
+            std::printf("SKIP optional backend=%s K=%s V=%s q=%lld mask=%d query_local=%d dense_admission=%d: indexed shape explicitly unsupported; CPU verification remains required\n",
+                    ggml_backend_name(target), ggml_type_name(spec.type_k), ggml_type_name(spec.type_v),
+                    (long long) spec.queries, spec.mask, spec.query_local, dense_supported);
+        }
+    }
+    for (int phase = 0; phase < 2; ++phase) {
+        data.refresh(phase);
+        const auto expected = reference.run(cpu, data);
+        compare(expected, indexed.run(cpu, data), data, ggml_backend_name(cpu), phase);
+        if (device) {
+            compare(expected, device->run(target, data), data, ggml_backend_name(target), phase);
+        }
+    }
+}
+} // namespace
+
+int main(int argc, char ** argv) {
+    try {
+        require(argc == 1 || (argc == 3 && std::strcmp(argv[1], "--backend") == 0),
+                "usage: test-flash-attn-indexed [--backend DEVICE_NAME]");
+        ggml_backend_load_all();
+        using backend_ptr = std::unique_ptr<ggml_backend, decltype(&ggml_backend_free)>;
+        backend_ptr cpu(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr), ggml_backend_free);
+        require(cpu != nullptr, "CPU reference backend unavailable");
+        set_threads(cpu.get());
+        backend_ptr selected(nullptr, ggml_backend_free);
+        if (argc == 3) {
+            selected.reset(open_backend(argv[2]));
+            require(selected != nullptr, "requested backend unavailable");
+        } else {
+            selected.reset(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_GPU, nullptr));
+            if (!selected) {
+                selected.reset(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_IGPU, nullptr));
+            }
+        }
+        const bool selected_cpu = selected &&
+                ggml_backend_dev_type(ggml_backend_get_device(selected.get())) == GGML_BACKEND_DEVICE_TYPE_CPU;
+        auto target = selected && !selected_cpu ? selected.get() : cpu.get();
+        std::printf("indexed FA: CPU reference and target=%s; per-request NMSE limit=%.9g\n", ggml_backend_name(target), max_nmse);
+        for (int64_t queries : {1, 4, 31, 32, 64}) {
+            run_case(cpu.get(), target, {queries, 256, true, true});
+        }
+        run_case(cpu.get(), target, {1, 4352, true, true});
+        run_case(cpu.get(), target, {4, 256, false, false});
+        run_case(cpu.get(), target, {31, 256, true, false, true});
+        run_case(cpu.get(), target, {32, 256, true, true, false, true});
+        const std::array<ggml_type, 8> types = {GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_BF16,
+                GGML_TYPE_Q4_0, GGML_TYPE_Q4_1, GGML_TYPE_Q5_0, GGML_TYPE_Q5_1, GGML_TYPE_Q8_0};
+        for (auto type_k : types) {
+            for (auto type_v : types) {
+                for (int64_t queries : {1, 32}) {
+                    run_case(cpu.get(), target, {queries, 256, true, true, false, false, type_k, type_v});
+                }
+            }
+        }
+        const std::array<std::array<int64_t, 2>, 13> head_shapes = {{{32, 32}, {64, 64}, {96, 96},
+                {96, 64}, {128, 128}, {128, 96}, {192, 192}, {192, 128}, {256, 256},
+                {320, 256}, {512, 512}, {576, 512}, {128, 64}}};
+        for (const auto & dimensions : head_shapes) {
+            for (auto type : types) {
+                for (int64_t queries : {1, 32}) {
+                    run_case(cpu.get(), target, {queries, 256, true, true, false, false,
+                            type, type, dimensions[0], dimensions[1]});
+                }
+            }
+        }
+        // CUDA's larger-head kernels require zero ALiBi and admitted GQA tile ratios.
+        const std::array<std::array<int64_t, 3>, 5> wide_shapes = {{{192, 128, 16},
+                {320, 256, 64}, {512, 512, 8}, {576, 512, 8}, {576, 512, 4}}};
+        for (const auto & dimensions : wide_shapes) {
+            for (auto type : types) {
+                for (int64_t queries : {1, 32}) {
+                    run_case(cpu.get(), target, {queries, 256, true, true, false, false,
+                            type, type, dimensions[0], dimensions[1], 0.0f, dimensions[2]});
+                }
+            }
+        }
+        for (int64_t dimension : {40, 48, 72, 80, 112}) {
+            for (auto type : {GGML_TYPE_F32, GGML_TYPE_F16, GGML_TYPE_BF16}) {
+                for (int64_t queries : {1, 32}) {
+                    run_case(cpu.get(), target, {queries, 256, true, true, false, false,
+                            type, type, dimension, dimension});
+                }
+            }
+        }
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "indexed FA test failed: %s\n", error.what());
+        return 1;
+    }
+}
