diff --git a/ggml/src/ggml-cpu/attention-indexed.cpp b/ggml/src/ggml-cpu/attention-indexed.cpp
new file mode 100644
index 000000000..0f62a5185
--- /dev/null
+++ b/ggml/src/ggml-cpu/attention-indexed.cpp
@@ -0,0 +1,121 @@
+#include "attention-indexed.h"
+
+#include "ggml-cpu.h"
+#include "ggml-cpu-impl.h"
+#include "ggml-impl.h"
+#include "vec.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+// CPU reference for the existing attention op's optional logical read tables.
+// K/V remain in their shared physical storage; only row addresses are indirect.
+void ggml_compute_forward_flash_attn_indexed(
+        const ggml_compute_params * params, ggml_tensor * dst) {
+    const auto * q = dst->src[0];
+    const auto * k = dst->src[1];
+    const auto * v = dst->src[2];
+    const auto * mask = dst->src[3];
+    const auto * sinks = dst->src[4];
+    const auto * indices = dst->src[5];
+    const auto * lengths = dst->src[6];
+    const int64_t dk = q->ne[0];
+    const int64_t dv = v->ne[0];
+    const auto * kt = ggml_get_type_traits_cpu(k->type);
+    const auto * qt = ggml_get_type_traits_cpu(kt->vec_dot_type);
+    const auto * vt = ggml_get_type_traits(v->type);
+    GGML_ASSERT(q->type == GGML_TYPE_F32 && kt->vec_dot && qt->from_float);
+    GGML_ASSERT(v->type == GGML_TYPE_F32 || vt->to_float);
+
+    float scale, max_bias, softcap;
+    memcpy(&scale, dst->op_params, sizeof(float));
+    memcpy(&max_bias, (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&softcap, (const float *) dst->op_params + 2, sizeof(float));
+    if (softcap != 0.0f) {
+        scale /= softcap;
+    }
+    const uint32_t head_power = 1u << (uint32_t) std::floor(std::log2(q->ne[2]));
+    const float m0 = std::pow(2.0f, -max_bias / head_power);
+    const float m1 = std::pow(2.0f, -(max_bias / 2.0f) / head_power);
+    std::vector<float> converted_q(dk);
+    std::vector<float> converted_v(dv);
+    std::vector<float> accum(dv);
+
+    const int64_t rows = q->ne[1] * q->ne[2] * q->ne[3];
+    for (int64_t row = params->ith; row < rows; row += params->nth) {
+        const int64_t request = row / (q->ne[1] * q->ne[2]);
+        const int64_t head = (row / q->ne[1]) % q->ne[2];
+        const int64_t query = row % q->ne[1];
+        const auto * ids = (const int32_t *) ((const char *) indices->data +
+                (query % indices->ne[1]) * indices->nb[1] +
+                (head % indices->ne[2]) * indices->nb[2] +
+                (request % indices->ne[3]) * indices->nb[3]);
+        const int32_t count = *(const int32_t *) ((const char *) lengths->data +
+                (query % lengths->ne[1]) * lengths->nb[1] +
+                (head % lengths->ne[2]) * lengths->nb[2] +
+                (request % lengths->ne[3]) * lengths->nb[3]);
+        GGML_ASSERT(count >= 0 && count <= indices->ne[0]);
+        const auto * pm = mask ? (const ggml_fp16_t *) ((const char *) mask->data +
+                query * mask->nb[1] + (head % mask->ne[2]) * mask->nb[2] +
+                (request % mask->ne[3]) * mask->nb[3]) : nullptr;
+        const auto * pq = (const float *) ((const char *) q->data + query * q->nb[1] +
+                head * q->nb[2] + request * q->nb[3]);
+        qt->from_float(pq, converted_q.data(), dk);
+        const float slope = max_bias > 0 ? (head < head_power ?
+                std::pow(m0, head + 1) : std::pow(m1, 2 * (head - head_power) + 1)) : 1.0f;
+        const size_t k_offset = (head / (q->ne[2] / k->ne[2])) * k->nb[2] +
+                (request / (q->ne[3] / k->ne[3])) * k->nb[3];
+        const size_t v_offset = (head / (q->ne[2] / v->ne[2])) * v->nb[2] +
+                (request / (q->ne[3] / v->ne[3])) * v->nb[3];
+        std::fill(accum.begin(), accum.end(), 0.0f);
+        float maximum = -INFINITY;
+        float sum = 0.0f;
+        for (int32_t slot = 0; slot < count; ++slot) {
+            const int32_t physical = ids[slot];
+            GGML_ASSERT(physical >= 0 && physical < k->ne[1] && physical < v->ne[1]);
+            const float bias = pm ? slope * GGML_FP16_TO_FP32(pm[slot]) : 0.0f;
+            if (bias == -INFINITY) {
+                continue;
+            }
+            float score;
+            const char * pk = (const char *) k->data + physical * k->nb[1] + k_offset;
+            kt->vec_dot(dk, &score, 0, pk, 0, converted_q.data(), 0, 1);
+            score *= scale;
+            if (softcap != 0) {
+                score = softcap * std::tanh(score);
+            }
+            score += bias;
+            const float next_max = std::max(maximum, score);
+            const float old_scale = std::exp(maximum - next_max);
+            const float weight = std::exp(score - next_max);
+            const char * pv = (const char *) v->data + physical * v->nb[1] + v_offset;
+            const float * values = (const float *) pv;
+            if (v->type != GGML_TYPE_F32) {
+                vt->to_float(pv, converted_v.data(), dv);
+                values = converted_v.data();
+            }
+            for (int64_t d = 0; d < dv; ++d) {
+                accum[d] = accum[d] * old_scale + values[d] * weight;
+            }
+            sum = sum * old_scale + weight;
+            maximum = next_max;
+        }
+        if (sinks && count > 0) {
+            const float sink = ((const float *) sinks->data)[head];
+            const float next_max = std::max(maximum, sink);
+            const float old_scale = std::exp(maximum - next_max);
+            for (float & value : accum) {
+                value *= old_scale;
+            }
+            sum = sum * old_scale + std::exp(sink - next_max);
+        }
+        const float inverse = sum > 0 ? 1.0f / sum : 0.0f;
+        auto * output = (float *) ((char *) dst->data + query * dst->nb[2] +
+                head * dst->nb[1] + request * dst->nb[3]);
+        for (int64_t d = 0; d < dv; ++d) {
+            output[d] = accum[d] * inverse;
+        }
+    }
+}
