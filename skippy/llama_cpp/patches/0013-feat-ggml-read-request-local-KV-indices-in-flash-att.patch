diff --git a/ggml/src/ggml-metal/ggml-metal-attention-indexed.h b/ggml/src/ggml-metal/ggml-metal-attention-indexed.h
new file mode 100644
index 000000000..04445aada
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-attention-indexed.h
@@ -0,0 +1,90 @@
+#pragma once
+
+#include "ggml.h"
+#include "ggml-metal-impl.h"
+
+// Request-local physical row lists use the existing attention gather kernels.
+// Keep their admission independent from the mask-scanning sparse hint limits.
+static inline bool ggml_metal_flash_attn_indexed_supported(const struct ggml_tensor * op) {
+    const struct ggml_tensor * indices = op->src[5];
+    const struct ggml_tensor * lengths = op->src[6];
+    if (!indices || !lengths || indices->type != GGML_TYPE_I32 || lengths->type != GGML_TYPE_I32 ||
+            indices->nb[0] != sizeof(int32_t) || lengths->ne[0] != 1 ||
+            op->src[0]->type != GGML_TYPE_F32 || op->src[1]->type != op->src[2]->type ||
+            op->src[0]->ne[1] >= 65536 || op->src[0]->ne[3] >= 65536 ||
+            indices->ne[0] <= 0 || indices->ne[0] > INT32_MAX || op->src[1]->ne[1] > INT32_MAX) {
+        return false;
+    }
+    for (int dim = 1; dim < 4; ++dim) {
+        if (indices->ne[dim] <= 0 || lengths->ne[dim] != indices->ne[dim] ||
+                op->src[0]->ne[dim] % indices->ne[dim] != 0) {
+            return false;
+        }
+    }
+    const int64_t dk = op->src[1]->ne[0];
+    const int64_t dv = op->src[2]->ne[0];
+    const bool shape = ((dk == 32 || dk == 40 || dk == 48 || dk == 64 || dk == 72 ||
+            dk == 80 || dk == 112) && dv == dk) ||
+            (dk == 96 && (dv == 96 || dv == 64)) || (dk == 128 && (dv == 128 || dv == 96)) ||
+            (dk == 192 && (dv == 192 || dv == 128)) || (dk == 256 && dv == 256) ||
+            (dk == 320 && dv == 256) || (dk == 512 && dv == 512) || (dk == 576 && dv == 512);
+    if (!shape || (dk % 32 != 0 && (indices->ne[1] != 1 || indices->ne[2] != 1))) {
+        return false;
+    }
+    switch (op->src[1]->type) {
+        case GGML_TYPE_F32:
+        case GGML_TYPE_F16:
+        case GGML_TYPE_BF16:
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+            return true;
+        default:
+            return false;
+    }
+}
+
+// Canonical request lists share one logical K/V order across the query tile.
+// Reuse the existing typed matrix kernel for prefill instead of scalarizing it.
+static inline bool ggml_metal_flash_attn_indexed_use_mma(const struct ggml_tensor * op) {
+    return op->src[5] && (op->src[0]->ne[1] >= 20 || op->src[1]->ne[0] % 32 != 0) &&
+            op->src[5]->ne[1] == 1 && op->src[5]->ne[2] == 1;
+}
+
+static inline void ggml_metal_flash_attn_indexed_args(
+        const struct ggml_tensor * op, ggml_metal_kargs_flash_attn_ext_vec * args) {
+    if (!op->src[5]) {
+        return;
+    }
+    args->n_kv_physical = (int32_t) op->src[1]->ne[1];
+    args->n_kv_indices = (int32_t) op->src[5]->ne[0];
+    args->ne51 = (int32_t) op->src[5]->ne[1];
+    args->ne52 = (int32_t) op->src[5]->ne[2];
+    args->ne53 = (int32_t) op->src[5]->ne[3];
+    args->nb51 = op->src[5]->nb[1];
+    args->nb52 = op->src[5]->nb[2];
+    args->nb53 = op->src[5]->nb[3];
+    args->nb61 = op->src[6]->nb[1];
+    args->nb62 = op->src[6]->nb[2];
+    args->nb63 = op->src[6]->nb[3];
+}
+
+static inline void ggml_metal_flash_attn_indexed_mma_args(
+        const struct ggml_tensor * op, ggml_metal_kargs_flash_attn_ext * args) {
+    if (!op->src[5]) {
+        return;
+    }
+    args->n_kv_physical = (int32_t) op->src[1]->ne[1];
+    args->n_kv_indices = (int32_t) op->src[5]->ne[0];
+    args->ne51 = (int32_t) op->src[5]->ne[1];
+    args->ne52 = (int32_t) op->src[5]->ne[2];
+    args->ne53 = (int32_t) op->src[5]->ne[3];
+    args->nb51 = op->src[5]->nb[1];
+    args->nb52 = op->src[5]->nb[2];
+    args->nb53 = op->src[5]->nb[3];
+    args->nb61 = op->src[6]->nb[1];
+    args->nb62 = op->src[6]->nb[2];
+    args->nb63 = op->src[6]->nb[3];
+}
