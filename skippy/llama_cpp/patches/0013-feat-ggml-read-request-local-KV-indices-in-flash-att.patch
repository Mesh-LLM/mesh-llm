diff --git a/src/llama-kv-read.cpp b/src/llama-kv-read.cpp
new file mode 100644
index 000000000..934d3b733
--- /dev/null
+++ b/src/llama-kv-read.cpp
@@ -0,0 +1,148 @@
+#include "llama-kv-read.h"
+
+#include "llama-kv-cache.h"
+
+#include <algorithm>
+#include <limits>
+#include <set>
+
+namespace {
+
+struct request_queries {
+    llama_seq_id sequence;
+    uint32_t count = 0;
+    llama_pos max_position = -1;
+};
+
+bool scalar_text_positions(const llama_ubatch & ubatch) {
+    if (ubatch.n_pos == 0) {
+        return false;
+    }
+    // Ordinary text can carry multiple rotary-position planes. The batch
+    // allocator expands these to [p, p, p, 0, ...]; spatial inputs retain
+    // independent coordinates and need the existing spatial mask instead.
+    for (uint32_t axis = 1; axis < ubatch.n_pos; ++axis) {
+        for (uint32_t token = 0; token < ubatch.n_tokens; ++token) {
+            const llama_pos expected = axis < 3 ? ubatch.pos[token] : 0;
+            if (ubatch.pos[axis * ubatch.n_tokens + token] != expected) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+bool query_runs(const llama_ubatch & ubatch, std::vector<request_queries> & requests) {
+    std::set<llama_seq_id> sequences;
+    std::set<llama_pos> positions;
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        if (ubatch.n_seq_id[i] != 1 || !ubatch.seq_id[i] || ubatch.pos[i] < 0) {
+            return false;
+        }
+        const llama_seq_id sequence = ubatch.seq_id[i][0];
+        if (sequence < 0 || sequence >= LLAMA_MAX_SEQ) {
+            return false;
+        }
+        if (requests.empty() || requests.back().sequence != sequence) {
+            // A request must own one contiguous query run, including decode
+            // split_simple batches whose b_equal_seqs flag is false.
+            if (!sequences.insert(sequence).second) {
+                return false;
+            }
+            requests.push_back({sequence});
+            positions.clear();
+        }
+        if (!positions.insert(ubatch.pos[i]).second) {
+            return false;
+        }
+        auto & request = requests.back();
+        ++request.count;
+        request.max_position = std::max(request.max_position, ubatch.pos[i]);
+    }
+    const uint32_t count = requests.front().count;
+    return std::all_of(requests.begin(), requests.end(), [count](const request_queries & request) {
+        return request.count == count;
+    });
+}
+
+bool visible_count(const llama_kv_cache & cache, const request_queries & request,
+        uint32_t physical_extent, bool spatial_positions, int32_t & count) {
+    const auto & cells = cache.get_cells(request.sequence);
+    llama_pos previous = -1;
+    count = 0;
+    for (const auto & entry : cells.seq_pos_get(request.sequence)) {
+        if (entry.first > request.max_position) {
+            break;
+        }
+        if (entry.first < 0 || entry.first == previous || entry.second >= physical_extent ||
+                count == std::numeric_limits<int32_t>::max()) {
+            return false;
+        }
+        if (spatial_positions) {
+            const auto & spatial = cells.ext_get(entry.second);
+            if (spatial.x != entry.first || spatial.y != entry.first) {
+                return false;
+            }
+        }
+        previous = entry.first;
+        ++count;
+    }
+    return true;
+}
+
+} // namespace
+
+llama_kv_read_plan llama_kv_cache_context::get_read_plan(const llama_ubatch & ubatch) const {
+    if (!kv || kv->get_n_stream() != 1 || kv->get_n_swa() != 0 ||
+            ubatch.n_tokens == 0 || ubatch.decision_order ||
+            !ubatch.pos || !ubatch.n_seq_id || !ubatch.seq_id) {
+        return {};
+    }
+    if (!scalar_text_positions(ubatch)) {
+        return {};
+    }
+    const uint32_t physical_extent = get_n_kv();
+    if (physical_extent == 0 || physical_extent > static_cast<uint32_t>(std::numeric_limits<int32_t>::max())) {
+        return {};
+    }
+
+    std::vector<request_queries> requests;
+    if (!query_runs(ubatch, requests)) {
+        return {};
+    }
+    llama_kv_read_plan plan;
+    plan.physical_extent = physical_extent;
+    plan.lengths.resize(requests.size());
+    uint32_t max_length = 0;
+    for (size_t i = 0; i < requests.size(); ++i) {
+        if (!visible_count(*kv, requests[i], physical_extent, ubatch.n_pos >= 3, plan.lengths[i])) {
+            return {};
+        }
+        max_length = std::max(max_length, static_cast<uint32_t>(plan.lengths[i]));
+    }
+    constexpr uint32_t alignment = 256;
+    if (max_length > static_cast<uint32_t>(std::numeric_limits<int32_t>::max()) - (alignment - 1)) {
+        return {};
+    }
+    plan.logical_extent = std::max(alignment, ((max_length + alignment - 1) / alignment) * alignment);
+    if (requests.size() > std::numeric_limits<size_t>::max() / plan.logical_extent) {
+        return {};
+    }
+    const size_t elements = requests.size() * plan.logical_extent;
+    plan.indices.assign(elements, -1);
+    plan.positions.assign(elements, -1);
+    for (size_t i = 0; i < requests.size(); ++i) {
+        size_t destination = i * plan.logical_extent;
+        for (const auto & entry : kv->get_cells(requests[i].sequence).seq_pos_get(requests[i].sequence)) {
+            if (entry.first > requests[i].max_position) {
+                break;
+            }
+            plan.indices[destination] = static_cast<int32_t>(entry.second);
+            plan.positions[destination] = entry.first;
+            ++destination;
+        }
+    }
+    plan.queries_per_request = requests.front().count;
+    plan.request_count = static_cast<uint32_t>(requests.size());
+    return plan;
+}
diff --git a/src/llama-kv-read.h b/src/llama-kv-read.h
new file mode 100644
index 000000000..ca21eae3a
--- /dev/null
+++ b/src/llama-kv-read.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include "llama.h"
+
+#include <cstdint>
+#include <vector>
+
+// Request-major logical token positions and their shared physical attention
+// cells. Padding is -1; lengths, not physical pool occupancy, bound each read.
+struct llama_kv_read_plan {
+    uint32_t queries_per_request = 0;
+    uint32_t request_count = 0;
+    uint32_t physical_extent = 0;
+    uint32_t logical_extent = 0;
+    std::vector<int32_t> indices;
+    std::vector<llama_pos> positions;
+    std::vector<int32_t> lengths;
+
+    explicit operator bool() const { return request_count != 0; }
+};
