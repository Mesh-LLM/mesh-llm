--- /dev/null
+++ b/src/llama-graph-kv-read.cpp
@@ -0,0 +1,134 @@
+#include "llama-graph.h"
+
+#include "llama-cparams.h"
+#include "llama-kv-cache.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <utility>
+#include <vector>
+
+bool llm_graph_context::supports_indexed_attn(const ggml_tensor * node,
+                                            const ggml_tensor * storage) const {
+    while (storage->view_src) {
+        storage = storage->view_src;
+    }
+    if (storage->buffer) {
+        const auto type = ggml_backend_buffer_get_type(storage->buffer);
+        const auto device = ggml_backend_buft_get_device(type);
+        if (device) {
+            return ggml_backend_dev_supports_op(device, node);
+        }
+        // Generic CPU and mapped host buffers have no device owner. Resolve
+        // their capability through the scheduler's CPU backend, without
+        // admitting unsupported GPU-owned storage onto a CPU copy path.
+        if (!ggml_backend_buft_is_host(type) || !sched) {
+            return false;
+        }
+        for (int i = 0; i < ggml_backend_sched_get_n_backends(sched); ++i) {
+            const auto backend = ggml_backend_sched_get_backend(sched, i);
+            const auto backend_device = ggml_backend_get_device(backend);
+            if (backend_device && ggml_backend_dev_type(backend_device) == GGML_BACKEND_DEVICE_TYPE_CPU &&
+                    ggml_backend_supports_op(backend, node)) {
+                return true;
+            }
+        }
+        return false;
+    }
+    // Unallocated planning tensors have no buffer owner yet. Use the normal
+    // scheduler's preferred compute backend for the same capability query.
+    return sched && ggml_backend_sched_get_n_backends(sched) > 0 &&
+            ggml_backend_supports_op(ggml_backend_sched_get_backend(sched, 0), node);
+}
+
+static llama_kv_read_plan make_read_plan(const llm_graph_input_attn_kv & input,
+                                       const llama_ubatch & ubatch) {
+    const auto & params = input.cparams;
+    if (!params.flash_attn || !params.causal_attn || !params.kv_unified || params.training ||
+            input.hparams.n_rel_attn_bkts != 0) {
+        return {};
+    }
+    return input.mctx->get_read_plan(ubatch);
+}
+
+void llm_graph_input_attn_kv::build_read_inputs(ggml_context * ctx, const llama_ubatch & ubatch) {
+    read_plan = make_read_plan(*this, ubatch);
+    if (!read_plan) {
+        return;
+    }
+    self_read_indices = ggml_new_tensor_4d(ctx, GGML_TYPE_I32,
+            read_plan.logical_extent, 1, 1, read_plan.request_count);
+    self_read_lengths = ggml_new_tensor_4d(ctx, GGML_TYPE_I32,
+            1, 1, 1, read_plan.request_count);
+    self_read_mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16,
+            read_plan.logical_extent, read_plan.queries_per_request, 1, read_plan.request_count);
+    ggml_set_input(self_read_indices);
+    ggml_set_input(self_read_lengths);
+    ggml_set_input(self_read_mask);
+    ggml_set_name(self_read_indices, "attn_inp_read_indices");
+    ggml_set_name(self_read_lengths, "attn_inp_read_lengths");
+    ggml_set_name(self_read_mask, "attn_inp_read_mask");
+}
+
+bool llm_graph_input_attn_kv::can_reuse_read_inputs(const llama_ubatch & ubatch) {
+    auto next = make_read_plan(*this, ubatch);
+    if (static_cast<bool>(next) != static_cast<bool>(read_plan)) {
+        return false;
+    }
+    if (next.logical_extent != read_plan.logical_extent ||
+            next.queries_per_request != read_plan.queries_per_request ||
+            next.request_count != read_plan.request_count ||
+            next.physical_extent != read_plan.physical_extent) {
+        return false;
+    }
+    read_plan = std::move(next);
+    return true;
+}
+
+void llm_graph_input_attn_kv::set_read_inputs(const llama_ubatch & ubatch) {
+    if (!read_plan) {
+        return;
+    }
+    if (self_read_indices->buffer) {
+        ggml_backend_tensor_set(self_read_indices, read_plan.indices.data(), 0,
+                                read_plan.indices.size() * sizeof(int32_t));
+    }
+    if (self_read_lengths->buffer) {
+        ggml_backend_tensor_set(self_read_lengths, read_plan.lengths.data(), 0,
+                                read_plan.lengths.size() * sizeof(int32_t));
+    }
+    if (!self_read_mask->buffer) {
+        return;
+    }
+
+    const uint32_t extent = read_plan.logical_extent;
+    const uint32_t queries = read_plan.queries_per_request;
+    std::vector<ggml_fp16_t> mask(ggml_nelements(self_read_mask));
+    const ggml_fp16_t drop = ggml_fp32_to_fp16(-INFINITY);
+    const ggml_fp16_t keep = ggml_fp32_to_fp16(0.0f);
+    std::fill(mask.begin(), mask.end(), drop);
+    for (uint32_t request = 0; request < read_plan.request_count; ++request) {
+        const auto * begin = read_plan.positions.data() + static_cast<size_t>(request) * extent;
+        const auto * end = begin + read_plan.lengths[request];
+        for (uint32_t query = 0; query < queries; ++query) {
+            const llama_pos position = ubatch.pos[request * queries + query];
+            auto * row = mask.data() + (static_cast<size_t>(request) * queries + query) * extent;
+            if (hparams.f_max_alibi_bias <= 0) {
+                const auto * visible = std::upper_bound(begin, end, position);
+                std::fill(row, row + (visible - begin), keep);
+                continue;
+            }
+            for (int32_t slot = 0; slot < read_plan.lengths[request]; ++slot) {
+                const llama_pos key_position = read_plan.positions[request * extent + slot];
+                if (key_position > position) {
+                    break;
+                }
+                const float bias = hparams.f_max_alibi_bias > 0 ?
+                        -static_cast<float>(position - key_position) : 0.0f;
+                row[slot] = ggml_fp32_to_fp16(bias);
+            }
+        }
+    }
+    ggml_backend_tensor_set(self_read_mask, mask.data(), 0, mask.size() * sizeof(ggml_fp16_t));
+}
