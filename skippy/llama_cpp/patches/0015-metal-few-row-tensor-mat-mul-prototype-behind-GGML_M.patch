 }
 
+// Few-row tensor mat-mul tile variant selected by GGML_METAL_MUL_MM_FR (a, b or
+// c); 0 when unset, which leaves the existing kernels in charge.
+char ggml_metal_mul_mm_fr_variant(void) {
+    static const char variant = [] {
+        const char * env = getenv("GGML_METAL_MUL_MM_FR");
+        return (env != nullptr && (env[0] == 'a' || env[0] == 'b' || env[0] == 'c')) ? env[0] : '\0';
+    }();
+    return variant;
+}
+
+ggml_metal_pipeline_with_params ggml_metal_library_get_pipeline_mul_mm_fr(ggml_metal_library_t lib, const ggml_tensor * op) {
+    char base[256];
+    char name[256];
+
+    const char variant = ggml_metal_mul_mm_fr_variant();
+    GGML_ASSERT(variant != '\0');
+
+    // <weight rows, src1 rows, K step, simdgroups> per variant, matching mul_mm.metal
+    const int nra = variant == 'b' ? 128 : 64;
+    const int nrb = variant == 'c' ? 8   : 16;
+    const int nk  = variant == 'b' ? 32  : 64;
+    const int nsg = 4;
+
+    const ggml_type tsrc0 = op->src[0]->type;
+    const ggml_type tsrc1 = op->src[1]->type;
+
+    const bool bc_inp = op->src[0]->ne[0] % 32 != 0;
+
+    GGML_ASSERT(op->src[1]->ne[2] <= INT16_MAX && op->src[1]->ne[3] <= INT16_MAX);
+    const int16_t ne12 = (int16_t) op->src[1]->ne[2];
+    const int16_t ne13 = (int16_t) op->src[1]->ne[3];
+    const int16_t r2   = (int16_t) (ne12 / op->src[0]->ne[2]);
+    const int16_t r3   = (int16_t) (ne13 / op->src[0]->ne[3]);
+
+    snprintf(base, 256, "kernel_mul_mm_fr%c_%s_%s", variant, ggml_type_name(tsrc0), ggml_type_name(tsrc1));
+    snprintf(name, 256, "%s_bci=%d_ne12=%d_ne13=%d_r2=%d_r3=%d", base, bc_inp, ne12, ne13, r2, r3);
+
+    ggml_metal_pipeline_with_params res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        ggml_metal_cv_t cv = ggml_metal_cv_init();
+
+        ggml_metal_cv_set_bool(cv, bc_inp, FC_MUL_MM + 0);
+        ggml_metal_cv_set_bool(cv, false,  FC_MUL_MM + 1);
+        ggml_metal_cv_set_int16(cv, ne12,  FC_MUL_MM + 2);
+        ggml_metal_cv_set_int16(cv, ne13,  FC_MUL_MM + 3);
+        ggml_metal_cv_set_int16(cv, r2,    FC_MUL_MM + 4);
+        ggml_metal_cv_set_int16(cv, r3,    FC_MUL_MM + 5);
+
+        res = ggml_metal_library_compile_pipeline(lib, base, name, cv);
+
+        ggml_metal_cv_free(cv);
+    }
+
+    res.nr0  = nra;
+    res.nr1  = nrb;
+    res.nsg  = nsg;
+    res.smem = (size_t) nra * nk * sizeof(ggml_fp16_t);
+
+    return res;
+}
