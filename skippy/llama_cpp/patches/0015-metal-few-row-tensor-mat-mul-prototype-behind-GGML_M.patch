index dfa5102c5..b3fe3dbb4 100644
--- a/ggml/src/ggml-metal/kernels/mul_mm.metal
+++ b/ggml/src/ggml-metal/kernels/mul_mm.metal
@@ -146,6 +146,110 @@ kernel void kernel_mul_mm(
     cT.store(tD);
 }
 
+// Few-row tensor mat-mul: the tensor kernel above with a small src1 tile, for
+// batches of a few rows such as speculative verification. The src1 tile holds
+// FR_NRB rows instead of 128, and each threadgroup dequantizes FR_NRA weight
+// rows over FR_NK of K per step, so a weight block is decoded once and applied
+// to every row of the batch.
+template<
+    short FR_NRA, short FR_NRB, short FR_NK, short FR_NSG,
+    typename SA, typename SA_4x4,
+    typename block_q, short nl, void (*dequantize_func)(device const block_q *, short, thread SA_4x4 &),
+    typename T0, typename T0_4x4, typename T1>
+kernel void kernel_mul_mm_fr(
+        constant ggml_metal_kargs_mul_mm & args,
+        device const char * srcA,
+        device const char * srcB,
+        device       char * dst,
+        threadgroup  char * shmem [[threadgroup(0)]],
+        uint3  tgpig [[threadgroup_position_in_grid]],
+        ushort tiitg [[thread_index_in_threadgroup]]) {
+    const int K = args.ne00;
+    const int M = args.ne0;
+    const int N = args.ne1;
+
+    const int im  = tgpig.z;
+    const int i12 = im % FC_mul_mm_ne12;
+    const int i13 = im / FC_mul_mm_ne12;
+
+    const uint64_t offset0 = (i12/FC_mul_mm_r2)*args.nb02 + (i13/FC_mul_mm_r3)*args.nb03;
+
+    const int ra = tgpig.y * FR_NRA;
+    const int rb = tgpig.x * FR_NRB;
+
+    threadgroup SA * sa = (threadgroup SA *)(shmem);
+
+    constexpr int K_CHUNKS    = FR_NK / 16;
+    constexpr int WORK_ITEMS  = FR_NRA * K_CHUNKS;
+    constexpr int NUM_THREADS = N_SIMDWIDTH * FR_NSG;
+
+    device T1 * ptrB = (device T1 *)(srcB + args.nb12*i12 + args.nb13*i13);
+    const int strideB = args.nb11 / sizeof(T1);
+    auto tB = tensor(ptrB, dextents<int32_t, 2>(K, N), array<int, 2>({1, strideB}));
+    auto tA = tensor(sa, dextents<int32_t, 2>(FR_NK, FR_NRA));
+
+    mpp::tensor_ops::matmul2d<
+        mpp::tensor_ops::matmul2d_descriptor(
+            FR_NRB, FR_NRA, static_cast<int>(dynamic_extent), false, true, true,
+            mpp::tensor_ops::matmul2d_descriptor::mode::multiply_accumulate),
+        execution_simdgroups<FR_NSG>> mm;
+
+    auto cT = mm.template get_destination_cooperative_tensor<decltype(tB), decltype(tA), float>();
+
+    for (int loop_k = 0; loop_k < K; loop_k += FR_NK) {
+        for (int work = tiitg; work < WORK_ITEMS; work += NUM_THREADS) {
+            const int   row     = work / K_CHUNKS;
+            const int   k_chunk = work % K_CHUNKS;
+            const int   k_pos   = loop_k + k_chunk * 16;
+            const short k_base  = k_chunk * 16;
+
+            if (ra + row < M && k_pos < K) {
+                if (is_same<T0_4x4, block_q>::value && FC_mul_mm_bc_inp) {
+                    device const T0 * row_ptr = (device const T0 *)(srcA + args.nb01 * (ra + row) + offset0);
+                    FOR_UNROLL (short i = 0; i < 16; i++) {
+                        sa[row * FR_NK + (k_base + i)] = (k_pos + i < K) ? (SA) row_ptr[k_pos + i] : (SA)0;
+                    }
+                } else {
+                    const int   block_idx = k_pos / (16 * nl);
+                    const short il        = (k_pos / 16) % nl;
+
+                    device const block_q * row_ptr = (device const block_q *)(srcA + args.nb01 * (ra + row) + offset0);
+
+                    SA_4x4 temp_a;
+                    dequantize_func(row_ptr + block_idx, il, temp_a);
+
+                    FOR_UNROLL (short i = 0; i < 16; i++) {
+                        sa[row * FR_NK + (k_base + i)] = (k_pos + i < K) ? temp_a[i/4][i%4] : (SA)0;
+                    }
+                }
+            } else {
+                FOR_UNROLL (short i = 0; i < 16; i++) {
+                    sa[row * FR_NK + (k_base + i)] = (SA)0;
+                }
+            }
+        }
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+
+        const int kExt = min((int) FR_NK, K - loop_k);
+
+        auto tAv = tensor(sa, dextents<int32_t, 2>(kExt, FR_NRA), array<int, 2>({1, FR_NK}));
+        auto tBv = tensor(ptrB + loop_k + rb * strideB, dextents<int32_t, 2>(kExt, N - rb), array<int, 2>({1, strideB}));
+
+        mm.run(tBv, tAv, cT);
+
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    const int tileM = min((int) FR_NRA, M - ra);
+    const int tileN = min((int) FR_NRB, N - rb);
+
+    device float * dstTile = (device float *)dst + (uint64_t) im * N * M + (uint64_t) rb * M + ra;
+
+    auto tD = tensor(dstTile, dextents<int32_t, 2>(tileM, tileN), array<int, 2>({1, M}));
+    cT.store(tD);
+}
+
