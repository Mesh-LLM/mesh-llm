 ggml/src/ggml-metal/ggml-metal-ops.cpp        | 74 ++++++++++++-------
 .../ggml-metal/kernels/fa_vec_common.metal    | 16 ++--
 tests/test-backend-ops.cpp                    | 17 ++++-
 3 files changed, 74 insertions(+), 33 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-ops.cpp b/ggml/src/ggml-metal/ggml-metal-ops.cpp
index 9309f9994..9e68f20d9 100644
--- a/ggml/src/ggml-metal/ggml-metal-ops.cpp
+++ b/ggml/src/ggml-metal/ggml-metal-ops.cpp
@@ -16,6 +16,7 @@
 #include <cstdlib>
 #include <limits>
 #include <cmath>
+#include <tuple>
 
 // threadgroups needed to fill the GPU
 // TODO: dedup
@@ -33,6 +34,27 @@ static ggml_metal_buffer_id ggml_metal_get_buffer_id(const ggml_tensor * t) {
     return ggml_metal_buffer_get_id(ctx, t);
 }
 
+// The first C-entry block of the row lists that the gather-free vec kernel cannot read straight
+// from the cache, or -1. Such a block is one run of consecutive cells from its first entry, then
+// only padding; a block of only padding is skipped, and a run ending inside its block reads on
+// to the block's end, so that read must stay inside the cache. Every entry is checked: the row
+// list contract allows any order.
+static int64_t ggml_metal_rows_first_gathered_block(const int32_t * lists, int64_t n_entries, int64_t n_cache_rows) {
+    constexpr int64_t C = OP_FLASH_ATTN_EXT_VEC_NCPSG;
+    const auto padding = [](int32_t row) { return row < 0; };
+    for (int64_t b = 0; b < n_entries/C; ++b) {
+        const int32_t * block = lists + b*C;
+        const int32_t * tail  = std::find_if(block, block + C, padding);
+        const bool run    = std::adjacent_find(block, tail, [](int32_t a, int32_t z) { return z != a + 1; }) == tail;
+        const bool padded = std::all_of(tail, block + C, padding);
+        const bool inside = tail == block || tail == block + C || block[0] + C <= n_cache_rows;
+        if (!run || !padded || !inside) {
+            return b;
+        }
+    }
+    return -1;
+}
+
 struct ggml_metal_op {
     ggml_metal_op(
         ggml_metal_device_t dev,
@@ -103,6 +125,21 @@ struct ggml_metal_op {
         ggml_metal_fusion_info_count_fusion(finfo, fusion);
     }
 
+    // row lists do not change while a command buffer encodes, and the attention layers of a graph
+    // share them, so each list is checked once per command buffer rather than once per layer
+    int64_t rows_first_gathered_block(const ggml_tensor * rows, int64_t n_entries, int64_t n_cache_rows) {
+        const auto key  = std::make_tuple(rows->data, n_entries, n_cache_rows);
+        const auto seen = std::find_if(rows_checked.begin(), rows_checked.end(), [&](const auto & checked) {
+            return checked.first == key;
+        });
+        if (seen != rows_checked.end()) {
+            return seen->second;
+        }
+        const int64_t block = ggml_metal_rows_first_gathered_block((const int32_t *) rows->data, n_entries, n_cache_rows);
+        rows_checked.emplace_back(key, block);
+        return block;
+    }
+
     ggml_metal_device_t  dev;
     ggml_metal_library_t lib;
     ggml_metal_encoder_t enc;
@@ -124,6 +161,8 @@ private:
 
     // non-empty node indices
     std::vector<int> idxs;
+
+    std::vector<std::pair<std::tuple<const void *, int64_t, int64_t>, int64_t>> rows_checked;
 };
 
 ggml_metal_op_t ggml_metal_op_init(
@@ -3608,9 +3647,8 @@ int ggml_metal_op_flash_attn_ext(ggml_metal_op_t ctx, int idx) {
     GGML_ASSERT(!has_rows || ne11_attn % OP_FLASH_ATTN_EXT_VEC_NCPSG == 0);
 
     // the vec kernel compiles without gather code when every block of every list is one
-    // consecutive range (possibly ending in padding) or all padding. a run ascends, so its ends
-    // decide; the lists are readable from the host whenever their Metal buffer is shared or
-    // mapped (every buffer type but private)
+    // consecutive range (possibly ending in padding) or all padding; the lists are readable from
+    // the host whenever their Metal buffer is shared or mapped (every buffer type but private)
     // GGML_METAL_ROWS_DEBUG=1 reports, at exit, how often the gather-free variant was chosen and
     // prints the first blocks that disqualified a list
     static const bool rows_debug = getenv("GGML_METAL_ROWS_DEBUG") != nullptr;
@@ -3628,31 +3666,15 @@ int ggml_metal_op_flash_attn_ext(ggml_metal_op_t ctx, int idx) {
     const bool rows_dense = rows_shared &&
         [&] {
             constexpr int64_t C = OP_FLASH_ATTN_EXT_VEC_NCPSG;
-            const int32_t * lists = (const int32_t *) kv_rows->data;
-            const int64_t n_blocks = (ne11_attn/C)*kv_rows->ne[1];
             const int64_t n_cache_rows = op->src[1]->ne[1];
-            for (int64_t b = 0; b < n_blocks; ++b) {
-                const int32_t * block = lists + b*C;
-                const int32_t first = block[0];
-                if (first < 0 || block[C - 1] == first + C - 1) {
-                    continue; // all padding (the kernel skips it), or one consecutive range
-                }
-                // a run ending inside the block: the kernel reads C rows from `first` and the mask
-                // drops the padded columns, so the read must stay inside the cache
-                const int32_t * tail = std::find(block, block + C, -1);
-                const int64_t live = tail - block;
-                if (tail == block + C || block[live - 1] != first + live - 1 || first + C > n_cache_rows ||
-                        std::any_of(tail, block + C, [](int32_t row) { return row >= 0; })) {
-                    if (rows_debug && rows_dense_misses.load() < 4) {
-                        GGML_LOG_INFO("rows attention: general kernel: list %lld block %lld of %lld: first %d last %d live %lld [%d..%d] cache rows %lld\n",
-                                (long long) (b/(ne11_attn/C)), (long long) (b % (ne11_attn/C)), (long long) (ne11_attn/C),
-                                first, block[C - 1], (long long) live, block[std::max<int64_t>(live - 1, 0)], tail < block + C ? *tail : -2,
-                                (long long) n_cache_rows);
-                    }
-                    return false;
-                }
+            const int64_t b = ctx->rows_first_gathered_block(kv_rows, ne11_attn*kv_rows->ne[1], n_cache_rows);
+            if (b >= 0 && rows_debug && rows_dense_misses.load() < 4) {
+                const int32_t * block = (const int32_t *) kv_rows->data + b*C;
+                GGML_LOG_INFO("rows attention: general kernel: list %lld block %lld of %lld: [%d %d .. %d %d] cache rows %lld\n",
+                        (long long) (b/(ne11_attn/C)), (long long) (b % (ne11_attn/C)), (long long) (ne11_attn/C),
+                        block[0], block[1], block[C - 2], block[C - 1], (long long) n_cache_rows);
             }
-            return true;
+            return b < 0;
         }();
     if (rows_shared) {
         (rows_dense ? rows_dense_hits : rows_dense_misses)++;
diff --git a/ggml/src/ggml-metal/kernels/fa_vec_common.metal b/ggml/src/ggml-metal/kernels/fa_vec_common.metal
index dfc35bae4..4da7bc07b 100644
--- a/ggml/src/ggml-metal/kernels/fa_vec_common.metal
+++ b/ggml/src/ggml-metal/kernels/fa_vec_common.metal
@@ -235,9 +235,9 @@ kernel void kernel_flash_attn_ext_vec(
             }
 
             // a block whose row list is consecutive reads K/V like the dense path, from its first row;
-            // only a block with gaps or padding gathers row by row. the lists are strictly ascending
-            // (llama_kv_cells::get_seq_cells), so a block is consecutive iff its ends are C-1 apart:
-            // two uniform loads decide it, without staging the indices
+            // only a block with gaps or padding gathers row by row. matching ends do not make a block
+            // consecutive, since a row list may hold any rows in any order: each lane checks its
+            // entries and the simdgroup votes
             int rows_base = -1;
             if (FC_flash_attn_ext_vec_has_rows) {
                 if (FC_flash_attn_ext_vec_rows_dense) {
@@ -249,9 +249,15 @@ kernel void kernel_flash_attn_ext_vec(
                     }
                 } else {
                     const int first = rows_list[ic];
-                    const int last  = rows_list[ic + C - 1];
 
-                    rows_base = (first >= 0 && last == first + C - 1) ? first : -1;
+                    bool consecutive = first >= 0;
+                    FOR_UNROLL (short ii = 0; ii < C/NW; ++ii) {
+                        const short i = ii*NW + tiisg;
+
+                        consecutive = consecutive && rows_list[ic + i] == first + i;
+                    }
+
+                    rows_base = simd_all(consecutive) ? first : -1;
                 }
             }
 
