From 64b7766d9ed5c8d133f3762cd6c6fe140bb21a74 Mon Sep 17 00:00:00 2001
From: Jared Wyles <jared.wyles@gmail.com>
Date: Wed, 18 Nov 2026 20:05:26 +1100
Subject: [PATCH 38/39] skippy: a helper takes a run's tasks only while that
 run admits it

A helper woke when its ordinal was below the run's helper limit, released
the lock, then took the lock again to claim tasks without checking the
limit. If the caller finished that run and started a narrower one in
between, the late helper claimed the new run's tasks past its
sample_threads limit.

work() now checks the limit of the run in progress on every claim. The
calling thread is always admitted; a helper that is not goes back to wait.

test-skippy-task-pool alternates wide runs of trivial tasks with
one-helper runs and checks that no more than one helper ever runs a task of
the narrow runs at once. It is a stress test: the old interleaving is
likely, not certain, to occur in one pass.
---
 src/skippy/task_pool.cpp        | 13 +++++++------
 src/skippy/task_pool.h          |  4 +++-
 tests/test-skippy-task-pool.cpp | 25 +++++++++++++++++++++++++
 3 files changed, 35 insertions(+), 7 deletions(-)

diff --git a/src/skippy/task_pool.cpp b/src/skippy/task_pool.cpp
index 88f8d3b59..c1e1bf517 100644
--- a/src/skippy/task_pool.cpp
+++ b/src/skippy/task_pool.cpp
@@ -50,7 +50,7 @@ void skippy_task_pool::run(size_t n, const task_fn & fn, size_t max_helpers) {
         failure = nullptr;
     }
     wake.notify_all();
-    work(false);
+    work(std::nullopt);
 
     std::unique_lock<std::mutex> lock(mutex);
     idle.wait(lock, [this] { return pending == 0; });
@@ -60,16 +60,17 @@ void skippy_task_pool::run(size_t n, const task_fn & fn, size_t max_helpers) {
     }
 }
 
-// Takes indices until none are left.
-void skippy_task_pool::work(bool on_helper) {
+// Takes indices until none are left. A helper may have woken for an earlier, wider run, so it
+// takes each index only while the run in progress still admits it.
+void skippy_task_pool::work(std::optional<size_t> helper) {
     std::unique_lock<std::mutex> lock(mutex);
-    while (task != nullptr && next < count) {
+    while (task != nullptr && next < count && (!helper || *helper < allowed)) {
         const size_t    index = next++;
         const task_fn * fn    = task;
         lock.unlock();
         std::exception_ptr thrown;
         try {
-            (*fn)(index, on_helper);
+            (*fn)(index, helper.has_value());
         } catch (...) {
             thrown = std::current_exception();
         }
@@ -91,7 +92,7 @@ void skippy_task_pool::serve(size_t ordinal) {
             return;
         }
         lock.unlock();
-        work(true);
+        work(ordinal);
         lock.lock();
     }
 }
diff --git a/src/skippy/task_pool.h b/src/skippy/task_pool.h
index e33523ea7..efc147f01 100644
--- a/src/skippy/task_pool.h
+++ b/src/skippy/task_pool.h
@@ -9,6 +9,7 @@
 #include <exception>
 #include <functional>
 #include <mutex>
+#include <optional>
 #include <thread>
 #include <vector>
 
@@ -40,7 +41,8 @@ class skippy_task_pool {
     void run(size_t count, const task_fn & task, size_t max_helpers);
 
   private:
-    void work(bool on_helper);
+    // helper: the pool thread's ordinal; none for the thread that called run()
+    void work(std::optional<size_t> helper);
     void serve(size_t ordinal);
 
     const size_t            limit;
diff --git a/tests/test-skippy-task-pool.cpp b/tests/test-skippy-task-pool.cpp
index e9b9284e0..677658b96 100644
--- a/tests/test-skippy-task-pool.cpp
+++ b/tests/test-skippy-task-pool.cpp
@@ -136,6 +136,30 @@ static void the_pool_grows_to_demand_and_honours_each_runs_limit() {
     });
 }
 
+// A helper woken for a wide run can reach the task list after a narrower run has started; it
+// must not take that run's tasks past the narrower limit.
+static void a_helper_woken_for_a_wider_run_respects_the_next_runs_limit() {
+    skippy_task_pool pool(6);
+    std::atomic<int> on_helpers_now { 0 };
+    std::atomic<int> most_on_helpers { 0 };
+    std::vector<int> rounds(2000);
+    std::for_each(rounds.begin(), rounds.end(), [&](int) {
+        pool.run(7, [](size_t, bool) {}, 6);
+        pool.run(16, [&](size_t, bool on_helper) {
+            if (!on_helper) {
+                return;
+            }
+            const int now = ++on_helpers_now;
+            int before = most_on_helpers.load();
+            while (now > before && !most_on_helpers.compare_exchange_weak(before, now)) {
+            }
+            std::this_thread::yield();
+            --on_helpers_now;
+        }, 1);
+    });
+    CHECK(most_on_helpers <= 1);
+}
+
 static void sample_threads_select_the_executor() {
     const auto name_of = [](uint32_t sample_threads) {
         return std::string(skippy_with_sample_executor(sample_threads,
@@ -162,6 +186,7 @@ int main() {
     an_exception_reaches_the_caller_and_the_pool_keeps_working();
     callers_on_different_threads_take_turns();
     the_pool_grows_to_demand_and_honours_each_runs_limit();
+    a_helper_woken_for_a_wider_run_respects_the_next_runs_limit();
     sample_threads_select_the_executor();
     CHECK(skippy_task_pool::shared().helpers() <= skippy_task_pool::shared().ceiling());
     if (failures == 0) {
