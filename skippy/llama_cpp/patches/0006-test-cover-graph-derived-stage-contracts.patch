diff --git a/tests/test-skippy-kv-page-export.cpp b/tests/test-skippy-kv-page-export.cpp
new file mode 100644
index 000000000..8b595464f
--- /dev/null
+++ b/tests/test-skippy-kv-page-export.cpp
@@ -0,0 +1,367 @@
+#include "skippy.h"
+#include "../src/skippy/state_memory.h"
+
+#include "../src/llama-batch.h"
+#include "../src/llama-kv-cache.h"
+#include "../src/llama-model.h"
+#include "../src/llama-graph.h"
+
+#include <cstdio>
+#include <memory>
+#include <string>
+#include <vector>
+
+// An unrecognized derived memory may add state that the base adapter omits.
+class unknown_kv_memory : public llama_kv_cache {
+public:
+    using llama_kv_cache::llama_kv_cache;
+};
+
+static bool graph_cache_capabilities_cover_complete_state() {
+    ggml_init_params params = {ggml_tensor_overhead() * 16 + 2 * ggml_graph_overhead_custom(32, false), nullptr, true};
+    ggml_context_ptr ctx(ggml_init(params));
+    auto * input = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 4);
+    auto * state = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 4);
+    ggml_set_input(input);
+    auto * output = ggml_cpy(ctx.get(), input, state);
+    auto * graph = ggml_new_graph_custom(ctx.get(), 32, false);
+    ggml_build_forward_expand(graph, output);
+    llm_graph_result result(32);
+    result.block_boundaries = {
+        {skippy_block_boundary_kind::entry, 0, input},
+        {skippy_block_boundary_kind::exit, 0, output},
+    };
+    const auto capabilities = [&](skippy_state_kind kind) {
+        result.replace_with_stage_graph(graph, {}, {}, {
+            {kind, skippy_state_access::read, 0, state, nullptr},
+            {kind, skippy_state_access::write, 0, state, output, 0},
+        });
+        return skippy_graph_cache_capabilities(result);
+    };
+    const uint32_t dense = SKIPPY_MEMORY_CACHE_RESIDENT | SKIPPY_MEMORY_CACHE_KV_RECURRENT |
+            SKIPPY_MEMORY_CACHE_FULL_STATE;
+    if (capabilities(skippy_state_kind::kv_key) != dense ||
+            capabilities(skippy_state_kind::kv_value) != dense ||
+            capabilities(skippy_state_kind::recurrent_conv) != (SKIPPY_MEMORY_CACHE_KV_RECURRENT | SKIPPY_MEMORY_CACHE_FULL_STATE) ||
+            capabilities(skippy_state_kind::recurrent_ssm) != (SKIPPY_MEMORY_CACHE_KV_RECURRENT | SKIPPY_MEMORY_CACHE_FULL_STATE) ||
+            capabilities(skippy_state_kind::derived_persistent) != SKIPPY_MEMORY_CACHE_FULL_STATE) {
+        return false;
+    }
+    capabilities(skippy_state_kind::kv_key);
+    // Malformed ownership and missing graph admission must never advertise a
+    // partial exporter, even when the underlying memory supports KV pages.
+    result.state_effects.back().storage = input;
+    if (skippy_graph_cache_capabilities(result) != 0) { return false; }
+    capabilities(skippy_state_kind::kv_key);
+    result.block_boundaries.clear();
+    if (skippy_graph_cache_capabilities(result) != 0) { return false; }
+
+    // An independently built stateless phase is compatible with every
+    // admitted exporter; absence of effects is not a failure of ownership.
+    auto * stateless_output = ggml_scale(ctx.get(), input, 2.0f);
+    auto * stateless_graph = ggml_new_graph_custom(ctx.get(), 32, false);
+    ggml_build_forward_expand(stateless_graph, stateless_output);
+    result.replace_with_stage_graph(stateless_graph, {}, {}, {});
+    result.block_boundaries = {
+        {skippy_block_boundary_kind::entry, 0, input},
+        {skippy_block_boundary_kind::exit, 0, stateless_output},
+    };
+    if (skippy_graph_cache_capabilities(result) != dense) { return false; }
+
+    // Context-owned cross-attention state is missing even from full memory
+    // snapshots. Each input owner declares that fact without a family lookup.
+    result.add_input(std::make_unique<llm_graph_input_cross_embd>(nullptr));
+    if (skippy_graph_cache_capabilities(result) != 0) { return false; }
+    result.inputs.clear();
+    result.add_input(std::make_unique<llm_graph_input_attn_cross>(nullptr));
+    return skippy_graph_cache_capabilities(result) == 0;
+}
+
+int main() {
+    if (!graph_cache_capabilities_cover_complete_state()) {
+        fprintf(stderr, "graph cache capabilities do not cover complete state\n");
+        return 1;
+    }
+    std::unique_ptr<llama_model> model(llama_model_create(LLM_ARCH_LLAMA, llama_model_default_params()));
+    if (!model) {
+        fprintf(stderr, "failed to create test model\n");
+        return 1;
+    }
+    llama_hparams hparams = {};
+    hparams.n_layer_all = 2;
+    hparams.n_layer_nextn = 1;
+    hparams.n_embd_head_k_full = 4;
+    hparams.n_embd_head_v_full = 4;
+    hparams.n_embd_head_k_swa = 4;
+    hparams.n_embd_head_v_swa = 4;
+    hparams.n_embd_head_k_mla_impl = 4;
+    hparams.n_embd_head_v_mla_impl = 4;
+    hparams.n_head_arr[0] = 1;
+    hparams.n_head_kv_arr[0] = 1;
+
+    llama_kv_cache kv(
+            *model,
+            hparams,
+            GGML_TYPE_F32,
+            GGML_TYPE_F32,
+            true,
+            false,
+            true,
+            1,
+            1,
+            1,
+            0,
+            LLAMA_SWA_TYPE_NONE,
+            nullptr,
+            [](int32_t il) { return il == 0; },
+            {},
+            {});
+
+    if (skippy_memory_cache_capabilities(&kv) !=
+            (SKIPPY_MEMORY_CACHE_RESIDENT | SKIPPY_MEMORY_CACHE_KV_RECURRENT | SKIPPY_MEMORY_CACHE_FULL_STATE) ||
+            skippy_model_memory_cache_capabilities(nullptr) != 0) {
+        return 1;
+    }
+    unknown_kv_memory unknown(*model, hparams, GGML_TYPE_F32, GGML_TYPE_F32,
+            true, false, true, 1, 1, 1, 0, LLAMA_SWA_TYPE_NONE, nullptr,
+            [](int32_t il) { return il == 0; }, {}, {});
+    if (skippy_memory_cache_capabilities(&unknown) != SKIPPY_MEMORY_CACHE_FULL_STATE) {
+        return 1;
+    }
+
+    llama_pos pos = 0;
+    llama_seq_id seq_id = 0;
+    llama_seq_id * seq_ids = &seq_id;
+    int32_t n_seq_id = 1;
+    llama_ubatch ubatch = {};
+    ubatch.n_tokens = 1;
+    ubatch.n_pos = 1;
+    ubatch.pos = &pos;
+    ubatch.n_seq_id = &n_seq_id;
+    ubatch.seq_id = &seq_ids;
+
+    llama_kv_cache::slot_info slot = {};
+    slot.s0 = 0;
+    slot.s1 = 0;
+    slot.strm = { 0 };
+    slot.idxs = {{ 0 }};
+    kv.apply_ubatch(slot, ubatch);
+
+    skippy_kv_page_desc desc = {};
+    size_t payload_bytes = 0;
+    std::string error;
+    if (!kv.stage_export_kv_page(
+                0,
+                0,
+                1,
+                0,
+                1,
+                &desc,
+                nullptr,
+                0,
+                &payload_bytes,
+                error)) {
+        fprintf(stderr, "K-only KV page sizing failed: %s\n", error.c_str());
+        return 1;
+    }
+    if ((desc.flags & SKIPPY_KV_PAGE_FLAG_V_TRANSPOSED) == 0 ||
+            desc.v_row_bytes != 0 ||
+            desc.v_element_bytes != 0 ||
+            payload_bytes == 0) {
+        fprintf(stderr, "unexpected K-only transposed KV page descriptor\n");
+        return 1;
+    }
+
+    std::vector<uint8_t> payload(payload_bytes);
+    if (!kv.stage_export_kv_page(
+                0,
+                0,
+                1,
+                0,
+                1,
+                &desc,
+                payload.data(),
+                payload.size(),
+                &payload_bytes,
+                error)) {
+        fprintf(stderr, "K-only KV page export failed: %s\n", error.c_str());
+        return 1;
+    }
+
+    if (payload_bytes != payload.size()) {
+        fprintf(stderr, "K-only KV page export byte count mismatch\n");
+        return 1;
+    }
+
+    llama_kv_cache restore_kv(
+            *model,
+            hparams,
+            GGML_TYPE_F32,
+            GGML_TYPE_F32,
+            true,
+            false,
+            true,
+            1,
+            1,
+            1,
+            0,
+            LLAMA_SWA_TYPE_NONE,
+            nullptr,
+            [](int32_t il) { return il == 0; },
+            {},
+            {});
+    restore_kv.apply_ubatch(slot, ubatch);
+
+    desc.layer_end = 2;
+    if (!restore_kv.stage_import_kv_page(
+                0,
+                desc,
+                payload.data(),
+                payload.size(),
+                error)) {
+        fprintf(stderr, "K-only KV page import failed: %s\n", error.c_str());
+        return 1;
+    }
+
+    uint8_t empty_payload = 0;
+    skippy_kv_page_desc invalid_range_desc = desc;
+    invalid_range_desc.layer_start = 1;
+    invalid_range_desc.layer_end = 2;
+    invalid_range_desc.layer_count = 0;
+    invalid_range_desc.payload_bytes = 0;
+    if (restore_kv.stage_import_kv_page(
+                0,
+                invalid_range_desc,
+                &empty_payload,
+                0,
+                error)) {
+        fprintf(stderr, "out-of-bounds KV page layer range was accepted\n");
+        return 1;
+    }
+    if (restore_kv.seq_pos_min(0) != 0) {
+        fprintf(stderr, "out-of-bounds KV page import mutated the existing page\n");
+        return 1;
+    }
+    error.clear();
+
+    llama_kv_cache filtered_kv(
+            *model,
+            hparams,
+            GGML_TYPE_F32,
+            GGML_TYPE_F32,
+            true,
+            false,
+            true,
+            1,
+            1,
+            1,
+            0,
+            LLAMA_SWA_TYPE_NONE,
+            nullptr,
+            [](int32_t) { return false; },
+            {},
+            {});
+    filtered_kv.apply_ubatch(slot, ubatch);
+
+    skippy_kv_page_desc filtered_export_desc = {};
+    size_t filtered_export_bytes = 0;
+    if (filtered_kv.stage_export_kv_page(
+                0,
+                1,
+                2,
+                1,
+                1,
+                &filtered_export_desc,
+                nullptr,
+                0,
+                &filtered_export_bytes,
+                error)) {
+        fprintf(stderr, "empty KV page layer selection was exported\n");
+        return 1;
+    }
+    if (error != "no KV cache layers selected by layer range") {
+        fprintf(stderr, "empty KV page layer selection returned the wrong error: %s\n", error.c_str());
+        return 1;
+    }
+    error.clear();
+
+    skippy_kv_page_desc empty_range_desc = desc;
+    empty_range_desc.layer_count = 0;
+    empty_range_desc.payload_bytes = 0;
+    if (filtered_kv.stage_import_kv_page(
+                0,
+                empty_range_desc,
+                &empty_payload,
+                0,
+                error)) {
+        fprintf(stderr, "empty KV page layer selection was accepted\n");
+        return 1;
+    }
+    if (filtered_kv.seq_pos_min(0) != 0) {
+        fprintf(stderr, "empty KV page layer selection mutated the existing page\n");
+        return 1;
+    }
+    error.clear();
+
+    restore_kv.seq_cp(0, 1, 0, 1);
+    if (restore_kv.stage_import_kv_page(
+                0,
+                desc,
+                payload.data(),
+                payload.size(),
+                error)) {
+        fprintf(stderr, "KV page import unexpectedly allocated a shared occupied cell\n");
+        return 1;
+    }
+    if (restore_kv.seq_pos_min(0) != 0 || restore_kv.seq_pos_min(1) != 0) {
+        fprintf(stderr, "failed KV page allocation did not preserve the existing page\n");
+        return 1;
+    }
+    error.clear();
+
+    skippy_kv_page_desc roundtrip_desc = {};
+    size_t roundtrip_bytes = 0;
+    if (!restore_kv.stage_export_kv_page(
+                0,
+                0,
+                1,
+                0,
+                1,
+                &roundtrip_desc,
+                nullptr,
+                0,
+                &roundtrip_bytes,
+                error)) {
+        fprintf(stderr, "K-only KV page round-trip sizing failed: %s\n", error.c_str());
+        return 1;
+    }
+    if (roundtrip_bytes != payload.size() ||
+            roundtrip_desc.flags != desc.flags ||
+            roundtrip_desc.k_row_bytes != desc.k_row_bytes ||
+            roundtrip_desc.v_row_bytes != 0 ||
+            roundtrip_desc.v_element_bytes != 0) {
+        fprintf(stderr, "unexpected K-only transposed KV page round-trip descriptor\n");
+        return 1;
+    }
+    std::vector<uint8_t> roundtrip_payload(roundtrip_bytes);
+    if (!restore_kv.stage_export_kv_page(
+                0,
+                0,
+                1,
+                0,
+                1,
+                &roundtrip_desc,
+                roundtrip_payload.data(),
+                roundtrip_payload.size(),
+                &roundtrip_bytes,
+                error)) {
+        fprintf(stderr, "K-only KV page round-trip export failed: %s\n", error.c_str());
+        return 1;
+    }
+    if (roundtrip_payload != payload) {
+        fprintf(stderr, "K-only KV page payload changed after round trip\n");
+        return 1;
+    }
+
+    return 0;
+}
diff --git a/tests/test-skippy-model-loader-accounting.cpp b/tests/test-skippy-model-loader-accounting.cpp
new file mode 100644
index 000000000..22b92c0a8
--- /dev/null
+++ b/tests/test-skippy-model-loader-accounting.cpp
@@ -0,0 +1,320 @@
+#include "llama.h"
+#include "llama-model-loader.h"
+#include "skippy.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+struct progress_state {
+    float last = 0.0f;
+    bool bounded = true;
+    bool monotonic = true;
+    bool progressed_after_completion = false;
+    size_t completion_count = 0;
+};
+
+static bool observe_progress(float progress, void * user_data) {
+    auto * state = static_cast<progress_state *>(user_data);
+    constexpr float tolerance = 1e-6f;
+
+    state->bounded &= std::isfinite(progress) && progress >= -tolerance && progress <= 1.0f + tolerance;
+    state->monotonic &= progress + tolerance >= state->last;
+    if (progress == 1.0f) {
+        state->completion_count++;
+    } else if (state->completion_count > 0) {
+        state->progressed_after_completion = true;
+    }
+    state->last = progress;
+    return true;
+}
+
+static llama_model_loader make_loader(const char * model_path, llama_load_mode load_mode = LLAMA_LOAD_MODE_NONE) {
+    std::vector<std::string> splits;
+    return llama_model_loader(
+            nullptr,
+            nullptr,
+            nullptr,
+            model_path,
+            splits,
+            false,
+            nullptr,
+            load_mode,
+            false,
+            true,
+            false,
+            nullptr,
+            nullptr);
+}
+
+static bool check_exact_resident_selection(const char * model_path) {
+    llama_model_loader loader = make_loader(model_path);
+    std::unordered_set<std::string> resident_tensor_names;
+    for (const auto & [name, _] : loader.weights_map) {
+        resident_tensor_names.insert(name);
+    }
+    if (resident_tensor_names.empty()) {
+        std::fprintf(stderr, "model has no resident tensor names\n");
+        return false;
+    }
+
+    llama_model_params params = llama_model_default_params();
+    llama_model_loader_stage_selection selection;
+    selection.layer_start = 0;
+    selection.layer_end = 1;
+    selection.resident_tensor_names = resident_tensor_names;
+    llama_model * model = llama_model_load_from_file_with_selection(model_path, params, &selection);
+    if (model == nullptr) {
+        std::fprintf(stderr, "exact resident tensor selection rejected complete closure\n");
+        return false;
+    }
+    llama_model_free(model);
+
+    resident_tensor_names.insert("skippy.missing.admitted.tensor");
+    selection.resident_tensor_names = resident_tensor_names;
+    model = llama_model_load_from_file_with_selection(model_path, params, &selection);
+    if (model != nullptr) {
+        llama_model_free(model);
+        std::fprintf(stderr, "exact resident tensor selection accepted an absent tensor\n");
+        return false;
+    }
+    return true;
+}
+
+static ggml_context_ptr make_accounting_context(const ggml_tensor * weight) {
+    const size_t tensor_count = 2;
+    ggml_init_params params = {
+        /*.mem_size   =*/ tensor_count * ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx(ggml_init(params));
+    if (ctx == nullptr) {
+        return nullptr;
+    }
+
+    ggml_tensor * duplicate = ggml_dup_tensor(ctx.get(), weight);
+    ggml_set_name(duplicate, ggml_get_name(weight));
+    ggml_tensor * tied = ggml_dup_tensor(ctx.get(), weight);
+    ggml_set_name(tied, ggml_get_name(weight));
+    return ctx;
+}
+
+static ggml_context_ptr make_synthetic_context(const ggml_tensor * weight) {
+    ggml_init_params params = {
+        /*.mem_size   =*/ ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx(ggml_init(params));
+    if (ctx != nullptr) {
+        ggml_tensor * synthetic = ggml_dup_tensor(ctx.get(), weight);
+        ggml_set_name(synthetic, "skippy.synthetic.after-completion");
+    }
+    return ctx;
+}
+
+static std::vector<ggml_backend_buffer_t> make_buffer_list(ggml_backend_buffer_t buffer) {
+    return { buffer };
+}
+
+static bool check_context_load_lifecycle(const char * model_path) {
+    llama_model_loader loader = make_loader(model_path, LLAMA_LOAD_MODE_MMAP);
+    if (loader.weights_map.empty()) {
+        std::fprintf(stderr, "model has no weights\n");
+        return false;
+    }
+
+    const ggml_tensor * weight = loader.weights_map.begin()->second.tensor;
+    ggml_context_ptr accounting_ctx = make_accounting_context(weight);
+    ggml_context_ptr synthetic_ctx = make_synthetic_context(weight);
+    if (accounting_ctx == nullptr || synthetic_ctx == nullptr) {
+        std::fprintf(stderr, "failed to allocate accounting contexts\n");
+        return false;
+    }
+
+    ggml_context * accounting_ctx_raw = accounting_ctx.get();
+    ggml_context * synthetic_ctx_raw = synthetic_ctx.get();
+    const auto cpu_buft = ggml_backend_cpu_buffer_type();
+    loader.ctx_map.emplace(llama_model_loader::ctx_key{cpu_buft, /*lazy=*/false, /*resident=*/true}, std::move(accounting_ctx));
+    loader.init_mappings(false);
+
+    const size_t weight_size = ggml_nbytes(weight);
+    const size_t expected = 2 * weight_size;
+    if (loader.size_data != expected) {
+        std::fprintf(
+                stderr,
+                "context accounting mismatch: expected %zu bytes, got %zu\n",
+                expected,
+                loader.size_data);
+        return false;
+    }
+
+    ggml_backend_buffer_ptr accounting_buffer {
+        ggml_backend_alloc_ctx_tensors_from_buft(accounting_ctx_raw, cpu_buft)
+    };
+    ggml_backend_buffer_ptr synthetic_buffer {
+        ggml_backend_alloc_ctx_tensors_from_buft(synthetic_ctx_raw, cpu_buft)
+    };
+    if (accounting_buffer == nullptr || synthetic_buffer == nullptr) {
+        std::fprintf(stderr, "failed to allocate CPU accounting buffers\n");
+        return false;
+    }
+
+    std::vector<ggml_backend_buffer_t> accounting_buffers = make_buffer_list(accounting_buffer.get());
+    std::vector<ggml_backend_buffer_t> synthetic_buffers = make_buffer_list(synthetic_buffer.get());
+    progress_state progress;
+
+    if (!loader.load_all_data(accounting_ctx_raw, accounting_buffers, nullptr, observe_progress, &progress)) {
+        std::fprintf(stderr, "accounting context load was cancelled\n");
+        return false;
+    }
+    if (loader.size_done != loader.size_data) {
+        std::fprintf(
+                stderr,
+                "accounting context did not complete: loaded %zu of %zu bytes\n",
+                loader.size_done,
+                loader.size_data);
+        return false;
+    }
+    if (!loader.load_all_data(synthetic_ctx_raw, synthetic_buffers, nullptr, observe_progress, &progress)) {
+        std::fprintf(stderr, "synthetic context load was cancelled\n");
+        return false;
+    }
+    // The final 1.0 callback is emitted only after load_all_data tears down the
+    // mmap fragments. The post-completion synthetic-only context must not emit
+    // it again, so a single completion proves that cleanup ran exactly once.
+    if (!progress.bounded || !progress.monotonic || progress.completion_count != 1 ||
+            progress.progressed_after_completion) {
+        std::fprintf(stderr, "tied-weight progress lifecycle was invalid\n");
+        return false;
+    }
+    return true;
+}
+
+static bool check_contextless_fallback(const char * model_path) {
+    llama_model_loader loader = make_loader(model_path);
+    size_t expected = 0;
+    for (const auto & [_, weight] : loader.weights_map) {
+        expected += ggml_nbytes(weight.tensor);
+    }
+
+    loader.init_mappings(false);
+    if (loader.size_data != expected) {
+        std::fprintf(
+                stderr,
+                "contextless accounting mismatch: expected %zu bytes, got %zu\n",
+                expected,
+                loader.size_data);
+        return false;
+    }
+    return true;
+}
+
+static bool check_multilane_context_capacity(const char * model_path) {
+    skippy_runtime_config config = skippy_runtime_config_default();
+    config.ctx_size = 256;
+    config.lane_count = 3;
+    config.n_batch = 32;
+    config.n_ubatch = 32;
+
+    skippy_model * model = nullptr;
+    skippy_error * error = nullptr;
+    if (skippy_model_open(model_path, &config, &model, &error) != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "multi-lane model open failed: %s\n", error != nullptr ? error->message : "unknown error");
+        skippy_error_free(error);
+        return false;
+    }
+
+    skippy_session * session = nullptr;
+    if (skippy_session_create(model, &session, &error) != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "multi-lane session create failed: %s\n", error != nullptr ? error->message : "unknown error");
+        skippy_error_free(error);
+        skippy_model_free(model, nullptr);
+        return false;
+    }
+
+    const llama_context * context = skippy_session_llama_context(session);
+    const bool valid = context != nullptr && llama_n_ctx(context) == 3 * 256;
+    if (!valid) {
+        std::fprintf(
+                stderr,
+                "multi-lane context capacity mismatch: expected %d cells, got %u\n",
+                3 * 256,
+                context != nullptr ? llama_n_ctx(context) : 0);
+    }
+
+    skippy_session_free(session, nullptr);
+    skippy_model_free(model, nullptr);
+    return valid;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 2) {
+        std::fprintf(stderr, "usage: %s MODEL\n", argv[0]);
+        return EXIT_FAILURE;
+    }
+
+    llama_backend_init();
+
+    if (!check_context_load_lifecycle(argv[1]) ||
+            !check_contextless_fallback(argv[1]) ||
+            !check_exact_resident_selection(argv[1]) ||
+            !check_multilane_context_capacity(argv[1])) {
+        llama_backend_free();
+        return EXIT_FAILURE;
+    }
+
+    progress_state progress;
+    llama_model_params params = llama_model_default_params();
+    params.load_mode = LLAMA_LOAD_MODE_MMAP;
+    params.n_gpu_layers = 99;
+    params.progress_callback = observe_progress;
+    params.progress_callback_user_data = &progress;
+    llama_model_loader accounting_loader = make_loader(argv[1]);
+    std::unordered_set<std::string> resident_tensor_names;
+    for (const auto & [name, _] : accounting_loader.weights_map) {
+        resident_tensor_names.insert(name);
+    }
+
+    llama_model_loader_stage_selection selection;
+    selection.layer_start = 0;
+    selection.layer_end = 1;
+    selection.resident_tensor_names = resident_tensor_names;
+    llama_model * model = llama_model_load_from_file_with_selection(argv[1], params, &selection);
+
+    const bool loaded = model != nullptr;
+    if (model != nullptr) {
+        llama_model_free(model);
+    }
+    llama_backend_free();
+
+    if (!loaded) {
+        std::fprintf(stderr, "selected model load failed\n");
+        return EXIT_FAILURE;
+    }
+    if (!progress.bounded) {
+        std::fprintf(stderr, "model-load progress escaped [0, 1]\n");
+        return EXIT_FAILURE;
+    }
+    if (!progress.monotonic) {
+        std::fprintf(stderr, "model-load progress regressed\n");
+        return EXIT_FAILURE;
+    }
+    if (progress.completion_count != 1) {
+        std::fprintf(
+                stderr,
+                "model-load completion callback count mismatch: expected 1, got %zu\n",
+                progress.completion_count);
+        return EXIT_FAILURE;
+    }
+    if (progress.progressed_after_completion) {
+        std::fprintf(stderr, "model-load progress continued after completion\n");
+        return EXIT_FAILURE;
+    }
+
+    return EXIT_SUCCESS;
+}
diff --git a/tests/test-skippy-recurrent-state-roundtrip.cpp b/tests/test-skippy-recurrent-state-roundtrip.cpp
new file mode 100644
index 000000000..9ef80a6ce
--- /dev/null
+++ b/tests/test-skippy-recurrent-state-roundtrip.cpp
@@ -0,0 +1,159 @@
+#include "../src/llama-batch.h"
+#include "../src/llama-io.h"
+#include "../src/llama-memory-recurrent.h"
+#include "../src/llama-model.h"
+
+#include "ggml-backend.h"
+
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+class buffer_writer final : public llama_io_write_i {
+public:
+    void write(const void * src, size_t size) override {
+        const auto * bytes = static_cast<const uint8_t *>(src);
+        data.insert(data.end(), bytes, bytes + size);
+    }
+
+    void write_tensor(ggml_tensor * tensor, size_t offset, size_t size) override {
+        const size_t old_size = data.size();
+        data.resize(old_size + size);
+        ggml_backend_tensor_get(tensor, data.data() + old_size, offset, size);
+    }
+
+    size_t n_bytes() override {
+        return data.size();
+    }
+
+    std::vector<uint8_t> data;
+};
+
+class buffer_reader final : public llama_io_read_i {
+public:
+    explicit buffer_reader(const std::vector<uint8_t> & data) : data(data) {}
+
+    void read(void * dst, size_t size) override {
+        require(size);
+        std::memcpy(dst, data.data() + offset, size);
+        offset += size;
+    }
+
+    void read_tensor(ggml_tensor * tensor, size_t tensor_offset, size_t size) override {
+        require(size);
+        ggml_backend_tensor_set(tensor, data.data() + offset, tensor_offset, size);
+        offset += size;
+    }
+
+    size_t n_bytes() override {
+        return offset;
+    }
+
+private:
+    void require(size_t size) const {
+        if (size > data.size() - offset) {
+            throw std::runtime_error("unexpectedly reached end of recurrent-state buffer");
+        }
+    }
+
+    const std::vector<uint8_t> & data;
+    size_t offset = 0;
+};
+
+static llama_memory_recurrent make_memory(const llama_model & model) {
+    return llama_memory_recurrent(
+            model,
+            GGML_TYPE_F32,
+            GGML_TYPE_F32,
+            false,
+            4,
+            2,
+            0,
+            {});
+}
+
+int main() {
+    std::unique_ptr<llama_model> model(llama_model_create(LLM_ARCH_MAMBA, llama_model_default_params()));
+    if (!model) {
+        std::fprintf(stderr, "failed to create test model\n");
+        return 1;
+    }
+
+    model->hparams.n_layer_all = 1;
+    model->hparams.n_embd_r_impl = 4;
+    model->hparams.ssm_d_state = 2;
+    model->hparams.ssm_d_inner = 2;
+
+    auto source = make_memory(*model);
+    llama_pos source_pos = 7;
+    llama_seq_id source_seq_id = 0;
+    llama_seq_id * source_seq_ids = &source_seq_id;
+    int32_t source_n_seq_id = 1;
+    llama_ubatch source_batch = {};
+    source_batch.b_equal_seqs = 1;
+    source_batch.n_tokens = 1;
+    source_batch.n_seq_tokens = 1;
+    source_batch.n_seqs = 1;
+    source_batch.n_pos = 1;
+    source_batch.pos = &source_pos;
+    source_batch.n_seq_id = &source_n_seq_id;
+    source_batch.seq_id = &source_seq_ids;
+    if (!source.find_slot(source_batch)) {
+        std::fprintf(stderr, "failed to allocate source recurrent cell\n");
+        return 2;
+    }
+
+    const std::vector<float> source_r = { 1.0f, 2.0f, 3.0f, 4.0f };
+    const std::vector<float> source_s = { 5.0f, 6.0f, 7.0f, 8.0f };
+    ggml_backend_tensor_set(source.r_l[0], source_r.data(), 0, source_r.size() * sizeof(float));
+    ggml_backend_tensor_set(source.s_l[0], source_s.data(), 0, source_s.size() * sizeof(float));
+
+    buffer_writer writer;
+    source.state_write(writer, source_seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+
+    uint32_t cell_count = 0;
+    llama_pos serialized_pos = -1;
+    uint32_t serialized_n_seq_id = 1;
+    std::memcpy(&cell_count, writer.data.data(), sizeof(cell_count));
+    std::memcpy(&serialized_pos, writer.data.data() + sizeof(cell_count), sizeof(serialized_pos));
+    std::memcpy(
+            &serialized_n_seq_id,
+            writer.data.data() + sizeof(cell_count) + sizeof(serialized_pos),
+            sizeof(serialized_n_seq_id));
+    if (cell_count != 1 || serialized_pos != source_pos || serialized_n_seq_id != 0) {
+        std::fprintf(stderr, "unexpected single-sequence recurrent-state metadata\n");
+        return 3;
+    }
+
+    auto destination = make_memory(*model);
+    constexpr llama_seq_id destination_seq_id = 1;
+    buffer_reader reader(writer.data);
+    destination.state_read(reader, destination_seq_id, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+
+    if (reader.n_bytes() != writer.n_bytes()) {
+        std::fprintf(stderr, "recurrent-state round-trip byte count mismatch\n");
+        return 4;
+    }
+    if (destination.seq_pos_min(destination_seq_id) != source_pos ||
+            destination.seq_pos_max(destination_seq_id) != source_pos) {
+        std::fprintf(stderr, "recurrent-state position was not preserved across sequence ids\n");
+        return 5;
+    }
+    if (destination.seq_pos_min(source_seq_id) != -1) {
+        std::fprintf(stderr, "recurrent state retained the source sequence id\n");
+        return 6;
+    }
+
+    std::vector<float> restored_r(source_r.size());
+    std::vector<float> restored_s(source_s.size());
+    ggml_backend_tensor_get(destination.r_l[0], restored_r.data(), 0, restored_r.size() * sizeof(float));
+    ggml_backend_tensor_get(destination.s_l[0], restored_s.data(), 0, restored_s.size() * sizeof(float));
+    if (restored_r != source_r || restored_s != source_s) {
+        std::fprintf(stderr, "recurrent tensor data changed during cross-sequence restore\n");
+        return 7;
+    }
+
+    return 0;
+}
