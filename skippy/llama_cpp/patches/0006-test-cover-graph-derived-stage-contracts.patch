diff --git a/src/skippy/tests/graph_contract_checks.h b/src/skippy/tests/graph_contract_checks.h
new file mode 100644
index 000000000..69844b1f8
--- /dev/null
+++ b/src/skippy/tests/graph_contract_checks.h
@@ -0,0 +1,138 @@
+#pragma once
+#include <set>
+#include <stdexcept>
+#include "../../vendor/nlohmann/json.hpp"
+
+static std::string contract_string(const skippy_stage_plan * plan, skippy_stage_plan_string_ref_v1 ref) {
+    const char * data = nullptr;
+    size_t length = 0;
+    if (skippy_stage_plan_string_v1(plan, ref, &data, &length, nullptr) != SKIPPY_STATUS_OK) {
+        throw std::runtime_error("invalid contract string reference");
+    }
+    return std::string(data, length);
+}
+
+static std::set<std::string> contract_parameters(const skippy_stage_plan * plan) {
+    skippy_stage_plan_desc_v1 desc{};
+    if (skippy_stage_plan_describe_v1(plan, &desc, nullptr) != SKIPPY_STATUS_OK) {
+        throw std::runtime_error("invalid plan descriptor");
+    }
+    std::set<std::string> result;
+    for (size_t i = 0; i < desc.resident_tensor_count; ++i) {
+        skippy_stage_plan_value_desc_v1 value{};
+        if (skippy_stage_plan_resident_tensor_at_v1(plan, i, &value, nullptr) != SKIPPY_STATUS_OK) {
+            throw std::runtime_error("invalid parameter descriptor");
+        }
+        if (!result.insert(contract_string(plan, value.identity) + "=" + contract_string(plan, value.binding)).second) {
+            throw std::runtime_error("duplicate resident parameter");
+        }
+    }
+    if (result.empty()) { throw std::runtime_error("stage has no resident parameters"); }
+    return result;
+}
+
+static void check_state_ownership(const skippy_stage_plan * plan, bool causal = true) {
+    skippy_stage_plan_desc_v1 desc{};
+    if (skippy_stage_plan_describe_v1(plan, &desc, nullptr) != SKIPPY_STATUS_OK) {
+        throw std::runtime_error("invalid state plan descriptor");
+    }
+    for (size_t p = 0; p < desc.profile_count; ++p) {
+        skippy_stage_plan_profile_desc_v1 profile{};
+        if (skippy_stage_plan_profile_at_v1(plan, p, &profile, nullptr) != SKIPPY_STATUS_OK) {
+            throw std::runtime_error("invalid state profile descriptor");
+        }
+        if (causal && profile.state_effect_count == 0) { throw std::runtime_error("causal profile lost all state effects"); }
+        std::set<std::string> reads, writes;
+        for (size_t i = 0; i < profile.state_effect_count; ++i) {
+            skippy_stage_plan_state_desc_v1 state{};
+            if (skippy_stage_plan_state_at_v1(plan, p, i, &state, nullptr) != SKIPPY_STATUS_OK) {
+                throw std::runtime_error("invalid state descriptor");
+            }
+            if (state.residency == SKIPPY_STAGE_PLAN_STATE_LAYER_LOCAL &&
+                (state.layer < desc.layer_start || state.layer >= desc.layer_end)) {
+                throw std::runtime_error("stage accesses foreign layer-local state");
+            }
+            auto identity = contract_string(plan, state.identity);
+            if (identity.empty()) { throw std::runtime_error("state identity is empty"); }
+            (state.access == SKIPPY_STAGE_PLAN_STATE_READ ? reads : writes).insert(identity);
+        }
+        if (causal && (reads.empty() || writes.empty())) { throw std::runtime_error("causal profile lost state reads or writes"); }
+    }
+}
+
+static void check_mtp_contract(const skippy_stage_plan * plan, int32_t expected_heads) {
+    skippy_stage_plan_desc_v1 desc{};
+    if (skippy_stage_plan_describe_v1(plan, &desc, nullptr) != SKIPPY_STATUS_OK) {
+        throw std::runtime_error("invalid MTP plan descriptor");
+    }
+    const auto contract = nlohmann::json::parse(contract_string(plan, desc.execution_contract));
+    const auto & heads = contract.at("mtp");
+    if (heads.size() != size_t(expected_heads)) {
+        throw std::runtime_error("execution contract omitted or misplaced MTP heads");
+    }
+    std::set<std::string> residents;
+    for (size_t i = 0; i < desc.resident_tensor_count; ++i) {
+        skippy_stage_plan_value_desc_v1 value{};
+        if (skippy_stage_plan_resident_tensor_at_v1(plan, i, &value, nullptr) != SKIPPY_STATUS_OK) {
+            throw std::runtime_error("invalid MTP resident descriptor");
+        }
+        residents.insert(contract_string(plan, value.identity));
+    }
+    for (int32_t i = 0; i < expected_heads; ++i) {
+        if (heads.at(i).at("offset") != i || heads.at(i).at("parameters").empty()) {
+            throw std::runtime_error("MTP head lacks offset or parameters");
+        }
+        for (const auto & parameter : heads.at(i).at("parameters")) {
+            if (!residents.count(parameter.get<std::string>())) {
+                throw std::runtime_error("MTP parameter missing from terminal stage");
+            }
+        }
+    }
+}
+
+static std::set<std::string> contract_states(const skippy_stage_plan * plan) {
+    skippy_stage_plan_desc_v1 desc{};
+    if (skippy_stage_plan_describe_v1(plan, &desc, nullptr) != SKIPPY_STATUS_OK) {
+        throw std::runtime_error("invalid state plan descriptor");
+    }
+    std::set<std::string> result;
+    for (size_t p = 0; p < desc.profile_count; ++p) {
+        skippy_stage_plan_profile_desc_v1 profile{};
+        if (skippy_stage_plan_profile_at_v1(plan, p, &profile, nullptr) != SKIPPY_STATUS_OK) {
+            throw std::runtime_error("invalid state profile");
+        }
+        for (size_t i = 0; i < profile.state_effect_count; ++i) {
+            skippy_stage_plan_state_desc_v1 state{};
+            if (skippy_stage_plan_state_at_v1(plan, p, i, &state, nullptr) != SKIPPY_STATUS_OK) {
+                throw std::runtime_error("invalid state effect");
+            }
+            result.insert(contract_string(plan, profile.profile_id) + ":" +
+                    contract_string(plan, state.identity) + ":" + std::to_string(state.access));
+        }
+    }
+    return result;
+}
+
+static void check_invalid_contract_requests(skippy_stage_planner * planner,
+        skippy_stage_planner_config_v1 config, int32_t layers) {
+    const int32_t ranges[][2] = {{-1, layers}, {0, layers + 1}, {1, 1}, {2, 1}};
+    for (const auto & range : ranges) {
+        skippy_stage_plan * invalid = nullptr;
+        skippy_error * error = nullptr;
+        const auto status = skippy_stage_planner_realize_v1(planner, range[0], range[1], &invalid, &error);
+        const bool rejected = status == SKIPPY_STATUS_INVALID_ARGUMENT && invalid == nullptr;
+        skippy_stage_plan_free(invalid);
+        skippy_error_free(error);
+        if (!rejected) { throw std::runtime_error("invalid stage range was admitted"); }
+    }
+    skippy_stage_planner_profile_v1 invalid_profile{1, sizeof(invalid_profile), "invalid", 1, 1, 2, 0};
+    config.profiles = &invalid_profile;
+    config.profile_count = 1;
+    skippy_stage_planner * invalid = nullptr;
+    skippy_error * error = nullptr;
+    const auto status = skippy_stage_planner_create_v1(&config, &invalid, &error);
+    const bool rejected = status == SKIPPY_STATUS_INVALID_ARGUMENT && invalid == nullptr;
+    skippy_stage_planner_free(invalid);
+    skippy_error_free(error);
+    if (!rejected) { throw std::runtime_error("impossible output profile was admitted"); }
+}
diff --git a/src/skippy/tests/graph_contract_models.cpp b/src/skippy/tests/graph_contract_models.cpp
new file mode 100644
index 000000000..d22503d9e
--- /dev/null
+++ b/src/skippy/tests/graph_contract_models.cpp
@@ -0,0 +1,221 @@
+#include "ggml.h"
+#include "gguf.h"
+#include "skippy/stage_plan.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "graph_contract_checks.h"
+#include "../../vendor/nlohmann/json.hpp"
+
+// Validate real architecture graphs using sparse synthetic GGUFs, without inference.
+static int run_contract(int argc, char ** argv) {
+    if (argc != 2 && argc != 3) {
+        std::fprintf(stderr, "usage: %s model.gguf [causal|stateless|shared-kv-18|encoder-decoder-rejection]\n", argv[0]);
+        return 1;
+    }
+    ggml_context * raw_context = nullptr;
+    gguf_init_params params{true, &raw_context};
+    std::unique_ptr<gguf_context, decltype(&gguf_free)> metadata(
+            gguf_init_from_file(argv[1], params), gguf_free);
+    std::unique_ptr<ggml_context, decltype(&ggml_free)> context(raw_context, ggml_free);
+    if (!metadata || !context) {
+        return 1;
+    }
+    const auto * arch = gguf_get_val_str(metadata.get(), gguf_find_key(metadata.get(), "general.architecture"));
+    const std::string layers_key = std::string(arch) + ".block_count";
+    const std::string mtp_key = std::string(arch) + ".nextn_predict_layers";
+    const int64_t mtp_index = gguf_find_key(metadata.get(), mtp_key.c_str());
+    const int32_t mtp_layers = mtp_index < 0 ? 0 : gguf_get_val_u32(metadata.get(), mtp_index);
+    const int32_t layers = gguf_get_val_u32(metadata.get(), gguf_find_key(metadata.get(), layers_key.c_str())) - mtp_layers;
+    const std::string mode = argc == 3 ? argv[2] : "causal";
+    const int32_t shared_tail = mode == "shared-kv-18" ? 18 : mode == "shared-kv-22" ? 22 : layers;
+    std::vector<skippy_stage_planner_tensor_v1> tensors;
+    for (int64_t index = 0; index < gguf_get_n_tensors(metadata.get()); ++index) {
+        const char * name = gguf_get_tensor_name(metadata.get(), index);
+        const auto * source = ggml_get_tensor(context.get(), name);
+        skippy_stage_planner_tensor_v1 tensor{};
+        tensor.abi_version = 1;
+        tensor.struct_size = sizeof(tensor);
+        tensor.tensor_id = name;
+        tensor.native_name = name;
+        tensor.ggml_type = source->type;
+        tensor.dimension_count = ggml_n_dims(source);
+        std::copy(source->ne, source->ne + 4, tensor.dimensions);
+        tensor.data_offset = gguf_get_data_offset(metadata.get()) + gguf_get_tensor_offset(metadata.get(), index);
+        tensor.stored_length = ggml_nbytes(source);
+        tensors.push_back(tensor);
+    }
+    std::sort(tensors.begin(), tensors.end(), [](const auto & left, const auto & right) {
+        return std::string(left.tensor_id) < std::string(right.tensor_id);
+    });
+    const skippy_stage_planner_profile_v1 profiles[] = {
+        {1, sizeof(skippy_stage_planner_profile_v1), "batched-decode", 2, 2, 2, 0},
+        {1, sizeof(skippy_stage_planner_profile_v1), "decode", 1, 1, 1, 0},
+        {1, sizeof(skippy_stage_planner_profile_v1), "prefill", 8, 1, 8, 0},
+        {1, sizeof(skippy_stage_planner_profile_v1), "prefill-last", 8, 1, 1, 0},
+    };
+    const char * paths[] = {argv[1]};
+    const std::string package_id = "sha256:" + std::string(64, 'a');
+    skippy_stage_planner_config_v1 config{1, sizeof(config), package_id.c_str(),
+        paths, 1, tensors.data(), tensors.size(), profiles, 4, "test.graph", "test.cpu"};
+    skippy_error * error = nullptr;
+    skippy_stage_planner * planner = nullptr;
+    auto status = skippy_stage_planner_create_v1(&config, &planner, &error);
+    std::unique_ptr<skippy_stage_planner, decltype(&skippy_stage_planner_free)> owner(planner, skippy_stage_planner_free);
+    if (status != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "planner creation failed: %s\n", error ? error->message : "unknown");
+        skippy_error_free(error);
+        return 1;
+    }
+    check_invalid_contract_requests(planner, config, layers);
+    if (mode == "encoder-decoder-rejection") {
+        for (int32_t start = 0; start < layers; ++start) {
+            skippy_stage_plan * rejected = nullptr;
+            status = skippy_stage_planner_realize_v1(planner, start, layers, &rejected, &error);
+            if (status != SKIPPY_STATUS_UNSUPPORTED || rejected != nullptr || error == nullptr ||
+                    std::string(error->message) != "stage planner does not support encoder-decoder cross-attention") {
+                skippy_stage_plan_free(rejected);
+                skippy_error_free(error);
+                throw std::runtime_error("encoder-decoder staging must reject before graph construction");
+            }
+            skippy_error_free(error);
+            error = nullptr;
+        }
+        return 0;
+    }
+    skippy_stage_plan * whole_raw = nullptr;
+    if (skippy_stage_planner_realize_v1(planner, 0, layers, &whole_raw, &error) != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "whole-model plan failed: %s\n", error ? error->message : "unknown");
+        skippy_error_free(error);
+        return 1;
+    }
+    std::unique_ptr<skippy_stage_plan, decltype(&skippy_stage_plan_free)> whole(whole_raw, skippy_stage_plan_free);
+    const auto all_parameters = contract_parameters(whole.get());
+    const auto all_states = contract_states(whole.get());
+    if (mode == "stateless" && !all_states.empty()) {
+        throw std::runtime_error("stateless graph contract unexpectedly owns mutable state");
+    }
+    check_state_ownership(whole.get(), mode != "stateless");
+    check_mtp_contract(whole.get(), mtp_layers);
+    // Balanced canary cuts, edge cuts, and a multi-stage chain exercise forwarding.
+    std::vector<std::vector<int32_t>> chains = {
+        {0, 1, layers}, {0, layers / 2, layers}, {0, layers - 1, layers},
+        {0, layers / 3, (2 * layers + 1) / 3, layers},
+    };
+    for (int32_t cut = 2; cut < layers - 1; ++cut) { chains.push_back({0, cut, layers}); }
+    for (const auto & cuts : chains) {
+        const bool forbidden_cut = std::any_of(cuts.begin() + 1, cuts.end() - 1,
+                [shared_tail](int32_t cut) { return cut > shared_tail; });
+        std::vector<std::unique_ptr<skippy_stage_plan, decltype(&skippy_stage_plan_free)>> owned;
+        std::vector<const skippy_stage_plan *> chain;
+        std::set<std::string> resident_union, state_union;
+        for (size_t i = 1; i < cuts.size(); ++i) {
+            skippy_stage_plan * plan = nullptr;
+            status = skippy_stage_planner_realize_v1(planner, cuts[i-1], cuts[i], &plan, &error);
+            owned.emplace_back(plan, skippy_stage_plan_free);
+            if (status != SKIPPY_STATUS_OK) { break; }
+            skippy_stage_plan_desc_v1 descriptor{};
+            status = skippy_stage_plan_describe_v1(plan, &descriptor, &error);
+            if (status != SKIPPY_STATUS_OK) { break; }
+            if (descriptor.profile_count != (mode == "causal-tokens" ? 4u : 8u)) {
+                std::fprintf(stderr, "expected token and embedding decode/prefill profiles, got %zu\n", size_t(descriptor.profile_count));
+                return 1;
+            }
+            std::vector<std::string> names;
+            for (size_t profile_index = 0; profile_index < descriptor.profile_count; ++profile_index) {
+                skippy_stage_plan_profile_desc_v1 profile{};
+                const char * name = nullptr;
+                size_t length = 0;
+                if (skippy_stage_plan_profile_at_v1(plan, profile_index, &profile, &error) != SKIPPY_STATUS_OK ||
+                    skippy_stage_plan_string_v1(plan, profile.profile_id, &name, &length, &error) != SKIPPY_STATUS_OK) {
+                    std::fprintf(stderr, "cannot inspect planned profile\n");
+                    skippy_error_free(error);
+                    return 1;
+                }
+                names.emplace_back(name, length);
+            }
+            std::sort(names.begin(), names.end());
+            std::vector<std::string> expected_names{"batched-decode", "decode", "prefill", "prefill-last"};
+            if (mode != "causal-tokens") {
+                expected_names.insert(expected_names.end(), {"embeddings:batched-decode", "embeddings:decode", "embeddings:prefill", "embeddings:prefill-last"});
+                std::sort(expected_names.begin(), expected_names.end());
+            }
+            if (names != expected_names) {
+                std::fprintf(stderr, "planned profile identities differ from requested input modes\n");
+                return 1;
+            }
+            auto resident = contract_parameters(plan);
+            resident_union.insert(resident.begin(), resident.end());
+            check_state_ownership(plan, false);
+            const auto states = contract_states(plan);
+            state_union.insert(states.begin(), states.end());
+            check_mtp_contract(plan, cuts[i] == layers ? mtp_layers : 0);
+            chain.push_back(plan);
+        }
+        if (forbidden_cut) {
+            if (status != SKIPPY_STATUS_UNSUPPORTED || !error ||
+                std::string(error->message).find("owned outside the requested slice") == std::string::npos) {
+                std::fprintf(stderr, "shared-KV cut must reject foreign state ownership\n");
+                skippy_error_free(error);
+                return 1;
+            }
+            skippy_error_free(error);
+            error = nullptr;
+            continue;
+        }
+        if (status == SKIPPY_STATUS_OK) {
+            status = skippy_stage_plan_validate_chain_v1(chain.data(), chain.size(), &error);
+        }
+        if (status != SKIPPY_STATUS_OK) {
+            std::fprintf(stderr, "%s split %d: %s\n", arch, cuts[1], error ? error->message : "unknown");
+            skippy_error_free(error);
+            return 1;
+        }
+        if (state_union != all_states) {
+            throw std::runtime_error("split state effects differ from whole-model plan");
+        }
+        if (resident_union != all_parameters) {
+            std::fprintf(stderr, "split parameter closure differs from whole-model plan\n");
+            return 1;
+        }
+        // A missing middle stage must not be accepted as a complete contract.
+        if (chain.size() == 3) {
+            const skippy_stage_plan * gap[] = {chain.front(), chain.back()};
+            if (skippy_stage_plan_validate_chain_v1(gap, 2, &error) == SKIPPY_STATUS_OK) {
+                std::fprintf(stderr, "accepted a chain with a missing stage\n");
+                return 1;
+            }
+            skippy_error_free(error);
+            error = nullptr;
+        }
+    }
+    config.backend_id = "test.other-backend";
+    skippy_stage_planner * other_raw = nullptr;
+    if (skippy_stage_planner_create_v1(&config, &other_raw, &error) != SKIPPY_STATUS_OK) { return 1; }
+    std::unique_ptr<skippy_stage_planner, decltype(&skippy_stage_planner_free)> other(other_raw, skippy_stage_planner_free);
+    skippy_stage_plan * left_raw = nullptr, * right_raw = nullptr;
+    if (skippy_stage_planner_realize_v1(planner, 0, layers / 2, &left_raw, &error) != SKIPPY_STATUS_OK ||
+        skippy_stage_planner_realize_v1(other.get(), layers / 2, layers, &right_raw, &error) != SKIPPY_STATUS_OK) { return 1; }
+    std::unique_ptr<skippy_stage_plan, decltype(&skippy_stage_plan_free)> left(left_raw, skippy_stage_plan_free), right(right_raw, skippy_stage_plan_free);
+    const skippy_stage_plan * incompatible[] = {left.get(), right.get()};
+    if (skippy_stage_plan_validate_chain_v1(incompatible, 2, &error) == SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "accepted incompatible backend contracts\n");
+        return 1;
+    }
+    skippy_error_free(error);
+    return 0;
+}
+
+int main(int argc, char ** argv) {
+    try {
+        return run_contract(argc, argv);
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "graph contract failed for %s: %s\n", argc > 1 ? argv[1] : "unknown model", error.what());
+        return 1;
+    }
+}
diff --git a/src/skippy/tests/hardware_application_probe.cpp b/src/skippy/tests/hardware_application_probe.cpp
new file mode 100644
index 000000000..471968158
--- /dev/null
+++ b/src/skippy/tests/hardware_application_probe.cpp
@@ -0,0 +1,76 @@
+#include "skippy/model_load_config_internal.h"
+#include "skippy/runtime.h"
+
+#include <cstdio>
+
+static bool require(bool condition, const char * message) {
+    if (!condition) {
+        std::fprintf(stderr, "%s\n", message);
+    }
+    return condition;
+}
+
+int main() {
+    skippy_runtime_config config = skippy_runtime_config_default();
+    bool passed = true;
+    passed &= require(config.cache_type_k == GGML_TYPE_F16,
+            "default K cache type must be F16");
+    passed &= require(config.cache_type_v == GGML_TYPE_F16,
+            "default V cache type must be F16");
+    passed &= require(config.kv_offload == SKIPPY_TRISTATE_AUTO,
+            "default kv_offload must preserve the derived default");
+    passed &= require(config.kv_unified == SKIPPY_TRISTATE_AUTO,
+            "default kv_unified must preserve the derived default");
+    passed &= require(config.swa_full == SKIPPY_TRISTATE_AUTO,
+            "default swa_full must preserve the derived default");
+    passed &= require(config.op_offload == SKIPPY_TRISTATE_AUTO,
+            "default op_offload must preserve the derived default");
+    passed &= require(config.split_mode == SKIPPY_TRISTATE_AUTO,
+            "default split_mode must preserve the derived default");
+
+    config.use_direct_io = true;
+    config.use_mlock = true;
+    config.has_mmap_override = true;
+    config.use_mmap = true;
+    config.no_host_buffer = true;
+    config.check_tensors = true;
+    config.has_main_gpu_override = true;
+    config.main_gpu = 2;
+    config.split_mode = LLAMA_SPLIT_MODE_ROW;
+    config.disable_repack = true;
+
+    llama_model_params model_params = llama_model_default_params();
+    skippy_apply_model_load_memory_config(&config, model_params);
+
+    passed &= require(model_params.load_mode == LLAMA_LOAD_MODE_DIRECT_IO,
+            "direct I/O must take precedence over mmap and mlock");
+    passed &= require(model_params.main_gpu == 2, "main_gpu override was not applied");
+    passed &= require(model_params.split_mode == LLAMA_SPLIT_MODE_ROW, "split mode was not applied");
+    passed &= require(model_params.no_host, "host-buffer policy was not applied");
+    passed &= require(model_params.check_tensors, "tensor checking was not applied");
+    passed &= require(!model_params.use_extra_bufts, "disabled repack must disable extra buffer types");
+
+    llama_context_params context_params = llama_context_default_params();
+    context_params.op_offload = true;
+    config.op_offload = SKIPPY_TRISTATE_AUTO;
+    skippy_apply_context_hardware_config(&config, context_params);
+    passed &= require(context_params.op_offload, "auto op_offload must preserve the derived default");
+
+    config.cache_type_k = GGML_TYPE_F32;
+    config.cache_type_v = GGML_TYPE_F32;
+    skippy_apply_context_hardware_config(&config, context_params);
+    passed &= require(context_params.type_k == GGML_TYPE_F32,
+            "explicit F32 K cache type must not fall back to F16");
+    passed &= require(context_params.type_v == GGML_TYPE_F32,
+            "explicit F32 V cache type must not fall back to F16");
+
+    config.op_offload = SKIPPY_TRISTATE_FALSE;
+    skippy_apply_context_hardware_config(&config, context_params);
+    passed &= require(!context_params.op_offload, "false op_offload override was not applied");
+
+    config.op_offload = SKIPPY_TRISTATE_TRUE;
+    skippy_apply_context_hardware_config(&config, context_params);
+    passed &= require(context_params.op_offload, "true op_offload override was not applied");
+
+    return passed ? 0 : 1;
+}
diff --git a/src/skippy/tests/input_capabilities.cpp b/src/skippy/tests/input_capabilities.cpp
new file mode 100644
index 000000000..a87425e96
--- /dev/null
+++ b/src/skippy/tests/input_capabilities.cpp
@@ -0,0 +1,78 @@
+#include "ggml.h"
+#include "gguf.h"
+#include "skippy/stage_plan.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <memory>
+#include <string>
+#include <vector>
+
+// Realize a stage from a synthetic GGUF without reading any weight payloads.
+// The expected profile count distinguishes token-only from embedding-capable graphs.
+int main(int argc, char ** argv) {
+    if (argc != 3) {
+        std::fprintf(stderr, "usage: %s model.gguf expected-profiles\n", argv[0]);
+        return 1;
+    }
+    ggml_context * raw_context = nullptr;
+    gguf_init_params params{true, &raw_context};
+    std::unique_ptr<gguf_context, decltype(&gguf_free)> metadata(
+            gguf_init_from_file(argv[1], params), gguf_free);
+    std::unique_ptr<ggml_context, decltype(&ggml_free)> context(raw_context, ggml_free);
+    if (!metadata || !context) {
+        return 1;
+    }
+    const auto * arch = gguf_get_val_str(metadata.get(), gguf_find_key(metadata.get(), "general.architecture"));
+    const std::string layers_key = std::string(arch) + ".block_count";
+    const int32_t layers = gguf_get_val_u32(metadata.get(), gguf_find_key(metadata.get(), layers_key.c_str()));
+    std::vector<skippy_stage_planner_tensor_v1> tensors;
+    for (int64_t index = 0; index < gguf_get_n_tensors(metadata.get()); ++index) {
+        const char * name = gguf_get_tensor_name(metadata.get(), index);
+        const auto * source = ggml_get_tensor(context.get(), name);
+        skippy_stage_planner_tensor_v1 tensor{};
+        tensor.abi_version = 1;
+        tensor.struct_size = sizeof(tensor);
+        tensor.tensor_id = name;
+        tensor.native_name = name;
+        tensor.ggml_type = source->type;
+        tensor.dimension_count = ggml_n_dims(source);
+        std::copy(source->ne, source->ne + 4, tensor.dimensions);
+        tensor.data_offset = gguf_get_data_offset(metadata.get()) + gguf_get_tensor_offset(metadata.get(), index);
+        tensor.stored_length = ggml_nbytes(source);
+        tensors.push_back(tensor);
+    }
+    std::sort(tensors.begin(), tensors.end(), [](const auto & left, const auto & right) {
+        return std::string(left.tensor_id) < std::string(right.tensor_id);
+    });
+    const skippy_stage_planner_profile_v1 profile{1, sizeof(profile), "prefill", 8, 1, 8, 0};
+    const char * paths[] = {argv[1]};
+    const std::string package_id = "sha256:" + std::string(64, 'a');
+    skippy_stage_planner_config_v1 config{1, sizeof(config), package_id.c_str(),
+        paths, 1, tensors.data(), tensors.size(), &profile, 1, "test.graph", "test.cpu"};
+    skippy_error * error = nullptr;
+    skippy_stage_planner * planner = nullptr;
+    auto status = skippy_stage_planner_create_v1(&config, &planner, &error);
+    std::unique_ptr<skippy_stage_planner, decltype(&skippy_stage_planner_free)> owner(planner, skippy_stage_planner_free);
+    skippy_stage_plan * plan = nullptr;
+    if (status == SKIPPY_STATUS_OK) {
+        status = skippy_stage_planner_realize_v1(planner, 0, layers, &plan, &error);
+    }
+    std::unique_ptr<skippy_stage_plan, decltype(&skippy_stage_plan_free)> plan_owner(plan, skippy_stage_plan_free);
+    skippy_stage_plan_desc_v1 descriptor{};
+    if (status == SKIPPY_STATUS_OK) {
+        status = skippy_stage_plan_describe_v1(plan, &descriptor, &error);
+    }
+    if (status != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "planning failed: %s\n", error ? error->message : "unknown");
+        skippy_error_free(error);
+        return 1;
+    }
+    const size_t expected = std::strtoul(argv[2], nullptr, 10);
+    if (descriptor.profile_count != expected) {
+        std::fprintf(stderr, "expected %zu profiles, got %zu\n", expected, descriptor.profile_count);
+        return 1;
+    }
+    return 0;
+}
diff --git a/src/skippy/tests/input_leaf_state_regression.h b/src/skippy/tests/input_leaf_state_regression.h
new file mode 100644
index 000000000..33d3faca9
--- /dev/null
+++ b/src/skippy/tests/input_leaf_state_regression.h
@@ -0,0 +1,49 @@
+#pragma once
+
+static int check_input_leaf_state_inference() {
+    ggml_init_params params = {ggml_tensor_overhead() * 32 + ggml_graph_overhead_custom(32, false), nullptr, true};
+    ggml_context_ptr ctx(ggml_init(params));
+    auto * input = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 4);
+    auto * absent = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 4);
+    auto * state = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 4);
+    ggml_set_input(input);
+    ggml_set_input(absent);
+    std::unique_ptr<ggml_backend_buffer, decltype(&ggml_backend_buffer_free)> buffer(
+            ggml_backend_buft_alloc_buffer(ggml_backend_cpu_buffer_type(), ggml_nbytes(state)), ggml_backend_buffer_free);
+    if (!buffer) { return 92; }
+    state->buffer = buffer.get();
+    auto * first = ggml_scale(ctx.get(), input, 2.0f);
+    auto * write = ggml_cpy(ctx.get(), first, state);
+    auto * output = ggml_add(ctx.get(), first, state);
+    auto * graph = ggml_new_graph_custom(ctx.get(), 32, false);
+    ggml_build_forward_expand(graph, write);
+    ggml_build_forward_expand(graph, output);
+    std::vector<skippy_block_boundary> boundaries = {
+        {skippy_block_boundary_kind::entry, 0, input},
+        {skippy_block_boundary_kind::exit, 0, output},
+    };
+    std::vector<skippy_state_effect> effects;
+    std::string error;
+    if (!skippy_infer_state_effects({}, graph, boundaries, effects, error) || effects.size() != 2 ||
+        effects[0].access != skippy_state_access::read || effects[1].access != skippy_state_access::write ||
+        effects[1].layer != 0 || effects[1].storage != state || effects[1].effect_node != write ||
+        effects[1].write_ordinal != 0 || effects[1].kind != skippy_state_kind::derived_persistent) {
+        std::fprintf(stderr, "input-leaf state inference failed: %s\n", error.c_str());
+        return 93;
+    }
+    // A leaf outside this graph and a missing exit remain invalid boundaries.
+    boundaries[0].tensor = absent;
+    if (skippy_infer_state_effects({}, graph, boundaries, effects, error)) { return 94; }
+    boundaries[0].tensor = input;
+    boundaries[1].tensor = absent;
+    if (skippy_infer_state_effects({}, graph, boundaries, effects, error)) { return 95; }
+    // Only the initial block can start before executable graph nodes.
+    boundaries = {
+        {skippy_block_boundary_kind::entry, 0, input},
+        {skippy_block_boundary_kind::exit, 0, first},
+        {skippy_block_boundary_kind::entry, 1, input},
+        {skippy_block_boundary_kind::exit, 1, output},
+    };
+    if (skippy_infer_state_effects({}, graph, boundaries, effects, error)) { return 96; }
+    return 0;
+}
diff --git a/src/skippy/tests/live_graph_reference.h b/src/skippy/tests/live_graph_reference.h
new file mode 100644
index 000000000..73129bf07
--- /dev/null
+++ b/src/skippy/tests/live_graph_reference.h
@@ -0,0 +1,194 @@
+#pragma once
+
+#include "llama-context.h"
+#include "llama-model.h"
+#include "skippy/runtime_types.h"
+#include "skippy/execution.h"
+#include "skippy/activation_internal.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <optional>
+#include <string>
+#include <vector>
+
+// Compare ordinary context graph reuse with a separately loaded context that
+// rebuilds at each shape. Serialized sequence state avoids a second, per-cache
+// description of which storage belongs to a model's recurrent/attention state.
+struct live_graph_snapshot {
+    std::vector<float> logits;
+    std::vector<uint8_t> state;
+};
+
+class fresh_graph_scope {
+public:
+    explicit fresh_graph_scope(bool enabled) : enabled(enabled) {
+        if (!enabled) return;
+        if (const char * value = std::getenv("LLAMA_GRAPH_REUSE_DISABLE")) previous = value;
+        set("1");
+    }
+    ~fresh_graph_scope() {
+        if (enabled) set(previous ? previous->c_str() : nullptr);
+    }
+private:
+    bool enabled;
+    std::optional<std::string> previous;
+    static void set(const char * value) {
+#ifdef _WIN32
+        _putenv_s("LLAMA_GRAPH_REUSE_DISABLE", value ? value : "");
+#else
+        if (value) setenv("LLAMA_GRAPH_REUSE_DISABLE", value, 1);
+        else unsetenv("LLAMA_GRAPH_REUSE_DISABLE");
+#endif
+    }
+};
+
+class live_graph_reference {
+public:
+    ~live_graph_reference() {
+        skippy_error * error = nullptr;
+        if (session) skippy_session_free(session, &error);
+        skippy_error_free(error);
+        error = nullptr;
+        if (model) skippy_model_free(model, &error);
+        skippy_error_free(error);
+    }
+
+    bool open(const std::vector<const char *> & parts, const skippy_runtime_config & config) {
+        fresh_graph_scope fresh(true);
+        skippy_error * error = nullptr;
+        const auto status = skippy_model_open_from_parts(parts.data(), parts.size(), &config, &model, &error);
+        if (!finished(status, error) || !model) return false;
+        error = nullptr;
+        const auto session_status = skippy_session_create(model, &session, &error);
+        return finished(session_status, error);
+    }
+
+    void clear_with(skippy_model * actual) {
+        llama_memory_clear(llama_get_memory(actual->ctx), true);
+        llama_memory_clear(llama_get_memory(model->ctx), true);
+    }
+
+    bool prefill(const llama_token * tokens, size_t count, const live_graph_reference * source = nullptr) {
+        skippy_error * error = nullptr;
+        const auto status = skippy_prefill_chunk_frame(session, tokens, count,
+                source ? &source->desc : nullptr, source ? source->payload.data() : nullptr,
+                &desc, payload.data(), payload.size(), &bytes, &error);
+        return finished(status, error);
+    }
+
+    bool step(llama_token token, const skippy_sampling_config * sampling,
+            llama_token expected, const live_graph_reference * source = nullptr) {
+        skippy_error * error = nullptr;
+        llama_token prediction = -1;
+        const auto status = skippy_decode_step_frame_sampled(session, token, sampling,
+                source ? &source->desc : nullptr, source ? source->payload.data() : nullptr,
+                &desc, payload.data(), payload.size(), &bytes, &prediction, &error);
+        return finished(status, error) && (expected < 0 || prediction == expected);
+    }
+
+    bool compare(skippy_model * actual, bool logits) const {
+        live_graph_snapshot left, right;
+        return snapshot(actual->ctx, session->seq_id, left, logits) &&
+               snapshot(model->ctx, session->seq_id, right, logits) && compare_snapshots(left, right);
+    }
+
+    static bool snapshot(llama_context * context, llama_seq_id seq, live_graph_snapshot & output,
+            bool logits = true) {
+        llama_synchronize(context);
+        if (logits) {
+            const auto count = llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(context)));
+            const float * values = llama_get_logits_ith(context, -1);
+            if (!values) return false;
+            output.logits.assign(values, values + count);
+        }
+        const auto size = llama_state_seq_get_size(context, seq);
+        if (size == 0) return false;
+        output.state.resize(size);
+        return llama_state_seq_get_data(context, output.state.data(), size, seq) == size;
+    }
+
+    static bool compare_snapshots(const live_graph_snapshot & left, const live_graph_snapshot & right) {
+        if (left.logits.size() != right.logits.size() || left.state != right.state) {
+            std::fprintf(stderr, "fresh/reused graph sequence-state mismatch\n");
+            return false;
+        }
+        for (size_t index = 0; index < left.logits.size(); ++index) {
+            const float a = left.logits[index], b = right.logits[index];
+            if (!std::isfinite(a) || !std::isfinite(b) || std::abs(a - b) > 1e-5f * (1 + std::abs(b))) {
+                std::fprintf(stderr, "fresh/reused graph logit mismatch at %zu\n", index);
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static bool check_capacity_preflight(skippy_session * actual, const llama_token * tokens, size_t count) {
+        live_graph_snapshot before, after;
+        if (!snapshot(actual->ctx, actual->seq_id, before, false)) return false;
+        const auto position = actual->n_past;
+        uint8_t payload = 0;
+        size_t required = 0;
+        skippy_activation_desc desc{};
+        skippy_error * error = nullptr;
+        const auto status = skippy_prefill_chunk_frame(actual, tokens, count, nullptr, nullptr,
+                &desc, &payload, 1, &required, &error);
+        skippy_error_free(error);
+        return status == SKIPPY_STATUS_BUFFER_TOO_SMALL && required > 1 && actual->n_past == position &&
+               !actual->reset_required && snapshot(actual->ctx, actual->seq_id, after, false) &&
+               before.state == after.state;
+    }
+
+    static bool check_activation_prefill_sampling(skippy_session * actual,
+            const llama_token * tokens, size_t count) {
+        skippy_error * error = nullptr;
+        auto status = skippy_session_configure_chat_sampling(
+                actual, nullptr, "{\"grammar\":\"\"}", 0, &error);
+        if (!finished(status, error)) return false;
+        if (actual->sampling_backend_enabled) {
+            std::fprintf(stderr, "activation-export stage attached a single-output backend sampler\n");
+            return false;
+        }
+        std::vector<uint8_t> payload(1024 * 1024);
+        for (int pass = 0; pass < 2; ++pass) {
+            skippy_activation_desc desc{};
+            size_t bytes = 0;
+            status = skippy_prefill_chunk_frame(actual, tokens, count, nullptr, nullptr,
+                    &desc, payload.data(), payload.size(), &bytes, &error);
+            if (!finished(status, error) || bytes == 0 || desc.part_count == 0) return false;
+            error = nullptr;
+            status = skippy_session_reset(actual, &error);
+            if (!finished(status, error) || actual->sampling_backend_enabled) return false;
+            error = nullptr;
+        }
+        return true;
+    }
+
+    static bool check_reservation_overflow(skippy_session * actual) {
+        uint8_t payload = 0;
+        skippy_activation_desc desc{};
+        skippy_error * error = nullptr;
+        const auto status = skippy_prepare_output_activation_frame(actual, 1, &payload, 1,
+                nullptr, &desc, nullptr, &error, skippy_activation_frame_shape::live_within_reservation);
+        const bool rejected = status == SKIPPY_STATUS_RUNTIME_ERROR && actual->reset_required &&
+                error != nullptr && error->status == SKIPPY_STATUS_RUNTIME_ERROR;
+        skippy_error_free(error);
+        return rejected;
+    }
+
+private:
+    skippy_model * model = nullptr;
+    skippy_session * session = nullptr;
+    skippy_activation_desc desc{};
+    std::vector<uint8_t> payload = std::vector<uint8_t>(1024 * 1024);
+    size_t bytes = 0;
+
+    static bool finished(skippy_status status, skippy_error * error) {
+        if (status != SKIPPY_STATUS_OK) {
+            std::fprintf(stderr, "fresh graph execution failed: %s\n", error ? error->message : "unknown");
+        }
+        skippy_error_free(error);
+        return status == SKIPPY_STATUS_OK;
+    }
+};
