From 9a0233b5ef8ddcbf563486917b69437e1dd42c65 Mon Sep 17 00:00:00 2001
From: Virgile-pct <222121099+Virgile-pct@users.noreply.github.com>
Date: Sun, 4 Oct 2026 00:13:52 +0200
Subject: [PATCH 59/67] test(skippy): check every auto fused op on split stages

check_stage_flash_attention_auto() only asserted flash attention, although
the three DeepSeek V4 HC fusions go through the same resolve() walk over
the same fused-node list, and the Gated Delta Net and Lightning Indexer
nodes share that list too.

Rename it to check_stage_fused_ops_auto(). On auto, each stage must now
resolve flash attention and the three HC fusions to enabled, and for every
fused op of the whole model it must keep the nodes of exactly its own
layers. A --stage-fused-ops mode runs only this check, and a new ctest,
skippy_stage_fused_ops_auto_deepseek4, runs it on the deepseek4-moe
fixture, whose layers carry the HC fusions.
---
 src/CMakeLists.txt                      |   8 ++
 src/skippy/tests/graph_build_inputs.cpp | 141 +++++++++++++++++++-----
 2 files changed, 124 insertions(+), 25 deletions(-)

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index b4ee9bd87..6b0fb5098 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -562,6 +562,14 @@ if (LLAMA_STAGE_BUILD_TESTS)
     set_tests_properties(skippy_noalloc_graph_planning_deepseek4_hyperconnection PROPERTIES
         FIXTURES_REQUIRED skippy-noalloc-deepseek4-fixture)
 
+    add_test(
+        NAME skippy_stage_fused_ops_auto_deepseek4
+        COMMAND skippy-graph-build-inputs
+            --stage-fused-ops
+            "${SKIPPY_MODEL_FIXTURE_DIR}/deepseek4-moe.gguf")
+    set_tests_properties(skippy_stage_fused_ops_auto_deepseek4 PROPERTIES
+        FIXTURES_REQUIRED skippy-noalloc-deepseek4-fixture)
+
     add_test(
         NAME skippy_noalloc_graph_planning_granite_hybrid
         COMMAND skippy-noalloc-graph-planning
