diff --git a/src/skippy/selected_logits.h b/src/skippy/selected_logits.h
new file mode 100644
index 000000000..0fa526e5d
--- /dev/null
+++ b/src/skippy/selected_logits.h
@@ -0,0 +1,43 @@
+#ifndef SKIPPY_SELECTED_LOGITS_H
+#define SKIPPY_SELECTED_LOGITS_H
+
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+// Selected output stays bounded even when the vocabulary is very large.
+constexpr size_t SKIPPY_MAX_SELECTED_TOKENS = 256;
+
+// Calculate in double precision. Masked (-infinity) logits are valid, but a
+// selected masked token, a NaN, +infinity or an entirely masked vocabulary is
+// not usable decision evidence. Never publish a partially filled result.
+inline bool skippy_selected_log_probabilities(
+        const float * logits, size_t vocabulary_size,
+        const int32_t * selected, size_t selected_count, float * output) {
+    if (!logits || !selected || !output || vocabulary_size == 0 ||
+            selected_count == 0 || selected_count > SKIPPY_MAX_SELECTED_TOKENS) return false;
+    double maximum = -std::numeric_limits<double>::infinity();
+    for (size_t index = 0; index < vocabulary_size; ++index) {
+        const double value = logits[index];
+        if (std::isnan(value) || value == std::numeric_limits<double>::infinity()) return false;
+        if (value > maximum) maximum = value;
+    }
+    if (!std::isfinite(maximum)) return false;
+    double sum = 0;
+    for (size_t index = 0; index < vocabulary_size; ++index) {
+        sum += std::exp(static_cast<double>(logits[index]) - maximum);
+    }
+    const double normalizer = std::log(sum);
+    float scores[SKIPPY_MAX_SELECTED_TOKENS];
+    for (size_t index = 0; index < selected_count; ++index) {
+        if (selected[index] < 0 || static_cast<size_t>(selected[index]) >= vocabulary_size) return false;
+        const double value = (static_cast<double>(logits[selected[index]]) - maximum) - normalizer;
+        scores[index] = static_cast<float>(value);
+        if (!std::isfinite(scores[index])) return false;
+    }
+    for (size_t index = 0; index < selected_count; ++index) output[index] = scores[index];
+    return true;
+}
+
+#endif
diff --git a/src/skippy/tests/selected_logits.cpp b/src/skippy/tests/selected_logits.cpp
new file mode 100644
index 000000000..d33237d1a
--- /dev/null
+++ b/src/skippy/tests/selected_logits.cpp
@@ -0,0 +1,25 @@
+#include "../selected_logits.h"
+
+#include <array>
+#include <cmath>
+#include <limits>
+
+int main() {
+    const std::array<float, 4> logits = {1000, 999, 998, -std::numeric_limits<float>::infinity()};
+    const std::array<int32_t, 3> selected = {2, 0, 1};
+    std::array<float, 3> result = {7, 7, 7};
+    if (!skippy_selected_log_probabilities(logits.data(), logits.size(), selected.data(), selected.size(), result.data())) return 1;
+    if (!(result[1] > result[2] && result[2] > result[0])) return 2;
+    if (std::abs(std::exp(result[0]) + std::exp(result[1]) + std::exp(result[2]) - 1) > 1e-6) return 3;
+    const std::array<int32_t, 2> invalid = {0, 4};
+    result.fill(7);
+    if (skippy_selected_log_probabilities(logits.data(), logits.size(), invalid.data(), invalid.size(), result.data())) return 4;
+    if (result[0] != 7 || result[1] != 7) return 5;
+    const std::array<float, 2> masked = {-std::numeric_limits<float>::infinity(), -std::numeric_limits<float>::infinity()};
+    if (skippy_selected_log_probabilities(masked.data(), masked.size(), selected.data(), 1, result.data())) return 6;
+    const std::array<float, 2> nan = {0, std::numeric_limits<float>::quiet_NaN()};
+    if (skippy_selected_log_probabilities(nan.data(), nan.size(), selected.data() + 1, 1, result.data())) return 7;
+    const std::array<float, 2> inf = {0, std::numeric_limits<float>::infinity()};
+    if (skippy_selected_log_probabilities(inf.data(), inf.size(), selected.data() + 1, 1, result.data())) return 8;
+    return 0;
+}
