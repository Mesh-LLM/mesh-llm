+++ b/include/skippy/execution.h
@@ -15,6 +15,23 @@
 extern "C" {
 #endif
 
+/** @brief Whether the loaded graph supports causal next-token score reads. */
+LLAMA_API bool skippy_model_supports_causal_readout(const struct skippy_model * model);
+
+/**
+ * @brief A bounded, unsampled read of selected final-row token log probabilities.
+ *
+ * Values use the full, unmodified vocabulary distribution, before temperature,
+ * penalties or grammar. The caller owns both arrays for the entire iteration.
+ * Only terminal stages write scores; intermediate stages forward activations.
+ * This read never samples a token or changes sampler history.
+ */
+struct skippy_token_score_request {
+        const llama_token * token_ids;
+        size_t token_count;
+        float * out_log_probabilities;
+};
+
