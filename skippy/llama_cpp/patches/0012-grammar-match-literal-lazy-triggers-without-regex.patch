 size_t llama_grammar_trigger_pattern::find(const std::string & input) const {
+    // Literal triggers still match across token pieces in the caller's buffer;
+    // avoid a growing-buffer regex search without converting them to token IDs.
+    if (!pattern.empty() && regex.flags() == std::regex::ECMAScript &&
+            pattern.find_first_of(R"(\.^$|()[]{}*+?)") == std::string::npos &&
+            std::all_of(pattern.begin(), pattern.end(), [](unsigned char ch) {
+                return ch >= 0x20 && ch <= 0x7e;
+            })) {
+        return input.find(pattern);
+    }
+
     auto find_start_pos = [](const std::smatch & match) {
         // get from the first matched capturing group to the end of the string
