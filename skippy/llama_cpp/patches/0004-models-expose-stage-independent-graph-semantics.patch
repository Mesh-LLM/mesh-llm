+std::unique_ptr<llm_graph_input_dsv4> llm_graph_input_dsv4_create(
+        ggml_context * ctx,
+        const llama_hparams & hparams,
+        const llama_cparams & cparams,
+        const llama_ubatch & ubatch,
+        const llama_kv_cache_dsv4_context * mctx) {
+    const auto * raw_ctx = mctx->get_raw();
+    auto inp_raw = std::make_unique<llm_graph_input_dsv4_raw>(cparams, raw_ctx);
+    const int64_t n_stream = mctx->get_csa_plan(ubatch).n_stream;
+
+    GGML_ASSERT(hparams.swa_type != LLAMA_SWA_TYPE_NONE && "DSV4 expects SWA raw cache");
+
+    inp_raw->self_k_idxs = raw_ctx->build_input_k_idxs(ctx, ubatch);
+    inp_raw->self_kq_mask = dsv4_build_raw_kq_mask(ctx, raw_ctx, ubatch, cparams, n_stream);
+    inp_raw->self_kq_mask_cnv = inp_raw->self_kq_mask;
+    inp_raw->self_k_rot = raw_ctx->build_input_k_rot(ctx);
+
+    auto inp = std::make_unique<llm_graph_input_dsv4>(cparams, std::move(inp_raw), mctx);
+    dsv4_build_comp_inputs(ctx, inp->inp_csa, mctx->get_csa_plan(ubatch), "csa", cparams, n_stream);
+    dsv4_build_comp_inputs(ctx, inp->inp_hca, mctx->get_hca_plan(ubatch), "hca", cparams, n_stream);
+    dsv4_build_comp_inputs(ctx, inp->inp_lid, mctx->get_lid_plan(ubatch), "lid", cparams, n_stream);
+    inp->inp_csa.k_rot = mctx->get_csa()->build_input_k_rot(ctx);
+    inp->inp_hca.k_rot = mctx->get_hca()->build_input_k_rot(ctx);
+    inp->inp_lid.k_rot = mctx->get_lid()->build_input_k_rot(ctx);
+    return inp;
