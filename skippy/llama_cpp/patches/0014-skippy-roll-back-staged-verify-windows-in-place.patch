diff --git a/src/skippy/tests/verify_rollback.cpp b/src/skippy/tests/verify_rollback.cpp
new file mode 100644
index 000000000..14b95b687
--- /dev/null
+++ b/src/skippy/tests/verify_rollback.cpp
@@ -0,0 +1,149 @@
+// Speculative verify windows with forced rejections must commit exactly the
+// tokens a session decodes one at a time, whether each window rolls back in
+// place through the recurrent rollback snapshots or through a host checkpoint.
+#include "skippy.h"
+#include "../runtime_types.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+#define CHECK(condition) do { if (!(condition)) { \
+    std::fprintf(stderr, "CHECK failed: %s at %s:%d\n", #condition, __FILE__, __LINE__); \
+    std::exit(1); } } while (0)
+
+namespace {
+
+constexpr size_t WINDOW = 5;
+constexpr size_t GENERATED = 24;
+// Proposal index rejected in successive windows; -1 accepts every row.
+constexpr int REJECTIONS[] = {-1, 0, 3, 1, -1, 2};
+
+void ok(skippy_status status, skippy_error * error) {
+    if (status != SKIPPY_STATUS_OK) {
+        std::fprintf(stderr, "native failure: %s\n", error ? error->message : "no detail");
+        std::exit(1);
+    }
+    skippy_error_free(error);
+}
+
+skippy_model * open(const char * path, uint32_t rollback_tokens) {
+    auto config = skippy_runtime_config_default();
+    config.selected_backend_device = "CPU";
+    config.ctx_size = 256;
+    config.recurrent_rollback_tokens = rollback_tokens;
+    skippy_model * model = nullptr;
+    skippy_error * error = nullptr;
+    ok(skippy_model_open(path, &config, &model, &error), error);
+    return model;
+}
+
+skippy_session * create(skippy_model * model) {
+    skippy_session * session = nullptr;
+    skippy_error * error = nullptr;
+    ok(skippy_session_create(model, &session, &error), error);
+    return session;
+}
+
+void prefill(skippy_session * session, const std::vector<llama_token> & tokens) {
+    size_t bytes = 0;
+    skippy_error * error = nullptr;
+    ok(skippy_prefill_chunk(session, tokens.data(), tokens.size(), nullptr, 0, nullptr, 0, &bytes, &error), error);
+}
+
+llama_token decode(skippy_session * session, llama_token token) {
+    llama_token predicted = -1;
+    size_t bytes = 0;
+    skippy_error * error = nullptr;
+    ok(skippy_decode_step_sampled(session, token, nullptr, nullptr, 0, nullptr, 0, &bytes, &predicted, &error), error);
+    return predicted;
+}
+
+const std::vector<llama_token> PROMPT = {1, 7, 3, 9, 4, 12, 5};
+
+std::vector<llama_token> reference(skippy_model * model) {
+    skippy_session * session = create(model);
+    prefill(session, std::vector<llama_token>(PROMPT.begin(), PROMPT.end() - 1));
+    std::vector<llama_token> tokens;
+    llama_token current = PROMPT.back();
+    while (tokens.size() < GENERATED + WINDOW) {
+        current = decode(session, current);
+        tokens.push_back(current);
+    }
+    skippy_error * error = nullptr;
+    ok(skippy_session_free(session, &error), error);
+    return tokens;
+}
+
+void speculate(skippy_model * model, const std::vector<llama_token> & expected, bool want_in_place) {
+    skippy_session * session = create(model);
+    prefill(session, std::vector<llama_token>(PROMPT.begin(), PROMPT.end() - 1));
+    const uint64_t prefix = PROMPT.size() - 1;
+    std::vector<llama_token> committed;
+    llama_token current = PROMPT.back();
+    for (size_t step = 0; committed.size() < GENERATED; ++step) {
+        const int reject = REJECTIONS[step % (sizeof(REJECTIONS) / sizeof(REJECTIONS[0]))];
+        std::vector<llama_token> window = {current};
+        for (size_t i = 0; i + 1 < WINDOW; ++i) {
+            const llama_token token = expected[committed.size() + i];
+            window.push_back(static_cast<int>(i) == reject ? token ^ 1 : token);
+        }
+        std::vector<llama_token> predicted(WINDOW, -1);
+        size_t count = 0;
+        skippy_error * error = nullptr;
+        ok(skippy_verify_tokens(session, window.data(), window.size(),
+                predicted.data(), predicted.size(), &count, &error), error);
+        CHECK(count == WINDOW);
+        size_t accepted = 0;
+        while (accepted + 1 < WINDOW && predicted[accepted] == window[accepted + 1]) {
+            ++accepted;
+        }
+        for (size_t i = 0; i <= accepted; ++i) {
+            if (predicted[i] != expected[committed.size()]) {
+                std::fprintf(stderr, "window %zu committed token %zu as %d, the one-at-a-time decode gives %d\n",
+                        step, committed.size(), predicted[i], expected[committed.size()]);
+                std::exit(1);
+            }
+            committed.push_back(predicted[i]);
+        }
+        const uint64_t base = prefix + committed.size() - accepted - 1;
+        error = nullptr;
+        if (accepted + 1 == WINDOW) {
+            ok(skippy_retire_verify_checkpoint(session, base, WINDOW, &error), error);
+        } else {
+            ok(skippy_trim_session(session, base + 1 + accepted, &error), error);
+        }
+        current = predicted[accepted];
+    }
+    // A decode after the last window must still match.
+    CHECK(decode(session, current) == expected[committed.size()]);
+    uint64_t in_place = 0;
+    uint64_t checkpointed = 0;
+    skippy_error * error = nullptr;
+    ok(skippy_session_verify_rollback_counts(session, &in_place, &checkpointed, &error), error);
+    std::fprintf(stderr, "verify windows: %llu in place, %llu checkpointed\n",
+            static_cast<unsigned long long>(in_place), static_cast<unsigned long long>(checkpointed));
+    CHECK(want_in_place ? in_place > 0 : checkpointed > 0);
+    error = nullptr;
+    ok(skippy_session_free(session, &error), error);
+}
+
+void release(skippy_model * model) {
+    skippy_error * error = nullptr;
+    ok(skippy_model_free(model, &error), error);
+}
+
+} // namespace
+
+int main(int argc, char ** argv) {
+    CHECK(argc == 2);
+    skippy_model * deep = open(argv[1], WINDOW + 2);
+    const auto expected = reference(deep);
+    speculate(deep, expected, true);
+    release(deep);
+    // Shallower than a window: every rejected window restores a host checkpoint.
+    skippy_model * shallow = open(argv[1], 1);
+    speculate(shallow, expected, false);
+    release(shallow);
+    return 0;
+}
diff --git a/src/skippy/verify_window.cpp b/src/skippy/verify_window.cpp
new file mode 100644
index 000000000..18393e3c4
--- /dev/null
+++ b/src/skippy/verify_window.cpp
@@ -0,0 +1,216 @@
+// Verify-window bookkeeping: the window that rolls back in place, the host
+// checkpoints that replace it when it cannot, and the buffers they reuse.
+#include "skippy.h"
+#include "skippy/verify_window.h"
+
+#include "skippy/activation_internal.h"
+#include "skippy/errors.h"
+#include "skippy/runtime_support.h"
+#include "skippy/runtime_types.h"
+#include "skippy/state_memory.h"
+
+#include "llama-context.h"
+#include "llama-memory-recurrent.h"
+
+#include <exception>
+#include <utility>
+
+void skippy_recycle_verify_checkpoint(
+        skippy_session * session,
+        skippy_verify_checkpoint && checkpoint) {
+    // A full sequence state can be tens of MiB; keep the few a pipelined
+    // window depth needs rather than every one ever taken.
+    constexpr size_t max_pooled_checkpoints = 2;
+    if (session->verify_checkpoint_pool.size() >= max_pooled_checkpoints) {
+        return;
+    }
+    checkpoint.valid = false;
+    session->verify_checkpoint_pool.push_back(std::move(checkpoint));
+}
+
+skippy_verify_checkpoint skippy_acquire_verify_checkpoint(skippy_session * session) {
+    if (session->verify_checkpoint_pool.empty()) {
+        return {};
+    }
+    skippy_verify_checkpoint checkpoint = std::move(session->verify_checkpoint_pool.back());
+    session->verify_checkpoint_pool.pop_back();
+    return checkpoint;
+}
+
+void skippy_clear_verify_windows(skippy_session * session) {
+    if (session == nullptr) {
+        return;
+    }
+    for (auto & checkpoint : session->verify_checkpoints) {
+        skippy_recycle_verify_checkpoint(session, std::move(checkpoint));
+    }
+    session->verify_checkpoints.clear();
+    session->inplace_verify_window.valid = false;
+}
+
+// Records the replay inputs of a window. The vectors keep their capacity, so a
+// recycled checkpoint copies into memory it already owns.
+void skippy_record_verify_window_inputs(
+        skippy_verify_checkpoint & window,
+        int32_t token_start,
+        const llama_token * token_ids,
+        size_t token_count,
+        const skippy_activation_desc * input_desc,
+        const void * input_payload) {
+    window.valid = true;
+    window.token_start = token_start;
+    window.token_count = token_count;
+    window.state_offset = 0;
+    if (token_ids != nullptr) {
+        window.token_ids.assign(token_ids, token_ids + token_count);
+    } else {
+        window.token_ids.clear();
+    }
+    window.has_activation_input = skippy_has_activation_payload(input_desc, input_payload);
+    if (window.has_activation_input) {
+        window.input_desc = *input_desc;
+        const uint8_t * bytes = static_cast<const uint8_t *>(input_payload);
+        window.input_payload.assign(bytes, bytes + input_desc->payload_bytes);
+    } else {
+        window.input_desc = {};
+        window.input_payload.clear();
+    }
+}
+
+enum skippy_status skippy_copy_verify_state(
+        skippy_session * session,
+        std::vector<uint8_t> & state,
+        skippy_error ** out_error) {
+    const size_t state_size = llama_state_seq_get_size_ext(
+            session->ctx,
+            session->seq_id,
+            LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    if (state_size == 0) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to size verify-window state checkpoint");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    // Same-sized recurrent state every window: resizing a recycled buffer
+    // neither reallocates nor clears it.
+    state.resize(state_size);
+    const size_t written = llama_state_seq_get_data_ext(
+            session->ctx,
+            state.data(),
+            state.size(),
+            session->seq_id,
+            LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+    if (written != state.size()) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to checkpoint verify-window sequence state");
+        return SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    return SKIPPY_STATUS_OK;
+}
+
+enum skippy_status skippy_reject_verify_checkpoint_depth(skippy_error ** out_error) {
+    skippy_set_error(
+            out_error,
+            SKIPPY_STATUS_UNSUPPORTED,
+            "verify-window pipeline depth exceeds supported checkpoint retention");
+    return SKIPPY_STATUS_UNSUPPORTED;
+}
+
+enum skippy_status skippy_settle_inplace_verify_window(
+        skippy_session * session,
+        skippy_error ** out_error) {
+    if (session == nullptr || !session->inplace_verify_window.valid) {
+        return SKIPPY_STATUS_OK;
+    }
+    skippy_verify_checkpoint & window = session->inplace_verify_window;
+    const int64_t window_end = static_cast<int64_t>(window.token_start) + static_cast<int64_t>(window.token_count);
+    if (session->n_past == window.token_start) {
+        // The window itself has not been decoded yet.
+        return SKIPPY_STATUS_OK;
+    }
+    window.valid = false;
+    if (session->n_past != window_end || window.token_count < 2) {
+        // Either the window no longer ends the sequence, or it holds no row
+        // that a trim could return to.
+        return SKIPPY_STATUS_OK;
+    }
+    if (session->verify_checkpoints.size() >= skippy_max_verify_checkpoints) {
+        return skippy_reject_verify_checkpoint_depth(out_error);
+    }
+
+    // The next decode overwrites the snapshots. Keep the state after the
+    // window's first row, read from the snapshot that rolls back to it. The
+    // first row is the committed token the window started from, so every
+    // trim inside the window lands at or after it.
+    llama_memory_recurrent * recurrent = skippy_memory_recurrent_adapter(session->ctx->get_memory());
+    const uint32_t rollback = static_cast<uint32_t>(window.token_count - 1);
+    llama_memory_recurrent::mem_cell * tail = nullptr;
+    if (recurrent != nullptr) {
+        const auto seq = static_cast<size_t>(session->seq_id);
+        if (seq >= recurrent->cells.size() || seq >= recurrent->rs_idx.size()) {
+            skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "verify-window sequence has no recurrent cell");
+            return SKIPPY_STATUS_RUNTIME_ERROR;
+        }
+        const int32_t tail_id = recurrent->cells[seq].tail;
+        if (tail_id < 0 || recurrent->rs_idx[seq] != 0 ||
+                (recurrent->n_rs_seq != 0 && rollback > recurrent->n_rs_seq)) {
+            skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "verify-window rollback snapshot is unavailable");
+            return SKIPPY_STATUS_RUNTIME_ERROR;
+        }
+        tail = &recurrent->cells[static_cast<size_t>(tail_id)];
+    }
+
+    skippy_verify_checkpoint checkpoint = skippy_acquire_verify_checkpoint(session);
+    std::swap(checkpoint.token_ids, window.token_ids);
+    std::swap(checkpoint.input_payload, window.input_payload);
+    checkpoint.has_activation_input = window.has_activation_input;
+    checkpoint.input_desc = window.input_desc;
+    checkpoint.token_start = window.token_start;
+    checkpoint.token_count = window.token_count;
+    checkpoint.state_offset = 1;
+
+    session->ctx->synchronize();
+    llama_pos tail_pos = 0;
+    if (tail != nullptr) {
+        // Serialize the sequence as if it had rolled back: the state writer
+        // reads the snapshot group named by rs_idx and the tail position.
+        tail_pos = tail->pos;
+        tail->pos = window.token_start;
+        if (recurrent->n_rs_seq != 0) {
+            recurrent->rs_idx[static_cast<size_t>(session->seq_id)] = rollback;
+        }
+    }
+    enum skippy_status status = SKIPPY_STATUS_OK;
+    try {
+        status = skippy_copy_verify_state(session, checkpoint.state, out_error);
+    } catch (const std::exception & error) {
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, error.what());
+        status = SKIPPY_STATUS_RUNTIME_ERROR;
+    }
+    if (tail != nullptr) {
+        tail->pos = tail_pos;
+        recurrent->rs_idx[static_cast<size_t>(session->seq_id)] = 0;
+    }
+    if (status != SKIPPY_STATUS_OK) {
+        skippy_recycle_verify_checkpoint(session, std::move(checkpoint));
+        return status;
+    }
+    checkpoint.valid = true;
+    session->verify_checkpoints.push_back(std::move(checkpoint));
+    if (session->verify_windows_in_place > 0) {
+        --session->verify_windows_in_place;
+    }
+    ++session->verify_windows_checkpointed;
+    return SKIPPY_STATUS_OK;
+}
+
+enum skippy_status skippy_session_verify_rollback_counts(
+        const skippy_session * session,
+        uint64_t * out_in_place,
+        uint64_t * out_checkpointed,
+        skippy_error ** out_error) {
+    if (session == nullptr || out_in_place == nullptr || out_checkpointed == nullptr) {
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, "session and outputs are required");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
+    *out_in_place = session->verify_windows_in_place;
+    *out_checkpointed = session->verify_windows_checkpointed;
+    return skippy_success(out_error);
+}
