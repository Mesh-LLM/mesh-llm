-            session->ctx,
-            session->seq_id,
-            LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
-    if (state_size == 0) {
-        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to size verify-window state checkpoint");
-        return SKIPPY_STATUS_RUNTIME_ERROR;
+    // A recorded window that never decoded is gone; one that did must stop
+    // depending on snapshots this window is about to overwrite.
+    if (session->inplace_verify_window.valid && session->n_past == session->inplace_verify_window.token_start) {
+        session->inplace_verify_window.valid = false;
+    }
+    // Only a window opened with nothing else outstanding may roll back in
+    // place. Otherwise windows are pipelined: a trim may land in an earlier
+    // window or at this window's first row, and neither is in the snapshots
