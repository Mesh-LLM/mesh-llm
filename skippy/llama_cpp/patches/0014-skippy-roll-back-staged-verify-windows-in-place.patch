+    skippy_record_verify_window_inputs(
+            checkpoint,
+            session->n_past,
+            token_ids,
+            token_count,
+            input_desc,
+            input_payload);
     session->verify_checkpoints.push_back(std::move(checkpoint));
+    ++session->verify_windows_checkpointed;
     return skippy_success(out_error);
 }
 
