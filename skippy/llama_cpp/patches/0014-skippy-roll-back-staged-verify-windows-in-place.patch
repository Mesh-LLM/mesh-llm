--- a/src/skippy/runtime_types.h
+++ b/src/skippy/runtime_types.h
@@ -120,6 +120,11 @@ struct skippy_verify_checkpoint {
     bool valid = false;
     int32_t token_start = 0;
     size_t token_count = 0;
+    // Leading window rows already folded into `state`. A checkpoint taken
+    // before the window holds 0; one recovered from a decoded window's
+    // rollback snapshots holds 1, so it restores to token_start + 1 and
+    // replays only the accepted rows after that.
+    size_t state_offset = 0;
     std::vector<uint8_t> state;
     std::vector<llama_token> token_ids;
     bool has_activation_input = false;
@@ -190,4 +195,16 @@ struct skippy_session {
     std::vector<skippy_pending_activation_part> pending_activation_exports;
     bool reset_required = false;
     std::vector<skippy_verify_checkpoint> verify_checkpoints;
+    // The verify window that rolls back in place through the recurrent
+    // rollback snapshots instead of a host checkpoint. Only its replay inputs
+    // are kept (`state` stays empty): if another decode lands before the
+    // window is trimmed or retired, they become a host checkpoint.
+    skippy_verify_checkpoint inplace_verify_window;
+    // Retired checkpoints whose buffers the next checkpoint reuses, so the
+    // fallback path does not allocate a full sequence state every window.
+    std::vector<skippy_verify_checkpoint> verify_checkpoint_pool;
+    // Verify windows held in place, and held in a host checkpoint, since the
+    // session was created or reset.
+    uint64_t verify_windows_in_place = 0;
+    uint64_t verify_windows_checkpointed = 0;
 };
