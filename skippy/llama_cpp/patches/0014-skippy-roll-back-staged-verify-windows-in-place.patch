@@ -0,0 +1,38 @@
+#pragma once
+
+#include "skippy/common.h"
+
+#include "llama.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+struct skippy_session;
+struct skippy_verify_checkpoint;
+struct skippy_activation_desc;
+
+// Most verify windows a session may hold checkpoints for at once.
+constexpr size_t skippy_max_verify_checkpoints = 64;
+
+enum skippy_status skippy_reject_verify_checkpoint_depth(skippy_error ** out_error);
+
+// Returns a retired checkpoint's buffers to the session for the next one.
+void skippy_recycle_verify_checkpoint(skippy_session * session, skippy_verify_checkpoint && checkpoint);
+// Takes a recycled checkpoint, or an empty one when none is left.
+skippy_verify_checkpoint skippy_acquire_verify_checkpoint(skippy_session * session);
+
+// Copies what replaying the window's accepted rows needs.
+void skippy_record_verify_window_inputs(
+        skippy_verify_checkpoint & window,
+        int32_t token_start,
+        const llama_token * token_ids,
+        size_t token_count,
+        const skippy_activation_desc * input_desc,
+        const void * input_payload);
+
+// Serializes the sequence's partial (recurrent) state into `state`.
+enum skippy_status skippy_copy_verify_state(
+        skippy_session * session,
+        std::vector<uint8_t> & state,
+        skippy_error ** out_error);
