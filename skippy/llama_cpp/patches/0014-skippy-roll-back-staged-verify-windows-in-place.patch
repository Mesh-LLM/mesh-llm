+++ b/src/skippy-verify-checkpoint.h
@@ -2,13 +2,17 @@
 
 #include <algorithm>
 #include <cstdint>
+#include <utility>
 #include <vector>
 
+// Removes the checkpoint of exactly this window. When `retired` is given, it
+// receives the removed checkpoint so its buffers can be reused.
 template<typename T>
 bool skippy_retire_verify_checkpoint_exact(
         std::vector<T> & checkpoints,
         uint64_t token_start,
-        uint64_t token_count) {
+        uint64_t token_count,
+        T * retired = nullptr) {
     const auto it = std::find_if(
             checkpoints.begin(), checkpoints.end(),
             [token_start, token_count](const T & checkpoint) {
@@ -19,6 +23,9 @@ bool skippy_retire_verify_checkpoint_exact(
     if (it == checkpoints.end()) {
         return false;
     }
+    if (retired != nullptr) {
+        *retired = std::move(*it);
+    }
     checkpoints.erase(it);
     return true;
 }
