diff --git a/src/skippy/chat_sampling.cpp b/src/skippy/chat_sampling.cpp
new file mode 100644
index 000000000..3c9fc758b
--- /dev/null
+++ b/src/skippy/chat_sampling.cpp
@@ -0,0 +1,75 @@
+#include "skippy/chat_sampling.h"
+#include "skippy/runtime_types.h"
+#include "skippy/runtime_support.h"
+#include "skippy/sampling_internal.h"
+#include "skippy/errors.h"
+#include "../../common/sampling.h"
+
+#include <cmath>
+#include <stdexcept>
+
+bool skippy_retire_backend_sampling(skippy_session * session, skippy_error ** out_error) {
+    if (!session->sampling_backend_enabled) { return true; }
+    try {
+        llama_synchronize(session->ctx);
+        skippy_mark_context_synchronized(session->stage_model);
+        // Cloning preserves accepted history and RNG state, but gives the chain
+        // fresh CPU nodes instead of the detached chain's offload-only nodes.
+        auto * replacement = common_sampler_clone(session->sampler);
+        llama_set_sampler(session->ctx, session->seq_id, nullptr);
+        common_sampler_free(session->sampler);
+        session->sampler = replacement;
+        session->sampling_chain = common_sampler_get(replacement);
+        session->sampling_backend_enabled = false;
+        session->sampling_backend_retired = true;
+        session->sampling_backend_row_invalid = true;
+        return true;
+    } catch (...) {
+        session->reset_required = true;
+        skippy_set_error(out_error, SKIPPY_STATUS_RUNTIME_ERROR, "failed to retire backend sampler");
+        return false;
+    }
+}
+
+void skippy_chat_accept_history(skippy_session * session) {
+    while (session->sampling_accepted_token_count < session->token_history.size()) {
+        const auto index = session->sampling_accepted_token_count;
+        common_sampler_accept(session->sampler, session->token_history[index],
+                index >= session->grammar_generated_start);
+        ++session->sampling_accepted_token_count;
+    }
+}
+
+llama_token skippy_chat_sample_token(skippy_session * session, int32_t logits_index) {
+    const auto backend_token = llama_get_sampled_token_ith(session->ctx, logits_index);
+    const auto * backend_probs = llama_get_sampled_probs_ith(session->ctx, logits_index);
+    const auto * backend_logits = llama_get_sampled_logits_ith(session->ctx, logits_index);
+    const bool processed_row = backend_token != LLAMA_TOKEN_NULL || backend_probs != nullptr || backend_logits != nullptr;
+    // A changed or detached sampler cannot reinterpret its predecessor's
+    // processed row. Only a subsequent decode for this session renews it.
+    if (processed_row && (session->sampling_backend_row_invalid || !session->sampling_backend_enabled)) {
+        return LLAMA_TOKEN_NULL;
+    }
+    if (session->sampling_backend_enabled) {
+        if (backend_token != LLAMA_TOKEN_NULL) {
+            skippy_chat_accept_history(session);
+            skippy_mark_context_synchronized(session->stage_model);
+            return backend_token;
+        }
+        // The chain may have been attached after this row was decoded.
+        if (!skippy_retire_backend_sampling(session, nullptr)) { return LLAMA_TOKEN_NULL; }
+    }
+    if (backend_probs == nullptr && backend_logits == nullptr &&
+            llama_get_logits_ith(session->ctx, logits_index) == nullptr) {
+        return LLAMA_TOKEN_NULL;
+    }
+    skippy_chat_accept_history(session);
+    const auto token = common_sampler_sample(session->sampler, session->ctx, logits_index);
+    skippy_mark_context_synchronized(session->stage_model);
+    const auto * candidates = common_sampler_get_candidates(session->sampler, false);
+    if (candidates->selected < 0 || static_cast<size_t>(candidates->selected) >= candidates->size) {
+        return LLAMA_TOKEN_NULL;
+    }
+    const auto logit = candidates->data[candidates->selected].logit;
+    return logit == -INFINITY || std::isnan(logit) ? LLAMA_TOKEN_NULL : token;
+}
