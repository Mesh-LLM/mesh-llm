diff --git a/tests/test-grammar-trigger-patterns.cpp b/tests/test-grammar-trigger-patterns.cpp
new file mode 100644
index 000000000..6df57b5c6
--- /dev/null
+++ b/tests/test-grammar-trigger-patterns.cpp
@@ -0,0 +1,72 @@
+#ifdef NDEBUG
+#undef NDEBUG
+#endif
+
+#include "../src/llama-grammar.h"
+
+#include <cassert>
+#include <string>
+#include <vector>
+
+static void check_match(const std::string & pattern, const std::string & input, size_t expected) {
+    const llama_grammar_trigger_pattern literal{pattern, std::regex(pattern)};
+    // optimize preserves regex semantics but bypasses the conservative literal
+    // gate, giving an independent matcher for offsets and partial spellings.
+    const llama_grammar_trigger_pattern regex{
+        pattern, std::regex(pattern, std::regex::ECMAScript | std::regex::optimize)};
+    assert(literal.find(input) == expected);
+    assert(regex.find(input) == expected);
+}
+
+int main() {
+    const size_t absent = std::string::npos;
+    struct match_case {
+        std::string pattern;
+        std::string input;
+        size_t expected;
+    };
+    const std::vector<match_case> cases{
+        {"<tool_call>", "", absent},
+        {"<tool_call>", "thinking <tool_call>rest", 9},
+        {"<tool_call>", "<tool_call><tool_call>", 0},
+        {"word_42 -", "xword_42 -y", 1},
+        {"literal", "literals later literal", 0},
+        {"x", "πx", 2},
+        {"<tool_call>", std::string("\xce", 1) + "<tool_call>", 1},
+        {"<tool_call>", std::string("a\0b", 3) + "<tool_call>", 3},
+        {"", "", 0},
+        {"", "x", 0},
+        {R"(tool\.call)", "xx tool.call", 3},
+        {"prefix(suffix)", "xxprefixsuffix", 8},
+        {"^prefix(suffix)$", "prefixsuffix", 6},
+        {"prefix()suffix", "xxprefixsuffix", 2},
+        {"(empty)?(suffix)", "xxsuffix", 2},
+        {"(first)|(second)", "xxsecond", 2},
+        {"^abc$", "xabc", absent},
+        {"^abc$", "abc", 0},
+        {"[a-z]+", "12abc", 2},
+        {"a.*(b)", "xxab", 3},
+        {"λ", "πλ", 2},
+        {"a{2}", "zaa", 1},
+        {"a?", "bbb", 0},
+        {R"(\bword\b)", "sword word", 6},
+        {"(?=word)", "xxword", 2},
+        {R"(\^)", "x^", 1},
+    };
+    for (const auto & item : cases) {
+        check_match(item.pattern, item.input, item.expected);
+    }
+
+    const std::vector<std::string> pieces{
+        "thought ", "\xf0", "\x9f", "\x99", "\x82", "<to", "ol_", "call", ">", "x"};
+    std::string buffer;
+    for (size_t i = 0; i < pieces.size(); ++i) {
+        buffer += pieces[i];
+        check_match("<tool_call>", buffer, i < 8 ? absent : 12);
+    }
+
+    const llama_grammar_trigger_pattern insensitive{
+        "word", std::regex("word", std::regex::ECMAScript | std::regex::icase)};
+    assert(insensitive.find("WORD") == 0);
+    return 0;
+}
