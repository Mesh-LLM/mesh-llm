+    }
+    params.logit_bias.assign(config->logit_bias,
+            config->logit_bias + std::min<uint32_t>(config->logit_bias_count, SKIPPY_MAX_LOGIT_BIAS));
+    params.ignore_eos = config->ignore_eos != 0 || (config->flags & SKIPPY_SAMPLING_FLAG_IGNORE_EOS);
+    params.dry_sequence_breakers.clear();
+    for (uint32_t i = 0; i < std::min<uint32_t>(config->dry_sequence_breaker_count, SKIPPY_MAX_DRY_SEQUENCE_BREAKERS); ++i) {
+        const auto * begin = config->dry_sequence_breakers[i];
+        params.dry_sequence_breakers.emplace_back(begin,
+                std::find(begin, begin + SKIPPY_MAX_DRY_SEQUENCE_BREAKER_BYTES, '\0'));
+    }
+    params.samplers.clear();
+    if (config->sampler_count != 0) {
+        for (uint32_t i = 0; i < std::min<uint32_t>(config->sampler_count, SKIPPY_MAX_SAMPLERS); ++i) {
+            params.samplers.push_back(sampler_type(config->samplers[i]));
+        }
+    } else {
+        for (auto type : {COMMON_SAMPLER_TYPE_PENALTIES, COMMON_SAMPLER_TYPE_DRY,
+                COMMON_SAMPLER_TYPE_TOP_N_SIGMA, COMMON_SAMPLER_TYPE_TOP_K,
+                COMMON_SAMPLER_TYPE_TYPICAL_P, COMMON_SAMPLER_TYPE_TOP_P,
+                COMMON_SAMPLER_TYPE_MIN_P, COMMON_SAMPLER_TYPE_XTC, COMMON_SAMPLER_TYPE_TEMPERATURE}) {
+            if (type == COMMON_SAMPLER_TYPE_TYPICAL_P && !(params.typ_p > 0 && params.typ_p < 1)) { continue; }
+            if (type == COMMON_SAMPLER_TYPE_TOP_P && !(params.top_p > 0 && params.top_p < 1)) { continue; }
+            params.samplers.push_back(type);
+        }
+    }
+    return params;
+}
+
+static void chat_params(common_params_sampling & params, const llama_vocab * vocab, const json & metadata,
+        bool configure_reasoning) {
+    const auto grammar = metadata.value("grammar", std::string());
+    if (!grammar.empty()) {
+        params.grammar = {COMMON_GRAMMAR_TYPE_TOOL_CALLS, grammar};
+    }
+    params.grammar_lazy = metadata.value("grammar_lazy", false);
+    params.generation_prompt = metadata.value("generation_prompt", std::string());
+    if (const auto triggers = metadata.find("grammar_triggers"); triggers != metadata.end() && triggers->is_array()) {
+        for (const auto & trigger : *triggers) {
+            const auto type = trigger.value("type", -1);
+            if (type < COMMON_GRAMMAR_TRIGGER_TYPE_TOKEN || type > COMMON_GRAMMAR_TRIGGER_TYPE_PATTERN_FULL) {
+                throw std::invalid_argument("unknown chat grammar trigger type");
+            }
+            // Preserve WORD text matching across token pieces. Normalizing it
+            // to one token ID would narrow the existing metadata contract.
+            params.grammar_triggers.push_back({static_cast<common_grammar_trigger_type>(type),
+                    trigger.value("value", std::string()), trigger.value("token", LLAMA_TOKEN_NULL)});
+        }
+    }
+    const auto start = metadata.value("thinking_start_tag", std::string());
+    const auto ends = metadata.find("thinking_end_tags");
+    if (configure_reasoning && !start.empty() && ends != metadata.end() && ends->is_array()) {
+        params.reasoning_budget_start = common_tokenize(vocab, start, false, true);
+        for (const auto & end : *ends) {
+            if (!end.is_string()) { continue; }
+            auto tokens = common_tokenize(vocab, end.get<std::string>(), false, true);
+            if (!tokens.empty()) { params.reasoning_budget_end.push_back(std::move(tokens)); }
+        }
+    }
+    if (params.reasoning_budget_start.empty() || params.reasoning_budget_end.empty()) {
+        if (configure_reasoning && params.reasoning_budget_tokens >= 0 && metadata.value("supports_thinking", false)) {
+            throw std::invalid_argument("finite reasoning budget requires non-empty thinking tags");
+        }
+        params.reasoning_budget_start.clear();
+        params.reasoning_budget_end.clear();
+    } else {
+        params.reasoning_budget_forced = params.reasoning_budget_end.front();
+    }
+    // common_sampler_init merges model suppression itself, but its callers
+    // supply EOG suppression for ignore_eos explicitly.
+    if (params.ignore_eos) {
+        for (llama_token token = 0; token < llama_vocab_n_tokens(vocab); ++token) {
+            if (llama_vocab_is_eog(vocab, token)) {
+                params.logit_bias.erase(std::remove_if(params.logit_bias.begin(), params.logit_bias.end(),
+                        [token](const llama_logit_bias & bias) { return bias.token == token; }), params.logit_bias.end());
+                params.logit_bias.push_back({token, -std::numeric_limits<float>::infinity()});
+            }
+        }
+    }
+}
+
+bool skippy_initialize_chat_sampler(skippy_session * session,
+        const skippy_sampling_config * config, const json & metadata, skippy_error **) {
+    auto params = sampling_params(config, !session->chat_sampling_metadata.empty());
+    const auto * model = session->stage_model->model;
+    const auto * vocab = llama_model_get_vocab(model);
+    chat_params(params, vocab, metadata, config != nullptr);
+    // Upstream appends model suppression once; discard conflicting user
+    // entries first so a positive infinity cannot cancel negative infinity.
+    int32_t count = 0;
+    const auto * suppressed = llama_vocab_get_suppress_tokens(vocab, &count);
+    params.logit_bias.erase(std::remove_if(params.logit_bias.begin(), params.logit_bias.end(),
+            [suppressed, count](const llama_logit_bias & bias) {
+                return suppressed != nullptr && count > 0 &&
+                        std::find(suppressed, suppressed + count, bias.token) != suppressed + count;
+            }), params.logit_bias.end());
+    session->sampler = common_sampler_init(model, params);
+    if (session->sampler == nullptr) { return false; }
+    session->sampling_chain = common_sampler_get(session->sampler);
+    session->sampling_has_grammar = !params.grammar.empty();
+    session->sampling_has_reasoning_budget = !params.reasoning_budget_start.empty() &&
+            !params.reasoning_budget_end.empty() && (params.grammar_lazy || params.reasoning_budget_tokens >= 0);
+    session->grammar_lazy = params.grammar_lazy;
+    ++session->sampling_rebuild_count;
+    return true;
+}
