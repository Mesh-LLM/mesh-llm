From 054fb8ca66283302bee704b8f3d114ec17a75b6f Mon Sep 17 00:00:00 2001
From: Jared Wyles <jared.wyles@gmail.com>
Date: Wed, 18 Nov 2026 20:05:54 +1100
Subject: [PATCH 39/39] skippy: apply the KV memory options to every attention
 cache a memory owns

kv_lazy_clear=false and kv_release_pages=false reached plain, ISWA, hybrid
and DSA memories only. MSA, DSA-ISWA and DeepSeek V4 memories derive from
llama_memory_i directly and own llama_kv_cache children that zero lazily and
release pages by default, so the opt-outs never reached them.

The traversal now also returns MSA's base and indexer caches, DSA-ISWA's
DSA pair and sliding-window cache, and DeepSeek V4's raw ISWA pair and its
CSA, HCA and indexer caches.
---
 src/skippy/state_memory.cpp | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/src/skippy/state_memory.cpp b/src/skippy/state_memory.cpp
index c62b1e629..a8a3757ca 100644
--- a/src/skippy/state_memory.cpp
+++ b/src/skippy/state_memory.cpp
@@ -5,6 +5,9 @@
 #include "llama-kv-cache.h"
 #include "llama-kv-cache-iswa.h"
 #include "llama-kv-cache-dsa.h"
+#include "llama-kv-cache-dsa-iswa.h"
+#include "llama-kv-cache-dsv4.h"
+#include "llama-kv-cache-msa.h"
 #include "llama-memory-hybrid.h"
 #include "llama-memory-hybrid-iswa.h"
 #include "llama-memory-recurrent.h"
@@ -27,11 +30,23 @@ llama_kv_cache * skippy_memory_kv_adapter(llama_memory_t memory) {
     return nullptr;
 }
 
-// Every attention cache a memory owns, composite memories included.
+// Every attention cache a memory owns, composite memories included; entries may be null.
 static std::vector<llama_kv_cache *> skippy_memory_attention_caches(llama_memory_t memory) {
     if (auto * dsa = dynamic_cast<llama_kv_cache_dsa *>(memory)) {
         return { dsa->get_mla(), dsa->get_lid() };
     }
+    if (auto * dsa_iswa = dynamic_cast<llama_kv_cache_dsa_iswa *>(memory)) {
+        auto * dsa = dsa_iswa->get_dsa();
+        return { dsa ? dsa->get_mla() : nullptr, dsa ? dsa->get_lid() : nullptr, dsa_iswa->get_swa() };
+    }
+    if (auto * msa = dynamic_cast<llama_kv_cache_msa *>(memory)) {
+        return { msa->get_base(), msa->get_idx() };
+    }
+    if (auto * dsv4 = dynamic_cast<llama_kv_cache_dsv4 *>(memory)) {
+        auto * raw = dsv4->get_raw();
+        return { raw ? raw->get_base() : nullptr, raw ? raw->get_swa() : nullptr,
+                 dsv4->get_csa(), dsv4->get_hca(), dsv4->get_lid() };
+    }
     if (auto * iswa = skippy_memory_iswa_adapter(memory)) {
         return { iswa->get_base(), iswa->get_swa() };
     }
