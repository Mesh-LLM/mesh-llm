+// Temperature 0 with the defaults and sampler order the serving layer sends.
+skippy_sampling_config temperature_zero_config() {
+    skippy_sampling_config config{};
+    config.version = 1;
+    config.flags = SKIPPY_SAMPLING_FLAG_ENABLED;
+    config.temperature = 0.0f;
+    config.top_k = 40;
+    config.top_p = 0.95f;
+    config.min_p = 0.05f;
+    config.typical_p = 1.0f;
+    config.top_nsigma = -1.0f;
+    config.dynatemp_exponent = 1.0f;
+    config.repeat_penalty = 1.0f;
+    config.penalty_last_n = 64;
+    config.dry_base = 1.75f;
+    config.dry_allowed_length = 2;
+    config.dry_penalty_last_n = 64;
+    config.xtc_threshold = 0.1f;
+    config.mirostat_entropy = 5.0f;
+    config.mirostat_learning_rate = 0.1f;
+    config.reasoning_budget_tokens = -1;
+    config.sampler_count = 9;
+    for (uint32_t i = 0; i < config.sampler_count; ++i) {
+        config.samplers[i] = i + 1;
+    }
+    return config;
+}
+
+// The token a freshly built chain selects from the row the last decode sampled.
+llama_token full_chain_token(skippy_session * session) {
+    auto * reference = common_sampler_clone(session->sampler);
+    CHECK(reference != nullptr);
+    common_sampler_reset(reference);
+    for (const llama_token token : session->token_history) {
+        common_sampler_accept(reference, token, true);
+    }
+    const auto token = common_sampler_sample(reference, session->ctx, -1);
+    CHECK(common_sampler_last(session->sampler) == session->token_history.back());
+    CHECK(session->sampling_accepted_token_count == session->token_history.size());
+    common_sampler_free(reference);
+    return token;
+}
+
+// Count the decodes that took the argmax path and check each against the full chain.
+uint64_t argmax_decodes(skippy_model * model, const skippy_sampling_config & sampling,
+        std::vector<llama_token> * predicted) {
+    auto * session = create(model);
+    prefill(session, {1, 2, 3, 4, 5, 6, 7, 8});
+    const uint64_t before = session->sampling_argmax_count;
+    llama_token previous = 9;
+    for (int step = 0; step < 6; ++step) {
+        previous = decode(session, sampling, previous);
+        CHECK(previous == full_chain_token(session));
+        predicted->push_back(previous);
+    }
+    const uint64_t taken = session->sampling_argmax_count - before;
+    release(session);
+    return taken;
+}
+
+void argmax_path(skippy_model * model) {
+    // Repeated biases apply in order to the original logit, without pre-summing.
+    skippy_argmax_plan plan;
+    skippy_prepare_argmax_plan(&plan, {{0, -1e20f}, {1, 0.0f}, {0, 1.0f}, {-1, 4.0f}}, 2);
+    const float logits[] = {1e20f, 0.5f};
+    CHECK(skippy_select_unique_argmax(logits, 2, plan) == 0);
+    skippy_prepare_argmax_plan(&plan, {}, 2);
+    CHECK(skippy_select_unique_argmax(logits, 2, plan) == 0);
+
+    // Each request can only select the top biased logit, so it must not run the full chain.
+    auto ignore_eos = temperature_zero_config();
+    ignore_eos.flags |= SKIPPY_SAMPLING_FLAG_IGNORE_EOS;
+    ignore_eos.ignore_eos = 1;
+    auto logit_bias = temperature_zero_config();
+    logit_bias.logit_bias_count = 2;
+    logit_bias.logit_bias[0] = {7, -3.0f};
+    logit_bias.logit_bias[1] = {9, 2.5f};
+    auto inert_penalties = temperature_zero_config();
+    inert_penalties.presence_penalty = 0.5f;
+    inert_penalties.frequency_penalty = 0.5f;
+    inert_penalties.penalty_last_n = 0;
+    for (const auto & sampling : {ignore_eos, logit_bias, inert_penalties}) {
+        std::vector<llama_token> predicted;
+        const uint64_t taken = argmax_decodes(model, sampling, &predicted);
+        if (taken != predicted.size()) {
+            std::fprintf(stderr, "argmax path taken for %llu of %zu temperature-0 decodes\n",
+                    static_cast<unsigned long long>(taken), predicted.size());
+        }
+        CHECK(taken == predicted.size());
+    }
+
+    // Equal biased maxima keep the full chain's tie order.
+    auto tie = temperature_zero_config();
+    tie.logit_bias_count = 2;
+    tie.logit_bias[0] = {3, 1e30f};
+    tie.logit_bias[1] = {5, 1e30f};
+    std::vector<llama_token> predicted;
+    CHECK(argmax_decodes(model, tie, &predicted) == 0);
+    for (const llama_token token : predicted) {
+        CHECK(token == 3 || token == 5);
+    }
+}
 
