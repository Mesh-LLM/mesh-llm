+static const skippy_argmax_plan & skippy_session_argmax_plan(skippy_session * session) {
+    auto & plan = session->sampling_argmax_plan;
+    if (!plan.valid) {
+        plan.valid = true;
+        const auto & config = session->sampling_config;
+        plan.eligible = session->sampling_config_valid && config.version != 0 &&
+                (config.flags & SKIPPY_SAMPLING_FLAG_ENABLED) && skippy_sampling_selects_argmax(&config);
+        if (plan.eligible) {
+            const auto * vocab = llama_model_get_vocab(session->stage_model->model);
+            std::vector<llama_logit_bias> biases(config.logit_bias,
+                    config.logit_bias + std::min<uint32_t>(config.logit_bias_count, SKIPPY_MAX_LOGIT_BIAS));
+            int32_t count = 0;
+            const auto * suppressed = llama_vocab_get_suppress_tokens(vocab, &count);
+            const bool ignore_eos = config.ignore_eos != 0 || (config.flags & SKIPPY_SAMPLING_FLAG_IGNORE_EOS);
+            for (llama_token token = 0; token < llama_vocab_n_tokens(vocab); ++token) {
+                const bool model_suppressed = suppressed != nullptr && count > 0 &&
+                        std::find(suppressed, suppressed + count, token) != suppressed + count;
+                if (model_suppressed || (ignore_eos && llama_vocab_is_eog(vocab, token))) {
+                    biases.erase(std::remove_if(biases.begin(), biases.end(),
+                            [token](const llama_logit_bias & bias) { return bias.token == token; }), biases.end());
+                    biases.push_back({token, -INFINITY});
+                }
+            }
+            skippy_prepare_argmax_plan(&plan, std::move(biases), llama_vocab_n_tokens(vocab));
+        }
+    }
+    return plan;
+}
