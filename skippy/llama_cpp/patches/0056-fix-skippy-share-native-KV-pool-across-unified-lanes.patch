From 41aea2a614ee087b48d82a8b53e3032e6b4a596b Mon Sep 17 00:00:00 2001
From: Mesh-LLM CI <ci@mesh-llm.local>
Date: Fri, 2 Oct 2026 14:53:19 +1000
Subject: [PATCH 56/67] fix(skippy): share native KV pool across unified lanes

---
 include/skippy/runtime.h                      |  4 +-
 src/skippy/model_loading.cpp                  | 45 +++++++++----------
 .../tests/hardware_application_probe.cpp      |  4 +-
 3 files changed, 24 insertions(+), 29 deletions(-)

diff --git a/include/skippy/runtime.h b/include/skippy/runtime.h
index 781572706..371353a7b 100644
--- a/include/skippy/runtime.h
+++ b/include/skippy/runtime.h
@@ -94,11 +94,9 @@ struct skippy_runtime_config {
     int32_t  glm_dsa_compact_flash_min_kv;
 
     // Tri-state KV/session controls resolved from `model_fit` config.
-    // SKIPPY_TRISTATE_AUTO preserves today's derived default; FALSE/TRUE
-    // force the value.
     /** @brief Whether K/V tensors are offloaded to the compute backend (mirrors upstream `offload_kqv`). */
     int32_t kv_offload;
-    /** @brief Whether the KV cache is unified across sequences/lanes instead of per-sequence (mirrors upstream `kv_unified`). Recurrent/hybrid architectures still force this true regardless of the requested value. */
+    /** @brief Legacy unified-KV setting. Skippy always uses unified KV; AUTO and TRUE are accepted, while FALSE is rejected. */
     int32_t kv_unified;
     /** @brief Whether sliding-window-attention layers use a full, unshifted cache window (mirrors upstream `swa_full`). */
     int32_t swa_full;
diff --git a/src/skippy/model_loading.cpp b/src/skippy/model_loading.cpp
index d47a8c071..9b2e245fe 100644
--- a/src/skippy/model_loading.cpp
+++ b/src/skippy/model_loading.cpp
@@ -606,7 +606,7 @@ struct skippy_runtime_config skippy_runtime_config_default(void) {
     config.cache_type_k = GGML_TYPE_F16;
     config.cache_type_v = GGML_TYPE_F16;
     config.kv_offload = SKIPPY_TRISTATE_AUTO;
-    config.kv_unified = SKIPPY_TRISTATE_AUTO;
+    config.kv_unified = SKIPPY_TRISTATE_TRUE;
     config.swa_full = SKIPPY_TRISTATE_AUTO;
     config.op_offload = SKIPPY_TRISTATE_AUTO;
     config.split_mode = SKIPPY_TRISTATE_AUTO;
@@ -663,6 +663,15 @@ enum skippy_status skippy_finish_model_open(
     // Encoder output is context-global in llama.cpp. Until that state can be
     // isolated per sequence, serialize encoder-decoder work on one lane.
     const uint32_t lane_count = encoder_decoder ? 1 : configured_lane_count;
+    if (config != nullptr && config->kv_unified == SKIPPY_TRISTATE_FALSE) {
+        llama_model_free(model);
+        const char * message = "non-unified KV is not supported by Skippy";
+        if (event_scope != nullptr) {
+            event_scope->emit_failure(SKIPPY_STATUS_INVALID_ARGUMENT, message);
+        }
+        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, message);
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
     uint32_t context_size_per_lane = 0;
     uint32_t context_size_total = 0;
     if (!skippy_context_capacity(config, lane_count, context_size_per_lane, context_size_total)) {
@@ -708,17 +717,15 @@ enum skippy_status skippy_finish_model_open(
     stage_model->lane_count = lane_count;
 
     llama_context_params params = llama_context_default_params();
-    // ctx_size is the per-lane request limit. llama.cpp's n_ctx is the total
-    // cell pool, so every simultaneously admitted lane needs that capacity.
+    // One unified pool reserves the requested context for every lane.
     params.n_ctx = context_size_total;
     params.n_batch = config != nullptr && config->n_batch > 0 ? static_cast<uint32_t>(config->n_batch) : context_size_per_lane;
     params.n_ubatch = config != nullptr && config->n_ubatch > 0 ? static_cast<uint32_t>(config->n_ubatch) : 0u;
     params.n_threads = config != nullptr && config->n_threads > 0 ? config->n_threads : skippy_default_thread_count();
     params.n_threads_batch = config != nullptr && config->n_threads_batch > 0 ? config->n_threads_batch : params.n_threads;
     params.n_seq_max = stage_model->lane_count;
-    params.kv_unified = stage_model->lane_count > 1;
+    params.kv_unified = true;
     if (config != nullptr) {
-        params.kv_unified = skippy_resolve_tristate(config->kv_unified, params.kv_unified);
         params.offload_kqv = skippy_resolve_tristate(config->kv_offload, params.offload_kqv);
         params.swa_full = skippy_resolve_tristate(config->swa_full, params.swa_full);
         skippy_apply_context_hardware_config(config, params);
@@ -758,22 +765,6 @@ enum skippy_status skippy_finish_model_open(
     if (llm_arch_is_recurrent(model->arch) || llm_arch_is_hybrid(model->arch)) {
         params.n_seq_max = std::max<uint32_t>(params.n_seq_max, std::max<uint32_t>(2, stage_model->lane_count * 2));
         params.n_rs_seq = std::max<uint32_t>(params.n_rs_seq, 2);
-        params.kv_unified = true;
-    }
-    // Batched activation exports are sliced by request offset, which is the
-    // microbatch row order only while llama splits with split_simple. A
-    // per-stream cache splits by sequence instead, so an exporting stage with
-    // more than one lane cannot run without a unified cache. Reject the
-    // configuration here, once, instead of failing every batched iteration.
-    if (activation_export_stage && stage_model->lane_count > 1 && !params.kv_unified) {
-        const char * message = "an exporting stage with multiple lanes requires a unified KV cache";
-        if (event_scope != nullptr) {
-            event_scope->emit_failure(SKIPPY_STATUS_INVALID_ARGUMENT, message);
-        }
-        llama_model_free(model);
-        delete stage_model;
-        skippy_set_error(out_error, SKIPPY_STATUS_INVALID_ARGUMENT, message);
-        return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
 
     const skippy_graph_build_inputs graph_build_inputs = skippy_graph_build_inputs_from_config(config);
@@ -1150,6 +1141,13 @@ enum skippy_status skippy_model_attach_mtp_draft_model(
         return SKIPPY_STATUS_INVALID_ARGUMENT;
     }
 
+    if (config->kv_unified == SKIPPY_TRISTATE_FALSE) {
+        skippy_set_error(
+                out_error,
+                SKIPPY_STATUS_INVALID_ARGUMENT,
+                "non-unified KV is not supported by Skippy");
+        return SKIPPY_STATUS_INVALID_ARGUMENT;
+    }
     uint32_t context_size_per_lane = 0;
     uint32_t context_size_total = 0;
     if (!skippy_context_capacity(
@@ -1195,14 +1193,13 @@ enum skippy_status skippy_model_attach_mtp_draft_model(
     ctx_params.ctx_type = LLAMA_CONTEXT_TYPE_MTP;
     ctx_params.ctx_other = target_model->ctx;
     ctx_params.n_ctx = context_size_total;
-    ctx_params.n_batch = config != nullptr && config->n_batch > 0 ? static_cast<uint32_t>(config->n_batch) : context_size_per_lane;
+    ctx_params.n_batch = config->n_batch > 0 ? static_cast<uint32_t>(config->n_batch) : context_size_per_lane;
     ctx_params.n_ubatch = config != nullptr && config->n_ubatch > 0 ? static_cast<uint32_t>(config->n_ubatch) : 0u;
     ctx_params.n_threads = config != nullptr && config->n_threads > 0 ? config->n_threads : skippy_default_thread_count();
     ctx_params.n_threads_batch = config != nullptr && config->n_threads_batch > 0 ? config->n_threads_batch : ctx_params.n_threads;
     ctx_params.n_seq_max = target_model->lane_count;
-    ctx_params.kv_unified = target_model->lane_count > 1;
+    ctx_params.kv_unified = true;
     if (config != nullptr) {
-        ctx_params.kv_unified = skippy_resolve_tristate(config->kv_unified, ctx_params.kv_unified);
         ctx_params.offload_kqv = skippy_resolve_tristate(config->kv_offload, ctx_params.offload_kqv);
         ctx_params.swa_full = skippy_resolve_tristate(config->swa_full, ctx_params.swa_full);
         skippy_apply_context_hardware_config(config, ctx_params);
diff --git a/src/skippy/tests/hardware_application_probe.cpp b/src/skippy/tests/hardware_application_probe.cpp
index 471968158..43c4e97df 100644
--- a/src/skippy/tests/hardware_application_probe.cpp
+++ b/src/skippy/tests/hardware_application_probe.cpp
@@ -19,8 +19,8 @@ int main() {
             "default V cache type must be F16");
     passed &= require(config.kv_offload == SKIPPY_TRISTATE_AUTO,
             "default kv_offload must preserve the derived default");
-    passed &= require(config.kv_unified == SKIPPY_TRISTATE_AUTO,
-            "default kv_unified must preserve the derived default");
+    passed &= require(config.kv_unified == SKIPPY_TRISTATE_TRUE,
+            "default kv_unified must enable the shared KV pool");
     passed &= require(config.swa_full == SKIPPY_TRISTATE_AUTO,
             "default swa_full must preserve the derived default");
     passed &= require(config.op_offload == SKIPPY_TRISTATE_AUTO,
-- 
2.54.0 (Apple Git-157)

