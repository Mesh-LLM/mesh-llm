index 9190ad55f..0e42a587a 100644
--- a/src/llama-kv-cells.h
+++ b/src/llama-kv-cells.h
@@ -482,6 +482,101 @@ public:
         }
     }
 
+    // the cells of a slice in ascending order: those that contain any of its sequences at a
+    // position >= slice.p_min
+    template <typename F>
+    void for_slice_cells(const llama_kv_rows_slice & slice, F && visit) const {
+        const uint32_t n_words = (used_max_p1() + 63)/64;
+
+        for (uint32_t w = 0; w < n_words; ++w) {
+            uint64_t word = 0;
+            for (const llama_seq_id seq_id : slice.seq_ids) {
+                const auto & bits = seq_bits[seq_id];
+                if (w < bits.size()) {
+                    word |= bits[w];
+                }
+            }
+
+            for (uint64_t b = word; b != 0; b &= b - 1) {
+                const int32_t i = 64*w + ctz64(b);
+                if (pos[i] >= slice.p_min) {
+                    visit(i);
+                }
+            }
+        }
+    }
+
+    // length of a slice's cell list once every run of consecutive cells after the first starts on
+    // a multiple of `block` list positions (see get_seq_cells_aligned)
+    int64_t seq_cells_aligned_len(const llama_kv_rows_slice & slice, uint32_t block) const {
+        int64_t n        = 0;
+        int32_t previous = -2;
+
+        for_slice_cells(slice, [&](int32_t i) {
+            if (i != previous + 1 && n%block != 0) {
+                n += block - n%block;
+            }
+            n++;
+            previous = i;
+        });
+
+        return n;
+    }
+
+    // same as get_seq_cells, with -1 before each run of consecutive cells that does not continue
+    // the previous cell, so that every run starts on a multiple of `block` list positions:
+    // a block of the list is then one consecutive range of cells, possibly ending in padding,
+    // or all padding
+    // returns false, with `data` left unspecified, if a list padded this way exceeds `n_per_seq`
+    bool get_seq_cells_aligned(const std::vector<llama_kv_rows_slice> & slices, int32_t * data, int64_t n_per_seq, uint32_t block) const {
+        assert(slices.size() >= 1);
+        assert(block >= 1);
+
+        const int64_t n_slices = (int64_t) slices.size();
+
+        for (int64_t s = 0; s < n_slices; ++s) {
+            int32_t * const begin = data + s*n_per_seq;
+            int32_t * const end   = begin + n_per_seq;
+
+            int32_t * dst      = begin;
+            int32_t   previous = -2;
+            bool      fits     = true;
+
+            for_slice_cells(slices[s], [&](int32_t i) {
+                if (!fits) {
+                    return;
+                }
+
+                const int64_t at = dst - begin;
+                if (i != previous + 1 && at%block != 0) {
+                    const int64_t at_aligned = at + (block - at%block);
+                    if (at_aligned >= n_per_seq) {
+                        fits = false;
+                        return;
+                    }
+                    std::fill(dst, begin + at_aligned, -1);
+                    dst = begin + at_aligned;
+                }
+
+                if (dst == end) {
+                    fits = false;
+                    return;
+                }
+
+                *dst++   = i;
+                previous = i;
+            });
+
+            if (!fits) {
+                return false;
+            }
+
+            std::fill(dst, end, -1);
+        }
+
+        return true;
+    }
+
     // the minimum position of sequence seq_id currently present in any of the cells
     // return -1 if the sequence is not present
     llama_pos seq_pos_min(llama_seq_id seq_id) const {
