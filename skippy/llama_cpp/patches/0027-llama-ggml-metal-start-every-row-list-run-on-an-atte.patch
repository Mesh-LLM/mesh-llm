diff --git a/tests/test-skippy-kv-rows-aligned.cpp b/tests/test-skippy-kv-rows-aligned.cpp
new file mode 100644
index 000000000..5cc440ab3
--- /dev/null
+++ b/tests/test-skippy-kv-rows-aligned.cpp
@@ -0,0 +1,106 @@
+// Block-aligned row lists (llama_kv_cells::get_seq_cells_aligned) against llama.cpp's own lists:
+// the same cells, every run on a block boundary, every block one consecutive range or padding.
+#include "../src/llama-kv-cells.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <random>
+#include <vector>
+
+static int failures = 0;
+#define CHECK(cond) do { if (!(cond)) { ++failures; std::printf("FAIL line %d: %s\n", __LINE__, #cond); } } while (0)
+
+static std::vector<int32_t> live(const std::vector<int32_t> & list) {
+    std::vector<int32_t> out;
+    std::copy_if(list.begin(), list.end(), std::back_inserter(out), [](int32_t c) { return c >= 0; });
+    return out;
+}
+
+int main() {
+    std::mt19937 rng(7);
+    const uint32_t block = 32;
+    for (int round = 0; round < 400; ++round) {
+        const uint32_t n_cells = 256 * (1 + rng() % 8);
+        llama_kv_cells cells;
+        cells.resize(n_cells);
+        const int n_seq = 1 + rng() % 4;
+        std::vector<llama_pos> next_pos(n_seq, 0);
+        const uint32_t fill = rng() % n_cells;
+        const bool fragmented = rng() % 3 == 0;
+        for (uint32_t i = 0; i < fill; ++i) {
+            const uint32_t cell = fragmented ? rng() % n_cells : i;
+            if (!cells.is_empty(cell)) {
+                continue;
+            }
+            // runs of one sequence, unless fragmented
+            const llama_seq_id seq = fragmented ? (llama_seq_id) (rng() % n_seq) : (llama_seq_id) ((i / (16 + rng() % 3)) % n_seq);
+            cells.pos_set(cell, next_pos[seq]++);
+            cells.seq_add(cell, seq);
+            if (rng() % 50 == 0 && n_seq > 1) {
+                cells.seq_add(cell, (seq + 1) % n_seq);
+            }
+        }
+
+        std::vector<llama_kv_rows_slice> slices;
+        if (rng() % 4 == 0) {
+            llama_kv_rows_slice all;
+            for (int s = 0; s < n_seq; ++s) { all.seq_ids.push_back(s); }
+            slices.push_back(all);
+        } else {
+            for (int s = 0; s < n_seq; ++s) {
+                llama_kv_rows_slice one;
+                one.seq_ids = { s };
+                one.p_min   = rng() % 3 == 0 ? (llama_pos) (rng() % 40) : -1;
+                slices.push_back(one);
+            }
+        }
+
+        int64_t longest = 0;
+        for (const auto & slice : slices) {
+            longest = std::max(longest, cells.seq_cells_aligned_len(slice, block));
+        }
+        const int64_t n_plain = n_cells;
+        std::vector<int32_t> plain(slices.size() * n_plain);
+        cells.get_seq_cells(slices, plain.data(), n_plain);
+
+        // room for the aligned lists: same cells, runs on block boundaries, blocks consecutive or padding
+        const int64_t n_rows = std::max<int64_t>(256, (longest + 255) / 256 * 256);
+        std::vector<int32_t> aligned(slices.size() * n_rows, 12345);
+        CHECK(cells.get_seq_cells_aligned(slices, aligned.data(), n_rows, block));
+        for (size_t s = 0; s < slices.size(); ++s) {
+            const std::vector<int32_t> a(aligned.begin() + s * n_rows, aligned.begin() + (s + 1) * n_rows);
+            const std::vector<int32_t> p(plain.begin() + s * n_plain, plain.begin() + (s + 1) * n_plain);
+            CHECK(live(a) == live(p));
+            int64_t last_live = -1;
+            for (int64_t i = 0; i < n_rows; ++i) {
+                if (a[i] >= 0) { last_live = i; }
+                if (a[i] >= 0 && i % block != 0) {
+                    CHECK(a[i - 1] == a[i] - 1);
+                }
+            }
+            CHECK(last_live + 1 == cells.seq_cells_aligned_len(slices[s], block));
+            for (int64_t b = 0; b + block <= n_rows; b += block) {
+                const int32_t first = a[b];
+                const auto tail = std::find(a.begin() + b, a.begin() + b + block, -1);
+                const int64_t n_live = tail - (a.begin() + b);
+                CHECK(std::all_of(tail, a.begin() + b + block, [](int32_t c) { return c == -1; }));
+                CHECK(first < 0 ? n_live == 0 : a[b + n_live - 1] == first + n_live - 1);
+            }
+        }
+
+        // block 1 is the plain list
+        std::vector<int32_t> unit(slices.size() * n_plain, 12345);
+        CHECK(cells.get_seq_cells_aligned(slices, unit.data(), n_plain, 1));
+        CHECK(unit == plain);
+
+        // no room: reports it instead of writing past the list
+        if (longest > 1) {
+            std::vector<int32_t> tight(slices.size() * (longest - 1) + 1, 777);
+            const bool fits = cells.get_seq_cells_aligned(slices, tight.data(), longest - 1, block);
+            CHECK(!fits);
+            CHECK(tight.back() == 777);
+        }
+    }
+    std::printf("%s\n", failures ? "FAILED" : "aligned row lists: all checks passed");
+    return failures != 0;
+}
