-    // the vec kernel compiles without gather code when every block of every list is either
-    // consecutive or padding; the lists are strictly ascending per slice and readable from the
-    // host whenever their Metal buffer is shared or mapped (every buffer type but private)
+    // the vec kernel compiles without gather code when every block of every list is one
+    // consecutive range (possibly ending in padding) or all padding. a run ascends, so its ends
+    // decide; the lists are readable from the host whenever their Metal buffer is shared or
+    // mapped (every buffer type but private)
     const bool rows_dense = has_rows &&
         ggml_metal_buffer_is_shared((ggml_metal_buffer_t) (kv_rows->view_src ? kv_rows->view_src->buffer : kv_rows->buffer)->context) &&
         [&] {
             constexpr int64_t C = OP_FLASH_ATTN_EXT_VEC_NCPSG;
             const int32_t * lists = (const int32_t *) kv_rows->data;
             const int64_t n_blocks = (ne11_attn/C)*kv_rows->ne[1];
+            const int64_t n_cache_rows = op->src[1]->ne[1];
             for (int64_t b = 0; b < n_blocks; ++b) {
-                const int32_t first = lists[b*C];
-                const int32_t last  = lists[b*C + C - 1];
-                if (first >= 0 && last != first + C - 1) {
+                const int32_t * block = lists + b*C;
+                const int32_t first = block[0];
+                if (first < 0 || block[C - 1] == first + C - 1) {
+                    continue; // all padding (the kernel skips it), or one consecutive range
+                }
+                // a run ending inside the block: the kernel reads C rows from `first` and the mask
+                // drops the padded columns, so the read must stay inside the cache
+                const int32_t * tail = std::find(block, block + C, -1);
+                const int64_t live = tail - block;
+                if (tail == block + C || block[live - 1] != first + live - 1 || first + C > n_cache_rows ||
+                        std::any_of(tail, block + C, [](int32_t row) { return row >= 0; })) {
                     return false;
                 }
             }
