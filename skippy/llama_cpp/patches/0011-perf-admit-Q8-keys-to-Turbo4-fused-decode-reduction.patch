From 15b062002aacd90ec0198232e07c4681e42d7c6f Mon Sep 17 00:00:00 2001
From: James Dumay <james@generalinference.xyz>
Date: Sat, 24 Oct 2026 22:31:46 +1100
Subject: [PATCH] perf: admit Q8 keys to Turbo4 fused decode reduction

---
 ggml/src/ggml-metal/ggml-metal-turbo4-fusion.h |  2 +-
 tests/test-backend-ops-turbo4-decode-inverse.h | 12 +++++++-----
 2 files changed, 8 insertions(+), 6 deletions(-)

diff --git a/ggml/src/ggml-metal/ggml-metal-turbo4-fusion.h b/ggml/src/ggml-metal/ggml-metal-turbo4-fusion.h
index 9b92391dc..ea0810bbb 100644
--- a/ggml/src/ggml-metal/ggml-metal-turbo4-fusion.h
+++ b/ggml/src/ggml-metal/ggml-metal-turbo4-fusion.h
@@ -18,7 +18,7 @@ static inline bool ggml_metal_turbo4_decode_inverse_compatible(
     const ggml_tensor * k = attention->src[1];
     const ggml_tensor * v = attention->src[2];
     return q && k && v && q->type == GGML_TYPE_F32 &&
-        k->type == GGML_TYPE_F16 && v->type == GGML_TYPE_TURBO4_0 &&
+        (k->type == GGML_TYPE_F16 || k->type == GGML_TYPE_Q8_0) && v->type == GGML_TYPE_TURBO4_0 &&
         q->ne[0] == 128 && k->ne[0] == 128 && v->ne[0] == 128 &&
         q->ne[1] == 1 && q->ne[3] == 1 && k->ne[3] == 1 && v->ne[3] == 1 &&
         q->ne[2] > 0 && q->ne[2] <= 64 && ggml_are_same_shape(attention, inverse);
diff --git a/tests/test-backend-ops-turbo4-decode-inverse.h b/tests/test-backend-ops-turbo4-decode-inverse.h
index 0d944b3c5..9520848f4 100644
--- a/tests/test-backend-ops-turbo4-decode-inverse.h
+++ b/tests/test-backend-ops-turbo4-decode-inverse.h
@@ -5,9 +5,9 @@ struct test_turbo4_decode_inverse : public test_skippy_turbo4_attention {
     const int mode;
 
     test_turbo4_decode_inverse(int64_t gqa, int64_t extent, int64_t queries,
-            std::array<int32_t, 4> permutation, bool masked, int mode)
+            std::array<int32_t, 4> permutation, bool masked, int mode, ggml_type key_type)
         : test_skippy_turbo4_attention(128, 128, 8, {gqa, 1}, extent, queries,
-              masked, false, 0.0f, 0.0f, GGML_PREC_F32, GGML_TYPE_F16,
+              masked, false, 0.0f, 0.0f, GGML_PREC_F32, key_type,
               GGML_TYPE_TURBO4_0, permutation), mode(mode) {}
 
     std::string vars() override {
@@ -65,10 +65,12 @@ static void add_turbo4_decode_inverse_tests(std::vector<std::unique_ptr<test_cas
         for (int64_t extent : {113, 512, 5632}) {
             for (auto permutation : {std::array<int32_t, 4>{0, 1, 2, 3}, std::array<int32_t, 4>{0, 2, 1, 3}}) {
                 for (bool masked : {false, true}) {
-                    for (int mode : {0, 1, 2, 3}) {
-                        cases.emplace_back(new test_turbo4_decode_inverse(gqa, extent, 1, permutation, masked, mode));
+                    for (auto key_type : {GGML_TYPE_F16, GGML_TYPE_Q8_0}) {
+                        for (int mode : {0, 1, 2, 3}) {
+                            cases.emplace_back(new test_turbo4_decode_inverse(gqa, extent, 1, permutation, masked, mode, key_type));
+                        }
+                        cases.emplace_back(new test_turbo4_decode_inverse(gqa, extent, 2, permutation, masked, 0, key_type));
                     }
-                    cases.emplace_back(new test_turbo4_decode_inverse(gqa, extent, 2, permutation, masked, 0));
                 }
             }
         }
-- 
2.56.0

